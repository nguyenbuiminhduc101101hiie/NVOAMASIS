
@using System.Globalization
@attribute [Authorize]
@inject GlobalServices gsv
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject AccountService asv
@inject SharedServices ssv
@inject BookingService bksv
@inject IJSRuntime JSRuntime
@inject SupportServices supsv
@inject IStringLocalizer<SharedResource> Localizer
@inject LocalChargesServices lcsv
@inject Bieugianangha_Services Bgnhsv
@inject CustomerService Cussv
@inject DNTUServices DNTUSV
@inject ProductPriceServices prsv;
@inject HistoryLogService HistoryLogService
@using System.Text.Json;

<PageTitle>@Localizer["Product_Price_Truck"] </PageTitle>
<MudText Class="pa-2" Typo="Typo.h6">@Localizer["Product_Price_Truck"]</MudText>
<MudStack Row Justify="Justify.FlexStart" Class="pa-4">

    <MudButton HtmlTag="label"
               OnClick="Refresh"
               Size="Size.Small" Color="Color.Primary" Variant="   Variant.Filled"
               StartIcon="@Icons.Material.Filled.Refresh">
        @Localizer["reload"]
    </MudButton>

    <MudButton HtmlTag="label"
               @onclick="@((e) => OpenCreateDialog(new Models.M_TruckingCostRequest()))"
               Size="Size.Small" Color="Color.Secondary" Variant="Variant.Filled"
               StartIcon="@Icons.Material.Filled.Add">
        @Localizer["new"]
    </MudButton>

    <MudButton HtmlTag="label"
               @onclick="@((e) => OpenEditDialog(detail))"
               Size="Size.Small" Color="Color.Info" Variant="Variant.Filled"
               StartIcon="@Icons.Material.Filled.Edit">
        @Localizer["edit"]
    </MudButton>

    <MudButton HtmlTag="label"
               @onclick="@(() => OpenAddDetailDialog(detail))"
               Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled"
               StartIcon="@Icons.Material.Filled.CopyAll">
        @Localizer["ADD_Detail"]
    </MudButton>

    <MudButton HtmlTag="label"
               @onclick="@((e) => OpenDuplicateDialog(detail))"
               Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled"
               StartIcon="@Icons.Material.Filled.CopyAll">
        @Localizer["duplicate"]
    </MudButton>


</MudStack>

<MudDataGrid T="M_TruckingCostRequest" Items="@Listdata" Filterable="true" @ref="mudTable" Class="pa-4" Bordered="true"
             FilterMode="@DataGridFilterMode.ColumnFilterRow" Dense="true" Virtualize="true" QuickFilter="@FilterFunc1"
             FixedHeader="true" FixedFooter="true" HeaderClass="no-wrap" FooterClass="no-wrap"
             ReadOnly="false" RowClassFunc="@SelectedRowClassFunc"
             RowClick="@RowClicked" EditDialogOptions="@options"
             ColumnResizeMode="@(_resizeColumn ? ResizeMode.Column : ResizeMode.Container)" Loading="_loading">
    <Columns>
        <HierarchyColumn T="M_TruckingCostRequest"></HierarchyColumn>

        <TemplateColumn CellClass="d-flex justify-end">
            <CellTemplate>
                <MudIconButton Icon="@Icons.Material.Outlined.Delete" OnClick="@(()=>DeleteItem(context.Item))" />
            </CellTemplate>
        </TemplateColumn>

        <PropertyColumn Property="x=>x.MaRFQ" Title="@Localizer["MaRFQ"]" CellStyleFunc="_cellStyleFunc"></PropertyColumn>
        <PropertyColumn Property="x=>x.NgayYeuCau" Title="@Localizer["Ngayguiyeucau"]" Format="dd/MM/yyyy" CellStyleFunc="_cellStyleFunc"></PropertyColumn>
        <PropertyColumn Property="x=>x.Nguoiyeucau" Title="@Localizer["nguoiyeucau"]" CellStyleFunc="_cellStyleFunc"></PropertyColumn>
        <PropertyColumn Property="x => CustomerName(x.CustomerId)" Title="@Localizer["Customer"]" CellStyleFunc="_cellStyleFunc">
            <EditTemplate>
                <MudSelect @bind-Value="context.Item.CustomerId" Label="@Localizer["Customer"]">
                    @foreach (var item in CustomerList)
                    {
                        <MudSelectItem Value="@item.Customer_ID">@item.COMPANY</MudSelectItem>
                    }
                </MudSelect>
            </EditTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x=>x.Loaihang" Title="@Localizer["Loaihang"]" CellStyleFunc="_cellStyleFunc"></PropertyColumn>
        <PropertyColumn Property="x=>x.Soluong" Title="@Localizer["Quantity"]" CellStyleFunc="_cellStyleFunc"></PropertyColumn>
        <PropertyColumn Property="x=>x.Donvitinh" Title="@Localizer["Unit"]" CellStyleFunc="_cellStyleFunc"></PropertyColumn>
        <PropertyColumn Property="x=>x.Kichthuochang" Title="@Localizer["Size"]" CellStyleFunc="_cellStyleFunc"></PropertyColumn>
        <PropertyColumn Property="x=>x.Loaixe" Title="@Localizer["Loaixe"]" CellStyleFunc="_cellStyleFunc"></PropertyColumn>
        <PropertyColumn Property="x=>x.Noilayhang" Title="@Localizer["Noilayhang"]" CellStyleFunc="_cellStyleFunc"></PropertyColumn>
        <PropertyColumn Property="x=>x.Noigiaohang" Title="@Localizer["Noigiaohang"]" CellStyleFunc="_cellStyleFunc"></PropertyColumn>
        <PropertyColumn Property="x=>x.Ngaylayhang" Title="@Localizer["Ngaylayhang"]" Format="dd/MM/yyyy" CellStyleFunc="_cellStyleFunc"></PropertyColumn>
        <PropertyColumn Property="x=>x.Ghichu" Title="@Localizer["ghichu"]" CellStyleFunc="_cellStyleFunc"></PropertyColumn>
        <PropertyColumn Property="x=>x.Trangthai" Title="@Localizer["status"]" CellStyleFunc="_cellStyleFunc"></PropertyColumn>


        <TemplateColumn Title="@Localizer["Approve"]">
            <CellTemplate>
                <MudCheckBox @bind-Checked="context.Item.Approve" @bind-Value="context.Item.Approve" @bind-Value:after="@(()=> OnApproveCheckboxWrapper(context.Item))">
                </MudCheckBox>
            </CellTemplate>
        </TemplateColumn>
        <PropertyColumn Property="x=>x.Continued" Title="@Localizer["Continued"]" CellStyleFunc="_cellStyleFunc"></PropertyColumn>
        <PropertyColumn Property="x=>x.Editable" Title="@Localizer["Editable"]" CellStyleFunc="_cellStyleFunc"></PropertyColumn>

        <PropertyColumn Property="x=>x.Createat" Title="@Localizer["CreatedAt"]" CellStyleFunc="_cellStyleFunc"></PropertyColumn>
        <PropertyColumn Property="x=>x.Usercreate" Title="@Localizer["Nguoilap"]" CellStyleFunc="_cellStyleFunc"></PropertyColumn>
        <PropertyColumn Property="x=>x.Userupdate" Title="@Localizer["Userupdate"]" CellStyleFunc="_cellStyleFunc"></PropertyColumn>
        <PropertyColumn Property="x=>x.Dateupdate" Title="@Localizer["Dateupdate"]" CellStyleFunc="_cellStyleFunc"></PropertyColumn>

    </Columns>

    <ChildRowContent>

        <Add_Detail_Truck_Index _ProductPrice_Truck_Details="context.Item" />

    </ChildRowContent>


    <PagerContent>
        <MudDataGridPager T="M_TruckingCostRequest" PageSizeOptions="@(new int[] { 8, 10, 20 })" />
    </PagerContent>
</MudDataGrid>
<MudItem xs="12">

    <MudChart ChartType="ChartType.Bar"
    ChartSeries="@Series"
    XAxisLabels="@XAxisLabels"
    Height="350px" Width="100%"
    ChartOptions="options_chart" />

</MudItem>
@code {
    List<M_TruckingCostRequest> Listdata = new List<M_TruckingCostRequest>();
    MudDataGrid<M_TruckingCostRequest> mudTable;
    AuthUser user;
    string usr;
    private List<string> ListUser { get; set; } = new List<string>();
    string UserHanding;
    List<string> trangthais = new List<string>();
    private List<Models.TrangThai> M_Trangthais = new List<Models.TrangThai>();
    private bool _resizeColumn;
    M_TruckingCostRequest detail;
    private List<Models.M_Customer> CustomerList = new List<Models.M_Customer>();
    public CultureInfo _en = CultureInfo.GetCultureInfo("en-US");
    private List<M_Product_Price_detail_ALL> M_details_Alls = new List<M_Product_Price_detail_ALL>();
    private List<M_Product_Price_detail_ALL> List_detail = new List<M_Product_Price_detail_ALL>();
    private List<ChargeModel> List_Charge = new List<ChargeModel>();

    public List<ChartSeries> Series = new List<ChartSeries>
    {
        new ChartSeries() { Name = "Fee", Data = new double[] { } }
    };
    public string[] XAxisLabels = { };

    protected async override Task OnInitializedAsync()
    {
        List_Charge = await supsv.GetListCharge();
        CustomerList = await Cussv.GetList();
        M_Trangthais = await supsv.GetListTrangThai();
        var tts = await supsv.GetListTrangThai();
        trangthais = tts.Where(x => x.Tieude == "ProductPriceTruck").OrderBy(x => x.Noidung).Select(x => x.Noidung).ToList();
        ListUser = await asv.GetList_User_handle() ?? new List<string>();
        usr = asv.GetAuth().Result.User.Identity!.Name!;

        // await Refresh();
    }


    bool _loading = false;
    async Task Refresh()
    {
        try
        {

            detail = null!;
            _loading = true;
            Listdata.Clear();

            await Task.Delay(500);
            if (!await ssv.CheckPermission(usr, "View", "Product_Price_Truck"))
            {
                CallSnackBar("You have not access to view", MudBlazor.Severity.Warning);
                return;
            }
            Listdata = await prsv.GetProduct_Price_truck();
            await GetChart();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            CallSnackBar("Something went wrong!, error code: " + ex.Message, MudBlazor.Severity.Warning);
        }
        finally
        {
            _loading = false;
        }

    }

    void CallSnackBar(string message, MudBlazor.Severity severity)
    {
        Snackbar.Clear();
        Snackbar.Configuration.SnackbarVariant = Variant.Filled;
        Snackbar.Configuration.MaxDisplayedSnackbars = 3;
        Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopRight;
        Snackbar.Add(message, severity);
    }
    void RowClicked(DataGridRowClickEventArgs<M_TruckingCostRequest> args)
    {
        detail = args.Item;
    }
    private int selectedRowNumber = -1;
    private string SelectedRowClassFunc(M_TruckingCostRequest m, int rowNumber)
    {
        if (selectedRowNumber == rowNumber)
        {
            selectedRowNumber = -1;
            return string.Empty;
        }
        else if (mudTable.SelectedItem != null && mudTable.SelectedItem.Equals(m))
        {
            selectedRowNumber = rowNumber;
            return "selected";
        }
        else
        {
            return string.Empty;
        }
    }

 
    int? index_no;

    async Task DeleteItem(M_TruckingCostRequest item)
    {
        if (item.Approve == true)
        {
            CallSnackBar("Data đã được Approve!!! , vui lòng bỏ Approve", MudBlazor.Severity.Warning);
            return;
        }
        if (!await ssv.CheckPermission(usr, "Delete", "Product_Price_Truck"))
        {
            CallSnackBar("You have not access to Delete", MudBlazor.Severity.Warning);
            return;
        }
        var resultMess = await DialogService.ShowMessageBox(
                "Warning",
                "Deleting can not be undone!",
                yesText: "Delete!", cancelText: "Cancel");

        if (resultMess.HasValue)
        {
            var rs = await prsv.DeleteProductPrice_truck(item);
            await prsv.DeleteDetail_All(item.Id);
            await HistoryLogService.LogAsync(usr, "Delete", "Product_Price", item.Id, item.MaRFQ, new { OldData = item });
            CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
            await Refresh();
        }

    }
    DialogOptions options = new DialogOptions
        {
            ClassBackground = "class-dialog-custom",
            FullWidth = true,
            MaxWidth = MaxWidth.Medium,
            CloseOnEscapeKey = false,
            DisableBackdropClick = true
        };
    string search;

    private bool FilterFunc1(M_TruckingCostRequest sbd) => FilterFunc(sbd, search);

    private bool FilterFunc(M_TruckingCostRequest sbd, string searchString)
    {
        if (string.IsNullOrWhiteSpace(sbd.MaRFQ))
            return true;
        if (string.IsNullOrWhiteSpace(searchString))
            return true;
        if (sbd.MaRFQ!.Contains(searchString, StringComparison.OrdinalIgnoreCase))
            return true;
        if ($"{sbd.MaRFQ} ".Contains(searchString))
            return true;
        return false;
    }

    private Func<M_TruckingCostRequest, string> _cellStyleFunc => x =>
       {
           
           string style = "";

           if (string.IsNullOrEmpty(x.Trangthai))
               return "color: #000000";

           var rs = M_Trangthais
           .Where(t => (t.Noidung).Contains(x.Trangthai, StringComparison.InvariantCultureIgnoreCase)
               && t.Tieude.Equals("ProductPrice", StringComparison.InvariantCultureIgnoreCase))
           .Select(t => t.Mamau)
           .FirstOrDefault();
           return "color: " + rs;
  

       };

    private async Task OpenCreateDialog(Models.M_TruckingCostRequest tr)
    {
        var optionsdialog = new DialogOptions { ClassBackground = "class-dialog-custom", FullWidth = true, MaxWidth = MaxWidth.Medium };

        if (await ssv.CheckPermission(asv.GetAuth().Result.User.Identity.Name, "Add", "Product_Price_Truck"))
        {

            DialogOptions closeOnEscapeKey = new DialogOptions() { CloseOnEscapeKey = true };
            var parameters = new DialogParameters<Add_Truck> { { x => x._ProductPrice_Truck_Details, tr }, { x => x.Status, "add" } };

            var dialog = await DialogService.ShowAsync<Add_Truck>(tr.Id == Guid.Empty ? "Request Pricing Truck Create" : "Request Pricing Truck Edit", parameters, optionsdialog);
            var result = await dialog.Result;
            if (!result.Canceled)
            {
                var data = (M_TruckingCostRequest)result.Data;
                var rs = await prsv.UpdateCreateProduct_Truck(data);
                await HistoryLogService.LogAsync(usr, "ADD", "Product_Price_Truck", data.Id, data.MaRFQ, data);
                MudBlazor.Severity severity;
                if (rs[1] == "1")
                    severity = MudBlazor.Severity.Success;
                else
                    severity = MudBlazor.Severity.Error;

                CallSnackBar(rs[0], severity);

                await HandleRefresh_create(data.Id);

            }

            return;

        }
        else
        {
            CallSnackBar("You have not access to Create", MudBlazor.Severity.Warning);
            return;
        }

    }

    async Task HandleRefresh_create(Guid? id)
    {
        try
        {

            detail = null;


            if (Listdata != null)
            {
                Listdata.Clear();
            }

            await Task.Delay(500);

            if (!await ssv.CheckPermission(asv.GetAuth().Result.User.Identity.Name, "View", "Product_Price_Truck"))
            {
                CallSnackBar("You have not access to view", MudBlazor.Severity.Warning);

                return;
            }
            Listdata = await prsv.GetProduct_price_Truck_create(id);
            StateHasChanged();
        }
        finally
        {


        }
    }

    private async Task OpenEditDialog(Models.M_TruckingCostRequest tr)
