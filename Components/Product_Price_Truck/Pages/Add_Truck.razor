@using System.Globalization
@inject ISnackbar Snackbar
@inject AccountService asv
@inject TrainScheduleServices trainsv
@inject IStringLocalizer<SharedResource> Localizer
@inject SharedServices ssv
@inject LocalChargesServices lcsv
@inject SupportServices supsv
@inject LenhDieuXeServices ldxsv
@inject TKHQ_Services tkhqsv
@inject GlobalServices gsv
@inject Bieugianangha_Services BGRRsv

@inject DNTUServices DNTUSV
@inject BookingService Bksv
@inject ShipmentService shipmentsv
@inject NavigationManager NavigationManager
@inject ProductPriceServices prsv
@inject NotificationService _notificationService
@inject IJSRuntime JSRuntime
@inject CustomerService Cussv

<style>
    .truck-dialog-shell {
        background: linear-gradient(180deg, #f8fbff 0%, #ffffff 42%);
        border: 1px solid #e5edf7;
        border-radius: 20px;
        box-shadow: 0 14px 36px rgba(15, 23, 42, .10);
        overflow: hidden;
    }

    .truck-dialog-header {
        padding: 14px 18px;
        background: linear-gradient(90deg, #0f7fa5 0%, #118ab2 55%, #14a3c7 100%);
        color: #ffffff;
    }

        .truck-dialog-header .mud-typography {
            color: #ffffff !important;
        }

    .truck-dialog-body {
        max-height: 72vh;
        overflow-y: auto;
        padding: 14px;
        background: #f8fbff;
    }

    .truck-section {
        background: #ffffff;
        border: 1px solid #e6edf5;
        border-radius: 18px;
        padding: 14px;
        margin-bottom: 12px;
        box-shadow: 0 8px 22px rgba(15, 23, 42, .06);
    }

    .truck-section-title {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 8px;
        color: #0f7fa5;
        font-weight: 800;
        letter-spacing: .01em;
    }

        .truck-section-title::before {
            content: "";
            width: 6px;
            height: 18px;
            border-radius: 99px;
            background: #118ab2;
            display: inline-block;
        }

    .truck-dialog-body .mud-input-control {
        margin-top: 0 !important;
    }

    .truck-dialog-body .mud-input > input,
    .truck-dialog-body .mud-input textarea {
        font-size: 13px;
    }

    .truck-dialog-body .mud-input-root {
        background: #ffffff;
        border-radius: 12px;
    }

    .truck-dialog-body .mud-input-label,
    .truck-dialog-body label,
    .custom-label .mud-input-label,
    .custom-label label {
        font-weight: 700 !important;
        color: #118ab2 !important;
    }

    .text-right input {
        text-align: right !important;
    }

    .truck-code-button,
    .truck-add-user-button {
        min-width: 42px !important;
        border-radius: 12px !important;
        font-weight: 800 !important;
        box-shadow: 0 6px 14px rgba(17, 138, 178, .20);
    }

    .truck-user-box {
        background: #f8fbff;
        border: 1px dashed #bfd7ea;
        border-radius: 16px;
        padding: 12px;
    }

    .truck-email-button,
    .truck-message-button {
        border-radius: 999px !important;
        text-transform: none !important;
        font-weight: 700 !important;
        min-height: 36px;
        width: 100%;
    }

    .truck-dialog-actions {
        display: flex;
        justify-content: flex-end;
        gap: 8px;
        width: 100%;
        padding: 12px 16px;
        border-top: 1px solid #e6edf5;
        background: #ffffff;
    }

        .truck-dialog-actions .mud-button-root {
            border-radius: 999px;
            text-transform: none;
            font-weight: 800;
            min-width: 92px;
        }

    @@media (max-width: 960px) {
        .truck-dialog-body {
            max-height: 70vh;
            padding: 10px;
        }

        .truck-section {
            padding: 10px;
            border-radius: 14px;
        }
    }
</style>

<MudDialog>
    <DialogContent>
        <div class="truck-dialog-shell">
            <div class="truck-dialog-header">
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Spacing="2">
                    <MudStack Spacing="0">
                        <MudText Typo="Typo.h6">@Localizer["PricingTruck_Title"]</MudText>
                        <MudText Typo="Typo.caption">@_ProductPrice_Truck_Details?.MaRFQ</MudText>
                    </MudStack>
                    <MudChip T="string" Color="Color.Info" Variant="Variant.Filled" Size="Size.Small">
                        @Status
                    </MudChip>
                </MudStack>
            </div>

            <div class="truck-dialog-body">
                <MudForm Model="@_ProductPrice_Truck_Details" @ref="@form">
                    <div class="truck-section">
                        <div class="truck-section-title">Thông tin yêu cầu</div>
                        <MudGrid Spacing="2">
                            <MudItem xs="12" sm="2" md="1" Class="d-flex align-end">
                                <MudButton Class="truck-code-button" Variant="Variant.Filled" Size="Size.Small" Color="Color.Primary"
                                           Disabled="@(Status == "edit")"
                                           OnClick="() => Get_BGNHNo()">
                                    >>>
                                </MudButton>
                            </MudItem>
                            <MudItem xs="12" sm="5" md="4">
                                <MudTextField @bind-Value="_ProductPrice_Truck_Details.MaRFQ"
                                              Disabled="true"
                                              Label="@Localizer["MaRFQ"]"
                                              Class="custom-label"
                                              Margin="Margin.Dense"
                                              Required="true" />
                            </MudItem>
                            <MudItem xs="12" sm="5" md="3">
                                <MudDatePicker Class="custom-label"
                                               @bind-Date="_ProductPrice_Truck_Details.NgayYeuCau"
                                               For="@(() => _ProductPrice_Truck_Details.NgayYeuCau)"
                                               Label="@Localizer["Ngayguiyeucau"]"
                                               Margin="Margin.Dense"
                                               DateFormat="dd/MM/yyyy"
                                               Required="true" />
                            </MudItem>
                            <MudItem xs="12" md="4">
                                <MudAutocomplete Class="custom-label" T="string"
                                                 @bind-Value="_ProductPrice_Truck_Details.Nguoiyeucau"
                                                 Label="@Localizer["nguoiyeucau"]"
                                                 Margin="Margin.Dense"
                                                 SearchFunc="Search_User"
                                                 Immediate="true"
                                                 CoerceText="true"
                                                 Clearable="true"
                                                 MaxItems="100" />
                            </MudItem>
                        </MudGrid>
                    </div>

                    <div class="truck-section">
                        <div class="truck-section-title">Thông tin hàng hóa</div>
                        <MudGrid Spacing="2">
                            <MudItem xs="12" md="6">
                                <MudAutocomplete Class="custom-label" T="Guid?"
                                                 Label="@Localizer["Customer"]"
                                                 @bind-Value="_ProductPrice_Truck_Details.CustomerId"
                                                 Margin="Margin.Dense"
                                                 SearchFunc="Search_Customer"
                                                 ToStringFunc="GetCustomerLable" />
                            </MudItem>
                            <MudItem xs="12" md="6">
                                <MudTextField @bind-Value="_ProductPrice_Truck_Details.Loaihang"
                                              Label="@Localizer["LoaiHang"]"
                                              Class="custom-label"
                                              Margin="Margin.Dense" />
                            </MudItem>
                            <MudItem xs="12" sm="6" md="3">
                                <MudNumericField @bind-Value="_ProductPrice_Truck_Details.Soluong"
                                                 Label="@Localizer["Quantity"]"
                                                 Format="#,##0.##"
                                                 Culture="@_en"
                                                 T="double?"
                                                 HideSpinButtons="true"
                                                 Margin="Margin.Dense"
                                                 Class="text-right custom-label" />
                            </MudItem>
                            <MudItem xs="12" sm="6" md="3">
                                <MudAutocomplete @bind-Value="_ProductPrice_Truck_Details.Donvitinh"
                                                 Label="@Localizer["Unit"]"
                                                 Class="custom-label"
                                                 Margin="Margin.Dense"
                                                 CoerceValue
                                                 SearchFunc="SearchUnit" />
                            </MudItem>
                            <MudItem xs="12" sm="6" md="3">
                                <MudTextField @bind-Value="_ProductPrice_Truck_Details.Kichthuochang"
                                              Label="@Localizer["Size"]"
                                              Class="custom-label"
                                              Margin="Margin.Dense" />
                            </MudItem>
                            <MudItem xs="12" sm="6" md="3">
                                <MudAutocomplete @bind-Value="_ProductPrice_Truck_Details.Loaixe"
                                                 Label="@Localizer["Loaixe"]"
                                                 Class="custom-label"
                                                 Margin="Margin.Dense"
                                                 CoerceValue
                                                 SearchFunc="SearchLoaixe" />
                            </MudItem>
                        </MudGrid>
                    </div>

                    <div class="truck-section">
                        <div class="truck-section-title">Tuyến xe và thời gian</div>
                        <MudGrid Spacing="2">
                            <MudItem xs="12" md="4">
                                <MudAutocomplete Class="custom-label" T="string"
                                                 @bind-Value="_ProductPrice_Truck_Details.Noilayhang"
                                                 Label="@Localizer["Noilayhang"]"
                                                 Margin="Margin.Dense"
                                                 SearchFunc="SearchPorts"
                                                 Immediate="true"
                                                 CoerceText="true"
                                                 Clearable="true"
                                                 MaxItems="100" />
                            </MudItem>
                            <MudItem xs="12" md="4">
                                <MudAutocomplete Class="custom-label" T="string"
                                                 @bind-Value="_ProductPrice_Truck_Details.Noigiaohang"
                                                 Label="@Localizer["Noigiaohang"]"
                                                 Margin="Margin.Dense"
                                                 SearchFunc="SearchPorts"
                                                 Immediate="true"
                                                 CoerceText="true"
                                                 Clearable="true"
                                                 MaxItems="100" />
                            </MudItem>
                            <MudItem xs="12" sm="6" md="2">
                                <MudDatePicker Class="custom-label"
                                               @bind-Date="_ProductPrice_Truck_Details.Ngaylayhang"
                                               For="@(() => _ProductPrice_Truck_Details.Ngaylayhang)"
                                               Label="@Localizer["Ngaylayhang"]"
                                               Margin="Margin.Dense"
                                               DateFormat="dd/MM/yyyy"
                                               Required="true" />
                            </MudItem>
                            <MudItem xs="12" sm="6" md="2">
                                <MudSelect @bind-Value="_ProductPrice_Truck_Details.Trangthai"
                                           Label="@Localizer["status"]"
                                           Class="custom-label"
                                           Margin="Margin.Dense">
                                    @foreach (var item in trangthais)
                                    {
                                        <MudSelectItem Value="@item">@item</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="12">
                                <MudTextField @bind-Value="_ProductPrice_Truck_Details.Ghichu"
                                              Label="@Localizer["ghichu"]"
                                              Class="custom-label"
                                              Margin="Margin.Dense"
                                              Lines="2"
                                              AutoGrow="true" />
                            </MudItem>
                        </MudGrid>
                    </div>

                    <div class="truck-section truck-user-box">
                        <div class="truck-section-title">Thông báo / người xử lý</div>
                        <MudGrid Spacing="2">
                            <MudItem xs="12" md="3">
                                <MudAutocomplete Class="custom-label" T="string"
                                                 @bind-Value="UserHanding"
                                                 Label="@Localizer["User"]"
                                                 Margin="Margin.Dense"
                                                 SearchFunc="Search_User"
                                                 Immediate="true"
                                                 CoerceText="true"
                                                 Clearable="true"
                                                 MaxItems="100" />
                            </MudItem>
                            <MudItem xs="12" md="1" Class="d-flex align-end">
                                <MudButton Class="truck-add-user-button" Variant="Variant.Filled" Size="Size.Small" Color="Color.Primary"
                                           OnClick="() => Getuser(_ProductPrice_Truck_Details)">
                                    >>>
                                </MudButton>
                            </MudItem>
                            <MudItem xs="12" md="4">
                                <MudTextField @bind-Value="_ProductPrice_Truck_Details.Userhandle"
                                              Class="custom-label"
                                              Margin="Margin.Dense"
                                              HelperTextOnFocus
                                              HelperText="từ 2 mail trở lên vui lòng ngăn cách bằng dấu ','"
                                              Lines="2"
                                              AutoGrow
                                              Label="@Localizer["EmailRecipient"]"
                                              Required="false" />
                            </MudItem>
                            <MudItem xs="12" sm="6" md="2" Class="d-flex align-end">
                                <MudButton Class="truck-email-button" HtmlTag="label" Disabled="_processingUpload"
                                           @onclick="@(() => SendMailnotify(_ProductPrice_Truck_Details))"
                                           Size="Size.Small" Color="Color.Tertiary" Variant="Variant.Filled"
                                           StartIcon="@Icons.Material.Filled.Email">
                                    @if (_processingUpload)
                                    {
                                        <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                                        <MudText Class="ms-2">Processing</MudText>
                                    }
                                    else
                                    {
                                        <MudText>@Localizer["sendemail"]</MudText>
                                    }
                                </MudButton>
                            </MudItem>
                            <MudItem xs="12" sm="6" md="2" Class="d-flex align-end">
                                <MudButton Class="truck-message-button" HtmlTag="label" Disabled="_processingUpload_message"
                                           @onclick="@(() => SendMessage(_ProductPrice_Truck_Details))"
                                           Size="Size.Small" Color="Color.Info" Variant="Variant.Filled"
                                           StartIcon="@Icons.Material.Filled.Notifications">
                                    @if (_processingUpload_message)
                                    {
                                        <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                                        <MudText Class="ms-2">Processing</MudText>
                                    }
                                    else
                                    {
                                        <MudText>@Localizer["message"]</MudText>
                                    }
                                </MudButton>
                            </MudItem>
                        </MudGrid>
                    </div>
                    <AttachmentField @ref="_attach" @bind-Value="_ProductPrice_Truck_Details.AttachmentIds" Folder="Truck" Title="Attachments" />
                </MudForm>
            </div>
        </div>
    </DialogContent>

    <DialogActions>
        <div class="truck-dialog-actions">
            <MudButton Variant="Variant.Text" OnClick="Cancel">Cancel</MudButton>
            <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="@(async () => await Submit())">Save</MudButton>
        </div>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] MudDialogInstance? MudDialog { get; set; }
    [Parameter] public Models.M_TruckingCostRequest _ProductPrice_Truck_Details { get; set; }
    [Parameter] public string Status { get; set; }
    List<PortModel> Ports = new List<PortModel>();
    List<string> trangthais = new List<string>();
    private List<Models.TrangThai> M_Trangthais = new List<Models.TrangThai>();
    public CultureInfo _en = CultureInfo.GetCultureInfo("en-US");
    List<M_TruckingCostRequest> TruckCosts = new List<M_TruckingCostRequest>();
    public string? UserHanding;
    MudForm form;
    private List<string> ListUser { get; set; } = new List<string>();
    List<M_Customer> Customers = new List<M_Customer>();
    List<string> List_Incoterm = new List<string>
    {
        "EXW-Giao hàng tại xưởng-người mua chịu toàn bộ chi phí và rủi ro",
        "FOB-Giao lên tàu-người bán chịu chi phí đến cảng xuất khẩu",
        "CIF-Người bán chịu chi phí + bảo hiểm đến cảng nhập khẩu",
        "DDP-Giao đã nộp thuế-người bán lo chi phí đến tận nơi mua",
        "FCA-Giao cho người vận chuyển chị định",
        "CPT-Cước phí trả tới nơi-người bán trả cước vận chuyển"
    };

    List<string> List_Type = new List<string>
    {
        "FCL",
        "LCL",
        "AIR Air Freight",
        "EXPRESS",
        "TRUCK",
        "WAREHOUSE",
        "CUSTOMS",
        "DOOR",
        "PROJECT",
        "OTHERS"
    };

    protected async override Task OnInitializedAsync()
    {
        if (Status == "Duplicate")
        {
            _ProductPrice_Truck_Details.MaRFQ = "";
            _ProductPrice_Truck_Details.Id = Guid.Empty;
            _ProductPrice_Truck_Details.Approve = false;
            _ProductPrice_Truck_Details.Continued = true;
            _ProductPrice_Truck_Details.Editable = true;
        }
        Customers = await Cussv.GetList();
        Ports = await Bksv.GetList_PORT();
        M_Trangthais = await supsv.GetListTrangThai();
        var tts = await supsv.GetListTrangThai();
        trangthais = tts.Where(x => x.Tieude == "ProductPriceTruck").OrderBy(x => x.Noidung).Select(x => x.Noidung).ToList();
        TruckCosts = await prsv.GetProduct_Price_truck();
        ListUser = await asv.GetList_User_handle() ?? new List<string>();
    }

    private async Task<IEnumerable<string>> SearchPorts(string text)
    {
        try
        {
            if (string.IsNullOrWhiteSpace(text))
            {
                return Ports
                    .Where(x => !string.IsNullOrEmpty(x.PORT))
                    .Select(x => x.PORT)
                    .Distinct();
            }

            return Ports
                .Where(x => !string.IsNullOrEmpty(x.PORT) &&
                            x.PORT.Contains(text, StringComparison.OrdinalIgnoreCase))
                .Select(x => x.PORT)
                .Distinct();
        }
        catch (Exception)
        {
            throw;
        }
    }

    private async Task Submit()
    {
        await form.Validate();

        if (form.IsValid)
        {
            var UserName = asv.GetAuth().Result.User.Identity!.Name!;
            if (Status == "add")
            {
                _ProductPrice_Truck_Details.Createat = DateTime.Now.ToString();
                _ProductPrice_Truck_Details.Usercreate = UserName;

                _ProductPrice_Truck_Details.Approve = false;
                _ProductPrice_Truck_Details.Continued = true;
                _ProductPrice_Truck_Details.Editable = true;
            }

            _ProductPrice_Truck_Details.Dateupdate = DateTime.Now.ToString();
            _ProductPrice_Truck_Details.Userupdate = UserName;
            if (_attach != null) await _attach.CommitAsync();
            MudDialog!.Close(_ProductPrice_Truck_Details);


        }

    }
    AttachmentField? _attach;
    async Task Cancel()
    {
        if (_attach != null) await _attach.RollbackAsync();
        MudDialog.Cancel();
    }

    void CallSnackBar(string message, MudBlazor.Severity severity)
    {

        Snackbar.Configuration.SnackbarVariant = Variant.Filled;
        Snackbar.Configuration.MaxDisplayedSnackbars = 3;
        Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopRight;
        Snackbar.Add(message, severity);
    }
    private async Task<IEnumerable<string?>> SearchUnit(string? text)
    {
        try
        {
            var items = TruckCosts.Select(x => x.Donvitinh).Distinct();
            if (string.IsNullOrEmpty(text))
            {
                return items;
            }
            // MBL.Porname = mst_Consignee;
            return items.Where(x => x != null && x.Equals(text));
        }
        catch (Exception)
        {
            throw;
        }
    }

    private async Task<IEnumerable<string?>> SearchLoaixe(string? text)
    {
        try
        {
            var items = TruckCosts.Select(x => x.Loaixe).Distinct();
            if (string.IsNullOrEmpty(text))
            {
                return items;
            }
            // MBL.Porname = mst_Consignee;
            return items.Where(x => x != null && x.Equals(text));
        }
        catch (Exception)
        {
            throw;
        }
    }
    private async Task Get_BGNHNo()
    {

        int formattedYear = DateTime.Now.Year;
        int formattedMonth = DateTime.Now.Month;

        string usr = asv.GetAuth().Result.User.Identity!.Name!;
        var refno = await supsv.GetRefNoByFunc("ProductPrice_Truck", formattedMonth, formattedYear, usr);

        var rs = asv.GetUserDetail();
        var cn = rs.Branch;
        _ProductPrice_Truck_Details.MaRFQ = cn + "PR_Truck_" + formattedYear.ToString() + formattedMonth.ToString() + refno.Value.ToString("D4");
    }
    private async Task<IEnumerable<string?>> SearchIncoterm(string? text)
    {
        try
        {
            var items = List_Incoterm.Distinct();
            if (string.IsNullOrWhiteSpace(text))
            {
                return items;
            }

            return items.Where(x => x != null && x.Contains(text, StringComparison.OrdinalIgnoreCase));
        }
        catch (Exception)
        {
            throw;
        }
    }
    private async Task<IEnumerable<string?>> SearchType(string? text)
    {
        try
        {
            var items = List_Type.Distinct();
            if (string.IsNullOrWhiteSpace(text))
            {
                return items;
            }

            return items.Where(x => x != null && x.Contains(text, StringComparison.OrdinalIgnoreCase));
        }
        catch (Exception)
        {
            throw;
        }
    }

    private async Task<IEnumerable<string>> Search_User(string value)
    {
        if (string.IsNullOrEmpty(value))
            return ListUser;

        return ListUser.Where(x => x.Contains(value, StringComparison.InvariantCultureIgnoreCase));
    }

    private async Task Getuser(M_TruckingCostRequest item)
    {
        if (string.IsNullOrEmpty(item.Userhandle))
        {
            item.Userhandle = UserHanding;
        }
        else
        {
            item.Userhandle += "," + UserHanding + ",";
        }
    }

    private bool _processingUpload = false;
    async Task SendMailnotify(M_TruckingCostRequest item)
    {
        try
        {
            string[] users = item.Userhandle.Split(',');
            List<string> emails = new List<string>(); // Danh sách động, có thể thêm thoải mái

            int index = 0;
            foreach (var user in users)
            {
                if (string.IsNullOrEmpty(user))
                {

                }
                else
                {
                    string inputemail = "";
                    inputemail = await gsv.GetEmailAsync(user);
                    if (!string.IsNullOrEmpty(inputemail))
                    {
                        emails.Add(inputemail);
                    }

                }
            }
            string[] emailarray = emails.ToArray();
            _processingUpload = true;
            await Task.Delay(1);
            StateHasChanged();

            if (emails != null && emailarray.Length > 0)
            {

                var rs = await gsv.GuiThongBaoProject_product_price_Truck(item, emailarray);

                CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);

            }
            else
            {

                CallSnackBar(Localizer["EmailEmpty"], MudBlazor.Severity.Warning);
                return;
            }


        }
        catch (Exception ex)
        {
            CallSnackBar(string.Format(Localizer["SomethingWentWrong"], ex.Message), MudBlazor.Severity.Error);
        }
        finally
        {
            _processingUpload = false;
        }

    }

    private bool _processingUpload_message = false;
    async Task SendMessage(M_TruckingCostRequest item)
    {
        try
        {
            string[] users = item.Userhandle.Split(',');
            List<string> listid = new List<string?>(); // Danh sách động, có thể thêm thoải mái

            int index = 0;
            foreach (var user in users)
            {
                if (string.IsNullOrEmpty(user))
                {

                }
                else
                {

                    Guid? inputid = await gsv.GetIdfromUser(user);
                    if (inputid != null)
                    {
                        listid.Add(inputid.ToString());
                    }

                }
            }
            string[] Idarray = listid.ToArray();
            _processingUpload_message = true;
            await Task.Delay(1);
            StateHasChanged();
            string noidung = "Request Pricing Trucking FRQ No:" + item.MaRFQ;
            if (listid != null && Idarray.Length > 0)
            {
                await _notificationService.SendNotificationAsync(Idarray, noidung);


            }
            else
            {

                CallSnackBar(Localizer["UserEmpty"], MudBlazor.Severity.Warning);
                return;
            }

        }
        catch (Exception ex)
        {
            CallSnackBar(string.Format(Localizer["SomethingWentWrong"], ex.Message), MudBlazor.Severity.Error);
        }
        finally
        {
            _processingUpload_message = false;
        }
    }

    private async Task<IEnumerable<Guid?>> Search_Customer(string value)
    {
        if (string.IsNullOrEmpty(value))
            return Customers.Select(x => (Guid?)x.Customer_ID);

        return Customers
        .Where(x => !string.IsNullOrEmpty(x.COMPANY) && x.COMPANY.Contains(value, StringComparison.InvariantCultureIgnoreCase))
        .Select(x => (Guid?)x.Customer_ID)  // Convert Customer_ID to Guid?
        .ToList();

    }

    private string GetCustomerLable(Guid? id)
    {
        var customer = Customers.FirstOrDefault(x => x.Customer_ID == id);
        return customer != null ? customer.COMPANY : string.Empty;
    }

}
