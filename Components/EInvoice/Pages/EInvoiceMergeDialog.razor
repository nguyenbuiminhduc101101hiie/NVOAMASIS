@using NVOAMASIS.Models

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Gộp hóa đơn · @InvoiceNo</MudText>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mb-3">
            Gộp @Items.Count dòng có chung số HĐ nội bộ <strong>@InvoiceNo</strong> thành 1 dòng trên hóa đơn điện tử.
        </MudText>
        <MudTextField @bind-Value="_productName"
                      Label="Tên sản phẩm / dịch vụ (productName)"
                      Variant="Variant.Outlined"
                      Required="true"
                      FullWidth="true" />
        <MudPaper Class="pa-3 mt-3" Elevation="0" Outlined="true">
            <MudText Typo="Typo.caption" Color="Color.Secondary">Tổng hợp</MudText>
            <MudText Typo="Typo.body2">Thành tiền: @TotalBeforeVat.ToString("#,##0.##")</MudText>
            <MudText Typo="Typo.body2">Sau thuế: @TotalAfterVat.ToString("#,##0.##")</MudText>
        </MudPaper>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Hủy</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit">Xác nhận gộp & xuất</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] MudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public List<M_HoaDonDauRa> Items { get; set; } = new();
    [Parameter] public string InvoiceNo { get; set; } = string.Empty;

    private string _productName = string.Empty;

    private double TotalBeforeVat => Items.Sum(x => x.thanhtien ?? 0);
    private double TotalAfterVat => Items.Sum(x => x.thanhtiensauthue ?? 0);

    void Cancel() => MudDialog.Cancel();

    void Submit()
    {
        if (string.IsNullOrWhiteSpace(_productName))
            return;

        MudDialog.Close(DialogResult.Ok(_productName.Trim()));
    }
}
