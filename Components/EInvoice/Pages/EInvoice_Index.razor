    private AddEInvoiceRequest BuildAddEInvoiceRequest(
        List<M_HoaDonDauRa> items,
        string? mergedProductName,
        M_Customer? customer = null,
        EInvoiceExportNoteResult? exportOptions = null)
    {
        var invoiceNo = items[0].sohoadonNoibo!.Trim();
        customer ??= _customers.FirstOrDefault(x => x.Customer_ID == items[0].customerid)
            ?? throw new InvalidOperationException($"Không tìm thấy khách hàng cho HĐ [{invoiceNo}].");

        var letEHoadonCalculateVat = exportOptions?.LetEHoadonCalculateVat ?? false;
        List<EInvoiceItemDto> eInvoiceItems;
        if (!string.IsNullOrWhiteSpace(mergedProductName))
            eInvoiceItems = new List<EInvoiceItemDto> { BuildMergedItem(items, mergedProductName, letEHoadonCalculateVat) };
        else
            eInvoiceItems = items.Select((item, index) => BuildItemFromRow(item, index + 1, letEHoadonCalculateVat)).ToList();

        var exportNote = exportOptions?.Note;
        if (!string.IsNullOrWhiteSpace(exportNote))
            eInvoiceItems.Add(BuildNoteLineItem(exportNote.Trim(), eInvoiceItems.Count + 1));

        var first = items[0];
        return new AddEInvoiceRequest
        {
            Id = Guid.NewGuid().ToString(),
            Guid = Guid.NewGuid().ToString(),
            Serial = _invoiceSerial?.Trim() ?? string.Empty,
            InvoiceNumber = invoiceNo,
            ArisingDate = DateTime.UtcNow,
            Status = "New",
            PaymentMethod = _paymentMethod,
            CurrencyType = MapCurrencyType(first.tiente),
            ExchangeRate = first.tigia ?? 1,
            EInvoiceItems = eInvoiceItems,
            InvoiceCustomer = BuildInvoiceCustomer(customer),
            Note = first.ghiChu ?? string.Empty,
            IsUseCheckDiscount = false,
            RateCheckDiscount = 0,
            DiscountType = "NotDicount"
        };
    }

    private async Task<AddEInvoiceApiResult> CallAddEInvoiceApiAsync(AddEInvoiceRequest request)
    {
        var taxNumber = _taxNumber.Trim();
        var apiUrl = $"https://{taxNumber}.ehoadon.net/api/EInvoiceOnline/AddEInvoice";
        var json = JsonSerializer.Serialize(request, _jsonCamelCase);
        using var httpRequest = new HttpRequestMessage(HttpMethod.Post, apiUrl)
        {
            Content = new StringContent(json, Encoding.UTF8, "application/json")
        };
        httpRequest.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", _eInvoiceToken.Trim());

        using var response = await HttpClient.SendAsync(httpRequest);
        var responseText = await response.Content.ReadAsStringAsync();
        return ParseAddEInvoiceResponse(responseText, response.IsSuccessStatusCode);
    }

    private async Task<AddEInvoicesBulkApiResult> CallAddEInvoicesBulkApiAsync(AddEInvoicesBulkRequest request)
    {
        var taxNumber = _taxNumber.Trim();
        var apiUrl = $"https://{taxNumber}.ehoadon.net/Api/EInvoiceOnline/BulkAddNewEInvoice";
        var json = JsonSerializer.Serialize(request, _jsonCamelCase);
        using var httpRequest = new HttpRequestMessage(HttpMethod.Post, apiUrl)
        {
            Content = new StringContent(json, Encoding.UTF8, "application/json")
        };
        httpRequest.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", _eInvoiceToken.Trim());

        var client = HttpClientFactory.CreateClient("EHoadon");
        using var response = await client.SendAsync(httpRequest);
        var responseText = await response.Content.ReadAsStringAsync();

        if (IsLocalSpaFallbackResponse(responseText))
        {
            return new AddEInvoicesBulkApiResult
            {
                Success = false,
                Message = "Không kết nối được API eHoadon (BulkAddNewEInvoice). Kiểm tra TaxNumber_E_Invoice trong Thông tin công ty (1.13)."
            };
        }

        return ParseAddEInvoicesBulkResponse(responseText, response.IsSuccessStatusCode);
    }

    private static bool IsLocalSpaFallbackResponse(string responseText) =>
        responseText.Contains("SPA default page middleware", StringComparison.OrdinalIgnoreCase)
        || (responseText.Contains("index.html", StringComparison.OrdinalIgnoreCase)
            && responseText.Contains("Production mode", StringComparison.OrdinalIgnoreCase));

    private static AddEInvoicesBulkApiResult ParseAddEInvoicesBulkResponse(string responseText, bool httpSuccess)
    {
        var result = new AddEInvoicesBulkApiResult { Message = responseText };

        try
        {
            using var doc = JsonDocument.Parse(responseText);
            var root = doc.RootElement;

            if (TryGetProperty(root, "message", out var msgEl) && msgEl.ValueKind == JsonValueKind.String)
                result.Message = msgEl.GetString() ?? result.Message;

            if (TryGetProperty(root, "status", out var statusEl) && statusEl.ValueKind == JsonValueKind.String)
                result.Status = statusEl.GetString();

            if (TryGetProperty(root, "code", out var codeEl))
            {
                if (codeEl.ValueKind == JsonValueKind.Number && codeEl.TryGetInt32(out var code))
                    result.Code = code;
                else if (codeEl.ValueKind == JsonValueKind.String)
                    result.CodeText = codeEl.GetString();
            }

            if (!TryGetProperty(root, "data", out var dataEl))
            {
                result.Success = httpSuccess;
                return result;
            }

            if (TryGetProperty(dataEl, "validInvoices", out var validEl) && validEl.ValueKind == JsonValueKind.Array)
            {
                foreach (var item in validEl.EnumerateArray())
                {
                    var valid = new BulkValidInvoiceResult
                    {
                        InvoiceId = GetStringProp(item, "invoiceId", "InvoiceId"),
                        Guid = GetStringProp(item, "guid", "Guid"),
                        ViewUrl = GetStringProp(item, "viewUrl", "ViewUrl"),
                        LookupCode = GetStringProp(item, "lookupCode", "LookupCode"),
                        InvoiceNumber = GetStringProp(item, "invoiceNumber", "InvoiceNumber")
                    };

                    if (TryGetProperty(item, "errors", out var errorsEl) && errorsEl.ValueKind == JsonValueKind.Object)
                    {
                        foreach (var prop in errorsEl.EnumerateObject())
                            valid.Errors[prop.Name] = prop.Value.ToString();
                    }

                    result.ValidInvoices.Add(valid);
                }
            }

            if (TryGetProperty(dataEl, "invalidInvoices", out var invalidEl) && invalidEl.ValueKind == JsonValueKind.Array)
            {
                foreach (var item in invalidEl.EnumerateArray())
                {
                    var invalid = new BulkInvalidInvoiceResult();
                    if (TryGetProperty(item, "invoice", out var invEl))
                        invalid.InvoiceNumber = GetStringProp(invEl, "invoiceNumber", "InvoiceNumber");

                    if (TryGetProperty(item, "errors", out var errorsEl) && errorsEl.ValueKind == JsonValueKind.Object)
                    {
                        foreach (var prop in errorsEl.EnumerateObject())
                            invalid.Errors[prop.Name] = prop.Value.ToString();
                    }

                    invalid.ErrorMessage = invalid.Errors.Any()
                        ? string.Join("; ", invalid.Errors.Select(x => $"{x.Key}: {x.Value}"))
                        : "Invalid invoice";

                    result.InvalidInvoices.Add(invalid);
                }
            }

            result.Success = result.Code == 200
                || string.Equals(result.Status, "success", StringComparison.OrdinalIgnoreCase)
                || string.Equals(result.CodeText, "Continue", StringComparison.OrdinalIgnoreCase)
                || result.ValidInvoices.Count > 0;
        }
        catch
        {
            result.Success = httpSuccess;
        }

        return result;
    }

    private static AddEInvoiceApiResult ParseAddEInvoiceResponse(string responseText, bool httpSuccess)
    {
        var result = new AddEInvoiceApiResult { Message = responseText };

        try
        {
            using var doc = JsonDocument.Parse(responseText);
            var root = doc.RootElement;

            if (TryGetProperty(root, "message", out var msgEl) && msgEl.ValueKind == JsonValueKind.String)
                result.Message = msgEl.GetString() ?? result.Message;

            if (TryGetProperty(root, "status", out var statusEl) && statusEl.ValueKind == JsonValueKind.String)
                result.Status = statusEl.GetString();

            if (TryGetProperty(root, "code", out var codeEl) && codeEl.TryGetInt32(out var code))
                result.Code = code;

            if (TryGetProperty(root, "data", out var dataEl))
            {
                result.InvoiceId = GetStringProp(dataEl, "invoiceId", "InvoiceId");
                result.EInvoiceGuid = GetStringProp(dataEl, "guid", "Guid");
                result.LookupCode = GetStringProp(dataEl, "lookupCode", "LookupCode");
                result.ViewUrl = GetStringProp(dataEl, "viewUrl", "ViewUrl");

                if (TryGetProperty(dataEl, "errors", out var errorsEl) && errorsEl.ValueKind == JsonValueKind.Object)
                {
                    foreach (var prop in errorsEl.EnumerateObject())
                        result.Errors[prop.Name] = prop.Value.ToString();
                }
            }

            result.Success = result.Code == 200 ||
                             string.Equals(result.Status, "success", StringComparison.OrdinalIgnoreCase);

            if (!result.Success && result.Errors.Any())
                result.Message = string.Join("; ", result.Errors.Select(x => $"{x.Key}: {x.Value}"));
        }
        catch
        {
            result.Success = httpSuccess;
        }

        return result;
    }

    private static bool TryGetProperty(JsonElement element, string name, out JsonElement value) =>
        element.TryGetProperty(name, out value) ||
        element.TryGetProperty(char.ToUpperInvariant(name[0]) + name[1..], out value);

    private static string? GetStringProp(JsonElement element, params string[] names)
    {
        foreach (var name in names)
        {
            if (TryGetProperty(element, name, out var el) && el.ValueKind == JsonValueKind.String)
                return el.GetString();
        }
        return null;
    }

