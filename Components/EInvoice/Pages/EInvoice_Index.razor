    private async Task PublishSelectedInvoicesAsync()
    {
        if (!await ValidatePublishPrerequisitesAsync())
            return;

        var invoiceNos = _selectedItems
            .Where(x => !IsRowPublished(x))
            .Select(x => x.sohoadonNoibo!.Trim())
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();

        if (invoiceNos.Count == 0)
        {
            Snackbar.Add("Các hóa đơn đã chọn đều đã phát hành.", MudBlazor.Severity.Warning);
            return;
        }

        if (_selectedItems.Any(IsRowPublished))
        {
            Snackbar.Add("Bỏ qua các dòng thuộc hóa đơn đã phát hành.", MudBlazor.Severity.Warning);
        }

        var invoiceIds = await ResolveInvoiceIdsBySoHoaDonNoiBoAsync(invoiceNos);
        if (invoiceIds.Count == 0)
        {
            Snackbar.Add("Không tìm thấy invoiceId trong lịch sử xuất HDDT.", MudBlazor.Severity.Warning);
            return;
        }

        if (invoiceIds.Count < invoiceNos.Count)
        {
            Snackbar.Add(
                $"Chỉ tìm thấy {invoiceIds.Count}/{invoiceNos.Count} invoiceId. Tiếp tục phát hành các HĐ có invoiceId.",
                MudBlazor.Severity.Warning);
        }

        var invoiceList = string.Join(", ", invoiceNos);
        var confirm = await DialogService.ShowMessageBox(
            "Phát hành hóa đơn điện tử",
            $"Phát hành {invoiceIds.Count} hóa đơn đã xuất — HĐ nội bộ: {invoiceList}?",
            yesText: "Phát hành",
            cancelText: "Hủy");

        if (confirm != true)
            return;

        await PublishInvoicesAsync(invoiceIds);
    }

    private async Task PublishInvoiceFromHistoryAsync(M_EInvoiceExportLog log)
    {
        if (log.IsPublished)
        {
            Snackbar.Add("Hóa đơn đã phát hành, không thể thao tác.", MudBlazor.Severity.Warning);
            return;
        }

        if (!await ValidatePublishPrerequisitesAsync())
