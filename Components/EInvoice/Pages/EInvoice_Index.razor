        };
        httpRequest.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", _eInvoiceToken.Trim());

        var client = HttpClientFactory.CreateClient("EHoadon");
        using var response = await client.SendAsync(httpRequest);
        var responseText = await response.Content.ReadAsStringAsync();

        if (IsLocalSpaFallbackResponse(responseText))
        {
            return new PublishInvoiceApiResult
            {
                Success = false,
                Message = "Không kết nối được API eHoadon (PublishInvoice). Kiểm tra TaxNumber_E_Invoice trong Thông tin công ty (1.13)."
            };
        }

        return ParsePublishInvoiceResponse(responseText, response.IsSuccessStatusCode, invoiceIds);
    }

    private static PublishInvoiceApiResult ParsePublishInvoiceResponse(
        string responseText,
        bool httpSuccess,
        IReadOnlyList<string> requestedInvoiceIds)
    {
        var result = new PublishInvoiceApiResult { Message = responseText };

        try
        {
            using var doc = JsonDocument.Parse(responseText);
            var root = doc.RootElement;

            if (TryGetProperty(root, "message", out var msgEl) && msgEl.ValueKind == JsonValueKind.String)
                result.Message = msgEl.GetString() ?? result.Message;

            if (TryGetProperty(root, "status", out var statusEl) && statusEl.ValueKind == JsonValueKind.String)
                result.Status = statusEl.GetString();

            if (TryGetProperty(root, "code", out var codeEl))
            {
                if (codeEl.ValueKind == JsonValueKind.Number && codeEl.TryGetInt32(out var code))
                    result.Code = code;
                else if (codeEl.ValueKind == JsonValueKind.String)
                    result.CodeText = codeEl.GetString();
            }

            if (TryGetProperty(root, "data", out var dataEl) && dataEl.ValueKind == JsonValueKind.Object)
            {
                if (TryGetProperty(dataEl, "message", out var dataMsgEl) && dataMsgEl.ValueKind == JsonValueKind.String)
                    result.Message = dataMsgEl.GetString() ?? result.Message;

                var dataStatus = false;
                if (TryGetProperty(dataEl, "status", out var dataStatusEl) && dataStatusEl.ValueKind == JsonValueKind.True)
                    dataStatus = true;

                if (TryGetProperty(dataEl, "invoicesSuccess", out var okEl) && okEl.ValueKind == JsonValueKind.Array)
                {
                    foreach (var item in okEl.EnumerateArray())
                    {
                        result.Results.Add(new PublishInvoiceResultItem
                        {
                            InvoiceId = GetStringProp(item, "id", "Id", "invoiceId", "InvoiceId"),
                            EInvoiceGuid = GetStringProp(item, "guid", "Guid"),
                            InvoiceNumber = GetStringProp(item, "invoiceNumber", "InvoiceNumber"),
                            TaxAuthorityCode = GetStringProp(item, "taxAuthorityCode", "TaxAuthorityCode"),
                            Success = true
                        });
                    }
                }

                if (TryGetProperty(dataEl, "invoicesError", out var errEl) && errEl.ValueKind == JsonValueKind.Array)
                {
                    foreach (var item in errEl.EnumerateArray())
                    {
                        result.Results.Add(new PublishInvoiceResultItem
                        {
                            InvoiceId = GetStringProp(item, "id", "Id", "invoiceId", "InvoiceId"),
                            EInvoiceGuid = GetStringProp(item, "guid", "Guid"),
                            InvoiceNumber = GetStringProp(item, "invoiceNumber", "InvoiceNumber"),
                            TaxAuthorityCode = GetStringProp(item, "taxAuthorityCode", "TaxAuthorityCode"),
                            Success = false,
                            Message = result.Message
                        });
                    }
                }

                if (TryGetProperty(dataEl, "errorInvoiceIds", out var errorIdsEl) && errorIdsEl.ValueKind == JsonValueKind.Array)
                {
                    foreach (var idEl in errorIdsEl.EnumerateArray())
                    {
                        if (idEl.ValueKind != JsonValueKind.String)
                            continue;

                        var invoiceId = idEl.GetString();
                        if (string.IsNullOrWhiteSpace(invoiceId))
                            continue;

                        if (!result.Results.Any(x => string.Equals(x.InvoiceId, invoiceId, StringComparison.OrdinalIgnoreCase)))
                        {
                            result.Results.Add(new PublishInvoiceResultItem
                            {
                                InvoiceId = invoiceId,
                                Success = false,
                                Message = result.Message
                            });
                        }
                    }
                }

                if (dataStatus && !result.Results.Any())
                {
                    result.Results = requestedInvoiceIds
                        .Select(id => new PublishInvoiceResultItem { InvoiceId = id, Success = true })
                        .ToList();
                }

                result.Success = dataStatus
                    || result.Code == 200
                    || string.Equals(result.Status, "success", StringComparison.OrdinalIgnoreCase)
                    || string.Equals(result.CodeText, "Continue", StringComparison.OrdinalIgnoreCase)
                    || (result.Results.Count > 0 && result.Results.All(x => x.Success));
            }
            else
            {
                result.Success = result.Code == 200
                    || string.Equals(result.Status, "success", StringComparison.OrdinalIgnoreCase)
                    || string.Equals(result.CodeText, "Continue", StringComparison.OrdinalIgnoreCase);
            }

            if (!result.Results.Any() && result.Success)
            {
                result.Results = requestedInvoiceIds
                    .Select(id => new PublishInvoiceResultItem { InvoiceId = id, Success = true })
                    .ToList();
            }
        }
        catch
        {
            result.Success = httpSuccess;
        }

        return result;
    }

    private static DownloadPdfApiResult ParseDownloadPdfResponse(string responseText, bool httpSuccess)
    {
        var result = new DownloadPdfApiResult { Message = responseText };

        try
        {
            using var doc = JsonDocument.Parse(responseText);
            var root = doc.RootElement;

            if (TryGetProperty(root, "message", out var msgEl) && msgEl.ValueKind == JsonValueKind.String)
                result.Message = msgEl.GetString() ?? result.Message;

            if (TryGetProperty(root, "status", out var statusEl) && statusEl.ValueKind == JsonValueKind.String)
                result.Status = statusEl.GetString();

            if (TryGetProperty(root, "code", out var codeEl) && codeEl.TryGetInt32(out var code))
                result.Code = code;

            if (TryGetProperty(root, "data", out var dataEl))
            {
                result.FileName = GetStringProp(dataEl, "fileName", "FileName");
                result.FileContentBase64 = GetFileContentBase64(dataEl);
            }

            result.Success = result.Code == 200 ||
                             string.Equals(result.Status, "success", StringComparison.OrdinalIgnoreCase);

            if (!result.Success && string.IsNullOrWhiteSpace(result.FileContentBase64) && httpSuccess)
                result.Success = !string.IsNullOrWhiteSpace(result.FileContentBase64);
        }
        catch
        {
            result.Success = httpSuccess;
        }

        return result;
    }

    private static string? GetFileContentBase64(JsonElement dataEl)
    {
        foreach (var name in new[] { "fileContent", "FileContent" })
        {
            if (!TryGetProperty(dataEl, name, out var el))
                continue;

            if (el.ValueKind == JsonValueKind.String)
                return el.GetString();

            if (el.ValueKind == JsonValueKind.Array)
            {
                var bytes = new List<byte>();
                foreach (var item in el.EnumerateArray())
                {
                    if (item.TryGetByte(out var b))
                        bytes.Add(b);
                }
                return bytes.Count > 0 ? Convert.ToBase64String(bytes.ToArray()) : null;
            }
        }

        return null;
    }

