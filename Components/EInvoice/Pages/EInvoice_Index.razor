    private async Task AttachInvoiceFilesToLogAsync(M_EInvoiceExportLog log)
    {
        if (string.IsNullOrWhiteSpace(log.InvoiceId)
            || string.IsNullOrWhiteSpace(_eInvoiceToken)
            || string.IsNullOrWhiteSpace(_taxNumber))
            return;

        try
        {
            var pdf = await CallDownloadInvoicePdfAsync(log.InvoiceId);
            if (pdf.Success && !string.IsNullOrWhiteSpace(pdf.FileContentBase64))
            {
                log.PdfFileName = string.IsNullOrWhiteSpace(pdf.FileName)
                    ? $"EInvoice-{log.SoHoaDonNoiBo ?? log.InvoiceId}.pdf"
                    : pdf.FileName;
                log.PdfFileContent = pdf.FileContentBase64;
            }
            else if (!pdf.Success)
            {
                Snackbar.Add($"[{log.SoHoaDonNoiBo}] Không lưu được PDF: {pdf.Message}", MudBlazor.Severity.Warning);
            }

            var xml = await CallDownloadInvoiceXmlAsync(log.InvoiceId);
            if (xml.Success && !string.IsNullOrWhiteSpace(xml.FileContentBase64))
            {
                log.XmlFileName = string.IsNullOrWhiteSpace(xml.FileName)
                    ? $"EInvoice-{log.SoHoaDonNoiBo ?? log.InvoiceId}.xml"
                    : xml.FileName;
                log.XmlFileContent = xml.FileContentBase64;
            }
            else if (!xml.Success)
            {
                Snackbar.Add($"[{log.SoHoaDonNoiBo}] Không lưu được XML: {xml.Message}", MudBlazor.Severity.Warning);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"[{log.SoHoaDonNoiBo}] Lỗi lưu file PDF/XML: {ex.Message}", MudBlazor.Severity.Warning);
        }
    }

    private async Task RefreshPublishedInvoiceFilesAsync(IReadOnlyList<string> invoiceIds)
    {
        if (invoiceIds.Count == 0)
            return;

        if (string.IsNullOrWhiteSpace(_eInvoiceToken) || string.IsNullOrWhiteSpace(_taxNumber))
            return;

        var logs = await eInvoiceSv.GetExportLogsByInvoiceIdsAsync(invoiceIds);
        if (logs.Count == 0)
            return;

        var refreshedCount = 0;
        foreach (var log in logs)
        {
            await AttachInvoiceFilesToLogAsync(log);

            if (string.IsNullOrWhiteSpace(log.PdfFileContent) && string.IsNullOrWhiteSpace(log.XmlFileContent))
                continue;

            var updateResult = await eInvoiceSv.UpdateExportLogFilesAsync(log);
            if (updateResult.Flag)
                refreshedCount++;
            else
                Snackbar.Add($"[{log.SoHoaDonNoiBo}] {updateResult.Message}", MudBlazor.Severity.Warning);
        }

        if (refreshedCount > 0)
            Snackbar.Add($"Đã cập nhật file PDF/XML mới cho {refreshedCount} hóa đơn.", MudBlazor.Severity.Info);
    }

    private async Task DownloadInvoicePdfAsync(M_EInvoiceExportLog log)
    {
        if (string.IsNullOrWhiteSpace(log.InvoiceId) && string.IsNullOrWhiteSpace(log.PdfFileContent))
        {
            Snackbar.Add("Không có invoiceId để tải PDF.", MudBlazor.Severity.Warning);
            return;
        }

        try
        {
            _downloadingFile = true;

            if (!string.IsNullOrWhiteSpace(log.PdfFileContent))
            {
                var cachedFileName = log.PdfFileName
                    ?? $"EInvoice-{log.SoHoaDonNoiBo ?? log.InvoiceId}.pdf";
                await JS.InvokeVoidAsync("downloadFileFromStream", cachedFileName, GetBase64ForDownload(log.PdfFileContent));
                Snackbar.Add("Đã tải PDF hóa đơn.", MudBlazor.Severity.Success);
                return;
            }

            if (string.IsNullOrWhiteSpace(_eInvoiceToken))
            {
                Snackbar.Add("Chưa có token. Vui lòng bấm Get Token.", MudBlazor.Severity.Warning);
                return;
            }

            if (string.IsNullOrWhiteSpace(_taxNumber))
            {
                Snackbar.Add("Chưa có TaxNumber E-Invoice.", MudBlazor.Severity.Warning);
                return;
            }

            var pdf = await CallDownloadInvoicePdfAsync(log.InvoiceId!);
            if (!pdf.Success || string.IsNullOrWhiteSpace(pdf.FileContentBase64))
            {
                Snackbar.Add($"Tải PDF thất bại: {pdf.Message}", MudBlazor.Severity.Error);
                return;
            }

            var fileName = string.IsNullOrWhiteSpace(pdf.FileName)
                ? $"EInvoice-{log.SoHoaDonNoiBo ?? log.InvoiceId}.pdf"
                : pdf.FileName;

            await JS.InvokeVoidAsync("downloadFileFromStream", fileName, GetBase64ForDownload(pdf.FileContentBase64));
            Snackbar.Add("Đã tải PDF hóa đơn.", MudBlazor.Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Lỗi tải PDF: {ex.Message}", MudBlazor.Severity.Error);
        }
        finally
        {
            _downloadingFile = false;
        }
    }

