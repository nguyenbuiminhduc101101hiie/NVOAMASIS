    private sealed record InvoiceExportGroup(string InvoiceNo, List<M_HoaDonDauRa> Items);

    private string GetDefaultExportNote()
    {
        var hbl = _selectedHblCode;
        if (string.IsNullOrWhiteSpace(hbl) && _selectedHblId.HasValue && _selectedHblId.Value != Guid.Empty)
            hbl = HblIdToCode(_selectedHblId);

        if (string.IsNullOrWhiteSpace(hbl))
            return string.Empty;

        var detail = _selectedHblDetail
            ?? _hbls.FirstOrDefault(x => _selectedHblId.HasValue && x.hblID == _selectedHblId.Value);

        var lines = new List<string> { $"B/L : {hbl}" };

        if (detail != null)
        {
            var pol = detail.polname?.Trim() ?? string.Empty;
            var pod = detail.podname?.Trim() ?? string.Empty;
            if (!string.IsNullOrEmpty(pol) || !string.IsNullOrEmpty(pod))
                lines.Add($"Cảng Đi : {pol}     Cảng Đến : {pod}");

            var vessel = detail.vessel?.Trim() ?? string.Empty;
            var voy = detail.voy?.Trim() ?? string.Empty;
            if (!string.IsNullOrWhiteSpace(vessel) || !string.IsNullOrWhiteSpace(voy))
                lines.Add($"Tên Tàu : {vessel}     Số Chuyến : {voy}");
        }

        return string.Join(Environment.NewLine, lines);
    }

    private async Task<EInvoiceExportNoteResult?> PromptExportNoteAsync()
    {
        var options = new DialogOptions
        {
            CloseOnEscapeKey = true,
            MaxWidth = MaxWidth.Small,
            FullWidth = true
        };

        var parameters = new DialogParameters<EInvoiceNoteDialog>
        {
            { x => x.DefaultNote, GetDefaultExportNote() }
        };

        var dialog = await DialogService.ShowAsync<EInvoiceNoteDialog>("Ghi chú xuất HDDT", parameters, options);
        var result = await dialog.Result;
        if (result.Canceled)
            return null;

        return result.Data as EInvoiceExportNoteResult ?? new EInvoiceExportNoteResult(string.Empty, false);
    }

    private async Task<int> ExportViaBulkApiAsync(
        IReadOnlyList<InvoiceExportGroup> groups,
        string? mergedProductName,
        EInvoiceExportNoteResult exportOptions,
        string exportTypeForLog)
    {
        if (groups.Count == 0)
            return 0;

        var firstItem = groups[0].Items[0];
        var customer = _customers.FirstOrDefault(x => x.Customer_ID == firstItem.customerid);
        if (customer == null)
        {
            Snackbar.Add("Không tìm thấy khách hàng.", MudBlazor.Severity.Error);
            return 0;
        }

        var bulkPayload = new AddEInvoicesBulkRequest
        {
            Invoices = groups.Select(g =>
            {
                var mergeName = groups.Count == 1 ? mergedProductName : null;
                return BuildAddEInvoiceRequest(g.Items, mergeName, customer, exportOptions);
            }).ToList(),
            CommitWhenAllInvoicesValid = true,
            SendToTaxAuthorite = false
        };

        var bulkResult = await CallAddEInvoicesBulkApiAsync(bulkPayload);
        if (!bulkResult.Success && !bulkResult.ValidInvoices.Any())
        {
            Snackbar.Add($"Xuất HDDT thất bại: {bulkResult.Message}", MudBlazor.Severity.Error);
            return 0;
        }

        var successCount = 0;
        for (var i = 0; i < groups.Count; i++)
        {
            var group = groups[i];
            var request = bulkPayload.Invoices[i];

            var valid = bulkResult.ValidInvoices.FirstOrDefault(v =>
                string.Equals(v.Guid, request.Guid, StringComparison.OrdinalIgnoreCase)
                || string.Equals(v.InvoiceNumber, group.InvoiceNo, StringComparison.OrdinalIgnoreCase));
            if (valid == null && i < bulkResult.ValidInvoices.Count)
                valid = bulkResult.ValidInvoices[i];

            if (valid == null)
                continue;

            valid.InvoiceNumber ??= group.InvoiceNo;

            var apiResult = new AddEInvoiceApiResult
            {
                Success = true,
                Message = bulkResult.Message,
                InvoiceId = valid.InvoiceId,
                EInvoiceGuid = valid.Guid,
                LookupCode = valid.LookupCode,
                ViewUrl = valid.ViewUrl
            };

            await SaveExportLogAndUpdateRowsAsync(apiResult, group.Items, customer, exportTypeForLog);
            successCount++;

            if (!string.IsNullOrWhiteSpace(valid.ViewUrl))
                await OpenViewUrlAsync(valid.ViewUrl);
        }

        if (bulkResult.InvalidInvoices.Any())
        {
            var invalidSummary = string.Join("; ",
                bulkResult.InvalidInvoices.Take(3).Select(x =>
                    $"[{x.InvoiceNumber}]: {x.ErrorMessage}"));
            Snackbar.Add($"Có {bulkResult.InvalidInvoices.Count} HĐ không hợp lệ. {invalidSummary}",
                MudBlazor.Severity.Warning);
        }

        return successCount;
    }

    private async Task SaveExportLogAndUpdateRowsAsync(
        AddEInvoiceApiResult apiResult,
        List<M_HoaDonDauRa> items,
        M_Customer customer,
        string exportType)
    {
        var invoiceNo = items[0].sohoadonNoibo!.Trim();
        var lookupOrId = apiResult.LookupCode ?? apiResult.InvoiceId ?? invoiceNo;

        foreach (var item in items)
        {
            var original = JsonSerializer.Deserialize<M_HoaDonDauRa>(JsonSerializer.Serialize(item))!;
            item.ngayphathanhhoadonDientu = DateTime.Now;
            item.sohoadonDientu = lookupOrId;
            item.userupdate = _usr;
            item.dateupdate = DateTime.Now.ToString();

            var updateResult = await shipsv.UpdateHoaDonDauRaMBL(item, original);
            if (!updateResult.Flag)
                Snackbar.Add($"{invoiceNo}: {updateResult.Message}", MudBlazor.Severity.Error);
        }

        var log = new M_EInvoiceExportLog
        {
            EInvoiceExportLogId = Guid.NewGuid(),
            InvoiceId = apiResult.InvoiceId,
            EInvoiceGuid = apiResult.EInvoiceGuid,
            LookupCode = apiResult.LookupCode,
            ViewUrl = apiResult.ViewUrl,
            SoHoaDonNoiBo = invoiceNo,
            HblId = _selectedHblId,
            HblCode = _selectedHblCode ?? HblIdToCode(_selectedHblId),
            CustomerId = customer.Customer_ID,
            CustomerName = CustomerName(customer.Customer_ID),
            ExportType = exportType,
            LineCount = items.Count,
            CreatedBy = _usr,
            CreatedAt = DateTime.Now,
            Continued = true
        };

        await AttachInvoiceFilesToLogAsync(log);

        var saveLog = await eInvoiceSv.CreateExportLogAsync(log);
        if (!saveLog.Flag)
            Snackbar.Add(saveLog.Message, MudBlazor.Severity.Warning);

        await LoadExportHistoryAsync();
    }

