        if (string.IsNullOrWhiteSpace(log.InvoiceId))
        {
            Snackbar.Add("Không có invoiceId để phát hành.", MudBlazor.Severity.Warning);
            return;
        }

        var confirm = await DialogService.ShowMessageBox(
            "Phát hành hóa đơn điện tử",
            $"Phát hành HĐ nội bộ [{log.SoHoaDonNoiBo}]?",
            yesText: "Phát hành",
            cancelText: "Hủy");

        if (confirm != true)
            return;

        await PublishInvoicesAsync(new List<string> { log.InvoiceId });
    }

    private async Task<bool> ValidatePublishPrerequisitesAsync()
    {
        if (!await ssv.CheckPermission(_usr, "Add", PermissionMenuName))
        {
            Snackbar.Add("Bạn không có quyền phát hành E-Invoice (E_Invoice · Add).", MudBlazor.Severity.Warning);
            return false;
        }

        await LoadEInvoiceConfigFromCompanyAsync();

        if (string.IsNullOrWhiteSpace(_taxNumber))
        {
            Snackbar.Add("Chưa có TaxNumber E-Invoice trong Thông tin công ty (1.13).", MudBlazor.Severity.Warning);
            return false;
        }

        if (!await GetTokenAsync())
            return false;

        return true;
    }

    private async Task<List<string>> ResolveInvoiceIdsBySoHoaDonNoiBoAsync(IReadOnlyList<string> invoiceNos)
    {
        if (invoiceNos.Count == 0)
            return new List<string>();

        var allHistory = await eInvoiceSv.GetExportLogsAsync(null);

        var invoiceIds = new List<string>();
        foreach (var invoiceNo in invoiceNos)
        {
            var log = allHistory
                .Where(x => !string.IsNullOrWhiteSpace(x.InvoiceId)
                            && string.Equals(x.SoHoaDonNoiBo?.Trim(), invoiceNo, StringComparison.OrdinalIgnoreCase))
                .OrderByDescending(x => x.CreatedAt)
                .FirstOrDefault();

            if (!string.IsNullOrWhiteSpace(log?.InvoiceId))
                invoiceIds.Add(log.InvoiceId);
        }

        return invoiceIds.Distinct(StringComparer.OrdinalIgnoreCase).ToList();
    }

    private async Task PublishInvoicesAsync(List<string> invoiceIds)
    {
        if (invoiceIds.Count == 0)
        {
            Snackbar.Add("Không có invoiceId để phát hành.", MudBlazor.Severity.Warning);
            return;
        }

        try
        {
            _publishing = true;
            var result = await CallPublishInvoiceApiAsync(invoiceIds);
            if (!result.Success)
            {
                Snackbar.Add($"Phát hành HDDT thất bại: {result.Message}", MudBlazor.Severity.Error);
                return;
            }

            var successCount = result.Results.Count(x => x.Success);
            if (successCount > 0)
            {
                var publishedIds = result.Results
                    .Where(x => x.Success && !string.IsNullOrWhiteSpace(x.InvoiceId))
                    .Select(x => x.InvoiceId!)
                    .ToList();

                var markResult = await eInvoiceSv.MarkAsPublishedAsync(publishedIds, _usr);
                if (!markResult.Flag)
                    Snackbar.Add(markResult.Message, MudBlazor.Severity.Warning);

                await RefreshPublishedInvoiceFilesAsync(publishedIds);

                await LoadPublishedInvoiceNosAsync();
                foreach (var item in _selectedItems.Where(IsRowPublished).ToList())
                    _selectedItems.Remove(item);
                NotifySelectionChanged();

                if (_activeTab == 1)
                    await LoadExportHistoryAsync();
                else if (_allData.Count > 0)
                    StateHasChanged();

                Snackbar.Add($"Phát hành HDDT thành công {successCount}/{invoiceIds.Count} hóa đơn.",
                    MudBlazor.Severity.Success);
            }
            else
            {
                Snackbar.Add($"Phát hành HDDT không thành công: {result.Message}", MudBlazor.Severity.Error);
            }

            if (result.Results.Any(x => !x.Success))
            {
                var failedSummary = string.Join("; ",
                    result.Results.Where(x => !x.Success).Take(3)
                        .Select(x => $"[{x.InvoiceId}]: {x.Message}"));
                Snackbar.Add($"Có {result.Results.Count(x => !x.Success)} HĐ phát hành lỗi. {failedSummary}",
                    MudBlazor.Severity.Warning);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Lỗi phát hành HDDT: {ex.Message}", MudBlazor.Severity.Error);
        }
        finally
        {
            _publishing = false;
        }
    }

    private async Task<PublishInvoiceApiResult> CallPublishInvoiceApiAsync(List<string> invoiceIds)
    {
        var taxNumber = _taxNumber.Trim();
        var apiUrl = $"https://{taxNumber}.ehoadon.net/api/EInvoiceOnline/PublishInvoice";

        var request = new PublishInvoiceRequest
