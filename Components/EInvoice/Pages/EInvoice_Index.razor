    private FeatureProductDto? BuildFeatureProductFromHbl()
    {
        var detail = _selectedHblDetail
            ?? (_selectedHblId.HasValue && _selectedHblId.Value != Guid.Empty
                ? _hbls.FirstOrDefault(x => x.hblID == _selectedHblId.Value)
                : null);

        if (detail == null)
            return null;

        var pol = detail.polname?.Trim() ?? string.Empty;
        var pod = detail.podname?.Trim() ?? string.Empty;
        var vessel = detail.vessel?.Trim() ?? string.Empty;
        var voy = detail.voy?.Trim() ?? string.Empty;

        return new FeatureProductDto
        {
            DeliveryService = new DeliveryServiceDto
            {
                Type = $"Cảng đi : {pol} - Cảng Đến : {pod}",
                VehicleControl = $"{vessel} {voy}".Trim()
            }
        };
    }

    private static double GetVatAmount(M_HoaDonDauRa item)
    {
        var amount = item.thanhtien ?? 0;
        var afterVat = item.thanhtiensauthue ?? 0;
        if (afterVat > 0 && amount > 0 && afterVat >= amount)
            return Math.Round(afterVat - amount, 2);

        var rate = item.thue ?? 0;
        return Math.Round(amount * rate / 100.0, 2);
    }

    private EInvoiceItemDto BuildItemFromRow(M_HoaDonDauRa item, int displayOrder, bool letEHoadonCalculateVat)
    {
        var amount = item.thanhtien ?? 0;
        var vatRate = item.thue ?? 0;
        var vatAmount = GetVatAmount(item);
        var totalAmount = item.thanhtiensauthue ?? Math.Round(amount + vatAmount, 2);

        return new EInvoiceItemDto
        {
            PosNumber = displayOrder,
            ProductNumber = item.itemid.ToString(),
            ProductId = item.itemid.ToString(),
            ProductName = ChargeName(item.itemid, item.soThuTu),
            Unit = string.Empty,
            Quantity = item.soluong ?? 1,
            Price = item.dongia ?? amount,
            VatRate = vatRate,
            Free = false,
            Discount = false,
            CurrencyType = MapCurrencyType(item.tiente),
            Amount = amount,
            VatAmount =  vatAmount,
            AddVatAmount = vatAmount,
            AddAmount =  amount,
            DiscountRate = 0,
            DiscountAmount = 0,
            // TotalAmount = totalAmount,
            DisplayOrder = item.soThuTu ?? displayOrder
            // FeatureProduct = BuildFeatureProductFromHbl()
        };
    }

    private EInvoiceItemDto BuildMergedItem(List<M_HoaDonDauRa> items, string productName, bool letEHoadonCalculateVat)
    {
        var amount = items.Sum(x => x.thanhtien ?? 0);
        var totalAmount = items.Sum(x => x.thanhtiensauthue ?? 0);
        var vatAmount = items.Sum(GetVatAmount);
 
        var vatRate = amount > 0 ? Math.Round(vatAmount / amount * 100, 2) : items.FirstOrDefault()?.thue ?? 0;
        var first = items[0];

        return new EInvoiceItemDto
        {
            PosNumber = 1,
            ProductNumber = "MERGE",
            ProductId = Guid.NewGuid().ToString(),
            ProductName = productName,
            Unit = string.Empty,
            Quantity = 1,
            Price = amount,
            VatRate = vatRate,
            Free = false,
            Discount = false,
            CurrencyType = MapCurrencyType(first.tiente),
            AddAmount =  amount,
            Amount = amount,
            VatAmount =  vatAmount,
            AddVatAmount =  vatAmount,
            DiscountRate = 0,
            DiscountAmount = 0,
            // TotalAmount = totalAmount,
            DisplayOrder = 1,
            FeatureProduct = BuildFeatureProductFromHbl()
        };
    }

