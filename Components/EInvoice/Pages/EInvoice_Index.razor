    private async Task<bool> GetTokenAsync()
    {
        if (!await ssv.CheckPermission(_usr, "Add", PermissionMenuName))
        {
            Snackbar.Add("Bạn không có quyền thao tác xuất E-Invoice (E_Invoice · Add).", MudBlazor.Severity.Warning);
            return false;
        }

        await LoadEInvoiceConfigFromCompanyAsync();

        if (string.IsNullOrWhiteSpace(_taxNumber))
        {
            Snackbar.Add("Chưa có TaxCode trong Thông tin công ty (1.13).", MudBlazor.Severity.Warning);
            return false;
        }

        if (string.IsNullOrWhiteSpace(_tenantId))
        {
            Snackbar.Add("Chưa có TenantID trong Thông tin công ty (1.13).", MudBlazor.Severity.Warning);
            return false;
        }

        if (string.IsNullOrWhiteSpace(_email))
        {
            Snackbar.Add("Chưa có Email E-Invoice trong Thông tin công ty (1.13).", MudBlazor.Severity.Warning);
            return false;
        }

        if (string.IsNullOrWhiteSpace(_password))
        {
            Snackbar.Add("Chưa có Password E-Invoice trong Thông tin công ty (1.13).", MudBlazor.Severity.Warning);
            return false;
        }

        try
        {
            _gettingToken = true;
            _eInvoiceToken = string.Empty;
            StateHasChanged();

            var taxNumber = _taxNumber.Trim();
            var apiUrl = $"https://{taxNumber}.ehoadon.net/api/token/create";

            var requestBody = new EInvoiceTokenRequest
            {
                TenantId = _tenantId.Trim(),
                Email = _email.Trim(),
                Password = _password
            };

            var json = JsonSerializer.Serialize(requestBody, _jsonPascalCase);
            using var content = new StringContent(json, Encoding.UTF8, "application/json");
            using var response = await HttpClient.PostAsync(apiUrl, content);
            var responseText = await response.Content.ReadAsStringAsync();

            if (!response.IsSuccessStatusCode)
            {
                Snackbar.Add($"Lấy token thất bại ({(int)response.StatusCode}): {responseText}", MudBlazor.Severity.Error);
                return false;
            }

            var token = responseText.Trim().Trim('"');
            if (string.IsNullOrWhiteSpace(token))
            {
                Snackbar.Add("Response token rỗng.", MudBlazor.Severity.Error);
                return false;
            }

            _eInvoiceToken = token;
            Snackbar.Add("Lấy token thành công.", MudBlazor.Severity.Success);
            return true;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Lỗi khi lấy token: {ex.Message}", MudBlazor.Severity.Error);
            return false;
        }
        finally
        {
            _gettingToken = false;
            StateHasChanged();
        }
    }

    private sealed class EInvoiceTokenRequest
    {
        public string TenantId { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
    }
