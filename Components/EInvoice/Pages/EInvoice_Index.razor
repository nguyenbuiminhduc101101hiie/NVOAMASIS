@using System.Globalization
@using System.Net.Http.Json
@using System.Text
@using System.Text.Json
@using System.Text.Json.Serialization
@using NVOAMASIS.Models
@using NVOAMASIS.Services
@attribute [Authorize]
@inject ShipmentService shipsv
@inject CustomerService csv
@inject SharedServices ssv
@inject AccountService asv
@inject SupportServices supsv
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject HttpClient HttpClient
@inject IHttpClientFactory HttpClientFactory
@inject GlobalServices gsv
@inject EInvoiceService eInvoiceSv
@inject IJSRuntime JS
@inject IStringLocalizer<SharedResource> Localizer

<PageTitle>5.13 E-Invoice</PageTitle>

<div class="product-price-page einvoice-page">
    <MudTabs Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-0" Class="einvoice-tabs"
             @bind-ActivePanelIndex="_activeTab"
             @bind-ActivePanelIndex:after="OnTabChangedAsync">
        <MudTabPanel Text="Xuất HĐ" Icon="@Icons.Material.Filled.CloudUpload">
            <PpScreenHeader Title="5.13 E-Invoice" Subtitle="Xuất hóa đơn điện tử eHoadon · theo HBL">
                <Toolbar>
                    <MudStack Row="true" Spacing="1" Class="flex-wrap product-price-toolbar" AlignItems="AlignItems.Center">
                        <MudAutocomplete T="Guid?"
                                         @bind-Value="_selectedHblId"
                                         Label="Mã HBL"
                                         Variant="Variant.Outlined"
                                         Dense="true"
                                         Margin="Margin.Dense"
                                         SearchFunc="SearchHBL"
                                         ToStringFunc="HblIdToCode"
                                         ResetValueOnEmptyText
                                         Clearable
                                         Adornment="Adornment.Start"
                                         AdornmentIcon="@Icons.Material.Filled.LocalShipping"
                                         Class="einvoice-field-hbl" />
                        <MudTextField @bind-Value="_searchString"
                                      Placeholder="Số HĐ nội bộ / điện tử..."
                                      Variant="Variant.Outlined"
                                      Dense="true"
                                      Margin="Margin.Dense"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Search"
                                      Immediate="true"
                                      Class="einvoice-field-search" />
                        <MudCheckBox @bind-Value="_onlyApproved" Label="Đã duyệt" Color="Color.Primary" Dense="true" />
                        <MudCheckBox @bind-Value="_onlyNotExported" Label="Chưa xuất" Color="Color.Primary" Dense="true" />
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.Search"
                                   OnClick="Search"
                                   Disabled="_loading">
                            Tìm
                        </MudButton>
                    </MudStack>
                </Toolbar>
            </PpScreenHeader>

            <div class="einvoice-status-bar">
                <span class="einvoice-stat einvoice-stat--accent">
                    <MudIcon Icon="@Icons.Material.Filled.LocalShipping" Size="Size.Small" />
                    HBL: @(string.IsNullOrEmpty(_selectedHblCode) ? "—" : _selectedHblCode)
                </span>
                <span class="einvoice-stat">
                    <MudIcon Icon="@Icons.Material.Filled.TableRows" Size="Size.Small" />
                    @_filteredCount dòng
                </span>
                <span class="einvoice-stat @(_selectedCount > 0 ? "einvoice-stat--accent" : "einvoice-stat--muted")">
                    <MudIcon Icon="@Icons.Material.Filled.CheckBox" Size="Size.Small" />
                    Đã chọn @_selectedCount
                </span>
                @if (!string.IsNullOrEmpty(_eInvoiceToken))
                {
                    <span class="einvoice-stat einvoice-stat--success">
                        <MudIcon Icon="@Icons.Material.Filled.Verified" Size="Size.Small" />
                        Token · @_tokenPreview
                    </span>
                }
                else
                {
                    <span class="einvoice-stat einvoice-stat--warn">
                        <MudIcon Icon="@Icons.Material.Filled.KeyOff" Size="Size.Small" />
                        Chưa có token
                    </span>
                }
            </div>

            <MudPaper Class="product-price-card einvoice-grid-card" Elevation="0">
                <div class="einvoice-grid-toolbar">
                    <span class="einvoice-grid-toolbar-title">
                        <MudIcon Icon="@Icons.Material.Filled.ReceiptLong" Size="Size.Small" Class="mr-1" />
                        Chi tiết hóa đơn đầu ra
                    </span>
                    <div class="einvoice-grid-toolbar-actions">
                        <span class="einvoice-selection-pill @(_selectedCount > 0 ? "has-selection" : null)">
                            <MudIcon Icon="@Icons.Material.Filled.TouchApp" Size="Size.Small" />
                            @_selectedCount / @_filteredCount đã chọn
                        </span>
                        <MudSelect T="int"
                                   @bind-Value="_paymentMethod"
                                   Label="PTTT"
                                   Variant="Variant.Outlined"
                                   Dense="true"
                                   Margin="Margin.Dense"
                                   Disabled="_exporting || !_canAdd"
                                   Class="einvoice-field-pttt">
                            <MudSelectItem T="int" Value="1">Thanh toán tiền mặt</MudSelectItem>
                            <MudSelectItem T="int" Value="2">Thanh toán chuyển khoản</MudSelectItem>
                            <MudSelectItem T="int" Value="3">Thanh toán tiền mặt hoặc chuyển khoản</MudSelectItem>
                            <MudSelectItem T="int" Value="4">Thanh toán thẻ tín dụng</MudSelectItem>
                            <MudSelectItem T="int" Value="5">Không thu tiền</MudSelectItem>
                            <MudSelectItem T="int" Value="9">Khác</MudSelectItem>
                        </MudSelect>
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.Refresh" OnClick="Search" Disabled="_loading">
                            Tải lại
                        </MudButton>
                        <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.CloudUpload"
                                   OnClick="ExportNormalAsync"
                                   Disabled="_loading || _exporting || _selectedCount < 1 || !_canAdd">
                            Xuất HDDT
                        </MudButton>
                        <MudButton Variant="Variant.Filled" Color="Color.Warning" Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.MergeType"
                                   OnClick="ExportMergeAsync"
                                   Disabled="_loading || _exporting || _selectedCount < 2 || !_canAdd">
                            Gộp & xuất
                        </MudButton>
                     @*    <MudButton Variant="Variant.Filled" Color="Color.Info" Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.LibraryAdd"
                                   OnClick="ExportBulkMultiAsync"
                                   Disabled="_loading || _exporting || _selectedCount < 2 || !_canAdd">
                            Bulk Multi
                        </MudButton> *@
                        <MudButton Variant="Variant.Filled" Color="Color.Secondary" Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.Publish"
                                   OnClick="PublishSelectedInvoicesAsync"
                                   Disabled="_loading || _exporting || _publishing || !_canPublishSelected || !_canAdd">
                            Phát hành HDDT
                        </MudButton>
                        <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.DeleteOutline"
                                   OnClick="DeleteOnlineInvoiceAsync"
                                   Disabled="_loading || _deletingOnline || !_canDeleteOnlineSelected || !_canDelete">
                            Xóa HĐ online
                        </MudButton>
                    </div>
                </div>

                <div class="product-price-grid-wrap">
            <MudDataGrid T="M_HoaDonDauRa"
                         Items="@FilteredData"
                         Filterable="true"
                         @ref="_grid"
                         Class="table-shipment-bg product-price-grid einvoice-data-grid"
                         FilterMode="DataGridFilterMode.Simple"
                         Dense="true"
                         Virtualize="true"
                         Height="calc(100vh - 340px)"
                         FixedHeader="true"
                         FixedFooter="true"
                         Bordered="true"
                         RowClass="no-wrap-cell"
                         RowClassFunc="@SelectedRowClassFunc"
                         RowClick="@RowClicked"
                         ColumnResizeMode="ResizeMode.Column"
                         Loading="_loading"
                         MultiSelection="false">
                <Columns>
                    <TemplateColumn Sortable="false" Filterable="false" Width="52px" StickyLeft="true">
                        <HeaderTemplate>
                            <MudCheckBox T="bool"
                                         Value="_selectAll"
                                         ValueChanged="OnSelectAllChanged"
                                         Indeterminate="_selectAllIndeterminate"
                                         Size="Size.Small"
                                         Color="Color.Primary"
                                         Disabled="!_canAdd" />
                        </HeaderTemplate>
                        <CellTemplate>
                            <MudCheckBox T="bool"
                                         Value="@IsRowSelected(context.Item)"
                                         ValueChanged="@(v => SetRowSelected(context.Item, v))"
                                         Size="Size.Small"
                                         Color="Color.Primary"
                                         Disabled="!_canAdd || IsRowPublished(context.Item)"
                                         @onclick:stopPropagation="true" />
                        </CellTemplate>
                    </TemplateColumn>
                    <PropertyColumn Property="x => x.soThuTu" Title="@Localizer["No."]" />
                    <PropertyColumn Property="x => x.sohoadonNoibo" Title="@Localizer["Offline invoice number"]" />
                    <PropertyColumn Property="x => x.sohoadonDientu" Title="@Localizer["Online invoice number"]">
                        <CellTemplate>
                            @if (!string.IsNullOrWhiteSpace(context.Item.sohoadonDientu))
                            {
                                <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                                    <span>@context.Item.sohoadonDientu</span>
                                    <MudChip Color="Color.Success" Size="Size.Small">Đã xuất</MudChip>
                                    @if (IsRowPublished(context.Item))
                                    {
                                        <MudChip Color="Color.Secondary" Size="Size.Small">Đã phát hành</MudChip>
                                    }
                                </MudStack>
                            }
                            else if (IsRowPublished(context.Item))
                            {
                                <MudChip Color="Color.Secondary" Size="Size.Small">Đã phát hành</MudChip>
                            }
                            else
                            {
                                <MudChip Color="Color.Warning" Size="Size.Small">Chưa xuất</MudChip>
                            }
                        </CellTemplate>
                    </PropertyColumn>
                    <PropertyColumn Property="x => CustomerName(x.customerid)" Title="@Localizer["Customer"]" />
                    <PropertyColumn Property="x => ChargeName(x.itemid, x.soThuTu)" Title="@Localizer["Item"]" CellClass="no-wrap-cell" />
                    <PropertyColumn Property="x => x.ngayphathanhhoadonDientu" Title="@Localizer["Invoice issue date"]" Format="dd-MMM-yyyy" />
                    <PropertyColumn Property="x => x.dongia" Title="@Localizer["Unit Price"]" Format="#,##0.##" Culture="@_en" CellClass="custom-right-align" />
                    <PropertyColumn Property="x => x.soluong" Title="@Localizer["Quantity"]" Format="#,##0.##" Culture="@_en" CellClass="custom-right-align" />
                    <PropertyColumn Property="x => x.thanhtien" Title="@Localizer["Total Price"]" Format="#,##0.##" Culture="@_en" CellClass="custom-right-align" />
                    <PropertyColumn Property="x => x.tiente" Title="@Localizer["Loaitiente"]" />
                    <PropertyColumn Property="x => x.tigia" Title="@Localizer["tigia"]" Format="#,##0.##" Culture="@_en" CellClass="custom-right-align" />
                    <PropertyColumn Property="x => x.thue" Title="@Localizer["VAT"]" Format="#,##0.##" Culture="@_en" CellClass="custom-right-align" />
                    <PropertyColumn Property="x => x.thanhtiensauthue" Title="@Localizer["Total Price Inc. VAT"]" Format="#,##0.##" Culture="@_en" CellClass="custom-right-align" />
                    <PropertyColumn Property="x => x.approve" Title="@Localizer["Approve"]">
                        <CellTemplate>
                            @if (context.Item.approve == true)
                            {
                                <MudChip Color="Color.Success" Size="Size.Small">@Localizer["Approve"]</MudChip>
                            }
                            else
                            {
                                <MudChip Color="Color.Default" Size="Size.Small">Chưa duyệt</MudChip>
                            }
                        </CellTemplate>
                    </PropertyColumn>
                    <PropertyColumn Property="x => x.ghiChu" Title="@Localizer["Notes"]" />
                </Columns>
            </MudDataGrid>
                </div>
            </MudPaper>
        </MudTabPanel>

        <MudTabPanel Text="Lịch sử HDDT" Icon="@Icons.Material.Filled.History">
            <div class="einvoice-history-header">
                <MudStack Spacing="0">
                    <MudText Typo="Typo.subtitle2" Class="einvoice-grid-toolbar-title">
                        <MudIcon Icon="@Icons.Material.Filled.History" Size="Size.Small" Class="mr-1" />
                        Lịch sử xuất hóa đơn điện tử
                    </MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        Mở tra cứu hoặc tải PDF/XML từ các lần xuất trước
                    </MudText>
                </MudStack>
                <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="flex-wrap">
                    <MudCheckBox @bind-Value="_historyFilterByHbl"
                                 @bind-Value:after="OnHistoryFilterChangedAsync"
                                 Label="Chỉ HBL đang chọn"
                                 Color="Color.Primary" Dense="true" />
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Refresh"
                               OnClick="LoadExportHistoryAsync"
                               Disabled="_loadingHistory">
                        Tải lại
                    </MudButton>
                </MudStack>
            </div>

            <MudPaper Class="product-price-card" Elevation="0">
                <div class="product-price-grid-wrap">
                <MudDataGrid T="M_EInvoiceExportLog"
                             Items="@_exportHistory"
                             Dense="true"
                             Bordered="true"
                             FixedHeader="true"
                             Height="calc(100vh - 300px)"
                             Loading="_loadingHistory"
                             Filterable="true"
                             FilterMode="DataGridFilterMode.Simple"
                             Class="product-price-grid einvoice-history-grid">
                    <Columns>
                        <TemplateColumn Title="Thao tác" Sortable="false" Filterable="false">
                            <CellTemplate>
                                <MudStack Row="true" Spacing="1">
                                    @if (!string.IsNullOrWhiteSpace(context.Item.ViewUrl))
                                    {
                                        <MudTooltip Text="Mở tra cứu (tab mới)">
                                            <MudIconButton Icon="@Icons.Material.Filled.OpenInNew"
                                                           Size="Size.Small"
                                                           Color="Color.Primary"
                                                           OnClick="@(() => OpenViewUrlAsync(context.Item.ViewUrl))" />
                                        </MudTooltip>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(context.Item.InvoiceId) && !context.Item.IsPublished)
                                    {
                                        <MudTooltip Text="Phát hành HDDT">
                                            <MudIconButton Icon="@Icons.Material.Filled.Publish"
                                                           Size="Size.Small"
                                                           Color="Color.Secondary"
                                                           OnClick="@(() => PublishInvoiceFromHistoryAsync(context.Item))"
                                                           Disabled="_publishing" />
                                        </MudTooltip>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(context.Item.InvoiceId))
                                    {
                                        <MudTooltip Text="Tải PDF">
                                            <MudIconButton Icon="@Icons.Material.Filled.PictureAsPdf"
                                                           Size="Size.Small"
                                                           Color="Color.Error"
                                                           OnClick="@(() => DownloadInvoicePdfAsync(context.Item))"
                                                           Disabled="_downloadingFile" />
                                        </MudTooltip>
                                        <MudTooltip Text="Tải XML">
                                            <MudIconButton Icon="@Icons.Material.Filled.Code"
                                                           Size="Size.Small"
                                                           Color="Color.Info"
                                                           OnClick="@(() => DownloadInvoiceXmlAsync(context.Item))"
                                                           Disabled="_downloadingFile" />
                                        </MudTooltip>
                                    }
                                </MudStack>
                            </CellTemplate>
                        </TemplateColumn>
                        <PropertyColumn Property="x => x.CreatedAt" Title="Ngày xuất" Format="dd/MM/yyyy HH:mm" />
                        <PropertyColumn Property="x => x.SoHoaDonNoiBo" Title="Số HĐ nội bộ" />
                        <PropertyColumn Property="x => x.HblCode" Title="HBL" />
                        <PropertyColumn Property="x => x.CustomerName" Title="Khách hàng" />
                        <PropertyColumn Property="x => x.ExportType" Title="Loại xuất" />
                        <PropertyColumn Property="x => x.IsPublished" Title="Phát hành">
                            <CellTemplate>
                                @if (context.Item.IsPublished)
                                {
                                    <MudChip Color="Color.Secondary" Size="Size.Small">Đã phát hành</MudChip>
                                }
                                else
                                {
                                    <MudChip Color="Color.Default" Size="Size.Small">Chưa phát hành</MudChip>
                                }
                            </CellTemplate>
                        </PropertyColumn>
                        <PropertyColumn Property="x => x.LineCount" Title="Số dòng" />
                        <PropertyColumn Property="x => x.InvoiceId" Title="InvoiceId" />
                        <PropertyColumn Property="x => x.LookupCode" Title="Mã tra cứu" />
                        <PropertyColumn Property="x => x.ViewUrl" Title="ViewUrl" CellClass="no-wrap-cell" />
                        <PropertyColumn Property="x => x.CreatedBy" Title="User" />
                    </Columns>
                </MudDataGrid>
                </div>
            </MudPaper>
        </MudTabPanel>
    </MudTabs>
</div>

@code {
    private const string PermissionMenuName = "E_Invoice";

    private bool _canAdd;
    private bool _canDelete;

    private int _activeTab;
    private MudDataGrid<M_HoaDonDauRa>? _grid;
    private List<M_HoaDonDauRa> _allData = new();
    private List<M_HBL> _hbls = new();
    private List<M_Customer> _customers = new();
    private List<ChargeModel> _charges = new();
    private HashSet<M_HoaDonDauRa> _selectedItems = new();
    private int _selectedCount;
    private bool _selectAll;
    private bool _selectAllIndeterminate;
    private Guid? _selectedHblId;
    private string? _selectedHblCode;
    private M_HBL? _selectedHblDetail;
    private string _usr = string.Empty;
    private bool _loading;
    private bool _onlyApproved = false;
    private bool _onlyNotExported = false;
    private string? _searchString;
    private int _paymentMethod = 2;
    private CultureInfo _en = CultureInfo.GetCultureInfo("en-US");

    // eHoadon API config
    private string _taxNumber = string.Empty;
    private string _tenantId = string.Empty;
    private string _email = string.Empty;
    private string _password = string.Empty;
    private bool _gettingToken;
    private bool _exporting;
    private bool _deletingOnline;
    private bool _publishing;
    private bool _loadingHistory;
    private bool _downloadingFile;
    private bool _historyFilterByHbl = true;
    private string _invoiceSerial = string.Empty;
    private List<M_EInvoiceExportLog> _exportHistory = new();
    private HashSet<string> _publishedInvoiceNos = new(StringComparer.OrdinalIgnoreCase);
    private string _eInvoiceToken = string.Empty;
    private string _tokenPreview => string.IsNullOrEmpty(_eInvoiceToken)
        ? string.Empty
        : (_eInvoiceToken.Length <= 12 ? _eInvoiceToken : $"{_eInvoiceToken[..6]}...{_eInvoiceToken[^4..]}");

    private static readonly JsonSerializerOptions _jsonPascalCase = new()
    {
        PropertyNamingPolicy = null
    };

    private static readonly JsonSerializerOptions _jsonCamelCase = new()
    {
        PropertyNamingPolicy = JsonNamingPolicy.CamelCase,
        DefaultIgnoreCondition = JsonIgnoreCondition.WhenWritingNull
    };

    private List<M_HoaDonDauRa> FilteredData => _allData.Where(MatchFilter).ToList();
    private int _filteredCount => FilteredData.Count;

    private bool _canPublishSelected =>
        _selectedCount > 0
        && _selectedItems.All(x => !string.IsNullOrWhiteSpace(x.sohoadonDientu))
        && _selectedItems.All(x => !IsRowPublished(x));

    private bool _canDeleteOnlineSelected =>
        _selectedCount > 0
        && _selectedItems.All(x => !string.IsNullOrWhiteSpace(x.sohoadonDientu))
        && _selectedItems.All(x => !IsRowPublished(x));

    private int SelectableRowCount => FilteredData.Count(x => !IsRowPublished(x));

    private bool IsRowPublished(M_HoaDonDauRa item)
    {
        var invoiceNo = item.sohoadonNoibo?.Trim();
        return !string.IsNullOrWhiteSpace(invoiceNo) && _publishedInvoiceNos.Contains(invoiceNo);
    }

    protected override async Task OnInitializedAsync()
    {
        _usr = asv.GetAuth().Result.User.Identity!.Name!;
        _canAdd = await ssv.CheckPermission(_usr, "Add", PermissionMenuName);
        _canDelete = await ssv.CheckPermission(_usr, "Delete", PermissionMenuName);
        _hbls = await shipsv.GetListHBLALL();
        _customers = await csv.GetList();
        _charges = await supsv.GetListCharge();
        await LoadEInvoiceConfigFromCompanyAsync();
    }

    private async Task OnTabChangedAsync()
    {
        if (_activeTab == 1)
            await LoadExportHistoryAsync();
    }

    private async Task OnHistoryFilterChangedAsync()
    {
        await LoadExportHistoryAsync();
    }

    private async Task LoadEInvoiceConfigFromCompanyAsync()
    {
        try
        {
            var companies = await gsv.Get_Company_info();
            var company = companies.FirstOrDefault();

            if (company == null)
            {
                Snackbar.Add("Chưa có thông tin công ty. Vui lòng cấu hình tại 1.13 Thông tin công ty.", MudBlazor.Severity.Warning);
                return;
            }

            _taxNumber = company.TaxNumber_E_Invoice?.Trim() ?? string.Empty;
            _tenantId = company.TenantID?.Trim() ?? string.Empty;
            _email = company.Email_E_invoice?.Trim() ?? string.Empty;
            _password = company.Password_E_invoice ?? string.Empty;
            _invoiceSerial = company.Serial_E_Invoice?.Trim() ?? string.Empty;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Không tải được cấu hình eHoadon: {ex.Message}", MudBlazor.Severity.Error);
        }
    }

    private async Task<IEnumerable<Guid?>> SearchHBL(string text)
    {
        await Task.CompletedTask;

        if (string.IsNullOrWhiteSpace(text))
            return _hbls.Select(x => (Guid?)x.hblID);

        return _hbls
            .Where(x => !string.IsNullOrEmpty(x.hbl) &&
                        x.hbl.Contains(text, StringComparison.OrdinalIgnoreCase))
            .Select(x => (Guid?)x.hblID);
    }

    private string HblIdToCode(Guid? hblId)
    {
        if (!hblId.HasValue || hblId.Value == Guid.Empty)
            return string.Empty;

        return _hbls.FirstOrDefault(x => x.hblID == hblId.Value)?.hbl ?? string.Empty;
    }

    private bool MatchFilter(M_HoaDonDauRa item)
    {
        if (_onlyApproved && item.approve != true)
            return false;

        if (_onlyNotExported && !string.IsNullOrWhiteSpace(item.sohoadonDientu))
            return false;

        if (!string.IsNullOrWhiteSpace(_searchString))
        {
            var text = _searchString.Trim();
            var match =
                (item.sohoadonNoibo?.Contains(text, StringComparison.OrdinalIgnoreCase) == true) ||
                (item.sohoadonDientu?.Contains(text, StringComparison.OrdinalIgnoreCase) == true) ||
                (CustomerName(item.customerid).Contains(text, StringComparison.OrdinalIgnoreCase)) ||
                (ChargeName(item.itemid, item.soThuTu).Contains(text, StringComparison.OrdinalIgnoreCase));

            if (!match)
                return false;
        }

        return true;
    }

    private string CustomerName(Guid customerId)
    {
        if (customerId == Guid.Empty)
            return string.Empty;

        var customer = _customers.FirstOrDefault(x => x.Customer_ID == customerId);
        return customer == null ? string.Empty : $"{customer.Customer_Code} - {customer.COMPANY}";
    }

    private string ChargeName(Guid itemId, int? soThuTu = null)
    {
        if (itemId == Guid.Empty)
            return string.Empty;

        var charge = _charges.FirstOrDefault(x => x.CHARGE_ID == itemId);
        if (charge == null)
            return string.Empty;

        return soThuTu.HasValue ? $"{soThuTu}) {charge.CHARGE}" : charge.CHARGE;
    }

    private bool IsRowSelected(M_HoaDonDauRa item) =>
        _selectedItems.Any(x => x.hoadondauraid == item.hoadondauraid);

    private string SelectedRowClassFunc(M_HoaDonDauRa item, int rowNumber)
    {
        if (IsRowPublished(item))
            return "einvoice-row-published";

        return IsRowSelected(item) ? "einvoice-row-selected" : string.Empty;
    }

    private void RowClicked(DataGridRowClickEventArgs<M_HoaDonDauRa> args)
    {
        if (!_canAdd || IsRowPublished(args.Item))
            return;

        SetRowSelected(args.Item, !IsRowSelected(args.Item));
    }

    private static bool SameInvoiceAndCustomer(M_HoaDonDauRa a, M_HoaDonDauRa b) =>
        string.Equals(a.sohoadonNoibo?.Trim(), b.sohoadonNoibo?.Trim(), StringComparison.OrdinalIgnoreCase)
        && a.customerid == b.customerid;

    private static bool SameCustomerAndTax(M_HoaDonDauRa a, M_HoaDonDauRa b) =>
        a.customerid == b.customerid && (a.thue ?? 0) == (b.thue ?? 0);

    private static double NormalizeTaxRate(double? thue) => thue ?? 0;

    private bool CanAddToSelection(M_HoaDonDauRa item)
    {
        if (IsRowPublished(item))
            return false;

        if (!_selectedItems.Any())
            return true;

        return SameCustomerAndTax(_selectedItems.First(), item);
    }

    private void SetRowSelected(M_HoaDonDauRa item, bool selected)
    {
        if (selected && IsRowPublished(item))
        {
            Snackbar.Add("Hóa đơn đã phát hành, không thể thao tác.", MudBlazor.Severity.Warning);
            return;
        }

        var existing = _selectedItems.FirstOrDefault(x => x.hoadondauraid == item.hoadondauraid);
        if (selected)
        {
            if (existing == null)
            {
                if (!CanAddToSelection(item))
                {
                    Snackbar.Add("Chỉ chọn được các dòng cùng khách hàng và cùng thuế suất.", MudBlazor.Severity.Warning);
                    return;
                }

                _selectedItems.Add(item);
            }
        }
        else if (existing != null)
        {
            _selectedItems.Remove(existing);
        }

        NotifySelectionChanged();
    }

    private void OnSelectAllChanged(bool value)
    {
        _selectedItems.Clear();
        if (value)
        {
            var data = FilteredData.Where(x => !IsRowPublished(x)).ToList();
            if (data.Count == 0)
            {
                Snackbar.Add("Không có dòng nào có thể chọn (đã phát hành hoặc không có dữ liệu).", MudBlazor.Severity.Warning);
                NotifySelectionChanged();
                return;
            }

            var first = data[0];
            if (data.Any(x => !SameCustomerAndTax(first, x)))
            {
                Snackbar.Add("Không thể chọn tất cả: dữ liệu phải cùng khách hàng và cùng thuế suất.", MudBlazor.Severity.Warning);
                NotifySelectionChanged();
                return;
            }

            foreach (var item in data)
                _selectedItems.Add(item);
        }

        NotifySelectionChanged();
    }

    private void NotifySelectionChanged()
    {
        _selectedCount = _selectedItems.Count;
        var selectableCount = SelectableRowCount;
        _selectAll = selectableCount > 0 && _selectedCount == selectableCount;
        _selectAllIndeterminate = _selectedCount > 0 && _selectedCount < selectableCount;
        StateHasChanged();
    }

    private async Task LoadPublishedInvoiceNosAsync()
    {
        _publishedInvoiceNos = await eInvoiceSv.GetPublishedSoHoaDonNoiBoAsync(_selectedHblId);
    }

    private async Task Search()
    {
        try
        {
            _loading = true;
            _selectedItems.Clear();
            _selectedCount = 0;
            _selectAll = false;
            _selectAllIndeterminate = false;
            _allData.Clear();
            _selectedHblCode = null;
            _selectedHblDetail = null;

            if (!await ssv.CheckPermission(_usr, "View", PermissionMenuName))
            {
                Snackbar.Add("Bạn không có quyền xem dữ liệu E-Invoice (E_Invoice · View).", MudBlazor.Severity.Warning);
                return;
            }

            if (!_selectedHblId.HasValue || _selectedHblId.Value == Guid.Empty)
            {
                Snackbar.Add("Vui lòng chọn HBL trước khi tìm kiếm.", MudBlazor.Severity.Warning);
                return;
            }

            _selectedHblCode = HblIdToCode(_selectedHblId);
            _selectedHblDetail = await shipsv.GetHBL_byHBLid(_selectedHblId);
            _allData = (await shipsv.GetListHoaDonDauRaHBL(_selectedHblId))
                .OrderBy(x => x.sohoadonNoibo ?? string.Empty, StringComparer.OrdinalIgnoreCase)
                .ThenBy(x => x.soThuTu ?? 0)
                .ToList();

            await LoadPublishedInvoiceNosAsync();

            Snackbar.Add($"Tìm thấy {_allData.Count} dòng hóa đơn đầu ra cho HBL {_selectedHblCode}.", MudBlazor.Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, MudBlazor.Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task<bool> ValidateExportSelectionAsync()
    {
        if (!_selectedItems.Any())
        {
            Snackbar.Add("Vui lòng chọn ít nhất một dòng hóa đơn.", MudBlazor.Severity.Warning);
            return false;
        }

        if (!await ssv.CheckPermission(_usr, "Add", PermissionMenuName))
        {
            Snackbar.Add("Bạn không có quyền xuất hóa đơn điện tử (E_Invoice · Add).", MudBlazor.Severity.Warning);
            return false;
        }

        if (string.IsNullOrWhiteSpace(_taxNumber))
        {
            Snackbar.Add("Chưa có TaxNumber E-Invoice trong Thông tin công ty (1.13).", MudBlazor.Severity.Warning);
            return false;
        }

        if (_selectedItems.Any(x => x.approve != true))
        {
            Snackbar.Add("Chỉ được xuất các dòng đã duyệt.", MudBlazor.Severity.Warning);
            return false;
        }

        if (_selectedItems.Any(x => !string.IsNullOrWhiteSpace(x.sohoadonDientu)))
        {
            Snackbar.Add("Có dòng đã có số hóa đơn điện tử trong danh sách đã chọn.", MudBlazor.Severity.Warning);
            return false;
        }

        if (_selectedItems.Any(x => string.IsNullOrWhiteSpace(x.sohoadonNoibo)))
        {
            Snackbar.Add("Có dòng chưa có số hóa đơn nội bộ.", MudBlazor.Severity.Warning);
            return false;
        }

        if (_selectedItems.Any(IsRowPublished))
        {
            Snackbar.Add("Có hóa đơn đã phát hành trong danh sách đã chọn.", MudBlazor.Severity.Warning);
            return false;
        }

        return true;
    }

    private async Task DeleteOnlineInvoiceAsync()
    {
        if (!await ssv.CheckPermission(_usr, "Delete", PermissionMenuName))
        {
            Snackbar.Add("Bạn không có quyền xóa số HĐ online (E_Invoice · Delete).", MudBlazor.Severity.Warning);
            return;
        }

        var items = _selectedItems
            .Where(x => !string.IsNullOrWhiteSpace(x.sohoadonDientu))
            .ToList();

        if (items.Count == 0)
        {
            Snackbar.Add("Chọn ít nhất một dòng đã có số hóa đơn điện tử.", MudBlazor.Severity.Warning);
            return;
        }

        if (items.Any(IsRowPublished))
        {
            Snackbar.Add("Không thể xóa số HĐ online của hóa đơn đã phát hành.", MudBlazor.Severity.Warning);
            return;
        }

        var distinctOnlineNos = items
            .Select(x => x.sohoadonDientu!.Trim())
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();
        var summary = string.Join(", ", distinctOnlineNos.Take(3));
        if (distinctOnlineNos.Count > 3)
            summary += "...";

        var confirm = await DialogService.ShowMessageBox(
            "Xóa số hóa đơn online",
            $"Xóa HĐ trên eHoadon và xóa số HĐ điện tử ({items.Count} dòng: {summary})? Các dòng sẽ chuyển về trạng thái chưa xuất.",
            yesText: "Xóa",
            cancelText: "Hủy");

        if (confirm != true)
            return;

        await LoadEInvoiceConfigFromCompanyAsync();
        if (string.IsNullOrWhiteSpace(_taxNumber))
        {
            Snackbar.Add("Chưa có TaxNumber E-Invoice trong Thông tin công ty (1.13).", MudBlazor.Severity.Warning);
            return;
        }

        if (!await GetTokenAsync())
            return;

        try
        {
            _deletingOnline = true;
            var successCount = 0;
            var invoiceNos = items
                .Select(x => x.sohoadonNoibo!.Trim())
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .ToList();
            var deletedInvoiceIds = new List<string>();

            foreach (var invoiceNo in invoiceNos)
            {
                var groupItems = items
                    .Where(x => string.Equals(x.sohoadonNoibo?.Trim(), invoiceNo, StringComparison.OrdinalIgnoreCase))
                    .ToList();

                var invoiceIds = await ResolveInvoiceIdsBySoHoaDonNoiBoAsync(new List<string> { invoiceNo });
                if (invoiceIds.Count == 0)
                {
                    Snackbar.Add($"[{invoiceNo}] Không tìm thấy invoiceId trong lịch sử xuất HDDT.", MudBlazor.Severity.Warning);
                    continue;
                }

                var invoiceId = invoiceIds[0];
                var deleteResult = await CallDeleteEInvoiceApiAsync(invoiceId);
                if (!deleteResult.Success)
                {
                    Snackbar.Add($"[{invoiceNo}] Xóa trên eHoadon thất bại: {deleteResult.Message}", MudBlazor.Severity.Error);
                    continue;
                }

                foreach (var item in groupItems)
                {
                    var original = JsonSerializer.Deserialize<M_HoaDonDauRa>(JsonSerializer.Serialize(item))!;
                    item.sohoadonDientu = null;
                    item.ngayphathanhhoadonDientu = null;
                    item.userupdate = _usr;
                    item.dateupdate = DateTime.Now.ToString();

                    var updateResult = await shipsv.UpdateHoaDonDauRaMBL(item, original);
                    if (updateResult.Flag)
                        successCount++;
                    else
                        Snackbar.Add($"{invoiceNo}: {updateResult.Message}", MudBlazor.Severity.Error);
                }

                deletedInvoiceIds.Add(invoiceId);
            }

            if (deletedInvoiceIds.Count > 0)
            {
                var logResult = await eInvoiceSv.DeactivateExportLogsByInvoiceIdsAsync(deletedInvoiceIds);
                if (!logResult.Flag)
                    Snackbar.Add(logResult.Message, MudBlazor.Severity.Warning);
            }

            if (successCount > 0)
            {
                Snackbar.Add($"Đã xóa HĐ online (eHoadon + hệ thống) cho {successCount} dòng.", MudBlazor.Severity.Success);
                _selectedItems.Clear();
                NotifySelectionChanged();
                await Search();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Lỗi xóa số HĐ online: {ex.Message}", MudBlazor.Severity.Error);
        }
        finally
        {
            _deletingOnline = false;
        }
    }

    private async Task ExportNormalAsync()
    {
        if (!await ValidateExportSelectionAsync())
            return;

        if (_selectedItems.Count >= 2)
        {
            if (_selectedItems.Select(x => x.customerid).Distinct().Count() != 1)
            {
                Snackbar.Add("Xuất HDDT thường: các dòng phải cùng khách hàng.", MudBlazor.Severity.Warning);
                return;
            }

            if (_selectedItems.Select(x => NormalizeTaxRate(x.thue)).Distinct().Count() != 1)
            {
                Snackbar.Add("Xuất HDDT thường: các dòng phải cùng thuế suất.", MudBlazor.Severity.Warning);
                return;
            }

            if (_selectedItems
                    .Select(x => x.sohoadonNoibo!.Trim())
                    .Distinct(StringComparer.OrdinalIgnoreCase)
                    .Count() != 1)
            {
                Snackbar.Add("Xuất HDDT thường: các dòng phải cùng số hóa đơn nội bộ.", MudBlazor.Severity.Warning);
                return;
            }
        }

        var items = _selectedItems.OrderBy(x => x.soThuTu ?? 0).ToList();
        var invoiceNo = items[0].sohoadonNoibo!.Trim();
        var groups = new List<InvoiceExportGroup> { new(invoiceNo, items) };

        string confirmMessage;
        if (items.Count == 1)
        {
            var row = items[0];
            confirmMessage = $"Xuất 1 dòng HĐ nội bộ [{invoiceNo}] — {ChargeName(row.itemid, row.soThuTu)}?";
        }
        else
        {
            confirmMessage = $"Xuất {items.Count} dòng HĐ nội bộ [{invoiceNo}]?";
        }

        var confirm = await DialogService.ShowMessageBox(
            "Xuất hóa đơn điện tử",
            confirmMessage,
            yesText: "Xuất",
            cancelText: "Hủy");

        if (confirm != true)
            return;

        var exportOptions = await PromptExportNoteAsync();
        if (exportOptions is null)
            return;

        if (!await GetTokenAsync())
            return;

        try
        {
            _exporting = true;
            var successCount = await ExportViaBulkApiAsync(groups, mergedProductName: null, exportOptions!, "Normal");
            if (successCount > 0)
            {
                Snackbar.Add("Xuất HDDT thành công.", MudBlazor.Severity.Success);
                _selectedItems.Clear();
                NotifySelectionChanged();
                await Search();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Lỗi xuất HDDT: {ex.Message}", MudBlazor.Severity.Error);
        }
        finally
        {
            _exporting = false;
        }
    }

