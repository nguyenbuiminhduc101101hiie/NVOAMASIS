@page "/ContainerInventory"
@page "/container/inventory"

@using System.Data
@using System.Data.Common
@using System.Text
@using Microsoft.EntityFrameworkCore
@using Microsoft.JSInterop
@using MudBlazor
@using NVOAMASIS.Data

@attribute [Authorize]

@inject IDbContextFactory<AppDbContext> DbFactory
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject NavigationManager Navigation

<PageTitle>8.3.3 Container Inventory</PageTitle>

<div class="container-inventory-page">
    <MudPaper Class="ci-header pa-4 mb-3" Elevation="0">
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="flex-wrap" Spacing="2">
            <div>
                <MudText Typo="Typo.h5" Class="ci-title">8.3.3 Container Inventory</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    Statistics from all yard/import tables using one common inventory logic: Current In Yard + In/Out Yard + VSS import/export tables.
                </MudText>
                @if (!string.IsNullOrWhiteSpace(_sourceInfo))
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Data source: @_sourceInfo</MudText>
                }
            </div>

            <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center" Class="flex-wrap">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Success"
                           Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.UploadFile"
                           OnClick="OpenImport834Async"
                           Disabled="_busy">
                    8.3.4 Import
                </MudButton>

                <MudButton Variant="Variant.Filled"
                           Color="Color.Info"
                           Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.UploadFile"
                           OnClick="OpenImport835Async"
                           Disabled="_busy">
                    8.3.5 Import
                </MudButton>

                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Refresh"
                           OnClick="LoadAsync"
                           Disabled="_busy">
                    Refresh
                </MudButton>

                <MudButton Variant="Variant.Outlined"
                           Color="Color.Success"
                           Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.FileDownload"
                           OnClick="ExportCsvAsync"
                           Disabled="_busy || !FilteredRecords.Any()">
                    CSV
                </MudButton>

                <MudButton Variant="Variant.Outlined"
                           Color="Color.Secondary"
                           Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Print"
                           OnClick="PrintAsync"
                           Disabled="_busy">
                    Print
                </MudButton>
            </MudStack>
        </MudStack>
    </MudPaper>

    @if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <MudAlert Severity="MudBlazor.Severity.Error" Variant="Variant.Filled" Dense="true" Class="mb-2">
            @_errorMessage
        </MudAlert>
    }

    <MudPaper Class="ci-card pa-3 mb-3" Elevation="0">
        <MudGrid Spacing="2" AlignItems="Center">
            <MudItem xs="12" md="3">
                <MudTextField @bind-Value="_search"
                              Label="Search"
                              Placeholder="Container, BOOK, BL, depot, port, vessel..."
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Immediate="true"
                              Clearable="true"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search" />
            </MudItem>

            <MudItem xs="12" md="2">
                <MudSelect T="string" @bind-Value="_sourceFilter" Label="Source" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Clearable="true">
                    @foreach (var v in SourceOptions)
                    {
                        <MudSelectItem T="string" Value="@v">@v</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            <MudItem xs="12" md="2">
                <MudSelect T="string" @bind-Value="_agentFilter" Label="AGENT" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Clearable="true">
                    @foreach (var v in AgentOptions)
                    {
                        <MudSelectItem T="string" Value="@v">@v</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            <MudItem xs="12" md="2">
                <MudSelect T="string" @bind-Value="_lineFilter" Label="LINE" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Clearable="true">
                    @foreach (var v in LineOptions)
                    {
                        <MudSelectItem T="string" Value="@v">@v</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            <MudItem xs="12" md="2">
                <MudSelect T="string" @bind-Value="_depotFilter" Label="DEPOT" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Clearable="true">
                    @foreach (var v in DepotOptions)
                    {
                        <MudSelectItem T="string" Value="@v">@v</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            <MudItem xs="12" md="2">
                <MudSelect T="string" @bind-Value="_sizeFilter" Label="Size/Type" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Clearable="true">
                    <MudSelectItem T="string" Value="@("20DC")">20DC</MudSelectItem>
                    <MudSelectItem T="string" Value="@("40HC")">40HC / 40HQ</MudSelectItem>
                    <MudSelectItem T="string" Value="@("OTHER")">OTHER</MudSelectItem>
                </MudSelect>
            </MudItem>

            <MudItem xs="12" md="2">
                <MudSelect T="string" @bind-Value="_statusFilter" Label="Status" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Clearable="true">
                    <MudSelectItem T="string" Value="@StatusInDepot">In Depot</MudSelectItem>
                    <MudSelectItem T="string" Value="@StatusWaitingPort">Waiting Port Arrival</MudSelectItem>
                    <MudSelectItem T="string" Value="@StatusArrivedPort">Arrived at Port</MudSelectItem>
                    <MudSelectItem T="string" Value="@StatusInTransit">In Transit</MudSelectItem>
                </MudSelect>
            </MudItem>

            <MudItem xs="12" md="1">
                <MudCheckBox T="bool" @bind-Checked="_excludeDamaged" Label="Hide DAM" Color="Color.Primary" />
            </MudItem>
        </MudGrid>
    </MudPaper>

    <MudGrid Spacing="3" Class="mb-3">
        <MudItem xs="12" md="3">
            <MudPaper Class="ci-kpi kpi-depot pa-4" Elevation="1">
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                    <div>
                        <MudText Typo="Typo.subtitle2" Class="fw-bold">In Depot</MudText>
                        <MudText Typo="Typo.caption">Container</MudText>
                        <MudText Typo="Typo.h4" Class="ci-kpi-number">@InDepotRecords.Count.ToString("N0")</MudText>
                    </div>
                    <MudAvatar Color="Color.Primary" Size="Size.Large">
                        <MudIcon Icon="@Icons.Material.Filled.Inventory2" />
                    </MudAvatar>
                </MudStack>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="3">
            <MudPaper Class="ci-kpi kpi-wait pa-4" Elevation="1">
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                    <div>
                        <MudText Typo="Typo.subtitle2" Class="fw-bold">Waiting Port Arrival</MudText>
                        <MudText Typo="Typo.caption">Container</MudText>
                        <MudText Typo="Typo.h4" Class="ci-kpi-number">@WaitingPortRecords.Count.ToString("N0")</MudText>
                    </div>
                    <MudAvatar Color="Color.Info" Size="Size.Large">
                        <MudIcon Icon="@Icons.Material.Filled.PendingActions" />
                    </MudAvatar>
                </MudStack>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="3">
            <MudPaper Class="ci-kpi kpi-port pa-4" Elevation="1">
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                    <div>
                        <MudText Typo="Typo.subtitle2" Class="fw-bold">Arrived at Port</MudText>
                        <MudText Typo="Typo.caption">Container</MudText>
                        <MudText Typo="Typo.h4" Class="ci-kpi-number">@ArrivedPortRecords.Count.ToString("N0")</MudText>
                    </div>
                    <MudAvatar Color="Color.Success" Size="Size.Large">
                        <MudIcon Icon="@Icons.Material.Filled.LocalShipping" />
                    </MudAvatar>
                </MudStack>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="3">
            <MudPaper Class="ci-kpi kpi-transit pa-4" Elevation="1">
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                    <div>
                        <MudText Typo="Typo.subtitle2" Class="fw-bold">In Transit</MudText>
                        <MudText Typo="Typo.caption">Container</MudText>
                        <MudText Typo="Typo.h4" Class="ci-kpi-number">@InTransitRecords.Count.ToString("N0")</MudText>
                    </div>
                    <MudAvatar Color="Color.Warning" Size="Size.Large">
                        <MudIcon Icon="@Icons.Material.Filled.DirectionsBoat" />
                    </MudAvatar>
                </MudStack>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <MudGrid Spacing="3">
        <MudItem xs="12" lg="6">
            <MudPaper Class="ci-card pa-3" Elevation="1">
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-2">
                    <MudText Typo="Typo.subtitle1" Class="ci-section-title">IN DEPOT</MudText>
                    <MudChip T="string" Color="Color.Primary" Variant="Variant.Outlined" Size="Size.Small">@InDepotRecords.Count.ToString("N0") cont</MudChip>
                </MudStack>

                <MudDataGrid T="ContainerGroupRow" Items="InDepotGroupRows" Dense="true" Hover="true" Bordered="true" Striped="true" Filterable="true" FixedHeader="true" Height="330px">
                    <Columns>
                        <PropertyColumn Property="x => x.Depot" Title="DEPOT" />
                        <PropertyColumn Property="x => x.Agent" Title="AGENT" />
                        <PropertyColumn Property="x => x.Line" Title="LINE" />
                        <PropertyColumn Property="x => x.ContainerType" Title="CONTAINER TYPE" />
                        <PropertyColumn Property="x => x.ContainerCount" Title="TOTAL" CellClass="text-end fw-bold" HeaderClass="text-end" />
                        <PropertyColumn Property="x => x.EmptyCount" Title="E - Empty" CellClass="text-end" HeaderClass="text-end" />
                        <PropertyColumn Property="x => x.FullCount" Title="F - Full" CellClass="text-end" HeaderClass="text-end" />
                        <PropertyColumn Property="x => x.DamagedCount" Title="D - Damage" CellClass="text-end" HeaderClass="text-end" />
                        <PropertyColumn Property="x => x.OtherFelCount" Title="Other" CellClass="text-end" HeaderClass="text-end" />
                    </Columns>
                    <PagerContent>
                        <MudDataGridPager T="ContainerGroupRow" PageSizeOptions="new int[] { 10, 25, 50 }" />
                    </PagerContent>
                </MudDataGrid>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" lg="6">
            <MudPaper Class="ci-card pa-3" Elevation="1">
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-2">
                    <MudText Typo="Typo.subtitle1" Class="ci-section-title">ARRIVED AT PORT</MudText>
                    <MudChip T="string" Color="Color.Success" Variant="Variant.Outlined" Size="Size.Small">@ArrivedPortRecords.Count.ToString("N0") cont</MudChip>
                </MudStack>

                <MudDataGrid T="ContainerGroupRow" Items="ArrivedPortGroupRows" Dense="true" Hover="true" Bordered="true" Striped="true" Filterable="true" FixedHeader="true" Height="330px">
                    <Columns>
                        <PropertyColumn Property="x => x.Depot" Title="DEPOT" />
                        <PropertyColumn Property="x => x.Agent" Title="AGENT" />
                        <PropertyColumn Property="x => x.Line" Title="LINE" />
                        <PropertyColumn Property="x => x.ContainerType" Title="CONTAINER TYPE" />
                        <PropertyColumn Property="x => x.ContainerCount" Title="TOTAL" CellClass="text-end fw-bold" HeaderClass="text-end" />
                        <PropertyColumn Property="x => x.EmptyCount" Title="E - Empty" CellClass="text-end" HeaderClass="text-end" />
                        <PropertyColumn Property="x => x.FullCount" Title="F - Full" CellClass="text-end" HeaderClass="text-end" />
                        <PropertyColumn Property="x => x.DamagedCount" Title="D - Damage" CellClass="text-end" HeaderClass="text-end" />
                        <PropertyColumn Property="x => x.OtherFelCount" Title="Other" CellClass="text-end" HeaderClass="text-end" />
                    </Columns>
                    <PagerContent>
                        <MudDataGridPager T="ContainerGroupRow" PageSizeOptions="new int[] { 10, 25, 50 }" />
                    </PagerContent>
                </MudDataGrid>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" lg="6">
            <MudPaper Class="ci-card pa-3" Elevation="1">
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-2">
                    <MudText Typo="Typo.subtitle1" Class="ci-section-title">WAITING PORT ARRIVAL</MudText>
                    <MudChip T="string" Color="Color.Info" Variant="Variant.Outlined" Size="Size.Small">@WaitingPortRecords.Count.ToString("N0") cont</MudChip>
                </MudStack>

                <MudDataGrid T="ContainerGroupRow" Items="WaitingPortGroupRows" Dense="true" Hover="true" Bordered="true" Striped="true" Filterable="true" FixedHeader="true" Height="300px">
                    <Columns>
                        <PropertyColumn Property="x => x.Depot" Title="DEPOT" />
                        <PropertyColumn Property="x => x.Agent" Title="AGENT" />
                        <PropertyColumn Property="x => x.Line" Title="LINE" />
                        <PropertyColumn Property="x => x.ContainerType" Title="CONTAINER TYPE" />
                        <PropertyColumn Property="x => x.ContainerCount" Title="TOTAL" CellClass="text-end fw-bold" HeaderClass="text-end" />
                        <PropertyColumn Property="x => x.EmptyCount" Title="E - Empty" CellClass="text-end" HeaderClass="text-end" />
                        <PropertyColumn Property="x => x.FullCount" Title="F - Full" CellClass="text-end" HeaderClass="text-end" />
                        <PropertyColumn Property="x => x.DamagedCount" Title="D - Damage" CellClass="text-end" HeaderClass="text-end" />
                        <PropertyColumn Property="x => x.OtherFelCount" Title="Other" CellClass="text-end" HeaderClass="text-end" />
                    </Columns>
                    <PagerContent>
                        <MudDataGridPager T="ContainerGroupRow" PageSizeOptions="new int[] { 10, 25, 50 }" />
                    </PagerContent>
                </MudDataGrid>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" lg="6">
            <MudPaper Class="ci-card pa-3" Elevation="1">
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-2">
                    <MudText Typo="Typo.subtitle1" Class="ci-section-title">IN TRANSIT</MudText>
                    <MudChip T="string" Color="Color.Warning" Variant="Variant.Outlined" Size="Size.Small">@InTransitRecords.Count.ToString("N0") cont</MudChip>
                </MudStack>

                <MudDataGrid T="ContainerGroupRow" Items="InTransitGroupRows" Dense="true" Hover="true" Bordered="true" Striped="true" Filterable="true" FixedHeader="true" Height="300px">
                    <Columns>
                        <PropertyColumn Property="x => x.Depot" Title="DEPOT" />
                        <PropertyColumn Property="x => x.Agent" Title="AGENT" />
                        <PropertyColumn Property="x => x.Line" Title="LINE" />
                        <PropertyColumn Property="x => x.ContainerType" Title="CONTAINER TYPE" />
                        <PropertyColumn Property="x => x.ContainerCount" Title="TOTAL" CellClass="text-end fw-bold" HeaderClass="text-end" />
                        <PropertyColumn Property="x => x.EmptyCount" Title="E - Empty" CellClass="text-end" HeaderClass="text-end" />
                        <PropertyColumn Property="x => x.FullCount" Title="F - Full" CellClass="text-end" HeaderClass="text-end" />
                        <PropertyColumn Property="x => x.DamagedCount" Title="D - Damage" CellClass="text-end" HeaderClass="text-end" />
                        <PropertyColumn Property="x => x.OtherFelCount" Title="Other" CellClass="text-end" HeaderClass="text-end" />
                    </Columns>
                    <PagerContent>
                        <MudDataGridPager T="ContainerGroupRow" PageSizeOptions="new int[] { 10, 25, 50 }" />
                    </PagerContent>
                </MudDataGrid>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <MudPaper Class="ci-card pa-3 mt-3" Elevation="1">
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-2 flex-wrap">
            <div>
                <MudText Typo="Typo.subtitle1" Class="ci-section-title">CONTAINER DETAIL</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">Rows: @FilteredRecords.Count.ToString("N0") / @_records.Count.ToString("N0")</MudText>
            </div>
            <MudChip T="string" Color="Color.Secondary" Variant="Variant.Outlined" Size="Size.Small">Distinct container by latest event</MudChip>
        </MudStack>

        <MudDataGrid T="ContainerRecord"
                     Items="FilteredRecords"
                     Dense="true"
                     Hover="true"
                     Bordered="true"
                     Striped="true"
                     Filterable="true"
                     FixedHeader="true"
                     Height="480px"
                     Class="ci-detail-grid ci-click-grid"
                     Loading="_busy"
                     RowClick="OnContainerRowClick"
                     @bind-SelectedItem="_selectedRecord">
            <Columns>
                <PropertyColumn Property="x => x.SourceTable" Title="Latest Source" />
                <PropertyColumn Property="x => x.SourceType" Title="Source Type" />
                <PropertyColumn Property="x => x.DuplicateCount" Title="Dup Rows" CellClass="text-end fw-bold" HeaderClass="text-end" />
                <PropertyColumn Property="x => x.DuplicateSourceTables" Title="Dup Sources" />
                <PropertyColumn Property="x => x.DuplicateEventHistory" Title="Dup Event History" />
                <PropertyColumn Property="x => x.Status" Title="Status" />
                <PropertyColumn Property="x => x.StatusReason" Title="Status Reason" />
                <PropertyColumn Property="x => x.EventMethod" Title="Method" />
                <PropertyColumn Property="x => x.EventTs" Title="Event Time" Format="dd/MM/yyyy HH:mm" />
                <PropertyColumn Property="x => x.AGENT" Title="AGENT" />
                <PropertyColumn Property="x => x.LINE" Title="LINE" />
                <PropertyColumn Property="x => x.DEPOT" Title="DEPOT" />
                <PropertyColumn Property="x => x.ITEM_NO" Title="Container" />
                <PropertyColumn Property="x => x.ISO" Title="ISO / Size" />
                <PropertyColumn Property="x => x.SizeType" Title="Size Group" />
                <PropertyColumn Property="x => x.FEL" Title="F/E/D" />
                <PropertyColumn Property="x => x.WEIGHT" Title="WEIGHT" Format="N2" CellClass="text-end" HeaderClass="text-end" />
                <PropertyColumn Property="x => x.VGM_WEIGHT" Title="VGM" Format="N2" CellClass="text-end" HeaderClass="text-end" />
                <PropertyColumn Property="x => x.BOOK_NO" Title="BOOK_NO" />
                <PropertyColumn Property="x => x.BILL_OF_LADING" Title="B/L" />
                <PropertyColumn Property="x => x.LOCATION" Title="LOCATION" />
                <PropertyColumn Property="x => x.CATEGORY" Title="CATEGORY" />
                <PropertyColumn Property="x => x.ARR_BY" Title="ARR_BY" />
                <PropertyColumn Property="x => x.ARR_CAR" Title="ARR_CAR" />
                <PropertyColumn Property="x => x.ARR_VES_NAME" Title="ARR VESSEL" />
                <PropertyColumn Property="x => x.ARR_TS" Title="ARR_TS" Format="dd/MM/yyyy HH:mm" />
                <PropertyColumn Property="x => x.DEP_BY" Title="DEP_BY" />
                <PropertyColumn Property="x => x.DEP_CAR" Title="DEP_CAR" />
                <PropertyColumn Property="x => x.DEP_VES_NAME" Title="DEP VESSEL" />
                <PropertyColumn Property="x => x.DEP_TS" Title="DEP_TS" Format="dd/MM/yyyy HH:mm" />
                <PropertyColumn Property="x => x.DISCH_PORT" Title="DISCH_PORT" />
                <PropertyColumn Property="x => x.FINAL_DISCH_PORT" Title="FINAL_DISCH" />
                <PropertyColumn Property="x => x.PLACE_OF_RECEIPT" Title="POR" />
                <PropertyColumn Property="x => x.PLACE_OF_DELIVERY" Title="POD/DEL" />
                <PropertyColumn Property="x => x.DGS_CLASS" Title="DGS" />
                <PropertyColumn Property="x => x.DAM" Title="DAM" />
                <PropertyColumn Property="x => x.SOSEAL" Title="SOSEAL" />
                <PropertyColumn Property="x => x.GHICHU" Title="NOTE" />
                <PropertyColumn Property="x => x.STORAGEDAY" Title="Storage Days" />
                <PropertyColumn Property="x => x.DateImport" Title="DateImport" Format="dd/MM/yyyy HH:mm" />
                <PropertyColumn Property="x => x.UserImport" Title="UserImport" />
            </Columns>
            <PagerContent>
                <MudDataGridPager T="ContainerRecord" PageSizeOptions="new int[] { 25, 50, 100, 200 }" />
            </PagerContent>
        </MudDataGrid>

        @if (_selectedRecord is not null)
        {
            <MudPaper Class="ci-selected-detail pa-3 mt-3" Elevation="0">
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-2 flex-wrap">
                    <div>
                        <MudText Typo="Typo.subtitle1" Class="ci-section-title">
                            Container Event Detail: @_selectedRecord.ITEM_NO
                        </MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            Latest status: @_selectedRecord.Status · Duplicate rows/events: @_selectedDuplicateRows.Count.ToString("N0")
                        </MudText>
                    </div>

                    <MudStack Row="true" Spacing="1">
                        <MudChip T="string" Color="Color.Primary" Variant="Variant.Outlined" Size="Size.Small">
                            @_selectedRecord.DepotDisplay
                        </MudChip>
                        <MudChip T="string" Color="Color.Secondary" Variant="Variant.Outlined" Size="Size.Small">
                            @_selectedRecord.LINE
                        </MudChip>
                        <MudButton Variant="Variant.Text"
                                   Color="Color.Error"
                                   Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.Close"
                                   OnClick="CloseContainerDetail">
                            Close
                        </MudButton>
                    </MudStack>
                </MudStack>

                <MudGrid Spacing="2" Class="mb-2">
                    <MudItem xs="12" md="3">
                        <MudPaper Class="ci-mini-card pa-2" Elevation="0">
                            <MudText Typo="Typo.caption">Container</MudText>
                            <MudText Typo="Typo.subtitle2" Class="fw-bold">@_selectedRecord.ITEM_NO</MudText>
                        </MudPaper>
                    </MudItem>
                    <MudItem xs="12" md="3">
                        <MudPaper Class="ci-mini-card pa-2" Elevation="0">
                            <MudText Typo="Typo.caption">Size / F-E-D</MudText>
                            <MudText Typo="Typo.subtitle2" Class="fw-bold">@_selectedRecord.ISO / @_selectedRecord.FEL</MudText>
                        </MudPaper>
                    </MudItem>
                    <MudItem xs="12" md="3">
                        <MudPaper Class="ci-mini-card pa-2" Elevation="0">
                            <MudText Typo="Typo.caption">Book / B/L</MudText>
                            <MudText Typo="Typo.subtitle2" Class="fw-bold">@_selectedRecord.BOOK_NO / @_selectedRecord.BILL_OF_LADING</MudText>
                        </MudPaper>
                    </MudItem>
                    <MudItem xs="12" md="3">
                        <MudPaper Class="ci-mini-card pa-2" Elevation="0">
                            <MudText Typo="Typo.caption">Latest Source</MudText>
                            <MudText Typo="Typo.subtitle2" Class="fw-bold">@_selectedRecord.SourceTable</MudText>
                        </MudPaper>
                    </MudItem>
                </MudGrid>

                <MudDataGrid T="ContainerRecord"
                             Items="_selectedDuplicateRows"
                             Dense="true"
                             Hover="true"
                             Bordered="true"
                             Striped="true"
                             Filterable="true"
                             FixedHeader="true"
                             Height="300px"
                             Class="ci-detail-grid">
                    <Columns>
                        <PropertyColumn Property="x => x.SourceTable" Title="Source Table" />
                        <PropertyColumn Property="x => x.SourceType" Title="Type" />
                        <PropertyColumn Property="x => x.Status" Title="Status" />
                        <PropertyColumn Property="x => x.StatusReason" Title="Status Reason" />
                        <PropertyColumn Property="x => x.EventMethod" Title="Method" />
                        <PropertyColumn Property="x => x.EventTs" Title="Event Time" Format="dd/MM/yyyy HH:mm" />
                        <PropertyColumn Property="x => x.AGENT" Title="AGENT" />
                        <PropertyColumn Property="x => x.LINE" Title="LINE" />
                        <PropertyColumn Property="x => x.DEPOT" Title="DEPOT" />
                        <PropertyColumn Property="x => x.ITEM_NO" Title="Container" />
                        <PropertyColumn Property="x => x.ISO" Title="ISO / Size" />
                        <PropertyColumn Property="x => x.FEL" Title="F/E/D" />
