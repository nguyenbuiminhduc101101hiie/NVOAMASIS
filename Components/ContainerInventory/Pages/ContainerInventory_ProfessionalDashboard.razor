    private async Task LoadAsync()
    {
        try
        {
            _busy = true;
            _errorMessage = string.Empty;
            _sourceInfo = string.Empty;
            _loadedSources.Clear();

            await using var db = await DbFactory.CreateDbContextAsync();
            var conn = db.Database.GetDbConnection();

            if (conn.State != ConnectionState.Open)
                await conn.OpenAsync();

            var sources = await FindInventorySourceTablesAsync(conn);
            _loadedSources = sources;

            if (sources.Count == 0)
            {
                _records.Clear();
                _errorMessage = "No compatible inventory/import tables were found. Required shape: Current table has ITEM_NO + ISO + DateImport, or In/Out table has SOCONT + KICHCO + DateImport.";
                return;
            }

            var raw = new List<ContainerRecord>();

            foreach (var source in sources)
            {
                var dbColumns = await LoadColumnNamesAsync(conn, source.SchemaName, source.TableName);
                var selectedColumns = SourceColumns.Where(x => dbColumns.Contains(x)).ToList();

                if (selectedColumns.Count == 0)
                    continue;

                raw.AddRange(await LoadSourceRowsAsync(conn, source, selectedColumns));
            }

            _allEventRows = raw
                .Where(x => !string.IsNullOrWhiteSpace(x.ContainerKey))
                .ToList();

            _selectedRecord = null;
            _selectedDuplicateRows.Clear();

            _records = _allEventRows
                .Where(x => !string.IsNullOrWhiteSpace(x.ContainerKey))
                .GroupBy(x => x.ContainerKey, StringComparer.OrdinalIgnoreCase)
                .Select(g =>
                {
                    var allRows = g.OrderByDescending(x => x.EventDate ?? DateTime.MinValue)
                                   .ThenByDescending(x => x.DateImport ?? DateTime.MinValue)
                                   .ThenByDescending(x => x.CreatedAt ?? DateTime.MinValue)
                                   .ThenByDescending(x => x.ARR_TS ?? DateTime.MinValue)
                                   .ToList();

                    var latest = allRows.First();

                    latest.DuplicateCount = allRows.Count;
                    latest.DuplicateSourceTables = string.Join(", ",
                        allRows.Select(x => x.SourceTable)
                               .Where(x => !string.IsNullOrWhiteSpace(x))
                               .Distinct(StringComparer.OrdinalIgnoreCase));

                    latest.DuplicateEventHistory = string.Join(" | ",
                        allRows.Take(6).Select(x =>
                            $"{FormatDateTime(x.EventDate)} - {x.SourceTable} - {FirstNonEmpty(x.EventMethod, x.Status, x.FEL, x.CATEGORY)}"));

                    return latest;
                })
                .OrderBy(x => x.DepotDisplay)
                .ThenBy(x => x.LINE)
                .ThenBy(x => x.ITEM_NO)
                .ToList();

            foreach (var item in _records)
            {
                var statusInfo = ResolveStatusInfo(item);
                item.Status = statusInfo.Status;
                item.StatusReason = statusInfo.Reason;
            }

            _sourceInfo = $"{sources.Count:N0} table(s): {string.Join(", ", sources.Select(x => x.TableName))}";
            Snackbar.Add($"Loaded {_records.Count:N0} distinct containers from {_sourceInfo}.", MudBlazor.Severity.Success);
        }
        catch (Exception ex)
        {
            var root = ex;

            while (root.InnerException is not null)
                root = root.InnerException;

            _errorMessage = root.Message;
            Snackbar.Add(root.Message, MudBlazor.Severity.Error);
        }
        finally
        {
            _busy = false;
            StateHasChanged();
        }
    }

    private async Task<List<TableSource>> FindInventorySourceTablesAsync(DbConnection conn)
    {
        var result = new List<TableSource>();

        foreach (var tableName in PreferredSourceTables)
        {
            var source = await FindSpecificSourceTableAsync(conn, tableName);

            if (source is not null && !result.Any(x => x.SchemaName == source.SchemaName && x.TableName == source.TableName))
                result.Add(source);
        }

        await using var cmd = conn.CreateCommand();
        cmd.CommandText = @"
SELECT s.name AS SchemaName, t.name AS TableName
FROM sys.tables t
INNER JOIN sys.schemas s ON s.schema_id = t.schema_id
WHERE
(
       (EXISTS (SELECT 1 FROM sys.columns c WHERE c.object_id = t.object_id AND c.name = N'ITEM_NO')
    AND EXISTS (SELECT 1 FROM sys.columns c WHERE c.object_id = t.object_id AND c.name = N'ISO')
    AND EXISTS (SELECT 1 FROM sys.columns c WHERE c.object_id = t.object_id AND c.name = N'DateImport'))
    OR
       (EXISTS (SELECT 1 FROM sys.columns c WHERE c.object_id = t.object_id AND c.name = N'SOCONT')
    AND EXISTS (SELECT 1 FROM sys.columns c WHERE c.object_id = t.object_id AND c.name = N'KICHCO')
    AND EXISTS (SELECT 1 FROM sys.columns c WHERE c.object_id = t.object_id AND c.name = N'DateImport'))
)
AND
(
       t.name LIKE N'%Yard%'
    OR t.name LIKE N'%IN_OUT%'
    OR t.name LIKE N'%VSS%'
    OR t.name LIKE N'%Inventory%'
    OR t.name LIKE N'%Container%'
    OR t.name LIKE N'%Stock%'
    OR t.name LIKE N'%Depot%'
)
ORDER BY
  CASE
    WHEN t.name = N'M_YardMovement_AMS_26040816_Current_In_Yard2' THEN 0
    WHEN t.name = N'M_8_3_IN_OUT_YARD_1' THEN 1
    WHEN t.name = N'M_8_3_VSS_IN_OUT_YARD_Exp' THEN 2
    WHEN t.name = N'M_8_3_VSS_IN_OUT_YARD_Imp' THEN 3
    WHEN t.name LIKE N'%Current%In%Yard%' THEN 4
    WHEN t.name LIKE N'%IN_OUT%' THEN 4
    ELSE 9
  END,
  t.name;";

        await using var reader = await cmd.ExecuteReaderAsync();
        var candidates = new List<TableRef>();

        while (await reader.ReadAsync())
            candidates.Add(new TableRef(reader.GetString(0), reader.GetString(1)));

        await reader.CloseAsync();

        foreach (var c in candidates)
        {
            if (result.Any(x => x.SchemaName == c.SchemaName && x.TableName == c.TableName))
                continue;

            var source = await BuildSourceIfCompatibleAsync(conn, c.SchemaName, c.TableName);

            if (source is not null)
                result.Add(source);
        }

        return result;
    }

    private async Task<TableSource?> FindSpecificSourceTableAsync(DbConnection conn, string tableName)
    {
        await using var cmd = conn.CreateCommand();
        cmd.CommandText = @"
SELECT TOP 1 s.name AS SchemaName, t.name AS TableName
FROM sys.tables t
INNER JOIN sys.schemas s ON s.schema_id = t.schema_id
WHERE t.name = @TableName
ORDER BY s.name, t.name;";
        AddParameter(cmd, "@TableName", tableName);

        await using var reader = await cmd.ExecuteReaderAsync();

        if (!await reader.ReadAsync())
            return null;

        var schema = reader.GetString(0);
        var table = reader.GetString(1);
        await reader.CloseAsync();

        return await BuildSourceIfCompatibleAsync(conn, schema, table);
    }

    private async Task<TableSource?> BuildSourceIfCompatibleAsync(DbConnection conn, string schemaName, string tableName)
    {
        var columns = await LoadColumnNamesAsync(conn, schemaName, tableName);

        if (columns.Contains("ITEM_NO") && columns.Contains("ISO") && columns.Contains("DateImport"))
            return new TableSource(schemaName, tableName, "CurrentInYard");

        if (columns.Contains("SOCONT") && columns.Contains("KICHCO") && columns.Contains("DateImport"))
            return new TableSource(schemaName, tableName, "InOutYard");

        return null;
    }

    private async Task<HashSet<string>> LoadColumnNamesAsync(DbConnection conn, string schemaName, string tableName)
    {
        var result = new HashSet<string>(StringComparer.OrdinalIgnoreCase);

        await using var cmd = conn.CreateCommand();
        cmd.CommandText = @"
SELECT c.name
FROM sys.columns c
INNER JOIN sys.tables t ON t.object_id = c.object_id
INNER JOIN sys.schemas s ON s.schema_id = t.schema_id
WHERE s.name = @SchemaName AND t.name = @TableName;";
        AddParameter(cmd, "@SchemaName", schemaName);
        AddParameter(cmd, "@TableName", tableName);

        await using var reader = await cmd.ExecuteReaderAsync();

        while (await reader.ReadAsync())
            result.Add(reader.GetString(0));

        return result;
    }

    private async Task<List<ContainerRecord>> LoadSourceRowsAsync(DbConnection conn, TableSource source, List<string> selectedColumns)
    {
        var result = new List<ContainerRecord>();
        var selectList = string.Join(", ", selectedColumns.Select(QuoteName));

        var orderColumns = new[] { "DateImport", "CreatedAt", "EXEC_TS", "ARR_TS", "DEP_TS" }
            .Where(c => selectedColumns.Contains(c, StringComparer.OrdinalIgnoreCase))
            .Select(QuoteName)
            .ToList();

        var orderBy = orderColumns.Count > 0
            ? $"COALESCE({string.Join(", ", orderColumns)}) DESC"
            : "(SELECT NULL)";

        await using var cmd = conn.CreateCommand();
        cmd.CommandText = $@"
SELECT TOP (100000) {selectList}
FROM {QuoteName(source.SchemaName)}.{QuoteName(source.TableName)} WITH (NOLOCK)
ORDER BY {orderBy};";
        cmd.CommandTimeout = 180;

        await using var reader = await cmd.ExecuteReaderAsync();
        var ordinals = Enumerable.Range(0, reader.FieldCount)
            .ToDictionary(reader.GetName, i => i, StringComparer.OrdinalIgnoreCase);

        while (await reader.ReadAsync())
        {
            var method = FirstNonEmpty(
                GetString(reader, ordinals, "METHOD"),
                GetString(reader, ordinals, "OPERATION_METHOD"));

            var execTs = GetDateTime(reader, ordinals, "EXEC_TS");
            var isInOut = source.SourceType == "InOutYard";
            var looksOut = LooksLikeOutMovement(method);
            var looksIn = LooksLikeInMovement(method);

            var arrTs = GetDateTime(reader, ordinals, "ARR_TS");
            var depTs = GetDateTime(reader, ordinals, "DEP_TS");

            if (isInOut && arrTs is null && looksIn)
                arrTs = execTs;

            if (isInOut && depTs is null && looksOut)
                depTs = execTs;

            var row = new ContainerRecord
            {
                Id = GetGuid(reader, ordinals, "Id"),
                SourceTable = source.TableName,
                SourceType = source.SourceType,
                EventMethod = method,
                EventTs = FirstNonEmptyDate(execTs, arrTs, depTs, GetDateTime(reader, ordinals, "DateImport"), GetDateTime(reader, ordinals, "CreatedAt")),

                AGENT = GetString(reader, ordinals, "AGENT"),
                LINE = GetString(reader, ordinals, "LINE"),
                DEPOT = GetString(reader, ordinals, "DEPOT"),
                ITEM_KEY = GetString(reader, ordinals, "ITEM_KEY"),

                ITEM_NO = FirstNonEmpty(
                    GetString(reader, ordinals, "ITEM_NO"),
                    GetString(reader, ordinals, "SOCONT")),

                ISO = FirstNonEmpty(
                    GetString(reader, ordinals, "ISO"),
                    GetString(reader, ordinals, "KICHCO")),

                FEL = FirstNonEmpty(
                    GetString(reader, ordinals, "FEL"),
                    GetString(reader, ordinals, "TRANGTHAI")),

                TEMP = GetDecimal(reader, ordinals, "TEMP"),

                WEIGHT = FirstNonEmptyDecimal(
                    GetDecimal(reader, ordinals, "WEIGHT"),
                    GetDecimal(reader, ordinals, "TRONGLUONG")),

                VGM_WEIGHT = FirstNonEmptyDecimal(
                    GetDecimal(reader, ordinals, "VGM_WEIGHT"),
                    GetDecimal(reader, ordinals, "TRONGLUONG_VGM")),

                BOOK_NO = GetString(reader, ordinals, "BOOK_NO"),

                BILL_OF_LADING = FirstNonEmpty(
                    GetString(reader, ordinals, "BILL_OF_LADING"),
                    GetString(reader, ordinals, "BL_NO")),

                LOCATION = FirstNonEmpty(
                    GetString(reader, ordinals, "LOCATION"),
                    GetString(reader, ordinals, "DEPOT")),

                CATEGORY = FirstNonEmpty(
                    GetString(reader, ordinals, "CATEGORY"),
                    method),

                ARR_BY = FirstNonEmpty(
                    GetString(reader, ordinals, "ARR_BY"),
                    looksIn ? method : string.Empty),

                ARR_CAR = FirstNonEmpty(
                    GetString(reader, ordinals, "ARR_CAR"),
                    GetString(reader, ordinals, "ENTRY_TRUCK_ID")),

                ARR_VES_NAME = FirstNonEmpty(
                    GetString(reader, ordinals, "ARR_VES_NAME"),
                    GetString(reader, ordinals, "ENTRY_VES_NAME")),

                ARR_TS = arrTs,

                DEP_BY = FirstNonEmpty(
                    GetString(reader, ordinals, "DEP_BY"),
                    looksOut ? method : string.Empty),

                DEP_CAR = FirstNonEmpty(
                    GetString(reader, ordinals, "DEP_CAR"),
                    GetString(reader, ordinals, "EXIT_TRUCK_ID")),

                DEP_VES_NAME = FirstNonEmpty(
                    GetString(reader, ordinals, "DEP_VES_NAME"),
                    GetString(reader, ordinals, "EXIT_VES_NAME")),

                DEP_TS = depTs,

                DISCH_PORT = FirstNonEmpty(
                    GetString(reader, ordinals, "DISCH_PORT"),
                    GetString(reader, ordinals, "CANGCT")),

                FINAL_DISCH_PORT = FirstNonEmpty(
                    GetString(reader, ordinals, "FINAL_DISCH_PORT"),
                    GetString(reader, ordinals, "CANGDEN")),

                PLACE_OF_RECEIPT = FirstNonEmpty(
                    GetString(reader, ordinals, "PLACE_OF_RECEIPT"),
                    GetString(reader, ordinals, "NHAN")),

                PLACE_OF_DELIVERY = FirstNonEmpty(
                    GetString(reader, ordinals, "PLACE_OF_DELIVERY"),
                    GetString(reader, ordinals, "GIAO")),

                CUSTOM_CLEARANCE = GetString(reader, ordinals, "CUSTOM_CLEARANCE"),
                CC_TS = GetDateTime(reader, ordinals, "CC_TS"),
                DGS_CLASS = GetString(reader, ordinals, "DGS_CLASS"),
                UN_NO = GetString(reader, ordinals, "UN_NO"),
                DAM = GetString(reader, ordinals, "DAM"),
                GHICHU = GetString(reader, ordinals, "GHICHU"),
                SOSEAL = GetString(reader, ordinals, "SOSEAL"),
                STORAGEDAY = GetInt(reader, ordinals, "STORAGEDAY"),
                DateImport = GetDateTime(reader, ordinals, "DateImport"),
                UserImport = GetString(reader, ordinals, "UserImport"),
                CreatedAt = GetDateTime(reader, ordinals, "CreatedAt")
            };

            row.SizeType = DetectSizeType(row.ISO);
            result.Add(row);
        }

        return result;
    }

    private void OnContainerRowClick(DataGridRowClickEventArgs<ContainerRecord> args)
    {
        if (args.Item is null)
            return;

        _selectedRecord = args.Item;

        _selectedDuplicateRows = _allEventRows
            .Where(x => string.Equals(x.ContainerKey, args.Item.ContainerKey, StringComparison.OrdinalIgnoreCase))
            .OrderByDescending(x => x.EventDate ?? DateTime.MinValue)
            .ThenByDescending(x => x.DateImport ?? DateTime.MinValue)
            .ThenByDescending(x => x.CreatedAt ?? DateTime.MinValue)
            .ThenByDescending(x => x.ARR_TS ?? DateTime.MinValue)
            .ToList();

        foreach (var row in _selectedDuplicateRows)
        {
            var statusInfo = ResolveStatusInfo(row);
            row.Status = statusInfo.Status;
            row.StatusReason = statusInfo.Reason;
        }
    }

    private void CloseContainerDetail()
    {
        _selectedRecord = null;
        _selectedDuplicateRows.Clear();
    }

    private bool MatchesFilters(ContainerRecord x)
    {
        if (_excludeDamaged && IsDamaged(x))
            return false;

        if (!string.IsNullOrWhiteSpace(_sourceFilter) && !string.Equals(x.SourceTable, _sourceFilter, StringComparison.OrdinalIgnoreCase))
            return false;

        if (!string.IsNullOrWhiteSpace(_agentFilter) && !string.Equals(x.AGENT, _agentFilter, StringComparison.OrdinalIgnoreCase))
            return false;

        if (!string.IsNullOrWhiteSpace(_lineFilter) && !string.Equals(x.LINE, _lineFilter, StringComparison.OrdinalIgnoreCase))
            return false;

        if (!string.IsNullOrWhiteSpace(_depotFilter) && !string.Equals(x.DepotDisplay, _depotFilter, StringComparison.OrdinalIgnoreCase))
            return false;

        if (!string.IsNullOrWhiteSpace(_sizeFilter) && !string.Equals(x.SizeType, _sizeFilter, StringComparison.OrdinalIgnoreCase))
            return false;

        if (!string.IsNullOrWhiteSpace(_statusFilter) && !string.Equals(x.Status, _statusFilter, StringComparison.OrdinalIgnoreCase))
            return false;

        if (string.IsNullOrWhiteSpace(_search))
            return true;

        var key = _search.Trim();

        return Contains(x.SourceTable, key)
            || Contains(x.SourceType, key)
            || Contains(x.EventMethod, key)
            || Contains(x.AGENT, key)
            || Contains(x.LINE, key)
            || Contains(x.DEPOT, key)
            || Contains(x.ITEM_KEY, key)
            || Contains(x.ITEM_NO, key)
            || Contains(x.ISO, key)
            || Contains(x.FEL, key)
            || Contains(x.BOOK_NO, key)
            || Contains(x.BILL_OF_LADING, key)
            || Contains(x.LOCATION, key)
            || Contains(x.CATEGORY, key)
            || Contains(x.ARR_CAR, key)
            || Contains(x.ARR_VES_NAME, key)
            || Contains(x.DEP_CAR, key)
            || Contains(x.DEP_VES_NAME, key)
            || Contains(x.DISCH_PORT, key)
            || Contains(x.FINAL_DISCH_PORT, key)
            || Contains(x.PLACE_OF_RECEIPT, key)
            || Contains(x.PLACE_OF_DELIVERY, key)
            || Contains(x.CUSTOM_CLEARANCE, key)
            || Contains(x.DAM, key)
            || Contains(x.GHICHU, key)
            || Contains(x.SOSEAL, key);
    }

    private static List<ContainerGroupRow> BuildGroupRows(IEnumerable<ContainerRecord> rows)
    {
        return rows
            .GroupBy(x => new
            {
                Depot = FirstNonEmpty(x.DepotDisplay, "N/A"),
                Agent = string.IsNullOrWhiteSpace(x.AGENT) ? "N/A" : x.AGENT.Trim(),
                Line = string.IsNullOrWhiteSpace(x.LINE) ? "N/A" : x.LINE.Trim(),
                ContainerType = string.IsNullOrWhiteSpace(x.SizeType) ? "OTHER" : x.SizeType.Trim()
            })
            .Select(g => new ContainerGroupRow
            {
                Depot = g.Key.Depot,
                Agent = g.Key.Agent,
                Line = g.Key.Line,
                ContainerType = g.Key.ContainerType,
                ContainerCount = g.Select(x => x.ContainerKey).Distinct(StringComparer.OrdinalIgnoreCase).Count(),
                Size20 = g.Where(x => x.SizeType == "20DC").Select(x => x.ContainerKey).Distinct(StringComparer.OrdinalIgnoreCase).Count(),
                Size40 = g.Where(x => x.SizeType == "40HC").Select(x => x.ContainerKey).Distinct(StringComparer.OrdinalIgnoreCase).Count(),
                EmptyCount = g.Where(IsEmptyFel).Select(x => x.ContainerKey).Distinct(StringComparer.OrdinalIgnoreCase).Count(),
                FullCount = g.Where(IsFullFel).Select(x => x.ContainerKey).Distinct(StringComparer.OrdinalIgnoreCase).Count(),
                DamagedCount = g.Where(IsDamagedOrDFel).Select(x => x.ContainerKey).Distinct(StringComparer.OrdinalIgnoreCase).Count(),
                OtherFelCount = g.Where(x => !IsEmptyFel(x) && !IsFullFel(x) && !IsDamagedOrDFel(x)).Select(x => x.ContainerKey).Distinct(StringComparer.OrdinalIgnoreCase).Count()
            })
            .OrderBy(x => x.Depot)
            .ThenBy(x => x.Line)
            .ThenBy(x => x.ContainerType)
            .ToList();
    }

    private (string Status, string Reason) ResolveStatusInfo(ContainerRecord x)
    {
        var movement = Normalize(FirstNonEmpty(x.EventMethod, x.CATEGORY, x.FEL));
        var location = Normalize(x.LOCATION);
        var category = Normalize(x.CATEGORY);
        var arrValid = IsValidDate(x.ARR_TS);
        var depValid = IsValidDate(x.DEP_TS);

        if (x.SourceType == "InOutYard")
        {
            if (LooksLikeOutMovement(movement))
            {
                var time = FormatDateTime(x.EventTs);
                return (StatusInTransit, $"In/Out source; METHOD/OPERATION indicates OUT movement. Event time: {time}.");
            }

            if (LooksLikeInMovement(movement))
            {
                var time = FormatDateTime(x.EventTs);

                if (LooksLikePort(location, x.DISCH_PORT, x.FINAL_DISCH_PORT, x.PLACE_OF_RECEIPT, x.PLACE_OF_DELIVERY))
                    return (StatusArrivedPort, $"In/Out source; IN movement and port fields detected. Event time: {time}.");

                return (StatusInDepot, $"In/Out source; METHOD/OPERATION indicates IN movement. Event time: {time}.");
            }

            if (movement.Contains("TRANSIT"))
                return (StatusInTransit, "TRANGTHAI or METHOD contains transit indicator.");

            if (movement.Contains("PORT") || movement.Contains("CANG") || movement.Contains("CẢNG"))
                return (StatusArrivedPort, "TRANGTHAI or METHOD contains port indicator.");

            if (movement.Contains("DEPOT") || movement.Contains("YARD") || movement.Contains("ICD"))
                return (StatusInDepot, "TRANGTHAI or METHOD contains depot/yard indicator.");
        }

        if (depValid && (!arrValid || x.DEP_TS!.Value >= x.ARR_TS!.Value))
        {
            var depText = x.DEP_TS?.ToString("dd/MM/yyyy HH:mm") ?? "available";
            return (StatusInTransit, $"DEP_TS = {depText}; the container has left the yard/port or is in transit.");
        }

        if (!arrValid)
        {
            if (!string.IsNullOrWhiteSpace(x.BOOK_NO) ||
                !string.IsNullOrWhiteSpace(x.BILL_OF_LADING) ||
                !string.IsNullOrWhiteSpace(x.ARR_CAR) ||
                !string.IsNullOrWhiteSpace(x.ARR_VES_NAME))
            {
                return (StatusWaitingPort, "ARR_TS is empty, but Booking/B/L/transport or inbound vessel data exists, so the container is waiting for port/yard arrival.");
            }

            return (StatusWaitingPort, "ARR_TS is empty, so the system classifies this container as Waiting Port Arrival.");
        }

        if (LooksLikeDepot(location, category))
        {
            var arrText = x.ARR_TS?.ToString("dd/MM/yyyy HH:mm") ?? "available";
            return (StatusInDepot, $"ARR_TS = {arrText}; DEP_TS is empty; LOCATION/CATEGORY is identified as depot/yard/warehouse.");
        }

        if (LooksLikePort(location, x.DISCH_PORT, x.FINAL_DISCH_PORT, x.PLACE_OF_RECEIPT, x.PLACE_OF_DELIVERY))
        {
            var arrText = x.ARR_TS?.ToString("dd/MM/yyyy HH:mm") ?? "available";
            return (StatusArrivedPort, $"ARR_TS = {arrText}; DEP_TS is empty; LOCATION/port fields are identified as port/terminal.");
        }

        return (StatusInDepot, "ARR_TS exists and DEP_TS is empty; no clear port indicator was detected, so the default status is In Depot.");
    }

    private static bool LooksLikeDepot(string location, string category)
    {
        if (location.StartsWith("Y-") || location.Contains("DEPOT") || location.Contains("KHO") || location.Contains("YARD") || location.Contains("ICD"))
            return true;

        if (category.Contains("DEPOT") || category.Contains("KHO") || category.Contains("YARD") || category.Contains("ICD"))
            return true;

        return false;
    }

    private static bool LooksLikePort(string location, params string[] ports)
    {
        if (location.Contains("PORT") || location.Contains("CAT LAI") || location.Contains("CAI MEP") || location.Contains("TERMINAL") || location.Contains("CANG") || location.Contains("CẢNG"))
            return true;

        if (!LooksLikeDepot(location, string.Empty) && ports.Any(p => !string.IsNullOrWhiteSpace(p)))
            return true;

        return false;
    }

    private static bool LooksLikeInMovement(string? text)
    {
        var n = Normalize(text);

        if (string.IsNullOrWhiteSpace(n))
            return false;

        return n.Contains("IN")
            || n.Contains("ENTRY")
            || n.Contains("ARR")
            || n.Contains("ARRIVAL")
            || n.Contains("GATE IN")
            || n.Contains("GATEIN")
            || n.Contains("NHAP")
            || n.Contains("NHẬP")
            || n.Contains("VAO")
            || n.Contains("VÀO");
    }

    private static bool LooksLikeOutMovement(string? text)
    {
        var n = Normalize(text);

        if (string.IsNullOrWhiteSpace(n))
            return false;

        return n.Contains("OUT")
            || n.Contains("EXIT")
            || n.Contains("DEP")
            || n.Contains("DEPART")
            || n.Contains("GATE OUT")
            || n.Contains("GATEOUT")
            || n.Contains("XUAT")
            || n.Contains("XUẤT")
            || n.Contains("RA");
    }

    private static string DetectSizeType(string iso)
    {
        var n = Normalize(iso);

        if (string.IsNullOrWhiteSpace(n))
            return "OTHER";

        if (n.StartsWith("22") || n.StartsWith("20") || n.Contains("20"))
            return "20DC";

        if (n.StartsWith("45") || n.StartsWith("42") || n.StartsWith("43") || n.StartsWith("40") || n.Contains("HC") || n.Contains("HQ") || n.Contains("45"))
            return "40HC";

        return "OTHER";
    }

    private static bool IsEmptyFel(ContainerRecord x)
    {
        var fel = Normalize(x.FEL);
        return fel is "E" or "EMPTY" or "R" or "MT";
    }

    private static bool IsFullFel(ContainerRecord x)
    {
        var fel = Normalize(x.FEL);
        return fel is "F" or "FULL" or "L" or "LADEN";
    }

    private static bool IsDamagedOrDFel(ContainerRecord x)
    {
        var fel = Normalize(x.FEL);
        return fel is "D" or "DAM" or "DAMAGE" or "DAMAGED" || IsDamaged(x);
    }

    private static bool IsDamaged(ContainerRecord x)
    {
        var dam = Normalize(x.DAM);
        var note = Normalize(x.GHICHU);

        if (string.IsNullOrWhiteSpace(dam) && string.IsNullOrWhiteSpace(note))
            return false;

        return dam is "1" or "Y" or "YES" or "DAM" or "DAMAGE" or "DAMAGED" or "HONG" or "HƯ"
            || dam.Contains("DAM")
            || dam.Contains("HONG")
            || dam.Contains("HƯ")
            || note.Contains("DAM")
            || note.Contains("HONG")
            || note.Contains("HƯ")
            || note.Contains("MOOP")
            || note.Contains("MOP")
            || note.Contains("BỂ")
            || note.Contains("BE ");
    }

    private async Task ExportCsvAsync()
    {
        var sb = new StringBuilder();

        sb.AppendLine("SourceTable,SourceType,DuplicateCount,DuplicateSourceTables,DuplicateEventHistory,Status,StatusReason,EventMethod,EventTime,AGENT,LINE,DEPOT,Container,ISO,Size,FEL,WEIGHT,VGM_WEIGHT,BOOK_NO,BILL_OF_LADING,LOCATION,CATEGORY,ARR_BY,ARR_CAR,ARR_VES_NAME,ARR_TS,DEP_BY,DEP_CAR,DEP_VES_NAME,DEP_TS,DISCH_PORT,FINAL_DISCH_PORT,PLACE_OF_RECEIPT,PLACE_OF_DELIVERY,DAM,SOSEAL,GHICHU,STORAGEDAY,DateImport,UserImport");

        foreach (var x in FilteredRecords)
        {
            sb.AppendLine(string.Join(",", new[]
            {
                Csv(x.SourceTable), Csv(x.SourceType), Csv(x.DuplicateCount.ToString()), Csv(x.DuplicateSourceTables), Csv(x.DuplicateEventHistory),
                Csv(x.Status), Csv(x.StatusReason), Csv(x.EventMethod), Csv(FormatDateTime(x.EventTs)),
                Csv(x.AGENT), Csv(x.LINE), Csv(x.DepotDisplay), Csv(x.ITEM_NO), Csv(x.ISO), Csv(x.SizeType), Csv(x.FEL),
                Csv(x.WEIGHT?.ToString("N2") ?? string.Empty), Csv(x.VGM_WEIGHT?.ToString("N2") ?? string.Empty),
                Csv(x.BOOK_NO), Csv(x.BILL_OF_LADING), Csv(x.LOCATION), Csv(x.CATEGORY), Csv(x.ARR_BY), Csv(x.ARR_CAR), Csv(x.ARR_VES_NAME), Csv(FormatDateTime(x.ARR_TS)),
                Csv(x.DEP_BY), Csv(x.DEP_CAR), Csv(x.DEP_VES_NAME), Csv(FormatDateTime(x.DEP_TS)), Csv(x.DISCH_PORT), Csv(x.FINAL_DISCH_PORT),
                Csv(x.PLACE_OF_RECEIPT), Csv(x.PLACE_OF_DELIVERY), Csv(x.DAM), Csv(x.SOSEAL), Csv(x.GHICHU), Csv(x.STORAGEDAY?.ToString() ?? string.Empty),
                Csv(FormatDateTime(x.DateImport)), Csv(x.UserImport)
            }));
        }

        var bytes = Encoding.UTF8.GetBytes(sb.ToString());
        var base64 = Convert.ToBase64String(bytes);
        var fileName = $"ContainerInventory_AllSources_{DateTime.Now:yyyyMMddHHmmss}.csv";

        await JS.InvokeVoidAsync("eval", $"const a=document.createElement('a');a.href='data:text/csv;base64,{base64}';a.download='{fileName}';a.click();");
    }

    private async Task PrintAsync()
    {
        await JS.InvokeVoidAsync("window.print");
    }

    private static void AddParameter(DbCommand cmd, string name, object? value)
    {
        var p = cmd.CreateParameter();
        p.ParameterName = name;
        p.Value = value ?? DBNull.Value;
        cmd.Parameters.Add(p);
    }

    private static string GetString(DbDataReader reader, Dictionary<string, int> ordinals, string name)
    {
        if (!ordinals.TryGetValue(name, out var i) || reader.IsDBNull(i))
            return string.Empty;

        return Convert.ToString(reader.GetValue(i))?.Trim() ?? string.Empty;
    }

    private static Guid? GetGuid(DbDataReader reader, Dictionary<string, int> ordinals, string name)
    {
        if (!ordinals.TryGetValue(name, out var i) || reader.IsDBNull(i))
            return null;

        var v = reader.GetValue(i);

        if (v is Guid g)
            return g;

        return Guid.TryParse(Convert.ToString(v), out var parsed) ? parsed : null;
    }

    private static decimal? GetDecimal(DbDataReader reader, Dictionary<string, int> ordinals, string name)
    {
        if (!ordinals.TryGetValue(name, out var i) || reader.IsDBNull(i))
            return null;

        return Convert.ToDecimal(reader.GetValue(i));
    }

    private static int? GetInt(DbDataReader reader, Dictionary<string, int> ordinals, string name)
    {
        if (!ordinals.TryGetValue(name, out var i) || reader.IsDBNull(i))
            return null;

        return Convert.ToInt32(reader.GetValue(i));
    }

    private static DateTime? GetDateTime(DbDataReader reader, Dictionary<string, int> ordinals, string name)
    {
        if (!ordinals.TryGetValue(name, out var i) || reader.IsDBNull(i))
            return null;

        var v = reader.GetValue(i);

        if (v is DateTime dt)
            return IsValidDate(dt) ? dt : null;

        return DateTime.TryParse(Convert.ToString(v), out var parsed) && IsValidDate(parsed) ? parsed : null;
    }

    private static bool IsValidDate(DateTime? value) => value.HasValue && IsValidDate(value.Value);
    private static bool IsValidDate(DateTime value) => value.Year > 1901;

    private static string QuoteName(string value) => "[" + value.Replace("]", "]]", StringComparison.Ordinal) + "]";
    private static string Normalize(string? value) => (value ?? string.Empty).Trim().ToUpperInvariant();
    private static bool Contains(string? source, string key) => !string.IsNullOrWhiteSpace(source) && source.Contains(key, StringComparison.OrdinalIgnoreCase);

    private static string FirstNonEmpty(params string[] values)
        => values.FirstOrDefault(x => !string.IsNullOrWhiteSpace(x))?.Trim() ?? string.Empty;

    private static decimal? FirstNonEmptyDecimal(params decimal?[] values)
        => values.FirstOrDefault(x => x.HasValue);

    private static DateTime? FirstNonEmptyDate(params DateTime?[] values)
        => values.FirstOrDefault(x => x.HasValue);

    private static string FormatDateTime(DateTime? value) => value?.ToString("dd/MM/yyyy HH:mm") ?? string.Empty;

    private static string Csv(string value)
    {
        value ??= string.Empty;
        return "\"" + value.Replace("\"", "\"\"") + "\"";
    }

