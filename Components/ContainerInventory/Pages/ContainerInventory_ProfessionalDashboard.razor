            SourceType = sourceType;
        }

        public string SchemaName { get; }
        public string TableName { get; }
        public string SourceType { get; }
    }

    private sealed class ContainerRecord
    {
        public Guid? Id { get; set; }

        public string SourceTable { get; set; } = string.Empty;
        public string SourceType { get; set; } = string.Empty;
        public string EventMethod { get; set; } = string.Empty;
        public DateTime? EventTs { get; set; }

        public int DuplicateCount { get; set; } = 1;
        public string DuplicateSourceTables { get; set; } = string.Empty;
        public string DuplicateEventHistory { get; set; } = string.Empty;

        public string AGENT { get; set; } = string.Empty;
        public string LINE { get; set; } = string.Empty;
        public string DEPOT { get; set; } = string.Empty;
        public string ITEM_KEY { get; set; } = string.Empty;
        public string ITEM_NO { get; set; } = string.Empty;
        public string ISO { get; set; } = string.Empty;
        public string FEL { get; set; } = string.Empty;
        public decimal? TEMP { get; set; }
        public decimal? WEIGHT { get; set; }
        public decimal? VGM_WEIGHT { get; set; }
        public string BOOK_NO { get; set; } = string.Empty;
        public string BILL_OF_LADING { get; set; } = string.Empty;
        public string LOCATION { get; set; } = string.Empty;
        public string CATEGORY { get; set; } = string.Empty;
        public string ARR_BY { get; set; } = string.Empty;
        public string ARR_CAR { get; set; } = string.Empty;
        public string ARR_VES_NAME { get; set; } = string.Empty;
        public DateTime? ARR_TS { get; set; }
        public string DEP_BY { get; set; } = string.Empty;
        public string DEP_CAR { get; set; } = string.Empty;
        public string DEP_VES_NAME { get; set; } = string.Empty;
        public DateTime? DEP_TS { get; set; }
        public string DISCH_PORT { get; set; } = string.Empty;
        public string FINAL_DISCH_PORT { get; set; } = string.Empty;
        public string PLACE_OF_RECEIPT { get; set; } = string.Empty;
        public string PLACE_OF_DELIVERY { get; set; } = string.Empty;
        public string CUSTOM_CLEARANCE { get; set; } = string.Empty;
        public DateTime? CC_TS { get; set; }
        public string DGS_CLASS { get; set; } = string.Empty;
        public string UN_NO { get; set; } = string.Empty;
        public string DAM { get; set; } = string.Empty;
        public string GHICHU { get; set; } = string.Empty;
        public string SOSEAL { get; set; } = string.Empty;
        public int? STORAGEDAY { get; set; }
        public DateTime? DateImport { get; set; }
        public string UserImport { get; set; } = string.Empty;
        public DateTime? CreatedAt { get; set; }

        public string SizeType { get; set; } = "OTHER";
        public string Status { get; set; } = StatusInDepot;
        public string StatusReason { get; set; } = string.Empty;

        public string DepotDisplay => FirstNonEmpty(DEPOT, LOCATION, DISCH_PORT, FINAL_DISCH_PORT, PLACE_OF_DELIVERY, "N/A");
        public string ContainerKey => !string.IsNullOrWhiteSpace(ITEM_NO) ? ITEM_NO.Trim() : !string.IsNullOrWhiteSpace(ITEM_KEY) ? ITEM_KEY.Trim() : Id?.ToString() ?? string.Empty;
        public DateTime? EventDate => FirstNonEmptyDate(EventTs, DEP_TS, ARR_TS, DateImport, CreatedAt);
    }

    private sealed class ContainerGroupRow
    {
        public string Depot { get; set; } = string.Empty;
        public string Agent { get; set; } = string.Empty;
        public string Line { get; set; } = string.Empty;
        public string ContainerType { get; set; } = string.Empty;
        public int ContainerCount { get; set; }
        public int Size20 { get; set; }
        public int Size40 { get; set; }
        public int EmptyCount { get; set; }
        public int FullCount { get; set; }
        public int DamagedCount { get; set; }
        public int OtherFelCount { get; set; }
    }
