@using System.Globalization
@inject ISnackbar Snackbar
@inject AccountService asv
@inject TrainScheduleServices trainsv
@inject IStringLocalizer<SharedResource> Localizer
@inject SharedServices ssv
@inject LocalChargesServices lcsv

<MudDialog>
    <DialogContent>
        <div class="pp-schedule-dialog-shell">
            <MudContainer MaxWidth="MaxWidth.False" Class="pa-0">
                <MudCard Elevation="0" Class="pp-schedule-card">
                    <div class="pp-schedule-header">
                        <div>
                            <div class="pp-schedule-title">@Localizer["LCC_ship_hangar"]</div>
                            <div class="pp-schedule-subtitle">@Localizer["Carrier"] / @Localizer["Loaitiente"] / Loại vỏ container</div>
                        </div>
                    </div>

                    <MudForm Model="@_LocalCharge_Detail" @ref="@form">
                        <MudCardContent Class="pa-3">
                            @* —— General info —— *@
                            <div class="pp-section pp-soft-section">
                                <div class="pp-section-title">General info</div>
                                <MudGrid Spacing="2">
                                    <MudItem xs="12" sm="6">
                                        <MudAutocomplete @bind-Value="_LocalCharge_Detail.Carr" Label="@($"{Localizer["Carrier"]}*")"
                                            Class="custom-label" Margin="Margin.Dense" Required SearchFunc="searchCarr" />
                                    </MudItem>
                                    <MudItem xs="12" sm="6">
                                        <MudSelect @bind-Value="_LocalCharge_Detail.CURRENCY" Label="@Localizer["Loaitiente"]"
                                            Class="custom-label" Margin="Margin.Dense">
                                            <MudSelectItem Value="@("VND")">VND</MudSelectItem>
                                            <MudSelectItem Value="@("USD")">USD</MudSelectItem>
                                        </MudSelect>
                                    </MudItem>
                                    <MudItem xs="12">
                                        <MudText Typo="Typo.caption" Class="lcc-label-highlight mb-1">
                                            Loại vỏ container* <span class="lcc-note">(mới)</span>
                                        </MudText>
                                        <div class="lcc-toggle-row">
                                            <MudButton Class="@($"lcc-toggle-btn {(_isCoc ? "lcc-active-coc" : "")}")"
                                                       OnClick="@(() => SetContainerType("COC"))">
                                                COC — vỏ hãng tàu
                                            </MudButton>
                                            <MudButton Class="@($"lcc-toggle-btn {(!_isCoc ? "lcc-active-soc" : "")}")"
                                                       OnClick="@(() => SetContainerType("SOC"))">
                                                SOC — vỏ khách hàng
                                            </MudButton>
                                        </div>
                                    </MudItem>
                                    <MudItem xs="12">
                                        <MudTextField @bind-Value="_LocalCharge_Detail.Remarks" Label="@Localizer["ghichu"]"
                                            Class="custom-label" Margin="Margin.Dense" Placeholder="@Localizer["InputRemarksPlaceholder"]"
                                            AdornmentIcon="Icons.Material.Filled.Notes"
                                            InputType="InputType.Text" Lines="2" />
                                    </MudItem>
                                </MudGrid>
                            </div>

                            @* —— THC / EBS (both COC & SOC) —— *@
                            <div class="pp-section">
                                <div class="pp-section-title">
                                    THC / EBS <span class="lcc-note">— áp dụng cho cả COC và SOC</span>
                                </div>
                                <MudGrid Spacing="2">
                                    <MudItem xs="12" sm="6"><MudNumericField @bind-Value="_LocalCharge_Detail.Thc20dc" Label="THC 20DC" Format="#,##0.##" Culture="@_en" T="double?" Margin="Margin.Dense" Class="text-right-input custom-label" /></MudItem>
                                    <MudItem xs="12" sm="6"><MudNumericField @bind-Value="_LocalCharge_Detail.EBS20dc" Label="EBS 20DC" Format="#,##0.##" Culture="@_en" T="double?" Margin="Margin.Dense" Class="text-right-input custom-label" /></MudItem>
                                    <MudItem xs="12" sm="6"><MudNumericField @bind-Value="_LocalCharge_Detail.Thc40hc" Label="THC 40HC" Format="#,##0.##" Culture="@_en" T="double?" Margin="Margin.Dense" Class="text-right-input custom-label" /></MudItem>
                                    <MudItem xs="12" sm="6"><MudNumericField @bind-Value="_LocalCharge_Detail.EBS40hc" Label="EBS 40HC" Format="#,##0.##" Culture="@_en" T="double?" Margin="Margin.Dense" Class="text-right-input custom-label" /></MudItem>
                                    <MudItem xs="12" sm="6"><MudNumericField @bind-Value="_LocalCharge_Detail.Thc20rf" Label="THC 20RF" Format="#,##0.##" Culture="@_en" T="double?" Margin="Margin.Dense" Class="text-right-input custom-label" /></MudItem>
                                    <MudItem xs="12" sm="6"><MudNumericField @bind-Value="_LocalCharge_Detail.EBS20rf" Label="EBS 20RF" Format="#,##0.##" Culture="@_en" T="double?" Margin="Margin.Dense" Class="text-right-input custom-label" /></MudItem>
                                    <MudItem xs="12" sm="6"><MudNumericField @bind-Value="_LocalCharge_Detail.Thc40rf" Label="THC 40RF" Format="#,##0.##" Culture="@_en" T="double?" Margin="Margin.Dense" Class="text-right-input custom-label" /></MudItem>
                                    <MudItem xs="12" sm="6"><MudNumericField @bind-Value="_LocalCharge_Detail.EBS40rf" Label="EBS 40RF" Format="#,##0.##" Culture="@_en" T="double?" Margin="Margin.Dense" Class="text-right-input custom-label" /></MudItem>
                                </MudGrid>
                            </div>

                            @* —— COC-specific —— *@
                            @if (_isCoc)
                            {
                                <div class="pp-section lcc-section-coc">
                                    <div class="pp-section-title">Phí đặc thù COC</div>
                                    <MudGrid Spacing="2">
                                        <MudItem xs="12" sm="6"><MudNumericField @bind-Value="_LocalCharge_Detail.DEM" Label="DEM (phí lưu bãi)" Format="#,##0.##" Culture="@_en" T="double?" Margin="Margin.Dense" Class="text-right-input custom-label" /></MudItem>
                                        <MudItem xs="12" sm="6"><MudNumericField @bind-Value="_LocalCharge_Detail.DET" Label="DET (phí lưu kho)" Format="#,##0.##" Culture="@_en" T="double?" Margin="Margin.Dense" Class="text-right-input custom-label" /></MudItem>
                                        <MudItem xs="12" sm="6"><MudNumericField @bind-Value="_LocalCharge_Detail.Deposit" Label="Đặt cọc vỏ (Deposit)" Format="#,##0.##" Culture="@_en" T="double?" Margin="Margin.Dense" Class="text-right-input custom-label" /></MudItem>
                                        <MudItem xs="12" sm="6"><MudNumericField @bind-Value="_LocalCharge_Detail.FreeTimeDemDet" Label="Free time DEM/DET (ngày)" T="int?" Margin="Margin.Dense" Class="text-right-input custom-label" /></MudItem>
                                        <MudItem xs="12" sm="6"><MudNumericField @bind-Value="_LocalCharge_Detail.RepairFee" Label="Phí sửa chữa vỏ (Repair fee)" Format="#,##0.##" Culture="@_en" T="double?" Margin="Margin.Dense" Class="text-right-input custom-label" /></MudItem>
                                    </MudGrid>
                                </div>
                            }

                            @* —— SOC-specific —— *@
                            @if (!_isCoc)
                            {
                                <div class="pp-section lcc-section-soc">
                                    <div class="pp-section-title">Phí đặc thù SOC</div>
                                    <MudGrid Spacing="2">
                                        <MudItem xs="12" sm="6"><MudNumericField @bind-Value="_LocalCharge_Detail.SurveyFee" Label="Container survey fee" Format="#,##0.##" Culture="@_en" T="double?" Margin="Margin.Dense" Class="text-right-input custom-label" /></MudItem>
                                        <MudItem xs="12" sm="6"><MudNumericField @bind-Value="_LocalCharge_Detail.FumigationFee" Label="Fumigation certificate" Format="#,##0.##" Culture="@_en" T="double?" Margin="Margin.Dense" Class="text-right-input custom-label" /></MudItem>
                                        <MudItem xs="12" sm="6"><MudNumericField @bind-Value="_LocalCharge_Detail.SocHandlingFee" Label="SOC handling / documentation fee" Format="#,##0.##" Culture="@_en" T="double?" Margin="Margin.Dense" Class="text-right-input custom-label" /></MudItem>
                                    </MudGrid>
                                </div>
                            }

                            @* —— Other fees & validity —— *@
                            <div class="pp-section">
                                <div class="pp-section-title">Other fees &amp; validity</div>
                                <MudGrid Spacing="2">
                                    <MudItem xs="12" sm="6" md="3"><MudNumericField @bind-Value="_LocalCharge_Detail.Seal" Label="Seal" Format="#,##0.##" Culture="@_en" T="double?" Margin="Margin.Dense" Class="text-right-input custom-label" /></MudItem>
                                    <MudItem xs="12" sm="6" md="3"><MudNumericField @bind-Value="_LocalCharge_Detail.BL" Label="BL" Format="#,##0.##" Culture="@_en" T="double?" Margin="Margin.Dense" Class="text-right-input custom-label" /></MudItem>
                                    @if (_isCoc)
                                    {
                                        <MudItem xs="12" sm="6" md="3"><MudNumericField @bind-Value="_LocalCharge_Detail.CIC" Label="CIC (chỉ COC)" Format="#,##0.##" Culture="@_en" T="double?" Margin="Margin.Dense" Class="text-right-input custom-label" /></MudItem>
                                    }
                                    <MudItem xs="12" sm="6" md="3"><MudNumericField @bind-Value="_LocalCharge_Detail.LSS" Label="LSS" Format="#,##0.##" Culture="@_en" T="double?" Margin="Margin.Dense" Class="text-right-input custom-label" /></MudItem>
                                    <MudItem xs="12" sm="6" md="3"><MudNumericField @bind-Value="_LocalCharge_Detail.Telex" Label="Telex" Format="#,##0.##" Culture="@_en" T="double?" Margin="Margin.Dense" Class="text-right-input custom-label" /></MudItem>
                                    <MudItem xs="12" sm="6" md="3"><MudNumericField @bind-Value="_LocalCharge_Detail.ISPS" Label="ISPS" Format="#,##0.##" Culture="@_en" T="double?" Margin="Margin.Dense" Class="text-right-input custom-label" /></MudItem>
                                    <MudItem xs="12" sm="6" md="3"><MudNumericField @bind-Value="_LocalCharge_Detail.ENS" Label="ENS" Format="#,##0.##" Culture="@_en" T="double?" Margin="Margin.Dense" Class="text-right-input custom-label" /></MudItem>
                                    <MudItem xs="12" sm="6" md="3"><MudNumericField @bind-Value="_LocalCharge_Detail.MTF" Label="MTF" Format="#,##0.##" Culture="@_en" T="double?" Margin="Margin.Dense" Class="text-right-input custom-label" /></MudItem>
                                    <MudItem xs="12" sm="6" md="3"><MudNumericField @bind-Value="_LocalCharge_Detail.MAF" Label="MAF" Format="#,##0.##" Culture="@_en" T="double?" Margin="Margin.Dense" Class="text-right-input custom-label" /></MudItem>
                                    <MudItem xs="12" sm="6" md="3"><MudNumericField @bind-Value="_LocalCharge_Detail.LatePayMentFEE" Label="@Localizer["LatePayMentFEE"]" Format="#,##0.##" Culture="@_en" T="double?" Margin="Margin.Dense" Class="text-right-input custom-label" /></MudItem>
                                    <MudItem xs="12" sm="6" md="3"><MudDatePicker Class="custom-label" @bind-Date="_LocalCharge_Detail.Ngaybatdau" For="@(() => _LocalCharge_Detail.Ngaybatdau)" Label="@($"{Localizer["ngaybatdau"]}*")" Margin="Margin.Dense" Required="true" /></MudItem>
                                    <MudItem xs="12" sm="6" md="3"><MudDatePicker Class="custom-label" @bind-Date="_LocalCharge_Detail.Ngayketthuc" For="@(() => _LocalCharge_Detail.Ngayketthuc)" Label="@($"{Localizer["ngayketthuc"]}*")" Margin="Margin.Dense" Required="true" /></MudItem>
                                </MudGrid>
                            </div>
                        </MudCardContent>
                    </MudForm>
                </MudCard>
            </MudContainer>
        </div>
    </DialogContent>
    <DialogActions>
        <div class="pp-dialog-actions-bar">
            <MudButton Variant="Variant.Text" OnClick="Cancel">Cancel</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(async () => await Submit())">Save</MudButton>
        </div>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] MudDialogInstance? MudDialog { get; set; }
    [Parameter] public Models.M_LocalCharge_pt _LocalCharge_Detail { get; set; }

    [Parameter] public string Status { get; set; }
    MudForm form;

    private bool _isCoc = true;
    private List<M_Customer> Cuss_Carr = new List<M_Customer>();
    public CultureInfo _en = CultureInfo.GetCultureInfo("en-US");

    protected async override Task OnInitializedAsync()
    {
        Cuss_Carr = await lcsv.GetList_Customer_line();

        if (Status == "add")
        {
            _LocalCharge_Detail.Index_ = await lcsv.Get_index();
        }

        if (string.IsNullOrEmpty(_LocalCharge_Detail.ContainerType))
            _LocalCharge_Detail.ContainerType = "COC";

        _isCoc = !string.Equals(_LocalCharge_Detail.ContainerType, "SOC", StringComparison.OrdinalIgnoreCase);

        if (string.IsNullOrEmpty(_LocalCharge_Detail.CURRENCY))
            _LocalCharge_Detail.CURRENCY = "VND";

        EnsureDefaults();
    }

    void SetContainerType(string type)
    {
        _LocalCharge_Detail.ContainerType = type;
        _isCoc = type == "COC";

        // CIC only applies to COC
        if (!_isCoc)
            _LocalCharge_Detail.CIC = 0;

        StateHasChanged();
    }

    void EnsureDefaults()
    {
        _LocalCharge_Detail.Thc20dc ??= 0;
        _LocalCharge_Detail.Thc40hc ??= 0;
        _LocalCharge_Detail.Thc20rf ??= 0;
        _LocalCharge_Detail.Thc40rf ??= 0;
        _LocalCharge_Detail.EBS20dc ??= 0;
        _LocalCharge_Detail.EBS40hc ??= 0;
        _LocalCharge_Detail.EBS20rf ??= 0;
        _LocalCharge_Detail.EBS40rf ??= 0;
        _LocalCharge_Detail.DEM ??= 0;
        _LocalCharge_Detail.DET ??= 0;
        _LocalCharge_Detail.Deposit ??= 0;
        _LocalCharge_Detail.FreeTimeDemDet ??= 0;
        _LocalCharge_Detail.RepairFee ??= 0;
        _LocalCharge_Detail.SurveyFee ??= 0;
        _LocalCharge_Detail.FumigationFee ??= 0;
        _LocalCharge_Detail.SocHandlingFee ??= 0;
        _LocalCharge_Detail.Seal ??= 0;
        _LocalCharge_Detail.BL ??= 0;
        _LocalCharge_Detail.Telex ??= 0;
        _LocalCharge_Detail.ENS ??= 0;
        _LocalCharge_Detail.LatePayMentFEE ??= 0;
        _LocalCharge_Detail.CIC ??= 0;
        _LocalCharge_Detail.LSS ??= 0;
        _LocalCharge_Detail.ISPS ??= 0;
        _LocalCharge_Detail.MTF ??= 0;
        _LocalCharge_Detail.MAF ??= 0;
    }

    private async Task Submit()
    {
        if ((await ssv.CheckPermission(asv.GetAuth().Result.User.Identity.Name, "Edit", "LocalCharges_PT") || await ssv.CheckPermission(asv.GetAuth().Result.User.Identity.Name, "New", "LocalCharges_PT")))
        {
            await form.Validate();

            if (form.IsValid)
            {
                var UserName = asv.GetAuth().Result.User.Identity!.Name!;
                _LocalCharge_Detail.Dateupdate = DateTime.Now.ToString();
                _LocalCharge_Detail.Userupdate = UserName;
                MudDialog!.Close(_LocalCharge_Detail);
            }
        }
    }

    void Cancel() => MudDialog.Cancel();

    void CallSnackBar(string message, MudBlazor.Severity severity)
    {
        Snackbar.Configuration.SnackbarVariant = Variant.Filled;
        Snackbar.Configuration.MaxDisplayedSnackbars = 3;
        Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopRight;
        Snackbar.Add(message, severity);
    }

    private async Task<IEnumerable<string>> searchCarr(string text)
    {
        try
        {
            if (string.IsNullOrWhiteSpace(text))
            {
                return Cuss_Carr.Where(x => !string.IsNullOrEmpty(x.COMPANY))
               .Select(x => x.COMPANY);
            }
            return Cuss_Carr.Where(x => !string.IsNullOrEmpty(x.COMPANY) &&
                            x.COMPANY.Contains(text, StringComparison.OrdinalIgnoreCase))
               .Select(x => x.COMPANY);
        }
        catch (Exception)
        {
            throw;
        }
    }
}
