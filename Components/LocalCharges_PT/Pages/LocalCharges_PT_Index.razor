@code {
    List<M_LocalCharge_pt> Listdata = new List<M_LocalCharge_pt>();
    MudDataGrid<M_LocalCharge_pt> mudTable;
    AuthUser user;
    string mailtp, mailpp;
    string usr;
    private List<string> ListUser { get; set; } = new List<string>();
    string UserHanding;
    List<string> trangthais = new List<string>();
    private List<Models.TrangThai> M_Trangthais = new List<Models.TrangThai>();
    private string searchText_pol = "";
    private string searchText_pod = "";
    private List<PortModel> filteredPorts = new List<PortModel>();
    private List<PortModel> filteredPorts_pod = new List<PortModel>();
    private List<PortModel> Ports = new List<PortModel>();
    private bool _resizeColumn;
    M_LocalCharge_pt detail;
    M_LocalCharge_pt detail_LCC;

    private List<M_Customer> filteredCarr = new List<M_Customer>();

    private List<M_Customer> Cuss_Carr = new List<M_Customer>();
    public CultureInfo _de = CultureInfo.GetCultureInfo("de-DE");
    public CultureInfo _en = CultureInfo.GetCultureInfo("en-US");

    protected async override Task OnInitializedAsync()
    {
        ListUser = await asv.GetList_User_handle() ?? new List<string>();
        usr = asv.GetAuth().Result.User.Identity!.Name!;
        Cuss_Carr = await lcsv.GetList_Customer_line();
        // await Refresh();
    }

  

    bool _loading = false;
    async Task Refresh()
    {
        try
        {
            detail = null!;
            _loading = true;
            Listdata.Clear();
            
            await Task.Delay(500);
            if (!await ssv.CheckPermission(usr, "View", "LocalCharges_PT"))
            {
                CallSnackBar("You have not access to view", MudBlazor.Severity.Warning);
                return;
            }
            Listdata = await lcsv.GetListLocalcharges_pt();
            StateHasChanged();
            if (Listdata.Count == 0)
            {
                CallSnackBar("No Data", MudBlazor.Severity.Warning);
                _loading = false;
                return;
            }
        }
        catch(Exception ex)
        {
            CallSnackBar("Something went wrong!, error code: " + ex.Message, MudBlazor.Severity.Warning);
        }
        finally
        {
            _loading = false;
        }

    }

    void CallSnackBar(string message, MudBlazor.Severity severity)
    {
        
        Snackbar.Configuration.SnackbarVariant = Variant.Filled;
        Snackbar.Configuration.MaxDisplayedSnackbars = 3;
        Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopRight;
        Snackbar.Add(message, severity);
    }
    void RowClicked(DataGridRowClickEventArgs<M_LocalCharge_pt> args)
    {
        detail = args.Item;
    }
    private int selectedRowNumber = -1;
    private string SelectedRowClassFunc(M_LocalCharge_pt m, int rowNumber)
    {
        if (selectedRowNumber == rowNumber)
        {
            selectedRowNumber = -1;
            return string.Empty;
        }
        else if (mudTable.SelectedItem != null && mudTable.SelectedItem.Equals(m))
        {
            selectedRowNumber = rowNumber;
            return "selected";
        }
        else
        {
            return string.Empty;
        }
    }

    async Task CommittedItem(M_LocalCharge_pt item)
    {
        item.Userupdate = asv.GetAuth().Result.User.Identity!.Name!;
        item.Dateupdate = DateTime.Now.ToString("dd/MMM/yyyy");
        var rs = item.Id != Guid.Empty ? await lcsv.UpdateLocalCharges_Pt_Detail(item,detail_LCC) : await lcsv.CreateLocalCharges_Pt_Detail(item);
        CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);

        await Refresh();
    }
    int? index_no;
    async Task AddItem()
    {

        if (!await ssv.CheckPermission(usr, "Add", "LocalCharges_PT"))
        {
            CallSnackBar("You have not access to Add", MudBlazor.Severity.Warning);
            return;
        }
        var item = new M_LocalCharge_pt
        {

        };
        item.Index_ = await lcsv.Get_index();
        item.Userupdate = asv.GetAuth().Result.User.Identity!.Name!;
        item.Dateupdate = DateTime.Now.ToString("dd/MMM/yyyy");
        Listdata.Add(item);
        await mudTable.SetEditingItemAsync(Listdata.LastOrDefault()!);
    }
    async Task DeleteItem(M_LocalCharge_pt item)
    {
        if (!await ssv.CheckPermission(usr, "Delete", "LocalCharges_PT"))
        {
            CallSnackBar("You have not access to Delete", MudBlazor.Severity.Warning);
            return;
        }
        var resultMess = await DialogService.ShowMessageBox(
                "Warning",
                "Deleting can not be undone!",
                yesText: "Delete!", cancelText: "Cancel");

        if (resultMess.HasValue)
        {
            var rs = await lcsv.DeleteLocalCharges_Pt_Detail(item);
            await HistoryLogService.LogAsync(usr, "Delete", "LocalCharges_PT", item.Id, item.Carr, new { OldData = item });
            CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
            await Refresh();
        }

    }
    DialogOptions options = new DialogOptions 
    {
        ClassBackground = "class-dialog-custom",
        FullWidth = true,
        MaxWidth = MaxWidth.Medium,
        CloseOnEscapeKey = false,
        DisableBackdropClick = true
    };
    string search;

    private bool FilterFunc1(M_LocalCharge_pt sbd) => FilterFunc(sbd, search);

    private bool FilterFunc(M_LocalCharge_pt sbd, string searchString)
    {
        if (string.IsNullOrWhiteSpace(sbd.Carr))
            return true;
        if (string.IsNullOrWhiteSpace(searchString))
            return true;
        if (sbd.Carr!.Contains(searchString, StringComparison.OrdinalIgnoreCase))
            return true;
        if ($"{sbd.Carr} ".Contains(searchString))
            return true;
        return false;
    }

    private Func<M_LocalCharge_pt, string> _cellStyleFunc => x =>
      {


          return "color: #000000";
      };

      private async Task OpenCreateDialog(Models.M_LocalCharge_pt tr)
    {
        var optionsdialog = new DialogOptions { ClassBackground = "class-dialog-custom", FullWidth = true, MaxWidth = MaxWidth.Medium };

        if (await ssv.CheckPermission(asv.GetAuth().Result.User.Identity.Name, "Add", "LocalCharges_PT"))
        {

            DialogOptions closeOnEscapeKey = new DialogOptions() { CloseOnEscapeKey = true };
            var parameters = new DialogParameters<ADD> { { x => x._LocalCharge_Detail, tr }, { x => x.Status, "add" } };

            var dialog = await DialogService.ShowAsync<ADD>(tr.Id == Guid.Empty ? "LCC Shipping Line Create" : "LCC Shipping Line Edit", parameters, optionsdialog);
            var result = await dialog.Result;
            if (!result.Canceled)
            {
                var data = (M_LocalCharge_pt)result.Data;
                var rs = await lcsv.UpdateCreateLCC(data);
                await HistoryLogService.LogAsync(usr, "ADD", "LocalCharges_PT", data.Id, data.Carr, data);
                MudBlazor.Severity severity;
                if (rs[1] == "1")
                    severity = MudBlazor.Severity.Success;
                else
                    severity = MudBlazor.Severity.Error;

                CallSnackBar(rs[0], severity);
        
                await HandleRefresh_create(data.Id);

            }

            return;

        }
        else
        {
            CallSnackBar("You have not access to Create", MudBlazor.Severity.Warning);
            return;
        }

    }

    async Task HandleRefresh_create(Guid? id)
    {
        try
        {

            detail = null;

            Listdata.Clear();
    
            await Task.Delay(500);

            if (!await ssv.CheckPermission(asv.GetAuth().Result.User.Identity.Name, "View", "LocalCharges_PT"))
            {
                CallSnackBar("You have not access to view", MudBlazor.Severity.Warning);

                return;
            }
            Listdata = await lcsv.GetListLCC_create(id);
            StateHasChanged();
        }
        finally
        {


        }
    }

    private async Task OpenEditDialog(Models.M_LocalCharge_pt tr)
    {
        var optionsdialog = new DialogOptions { ClassBackground = "class-dialog-custom", FullWidth = true, MaxWidth = MaxWidth.Medium };
        if (tr == null)
        {
            CallSnackBar("Please select Data", MudBlazor.Severity.Warning);
            return;
        }

        if (await ssv.CheckPermission(asv.GetAuth().Result.User.Identity.Name, "Edit", "LocalCharges_PT"))
        {
            var OldData = JsonSerializer.Deserialize<M_LocalCharge_pt>(JsonSerializer.Serialize(tr));
            DialogOptions closeOnEscapeKey = new DialogOptions() { CloseOnEscapeKey = true };
            var parameters = new DialogParameters<ADD> { { x => x._LocalCharge_Detail, tr }, { x => x.Status, "edit" } };

            var dialog = await DialogService.ShowAsync<ADD>(tr.Id == Guid.Empty ? "LCC Shipping Line Edit" : "LCC Shipping Line Edit", parameters, optionsdialog);
            var result = await dialog.Result;
            // Giữ nguyên dòng được chọn
            selectedRowNumber = selectedRowNumber;
            StateHasChanged();

            if (!result.Canceled)
            {
                var data = (M_LocalCharge_pt)result.Data;
                var rs = await  lcsv.UpdateCreateLCC(data);
                await HistoryLogService.LogAsync(usr, "Update", "LocalCharges_PT", data.Id, data.Carr, new { OldData = OldData, NewData = data });
                MudBlazor.Severity severity;
                if (rs[1] == "1")
                    severity = MudBlazor.Severity.Success;
                else
                    severity = MudBlazor.Severity.Error;

                CallSnackBar(rs[0], severity);
            }

            return;

        }
        else
        {
            CallSnackBar("You have not access to Edit", MudBlazor.Severity.Warning);
            return;
        }

    }

    private async Task<IEnumerable<string>> searchCarr(string text)
    {
        try
        {
            if (string.IsNullOrWhiteSpace(text))
            {
                return Cuss_Carr.Where(x => !string.IsNullOrEmpty(x.COMPANY))
               .Select(x => x.COMPANY);
            }
            // MBL.Porname = mst_Consignee;
            return Cuss_Carr.Where(x => !string.IsNullOrEmpty(x.COMPANY) &&
                            x.COMPANY.Contains(text, StringComparison.OrdinalIgnoreCase))
               .Select(x => x.COMPANY);
        }
        catch (Exception)
        {
            throw;
        }
    }
}
