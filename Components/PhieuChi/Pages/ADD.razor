@using System.Globalization
@inject ISnackbar Snackbar
@inject AccountService asv
@inject TrainScheduleServices trainsv
@inject IStringLocalizer<SharedResource> Localizer
@inject SharedServices ssv
@inject LocalChargesServices lcsv
@inject SupportServices supsv
@inject LenhDieuXeServices ldxsv
@inject TKHQ_Services tkhqsv
@inject GlobalServices gsv
@inject Bieugianangha_Services Bgnhsv
@inject CustomerService Cussv
@inject PhieuThu_Chi_Services Thuchisv
@inject ShipmentService shipmentsv
@inject Danhmuctaikhoan_services DMTKSv
@inject IJSRuntime JSRuntime
@inject tigiaVCBservices Vcbsv
@inject DNTUServices DNTUSv

<style>
    .class-dialog-custom {
        backdrop-filter: blur(10px);
        transition: none !important;
        animation: none !important;
    }

    .selected {
        background: #855ff3 !important;
    }

        .selected > td {
            color: white !important;
        }

            .selected > td .mud-input {
                color: white !important;
            }

    .labelCustomColor label {
        font-weight: 600;
        color: #424242 !important;
    }

    .mud-table thead {
        background-color: #118AB2;
    }

    .mud-table th {
        background-color: #118AB2 !important;
        color: white !important;
    }

    .mud-table-foot tr {
        background-color: #118AB2 !important;
    }

    .footer-cell {
        background-color: #118AB2 !important;
        color: white !important;
    }

    .filter-header-cell {
        background-color: white !important;
        color: black !important;
    }

    .mud-menu {
        display: none;
    }

    .no-wrap {
        white-space: nowrap;
    }

    .custom-label .mud-input-label {
        color: #424242 !important;
    }

    .section-title {
        font-weight: 700;
        color: #118AB2;
        margin-top: 6px;
        margin-bottom: 0px;
        font-size: 14px;
        line-height: 1.2;
    }

    .receipt-action-button {
        min-width: 110px;
        height: 36px;
        padding: 5px 10px;
    }

    .receipt-alert {
        margin-top: 0px;
        margin-bottom: 2px;
        padding-top: 4px !important;
        padding-bottom: 4px !important;
    }

    .receipt-compact {
        margin-top: 0px !important;
    }

        .receipt-compact .mud-input-control {
            margin-top: 2px !important;
            margin-bottom: 2px !important;
        }

        .receipt-compact .mud-input-control-input-container {
            margin-top: 0px !important;
        }

        .receipt-compact .mud-grid-item {
            padding-top: 4px !important;
            padding-bottom: 4px !important;
        }

    .text-right input {
        text-align: right !important;
    }
</style>

<MudDialog>
    <DialogContent>
        <MudSpacer></MudSpacer>
        <MudContainer>

            <MudCard>
                <MudForm Model="@_Phieuchi_Detail" @ref="@form">
                    <MudCardContent>

                        <MudTabs>
                            <MudTabPanel Text="Payment Voucher Info">
                                <MudGrid Spacing="1" Class="receipt-compact">

                                    <!-- Voucher Information -->
                                    <MudItem xs="12">
                                        <MudText Typo="Typo.subtitle2" Class="section-title">Voucher Information</MudText>
                                    </MudItem>

                                    <MudItem xs="2">
                                        <MudButton Style="background-color: #007BFF; color: white;"
                                                   Size="Size.Small"
                                                   Color="Color.Primary"
                                                   Disabled="@(Status == "edit")"
                                                   Class="receipt-action-button"
                                                   OnClick="() => Get_PhieuChiNo()">
                                            Auto No.
                                        </MudButton>
                                    </MudItem>

                                    <MudItem xs="4">
                                        <MudTextField @bind-Value="_Phieuchi_Detail.Sophieuchi"
                                                      Disabled="true"
                                                      Label="@Localizer["Sophieuchi"]"
                                                      Required="true"
                                                      Class="custom-label" />
                                    </MudItem>

                                    <MudItem xs="4">
                                        <MudAutocomplete T="Guid"
                                                         @bind-Value="sodntt"
                                                         Label="@Localizer["DNTT"]"
                                                         SearchFunc="SearchDNTT"
                                                         ToStringFunc="DnttidtosoDntt"
                                                         MaxItems="10"
                                                         Clearable
                                                         Class="custom-label" />
                                    </MudItem>

                                    <MudItem xs="2">
                                        <MudButton Variant="Variant.Filled"
                                                   Color="Color.Success"
                                                   Size="Size.Small"
                                                   Class="receipt-action-button"
                                                   OnClick="@(() => get_info_Dntt(_Phieuchi_Detail))">
                                            Get Info
                                        </MudButton>
                                    </MudItem>

                                    <MudItem xs="6">
                                        <MudDatePicker Class="custom-label"
                                                       @bind-Date="_Phieuchi_Detail.Ngay"
                                                       For="@(() => _Phieuchi_Detail.Ngay)"
                                                       Label="@Localizer["NGAY"]"
                                                       DateFormat="dd/MM/yyyy"
                                                       Required="true" />
                                    </MudItem>

                                    <MudItem xs="6">
                                        <MudSelect @bind-Value="_Phieuchi_Detail.Branch"
                                                   Label="@Localizer["Branch"]"
                                                   Class="custom-label">
                                            <MudSelectItem Value="@("SGN")">SGN</MudSelectItem>
                                            <MudSelectItem Value="@("HAN")">HAN</MudSelectItem>
                                        </MudSelect>
                                    </MudItem>

                                    <MudItem xs="6">
                                        <MudAutocomplete Class="custom-label"
                                                         T="Guid ?"
                                                         Label="@Localizer["Customer"]"
                                                         @bind-Value="_Phieuchi_Detail.Customer_ID"
                                                         SearchFunc="Search_Customer"
                                                         ToStringFunc="GetCustomerLable" />
                                    </MudItem>

                                    <MudItem xs="6">
                                        <MudTextField @bind-Value="_Phieuchi_Detail.Nguoinoptien"
                                                      Label="@Localizer["Nguoinoptien"]"
                                                      Class="custom-label" />
                                    </MudItem>

                                    <MudItem xs="12">
                                        <MudTextField @bind-Value="_Phieuchi_Detail.Noidung"
                                                      Label="@Localizer["noidung"]"
                                                      Class="custom-label" />
                                    </MudItem>

                                    <!-- Payment Information -->
                                    <MudItem xs="12">
                                        <MudText Typo="Typo.subtitle2" Class="section-title">Payment Information</MudText>
                                    </MudItem>

                                    <MudItem xs="6">
                                        <MudAutocomplete @bind-Value="_Phieuchi_Detail.PTTT"
                                                         Label="@Localizer["PTTT"]"
                                                         Class="custom-label"
                                                         CoerceValue
                                                         SearchFunc="SearchPTTT" />
                                    </MudItem>

                                    <MudItem xs="6">
                                        <MudTextField @bind-Value="_Phieuchi_Detail.Bank"
                                                      Label="@Localizer["Bank"]"
                                                      Class="custom-label" />
                                    </MudItem>

                                    <MudItem xs="6">
                                        <MudAutocomplete @bind-Value="_Phieuchi_Detail.Currency"
                                                         Label="@Localizer["Loaitiente"]"
                                                         Required="true"
                                                         Class="custom-label"
                                                         CoerceValue
                                                         SearchFunc="SearchCurr" />
                                    </MudItem>

                                    <MudItem xs="6">
                                        <MudStack Row Spacing="1" AlignItems="AlignItems.Center">
                                            <MudButton Variant="Variant.Filled"
                                                       Color="Color.Success"
                                                       Size="Size.Small"
                                                       Class="receipt-action-button"
                                                       OnClick="@(() => GetTigia(_Phieuchi_Detail))">
                                                Get Rate
                                            </MudButton>

                                            <MudNumericField @bind-Value="_Phieuchi_Detail.Tigia"
                                                             Label="@Localizer["tigia"]"
                                                             Format="#,##0.##"
                                                             Culture="@_en"
                                                             T="double?"
                                                             Required="true"
                                                             HideSpinButtons="true"
                                                             Dense="true"
                                                             Class="text-right custom-label" />
                                        </MudStack>
                                    </MudItem>

                                    <MudItem xs="6">
                                        <MudNumericField @bind-Value="_Phieuchi_Detail.Sotien"
                                                         HideSpinButtons="true"
                                                         Label="@Localizer["sotien"]"
                                                         Format="#,##0.##"
                                                         Culture="@_en"
                                                         Required="true"
                                                         T="double?"
                                                         Class="text-right custom-label" />
                                    </MudItem>

                                    <!-- Accounting Entry -->
                                    <MudItem xs="12">
                                        <MudText Typo="Typo.subtitle2" Class="section-title">Accounting Entry</MudText>
                                    </MudItem>

                                    <MudItem xs="6">
                                        <MudAutocomplete Class="labelCustomColor custom-label"
                                                         T="string"
                                                         @bind-Value="_Phieuchi_Detail.TKnophieuchi"
                                                         Label="Debit Account / TK Nợ"
                                                         SearchFunc="SearchTk"
                                                         Immediate="true"
                                                         CoerceText="true"
                                                         Clearable="true"
                                                         MaxItems="100">
                                        </MudAutocomplete>
                                    </MudItem>

                                    <MudItem xs="6">
                                        <MudAutocomplete Class="labelCustomColor custom-label"
                                                         T="string"
                                                         @bind-Value="_Phieuchi_Detail.TKCophieuchi"
                                                         Label="Credit Account / TK Có"
                                                         SearchFunc="SearchTk"
                                                         Immediate="true"
                                                         CoerceText="true"
                                                         Clearable="true"
                                                         MaxItems="100">
                                        </MudAutocomplete>
                                    </MudItem>

                                    <MudItem xs="12">
                                        <MudAlert Severity="@MudBlazor.Severity.Info" Dense="true" Class="receipt-alert">
                                            Phiếu chi sẽ hạch toán: Nợ tài khoản đối ứng, Có TK tiền mặt/ngân hàng.
                                            Ví dụ: Nợ 331/642/156 - Có 111/112.
                                        </MudAlert>
                                    </MudItem>

                                    <!-- Reference Documents -->
                                    <MudItem xs="12">
                                        <MudText Typo="Typo.subtitle2" Class="section-title">Reference Documents</MudText>
                                    </MudItem>

                                    <MudItem xs="6">
                                        <MudTextField @bind-Value="_Phieuchi_Detail.Chungtu"
                                                      Label="@Localizer["Chungtukemtheo"]"
                                                      Class="custom-label" />
                                    </MudItem>

                                    <MudItem xs="6">
                                        <MudTextField @bind-Value="_Phieuchi_Detail.SoHoaDon"
                                                      Label="@Localizer["sohoadon"]"
                                                      Class="custom-label" />
                                    </MudItem>

                                    <MudItem xs="6">
                                        <MudTextField @bind-Value="_Phieuchi_Detail.Ref"
                                                      Label="@Localizer["Ref"]"
                                                      Class="custom-label" />
                                    </MudItem>

                                    <MudItem xs="6">
                                        <MudTextField @bind-Value="_Phieuchi_Detail.Quyenso"
                                                      Label="@Localizer["Quyenso"]"
                                                      Class="custom-label" />
                                    </MudItem>

                                </MudGrid>
                            </MudTabPanel>

                            <MudTabPanel Text="Extra Info">
                                <MudGrid Spacing="1" Class="receipt-compact">

                                    <MudItem xs="6">
                                        <MudTextField @bind-Value="_Phieuchi_Detail.Hbl"
                                                      Label="@Localizer["HBL"]"
                                                      Class="custom-label" />
                                    </MudItem>

                                    <MudItem xs="6">
                                        <MudAutocomplete @bind-Value="_Phieuchi_Detail.Mbl"
                                                         Label="@Localizer["MBL"]"
                                                         Class="custom-label"
                                                         CoerceValue
                                                         SearchFunc="SearchMBL" />
                                    </MudItem>

                                    <MudItem xs="6">
                                        <MudTextField @bind-Value="_Phieuchi_Detail.Vesselvoy"
                                                      Label="@Localizer["Vesselvoy"]"
                                                      Class="custom-label" />
                                    </MudItem>

                                    <MudItem xs="6">
                                        <MudSelect @bind-Value="_Phieuchi_Detail.Trangthai"
                                                   Label="@Localizer["status"]"
                                                   Class="custom-label">
                                            @foreach (var item in trangthais)
                                            {
                                                <MudSelectItem Value="@item">@item</MudSelectItem>
                                            }
                                        </MudSelect>
                                    </MudItem>

                                </MudGrid>
                            </MudTabPanel>
                        </MudTabs>

                    </MudCardContent>
                </MudForm>

            </MudCard>
        </MudContainer>
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="@(async () => await Submit())">Save</MudButton>
        <MudButton Color="Color.Default" Variant="Variant.Text" OnClick="Cancel">Cancel</MudButton>
    </DialogActions>
</MudDialog>


@code {
    [CascadingParameter] MudDialogInstance? MudDialog { get; set; }
    [Parameter] public Models.M_PhieuChi _Phieuchi_Detail { get; set; }

    [Parameter] public string Status { get; set; }
    MudForm form;
    List<string> trangthais = new List<string>();
    private List<Models.TrangThai> M_Trangthais = new List<Models.TrangThai>();
    public CultureInfo _en = CultureInfo.GetCultureInfo("en-US");
    private List<Terminal_> Terminals = new List<Terminal_>();
    private List<Terminal_> Terminals_Address = new List<Terminal_>();
    List<M_PhieuChi> Phieuchis = new List<M_PhieuChi>();
    string UserHanding;
    private List<string> ListUser { get; set; } = new List<string>();
    List<M_Customer> Customers = new List<M_Customer>();
    List<M_MBL> MBLs = new List<M_MBL>();
    private List<string> List_Acc { get; set; } = new List<string>();
    List<string> currs = new List<string>();
    Guid sodntt;
    List<M_DNTT_Logistics> DNTTs = new List<M_DNTT_Logistics>();

    protected async override Task OnInitializedAsync()
    {

        if (Status == "Duplicate")
        {
            _Phieuchi_Detail.Sophieuchi = "";
            _Phieuchi_Detail.PhieuchiID = Guid.Empty;
            _Phieuchi_Detail.Approve = false;
            _Phieuchi_Detail.Continued = true;
            _Phieuchi_Detail.Editable = true;
        }
        List_Acc = await DMTKSv.GetList_Danhmuctaikhoan_search() ?? new List<string>();
        MBLs = await shipmentsv.GetListMBLALL();
        Customers = await Cussv.GetList();
        M_Trangthais = await supsv.GetListTrangThai();
        var tts = await supsv.GetListTrangThai();
        trangthais = tts.Where(x => x.Tieude == "Phieuchi").OrderBy(x => x.Noidung).Select(x => x.Noidung).ToList();
        Phieuchis = await Thuchisv.GetList_PhieuChi();
        Terminals_Address = await gsv.GetList_Terminal_add();
        currs = await Vcbsv.GetCur();
        ListUser = await asv.GetList_User_handle() ?? new List<string>();
        DNTTs = await DNTUSv.GetList_DNTT_approved();
    }

    private async Task Get_PhieuChiNo()
    {

        int formattedYear = DateTime.Now.Year;
        int formattedMonth = DateTime.Now.Month;

        string usr = asv.GetAuth().Result.User.Identity!.Name!;
        var refno = await supsv.GetRefNoByFunc("Phieuchi", formattedMonth, formattedYear, usr);

        var rs = asv.GetUserDetail();
        var cn = rs.Branch;
        _Phieuchi_Detail.Sophieuchi = cn + "PC_" + formattedYear.ToString() + formattedMonth.ToString() + refno.Value.ToString("D4");
    }

    private async Task Submit()
    {
        if ((await ssv.CheckPermission(asv.GetAuth().Result.User.Identity.Name, "Edit", "Phieuchi") || await ssv.CheckPermission(asv.GetAuth().Result.User.Identity.Name, "New", "Phieuchi")))
        {

            await form.Validate();

            if (form.IsValid)
            {
                if (string.IsNullOrWhiteSpace(_Phieuchi_Detail.TKnophieuchi))
                {
                    CallSnackBar("Vui lòng chọn tài khoản Nợ.", MudBlazor.Severity.Warning);
                    return;
                }

                if (string.IsNullOrWhiteSpace(_Phieuchi_Detail.TKCophieuchi))
                {
                    CallSnackBar("Vui lòng chọn tài khoản Có.", MudBlazor.Severity.Warning);
                    return;
                }

                if (_Phieuchi_Detail.Sotien == null || _Phieuchi_Detail.Sotien <= 0)
                {
                    CallSnackBar("Số tiền phải lớn hơn 0.", MudBlazor.Severity.Warning);
                    return;
                }

                var UserName = asv.GetAuth().Result.User.Identity!.Name!;
                _Phieuchi_Detail.DateUpdate = DateTime.Now.ToString("dd/MMM/yyyy");
                _Phieuchi_Detail.Useupdate = UserName;
                _Phieuchi_Detail.Loaiphieu = "PC";

                MudDialog!.Close(_Phieuchi_Detail);

            }
        }

    }
    void Cancel() => MudDialog.Cancel();

    void CallSnackBar(string message, MudBlazor.Severity severity)
    {

        Snackbar.Configuration.SnackbarVariant = Variant.Filled;
        Snackbar.Configuration.MaxDisplayedSnackbars = 3;
        Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopRight;
        Snackbar.Add(message, severity);
    }

    private Task<IEnumerable<Guid?>> Search_Customer(string value)
    {
        IEnumerable<M_Customer> query = Customers ?? new List<M_Customer>();

        if (!string.IsNullOrWhiteSpace(value))
        {
            query = query.Where(x =>
                !string.IsNullOrWhiteSpace(x.COMPANY) &&
                x.COMPANY.Contains(value, StringComparison.InvariantCultureIgnoreCase));
        }

        return Task.FromResult(query.Select(x => (Guid?)x.Customer_ID));
    }

    private string GetCustomerLable(Guid? id)
    {
        if (id == null || id == Guid.Empty)
            return string.Empty;

        var customer = Customers?.FirstOrDefault(x => x.Customer_ID == id);
        return customer?.COMPANY ?? string.Empty;
    }

    private async Task<IEnumerable<string>> SearchTk(string value)
    {
        if (string.IsNullOrEmpty(value))
            return List_Acc;

        return List_Acc.Where(x => x.Contains(value, StringComparison.InvariantCultureIgnoreCase));
    }

    private Task<IEnumerable<string?>> SearchPTTT(string? text)
    {
        var items = Phieuchis
            .Select(x => x.PTTT)
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Distinct();

        if (string.IsNullOrWhiteSpace(text))
            return Task.FromResult(items);

        return Task.FromResult(items.Where(x => x != null && x.Contains(text, StringComparison.OrdinalIgnoreCase)));
    }

    private Task<IEnumerable<string>> SearchMBL(string value)
    {
        var items = MBLs
            .Select(x => x.Mbl)
            .Where(x => !string.IsNullOrEmpty(x))
            .Distinct();

        if (string.IsNullOrWhiteSpace(value))
            return Task.FromResult(items);

        var result = items.Where(x => x.Contains(value, StringComparison.OrdinalIgnoreCase));
        return Task.FromResult(result);
    }

    private async Task GetTigia(M_PhieuChi item)
    {
        double? tigia_ = await Vcbsv.Getexchange_cur(item.Currency);
        item.Tigia = tigia_;
    }
    private async Task<IEnumerable<string>> SearchCurr(string? text)
    {
        if (string.IsNullOrWhiteSpace(text))
            return currs;

        return currs.Where(x => !string.IsNullOrEmpty(x) && x.Contains(text, StringComparison.OrdinalIgnoreCase));
    }


    private async Task<IEnumerable<Guid>> SearchDNTT(string text)
    {
        try
        {
            if (string.IsNullOrWhiteSpace(text))
            {
                return DNTTs.Select(x => x.Id);
            }
            // MBL.Porname = mst_Consignee;
            return DNTTs.Where(x => !string.IsNullOrEmpty(x.So) && (x.So).Contains(text, StringComparison.OrdinalIgnoreCase)).Select(x => x.Id);

        }
        catch (Exception)
        {
            throw;
        }
    }
    string DnttidtosoDntt(Guid PTid)
    {
        if (PTid == null || PTid == Guid.Empty)
            return string.Empty;
        var rs = DNTTs.FirstOrDefault(x => x.Id == PTid);
        return rs == null ? string.Empty : rs.So!;
    }
    private async Task get_info_Dntt(M_PhieuChi item)
    {
        var dntt_info = DNTUSv.Get_DNTT_BY_id(sodntt);
        if (dntt_info != null)
        {
            item.Customer_ID = dntt_info.Customerid;
            item.PTTT = dntt_info.PTTT;
            item.Sotien = dntt_info.Thanhtien;
            item.Currency = dntt_info.Loaitiente;
            item.Tigia = dntt_info.Tigia;
            item.Noidung = dntt_info.Noidung;

        }
    }
}
