<MudDialog>
    <DialogContent>
        <MudSpacer></MudSpacer>
        <MudContainer>

            <MudCard>
                <MudForm Model="@_Phieuchi_Detail" @ref="@form">
                    <MudCardContent>
                        <MudGrid>
                            <MudGrid>

                                <MudItem xs="2">
                                    <MudButton Style="background-color: #007BFF; color: white;" Size="Size.Small" Color="Color.Primary"
                                    Disabled="@(Status == "edit")"
                                    OnClick="() => Get_PhieuChiNo()">>>></MudButton>
                                </MudItem>

                                <MudItem xs="4">
                                    <MudTextField @bind-Value="_Phieuchi_Detail.Sophieuchi" Disabled="true" Label="@Localizer["Sophieuchi"]" Required="true" />
                                </MudItem>

                                <MudItem xs=4>
                                    <MudAutocomplete T="Guid" @bind-Value="sodntt" Label="@Localizer["DNTT"]"
                                                     SearchFunc="SearchDNTT" ToStringFunc="DnttidtosoDntt" MaxItems="10" Clearable />
                                </MudItem>

                                <MudItem xs=2>
                                    <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small"
                                               Style="min-width: 80px; height: 36px; padding: 5px 10px;"
                                               OnClick="@(() => get_info_Dntt(_Phieuchi_Detail))">
                                        @Localizer["Get Info"]
                                    </MudButton>
                                </MudItem>

                            </MudGrid>

                            <MudGrid>
                                <MudItem xs="6">
                                    <MudAutocomplete Class="custom-label" T="Guid?" Label="@Localizer["Customer"]"
                                    @bind-Value="_Phieuchi_Detail.Customer_ID"
                                    SearchFunc="Search_Customer"
                                    ToStringFunc="GetCustomerLable" />
                                </MudItem>


                                <MudItem xs="6">
                                    <MudSelect @bind-Value="_Phieuchi_Detail.Branch" Label="@Localizer["Branch"]" class="custom-label">
                                        <MudSelectItem Value="@("SGN")">SGN</MudSelectItem>
                                        <MudSelectItem Value="@("HAN")">HAN</MudSelectItem>

                                    </MudSelect>
                                </MudItem>


                                <MudItem xs="6">
                                    <MudAutocomplete Class=" labelCustomColor custom-label" T="string"
                                    @bind-Value="_Phieuchi_Detail.TKnophieuchi"
                                    Label="@Localizer["TKnophieuchi"]"
                                    SearchFunc="SearchTk"
                                    Immediate="true"
                                    CoerceText="true"
                                    Clearable="true"
                                    MaxItems="100">
                                    </MudAutocomplete>
                                </MudItem>


                                <MudItem xs="6">
                                    <MudAutocomplete Class=" labelCustomColor custom-label" T="string"
                                    @bind-Value="_Phieuchi_Detail.TKCophieuchi"
                                    Label="@Localizer["TKCophieuchi"]"
                                    SearchFunc="SearchTk"
                                    Immediate="true"
                                    CoerceText="true"
                                    Clearable="true"
                                    MaxItems="100">
                                    </MudAutocomplete>
                                </MudItem>

                                <MudItem xs="6">

                                    <MudDatePicker Class="custom-label" @bind-Date="_Phieuchi_Detail.Ngay"
                                    For="@(() => _Phieuchi_Detail.Ngay)"
                                    Label="@Localizer["NGAY"]"
                                    DateFormat="dd/MM/yyyy"
                                    Required="true" />
                                </MudItem>

                                <MudItem xs="6">
                                    <MudAutocomplete @bind-Value="_Phieuchi_Detail.PTTT" Label="@Localizer["PTTT"]"
                                    class="custom-label" CoerceValue SearchFunc="SearchPTTT" />
                                </MudItem>

                                <MudItem xs="6">
                                    <MudNumericField @bind-Value="_Phieuchi_Detail.Sotien" HideSpinButtons="true"
                                    Label="@Localizer["sotien"]" Format="#,##0.##" Culture="@_en" Required="true" T="double?"
                                    Class="text-right custom-label" />
                                </MudItem>

                             @*    <MudItem xs="6">
                                    <MudNumericField @bind-Value="_Phieuchi_Detail.Tigia" HideSpinButtons="true"
                                    Label="@Localizer["tigia"]" Format="#,##0.##" Culture="@_en" Required="true" T="double?"
                                    Class="text-right custom-label" />
                                </MudItem> *@
@* 
                                <MudItem xs="6">
                                    <MudSelect @bind-Value="_Phieuchi_Detail.Currency" Label="@Localizer["Loaitiente"]" Required="true" class="custom-label">
                                        <MudSelectItem Value="@("USD")">USD</MudSelectItem>
                                        <MudSelectItem Value="@("VND")">VND</MudSelectItem>

                                    </MudSelect>
                                </MudItem> *@

                                <MudItem xs="6">
                                    <MudAutocomplete @bind-Value="_Phieuchi_Detail.Currency" Label="@Localizer["Loaitiente"]" Required="true" Class="custom-label" CoerceValue SearchFunc="SearchCurr" />
                                </MudItem>



                                <MudItem xs="6">

                                    <MudStack Row Spacing="1" AlignItems="AlignItems.Center">
                                        <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small"
                                                   Style="min-width: 80px; height: 36px; padding: 5px 10px;"
                                                   OnClick="@(() => GetTigia(_Phieuchi_Detail))">
                                            @Localizer["gettigia"]
                                        </MudButton>

                                        <MudNumericField @bind-Value="_Phieuchi_Detail.Tigia"
                                                         Label="@Localizer["tigia"]"
                                                         Format="#,##0.##" Culture="@_en"
                                                         T="double?" Required="true" HideSpinButtons="true"
                                                         Dense="true"
                                                         Class="text-right custom-label" />
                                    </MudStack>
                                </MudItem>

                                <MudItem xs="6">
                                    <MudTextField @bind-Value="_Phieuchi_Detail.Nguoinoptien" Label="@Localizer["Nguoinoptien"]" Class="custom-label" />
                                </MudItem>

                                <MudItem xs="12">
                                    <MudTextField @bind-Value="_Phieuchi_Detail.Noidung" Label="@Localizer["noidung"]" Class="custom-label" Lines="3" />
                                </MudItem>

                                <MudItem xs="12">
                                    <MudTextField @bind-Value="_Phieuchi_Detail.Chungtu" Label="@Localizer["Chungtukemtheo"]" Class="custom-label" />
                                </MudItem>



                                <MudItem xs="6">
                                    <MudTextField @bind-Value="_Phieuchi_Detail.Hbl" Label="@Localizer["HBL"]" Class="custom-label" />
                                </MudItem>


                                <MudItem xs="6">
                                    <MudTextField @bind-Value="_Phieuchi_Detail.Bank" Label="@Localizer["Bank"]" Class="custom-label" />
                                </MudItem>

                                <MudItem xs="6">
                                    <MudTextField @bind-Value="_Phieuchi_Detail.SoHoaDon" Label="@Localizer["sohoadon"]" Class="custom-label" />
                                </MudItem>

                                <MudItem xs="6">
                                    <MudTextField @bind-Value="_Phieuchi_Detail.Vesselvoy" Label="@Localizer["Vesselvoy"]" Class="custom-label" />
                                </MudItem>

                                <MudItem xs="6">
                                    <MudTextField @bind-Value="_Phieuchi_Detail.Ref" Label="@Localizer["Ref"]" Class="custom-label" />
                                </MudItem>

                                <MudItem xs="6">
                                    <MudAutocomplete @bind-Value="_Phieuchi_Detail.Mbl" Label="@Localizer["MBL"]"
                                    class="custom-label" CoerceValue SearchFunc="SearchMBL" />
                                </MudItem>

                                <MudItem xs="6">
                                    <MudSelect @bind-Value="_Phieuchi_Detail.Trangthai" Label="@Localizer["status"]" class="custom-label">
                                        @foreach (var item in trangthais)
                                        {
                                            <MudSelectItem Value="item">@item</MudSelectItem>
                                        }
                                    </MudSelect>
                                </MudItem>

                                <MudItem xs="6">
                                    <MudTextField @bind-Value="_Phieuchi_Detail.Quyenso" Label="@Localizer["Quyenso"]" Class="custom-label" />
                                </MudItem>




                            </MudGrid>
                        </MudGrid>
                    </MudCardContent>
                </MudForm>

            </MudCard>
        </MudContainer>
    </DialogContent>
    <DialogActions>

        <MudButton OnClick="@(async () => await Submit())">Save</MudButton>
        <MudButton OnClick="Cancel">Cancel</MudButton>

    </DialogActions>
</MudDialog>



@code {
    [CascadingParameter] MudDialogInstance? MudDialog { get; set; }
    [Parameter] public Models.M_PhieuChi _Phieuchi_Detail { get; set; }

    [Parameter] public string Status { get; set; }
    MudForm form;
    List<string> trangthais = new List<string>();
    private List<Models.TrangThai> M_Trangthais = new List<Models.TrangThai>();
    public CultureInfo _en = CultureInfo.GetCultureInfo("en-US");
    private List<Terminal_> Terminals = new List<Terminal_>();
    private List<Terminal_> Terminals_Address = new List<Terminal_>();
    List<M_PhieuChi> Phieuchis = new List<M_PhieuChi>();
    string UserHanding;
    private List<string> ListUser { get; set; } = new List<string>();
    List<M_Customer> Customers = new List<M_Customer>();
    List<M_MBL> MBLs = new List<M_MBL>();
    private List<string> List_Acc { get; set; } = new List<string>();
    List<string> currs = new List<string>();
    Guid sodntt;
    List<M_DNTT_Logistics> DNTTs = new List<M_DNTT_Logistics>();

    protected async override Task OnInitializedAsync()
    {

        if (Status == "Duplicate")
        {
            _Phieuchi_Detail.Sophieuchi = "";
            _Phieuchi_Detail.PhieuchiID = Guid.Empty;
            _Phieuchi_Detail.Approve = false;
            _Phieuchi_Detail.Continued = true;
            _Phieuchi_Detail.Editable = true;
        }
        List_Acc = await DMTKSv.GetList_Danhmuctaikhoan_search() ?? new List<string>();
        MBLs = await shipmentsv.GetListMBLALL();
        Customers =await Cussv.GetList();
        M_Trangthais = await supsv.GetListTrangThai();
        var tts = await supsv.GetListTrangThai();
        trangthais = tts.Where(x => x.Tieude == "Phieuthu").OrderBy(x => x.Noidung).Select(x => x.Noidung).ToList();
        Phieuchis = await Thuchisv.GetList_PhieuChi();
        Terminals_Address = await gsv.GetList_Terminal_add();
        currs = await Vcbsv.GetCur();
        ListUser = await asv.GetList_User_handle() ?? new List<string>();
        DNTTs = await DNTUSv.GetList_DNTT_approved();
    }
   
    private async Task Get_PhieuChiNo()
    {

        int formattedYear = DateTime.Now.Year;
        int formattedMonth = DateTime.Now.Month;

        string usr = asv.GetAuth().Result.User.Identity!.Name!;
        var refno = await supsv.GetRefNoByFunc("Phieuchi", formattedMonth, formattedYear, usr);

        var rs = asv.GetUserDetail();
        var cn = rs.Branch;
        _Phieuchi_Detail.Sophieuchi = cn + "PC_" + formattedYear.ToString() + formattedMonth.ToString() + refno.Value.ToString("D4");
    }

    private async Task Submit()
    {
        if ((await ssv.CheckPermission(asv.GetAuth().Result.User.Identity.Name, "Edit", "Phieuthu") || await ssv.CheckPermission(asv.GetAuth().Result.User.Identity.Name, "New", "Phieuthu")))
        {

            await form.Validate();

            if (form.IsValid)
            {

                var UserName = asv.GetAuth().Result.User.Identity!.Name!;
                _Phieuchi_Detail.DateUpdate = DateTime.Now.ToString("dd/MMM/yyyy");
                _Phieuchi_Detail.Useupdate = UserName;
                _Phieuchi_Detail.Loaiphieu = "PC";

                MudDialog!.Close(_Phieuchi_Detail);

            }
        }

    }
    void Cancel() => MudDialog.Cancel();

    void CallSnackBar(string message, MudBlazor.Severity severity)
    {
        
        Snackbar.Configuration.SnackbarVariant = Variant.Filled;
        Snackbar.Configuration.MaxDisplayedSnackbars = 3;
        Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopRight;
        Snackbar.Add(message, severity);
    }

    private async Task<IEnumerable<Guid?>> Search_Customer(string value)
    {
        if (string.IsNullOrEmpty(value))
            return Customers.Select(x => (Guid?)x.Customer_ID);

        return Customers
        .Where(x => !string.IsNullOrEmpty(x.COMPANY) && x.COMPANY.Contains(value, StringComparison.InvariantCultureIgnoreCase))
        .Select(x => (Guid?)x.Customer_ID)  // Convert Customer_ID to Guid?
        .ToList();


    }

    private string GetCustomerLable(Guid? id)
    {
        var customer = Customers.FirstOrDefault(x => x.Customer_ID == id);
        return customer != null ? customer.COMPANY : string.Empty;
    }

    private async Task<IEnumerable<string>> SearchTk(string value)
    {
        if (string.IsNullOrEmpty(value))
            return List_Acc;

        return List_Acc.Where(x => x.Contains(value, StringComparison.InvariantCultureIgnoreCase));
    }

    private async Task<IEnumerable<string?>> SearchPTTT(string? text)
    {
        try
        {
            var items = Phieuchis.Select(x => x.PTTT).Distinct();
            if (string.IsNullOrEmpty(text))
            {
                return items;
            }
            // MBL.Porname = mst_Consignee;
            return items.Where(x => x != null && x.Equals(text));
        }
        catch (Exception)
        {
            throw;
        }
    }
  
    private Task<IEnumerable<string>> SearchMBL(string value)
    {
        var items = MBLs
            .Select(x => x.Mbl)
            .Where(x => !string.IsNullOrEmpty(x))
            .Distinct();

        if (string.IsNullOrWhiteSpace(value))
            return Task.FromResult(items);

        var result = items.Where(x => x.Contains(value, StringComparison.OrdinalIgnoreCase));
        return Task.FromResult(result);
    }

    private async Task GetTigia(M_PhieuChi item)
    {
        double? tigia_ = await Vcbsv.Getexchange_cur(item.Currency);
        item.Tigia = tigia_;
    }
    private async Task<IEnumerable<string>> SearchCurr(string? text)
    {
        if (string.IsNullOrWhiteSpace(text))
            return currs;

        return currs.Where(x => !string.IsNullOrEmpty(x) && x.Contains(text, StringComparison.OrdinalIgnoreCase));
    }


    private async Task<IEnumerable<Guid>> SearchDNTT(string text)
    {
        try
        {
            if (string.IsNullOrWhiteSpace(text))
            {
                return DNTTs.Select(x => x.Id);
            }
            // MBL.Porname = mst_Consignee;
            return DNTTs.Where(x => !string.IsNullOrEmpty(x.So) && (x.So).Contains(text, StringComparison.OrdinalIgnoreCase)).Select(x => x.Id);

        }
        catch (Exception)
        {
            throw;
        }
    }
    string DnttidtosoDntt(Guid PTid)
    {
        if (PTid == null || PTid == Guid.Empty)
            return string.Empty;
        var rs = DNTTs.FirstOrDefault(x => x.Id == PTid);
        return rs == null ? string.Empty : rs.So!;
    }
    private async Task get_info_Dntt(M_PhieuChi item)
    {
        var dntt_info = DNTUSv.Get_DNTT_BY_id(sodntt);
        if (dntt_info != null)
        {
            item.Customer_ID = dntt_info.Customerid;
            item.PTTT = dntt_info.PTTT;
            item.Sotien = dntt_info.Thanhtien;
            item.Currency = dntt_info.Loaitiente;
            item.Tigia = dntt_info.Tigia;
            item.Noidung = dntt_info.Noidung;

        }
    }
}
