@page "/"
@attribute [Authorize]
@using System.Globalization
@inject AccountService asv
@using BlazorBootstrap;
@inject tigiaVCBservices vcbsv
@inject SingletonSerivce singsv
<style>
    .isolate-style :is( .image-container, .full-image, .panel-content img, .mud-nav-group, .footer-container, .custom-button, .selected, .selected > td, .selected > td .mud-input, .labelCustomColor label, .mud-table thead, .mud-table th, .mud-table1, .button-align, .mud-table-customtext, .class-dialog-custom, .table-shipment-bg, .mud-table-foot tr, .footer-cell, .filter-header-cell, .no-wrap, .text-right input, .text-right textarea, .custom-right-align, .custom-label .mud-input-label, .label-right label, .no-wrap-cell, .nondisplay, .custom-credit thead tr, .custom-credit th, .table-hbl-bg, .custom-tab .mud-tabs-toolbar, .custom-tab .mud-tab, .close-tab-icon, .button-no-grow, .datagrid-responsive, .custom-disable, .custom-disable:hover ) {
        all: unset !important;
    }

        @@keyframes blink
    {
            0% {
                opacity: 1;
            }

            50% {
                opacity: 0.2;
            }

            100% {
                opacity: 1;
            }
        }

        .blinking-icon {
            animation: blink 1s infinite;
        }

        @@keyframes pulse
        {
                0% {
                    transform: scale(1);
                }

                50% {
                    transform: scale(1.1);
                }

                100% {
                    transform: scale(1);
                }
            }

            /* ===== Dashboard modern UI ===== */
            .dashboard-shell {
                background: linear-gradient(180deg, #f8fbff 0%, #ffffff 60%);
                border-radius: 18px;
            }

            .dashboard-toolbar {
                margin: 18px 28px 0 28px;
                padding: 16px 18px;
                border-radius: 18px;
                background: linear-gradient(135deg, #0f766e 0%, #2563eb 100%);
                color: #fff;
                box-shadow: 0 12px 30px rgba(37, 99, 235, .18);
            }

            .dashboard-title {
                color: #fff;
                font-weight: 800;
                letter-spacing: .2px;
            }

            .dashboard-subtitle {
                color: rgba(255,255,255,.78);
            }


            /* ===== Font chữ dashboard gọn, dễ đọc ===== */
            .dashboard-shell,
            .dashboard-toolbar,
            .dashboard-shell .mud-typography,
            .dashboard-shell .mud-button,
            .dashboard-shell .mud-button-label,
            .dashboard-shell .mud-input,
            .dashboard-shell .mud-input-label,
            .dashboard-shell .mud-select,
            .dashboard-shell .mud-chip,
            .map-info-panel {
                font-family: "Segoe UI", Roboto, Arial, sans-serif !important;
            }

            .dashboard-title {
                font-size: 22px !important;
                line-height: 1.25 !important;
            }

            .dashboard-subtitle {
                font-size: 13px !important;
                line-height: 1.45 !important;
            }

            .kpi-label,
            .chart-title {
                font-size: 15px !important;
                line-height: 1.25 !important;
            }

            .kpi-caption,
            .chart-caption {
                font-size: 12px !important;
                line-height: 1.35 !important;
            }

            .kpi-value {
                font-size: clamp(28px, 2vw, 38px) !important;
                line-height: 1.1 !important;
            }

            .dashboard-shell .mud-button {
                text-transform: none !important;
                font-size: 12px !important;
                font-weight: 650 !important;
                letter-spacing: .1px !important;
                border-radius: 10px !important;
                min-height: 34px !important;
            }

            .dashboard-shell .mud-icon-root {
                font-size: 20px;
            }

            .map-title-row .mud-typography {
                font-size: 14px !important;
                font-weight: 700 !important;
            }

            .map-controls-row .mud-input,
            .map-controls-row .mud-input-label,
            .map-search-box .mud-input,
            .map-search-box .mud-input-label {
                font-size: 12px !important;
            }

            .leaflet-container {
                font-family: "Segoe UI", Roboto, Arial, sans-serif !important;
                font-size: 12px !important;
            }


            .dashboard-help-btn {
                border-radius: 999px !important;
                background: rgba(255,255,255,.16) !important;
                color: white !important;
                border: 1px solid rgba(255,255,255,.28) !important;
                backdrop-filter: blur(8px);
            }

            .dashboard-refresh-btn {
                color: white !important;
                background: rgba(255,255,255,.16) !important;
                border-radius: 999px !important;
                border: 1px solid rgba(255,255,255,.26) !important;
            }

            .dashboard-grid {
                margin-top: 18px;
            }

            .dashboard-card,
            .dashboard-kpi-card,
            .dashboard-chart-card,
            .dashboard-map-card {
                width: 100%;
                height: 100%;
                border-radius: 20px !important;
                border: 1px solid rgba(15, 23, 42, .07);
                background: rgba(255,255,255,.96);
                box-shadow: 0 10px 28px rgba(15, 23, 42, .08) !important;
                overflow: hidden;
            }

            .dashboard-kpi-card {
                min-height: 190px;
                padding: 22px;
                position: relative;
            }

            .kpi-profit {
                background: linear-gradient(135deg, #ecfeff 0%, #ffffff 52%, #f0fdf4 100%);
            }

            .kpi-quote {
                background: linear-gradient(135deg, #eff6ff 0%, #ffffff 55%, #f8fafc 100%);
            }

            .kpi-debt {
                background: linear-gradient(135deg, #fff7ed 0%, #ffffff 55%, #fef2f2 100%);
            }

            .kpi-header,
            .chart-header {
                width: 100%;
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 12px;
                margin-bottom: 12px;
            }

            .kpi-label,
            .chart-title {
                font-weight: 700;
                color: #0f172a;
            }

            .kpi-caption,
            .chart-caption {
                color: #64748b;
                font-size: .82rem;
            }

            .kpi-value {
                color: #0f172a;
                font-weight: 800;
                line-height: 1.1;
                word-break: break-word;
            }

            .kpi-icon {
                padding: 10px;
                border-radius: 16px;
                background: rgba(37, 99, 235, .10);
                color: #2563eb;
                font-size: 42px !important;
            }

            .kpi-chart-wrapper {
                width: 100%;
                height: 138px;
                min-height: 138px;
                display: flex;
                align-items: center;
                justify-content: center;
            }

            /* Chart card: ép card vừa nội dung, không kéo cao theo row của MudGrid */
            .dashboard-chart-card {
                height: auto !important;
                min-height: 320px !important;
                max-height: 360px !important;
                padding: 18px;
                display: flex;
                flex-direction: column;
                overflow: hidden;
            }

            .dashboard-chart-item {
                align-self: flex-start;
                min-width: 0;
                height: auto !important;
            }

                .dashboard-chart-item > .mud-card {
                    height: auto !important;
                }

            .chart-header {
                flex: 0 0 auto;
            }

            /* Chart nằm gọn trong chiều cao cố định, không bị tạo khoảng trắng lớn */
            .profit-chart-wrapper,
            .shipment-chart-wrapper {
                width: 100%;
                height: clamp(210px, 15vw, 250px) !important;
                min-height: 210px !important;
                max-height: 250px !important;
                flex: 0 0 clamp(210px, 15vw, 250px);
                position: relative;
                overflow: hidden;
            }

                .profit-chart-wrapper svg,
                .profit-chart-wrapper svg,
                .profit-chart-wrapper canvas,
                .shipment-chart-wrapper svg,
                .shipment-chart-wrapper canvas {
                    width: 100% !important;
                    height: 100% !important;
                    max-height: 250px !important;
                    display: block !important;
                }

            /* Khu vực bản đồ chiếm đúng nửa màn hình desktop */
            .map-half-item {
                flex: 0 0 50% !important;
                max-width: 50% !important;
                width: 50% !important;
            }

            .dashboard-map-card {
                width: 100%;
                height: auto;
                min-height: unset;
                padding: 16px !important;
                overflow: hidden;
            }

            .map-toolbar,
            .map-controls-row {
                gap: 8px;
                flex-wrap: wrap;
            }

            .map-title-row {
                width: 100%;
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 10px;
                flex-wrap: wrap;
            }

            .map-panel-wrapper {
                margin-top: 12px;
                width: 100%;
                max-width: 100%;
                min-width: 0;
                position: relative;
                display: block;
            }

            .map-canvas-holder {
                width: 100%;
                min-width: 0;
                display: block;
            }

            /* Bản đồ hình vuông: rộng full nửa màn hình, cao bằng rộng */
            .dashboard-map-box {
                width: 100% !important;
                aspect-ratio: 1 / 1;
                height: auto;
                min-height: 420px !important;
                max-height: 640px !important;
                display: block !important;
                position: relative !important;
                border-radius: 18px;
                box-shadow: inset 0 0 0 1px rgba(15,23,42,.08), 0 8px 22px rgba(15,23,42,.08);
                overflow: hidden;
                background: #eef2ff;
            }

            .map-search-box {
                width: 260px;
                max-width: 100%;
            }

            @@media(max - width: 960px) {
                    .dashboard-toolbar {
                        margin: 12px 14px 0 14px;
                    }

                    .profit-chart-wrapper,
                    .shipment-chart-wrapper {
                        height: 220px !important;
                        min-height: 220px !important;
                        max-height: 220px !important;
                        flex-basis: 220px !important;
                    }

                    .map-half-item {
                        flex: 0 0 100% !important;
                        max-width: 100% !important;
                        width: 100% !important;
                    }

                    .map-panel-wrapper {
                        max-width: 100%;
                        min-width: 0;
                    }

                    .map-canvas-holder {
                        min-width: 0;
                    }

                    .dashboard-map-box {
                        width: 100% !important;
                        aspect-ratio: 1 / 1;
                        height: auto;
                        min-height: 320px !important;
                        max-height: none !important;
                    }
                }


                /* ===== Modern style cho lưới HBLRelease phía trên Dashboard ===== */
                .release-grid-modern {
                    margin: 10px 18px 18px 18px;
                    padding: 12px 14px 10px 14px;
                    border-radius: 18px;
                    background: linear-gradient(180deg, #ffffff 0%, #f8fbff 100%);
                    border: 1px solid rgba(15, 23, 42, .08);
                    box-shadow: 0 10px 26px rgba(15, 23, 42, .08);
                    overflow-x: auto;
                    overflow-y: hidden;
                }

                    .release-grid-modern .mud-paper,
                    .release-grid-modern .mud-table-container,
                    .release-grid-modern .mud-table,
                    .release-grid-modern .mud-data-grid {
                        border-radius: 14px !important;
                        background: #ffffff !important;
                        box-shadow: none !important;
                        overflow: hidden !important;
                    }

                    .release-grid-modern .mud-table-toolbar,
                    .release-grid-modern .mud-toolbar {
                        min-height: 46px !important;
                        padding: 8px 10px !important;
                        background: #ffffff !important;
                        border-bottom: 1px solid #eef2f7 !important;
                    }

                    .release-grid-modern .mud-button {
                        border-radius: 10px !important;
                        text-transform: none !important;
                        font-size: 12px !important;
                        font-weight: 650 !important;
                        letter-spacing: .1px !important;
                        min-height: 32px !important;
                        padding: 6px 12px !important;
                        box-shadow: 0 6px 14px rgba(37, 99, 235, .16) !important;
                    }

                    .release-grid-modern thead,
                    .release-grid-modern .mud-table-head {
                        background: linear-gradient(135deg, #0f766e 0%, #2563eb 100%) !important;
                    }

                        .release-grid-modern thead tr,
                        .release-grid-modern .mud-table-head tr {
                            background: transparent !important;
                        }

                        .release-grid-modern thead th,
                        .release-grid-modern .mud-table-head th {
                            background: transparent !important;
                            color: #ffffff !important;
                            font-size: 12.5px !important;
                            font-weight: 750 !important;
                            line-height: 1.25 !important;
                            padding: 10px 12px !important;
                            border-bottom: 1px solid rgba(255,255,255,.18) !important;
                            white-space: nowrap !important;
                        }

                        .release-grid-modern .mud-table-head .mud-input-root,
                        .release-grid-modern thead .mud-input-root {
                            min-height: 30px !important;
                            font-size: 12px !important;
                            color: #eaf4ff !important;
                        }

                        .release-grid-modern thead input,
                        .release-grid-modern .mud-table-head input,
                        .release-grid-modern thead .mud-input-slot,
                        .release-grid-modern .mud-table-head .mud-input-slot {
                            color: #eaf4ff !important;
                            font-size: 12px !important;
                        }

                            .release-grid-modern thead input::placeholder,
                            .release-grid-modern .mud-table-head input::placeholder {
                                color: rgba(255,255,255,.74) !important;
                                opacity: 1 !important;
                            }

                    .release-grid-modern .mud-input-underline:before,
                    .release-grid-modern .mud-input-underline:after {
                        border-bottom-color: rgba(255,255,255,.36) !important;
                    }

                    .release-grid-modern thead .mud-icon-root,
                    .release-grid-modern .mud-table-head .mud-icon-root {
                        color: #dbeafe !important;
                        font-size: 18px !important;
                    }

                    .release-grid-modern tbody tr,
                    .release-grid-modern .mud-table-body tr {
                        transition: background .18s ease, box-shadow .18s ease;
                    }

                        .release-grid-modern tbody tr:nth-child(even),
                        .release-grid-modern .mud-table-body tr:nth-child(even) {
                            background: #f8fbff !important;
                        }

                        .release-grid-modern tbody tr:hover,
                        .release-grid-modern .mud-table-body tr:hover {
                            background: #eef6ff !important;
                        }

                    .release-grid-modern td,
                    .release-grid-modern .mud-table-cell {
                        font-size: 12.5px !important;
                        color: #1e293b !important;
                        padding: 8px 12px !important;
                        border-bottom: 1px solid #edf2f7 !important;
                        white-space: nowrap !important;
                        vertical-align: middle !important;
                    }

                    .release-grid-modern .mud-table-pagination,
                    .release-grid-modern .mud-table-pagination-toolbar {
                        min-height: 42px !important;
                        background: #ffffff !important;
                        border-top: 1px solid #eef2f7 !important;
                        color: #475569 !important;
                        font-size: 12px !important;
                    }

                    .release-grid-modern::-webkit-scrollbar {
                        height: 8px;
                    }

                    .release-grid-modern::-webkit-scrollbar-thumb {
                        background: #cbd5e1;
                        border-radius: 999px;
                    }

                    .release-grid-modern::-webkit-scrollbar-track {
                        background: #f1f5f9;
                    }

                @@media(max - width: 960px) {
                        .release-grid-modern {
                            margin: 8px 10px 14px 10px;
                            padding: 10px;
                            border-radius: 14px;
                        }

                            .release-grid-modern td,
                            .release-grid-modern th,
                            .release-grid-modern .mud-table-cell {
                                font-size: 12px !important;
                                padding: 8px 10px !important;
                            }
                    }

                </style>
                <PageTitle>Dashboard</PageTitle>
                <div class="release-grid-modern">
                    <HBLRelease />
                </div>

                <MudPaper Elevation="0" Class="dashboard-toolbar">
                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                        <MudStack Spacing="0">
                            <MudText Typo="Typo.h5" Class="dashboard-title">Dashboard</MudText>
                            <MudText Typo="Typo.caption" Class="dashboard-subtitle">
                                Tổng quan lợi nhuận, báo giá, công nợ và tình trạng lô hàng trong năm @DateTime.Now.Year
                            </MudText>
                        </MudStack>

                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <MudIconButton HtmlTag="label"
                                           OnClick="refreshData"
                                           Disabled="_loading"
                                           Size="Size.Small"
                                           Variant="Variant.Filled"
                                           Icon="@Icons.Material.Filled.Refresh"
                                           Class="dashboard-refresh-btn blinking-icon" />
                            <a href="HDSDhtml/HDSD_Dashboard_Report_Final.html" target="_blank" style="text-decoration:none;">
                                <MudButton Size="Size.Small"
                                           Variant="Variant.Filled"
                                           StartIcon="@Icons.Material.Filled.Info"
                                           Class="dashboard-help-btn">
                                    Trợ giúp
                                </MudButton>
                            </a>
                        </MudStack>
                    </MudStack>
                </MudPaper>

                <MudContainer Class="mt-4 px-8 isolate-style dashboard-shell" MaxWidth="MaxWidth.False">
                    <MudGrid Class="dashboard-grid">
                        <MudItem xs="12" sm="12" md="4">
                            <MudCard Elevation="0" Class="dashboard-kpi-card kpi-profit">
                                <MudStack Spacing="2">
                                    <div class="kpi-header">
                                        <div>
                                            <MudText Typo="Typo.subtitle2" Class="kpi-label">Profit tháng @DateTime.Now.Month</MudText>
                                            <MudText Typo="Typo.caption" Class="kpi-caption">Tổng lợi nhuận hiện tại</MudText>
                                        </div>
                                        <MudIcon Icon="@Icons.Material.Filled.TrendingUp" Class="kpi-icon" />
                                    </div>
                                    <MudText Typo="Typo.h3" Class="kpi-value">@profitNow VND</MudText>
                                </MudStack>
                            </MudCard>
                        </MudItem>

                        <MudItem xs="12" sm="6" md="4">
                            <MudCard Elevation="0" Class="dashboard-kpi-card kpi-quote">
                                <div class="kpi-header">
                                    <div>
                                        <MudText Typo="Typo.subtitle2" Class="kpi-label">Yêu cầu báo giá</MudText>
                                        <MudText Typo="Typo.caption" Class="kpi-caption">Theo trạng thái quotation</MudText>
                                    </div>
                                    <MudText Typo="Typo.h6" Class="kpi-label">@dataQuo.Sum().ToString("0")</MudText>
                                </div>
                                <div class="kpi-chart-wrapper">
                                    <MudChart ChartType="MudBlazor.ChartType.Donut"
                                              LegendPosition="MudBlazor.Position.Top"
                                              InputData="@dataQuo"
                                              InputLabels="@labelsQuo"
                                              Width="100%"
                                              Height="150px" />
                                </div>
                            </MudCard>
                        </MudItem>

                        <MudItem xs="12" sm="6" md="4">
                            <MudCard Elevation="0" Class="dashboard-kpi-card kpi-debt">
                                <div class="kpi-header">
                                    <div>
                                        <MudText Typo="Typo.subtitle2" Class="kpi-label">Công nợ quá hạn</MudText>
                                        <MudText Typo="Typo.caption" Class="kpi-caption">Tình trạng công nợ khách hàng</MudText>
                                    </div>
                                    <MudText Typo="Typo.h6" Class="kpi-label">@dataDebt.Sum().ToString("0")</MudText>
                                </div>
                                <div class="kpi-chart-wrapper">
                                    <MudChart ChartType="MudBlazor.ChartType.Donut"
                                              LegendPosition="MudBlazor.Position.Top"
                                              InputData="@dataDebt"
                                              InputLabels="@labelsDebt"
                                              Width="100%"
                                              Height="150px" />
                                </div>
                            </MudCard>
                        </MudItem>
                        @* <MudItem xs="12" sm="6">
            <MudGrid>
                <MudItem xs="12">
                    <MudPaper Elevation="2" Class="pa-4" Style="height: 200px;">
                        <MudText Typo="Typo.caption">Báo cáo vấn đề</MudText>
                    </MudPaper>
                </MudItem>
                <MudItem xs="12">
                    <MudPaper Elevation="2" Class="pa-4" Style="height: 200px;"></MudPaper>
                </MudItem>
            </MudGrid>
        </MudItem> *@

                        <MudItem xs="12" sm="6" Class="dashboard-chart-item">
                            <MudCard Elevation="0" Class="dashboard-chart-card">
                                <div class="chart-header">
                                    <div>
                                        <MudText Typo="Typo.h6" Class="chart-title">Profit</MudText>
                                        <MudText Typo="Typo.caption" Class="chart-caption">Báo cáo lợi nhuận trong năm @DateTime.Now.Year</MudText>
                                    </div>
                                    <MudIcon Icon="@Icons.Material.Filled.ShowChart" Color="Color.Primary" />
                                </div>

                                <div class="profit-chart-wrapper">
                                    <MudChart ChartType="MudBlazor.ChartType.Line"
                                              LegendPosition="MudBlazor.Position.Bottom"
                                              ChartSeries="@dataProfitChart"
                                              XAxisLabels="@labelsProfit"
                                              Width="100%"
                                              Height="100%"
                                              ChartOptions="optionsProfit" />
                                </div>
                            </MudCard>
                        </MudItem>

                        <MudItem xs="12" sm="6" Class="dashboard-chart-item">
                            <MudCard Elevation="0" Class="dashboard-chart-card">
                                <div class="chart-header">
                                    <div>
                                        <MudText Typo="Typo.h6" Class="chart-title">Shipment</MudText>
                                        <MudText Typo="Typo.caption" Class="chart-caption">Báo cáo lô hàng trong năm @DateTime.Now.Year</MudText>
                                    </div>
                                    <MudIcon Icon="@Icons.Material.Filled.BarChart" Color="Color.Primary" />
                                </div>

                                <div class="shipment-chart-wrapper">
                                    <MudChart ChartType="MudBlazor.ChartType.Bar"
                                              LegendPosition="MudBlazor.Position.Bottom"
                                              ChartSeries="@dataShipment"
                                              XAxisLabels="@labelsShipment"
                                              Width="100%"
                                              Height="100%"
                                              ChartOptions="_axisChartOptions" />
                                </div>
                            </MudCard>
                        </MudItem>

                        <MudItem xs="12" md="6" lg="6" Class="map-half-item">
                            <MudCard Elevation="0" Class="dashboard-map-card">
                                <MudStack>
                                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-3 map-toolbar">
                                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                            <MudText Typo="Typo.h6">Theo dõi vị trí lô hàng</MudText>
                                            <MudButton OnClick="ToggleMapVisible"
                                                       Size="Size.Small"
                                                       Color="Color.Primary"
                                                       Variant="Variant.Outlined"
                                                       StartIcon="@(_mapVisible ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)">
                                                @(_mapVisible ? "Ẩn bản đồ" : "Hiện bản đồ")
                                            </MudButton>
                                        </MudStack>
                                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                            <MudTextField @bind-Value="searchHBLNo"
                                                          Label="Nhập HBL Number(s)"
                                                          Variant="Variant.Outlined"
                                                          Size="Size.Small"
                                                          Class="map-search-box"
                                                          OnKeyUp="OnHBLSearchKeyUp"
                                                          Placeholder="VD: HBL001 hoặc HBL001,HBL002..."
                                                          Lines="1"
                                                          Clearable="true" />
                                            <MudButton OnClick="SearchHBL"
                                                       Disabled="@(string.IsNullOrEmpty(searchHBLNo))"
                                                       Size="Size.Small"
                                                       Color="Color.Primary"
                                                       Variant="Variant.Filled"
                                                       StartIcon="@Icons.Material.Filled.Search">
                                                Tìm kiếm
                                            </MudButton>
                                            <MudButton OnClick="RefreshMap"
