<!-- Leaflet JavaScript -->
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" 
        integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" 
        crossorigin=""></script>

<script>
    let dashboardMap;
    let dashboardMarkers = [];
    let isFullscreen = false;
    let routePolylines = [];

    // Khởi tạo map cho dashboard với Leaflet
    function initDashboardMap() {
        try {
            // Khởi tạo map với OpenStreetMap
            dashboardMap = L.map('dashboardMap').setView([10.7769, 106.7009], 12);

            // Thêm OpenStreetMap tile layer
            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                attribution: '© <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
                maxZoom: 19
            }).addTo(dashboardMap);

            // Không sử dụng marker clustering để tránh lỗi
            console.log("Map initialized without clustering");

            console.log("Dashboard map initialized successfully with Leaflet");
        } catch (error) {
            console.error("Error initializing dashboard map:", error);
            // Hiển thị thông báo lỗi cho user
            const mapElement = document.getElementById("dashboardMap");
            if (mapElement) {
                mapElement.innerHTML = `
                    <div style="display: flex; flex-direction: column; align-items: center; justify-content: center; height: 100%; background: #f5f5f5; border-radius: 8px; padding: 20px; text-align: center;">
                        <h3 style="color: #d32f2f; margin-bottom: 10px;">⚠️ Lỗi Leaflet Map</h3>
                        <p style="color: #666; margin-bottom: 10px;">Không thể khởi tạo bản đồ</p>
                        <p style="color: #666; font-size: 14px;">Vui lòng kiểm tra kết nối internet</p>
                        <button onclick="location.reload()" style="margin-top: 10px; padding: 8px 16px; background: #1976d2; color: white; border: none; border-radius: 4px; cursor: pointer;">
                            Thử lại
                        </button>
                    </div>
                `;
            }
        }
    }

    // Load markers cho dashboard map với Leaflet
    window.loadDashboardMapMarkers = (jsonLocations, hblGroupsJson) => {
        if (!dashboardMap) {
            console.error("Dashboard map chưa được khởi tạo!");
            return;
        }

        let locations;
        let hblGroups = {};
        
        try {
            locations = JSON.parse(jsonLocations);
            if (hblGroupsJson) {
                hblGroups = JSON.parse(hblGroupsJson);
            }
        } catch (error) {
            console.error("Lỗi khi parse JSON:", error);
            return;
        }

        if (!Array.isArray(locations) || locations.length === 0) {
            console.log("Không có dữ liệu vị trí để hiển thị");
            dashboardMarkers.forEach(m => dashboardMap.removeLayer(m));
            dashboardMarkers = [];
            return;
        }

        // Xóa markers và polylines cũ
        dashboardMarkers.forEach(m => dashboardMap.removeLayer(m));
        dashboardMarkers = [];
        routePolylines.forEach(polyline => dashboardMap.removeLayer(polyline));
        routePolylines = [];
        
        // Xóa panel thông tin cũ nếu có
        const existingInfoPanel = document.querySelector('#map-info-panel');
        if (existingInfoPanel) {
            existingInfoPanel.remove();
        }

        const validMarkers = [];
        const hblColors = ['#ff4444', '#4285f4', '#44ff44', '#ff9800', '#9c27b0', '#00bcd4', '#4caf50', '#f44336'];
        const hblColorMap = {};
        let colorIndex = 0;

        // Tạo màu cho từng HBL
        Object.keys(hblGroups).forEach(hblNo => {
            hblColorMap[hblNo] = hblColors[colorIndex % hblColors.length];
            colorIndex++;
        });

        // Tạo markers cho từng HBL
        Object.keys(hblGroups).forEach(hblNo => {
            const hblLocations = hblGroups[hblNo];
            const hblColor = hblColorMap[hblNo];
            
            hblLocations.forEach((location, index) => {
                // Validate coordinates
                const lat = parseFloat(location.Latitude);
                const lng = parseFloat(location.Longitude);
                
                // Check if coordinates are valid
                if (isNaN(lat) || isNaN(lng) || 
                    lat < -90 || lat > 90 || 
                    lng < -180 || lng > 180) {
                    console.warn(`Tọa độ không hợp lệ cho HBL ${hblNo}: lat=${lat}, lng=${lng}`);
                    return;
                }

                try {
                    // Tạo custom icon với màu theo HBL
                    const customIcon = L.divIcon({
                        className: 'custom-div-icon',
                        html: `
                            <div style="
                                background-color: ${hblColor};
                                width: 40px;
                                height: 40px;
                                border-radius: 50%;
                                border: 3px solid white;
                                display: flex;
                                align-items: center;
                                justify-content: center;
                                color: white;
                                font-weight: bold;
                                font-size: 14px;
                                box-shadow: 0 2px 6px rgba(0,0,0,0.3);
                                ${index === 0 ? 'animation: pulse 2s infinite;' : ''}
                            ">
                                ${index + 1}
                            </div>
                        `,
                        iconSize: [40, 40],
                        iconAnchor: [20, 20]
                    });

                    // Tạo marker
                    const marker = L.marker([lat, lng], { icon: customIcon });

                    // Tạo popup content
                    const popupContent = `
                        <div class="custom-popup">
                            <h4 style="border-bottom-color: ${hblColor};">${hblNo} - Node ${index + 1}</h4>
                            <p><strong>Thời gian:</strong> ${new Date(location.ngay).toLocaleString('vi-VN')}</p>
                            <p><strong>Tọa độ:</strong> ${lat.toFixed(6)}, ${lng.toFixed(6)}</p>
                            <p><strong>HBL No:</strong> ${location.HBLNo || 'N/A'}</p>
                            ${location.Accuracy ? `<p><strong>Độ chính xác:</strong> ${location.Accuracy}m</p>` : ''}
                            ${location.Speed ? `<p><strong>Tốc độ:</strong> ${location.Speed} km/h</p>` : ''}
                            <div style="margin-top: 10px; padding: 5px; background: ${hblColor}20; border-left: 3px solid ${hblColor};">
                                <small style="color: #666;">Màu sắc: ${hblColor}</small>
                            </div>
                        </div>
                    `;

                    marker.bindPopup(popupContent);
                    marker.addTo(dashboardMap);
                    dashboardMarkers.push(marker);
                    validMarkers.push(marker);

                    // Tự động mở popup cho node đầu tiên
                    if (index === 0) {
                        setTimeout(() => {
                            marker.openPopup();
                        }, 1000);
                    }

                } catch (error) {
                    console.error(`Lỗi khi tạo marker cho HBL ${hblNo}:`, error);
                }
            });

            // Tạo polyline cho từng HBL
            if (hblLocations.length > 1) {
                const hblCoordinates = hblLocations
                    .filter(loc => {
                        const lat = parseFloat(loc.Latitude);
                        const lng = parseFloat(loc.Longitude);
                        return !isNaN(lat) && !isNaN(lng) && lat >= -90 && lat <= 90 && lng >= -180 && lng <= 180;
                    })
                    .map(loc => [parseFloat(loc.Latitude), parseFloat(loc.Longitude)]);

                if (hblCoordinates.length > 1) {
                    const polyline = L.polyline(hblCoordinates, {
                        color: hblColor,
                        weight: 4,
                        opacity: 0.8,
                        smoothFactor: 1
                    }).addTo(dashboardMap);
                    
                    routePolylines.push(polyline);
                }
            }
        });

        // Hiển thị thông tin tất cả markers
        if (validMarkers.length > 0) {
            showAllMarkersInfo(hblGroups, hblColorMap);
            
            // Fit map để hiển thị tất cả markers
            if (validMarkers.length > 0) {
                const group = new L.featureGroup(validMarkers);
                dashboardMap.fitBounds(group.getBounds().pad(0.1));
            }
        } else {
            console.warn("Không có marker hợp lệ nào được tạo");
        }
    };

    // Hiển thị thông tin tất cả markers
    function showAllMarkersInfo(hblGroups, hblColorMap) {
        const allMarkersInfo = [];
        
        Object.keys(hblGroups).forEach(hblNo => {
            const hblLocations = hblGroups[hblNo];
            const hblColor = hblColorMap[hblNo];
            
            hblLocations.forEach((location, index) => {
                const lat = parseFloat(location.Latitude);
                const lng = parseFloat(location.Longitude);
                
                if (!isNaN(lat) && !isNaN(lng) && lat >= -90 && lat <= 90 && lng >= -180 && lng <= 180) {
                    allMarkersInfo.push({
                        hblNo: hblNo,
                        nodeIndex: index + 1,
                        lat: lat,
                        lng: lng,
                        time: new Date(location.ngay).toLocaleString('vi-VN'),
                        hblColor: hblColor,
                        accuracy: location.Accuracy,
                        speed: location.Speed
                    });
                }
            });
        });
        
        // Sắp xếp theo thời gian
        allMarkersInfo.sort((a, b) => new Date(a.time) - new Date(b.time));
        
        // Tạo nội dung hiển thị tất cả thông tin
        const allInfoContent = `
            <div class="map-info-panel">
                <h3>📍 Thông tin tất cả vị trí (${allMarkersInfo.length} điểm)</h3>
                <div style="display: flex; flex-direction: column; gap: 10px;">
                    ${allMarkersInfo.map((info, index) => `
                        <div class="location-item" style="border-color: ${info.hblColor}; background: ${info.hblColor}10;">
                            <div class="location-header">
                                <h4 class="location-title" style="color: ${info.hblColor};">
                                    ${info.hblNo} - Node ${info.nodeIndex}
                                </h4>
                                <span class="location-number" style="background: ${info.hblColor};">
                                    #${index + 1}
                                </span>
                            </div>
                            <div class="location-details">
                                <p><strong>🕒 Thời gian:</strong> ${info.time}</p>
                                <p><strong>📍 Tọa độ:</strong> ${info.lat.toFixed(6)}, ${info.lng.toFixed(6)}</p>
                                ${info.accuracy ? `<p><strong>🎯 Độ chính xác:</strong> ${info.accuracy}m</p>` : ''}
                                ${info.speed ? `<p><strong>🚀 Tốc độ:</strong> ${info.speed} km/h</p>` : ''}
                            </div>
                        </div>
                    `).join('')}
                </div>
                <div style="margin-top: 15px; padding: 10px; background: #e3f2fd; border-radius: 8px; text-align: center;">
                    <small style="color: #1976d2; font-weight: bold;">
                        ✨ Sử dụng OpenStreetMap miễn phí!
                    </small>
                </div>
            </div>
        `;
        
        // Hiển thị thông tin tổng hợp ở góc map
        const infoDiv = document.createElement('div');
        infoDiv.innerHTML = allInfoContent;
        
        // Thêm nút đóng
        const closeButton = document.createElement('button');
        closeButton.innerHTML = '✕';
        closeButton.className = 'close-button';
        closeButton.onclick = () => infoDiv.remove();
        
        infoDiv.appendChild(closeButton);
        document.getElementById('dashboardMap').parentElement.appendChild(infoDiv);
    }

    // Thay đổi style bản đồ với Leaflet
    window.changeMapStyle = (styleType) => {
        if (!dashboardMap) return;
        
        // Xóa layer cũ
        dashboardMap.eachLayer(layer => {
            if (layer instanceof L.TileLayer) {
                dashboardMap.removeLayer(layer);
            }
        });
        
        // Thêm layer mới theo style
        let tileLayer;
        switch(styleType) {
            case 'satellite':
                tileLayer = L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}', {
                    attribution: '© Esri',
                    maxZoom: 19
                });
                break;
            case 'terrain':
                tileLayer = L.tileLayer('https://{s}.tile.opentopomap.org/{z}/{x}/{y}.png', {
                    attribution: '© OpenTopoMap',
                    maxZoom: 17
                });
                break;
            case 'hybrid':
                tileLayer = L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}', {
                    attribution: '© Esri',
                    maxZoom: 19
                });
                break;
            default: // roadmap
                tileLayer = L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                    attribution: '© OpenStreetMap contributors',
                    maxZoom: 19
                });
        }
        
        tileLayer.addTo(dashboardMap);
    };

    // Toggle traffic layer (không có trong Leaflet, sử dụng OpenStreetMap traffic overlay)
    window.toggleTrafficLayer = (show) => {
        if (!dashboardMap) return;
        
        // Leaflet không có traffic layer built-in như Google Maps
        // Có thể sử dụng OpenStreetMap traffic overlay hoặc bỏ qua
        console.log('Traffic layer không khả dụng với OpenStreetMap');
    };

    // Toggle fullscreen
    window.toggleFullscreenMap = (fullscreen) => {
        const mapElement = document.getElementById("dashboardMap");
        if (fullscreen) {
            mapElement.style.position = "fixed";
            mapElement.style.top = "0";
            mapElement.style.left = "0";
            mapElement.style.width = "100vw";
            mapElement.style.height = "100vh";
            mapElement.style.zIndex = "9999";
            mapElement.style.borderRadius = "0";
            isFullscreen = true;
        } else {
            mapElement.style.position = "relative";
            mapElement.style.top = "auto";
            mapElement.style.left = "auto";
            mapElement.style.width = "100%";
            mapElement.style.height = "750px";
            mapElement.style.zIndex = "auto";
            mapElement.style.borderRadius = "8px";
            isFullscreen = false;
        }
        
        // Trigger resize event để map tự điều chỉnh
        setTimeout(() => {
            if (dashboardMap) {
                dashboardMap.invalidateSize();
            }
        }, 100);
    };

    // Khởi tạo map khi trang load
    document.addEventListener('DOMContentLoaded', function() {
        setTimeout(initDashboardMap, 500);
    });

    // Function để xóa panel thông tin
    window.clearMapInfoPanel = () => {
        const existingInfoPanel = document.querySelector('#map-info-panel');
        if (existingInfoPanel) {
            existingInfoPanel.remove();
        }
    };
    
    // Function để đóng tất cả popup
    window.closeAllPopups = () => {
        if (dashboardMap) {
            dashboardMap.closePopup();
        }
    };
</script>

