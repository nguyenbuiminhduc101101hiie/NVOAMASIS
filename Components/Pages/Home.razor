                    {
                        <MudAlert Severity="@(searchMessage.Contains("không tìm thấy") ? MudBlazor.Severity.Warning : MudBlazor.Severity.Info)" 
                                  Class="mb-2" 
                                  Dense="true">
                            @searchMessage
