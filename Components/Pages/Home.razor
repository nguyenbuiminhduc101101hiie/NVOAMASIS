    string profitNow = "0";
    double? TProfit_(Guid id, string type)
    {
        var debit = ListDebit.Where(x => x.hblid == id).ToList();
        var credit = ListCredit.Where(x => x.hblid == id).ToList();
        var totaldebit = debit.Sum(x =>
        {
            var tien =  x.thanhtien;
            return x.tiente == "VND"
                ? tien * 1
                : tien * x.tigiadebit;
        });
        var totalcredit = credit.Sum(x =>
        {
            var tien = x.thanhtien;
            return x.tiente == "VND"
                ? tien * 1
                : tien * x.tigiacredit;
        });
        return totaldebit - totalcredit;
    }
    double? TProfit_USD(Guid id, string type)
    {
        var debit = ListDebit.Where(x => x.hblid == id).ToList();
        var credit = ListCredit.Where(x => x.hblid == id).ToList();
        var totaldebit = debit.Sum(x =>
        {
            var tien = x.thanhtiensauthue;
            return x.tiente == "USD"
                ? tien * 1
                : tien / (x.tigiadebit == 0 ? 1 : x.tigiadebit);
            
        });
        var totalcredit = credit.Sum(x =>
        {
            var tien = x.thanhtiensauthue;
            return x.tiente == "USD"
                ? tien * 1
                : tien / (x.tigiacredit == 0 ? 1 : x.tigiacredit);
        });
        return totaldebit - totalcredit;
    }
    
