    async Task SetupProfit()
    {
        try
        {
            var startOfYear = new DateTime(DateTime.Now.Year, 1, 1);
            var allMonths = Enumerable.Range(1, 12).ToList();
            // List<string> LabelsProfit = new List<string> { "Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep" };
            List<IChartDataset> dataProfit = new List<IChartDataset>();
            var colors = ColorUtility.CategoricalTwelveColors;
            var LabelsProfit = allMonths
               .Select(m => CultureInfo.CurrentCulture.DateTimeFormat.GetAbbreviatedMonthName(m))
               .ToList();

            //profit

            HBLs = await singsv.GetListHBLALL_bysale();
            var profitPerMonth = HBLs
                .Where(x => x.datereport.HasValue && x.datereport >= startOfYear)
                .GroupBy(x => x.datereport!.Value.Month)
                .Select(g => new
                {
                    Thang = g.Key,
                    Profit = g.Sum(x => Math.Round(TProfit_USD(x.hblID, "") ?? 0))
                })
                .ToList();

            dataProfit.Clear();
            var dataset1 = new LineChartDataset
                {
                    Label = "Profit",
                    Data = allMonths
                                .Select(month =>
                                    profitPerMonth.FirstOrDefault(p => p.Thang == month)?.Profit ?? 0
                                )
                                .Select(x => (double?)x)
                                .ToList(),
                    BackgroundColor = colors[0],
                    BorderColor = colors[0],
                    BorderWidth = 2,
                    HoverBorderWidth = 4,
                    // PointBackgroundColor = colors[0],
                    // PointRadius = 3, // show points
                    // PointHoverRadius = 4,

                    // datalabels
                    Datalabels = new() { Alignment = Alignment.End, Anchor = BlazorBootstrap.Anchor.End }
                };
            dataProfit.Add(dataset1);
            chartData = new ChartData
                {
                    Labels = LabelsProfit,
                    Datasets = dataProfit
                };

            lineChartOptions = new();
            lineChartOptions.Responsive = true;
            lineChartOptions.Interaction = new Interaction { Mode = InteractionMode.Index };

            lineChartOptions.Scales.X!.Title = new ChartAxesTitle { Text = DateTime.Now.Year.ToString(), Display = true };
            lineChartOptions.Scales.Y!.Title = new ChartAxesTitle { Text = "USD", Display = true };

            lineChartOptions.Plugins.Title!.Text = "Profit";
            lineChartOptions.Plugins.Title.Display = true;

            // datalabels
            lineChartOptions.Plugins.Datalabels.Color = "white";
            await lineChart.UpdateAsync(chartData, lineChartOptions);
        }
        catch(Exception ex)
