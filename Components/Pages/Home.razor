    // Methods cho map tracking
    async Task SearchHBL()
    {
        try
        {
            await EnsureMapVisibleAndReady();

            if (string.IsNullOrEmpty(searchHBLNo))
            {
                searchMessage = "Vui lòng nhập HBL Number";
                return;
            }

            searchMessage = "Đang tìm kiếm HBL...";
            StateHasChanged();

            // Parse multiple HBL numbers (comma-separated or line-separated)
            var hblNumbers = ParseHBLNumbers(searchHBLNo);

            if (hblNumbers.Count == 0)
            {
                searchMessage = "Không tìm thấy HBL number hợp lệ";
                return;
            }

            // Lấy dữ liệu vị trí cho nhiều HBL
            hblLocationData = await shipsv.GetlistVitrilohangByMultipleHBLNos(hblNumbers);

            // Tạo danh sách HBL đã tìm thấy
            selectedHBLs.Clear();
            mapData.Clear();

            var foundCount = 0;
            var totalLocations = 0;

            foreach (var kvp in hblLocationData)
            {
                if (kvp.Value.Count > 0)
                {
                    foundCount++;
                    totalLocations += kvp.Value.Count;

                    // Tạo HBL object từ dữ liệu vị trí
                    var firstLocation = kvp.Value.First();
                    var hbl = new M_HBL
                    {
                        hblID = firstLocation.HBLID,
                        hbl = firstLocation.HBLNo
                    };
                    selectedHBLs.Add(hbl);

                    // Thêm vào mapData tổng hợp
                    mapData.AddRange(kvp.Value);
                }
            }

            if (foundCount == 0)
            {
                searchMessage = $"Không tìm thấy dữ liệu vị trí cho {hblNumbers.Count} HBL";
                await LoadMapData(new List<M_HBLViTriLoHang>());
            }
            else
            {
                searchMessage = $"Đã tìm thấy {foundCount}/{hblNumbers.Count} HBL với {totalLocations} vị trí";
                await LoadMapData(mapData);
            }
        }
        catch (Exception ex)
        {
            searchMessage = "Có lỗi xảy ra khi tìm kiếm: " + ex.Message;
        }
    }

    private List<string> ParseHBLNumbers(string input)
    {
        if (string.IsNullOrWhiteSpace(input))
            return new List<string>();

        // Split by comma, semicolon, or newline
        var separators = new char[] { ',', ';', '\n', '\r' };
        var numbers = input.Split(separators, StringSplitOptions.RemoveEmptyEntries)
                          .Select(x => x.Trim())
                          .Where(x => !string.IsNullOrWhiteSpace(x))
                          .ToList();

        return numbers;
    }

    async Task RefreshMap()
    {
        try
        {
            await EnsureMapVisibleAndReady();

            if (selectedHBLs.Count == 0)
            {
                searchMessage = "Vui lòng chọn HBL trước khi reload";
                return;
            }

            // Sử dụng lại dữ liệu đã có hoặc tải lại từ HBLNos
            if (mapData.Count > 0)
            {
                await LoadMapData(mapData);
                searchMessage = $"Đã tìm thấy {mapData.Count} vị trí cho {selectedHBLs.Count} HBL";
            }
            else
            {
                // Tải lại dữ liệu từ HBLNos
                var hblNumbers = selectedHBLs.Select(h => h.hbl).ToList();
                hblLocationData = await shipsv.GetlistVitrilohangByMultipleHBLNos(hblNumbers);

                mapData.Clear();
                foreach (var kvp in hblLocationData)
                {
                    mapData.AddRange(kvp.Value);
                }

                await LoadMapData(mapData);

                if (mapData.Count == 0)
                {
                    searchMessage = "Không tìm thấy dữ liệu vị trí cho các HBL này";
                }
                else
                {
                    searchMessage = $"Đã tìm thấy {mapData.Count} vị trí cho {selectedHBLs.Count} HBL";
                }
            }
        }
        catch (Exception ex)
        {
            searchMessage = "Có lỗi xảy ra khi load dữ liệu: " + ex.Message;
        }
    }

    async Task ClearMap()
    {
        try
        {
            selectedHBLs.Clear();
            mapData.Clear();
            hblLocationData.Clear();
            searchHBLNo = string.Empty;
            searchMessage = "Đã xóa tất cả dữ liệu map";

            // Xóa panel thông tin trên map
            await JSRuntime.InvokeVoidAsync("clearMapInfoPanel");

            await LoadMapData(new List<M_HBLViTriLoHang>());
        }
        catch (Exception ex)
        {
            searchMessage = "Có lỗi xảy ra khi xóa map: " + ex.Message;
        }
    }

    async Task CloseAllPopups()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("closeAllPopups");
            searchMessage = "Đã đóng tất cả popup trên map";
        }
        catch (Exception ex)
        {
            searchMessage = "Có lỗi xảy ra khi đóng popup: " + ex.Message;
        }
    }

    async Task OnHBLSearchKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SearchHBL();
        }
    }

    async Task LoadMapData(List<M_HBLViTriLoHang> locations)
    {
        try
        {
            // Validate locations data before sending to JavaScript
            if (locations == null || locations.Count == 0)
            {
                searchMessage = "Không có dữ liệu vị trí để hiển thị";
                await JSRuntime.InvokeVoidAsync("loadDashboardMapMarkers", "[]", "{}");
                return;
            }

            // Filter out invalid coordinates
            var validLocations = locations.Where(loc =>
                loc.Latitude >= -90 && loc.Latitude <= 90 &&
                loc.Longitude >= -180 && loc.Longitude <= 180 &&
                loc.Latitude != 0 && loc.Longitude != 0
            ).ToList();

            if (validLocations.Count == 0)
            {
                searchMessage = "Không có tọa độ hợp lệ để hiển thị trên bản đồ";
                await JSRuntime.InvokeVoidAsync("loadDashboardMapMarkers", "[]", "{}");
                return;
            }

            // Tạo dữ liệu cho JavaScript với thông tin HBL
            var mapDataForJS = new
            {
                locations = validLocations,
                hblGroups = hblLocationData.Where(kvp => kvp.Value.Any())
                                          .ToDictionary(kvp => kvp.Key, kvp => kvp.Value.Where(loc =>
                                              loc.Latitude >= -90 && loc.Latitude <= 90 &&
                                              loc.Longitude >= -180 && loc.Longitude <= 180 &&
                                              loc.Latitude != 0 && loc.Longitude != 0).ToList())
            };

            var jsonData = System.Text.Json.JsonSerializer.Serialize(validLocations);
            var hblGroupsJson = System.Text.Json.JsonSerializer.Serialize(mapDataForJS.hblGroups);
            await JSRuntime.InvokeVoidAsync("loadDashboardMapMarkers", jsonData, hblGroupsJson);

            if (validLocations.Count < locations.Count)
            {
                searchMessage = $"Hiển thị {validLocations.Count}/{locations.Count} vị trí hợp lệ";
            }
            else
            {
                searchMessage = $"Đã tải {validLocations.Count} vị trí lên bản đồ";
            }
        }
        catch (Exception ex)
        {
            searchMessage = "Lỗi khi load map: " + ex.Message;
            Console.WriteLine($"Error in LoadMapData: {ex}");
        }
    }

    // Methods cho map controls
    async Task OnMapStyleChanged()
    {
        await EnsureMapVisibleAndReady();
        await JSRuntime.InvokeVoidAsync("changeMapStyle", selectedMapStyle);
    }

    async Task ToggleTraffic()
    {
        await EnsureMapVisibleAndReady();
        showTraffic = !showTraffic;
        selectedMapStyle = showTraffic ? "traffic" : "roadmap";
        await JSRuntime.InvokeVoidAsync("toggleTrafficLayer", showTraffic);
    }

