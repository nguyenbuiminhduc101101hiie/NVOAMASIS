@* @page "/" *@
@attribute [Authorize]
@inject IStringLocalizer<SharedResource> Localizer

@code {
    bool shouldOpenHome = false;

    protected async override Task OnInitializedAsync()
    {
        await OpenHome();

    }

    [CascadingParameter] Components.Layout.MainLayout? Layout { get; set; }
    RenderFragment RenderComponent(Type componentType) => builder =>
    {
        builder.OpenComponent(0, componentType);
        builder.CloseComponent();
    };
    async Task OpenHome()
    {
        if (Layout != null)
        {
            Layout.OpenTab("Dashboard", $"1. {Localizer["Dashboard"]}", RenderComponent(typeof(Components.Pages.Home)));
        }
    }
}
