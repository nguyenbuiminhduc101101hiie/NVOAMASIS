@page "/AccountingVouchers584"
@using NVOAMASIS.Data
@using NVOAMASIS.Models
@using NVOAMASIS.Services
@using Microsoft.EntityFrameworkCore
@using MudBlazor
@using NVOAMASIS.Data
@using NVOAMASIS.Models
@using NVOAMASIS.Resources
@attribute [Authorize]
@implements IDisposable
@inject TabRequestService TabRequests
@inject SharedServices ssv
@inject AccountService asv
@inject IDbContextFactory<AppDbContext> DbFactory
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IStringLocalizer<SharedResource> Localizer

<PageTitle>@Localizer["Av584.Title"]</PageTitle>

<div class="voucher-misa-page">
    <PpScreenHeader Title="@Localizer["Av584.Title"]" Subtitle="@Localizer["Av584.Subtitle"]">
        <Toolbar>
            <MudStack Row="true" Spacing="1" Class="flex-wrap voucher-toolbar">
                <MudButton Variant="Variant.Filled" Color="Color.Secondary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenAddAsync" Disabled="_busy">@Localizer["Av584.Add"]</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Edit" OnClick="OpenEditAsync" Disabled="_busy || _selected is null || IsPostedVoucher(_selected) || !CanEditDeleteByRole">@Localizer["Av584.Edit"]</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small" StartIcon="@Icons.Material.Filled.CheckCircle" OnClick="ApproveAsync" Disabled="_busy || _selected is null || _selected.Approve == true">@Localizer["Av584.Approve"]</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Warning" Size="Size.Small" StartIcon="@Icons.Material.Filled.CheckCircleOutline" OnClick="UnapproveAsync" Disabled="_busy || _selected is null || _selected.Approve != true">@Localizer["Av584.Unapprove"]</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Tertiary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Undo" OnClick="UnpostAsync" Disabled="_busy || _selected is null || !IsPostedVoucher(_selected) || !CanEditDeleteByRole">@Localizer["Av584.Unpost"]</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Error" Size="Size.Small" StartIcon="@Icons.Material.Filled.Delete" OnClick="DeleteAsync" Disabled="_busy || _selected is null || IsPostedVoucher(_selected) || !CanEditDeleteByRole">@Localizer["delete"]</MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Info" Size="Size.Small" StartIcon="@Icons.Material.Filled.Refresh" OnClick="LoadAsync" Disabled="_busy">@Localizer["reload"]</MudButton>
            </MudStack>
        </Toolbar>
    </PpScreenHeader>

    <MudGrid Spacing="2" Class="mb-3">
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="voucher-kpi-card" Elevation="0">
                <MudText Typo="Typo.caption">@Localizer["Av584.Kpi_Total"]</MudText>
                <MudText Typo="Typo.h6">@TotalVoucherCount.ToString("N0")</MudText>
                <MudText Typo="Typo.caption">@Localizer["Av584.Kpi_TotalHint"]</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="voucher-kpi-card" Elevation="0">
                <MudText Typo="Typo.caption">@Localizer["Av584.Kpi_Posted"]</MudText>
                <MudText Typo="Typo.h6">@PostedVoucherCount.ToString("N0")</MudText>
                <MudText Typo="Typo.caption">@Localizer["Av584.Kpi_PostedHint"]</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="voucher-kpi-card" Elevation="0">
                <MudText Typo="Typo.caption">@Localizer["Av584.Kpi_TotalDebit"]</MudText>
                <MudText Typo="Typo.h6">@TotalDebitAll.ToString("N0")</MudText>
                <MudText Typo="Typo.caption">@Localizer["Av584.Kpi_FromLines"]</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="voucher-kpi-card" Elevation="0">
                <MudText Typo="Typo.caption">@Localizer["Av584.Kpi_TotalCredit"]</MudText>
                <MudText Typo="Typo.h6">@TotalCreditAll.ToString("N0")</MudText>
                <MudText Typo="Typo.caption">@string.Format(Localizer["Av584.Kpi_Diff"], TotalDiffAll.ToString("N0"))</MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <MudPaper Class="voucher-misa-card" Elevation="0">
        <MudStack Row="true" Spacing="2" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="voucher-filter-bar">
            <MudTextField @bind-Value="_search"
                          Label="@Localizer["Av584.Search"]"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Immediate="true"
                          Clearable="true"
                          Class="voucher-search" />
            <MudText Typo="Typo.caption" Class="voucher-selected-text">
                @(_selected is null ? Localizer["Av584.NoSelection"] : string.Format(Localizer["Av584.Selected"], _selected.VoucherNo))
            </MudText>
        </MudStack>

        <MudDataGrid T="M_AccountingVouchers"
                     Items="VisibleItems"
                     Class="auto-fit-grid voucher-grid"
                     Dense="true"
                     Striped="true"
                     Bordered="true"
                     Hover="true"
                     Filterable="true"
                     FilterMode="@DataGridFilterMode.ColumnFilterRow"
                     RowClick="OnRowClick"
                     SelectedItem="_selected"
                     SelectedItemChanged="OnSelectedItemChanged"
                     RowClassFunc="RowClass"
                     Height="calc(100vh - 360px)"
                     FixedHeader="true"
                     Loading="_busy">
            <Columns>
                <HierarchyColumn T="M_AccountingVouchers" Filterable="false" />
                <PropertyColumn Property="x => x.VoucherNo" Title="@Localizer["GeneralLedgerEntries.VoucherNo"]" />
                <TemplateColumn Title="@Localizer["Av584.Col_Status"]">
                    <CellTemplate>
                        <span class="@StatusPillClass(context.Item)">@StatusLabel(context.Item.Status)</span>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="@Localizer["Av584.Approve"]">
                    <CellTemplate>
                        <span class="@ApprovePillClass(context.Item)">@ApproveLabel(context.Item.Approve)</span>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="@Localizer["Av584.Col_Posted"]">
                    <CellTemplate>
                        <span class="@PostedPillClass(context.Item)">@(IsPostedVoucher(context.Item) ? Localizer["Av584.Posted_Yes"] : Localizer["Av584.Posted_Open"])</span>
                    </CellTemplate>
                </TemplateColumn>
                <PropertyColumn Property="x => CustomerLabel(x.CompanyId)" Title="@Localizer["Av584.Col_Party"]" />
                <PropertyColumn Property="x => GetAccountCodesLabel(x.Id)" Title="@Localizer["Av584.Col_AccountAmount"]" />
                <PropertyColumn Property="x => GetVoucherDebitTotal(x.Id)" Title="@Localizer["Av584.Col_TotalDebit"]" Format="N2" CellClass="text-end fw-bold" HeaderClass="text-end" />
                <PropertyColumn Property="x => GetVoucherCreditTotal(x.Id)" Title="@Localizer["Av584.Col_TotalCredit"]" Format="N2" CellClass="text-end fw-bold" HeaderClass="text-end" />
                <TemplateColumn Title="@Localizer["Av584.Col_Balance"]">
                    <CellTemplate>
                        <span class="@BalancePillClass(context.Item)">@BalanceText(context.Item.Id)</span>
                    </CellTemplate>
                </TemplateColumn>
                <PropertyColumn Property="x => x.VoucherDate" Title="@Localizer["GeneralLedgerEntries.VoucherDate"]" Format="dd/MM/yyyy" />
                <PropertyColumn Property="x => x.PostingDate" Title="@Localizer["Av584.Col_PostingDate"]" Format="dd/MM/yyyy" />
                <PropertyColumn Property="x => x.FiscalYear" Title="@Localizer["GeneralLedgerEntries.Year"]" />
                <PropertyColumn Property="x => x.FiscalPeriod" Title="@Localizer["Av584.Col_Period"]" />
                <PropertyColumn Property="x => GetTransactionTypeName(x.TransactionTypeCode)" Title="@Localizer["Av584.Col_TransType"]" />
                <PropertyColumn Property="x => x.CurrencyCode" Title="@Localizer["GeneralLedgerEntries.CurrencyCode"]" />
                <PropertyColumn Property="x => x.ExchangeRate" Title="@Localizer["GeneralLedgerEntries.ExchangeRate"]" Format="N6" />
                <PropertyColumn Property="x => x.Description" Title="@Localizer["GeneralLedgerEntries.Description"]" />
                <PropertyColumn Property="x => x.ReferenceNo" Title="@Localizer["Av584.Col_ReferenceNo"]" />
                <PropertyColumn Property="x => x.ReferenceDate" Title="@Localizer["Av584.Col_ReferenceDate"]" Format="dd/MM/yyyy" />
                <PropertyColumn Property="x => x.SourceModule" Title="@Localizer["Av584.Col_Source"]" />
                <PropertyColumn Property="x => x.CreatedBy" Title="@Localizer["GeneralLedgerEntries.CreatedBy"]" />
                <PropertyColumn Property="x => x.CreatedDate" Title="@Localizer["GeneralLedgerEntries.CreatedAt"]" Format="dd/MM/yyyy HH:mm" />
                <PropertyColumn Property="x => x.ModifiedBy" Title="@Localizer["Av584.Col_ModifiedBy"]" />
                <PropertyColumn Property="x => x.ModifiedDate" Title="@Localizer["Av584.Col_ModifiedDate"]" Format="dd/MM/yyyy HH:mm" />
                <PropertyColumn Property="x => x.PostedBy" Title="@Localizer["Av584.Col_PostedBy"]" />
                <PropertyColumn Property="x => x.PostedDate" Title="@Localizer["Av584.Col_PostedDate"]" Format="dd/MM/yyyy HH:mm" />
            </Columns>
            <ChildRowContent>
                @{
                    var lines = GetVoucherLines(context.Item.Id);
                }
                @if (lines.Count == 0)
                {
                    <MudAlert Severity="MudBlazor.Severity.Info" Dense="true" Class="ma-2">@Localizer["Av584.NoLines"]</MudAlert>
                }
                else
                {
                    <MudTable T="M_AccountingVoucherLines" Items="lines" Dense="true" Hover="true" Bordered="true" Class="ma-2 voucher-lines-table">
                        <HeaderContent>
                            <MudTh>@Localizer["Av584.Child_LineNo"]</MudTh>
                            <MudTh>@Localizer["thuho"]</MudTh>
                            <MudTh>@Localizer["Av584.Child_AccountCode"]</MudTh>
                            <MudTh>@Localizer["Av584.Child_AccountName"]</MudTh>
                            <MudTh>@Localizer["Av584.Child_Description"]</MudTh>
                            <MudTh>@Localizer["Av584.Child_Customer"]</MudTh>
                            <MudTh>@Localizer["Av584.Child_ShipmentHbl"]</MudTh>
                            <MudTh>@Localizer["Av584.Child_HblNo"]</MudTh>
                            <MudTh>@Localizer["Av584.Child_BookingNo"]</MudTh>
                            <MudTh>@Localizer["Av584.Child_POR"]</MudTh>
                            <MudTh>@Localizer["Av584.Child_POL"]</MudTh>
                            <MudTh>@Localizer["Av584.Child_POD"]</MudTh>
                            <MudTh>@Localizer["Av584.Child_DEL"]</MudTh>
                            <MudTh>@Localizer["Av584.Child_ContainerNo"]</MudTh>
                            <MudTh>@Localizer["Av584.Child_SizeType"]</MudTh>
                            <MudTh>@Localizer["Av584.Child_Sale"]</MudTh>
                            <MudTh>@Localizer["Av584.Child_Mode"]</MudTh>
                            <MudTh>@Localizer["Av584.Child_DueDate"]</MudTh>
                            <MudTh align="right">@Localizer["Av584.Child_Debit"]</MudTh>
                            <MudTh align="right">@Localizer["Av584.Child_Credit"]</MudTh>
                            <MudTh>@Localizer["Av584.Child_Ledger"]</MudTh>
                            <MudTh>@Localizer["Av584.Child_Vat"]</MudTh>
                            <MudTh>@Localizer["Av584.Child_InvoiceNo"]</MudTh>
                        </HeaderContent>
                        <RowTemplate Context="line">
                            <MudTd DataLabel="@Localizer["Av584.Child_LineNo"]">@line.LineNo_</MudTd>
                            <MudTd DataLabel="@Localizer["thuho"]">
                                <MudCheckBox T="bool" Value="line.thuho" ReadOnly="true" Disabled="true" Dense="true" Color="Color.Info" />
                            </MudTd>
                            <MudTd DataLabel="@Localizer["Av584.Child_AccountCode"]">@(!string.IsNullOrWhiteSpace(line.AccountCode) ? line.AccountCode : GetTaiKhoan(line.DanhMucTaiKhoanID))</MudTd>
                            <MudTd DataLabel="@Localizer["Av584.Child_AccountName"]">@GetTenTaiKhoan(line.DanhMucTaiKhoanID)</MudTd>
                            <MudTd DataLabel="@Localizer["Av584.Child_Description"]">@line.LineDescription</MudTd>
                            <MudTd DataLabel="@Localizer["Av584.Child_Customer"]">@GetCustomerLabel(line.CustomerId)</MudTd>
                            <MudTd DataLabel="@Localizer["Av584.Child_ShipmentHbl"]">@GetHblLabel(line.ShipmentId)</MudTd>
                            <MudTd DataLabel="@Localizer["Av584.Child_HblNo"]">@line.HBLNo</MudTd>
                            <MudTd DataLabel="@Localizer["Av584.Child_BookingNo"]">@line.BookingNo</MudTd>
                            <MudTd DataLabel="@Localizer["Av584.Child_POR"]">@line.PORName</MudTd>
                            <MudTd DataLabel="@Localizer["Av584.Child_POL"]">@line.POLName</MudTd>
                            <MudTd DataLabel="@Localizer["Av584.Child_POD"]">@line.PODName</MudTd>
                            <MudTd DataLabel="@Localizer["Av584.Child_DEL"]">@line.DELName</MudTd>
                            <MudTd DataLabel="@Localizer["Av584.Child_ContainerNo"]">@line.ContainerNo</MudTd>
                            <MudTd DataLabel="@Localizer["Av584.Child_SizeType"]">@line.ContainerSizeType</MudTd>
                            <MudTd DataLabel="@Localizer["Av584.Child_Sale"]">@line.SaleName</MudTd>
                            <MudTd DataLabel="@Localizer["Av584.Child_Mode"]">@line.TransportMode</MudTd>
                            <MudTd DataLabel="@Localizer["Av584.Child_DueDate"]">@FormatDate(line.DueDate)</MudTd>
                            <MudTd DataLabel="@Localizer["Av584.Child_Debit"]" align="right">@line.DebitAmount.ToString("N2")</MudTd>
                            <MudTd DataLabel="@Localizer["Av584.Child_Credit"]" align="right">@line.CreditAmount.ToString("N2")</MudTd>
                            <MudTd DataLabel="@Localizer["Av584.Child_Ledger"]">@line.LedgerType</MudTd>
                            <MudTd DataLabel="@Localizer["Av584.Child_Vat"]">@(line.VatRate?.ToString("N2") ?? string.Empty)</MudTd>
                            <MudTd DataLabel="@Localizer["Av584.Child_InvoiceNo"]">@line.InvoiceNo</MudTd>
                        </RowTemplate>
                    </MudTable>
                    <MudPaper Class="voucher-child-total pa-2 mx-2 mb-2" Elevation="0">
                        <MudStack Row="true" Spacing="2" Justify="Justify.FlexEnd" AlignItems="AlignItems.Center">
                            <MudText Typo="Typo.body2">@string.Format(Localizer["Av584.Child_TotalLines"], lines.Count)</MudText>
                            <MudText Typo="Typo.body2">@string.Format(Localizer["Av584.Child_TotalDebit"], lines.Sum(x => x.DebitAmount).ToString("N2"))</MudText>
                            <MudText Typo="Typo.body2">@string.Format(Localizer["Av584.Child_TotalCredit"], lines.Sum(x => x.CreditAmount).ToString("N2"))</MudText>
                            <MudText Typo="Typo.body2" Color="@(lines.Sum(x => x.DebitAmount) - lines.Sum(x => x.CreditAmount) == 0 ? MudBlazor.Color.Success : MudBlazor.Color.Error)">
                                @string.Format(Localizer["Av584.Child_Difference"], (lines.Sum(x => x.DebitAmount) - lines.Sum(x => x.CreditAmount)).ToString("N2"))
                            </MudText>
                        </MudStack>
                    </MudPaper>
                }
            </ChildRowContent>
            <PagerContent>
                <MudDataGridPager T="M_AccountingVouchers" PageSizeOptions="new int[] { 10, 25, 50 }" />
            </PagerContent>
        </MudDataGrid>
    </MudPaper>
</div>

@code {
    private const string PermissionMenuName = "PhieuKeToan";

    private bool _busy;
    private string _usr = string.Empty;
    private string _userDept = string.Empty;
    private string _search = string.Empty;
    private List<M_AccountingVouchers> _items = new();
    private M_AccountingVouchers? _selected;
    private Dictionary<string, string> _transactionTypeNames = new();
    private Dictionary<Guid, M_Customer> _customerById = new();
    private Dictionary<Guid, DanhMucTaiKhoan> _danhMucById = new();
    private Dictionary<Guid, M_HBL> _hblById = new();
    private Dictionary<Guid, List<M_AccountingVoucherLines>> _linesByVoucherId = new();
    private Dictionary<Guid, string> _accountCodesByVoucherId = new();
    private Dictionary<Guid, decimal> _totalDebitByVoucherId = new();
    private Dictionary<Guid, decimal> _totalCreditByVoucherId = new();


    private int TotalVoucherCount => _items.Count;
    private int PostedVoucherCount => _items.Count(IsPostedVoucher);
    private decimal TotalDebitAll => _totalDebitByVoucherId.Values.Sum();
    private decimal TotalCreditAll => _totalCreditByVoucherId.Values.Sum();
    private decimal TotalDiffAll => TotalDebitAll - TotalCreditAll;

    private IEnumerable<M_AccountingVouchers> VisibleItems =>
        string.IsNullOrWhiteSpace(_search)
            ? _items
            : _items.Where(MatchesSearch);

    private bool CanEditDeleteByRole =>
        !string.IsNullOrWhiteSpace(_userDept)
        && (_userDept.Contains("ADMIN", StringComparison.OrdinalIgnoreCase)
            || _userDept.Contains("MANAGER", StringComparison.OrdinalIgnoreCase));

    private bool MatchesSearch(M_AccountingVouchers x)
    {
        var key = _search.Trim();
        return (x.VoucherNo?.Contains(key, StringComparison.OrdinalIgnoreCase) ?? false)
            || CustomerLabel(x.CompanyId).Contains(key, StringComparison.OrdinalIgnoreCase)
            || x.VoucherDate.ToString("dd/MM/yyyy").Contains(key, StringComparison.OrdinalIgnoreCase)
            || x.PostingDate.ToString("dd/MM/yyyy").Contains(key, StringComparison.OrdinalIgnoreCase)
            || x.FiscalYear.ToString().Contains(key, StringComparison.OrdinalIgnoreCase)
            || x.FiscalPeriod.ToString().Contains(key, StringComparison.OrdinalIgnoreCase)
            || GetTransactionTypeName(x.TransactionTypeCode).Contains(key, StringComparison.OrdinalIgnoreCase)
            || (x.TransactionTypeCode?.Contains(key, StringComparison.OrdinalIgnoreCase) ?? false)
            || StatusLabel(x.Status).Contains(key, StringComparison.OrdinalIgnoreCase)
            || ApproveLabel(x.Approve).Contains(key, StringComparison.OrdinalIgnoreCase)
            || (x.CurrencyCode?.Contains(key, StringComparison.OrdinalIgnoreCase) ?? false)
            || x.ExchangeRate.ToString().Contains(key, StringComparison.OrdinalIgnoreCase)
            || (x.Description?.Contains(key, StringComparison.OrdinalIgnoreCase) ?? false)
            || (x.ReferenceNo?.Contains(key, StringComparison.OrdinalIgnoreCase) ?? false)
            || (x.ReferenceDate?.ToString("dd/MM/yyyy").Contains(key, StringComparison.OrdinalIgnoreCase) ?? false)
            || (x.SourceModule?.Contains(key, StringComparison.OrdinalIgnoreCase) ?? false)
            || (x.SourceId?.ToString().Contains(key, StringComparison.OrdinalIgnoreCase) ?? false)
            || BoolLabel(x.Ghiso).Contains(key, StringComparison.OrdinalIgnoreCase)
            || BoolLabel(x.Both).Contains(key, StringComparison.OrdinalIgnoreCase)
            || (x.CreatedBy?.Contains(key, StringComparison.OrdinalIgnoreCase) ?? false)
            || (x.ModifiedBy?.Contains(key, StringComparison.OrdinalIgnoreCase) ?? false)
            || (x.PostedBy?.Contains(key, StringComparison.OrdinalIgnoreCase) ?? false)
            || (x.CancelledBy?.Contains(key, StringComparison.OrdinalIgnoreCase) ?? false)
            || GetAccountCodesLabel(x.Id).Contains(key, StringComparison.OrdinalIgnoreCase)
            || GetVoucherDebitTotal(x.Id).ToString("N2").Contains(key, StringComparison.OrdinalIgnoreCase)
            || GetVoucherCreditTotal(x.Id).ToString("N2").Contains(key, StringComparison.OrdinalIgnoreCase);
    }

    // khi hạch toán tự động tạo chứng từ mới, tab này (nếu đang mở) tự tải lại
    private Task OnVouchersChangedAsync() => InvokeAsync(async () =>
    {
        await LoadAsync();
        StateHasChanged();
    });

    public void Dispose() => TabRequests.VouchersChanged -= OnVouchersChangedAsync;

    protected override async Task OnInitializedAsync()
    {
        TabRequests.VouchersChanged += OnVouchersChangedAsync;
        var auth = await asv.GetAuth();
        _usr = auth.User.Identity?.Name ?? string.Empty;

        try
        {
            var userDetail = asv.GetUserDetail();
            _userDept = userDetail?.Department ?? string.Empty;
        }
        catch
        {
            _userDept = string.Empty;
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        await LoadAsync(_selected?.Id);
    }

    private async Task LoadAsync(Guid? focusVoucherId)
    {
        if (!await ssv.CheckPermission(_usr, "View", PermissionMenuName))
        {
            CallSnack(Localizer["NoPermission_View"], MudBlazor.Severity.Warning);
            _items.Clear();
            _selected = null;
            return;
        }

        try
        {
            _busy = true;
            await using var db = await DbFactory.CreateDbContextAsync();
            _items = await db.AccountingVouchers.AsNoTracking()
                .OrderByDescending(x => x.VoucherDate)
                .ThenByDescending(x => x.VoucherNo)
                .ToListAsync();

            // Avoid list.Contains translation for older SQL compatibility levels.
            // Load a lightweight lookup then map in memory.
            var types = await db.TransactionTypes.AsNoTracking()
                .Select(x => new { x.Code, x.Name })
                .ToListAsync();
            _transactionTypeNames = types
                .Where(x => !string.IsNullOrWhiteSpace(x.Code))
                .GroupBy(x => x.Code)
                .ToDictionary(g => g.Key, g => g.First().Name ?? string.Empty);
            var customers = await db.Customer.AsNoTracking()
                .Where(x => x.Customer_ID != Guid.Empty)
                .ToListAsync();
            _customerById = customers.ToDictionary(x => x.Customer_ID, x => x);
            var dms = await db.DanhMucTaiKhoan.AsNoTracking()
                .Where(x => x.Taikhoan != null)
                .ToListAsync();
            _danhMucById = dms.ToDictionary(x => x.Id, x => x);
            var hbls = await db.HBL.AsNoTracking()
                .Where(x => x.hblID != Guid.Empty)
                .ToListAsync();
            _hblById = hbls.ToDictionary(x => x.hblID, x => x);

            var lines = await db.AccountingVoucherLines.AsNoTracking()
                .ToListAsync();
            _linesByVoucherId = lines
                .GroupBy(x => x.VoucherId)
                .ToDictionary(g => g.Key, g => g.OrderBy(y => y.SortKey ?? int.MaxValue).ThenBy(y => y.LineNo_).ToList());
            _accountCodesByVoucherId = _linesByVoucherId.ToDictionary(
                x => x.Key,
                x => string.Join(", ", x.Value
                    .Select(FormatAccountCodeWithAmount)
                    .Where(y => !string.IsNullOrWhiteSpace(y))));

            _totalDebitByVoucherId = _linesByVoucherId.ToDictionary(
                x => x.Key,
                x => x.Value.Sum(y => y.DebitAmount));

            _totalCreditByVoucherId = _linesByVoucherId.ToDictionary(
                x => x.Key,
                x => x.Value.Sum(y => y.CreditAmount));

            RestoreSelectedVoucher(focusVoucherId);
        }
        catch (Exception ex)
        {
            CallSnack(ex.Message, MudBlazor.Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private void RestoreSelectedVoucher(Guid? voucherId)
    {
        if (!voucherId.HasValue || voucherId.Value == Guid.Empty)
        {
            _selected = null;
            return;
        }

        _selected = _items.FirstOrDefault(x => x.Id == voucherId.Value);
    }

    private void OnSelectedItemChanged(M_AccountingVouchers? item)
    {
        _selected = item;
    }

    private string GetTransactionTypeName(string code)
    {
        if (string.IsNullOrWhiteSpace(code))
            return string.Empty;
        return _transactionTypeNames.TryGetValue(code, out var n) ? n : code;
    }

    private static string StatusLabel(int status) => status switch
    {
        1 => "0-Draft",
        2 => "1-Posted",
        3 => "2-Cancelled",
        _ => status.ToString()
    };
    private static string ApproveLabel(bool? approve) => approve == true ? "Yes" : "No";
    private static string BoolLabel(bool? value) => value == true ? "Yes" : "No";

    private static string StatusPillClass(M_AccountingVouchers row) => row.Status switch
    {
        2 => "voucher-pill voucher-pill-posted",
        3 => "voucher-pill voucher-pill-cancelled",
        _ => "voucher-pill voucher-pill-draft"
    };

    private static string ApprovePillClass(M_AccountingVouchers row)
        => row.Approve == true ? "voucher-pill voucher-pill-approved" : "voucher-pill voucher-pill-open";

    private static string PostedPillClass(M_AccountingVouchers row)
        => IsPostedVoucher(row) ? "voucher-pill voucher-pill-posted" : "voucher-pill voucher-pill-open";

    private string BalanceText(Guid voucherId)
    {
        var diff = GetVoucherDebitTotal(voucherId) - GetVoucherCreditTotal(voucherId);
        if (GetVoucherDebitTotal(voucherId) == 0 && GetVoucherCreditTotal(voucherId) == 0)
            return Localizer["Av584.Balance_None"];
        return diff == 0 ? Localizer["Av584.Balance_Ok"] : diff.ToString("N2");
    }

    private string BalancePillClass(M_AccountingVouchers row)
    {
        var debit = GetVoucherDebitTotal(row.Id);
        var credit = GetVoucherCreditTotal(row.Id);
        if (debit == 0 && credit == 0)
            return "voucher-pill voucher-pill-open";
        return debit == credit ? "voucher-pill voucher-pill-approved" : "voucher-pill voucher-pill-cancelled";
    }

    private string CustomerLabel(Guid companyId)
    {
        if (!_customerById.TryGetValue(companyId, out var c))
            return companyId.ToString();
        var code = c.Customer_Code?.Trim() ?? string.Empty;
        var company = !string.IsNullOrWhiteSpace(c.COMPANY) ? c.COMPANY!.Trim() : (c.shortname?.Trim() ?? string.Empty);
        if (!string.IsNullOrWhiteSpace(code) && !string.IsNullOrWhiteSpace(company))
            return $"{code} - {company}";
        return !string.IsNullOrWhiteSpace(company) ? company : code;
    }

    private List<M_AccountingVoucherLines> GetVoucherLines(Guid voucherId)
        => _linesByVoucherId.TryGetValue(voucherId, out var lines) ? lines : new List<M_AccountingVoucherLines>();

    private string GetAccountCodesLabel(Guid voucherId)
        => _accountCodesByVoucherId.TryGetValue(voucherId, out var codes) ? codes : string.Empty;

    private decimal GetVoucherDebitTotal(Guid voucherId)
        => _totalDebitByVoucherId.TryGetValue(voucherId, out var total) ? total : 0m;

    private decimal GetVoucherCreditTotal(Guid voucherId)
        => _totalCreditByVoucherId.TryGetValue(voucherId, out var total) ? total : 0m;

    private string FormatAccountCodeWithAmount(M_AccountingVoucherLines line)
    {
        var accountCode = !string.IsNullOrWhiteSpace(line.AccountCode)
            ? line.AccountCode!.Trim()
            : GetTaiKhoan(line.DanhMucTaiKhoanID);

        if (string.IsNullOrWhiteSpace(accountCode))
            return string.Empty;

        if (line.DebitAmount != 0 && line.CreditAmount != 0)
            return $"{accountCode} N:{line.DebitAmount:N0}/C:{line.CreditAmount:N0}";

        if (line.DebitAmount != 0)
            return $"{accountCode} N:{line.DebitAmount:N0}";

        if (line.CreditAmount != 0)
            return $"{accountCode} C:{line.CreditAmount:N0}";

        return accountCode;
    }

    private string GetTenTaiKhoan(Guid id) => _danhMucById.TryGetValue(id, out var dm) ? (dm.Tentaikhoan ?? string.Empty) : string.Empty;

    private string GetTaiKhoan(Guid id) => _danhMucById.TryGetValue(id, out var dm) ? (dm.Taikhoan ?? string.Empty) : string.Empty;

    private string GetCustomerLabel(Guid? id)
    {
        if (id is null || id == Guid.Empty)
            return string.Empty;
        if (!_customerById.TryGetValue(id.Value, out var c))
            return string.Empty;
        var code = c.Customer_Code?.Trim() ?? string.Empty;
        var company = !string.IsNullOrWhiteSpace(c.COMPANY) ? c.COMPANY!.Trim() : (c.BIZName?.Trim() ?? string.Empty);
        if (!string.IsNullOrWhiteSpace(code) && !string.IsNullOrWhiteSpace(company))
            return $"{code} - {company}";
        return !string.IsNullOrWhiteSpace(code) ? code : company;
    }

    private string GetHblLabel(Guid? id)
    {
        if (id is null || id == Guid.Empty)
            return string.Empty;
        return _hblById.TryGetValue(id.Value, out var h) ? (h.hbl ?? string.Empty) : string.Empty;
    }

    private static string FormatDate(DateTime? value) => value?.ToString("dd/MM/yyyy") ?? string.Empty;

    private void OnRowClick(DataGridRowClickEventArgs<M_AccountingVouchers> args) => _selected = args.Item;

    private string RowClass(M_AccountingVouchers row, int _)
    {
        var classes = new List<string>();

        if (_selected?.Id == row.Id)
            classes.Add("selected-row-blue");

        if (IsPostedVoucher(row))
            classes.Add("posted-row-red");

        return string.Join(" ", classes);
    }

    /// <summary>Chứng từ sinh từ phiếu kho (10.18.2) — chỉ sửa / bỏ ghi sổ từ phiếu kho để tồn kho và sổ cái luôn khớp.</summary>
    private static bool IsInventoryVoucher(M_AccountingVouchers? row)
        => string.Equals(row?.SourceModule, NVOAMASIS.Services.Kho.KhoService.SourceModule, StringComparison.OrdinalIgnoreCase);

    private string InventoryVoucherMessage(string verb)
        => $"Chứng từ {_selected?.VoucherNo} sinh từ phiếu kho — muốn {verb} hãy vào 10.18.2 Phiếu nhập, xuất kho, bấm \"Bỏ ghi sổ\" phiếu đó.";

    private static bool IsPostedVoucher(M_AccountingVouchers? row)
        => row is not null
           && (row.Status == 2
               || row.Ghiso == true
               || !string.IsNullOrWhiteSpace(row.PostedBy));

    private async Task OpenAddAsync()
    {
        if (!await ssv.CheckPermission(_usr, "Add", PermissionMenuName))
        {
            CallSnack(Localizer["NoPermission_Add"], MudBlazor.Severity.Warning);
            return;
        }

        var dialog = DialogService.Show<AccountingVoucher_AddEditDialog>(
            "Chứng từ kế toán — Thêm",
            new DialogParameters { ["VoucherId"] = (Guid?)null },
            new DialogOptions { MaxWidth = MaxWidth.ExtraLarge, FullWidth = true, CloseOnEscapeKey = true });

        var rs = await dialog.Result;
        if (!rs.Canceled)
            await LoadAsync();
    }

    private async Task OpenEditAsync()
    {
        if (_selected is null)
            return;

        if (IsInventoryVoucher(_selected))
        {
            CallSnack(InventoryVoucherMessage("sửa"), MudBlazor.Severity.Warning);
            return;
        }

        if (!CanEditDeleteByRole)
        {
            CallSnack("Chỉ ADMIN hoặc MANAGER mới được sửa chứng từ.", MudBlazor.Severity.Warning);
            return;
        }

        if (IsPostedVoucher(_selected))
        {
            CallSnack("Chứng từ đã Posted/Ghi sổ, không được sửa.", MudBlazor.Severity.Warning);
            return;
        }

        if (_selected.Approve == true)
        {
            CallSnack("Chứng từ đã Approve, không được chỉnh sửa.", MudBlazor.Severity.Warning);
            return;
        }
        if (!await ssv.CheckPermission(_usr, "Edit", PermissionMenuName))
        {
            CallSnack(Localizer["NoPermission_Edit"], MudBlazor.Severity.Warning);
            return;
        }

        var focusVoucherId = _selected.Id;

        var dialog = DialogService.Show<AccountingVoucher_AddEditDialog>(
            "Chứng từ kế toán — Sửa",
            new DialogParameters { ["VoucherId"] = focusVoucherId },
            new DialogOptions { MaxWidth = MaxWidth.ExtraLarge, FullWidth = true, CloseOnEscapeKey = true });

        var rs = await dialog.Result;
        if (!rs.Canceled)
            await LoadAsync(focusVoucherId);
    }

