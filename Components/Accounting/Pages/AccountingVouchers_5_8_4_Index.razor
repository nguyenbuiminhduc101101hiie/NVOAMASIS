        {
            CallSnack(Localizer["Av584.NoApprovePermission"], MudBlazor.Severity.Warning);
            return;
        }

        try
        {
            var focusVoucherId = _selected.Id;
            _busy = true;
            await using var db = await DbFactory.CreateDbContextAsync();
            var entity = await db.AccountingVouchers.FirstOrDefaultAsync(x => x.Id == focusVoucherId);
