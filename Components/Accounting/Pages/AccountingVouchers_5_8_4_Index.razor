@page "/AccountingVouchers584"
@using NVOAMASIS.Data
@using NVOAMASIS.Models
@using NVOAMASIS.Services
@using Microsoft.EntityFrameworkCore
@using MudBlazor
@using NVOAMASIS.Data
@using NVOAMASIS.Models
@using NVOAMASIS.Resources
@attribute [Authorize]
@inject SharedServices ssv
@inject AccountService asv
@inject IDbContextFactory<AppDbContext> DbFactory
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IStringLocalizer<SharedResource> Localizer

<PageTitle>5.8.4 Chứng Từ Kế Toán</PageTitle>

<div class="product-price-page">
    <PpScreenHeader Title="10.4 Chứng Từ Kế Toán" Subtitle="@Localizer["PhieuKeToan"]">
        <Toolbar>
            <MudStack Row="true" Spacing="1" Class="flex-wrap">
                <MudButton Variant="Variant.Filled" Color="Color.Secondary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenAddAsync" Disabled="_busy">@Localizer["new"]</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Edit" OnClick="OpenEditAsync" Disabled="_busy || _selected is null">@Localizer["edit"]</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small" StartIcon="@Icons.Material.Filled.CheckCircle" OnClick="ApproveAsync" Disabled="_busy || _selected is null || _selected.Approve == true">Approve</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Warning" Size="Size.Small" StartIcon="@Icons.Material.Filled.CheckCircleOutline" OnClick="UnapproveAsync" Disabled="_busy || _selected is null || _selected.Approve != true">Hủy Approve</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Error" Size="Size.Small" StartIcon="@Icons.Material.Filled.Delete" OnClick="DeleteAsync" Disabled="_busy || _selected is null">@Localizer["delete"]</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Info" Size="Size.Small" StartIcon="@Icons.Material.Filled.Refresh" OnClick="LoadAsync" Disabled="_busy">@Localizer["reload"]</MudButton>
            </MudStack>
        </Toolbar>
    </PpScreenHeader>

    <MudPaper Class="product-price-card pa-3" Elevation="0">
        <MudTextField @bind-Value="_search"
                      Label="@Localizer["search"]"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      Immediate="true"
                      Clearable="true"
                      Class="mb-2" />
        <MudDataGrid T="M_AccountingVouchers"
                     Items="VisibleItems"
                     Class="auto-fit-grid"
                     Dense="true"
                     Striped="true"
                     Bordered="true"
                     Hover="true"
                     Filterable="true"
                     FilterMode="@DataGridFilterMode.ColumnFilterRow"
                     RowClick="OnRowClick"
                     RowClassFunc="RowClass"
                     Height="calc(100vh - 300px)"
                     FixedHeader="true"
                     Loading="_busy">
            <Columns>
                <HierarchyColumn T="M_AccountingVouchers" />
                <PropertyColumn Property="x => x.VoucherNo" Title="@Localizer["Sophieuketoan"]" />
                <PropertyColumn Property="x => CustomerLabel(x.CompanyId)" Title="@Localizer["AccountingVoucherLine.Customer"]" />
                <PropertyColumn Property="x => GetAccountCodesLabel(x.Id)" Title="Account Codes" />
                <PropertyColumn Property="x => x.VoucherDate" Title="@Localizer["Ngay"]" Format="dd/MM/yyyy" />
                <PropertyColumn Property="x => x.PostingDate" Title="@Localizer["AccountingVoucher.PostingDate"]" Format="dd/MM/yyyy" />
                <PropertyColumn Property="x => x.FiscalYear" Title="@Localizer["AccountingVoucher.FiscalYear"]" />
                <PropertyColumn Property="x => x.FiscalPeriod" Title="@Localizer["AccountingVoucher.FiscalPeriod"]" />
                <PropertyColumn Property="x => GetTransactionTypeName(x.TransactionTypeCode)" Title="@Localizer["AccountingVoucher.TransactionType"]" />
                <PropertyColumn Property="x => StatusLabel(x.Status)" Title="@Localizer["status"]" />
                <PropertyColumn Property="x => ApproveLabel(x.Approve)" Title="@Localizer["AccountingVoucher.Approve"]" />
                <PropertyColumn Property="x => x.CurrencyCode" Title="@Localizer["Loaitiente"]" />
                <PropertyColumn Property="x => x.ExchangeRate" Title="@Localizer["AccountingVoucher.ExchangeRate"]" />
                <PropertyColumn Property="x => x.Description" Title="@Localizer["noidung"]" />
                <PropertyColumn Property="x => x.ReferenceNo" Title="@Localizer["AccountingVoucher.ReferenceNo"]" />
                <PropertyColumn Property="x => x.ReferenceDate" Title="@Localizer["AccountingVoucher.ReferenceDate"]" Format="dd/MM/yyyy" />

                <PropertyColumn Property="x => x.SourceModule" Title="@Localizer["AccountingVoucher.SourceModule"]" />
                <PropertyColumn Property="x => x.SourceId" Title="@Localizer["AccountingVoucher.SourceId"]" />
                <PropertyColumn Property="x => BoolLabel(x.Ghiso)" Title="@Localizer["AccountingVoucher.Ghiso"]" />
                <PropertyColumn Property="x => BoolLabel(x.Both)" Title="@Localizer["AccountingVoucher.Both"]" />

                <PropertyColumn Property="x => x.CreatedBy" Title="@Localizer["AccountingVoucher.CreatedBy"]" />
                <PropertyColumn Property="x => x.CreatedDate" Title="@Localizer["AccountingVoucher.CreatedDate"]" Format="dd/MM/yyyy HH:mm" />
                <PropertyColumn Property="x => x.ModifiedBy" Title="@Localizer["AccountingVoucher.ModifiedBy"]" />
                <PropertyColumn Property="x => x.ModifiedDate" Title="@Localizer["AccountingVoucher.ModifiedDate"]" Format="dd/MM/yyyy HH:mm" />
                <PropertyColumn Property="x => x.PostedBy" Title="@Localizer["AccountingVoucher.PostedBy"]" />
                <PropertyColumn Property="x => x.PostedDate" Title="@Localizer["AccountingVoucher.PostedDate"]" Format="dd/MM/yyyy HH:mm" />
                <PropertyColumn Property="x => x.CancelledBy" Title="@Localizer["AccountingVoucher.CancelledBy"]" />
                <PropertyColumn Property="x => x.CancelledDate" Title="@Localizer["AccountingVoucher.CancelledDate"]" Format="dd/MM/yyyy HH:mm" />
            </Columns>
            <ChildRowContent>
                @{
                    var lines = GetVoucherLines(context.Item.Id);
                }
                @if (lines.Count == 0)
                {
                    <MudText Class="pa-2">Không có dòng bút toán.</MudText>
                }
                else
                {
                    <MudTable T="M_AccountingVoucherLines" Items="lines" Dense="true" Hover="true" Bordered="true" Class="ma-2">
                        <HeaderContent>
                            <MudTh>Line No</MudTh>
                            <MudTh>TK</MudTh>
                            <MudTh>Tên TK</MudTh>
                            <MudTh>Account Code</MudTh>
                            <MudTh>Description</MudTh>
                            <MudTh>Customer</MudTh>
                            <MudTh>Shipment (HBL)</MudTh>
                            <MudTh>Contract</MudTh>
                            <MudTh>Branch</MudTh>
                            <MudTh>Department</MudTh>
                            <MudTh>Due Date</MudTh>
                            <MudTh align="right">Debit</MudTh>
                            <MudTh align="right">Credit</MudTh>
                            <MudTh align="right">Debit FC</MudTh>
                            <MudTh align="right">Credit FC</MudTh>
                            <MudTh>Ledger Type</MudTh>
                            <MudTh>Tax Code</MudTh>
                            <MudTh>VAT Rate</MudTh>
                            <MudTh>Invoice No</MudTh>
                            <MudTh>Invoice Date</MudTh>
                            <MudTh>Is Tax Book</MudTh>
                            <MudTh>Is Management Book</MudTh>
                            <MudTh>Sort Key</MudTh>
                        </HeaderContent>
                        <RowTemplate Context="line">
                            <MudTd DataLabel="Line No">@line.LineNo_</MudTd>
                            <MudTd DataLabel="TK">@GetTaiKhoan(line.DanhMucTaiKhoanID)</MudTd>
                            <MudTd DataLabel="Tên TK">@GetTenTaiKhoan(line.DanhMucTaiKhoanID)</MudTd>
                            <MudTd DataLabel="Account Code">@line.AccountCode</MudTd>
                            <MudTd DataLabel="Description">@line.LineDescription</MudTd>
                            <MudTd DataLabel="Customer">@GetCustomerLabel(line.CustomerId)</MudTd>
                            <MudTd DataLabel="Shipment (HBL)">@GetHblLabel(line.ShipmentId)</MudTd>
                            <MudTd DataLabel="Contract">@line.ContractId</MudTd>
                            <MudTd DataLabel="Branch">@line.BranchId</MudTd>
                            <MudTd DataLabel="Department">@line.DepartmentId</MudTd>
                            <MudTd DataLabel="Due Date">@FormatDate(line.DueDate)</MudTd>
                            <MudTd DataLabel="Debit" align="right">@line.DebitAmount.ToString("N2")</MudTd>
                            <MudTd DataLabel="Credit" align="right">@line.CreditAmount.ToString("N2")</MudTd>
                            <MudTd DataLabel="Debit FC" align="right">@line.DebitAmountFC.ToString("N2")</MudTd>
                            <MudTd DataLabel="Credit FC" align="right">@line.CreditAmountFC.ToString("N2")</MudTd>
                            <MudTd DataLabel="Ledger Type">@line.LedgerType</MudTd>
                            <MudTd DataLabel="Tax Code">@line.TaxCode</MudTd>
                            <MudTd DataLabel="VAT Rate">@(line.VatRate?.ToString("N2") ?? string.Empty)</MudTd>
                            <MudTd DataLabel="Invoice No">@line.InvoiceNo</MudTd>
                            <MudTd DataLabel="Invoice Date">@FormatDate(line.InvoiceDate)</MudTd>
                            <MudTd DataLabel="Is Tax Book">@BoolLabel(line.IsTaxBook)</MudTd>
                            <MudTd DataLabel="Is Management Book">@BoolLabel(line.IsManagementBook)</MudTd>
                            <MudTd DataLabel="Sort Key">@line.SortKey</MudTd>
                        </RowTemplate>
                    </MudTable>
                    <MudPaper Class="pa-2 mx-2 mb-2" Elevation="0">
                        <MudStack Row="true" Spacing="2" Justify="Justify.FlexEnd" AlignItems="AlignItems.Center">
                            <MudText Typo="Typo.body2">Tổng dòng: @lines.Count</MudText>
                            <MudText Typo="Typo.body2">Tổng Nợ: @lines.Sum(x => x.DebitAmount).ToString("N2")</MudText>
                            <MudText Typo="Typo.body2">Tổng Có: @lines.Sum(x => x.CreditAmount).ToString("N2")</MudText>
                            <MudText Typo="Typo.body2" Color="@(lines.Sum(x => x.DebitAmount) - lines.Sum(x => x.CreditAmount) == 0 ? MudBlazor.Color.Success : MudBlazor.Color.Error)">
                                Chênh lệch: @(lines.Sum(x => x.DebitAmount) - lines.Sum(x => x.CreditAmount)).ToString("N2")
                            </MudText>
                        </MudStack>
                    </MudPaper>
                }
            </ChildRowContent>
            <PagerContent>
                <MudDataGridPager T="M_AccountingVouchers" PageSizeOptions="new int[] { 10, 25, 50 }" />
            </PagerContent>
        </MudDataGrid>
    </MudPaper>
</div>

@code {
    private const string PermissionMenuName = "PhieuKeToan";

    private bool _busy;
    private string _usr = string.Empty;
    private string _search = string.Empty;
    private List<M_AccountingVouchers> _items = new();
    private M_AccountingVouchers? _selected;
    private Dictionary<string, string> _transactionTypeNames = new();
    private Dictionary<Guid, M_Customer> _customerById = new();
    private Dictionary<Guid, DanhMucTaiKhoan> _danhMucById = new();
    private Dictionary<Guid, M_HBL> _hblById = new();
    private Dictionary<Guid, List<M_AccountingVoucherLines>> _linesByVoucherId = new();
    private Dictionary<Guid, string> _accountCodesByVoucherId = new();

    private IEnumerable<M_AccountingVouchers> VisibleItems =>
        string.IsNullOrWhiteSpace(_search)
            ? _items
            : _items.Where(MatchesSearch);

    private bool MatchesSearch(M_AccountingVouchers x)
    {
        var key = _search.Trim();
        return (x.VoucherNo?.Contains(key, StringComparison.OrdinalIgnoreCase) ?? false)
            || CustomerLabel(x.CompanyId).Contains(key, StringComparison.OrdinalIgnoreCase)
            || x.VoucherDate.ToString("dd/MM/yyyy").Contains(key, StringComparison.OrdinalIgnoreCase)
            || x.PostingDate.ToString("dd/MM/yyyy").Contains(key, StringComparison.OrdinalIgnoreCase)
            || x.FiscalYear.ToString().Contains(key, StringComparison.OrdinalIgnoreCase)
            || x.FiscalPeriod.ToString().Contains(key, StringComparison.OrdinalIgnoreCase)
            || GetTransactionTypeName(x.TransactionTypeCode).Contains(key, StringComparison.OrdinalIgnoreCase)
            || (x.TransactionTypeCode?.Contains(key, StringComparison.OrdinalIgnoreCase) ?? false)
            || StatusLabel(x.Status).Contains(key, StringComparison.OrdinalIgnoreCase)
            || ApproveLabel(x.Approve).Contains(key, StringComparison.OrdinalIgnoreCase)
            || (x.CurrencyCode?.Contains(key, StringComparison.OrdinalIgnoreCase) ?? false)
            || x.ExchangeRate.ToString().Contains(key, StringComparison.OrdinalIgnoreCase)
            || (x.Description?.Contains(key, StringComparison.OrdinalIgnoreCase) ?? false)
            || (x.ReferenceNo?.Contains(key, StringComparison.OrdinalIgnoreCase) ?? false)
            || (x.ReferenceDate?.ToString("dd/MM/yyyy").Contains(key, StringComparison.OrdinalIgnoreCase) ?? false)
            || (x.SourceModule?.Contains(key, StringComparison.OrdinalIgnoreCase) ?? false)
            || (x.SourceId?.ToString().Contains(key, StringComparison.OrdinalIgnoreCase) ?? false)
            || BoolLabel(x.Ghiso).Contains(key, StringComparison.OrdinalIgnoreCase)
            || BoolLabel(x.Both).Contains(key, StringComparison.OrdinalIgnoreCase)
            || (x.CreatedBy?.Contains(key, StringComparison.OrdinalIgnoreCase) ?? false)
            || (x.ModifiedBy?.Contains(key, StringComparison.OrdinalIgnoreCase) ?? false)
            || (x.PostedBy?.Contains(key, StringComparison.OrdinalIgnoreCase) ?? false)
            || (x.CancelledBy?.Contains(key, StringComparison.OrdinalIgnoreCase) ?? false)
            || GetAccountCodesLabel(x.Id).Contains(key, StringComparison.OrdinalIgnoreCase);
    }

    protected override async Task OnInitializedAsync()
    {
        var auth = await asv.GetAuth();
        _usr = auth.User.Identity?.Name ?? string.Empty;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (!await ssv.CheckPermission(_usr, "View", PermissionMenuName))
        {
            CallSnack(Localizer["NoPermission_View"], MudBlazor.Severity.Warning);
            _items.Clear();
            _selected = null;
            return;
        }

        try
        {
            _busy = true;
            await using var db = await DbFactory.CreateDbContextAsync();
            _items = await db.AccountingVouchers.AsNoTracking()
                .OrderByDescending(x => x.VoucherDate)
                .ThenByDescending(x => x.VoucherNo)
                .ToListAsync();

            // Avoid list.Contains translation for older SQL compatibility levels.
            // Load a lightweight lookup then map in memory.
            var types = await db.TransactionTypes.AsNoTracking()
                .Select(x => new { x.Code, x.Name })
                .ToListAsync();
            _transactionTypeNames = types
                .Where(x => !string.IsNullOrWhiteSpace(x.Code))
                .GroupBy(x => x.Code)
                .ToDictionary(g => g.Key, g => g.First().Name ?? string.Empty);
            var customers = await db.Customer.AsNoTracking()
                .Where(x => x.Customer_ID != Guid.Empty)
                .ToListAsync();
            _customerById = customers.ToDictionary(x => x.Customer_ID, x => x);
            var dms = await db.DanhMucTaiKhoan.AsNoTracking()
                .Where(x => x.Taikhoan != null)
                .ToListAsync();
            _danhMucById = dms.ToDictionary(x => x.Id, x => x);
            var hbls = await db.HBL.AsNoTracking()
                .Where(x => x.hblID != Guid.Empty)
                .ToListAsync();
            _hblById = hbls.ToDictionary(x => x.hblID, x => x);

            var lines = await db.AccountingVoucherLines.AsNoTracking()
                .ToListAsync();
            _linesByVoucherId = lines
                .GroupBy(x => x.VoucherId)
                .ToDictionary(g => g.Key, g => g.OrderBy(y => y.SortKey ?? int.MaxValue).ThenBy(y => y.LineNo_).ToList());
            _accountCodesByVoucherId = _linesByVoucherId.ToDictionary(
                x => x.Key,
                x => string.Join(", ", x.Value
                    .Select(y => y.AccountCode?.Trim())
                    .Where(y => !string.IsNullOrWhiteSpace(y))
                    .Distinct()));

            _selected = null;
        }
        catch (Exception ex)
        {
            CallSnack(ex.Message, MudBlazor.Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private string GetTransactionTypeName(string code)
    {
        if (string.IsNullOrWhiteSpace(code))
            return string.Empty;
        return _transactionTypeNames.TryGetValue(code, out var n) ? n : code;
    }

    private static string StatusLabel(int status) => status switch
    {
        1 => "0-Draft",
        2 => "1-Posted",
        3 => "2-Cancelled",
        _ => status.ToString()
    };
    private static string ApproveLabel(bool? approve) => approve == true ? "Yes" : "No";
    private static string BoolLabel(bool? value) => value == true ? "Yes" : "No";
    private string CustomerLabel(Guid companyId)
    {
        if (!_customerById.TryGetValue(companyId, out var c))
            return companyId.ToString();
        var code = c.Customer_Code?.Trim() ?? string.Empty;
        var company = !string.IsNullOrWhiteSpace(c.COMPANY) ? c.COMPANY!.Trim() : (c.shortname?.Trim() ?? string.Empty);
        if (!string.IsNullOrWhiteSpace(code) && !string.IsNullOrWhiteSpace(company))
            return $"{code} - {company}";
        return !string.IsNullOrWhiteSpace(company) ? company : code;
    }

    private List<M_AccountingVoucherLines> GetVoucherLines(Guid voucherId)
        => _linesByVoucherId.TryGetValue(voucherId, out var lines) ? lines : new List<M_AccountingVoucherLines>();

    private string GetAccountCodesLabel(Guid voucherId)
        => _accountCodesByVoucherId.TryGetValue(voucherId, out var codes) ? codes : string.Empty;

    private string GetTenTaiKhoan(Guid id) => _danhMucById.TryGetValue(id, out var dm) ? (dm.Tentaikhoan ?? string.Empty) : string.Empty;

    private string GetTaiKhoan(Guid id) => _danhMucById.TryGetValue(id, out var dm) ? (dm.Taikhoan ?? string.Empty) : string.Empty;

    private string GetCustomerLabel(Guid? id)
    {
        if (id is null || id == Guid.Empty)
            return string.Empty;
        if (!_customerById.TryGetValue(id.Value, out var c))
            return string.Empty;
        var code = c.Customer_Code?.Trim() ?? string.Empty;
        var company = !string.IsNullOrWhiteSpace(c.COMPANY) ? c.COMPANY!.Trim() : (c.BIZName?.Trim() ?? string.Empty);
        if (!string.IsNullOrWhiteSpace(code) && !string.IsNullOrWhiteSpace(company))
            return $"{code} - {company}";
        return !string.IsNullOrWhiteSpace(code) ? code : company;
    }

    private string GetHblLabel(Guid? id)
    {
        if (id is null || id == Guid.Empty)
            return string.Empty;
        return _hblById.TryGetValue(id.Value, out var h) ? (h.hbl ?? string.Empty) : string.Empty;
    }

    private static string FormatDate(DateTime? value) => value?.ToString("dd/MM/yyyy") ?? string.Empty;

    private void OnRowClick(DataGridRowClickEventArgs<M_AccountingVouchers> args) => _selected = args.Item;

    private string RowClass(M_AccountingVouchers row, int _) => _selected?.Id == row.Id ? "selected-row-blue" : string.Empty;

    private async Task OpenAddAsync()
    {
        if (!await ssv.CheckPermission(_usr, "Add", PermissionMenuName))
        {
            CallSnack(Localizer["NoPermission_Add"], MudBlazor.Severity.Warning);
            return;
        }

        var dialog = DialogService.Show<AccountingVoucher_AddEditDialog>(
            "Chứng từ kế toán — Thêm",
            new DialogParameters { ["VoucherId"] = (Guid?)null },
            new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true, CloseOnEscapeKey = true });

        var rs = await dialog.Result;
        if (!rs.Canceled)
            await LoadAsync();
    }

    private async Task OpenEditAsync()
    {
        if (_selected is null)
            return;
        if (_selected.Approve == true)
        {
            CallSnack("Chứng từ đã Approve, không được chỉnh sửa.", MudBlazor.Severity.Warning);
            return;
        }
        if (!await ssv.CheckPermission(_usr, "Edit", PermissionMenuName))
        {
            CallSnack(Localizer["NoPermission_Edit"], MudBlazor.Severity.Warning);
            return;
        }

        var dialog = DialogService.Show<AccountingVoucher_AddEditDialog>(
            "Chứng từ kế toán — Sửa",
            new DialogParameters { ["VoucherId"] = _selected.Id },
            new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true, CloseOnEscapeKey = true });

        var rs = await dialog.Result;
        if (!rs.Canceled)
            await LoadAsync();
    }

    private async Task OpenLinesDialogAsync()
    {
        if (_selected is null)
            return;
        if (!await ssv.CheckPermission(_usr, "View", PermissionMenuName))
        {
            CallSnack(Localizer["NoPermission_View"], MudBlazor.Severity.Warning);
            return;
        }

        var dialog = DialogService.Show<AccountingVoucherLines_ManagerDialog>(
            "Thông Tin Bút Toán",
            new DialogParameters
            {
                ["VoucherId"] = _selected.Id,
                ["VoucherNo"] = _selected.VoucherNo,
                ["PermissionCode"] = PermissionMenuName
            },
            new DialogOptions { MaxWidth = MaxWidth.ExtraLarge, FullWidth = true, CloseOnEscapeKey = true });

        await dialog.Result;
        await LoadAsync();
    }

    private async Task DeleteAsync()
    {
        if (_selected is null)
            return;
        if (!await ssv.CheckPermission(_usr, "Delete", PermissionMenuName))
        {
            CallSnack(Localizer["NoPermission_Delete"], MudBlazor.Severity.Warning);
            return;
        }

        var confirm = await DialogService.ShowMessageBox(Localizer["Warning"], Localizer["Delete_Confirm"], yesText: Localizer["delete"], cancelText: Localizer["cancel"]);
        if (confirm != true)
            return;

        try
        {
            _busy = true;
            await using var db = await DbFactory.CreateDbContextAsync();
            var entity = await db.AccountingVouchers.FirstOrDefaultAsync(x => x.Id == _selected.Id);
            if (entity is null)
            {
                CallSnack(Localizer["RecordNotFound"], MudBlazor.Severity.Warning);
                return;
            }

            var lines = await db.AccountingVoucherLines.Where(x => x.VoucherId == entity.Id).ToListAsync();
            if (lines.Count > 0)
                db.AccountingVoucherLines.RemoveRange(lines);

            db.AccountingVouchers.Remove(entity);
            await db.SaveChangesAsync();
            CallSnack(Localizer["DeletedSuccess"], MudBlazor.Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            CallSnack(ex.Message, MudBlazor.Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ApproveAsync()
    {
        if (_selected is null)
            return;
        if (_selected.Approve == true)
        {
            CallSnack("Chứng từ đã được Approve.", MudBlazor.Severity.Warning);
            return;
        }
        if (!await ssv.CheckPermission(_usr, "Approve", PermissionMenuName))
        {
            CallSnack("Không có quyền Approve.", MudBlazor.Severity.Warning);
            return;
        }

        try
        {
            _busy = true;
            await using var db = await DbFactory.CreateDbContextAsync();
            var entity = await db.AccountingVouchers.FirstOrDefaultAsync(x => x.Id == _selected.Id);
            if (entity is null)
            {
                CallSnack(Localizer["RecordNotFound"], MudBlazor.Severity.Warning);
                return;
            }

            entity.Approve = true;
            await db.SaveChangesAsync();
            CallSnack("Đã Approve.", MudBlazor.Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            CallSnack(ex.Message, MudBlazor.Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task UnapproveAsync()
    {
        if (_selected is null)
            return;
        if (!await ssv.CheckPermission(_usr, "Approve", PermissionMenuName))
        {
            CallSnack("Không có quyền Approve.", MudBlazor.Severity.Warning);
            return;
        }

        try
        {
            _busy = true;
            await using var db = await DbFactory.CreateDbContextAsync();
            var entity = await db.AccountingVouchers.FirstOrDefaultAsync(x => x.Id == _selected.Id);
            if (entity is null)
            {
                CallSnack(Localizer["RecordNotFound"], MudBlazor.Severity.Warning);
                return;
            }

            entity.Approve = false;
            await db.SaveChangesAsync();
            CallSnack("Đã hủy Approve.", MudBlazor.Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            CallSnack(ex.Message, MudBlazor.Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private void CallSnack(string message, MudBlazor.Severity severity)
    {
        Snackbar.Configuration.SnackbarVariant = Variant.Filled;
        Snackbar.Configuration.MaxDisplayedSnackbars = 3;
        Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopRight;
        Snackbar.Add(message, severity);
    }
}

