            _busy = false;
        }
    }

    private async Task UnpostAsync()
    {
        if (_selected is null)
            return;

        if (IsInventoryVoucher(_selected))
        {
            CallSnack(InventoryVoucherMessage("bỏ ghi sổ"), MudBlazor.Severity.Warning);
            return;
        }

        if (!CanEditDeleteByRole)
        {
            CallSnack(Localizer["Av584.UnpostAdminOnly"], MudBlazor.Severity.Warning);
            return;
        }

        if (!IsPostedVoucher(_selected))
        {
            CallSnack(Localizer["Av584.NotPostedYet"], MudBlazor.Severity.Info);
            return;
        }

        var confirm = await DialogService.ShowMessageBox(
            Localizer["Av584.UnpostTitle"],
            Localizer["Av584.UnpostConfirm"],
            yesText: Localizer["Av584.Unpost"],
            cancelText: Localizer["cancel"]);

        if (confirm != true)
            return;

        try
        {
            var focusVoucherId = _selected.Id;
            _busy = true;
            await using var db = await DbFactory.CreateDbContextAsync();
            var entity = await db.AccountingVouchers.FirstOrDefaultAsync(x => x.Id == focusVoucherId);
            if (entity is null)
            {
                CallSnack(Localizer["RecordNotFound"], MudBlazor.Severity.Warning);
                return;
            }

            // Kỳ đã khóa sổ (10.8) thì không được bỏ ghi sổ — kiểm tra TRƯỚC khi xóa bút toán sổ cái.
            await NVOAMASIS.Services.Accounting.AccountingPeriodLock.EnsureOpenAsync(db, entity.PostingDate, $"bỏ ghi sổ phiếu {entity.VoucherNo}");

            await db.Database.ExecuteSqlInterpolatedAsync($@"
IF OBJECT_ID(N'dbo.GeneralLedgerEntries', N'U') IS NOT NULL
BEGIN
    DELETE FROM dbo.GeneralLedgerEntries
    WHERE VoucherId = {focusVoucherId};
END");

            entity.Status = 1;
            entity.Ghiso = false;
            entity.PostedBy = null;
            entity.PostedDate = null;
            entity.ModifiedBy = _usr;
            entity.ModifiedDate = DateTime.Now;

            await db.SaveChangesAsync();
            CallSnack(Localizer["Av584.UnpostSuccess"], MudBlazor.Severity.Success);
            await LoadAsync(focusVoucherId);
        }
        catch (Exception ex)
        {
            CallSnack(string.Format(Localizer["Av584.UnpostFailed"], ex.Message), MudBlazor.Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

