    private async Task DeleteAsync()
    {
        if (_selected is null)
            return;

        if (IsInventoryVoucher(_selected))
        {
            CallSnack(InventoryVoucherMessage("xóa"), MudBlazor.Severity.Warning);
            return;
        }

        if (!CanEditDeleteByRole)
        {
            CallSnack("Chỉ ADMIN hoặc MANAGER mới được xóa chứng từ.", MudBlazor.Severity.Warning);
            return;
        }

        if (IsPostedVoucher(_selected))
        {
            CallSnack("Chứng từ đã Posted/Ghi sổ, không được xóa.", MudBlazor.Severity.Warning);
            return;
        }

        if (!await ssv.CheckPermission(_usr, "Delete", PermissionMenuName))
        {
            CallSnack(Localizer["NoPermission_Delete"], MudBlazor.Severity.Warning);
            return;
        }

        var confirm = await DialogService.ShowMessageBox(Localizer["Warning"], Localizer["Delete_Confirm"], yesText: Localizer["delete"], cancelText: Localizer["cancel"]);
        if (confirm != true)
            return;

        try
        {
            _busy = true;
            await using var db = await DbFactory.CreateDbContextAsync();
            var entity = await db.AccountingVouchers.FirstOrDefaultAsync(x => x.Id == _selected.Id);
            if (entity is null)
            {
                CallSnack(Localizer["RecordNotFound"], MudBlazor.Severity.Warning);
                return;
            }

            if (IsPostedVoucher(entity))
            {
                CallSnack("Chứng từ đã Posted/Ghi sổ, không được xóa.", MudBlazor.Severity.Warning);
                await LoadAsync(entity.Id);
                return;
            }

            var lines = await db.AccountingVoucherLines.Where(x => x.VoucherId == entity.Id).ToListAsync();
            if (lines.Count > 0)
                db.AccountingVoucherLines.RemoveRange(lines);

            db.AccountingVouchers.Remove(entity);
            await db.SaveChangesAsync();
            CallSnack(Localizer["DeletedSuccess"], MudBlazor.Severity.Success);
            _selected = null;
            await LoadAsync((Guid?)null);
        }
        catch (Exception ex)
        {
            CallSnack(ex.Message, MudBlazor.Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

