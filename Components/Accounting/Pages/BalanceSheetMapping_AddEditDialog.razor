@using Microsoft.Extensions.Localization
@using MudBlazor
@using NVOAMASIS.Models
@using NVOAMASIS.Resources
@inject IStringLocalizer<SharedResource> Localizer

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form">
            <MudGrid Spacing="2">
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="_model.ItemCode"
                                  Label="@Localizer["BalanceSheetMapping.ItemCode"]"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Required="true" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="_model.ItemName"
                                  Label="@Localizer["BalanceSheetMapping.ItemName"]"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Required="true" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="_model.Section"
                                  Label="@Localizer["BalanceSheetMapping.Section"]"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Required="true" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="_model.AccountCode"
                                  Label="@Localizer["BalanceSheetMapping.AccountCode"]"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Required="true" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudNumericField T="int" @bind-Value="_model.Sign"
                                     Label="@Localizer["BalanceSheetMapping.Sign"]"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     HelperText="1 / -1" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudNumericField T="int" @bind-Value="_model.SortOrder"
                                     Label="@Localizer["BalanceSheetMapping.SortOrder"]"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudCheckBox T="bool" @bind-Value="_model.IsActive" Label="@Localizer["BalanceSheetMapping.IsActive"]" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="_noteBinding"
                                  Label="@Localizer["BalanceSheetMapping.Note"]"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Lines="2" />
                </MudItem>
            </MudGrid>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="Cancel">@Localizer["cancel"]</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SubmitAsync">@Localizer["save"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private MudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public M_BalanceSheetMapping Model { get; set; } = new();
    [Parameter] public bool IsEdit { get; set; }

    private MudForm? _form;
    private M_BalanceSheetMapping _model = new();
    private string _noteBinding = string.Empty;

    protected override void OnParametersSet()
    {
        _model = new M_BalanceSheetMapping
        {
            Id = Model.Id,
            ItemCode = Model.ItemCode ?? string.Empty,
            ItemName = Model.ItemName ?? string.Empty,
            Section = Model.Section ?? string.Empty,
            AccountCode = Model.AccountCode ?? string.Empty,
            Sign = Model.Sign == 0 ? 1 : Model.Sign,
            SortOrder = Model.SortOrder,
            Note = Model.Note,
            IsActive = Model.IsActive,
            CreatedDate = Model.CreatedDate
        };
        _noteBinding = Model.Note ?? string.Empty;
    }

    private async Task SubmitAsync()
    {
        if (_form is not null)
            await _form.Validate();

        if (string.IsNullOrWhiteSpace(_model.ItemCode) ||
            string.IsNullOrWhiteSpace(_model.ItemName) ||
            string.IsNullOrWhiteSpace(_model.Section) ||
            string.IsNullOrWhiteSpace(_model.AccountCode))
            return;

        _model.ItemCode = _model.ItemCode.Trim();
        _model.ItemName = _model.ItemName.Trim();
        _model.Section = _model.Section.Trim();
        _model.AccountCode = _model.AccountCode.Trim();
        _model.Note = string.IsNullOrWhiteSpace(_noteBinding) ? null : _noteBinding.Trim();

        MudDialog.Close(DialogResult.Ok(_model));
    }

    private void Cancel() => MudDialog.Cancel();
}
