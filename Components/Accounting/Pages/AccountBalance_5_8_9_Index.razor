    private async Task LoadStageAsync()
    {
        try
        {
            _busy = true;
            _stageItems.Clear();
            _stageBatchIds.Clear();

            await using var db = await DbFactory.CreateDbContextAsync();
            var conn = db.Database.GetDbConnection();
            var shouldClose = conn.State != System.Data.ConnectionState.Open;

            if (shouldClose)
                await conn.OpenAsync();

            try
            {
                await using var cmd = conn.CreateCommand();
                cmd.CommandText = @"
SELECT TOP (1000)
    id,
    import_batch_id,
    account_code,
    period_year,
    period_month,
    opening_balance,
    debit_total,
    credit_total,
    closing_balance,
    account_type,
    company_id,
    book_code,
    import_note,
    created_at
FROM dbo.AccountBalanceImportStaging
WHERE (@period_year IS NULL OR period_year = @period_year)
  AND (@period_month IS NULL OR period_month = @period_month)
ORDER BY created_at DESC, book_code, account_code;";
                cmd.CommandType = System.Data.CommandType.Text;

                AddSqlParameter(cmd, "@period_year", _fiscalYear);
                AddSqlParameter(cmd, "@period_month", _periodMonth);

                await using var reader = await cmd.ExecuteReaderAsync();

                while (await reader.ReadAsync())
                {
                    _stageItems.Add(new AccountBalanceImportStageView
                    {
                        Id = reader.GetGuid(0),
                        ImportBatchId = reader.GetGuid(1),
                        AccountCode = reader.IsDBNull(2) ? string.Empty : Convert.ToString(reader.GetValue(2)) ?? string.Empty,
                        PeriodYear = reader.IsDBNull(3) ? 0 : Convert.ToInt32(reader.GetValue(3)),
                        PeriodMonth = reader.IsDBNull(4) ? 0 : Convert.ToInt32(reader.GetValue(4)),
                        OpeningBalance = reader.IsDBNull(5) ? 0 : Convert.ToDecimal(reader.GetValue(5)),
                        DebitTotal = reader.IsDBNull(6) ? 0 : Convert.ToDecimal(reader.GetValue(6)),
                        CreditTotal = reader.IsDBNull(7) ? 0 : Convert.ToDecimal(reader.GetValue(7)),
                        ClosingBalance = reader.IsDBNull(8) ? 0 : Convert.ToDecimal(reader.GetValue(8)),
                        AccountType = reader.IsDBNull(9) ? null : Convert.ToString(reader.GetValue(9)),
                        CompanyId = reader.IsDBNull(10) ? Guid.Empty : reader.GetGuid(10),
                        BookCode = reader.IsDBNull(11) ? null : Convert.ToString(reader.GetValue(11)),
                        ImportNote = reader.IsDBNull(12) ? null : Convert.ToString(reader.GetValue(12)),
                        CreatedAt = reader.IsDBNull(13) ? DateTime.MinValue : Convert.ToDateTime(reader.GetValue(13))
                    });
                }
            }
            finally
            {
                if (shouldClose)
                    await conn.CloseAsync();
            }

            _stageBatchIds = _stageItems
                .Select(x => x.ImportBatchId)
                .Distinct()
                .ToList();

            if (!_selectedStageBatchId.HasValue && _lastImportBatchId.HasValue && _stageBatchIds.Contains(_lastImportBatchId.Value))
                _selectedStageBatchId = _lastImportBatchId.Value;

            if (!_selectedStageBatchId.HasValue && _stageBatchIds.Count > 0)
                _selectedStageBatchId = _stageBatchIds[0];

            CallSnack($"Loaded {_stageItems.Count:N0} stage rows.", MudBlazor.Severity.Info);
        }
        catch (Exception ex)
        {
            CallSnack(ex.Message, MudBlazor.Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

