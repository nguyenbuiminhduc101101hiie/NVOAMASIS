    private async Task ExportAccountBalanceToExcelAsync()
    {
        if (_items.Count == 0)
        {
            CallSnack("Không có dữ liệu để export.", MudBlazor.Severity.Warning);
            return;
        }

        try
        {
            _busy = true;

            ExcelPackage.LicenseContext = LicenseContext.NonCommercial;

            using var package = new ExcelPackage();
            var ws = package.Workbook.Worksheets.Add("AccountBalance");

            var headers = new[]
            {
                "account_code",
                "book_code",
                "account_type",
                "period_year",
                "period_month",
                "opening_balance",
                "debit_total",
                "credit_total",
                "closing_balance",
                "company_id",
                "calculated_from",
                "calculated_to",
                "last_calculated_at"
            };

            for (var col = 0; col < headers.Length; col++)
            {
                ws.Cells[1, col + 1].Value = headers[col];
                ws.Cells[1, col + 1].Style.Font.Bold = true;
                ws.Cells[1, col + 1].Style.Fill.PatternType = OfficeOpenXml.Style.ExcelFillStyle.Solid;
                ws.Cells[1, col + 1].Style.Fill.BackgroundColor.SetColor(System.Drawing.Color.LightGray);
            }

            var exportRows = VisibleItems
                .OrderBy(x => NormalizeBookCode(x.BookCode))
                .ThenBy(x => x.AccountCode)
                .ToList();

            for (var i = 0; i < exportRows.Count; i++)
            {
                var r = exportRows[i];
                var row = i + 2;

                ws.Cells[row, 1].Value = r.AccountCode;
                ws.Cells[row, 2].Value = NormalizeBookCode(r.BookCode);
                ws.Cells[row, 3].Value = r.AccountType;
                ws.Cells[row, 4].Value = r.PeriodYear;
                ws.Cells[row, 5].Value = r.PeriodMonth;
                ws.Cells[row, 6].Value = r.OpeningBalance;
                ws.Cells[row, 7].Value = r.DebitTotal;
                ws.Cells[row, 8].Value = r.CreditTotal;
                ws.Cells[row, 9].Value = r.ClosingBalance;
                ws.Cells[row, 10].Value = r.CompanyId?.ToString();
                ws.Cells[row, 11].Value = r.CalculatedFrom;
                ws.Cells[row, 12].Value = r.CalculatedTo;
                ws.Cells[row, 13].Value = r.LastCalculatedAt;
            }

            ws.Cells[ws.Dimension.Address].AutoFitColumns();

            ws.Column(6).Style.Numberformat.Format = "#,##0.00";
            ws.Column(7).Style.Numberformat.Format = "#,##0.00";
            ws.Column(8).Style.Numberformat.Format = "#,##0.00";
            ws.Column(9).Style.Numberformat.Format = "#,##0.00";
            ws.Column(11).Style.Numberformat.Format = "dd/mm/yyyy hh:mm";
            ws.Column(12).Style.Numberformat.Format = "dd/mm/yyyy hh:mm";
            ws.Column(13).Style.Numberformat.Format = "dd/mm/yyyy hh:mm";

            var bytes = await package.GetAsByteArrayAsync();
            var base64 = Convert.ToBase64String(bytes);
            var fileName = $"AccountBalance_{_fiscalYear}_{_periodMonth:00}_{DateTime.Now:yyyyMMddHHmmss}.xlsx";

            await JS.InvokeVoidAsync("eval", $@"
                (function() {{
                    const link = document.createElement('a');
                    link.download = '{fileName}';
                    link.href = 'data:application/vnd.openxmlformats-officedocument.spreadsheetml.sheet;base64,{base64}';
                    document.body.appendChild(link);
                    link.click();
                    document.body.removeChild(link);
                }})();
            ");

            CallSnack($"Export Excel thành công: {exportRows.Count:N0} dòng.", MudBlazor.Severity.Success);
        }
        catch (Exception ex)
        {
            CallSnack(ex.Message, MudBlazor.Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }



