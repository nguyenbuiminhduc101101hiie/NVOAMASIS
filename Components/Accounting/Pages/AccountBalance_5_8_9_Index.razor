@page "/account-balance"
@using Microsoft.EntityFrameworkCore
@using MudBlazor
@using NVOAMASIS.Data
@using NVOAMASIS.Models
@using NVOAMASIS.Resources
@attribute [Authorize]
@inject SharedServices ssv
@inject AccountService asv
@inject IDbContextFactory<AppDbContext> DbFactory
@inject ISnackbar Snackbar
@inject IStringLocalizer<SharedResource> Localizer

<PageTitle>@Localizer["AccountBalance.Title"]</PageTitle>

<div class="product-price-page">
    <PpScreenHeader Title="@($"10.9 {Localizer["AccountBalance.Title"]}")" Subtitle="Period balances · calculate / refresh" />

    <MudPaper Class="product-price-card pa-3 mb-3" Elevation="0">
        <MudGrid>
            <MudItem xs="12" sm="3">
                <MudNumericField T="int" @bind-Value="_fiscalYear" Label="@Localizer["AccountBalance.FiscalYear"]" Min="2000" Max="2100" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" sm="3">
                <MudNumericField T="int" @bind-Value="_periodMonth" Label="@Localizer["AccountBalance.PeriodMonth"]" Min="1" Max="12" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" sm="6" Class="d-flex align-center ga-2">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Calculate"
                           Disabled="_busy"
                           OnClick="CalculateAndUpsertAsync">
                    @Localizer["AccountBalance.CalculateUpsert"]
                </MudButton>
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Info"
                           Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Refresh"
                           Disabled="_busy"
                           OnClick="LoadAsync">
                    @Localizer["reload"]
                </MudButton>
            </MudItem>
        </MudGrid>
    </MudPaper>

    <MudPaper Class="pa-3">
        <MudGrid Class="mb-2" AlignItems="AlignItems.Center">
            <MudItem xs="12" sm="8" md="9">
                <MudTextField @bind-Value="_search"
                              Label="@Localizer["AccountBalance.Search"]"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Immediate="true"
                              Clearable="true" />
            </MudItem>
            <MudItem xs="12" sm="4" md="3">
                <MudSelect T="string"
                           @bind-Value="_bookFilter"
                           Label="Book"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Dense="true">
                    <MudSelectItem T="string" Value="@("ALL")">All books</MudSelectItem>
                    <MudSelectItem T="string" Value="@("TAX")">TAX</MudSelectItem>
                    <MudSelectItem T="string" Value="@("MGMT")">MGMT</MudSelectItem>
                </MudSelect>
            </MudItem>
        </MudGrid>

        <MudDataGrid T="M_account_balance"
                     Items="VisibleItems"
                     Dense="true"
                     Striped="true"
                     Bordered="true"
                     Hover="true"
                     Filterable="true"
                     FilterMode="@DataGridFilterMode.ColumnFilterRow"
                     Height="calc(100vh - 360px)"
                     FixedHeader="true"
                     Loading="_busy">
            <Columns>
                <HierarchyColumn T="M_account_balance" Filterable="false" />
                <PropertyColumn Property="x => x.AccountCode" Title="@Localizer["AccountBalance.AccountCode"]" />
                <PropertyColumn Property="x => x.BookCode" Title="Book" />
                <PropertyColumn Property="x => x.AccountType" Title="@Localizer["AccountBalance.Section"]" />
                <PropertyColumn Property="x => x.PeriodYear" Title="@Localizer["AccountBalance.Year"]" />
                <PropertyColumn Property="x => x.PeriodMonth" Title="@Localizer["AccountBalance.Month"]" />
                <PropertyColumn Property="x => x.OpeningBalance" Title="@Localizer["AccountBalance.Opening"]" Format="#,##0.00" CellClass="text-end" HeaderClass="text-end" />
                <PropertyColumn Property="x => x.DebitTotal" Title="@Localizer["AccountBalance.Debit"]" Format="#,##0.00" CellClass="text-end" HeaderClass="text-end" />
                <PropertyColumn Property="x => x.CreditTotal" Title="@Localizer["AccountBalance.Credit"]" Format="#,##0.00" CellClass="text-end" HeaderClass="text-end" />
                <PropertyColumn Property="x => x.ClosingBalance" Title="@Localizer["AccountBalance.Closing"]" Format="#,##0.00" CellClass="text-end" HeaderClass="text-end" />
                <PropertyColumn Property="x => x.CalculatedFrom" Title="@Localizer["AccountBalance.FromGlDate"]" Format="dd/MM/yyyy HH:mm" />
                <PropertyColumn Property="x => x.CalculatedTo" Title="@Localizer["AccountBalance.ToGlDate"]" Format="dd/MM/yyyy HH:mm" />
                <PropertyColumn Property="x => x.LastCalculatedAt" Title="@Localizer["AccountBalance.LastCalculated"]" Format="dd/MM/yyyy HH:mm" />
            </Columns>
            <ChildRowContent>
                <MudPaper Class="pa-3 ma-2" Elevation="0" Outlined="true">
                    <MudText Typo="Typo.subtitle2" Class="mb-2">@Localizer["AccountBalance.GlSnapshotDetails"] — @context.Item.BookCode / @context.Item.AccountCode</MudText>
                    @{
                        var lines = OrderedGlLines(context.Item);
                    }
                    @if (lines.Count == 0)
                    {
                        <MudText Typo="Typo.body2" Color="Color.Secondary">@Localizer["AccountBalance.NoGlLinesSaved"]</MudText>
                    }
                    else
                    {
                        <MudTable Items="lines" Dense="true" Hover="true" Striped="true" Bordered="true">
                            <HeaderContent>
                                <MudTh>@Localizer["GeneralLedgerEntries.VoucherNo"]</MudTh>
                                <MudTh>@Localizer["GeneralLedgerEntries.PostingDate"]</MudTh>
                                <MudTh>@Localizer["GeneralLedgerEntries.Description"]</MudTh>
                                <MudTh Class="text-end">@Localizer["GeneralLedgerEntries.Debit"]</MudTh>
                                <MudTh Class="text-end">@Localizer["GeneralLedgerEntries.Credit"]</MudTh>
                            </HeaderContent>
                            <RowTemplate Context="line">
                                <MudTd DataLabel="@Localizer["GeneralLedgerEntries.VoucherNo"]">@line.VoucherNo</MudTd>
                                <MudTd DataLabel="@Localizer["GeneralLedgerEntries.PostingDate"]">@line.PostingDate.ToString("dd/MM/yyyy HH:mm")</MudTd>
                                <MudTd DataLabel="@Localizer["GeneralLedgerEntries.Description"]">@line.Description</MudTd>
                                <MudTd DataLabel="@Localizer["GeneralLedgerEntries.Debit"]" Class="text-end">@line.Debit.ToString("N2")</MudTd>
                                <MudTd DataLabel="@Localizer["GeneralLedgerEntries.Credit"]" Class="text-end">@line.Credit.ToString("N2")</MudTd>
                            </RowTemplate>
                        </MudTable>
                    }
                </MudPaper>
            </ChildRowContent>
            <PagerContent>
                <MudDataGridPager T="M_account_balance" PageSizeOptions="new int[] { 10, 25, 50 }" />
            </PagerContent>
        </MudDataGrid>
    </MudPaper>
</div>

@code {
    private const string PermissionMenuName = "account_balance";
    /// <summary>Must match CK_account_mapping_statement_type in SQL.</summary>
    private const string BalanceSheetStatementType = "Balance Sheet";

    private bool _busy;
    private string _usr = string.Empty;
    private string _search = string.Empty;
    private string _bookFilter = "ALL";
    private int _fiscalYear = DateTime.UtcNow.Year;
    private int _periodMonth = DateTime.UtcNow.Month;
    private List<M_account_balance> _items = new();

    private IEnumerable<M_account_balance> VisibleItems
    {
        get
        {
            IEnumerable<M_account_balance> query = _items;

            if (!string.Equals(_bookFilter, "ALL", StringComparison.OrdinalIgnoreCase))
            {
                query = query.Where(x => string.Equals(NormalizeBookCode(x.BookCode), _bookFilter, StringComparison.OrdinalIgnoreCase));
            }

            if (!string.IsNullOrWhiteSpace(_search))
            {
                query = query.Where(x =>
                    (x.AccountCode?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (NormalizeBookCode(x.BookCode).Contains(_search, StringComparison.OrdinalIgnoreCase)) ||
                    (x.AccountType?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false));
            }

            return query;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var auth = await asv.GetAuth();
        _usr = auth.User.Identity?.Name ?? string.Empty;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (!await ssv.CheckPermission(_usr, "View", PermissionMenuName))
        {
            CallSnack(Localizer["AccountBalance.NoAccessView"], MudBlazor.Severity.Warning);
            _items.Clear();
            return;
        }

        try
        {
            _busy = true;
            await using var db = await DbFactory.CreateDbContextAsync();
            _items = await db.AccountBalances.AsNoTracking()
                .Include(x => x.GlSnapshotLines)
                .Where(x => x.PeriodYear == _fiscalYear && x.PeriodMonth == _periodMonth)
                .OrderBy(x => x.BookCode)
                .ThenBy(x => x.AccountCode)
                .ToListAsync();
        }
        catch (Exception ex)
        {
            CallSnack(ex.Message, MudBlazor.Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private static string NormalizeBookCode(string? bookCode)
    {
        return string.IsNullOrWhiteSpace(bookCode)
            ? "TAX"
            : bookCode.Trim().ToUpperInvariant();
    }

    private static string BalanceKey(string? bookCode, string? accountCode)
    {
        var book = NormalizeBookCode(bookCode);
        var acc = string.IsNullOrWhiteSpace(accountCode) ? string.Empty : accountCode.Trim().ToUpperInvariant();
        return $"{book}|{acc}";
    }

    private async Task CalculateAndUpsertAsync()
    {
        if (!await ssv.CheckPermission(_usr, "Add", PermissionMenuName))
        {
            CallSnack(Localizer["AccountBalance.NoAccessCalculate"], MudBlazor.Severity.Warning);
            return;
        }

        if (_periodMonth < 1 || _periodMonth > 12)
        {
            CallSnack(Localizer["AccountBalance.InvalidPeriodMonth"], MudBlazor.Severity.Warning);
            return;
        }

        try
        {
            _busy = true;
            await using var db = await DbFactory.CreateDbContextAsync();

            var glRows = await (
                from gl in db.GeneralLedgerEntries.AsNoTracking()
                join fam in db.FinancialReportAccountMappings.AsNoTracking()
                    on new { gl.AccountCode, gl.CompanyId } equals new { fam.AccountCode, fam.CompanyId }
                join rl in db.FinancialReportLines.AsNoTracking()
                    on fam.ReportLineId equals rl.Id
                where gl.FiscalYear == _fiscalYear
                      && gl.FiscalPeriod == _periodMonth
                      && fam.Active
                      && rl.Active
                      && (rl.ReportType == "BALANCE_SHEET" || rl.ReportType == "BalanceSheet")
                select new { gl, fam, rl })
                .ToListAsync();

            var bookRows = glRows
                .SelectMany(x =>
                {
                    var books = new List<string>();

                    if (x.gl.IsTaxBook == true)
                        books.Add("TAX");

                    if (x.gl.IsManagementBook == true)
                        books.Add("MGMT");

                    if (books.Count == 0)
                        books.Add("TAX");

                    return books.Select(bookCode => new
                    {
                        BookCode = bookCode,
                        x.gl,
                        x.fam,
                        x.rl
                    });
                })
                .ToList();

            var groups = bookRows
                .GroupBy(x => new
                {
                    x.BookCode,
                    x.gl.AccountCode
                })
                .ToList();

            if (groups.Count == 0)
            {
                CallSnack(Localizer["AccountBalance.NoGlForPeriod"], MudBlazor.Severity.Info);
                return;
            }

            var mappingByCode = (await db.AccountMappings.ToListAsync())
                .ToDictionary(x => x.AccountCode, StringComparer.OrdinalIgnoreCase);

            var mappingsCreated = 0;

            foreach (var g in groups)
            {
                var code = g.Key.AccountCode;
                if (mappingByCode.ContainsKey(code))
                    continue;

                var sample = g.First();
                var newMapping = new M_AccountMapping
                    {
                        AccountCode = code,
                        AccountName = code,
                        StatementType = BalanceSheetStatementType,
                        BsSection = sample.rl.Section,
                        NormalBalance = sample.fam.NormalBalance ?? "Debit",
                        IsActive = true
                    };

                db.AccountMappings.Add(newMapping);
                mappingByCode[code] = newMapping;
                mappingsCreated++;
            }

            if (mappingsCreated > 0)
                await db.SaveChangesAsync();

            var affectedKeys = groups
                .Select(g => BalanceKey(g.Key.BookCode, g.Key.AccountCode))
                .ToHashSet(StringComparer.OrdinalIgnoreCase);

            if (affectedKeys.Count > 0)
            {
                var snapshotRowsInPeriod = await (
                        from line in db.AccountBalanceGlLines
                        join bal in db.AccountBalances on line.AccountBalanceId equals bal.Id
                        where bal.PeriodYear == _fiscalYear
                              && bal.PeriodMonth == _periodMonth
                        select new
                        {
                            line,
                            bal.AccountCode,
                            bal.BookCode
                        })
                    .ToListAsync();

                var linesToClear = snapshotRowsInPeriod
                    .Where(x => affectedKeys.Contains(BalanceKey(x.BookCode, x.AccountCode)))
                    .Select(x => x.line)
                    .ToList();

                if (linesToClear.Count > 0)
                    db.AccountBalanceGlLines.RemoveRange(linesToClear);
            }

            var existingBalances = await db.AccountBalances
                .Where(x => x.PeriodYear == _fiscalYear && x.PeriodMonth == _periodMonth)
                .ToListAsync();

            var balanceByBookAndCode = existingBalances.ToDictionary(
                x => BalanceKey(x.BookCode, x.AccountCode),
                StringComparer.OrdinalIgnoreCase);

            var prevDate = new DateTime(_fiscalYear, _periodMonth, 1).AddMonths(-1);
            var previousBalances = await db.AccountBalances.AsNoTracking()
                .Where(x => x.PeriodYear == prevDate.Year && x.PeriodMonth == prevDate.Month)
                .ToListAsync();

            var previousBalanceByBookAndCode = previousBalances.ToDictionary(
                x => BalanceKey(x.BookCode, x.AccountCode),
                x => x.ClosingBalance,
                StringComparer.OrdinalIgnoreCase);

            var nowUtc = DateTime.UtcNow;

            foreach (var g in groups)
            {
                var bookCode = g.Key.BookCode;
                var accountCode = g.Key.AccountCode;
                var key = BalanceKey(bookCode, accountCode);

                var mapRow = mappingByCode[accountCode];
                var lines = g.Select(x => x.gl).DistinctBy(x => x.Id).ToList();
                var debitTotal = lines.Sum(x => x.Debit);
                var creditTotal = lines.Sum(x => x.Credit);
                var calculatedFrom = lines.Count > 0 ? lines.Min(x => x.PostingDate) : (DateTime?)null;
                var calculatedTo = lines.Count > 0 ? lines.Max(x => x.PostingDate) : (DateTime?)null;
                var companyId = lines.Count > 0 ? lines[0].CompanyId : (Guid?)null;

                var bsSection = mapRow.BsSection
                    ?? g.Select(x => x.rl.Section).FirstOrDefault(s => !string.IsNullOrWhiteSpace(s))
                    ?? string.Empty;

                var normalBalance = mapRow.NormalBalance
                    ?? g.Select(x => x.fam.NormalBalance).FirstOrDefault(nb => !string.IsNullOrWhiteSpace(nb))
                    ?? "Debit";

                var isDebitNatural = string.Equals(normalBalance, "Debit", StringComparison.OrdinalIgnoreCase);

                balanceByBookAndCode.TryGetValue(key, out var balanceRow);

                var openingForRow = previousBalanceByBookAndCode.TryGetValue(key, out var prevClosing)
                    ? prevClosing
                    : balanceRow?.OpeningBalance ?? 0m;

                var closingBalance = isDebitNatural
                    ? openingForRow + debitTotal - creditTotal
                    : openingForRow + creditTotal - debitTotal;

                if (balanceRow is null)
                {
                    balanceRow = new M_account_balance
                        {
                            Id = Guid.NewGuid(),
                            AccountCode = accountCode,
                            BookCode = bookCode,
                            CompanyId = companyId,
                            PeriodYear = _fiscalYear,
                            PeriodMonth = _periodMonth,
                            OpeningBalance = openingForRow,
                            DebitTotal = debitTotal,
                            CreditTotal = creditTotal,
                            ClosingBalance = closingBalance,
                            AccountType = AccountTypeFromSection(bsSection),
                            CalculatedFrom = calculatedFrom,
                            CalculatedTo = calculatedTo,
                            LastCalculatedAt = nowUtc,
                            CreatedAt = nowUtc,
                            UpdatedAt = nowUtc
                        };

                    db.AccountBalances.Add(balanceRow);
                    balanceByBookAndCode[key] = balanceRow;
                }
                else
                {
                    balanceRow.BookCode = bookCode;
                    balanceRow.OpeningBalance = openingForRow;
                    balanceRow.DebitTotal = debitTotal;
                    balanceRow.CreditTotal = creditTotal;
                    balanceRow.AccountType = AccountTypeFromSection(bsSection);
                    balanceRow.CompanyId = companyId ?? balanceRow.CompanyId;
                    balanceRow.CalculatedFrom = calculatedFrom;
                    balanceRow.CalculatedTo = calculatedTo;
                    balanceRow.LastCalculatedAt = nowUtc;
                    balanceRow.ClosingBalance = closingBalance;
                    balanceRow.UpdatedAt = nowUtc;
                }

                foreach (var gl in lines.OrderBy(x => x.PostingDate).ThenBy(x => x.VoucherNo))
                {
                    db.AccountBalanceGlLines.Add(new M_account_balance_gl_line
                        {
                            Id = Guid.NewGuid(),
                            AccountBalanceId = balanceRow.Id,
                            GeneralLedgerEntryId = gl.Id,
                            VoucherNo = gl.VoucherNo ?? string.Empty,
                            PostingDate = gl.PostingDate,
                            Debit = gl.Debit,
                            Credit = gl.Credit,
                            Description = gl.Description
                        });
                }
            }

            await db.SaveChangesAsync();

            var successMsg = $"Calculated {groups.Count} account/book balances.";
            if (mappingsCreated > 0)
                successMsg += $" Ensured {mappingsCreated} account mappings.";

            CallSnack(successMsg, MudBlazor.Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            CallSnack(ex.Message, MudBlazor.Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private static string? AccountTypeFromSection(string section)
    {
        if (string.IsNullOrWhiteSpace(section))
            return null;
        var s = section.Trim();
        return s.Length <= 20 ? s : s[..20];
    }

    private static List<M_account_balance_gl_line> OrderedGlLines(M_account_balance row) =>
        (row.GlSnapshotLines ?? Enumerable.Empty<M_account_balance_gl_line>())
            .OrderBy(l => l.PostingDate)
            .ThenBy(l => l.VoucherNo)
            .ToList();

    private void CallSnack(string message, MudBlazor.Severity severity)
    {
        Snackbar.Configuration.SnackbarVariant = Variant.Filled;
        Snackbar.Configuration.MaxDisplayedSnackbars = 3;
        Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopRight;
        Snackbar.Add(message, severity);
    }
}
