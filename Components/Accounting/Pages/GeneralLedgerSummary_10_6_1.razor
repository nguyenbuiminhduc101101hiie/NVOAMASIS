@page "/accounting/general-ledger"
@page "/GeneralLedgerSummary"
@using Microsoft.EntityFrameworkCore
@using MudBlazor
@using NVOAMASIS.Data
@using NVOAMASIS.Models
@using NVOAMASIS.Resources
@attribute [Authorize]
@inject SharedServices ssv
@inject AccountService asv
@inject IDbContextFactory<AppDbContext> DbFactory
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IStringLocalizer<SharedResource> Localizer

<PageTitle>10.6.1 Sổ cái tổng hợp</PageTitle>

<div class="product-price-page gl-summary-page">
    <PpScreenHeader Title="10.6.1 Sổ cái tổng hợp" Subtitle="General Ledger · xem toàn bộ phát sinh đã ghi sổ">
        <Toolbar>
            <MudStack Row="true" Spacing="1" Class="flex-wrap">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Search"
                           OnClick="LoadAsync"
                           Disabled="_busy">
                    Load
                </MudButton>

                <MudButton Variant="Variant.Outlined"
                           Color="Color.Info"
                           Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Refresh"
                           OnClick="ResetFilterAsync"
                           Disabled="_busy">
                    Reset
                </MudButton>
            </MudStack>
        </Toolbar>
    </PpScreenHeader>

    <MudPaper Class="product-price-card pa-3 mb-2" Elevation="0">
        <MudGrid Spacing="2" AlignItems="Center">
            <MudItem xs="12" sm="2">
                <MudDatePicker Label="Từ ngày"
                               @bind-Date="_fromDate"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               DateFormat="dd/MM/yyyy" />
            </MudItem>

            <MudItem xs="12" sm="2">
                <MudDatePicker Label="Đến ngày"
                               @bind-Date="_toDate"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               DateFormat="dd/MM/yyyy" />
            </MudItem>

            <MudItem xs="6" sm="1">
                <MudNumericField T="int?"
                                 Label="Year"
                                 Value="_fiscalYear"
                                 ValueChanged="OnYearChanged"
                                 Variant="Variant.Outlined"
                                 Margin="Margin.Dense"
                                 Min="2000"
                                 Max="2100" />
            </MudItem>

            <MudItem xs="6" sm="1">
                <MudNumericField T="int?"
                                 Label="Month"
                                 Value="_periodMonth"
                                 ValueChanged="OnMonthChanged"
                                 Variant="Variant.Outlined"
                                 Margin="Margin.Dense"
                                 Min="1"
                                 Max="12" />
            </MudItem>

            <MudItem xs="12" sm="1">
                <MudSelect T="string"
                           Label="Book"
                           @bind-Value="_book"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Dense="true">
                    <MudSelectItem T="string" Value="@("ALL")">ALL</MudSelectItem>
                    <MudSelectItem T="string" Value="@("TAX")">TAX</MudSelectItem>
                    <MudSelectItem T="string" Value="@("MGMT")">MGMT</MudSelectItem>
                </MudSelect>
            </MudItem>

            <MudItem xs="12" sm="2">
                <MudSelect T="string"
                           Label="Tài khoản"
                           @bind-Value="_accountCode"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Dense="true"
                           Clearable="true"
                           Class="gl-select">
                    <MudSelectItem T="string" Value="@("ALL")">ALL</MudSelectItem>
                    @foreach (var acc in _accountCodes)
                    {
                        <MudSelectItem T="string" Value="@acc">@acc</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            <MudItem xs="12" sm="3">
                <MudTextField @bind-Value="_search"
                              Label="Search"
                              Placeholder="Voucher, khách hàng, diễn giải, source..."
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Immediate="true"
                              Clearable="true"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search" />
            </MudItem>
        </MudGrid>
    </MudPaper>

    <MudPaper Class="product-price-card pa-2 mb-2" Elevation="0">
        <MudGrid Spacing="2">
            <MudItem xs="12" sm="3">
                <MudPaper Class="pa-2 text-center gl-stat" Elevation="0" Outlined="true">
                    <MudText Typo="Typo.caption">Total Debit</MudText>
                    <MudText Typo="Typo.subtitle1" Class="fw-bold">@VisibleItems.Sum(x => x.Debit).ToString("N0")</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="3">
                <MudPaper Class="pa-2 text-center gl-stat" Elevation="0" Outlined="true">
                    <MudText Typo="Typo.caption">Total Credit</MudText>
                    <MudText Typo="Typo.subtitle1" Class="fw-bold">@VisibleItems.Sum(x => x.Credit).ToString("N0")</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="3">
                <MudPaper Class="pa-2 text-center gl-stat" Elevation="0" Outlined="true">
                    <MudText Typo="Typo.caption">Difference</MudText>
                    <MudText Typo="Typo.subtitle1" Class="fw-bold"
                             Color="@(VisibleItems.Sum(x => x.Debit) - VisibleItems.Sum(x => x.Credit) == 0 ? Color.Success : Color.Error)">
                        @((VisibleItems.Sum(x => x.Debit) - VisibleItems.Sum(x => x.Credit)).ToString("N0"))
                    </MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="3">
                <MudPaper Class="pa-2 text-center gl-stat" Elevation="0" Outlined="true">
                    <MudText Typo="Typo.caption">Lines</MudText>
                    <MudText Typo="Typo.subtitle1" Class="fw-bold">@VisibleItems.Count().ToString("N0")</MudText>
                </MudPaper>
            </MudItem>
        </MudGrid>
    </MudPaper>

    <MudPaper Class="product-price-card pa-2" Elevation="0">
        <MudDataGrid @key="_gridKey"
                     T="GeneralLedgerSummaryRow"
                     Items="VisibleItems"
                     Dense="true"
                     Striped="true"
                     Hover="true"
                     Bordered="true"
                     Filterable="true"
                     FilterMode="@DataGridFilterMode.ColumnFilterRow"
                     ColumnResizeMode="ResizeMode.Column"
                     FixedHeader="true"
                     Height="calc(100vh - 340px)"
                     Class="gl-summary-grid"
                     RowClassFunc="RowClass"
                     SelectedItem="_selected"
                     SelectedItemChanged="OnSelectedChanged"
                     Loading="_busy">
            <Columns>
                <PropertyColumn Property="x => x.PostingDate" Title="Ngày HT" Format="dd/MM/yyyy" />
                <PropertyColumn Property="x => x.VoucherNo" Title="Số chứng từ" />
                <PropertyColumn Property="x => x.VoucherDate" Title="Ngày CT" Format="dd/MM/yyyy" />
                <PropertyColumn Property="x => x.VoucherType" Title="Loại CT" />
                <PropertyColumn Property="x => x.AccountCode" Title="TK" />
                <PropertyColumn Property="x => x.AccountName" Title="Tên tài khoản" />
                <PropertyColumn Property="x => x.CustomerName" Title="Đối tượng / Khách hàng" />
                <PropertyColumn Property="x => x.Description" Title="Diễn giải" />
                <PropertyColumn Property="x => x.Debit" Title="Nợ" Format="N0" CellClass="text-end fw-bold" HeaderClass="text-end" />
                <PropertyColumn Property="x => x.Credit" Title="Có" Format="N0" CellClass="text-end fw-bold" HeaderClass="text-end" />
                <PropertyColumn Property="x => x.CurrencyCode" Title="Tiền tệ" />
                <PropertyColumn Property="x => x.ExchangeRate" Title="Tỷ giá" Format="N2" CellClass="text-end" HeaderClass="text-end" />
                <PropertyColumn Property="x => x.Book" Title="Book" />
                <PropertyColumn Property="x => x.SourceName" Title="Nguồn phát sinh" />
                <PropertyColumn Property="x => x.CreatedBy" Title="Người tạo" />
            </Columns>

            <PagerContent>
                <MudDataGridPager T="GeneralLedgerSummaryRow" PageSizeOptions="new int[] { 25, 50, 100, 200 }" />
            </PagerContent>

            <NoRecordsContent>
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="pa-4 text-center">
                    Không có dữ liệu sổ cái theo điều kiện lọc hiện tại.
                </MudText>
            </NoRecordsContent>
        </MudDataGrid>
    </MudPaper>
</div>

@code {
    [Parameter] public string? InitialAccountCode { get; set; }
    [Parameter] public int? InitialFiscalYear { get; set; }
    [Parameter] public int? InitialPeriodMonth { get; set; }
    [Parameter] public string? InitialBook { get; set; }
    [Parameter] public Guid? InitialCustomerId { get; set; }

    private const string PermissionMenuName = "GeneralLedgerEntries";

    private bool _busy;
    private string _usr = string.Empty;
    private int _gridKey;

    private DateTime? _fromDate = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
    private DateTime? _toDate = DateTime.Today;
    private int? _fiscalYear = DateTime.Today.Year;
    private int? _periodMonth = DateTime.Today.Month;
    private string _book = "ALL";
    private string _accountCode = "ALL";
    private Guid? _customerIdFilter;
    private string _search = string.Empty;

    private List<GeneralLedgerSummaryRow> _rows = new();
    private List<string> _accountCodes = new();
    private GeneralLedgerSummaryRow? _selected;

    private IEnumerable<GeneralLedgerSummaryRow> VisibleItems =>
        _rows.Where(MatchesFilter).Where(MatchesSearch);

    protected override async Task OnInitializedAsync()
    {
        var auth = await asv.GetAuth();
        _usr = auth.User.Identity?.Name ?? string.Empty;

        ApplyInitialFilters();

        UpdateDateRange();

        await LoadAsync();
    }

    private void ApplyInitialFilters()
    {
        if (!string.IsNullOrWhiteSpace(InitialAccountCode))
            _accountCode = InitialAccountCode.Trim();

        if (InitialFiscalYear.HasValue)
            _fiscalYear = InitialFiscalYear.Value;

        if (InitialPeriodMonth.HasValue)
            _periodMonth = InitialPeriodMonth.Value;

        if (!string.IsNullOrWhiteSpace(InitialBook))
            _book = InitialBook.Trim().ToUpperInvariant();

        if (InitialCustomerId.HasValue && InitialCustomerId.Value != Guid.Empty)
            _customerIdFilter = InitialCustomerId.Value;
        if (_fiscalYear.HasValue && _periodMonth.HasValue)
        {
            _fromDate = new DateTime(
                _fiscalYear.Value,
                _periodMonth.Value,
                1);

            _toDate = _fromDate.Value
                .AddMonths(1)
                .AddDays(-1);
        }
    }

    private async Task OnYearChanged(int? year)
    {
        _fiscalYear = year;
        UpdateDateRange();
        await LoadAsync();
    }

    private async Task OnMonthChanged(int? month)
    {
        _periodMonth = month;
        UpdateDateRange();
        await LoadAsync();
    }

    private void UpdateDateRange()
    {
        if (!_fiscalYear.HasValue || !_periodMonth.HasValue)
            return;

        if (_periodMonth.Value < 1 || _periodMonth.Value > 12)
            return;

        _fromDate = new DateTime(_fiscalYear.Value, _periodMonth.Value, 1);
        _toDate = _fromDate.Value.AddMonths(1).AddDays(-1);
    }

    private async Task ResetFilterAsync()
    {
        _fromDate = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
        _toDate = DateTime.Today;
        _fiscalYear = DateTime.Today.Year;
        _periodMonth = DateTime.Today.Month;
        _book = "ALL";
        _accountCode = "ALL";
        _customerIdFilter = null;
        _search = string.Empty;

        UpdateDateRange();

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (!await ssv.CheckPermission(_usr, "View", PermissionMenuName))
        {
            Snackbar.Add("Bạn không có quyền xem sổ cái.", MudBlazor.Severity.Warning);
            _rows.Clear();
            return;
        }

        try
        {
            _busy = true;

            await using var db = await DbFactory.CreateDbContextAsync();

            var query = db.GeneralLedgerEntries.AsNoTracking().AsQueryable();

            if (_fromDate.HasValue)
                query = query.Where(x => x.PostingDate >= _fromDate.Value.Date);

            if (_toDate.HasValue)
                query = query.Where(x => x.PostingDate <= _toDate.Value.Date);

            if (_fiscalYear.HasValue)
                query = query.Where(x => x.FiscalYear == _fiscalYear.Value);

            if (_periodMonth.HasValue)
                query = query.Where(x => x.FiscalPeriod == _periodMonth.Value);

            if (!string.Equals(_book, "ALL", StringComparison.OrdinalIgnoreCase))
            {
                if (_book == "TAX")
                    query = query.Where(x => x.IsTaxBook == true);

                if (_book == "MGMT")
                    query = query.Where(x => x.IsManagementBook == true);
            }

            if (!string.IsNullOrWhiteSpace(_accountCode)
                && !string.Equals(_accountCode, "ALL", StringComparison.OrdinalIgnoreCase))
            {
                var acc = _accountCode.Trim();
                query = query.Where(x => x.AccountCode != null && x.AccountCode.StartsWith(acc));
            }

            if (_customerIdFilter.HasValue && _customerIdFilter.Value != Guid.Empty)
            {
                query = query.Where(x => x.CustomerId == _customerIdFilter.Value);
            }

            var data = await query
                .OrderByDescending(x => x.PostingDate)
                .ThenByDescending(x => x.CreatedAt)
                .Take(5000)
                .ToListAsync();

            var customerIds = data
                .Where(x => x.CustomerId.HasValue && x.CustomerId.Value != Guid.Empty)
                .Select(x => x.CustomerId!.Value)
                .Distinct()
                .ToHashSet();

            var customerMap = new Dictionary<Guid, string>();
            if (customerIds.Count > 0)
            {
                var customers = await db.Customer.AsNoTracking()
                    .Where(c => customerIds.Contains(c.Customer_ID))
                    .Select(c => new
                    {
                        c.Customer_ID,
                        c.Customer_Code,
                        c.COMPANY
                    })
                    .ToListAsync();

                customerMap = customers
                    .GroupBy(x => x.Customer_ID)
                    .ToDictionary(
                        g => g.Key,
                        g =>
                        {
                            var c = g.First();
                            return string.IsNullOrWhiteSpace(c.Customer_Code)
                                ? (c.COMPANY ?? string.Empty)
                                : $"{c.Customer_Code} - {c.COMPANY}";
                        });
            }

            var accountCodes = data
                .Where(x => !string.IsNullOrWhiteSpace(x.AccountCode))
                .Select(x => x.AccountCode!)
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .ToHashSet(StringComparer.OrdinalIgnoreCase);

            var accountMap = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
            if (accountCodes.Count > 0)
            {
                var accounts = await db.DanhMucTaiKhoan.AsNoTracking()
                    .Where(a => accountCodes.Contains(a.Taikhoan))
                    .Select(a => new
                    {
                        Code = a.Taikhoan,
                        Name = a.Tentaikhoan
                    })
                    .ToListAsync();

                accountMap = accounts
                    .Where(x => !string.IsNullOrWhiteSpace(x.Code))
                    .GroupBy(x => x.Code!)
                    .ToDictionary(g => g.Key, g => g.First().Name ?? string.Empty, StringComparer.OrdinalIgnoreCase);
            }

            var sourceIdsText = data
                .Where(x => !string.IsNullOrWhiteSpace(x.SourceId))
                .Select(x => x.SourceId!.Trim())
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .ToHashSet(StringComparer.OrdinalIgnoreCase);

            var sourceMap = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);

            if (sourceIdsText.Count > 0)
            {
                var sourceVouchers = await db.AccountingVouchers.AsNoTracking()
                    .Where(v => !string.IsNullOrWhiteSpace(v.SourceId)
                             && sourceIdsText.Contains(v.SourceId))
                    .Select(v => new
                    {
                        v.SourceId,
                        v.VoucherNo,
                        v.Description
                    })
                    .ToListAsync();

                foreach (var v in sourceVouchers)
                {
                    if (string.IsNullOrWhiteSpace(v.SourceId))
                        continue;

                    sourceMap[v.SourceId.Trim()] = string.IsNullOrWhiteSpace(v.Description)
                        ? v.VoucherNo
                        : $"{v.VoucherNo} - {v.Description}";
                }

                var sourceIdsGuid = sourceIdsText
                    .Select(x => Guid.TryParse(x, out var id) ? id : Guid.Empty)
                    .Where(x => x != Guid.Empty)
                    .Distinct()
                    .ToHashSet();

                if (sourceIdsGuid.Count > 0)
                {
                    var receipts = await db.Phieuthu.AsNoTracking()
                        .Where(p => sourceIdsGuid.Contains(p.PhieuthuID))
                        .Select(p => new
                        {
                            Id = p.PhieuthuID,
                            No = p.SoPhieuthu,
                            Description = p.Noidung
                        })
                        .ToListAsync();

                    foreach (var p in receipts)
                    {
                        sourceMap[p.Id.ToString()] = string.IsNullOrWhiteSpace(p.Description)
                            ? p.No
                            : $"{p.No} - {p.Description}";
                    }
                }
            }

            _rows = data.Select(x => new GeneralLedgerSummaryRow
            {
                Id = x.Id,
                PostingDate = x.PostingDate,
                VoucherNo = x.VoucherNo ?? string.Empty,
                VoucherDate = x.VoucherDate,
                VoucherType = string.IsNullOrWhiteSpace(x.LedgerType) ? x.SourceModule ?? string.Empty : x.LedgerType,
                AccountCode = x.AccountCode ?? string.Empty,
                AccountName = !string.IsNullOrWhiteSpace(x.AccountCode) && accountMap.TryGetValue(x.AccountCode, out var accName)
                    ? accName
                    : string.Empty,
                CustomerName = x.CustomerId.HasValue && customerMap.TryGetValue(x.CustomerId.Value, out var customerName)
                    ? customerName
                    : string.Empty,
                Description = x.Description ?? string.Empty,
                Debit = x.Debit,
                Credit = x.Credit,
                CurrencyCode = x.CurrencyCode ?? string.Empty,
                ExchangeRate = x.ExchangeRate,
                Book =
                    x.IsTaxBook == true && x.IsManagementBook == true ? "TAX/MGMT" :
                    x.IsTaxBook == true ? "TAX" :
                    x.IsManagementBook == true ? "MGMT" :
                    string.Empty,
                SourceName = !string.IsNullOrWhiteSpace(x.SourceId) && sourceMap.TryGetValue(x.SourceId.Trim(), out var sourceName)
                    ? sourceName
                    : x.SourceModule ?? string.Empty,
                CreatedBy = x.CreatedBy ?? string.Empty
            }).ToList();

            _accountCodes = _rows
                .Where(x => !string.IsNullOrWhiteSpace(x.AccountCode))
                .Select(x => x.AccountCode)
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(x => x)
                .ToList();

            if (!string.IsNullOrWhiteSpace(_accountCode)
                && !string.Equals(_accountCode, "ALL", StringComparison.OrdinalIgnoreCase)
                && !_accountCodes.Contains(_accountCode, StringComparer.OrdinalIgnoreCase))
            {
                _accountCodes.Insert(0, _accountCode);
            }

            _gridKey++;
            Snackbar.Add($"Loaded {_rows.Count:N0} ledger lines.", MudBlazor.Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, MudBlazor.Severity.Error);
        }
        finally
        {
            _busy = false;
            StateHasChanged();
        }
    }

    private bool MatchesFilter(GeneralLedgerSummaryRow x)
    {
        if (!string.IsNullOrWhiteSpace(_accountCode)
            && !string.Equals(_accountCode, "ALL", StringComparison.OrdinalIgnoreCase)
            && !x.AccountCode.StartsWith(_accountCode.Trim(), StringComparison.OrdinalIgnoreCase))
            return false;

        return true;
    }

    private bool MatchesSearch(GeneralLedgerSummaryRow x)
    {
        if (string.IsNullOrWhiteSpace(_search))
            return true;

        var key = _search.Trim();

        return x.VoucherNo.Contains(key, StringComparison.OrdinalIgnoreCase)
            || x.PostingDate.ToString("dd/MM/yyyy").Contains(key, StringComparison.OrdinalIgnoreCase)
            || x.VoucherDate.ToString("dd/MM/yyyy").Contains(key, StringComparison.OrdinalIgnoreCase)
            || x.VoucherType.Contains(key, StringComparison.OrdinalIgnoreCase)
            || x.AccountCode.Contains(key, StringComparison.OrdinalIgnoreCase)
            || x.AccountName.Contains(key, StringComparison.OrdinalIgnoreCase)
            || x.CustomerName.Contains(key, StringComparison.OrdinalIgnoreCase)
            || x.Description.Contains(key, StringComparison.OrdinalIgnoreCase)
            || x.Debit.ToString("N0").Contains(key, StringComparison.OrdinalIgnoreCase)
            || x.Credit.ToString("N0").Contains(key, StringComparison.OrdinalIgnoreCase)
            || x.CurrencyCode.Contains(key, StringComparison.OrdinalIgnoreCase)
            || x.Book.Contains(key, StringComparison.OrdinalIgnoreCase)
            || x.SourceName.Contains(key, StringComparison.OrdinalIgnoreCase)
            || x.CreatedBy.Contains(key, StringComparison.OrdinalIgnoreCase);
    }

    private void OnSelectedChanged(GeneralLedgerSummaryRow? item) => _selected = item;

    private string RowClass(GeneralLedgerSummaryRow row, int rowNumber)
        => _selected is not null && _selected.Id == row.Id ? "selected-row-blue" : string.Empty;

    private sealed class GeneralLedgerSummaryRow
    {
        public Guid Id { get; set; }
        public DateTime PostingDate { get; set; }
        public string VoucherNo { get; set; } = string.Empty;
        public DateTime VoucherDate { get; set; }
        public string VoucherType { get; set; } = string.Empty;
        public string AccountCode { get; set; } = string.Empty;
        public string AccountName { get; set; } = string.Empty;
        public string CustomerName { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
        public decimal Debit { get; set; }
        public decimal Credit { get; set; }
        public string CurrencyCode { get; set; } = string.Empty;
        public decimal ExchangeRate { get; set; }
        public string Book { get; set; } = string.Empty;
        public string SourceName { get; set; } = string.Empty;
        public string CreatedBy { get; set; } = string.Empty;
    }
}

<style>
    .gl-summary-page {
        background: #f4fdf7;
    }

        .gl-summary-page .product-price-card {
            border: 1px solid #d1fae5;
            border-radius: 14px;
            box-shadow: 0 8px 20px rgba(22, 101, 52, 0.06);
        }

        .gl-summary-page .gl-stat {
            border-radius: 10px;
            background: #f0fff4;
            border: 1px solid #bbf7d0;
        }

        .gl-summary-page .gl-summary-grid {
            font-size: 0.82rem;
        }

            .gl-summary-page .gl-summary-grid .mud-table-container {
                overflow-x: auto;
            }

            .gl-summary-page .gl-summary-grid .mud-table-root .mud-table {
                width: max-content !important;
                min-width: 100%;
            }

            .gl-summary-page .gl-summary-grid .mud-table-cell,
            .gl-summary-page .gl-summary-grid td,
            .gl-summary-page .gl-summary-grid th {
                padding: 4px 8px !important;
                white-space: nowrap;
            }

        .gl-summary-page .selected-row-blue {
            background-color: #2196f3 !important;
            color: #fff !important;
        }

    .gl-select {
        width: 100%;
    }
</style>
