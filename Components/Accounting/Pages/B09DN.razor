    private async Task ExportExcelAsync()
    {
        if (_report is null) return;
        await RunAsync(async () =>
        {
            ExcelPackage.LicenseContext = LicenseContext.NonCommercial;
            using var package = new ExcelPackage();
            var ws = package.Workbook.Worksheets.Add("B09-DN");
            ws.Cells[1, 1].Value = "B09-DN Thuyết minh BCTC TT99/2025";
            ws.Cells[2, 1].Value = CompanyToString(_report.CompanyId);
            ws.Cells[3, 1].Value = $"Năm {_report.FiscalYear} — {_report.Status}";
            var headers = new[] { "Mục", "Mã", "Chỉ tiêu", "GL năm nay", "Đ.chỉnh NY", "BC năm nay", "GL năm trước", "Đ.chỉnh NT", "BC năm trước", "Nguồn", "Thuyết minh", "Lý do ĐC" };
            for (var i = 0; i < headers.Length; i++)
                ws.Cells[5, i + 1].Value = headers[i];

            var row = 6;
            foreach (var line in _report.Lines)
            {
                ws.Cells[row, 1].Value = line.SectionCode;
                ws.Cells[row, 2].Value = line.Code;
                ws.Cells[row, 3].Value = line.Name;
                ws.Cells[row, 4].Value = line.CurrentSystemValue;
                ws.Cells[row, 5].Value = line.CurrentAdjustment;
                ws.Cells[row, 6].Value = line.CurrentReportedValue;
                ws.Cells[row, 7].Value = line.PreviousSystemValue;
                ws.Cells[row, 8].Value = line.PreviousAdjustment;
                ws.Cells[row, 9].Value = line.PreviousReportedValue;
                ws.Cells[row, 10].Value = line.SourceType.ToString();
                ws.Cells[row, 11].Value = line.Narrative;
                ws.Cells[row, 12].Value = line.AdjustmentReason;
                row++;
            }

            var ar = package.Workbook.Worksheets.Add("AR_10pct");
            ar.Cells[1, 1].Value = "Phải thu ≥ 10%";
            WriteConcentrationSheet(ar, _arRows);
            var ap = package.Workbook.Worksheets.Add("AP_10pct");
            ap.Cells[1, 1].Value = "Phải trả ≥ 10%";
            WriteConcentrationSheet(ap, _apRows);

            var fa = package.Workbook.Worksheets.Add("TSCD");
            fa.Cells[1, 1].Value = "Tài sản cố định";
            fa.Cells[2, 1].Value = "Mã";
            fa.Cells[2, 2].Value = "Tên";
            fa.Cells[2, 3].Value = "Nguyên giá";
            fa.Cells[2, 4].Value = "KH lũy kế";
            fa.Cells[2, 5].Value = "Còn lại";
            fa.Cells[2, 6].Value = "Trạng thái";
            var r = 3;
            foreach (var asset in _fixedAssets)
            {
                fa.Cells[r, 1].Value = asset.AssetCode;
                fa.Cells[r, 2].Value = asset.AssetName;
                fa.Cells[r, 3].Value = asset.OriginalCost;
                fa.Cells[r, 4].Value = asset.OpeningAccumulatedDepreciation;
                fa.Cells[r, 5].Value = asset.RemainingValue;
                fa.Cells[r, 6].Value = asset.Status;
                r++;
            }

            var fileName = $"B09-DN_{_report.FiscalYear}_{DateTime.Now:yyyyMMddHHmmss}.xlsx";
            await JS.InvokeVoidAsync("saveAsFile", fileName, Convert.ToBase64String(package.GetAsByteArray()));
        });
    }

    private static void WriteConcentrationSheet(OfficeOpenXml.ExcelWorksheet sheet, List<B09ConcentrationDto> rows)
    {
        sheet.Cells[2, 1].Value = "Đối tượng";
        sheet.Cells[2, 2].Value = "Số dư";
        sheet.Cells[2, 3].Value = "%";
        sheet.Cells[2, 4].Value = "≥10%";
        var row = 3;
        foreach (var item in rows)
        {
            sheet.Cells[row, 1].Value = item.PartyLabel;
            sheet.Cells[row, 2].Value = item.Amount;
            sheet.Cells[row, 3].Value = item.PercentOfTotal;
            sheet.Cells[row, 4].Value = item.MeetsThreshold ? "Có" : "";
            row++;
        }
    }

    private async Task RunAsync(Func<Task> action)
    {
        try
        {
            _busy = true;
            await action();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, MudBlazor.Severity.Error);
        }
        finally { _busy = false; }
    }

    private static string Format(decimal? value) => value.HasValue ? value.Value.ToString("N0") : "-";

    private static Color StatusColor(B09ReportStatus status) => status switch
    {
        B09ReportStatus.Locked => Color.Error,
        B09ReportStatus.Approved => Color.Success,
        B09ReportStatus.Validated or B09ReportStatus.Reviewed => Color.Info,
        _ => Color.Default
    };

    private static string ValidationIcon(B09ValidationSeverity severity) => severity switch
    {
        B09ValidationSeverity.Error => Icons.Material.Filled.Error,
        B09ValidationSeverity.Warning => Icons.Material.Filled.Warning,
        _ => Icons.Material.Filled.Info
    };

    private static string? FindClaim(System.Security.Claims.ClaimsPrincipal user, params string[] types)
    {
        foreach (var type in types)
        {
            var value = user.FindFirst(type)?.Value;
            if (!string.IsNullOrWhiteSpace(value))
                return value;
        }
        return null;
    }
