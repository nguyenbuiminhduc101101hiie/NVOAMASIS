    private async Task EditLineAsync(B09LineDto line)
    {
        if (_report is null) return;
        var parameters = new DialogParameters
        {
            [nameof(B09LineEditDialog.Line)] = line,
            [nameof(B09LineEditDialog.CanEdit)] = !IsLocked
        };
        var dialog = DialogService.Show<B09LineEditDialog>($"{line.Code}", parameters, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        var result = await dialog.Result;
        if (result.Canceled || result.Data is not B09LineEditDialog.B09LineEditResult edit)
            return;

        await RunAsync(async () =>
        {
            await B09Service.UpdateNarrativeAsync(_report.Id, line.NoteLineId, edit.Narrative, _userName);
            await B09Service.ApplyAdjustmentAsync(_report.Id, line.NoteLineId, edit.CurrentAdjustment, edit.PreviousAdjustment, edit.Reason ?? string.Empty, _userName);
            _report = await B09Service.GetAsync(_report.Id);
            Snackbar.Add($"Đã lưu {line.Code}.", MudBlazor.Severity.Success);
        });
    }

