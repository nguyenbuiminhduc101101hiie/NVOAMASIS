@page "/accounting/financial-statements/b09-dn"
@namespace NVOAMASIS.Components.Accounting.Pages
@attribute [Authorize]
@using Microsoft.EntityFrameworkCore
@using OfficeOpenXml
@using NVOAMASIS.Accounting.B09.Domain
@using NVOAMASIS.Accounting.B09.DTOs
@using NVOAMASIS.Accounting.B09.Services
@using NVOAMASIS.Data
@using NVOAMASIS.Models
@inject IB09FinancialStatementService B09Service
@inject IDbContextFactory<AppDbContext> DbFactory
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>B09-DN</PageTitle>

<MudPaper Class="pa-4">
    <MudText Typo="Typo.h5">B09-DN - Thuyết minh Báo cáo tài chính</MudText>
    <MudText Typo="Typo.body2" Class="mb-4">TT99/2025 — lớp báo cáo trên sổ cái, không sửa GeneralLedgerEntries</MudText>

    <MudGrid>
        <MudItem xs="12" md="5">
            <MudAutocomplete T="Guid"
                             Label="Công ty"
                             Variant="Variant.Outlined"
                             Value="_companyId"
                             ValueChanged="OnCompanyChangedAsync"
                             SearchFunc="SearchCompanyAsync"
                             ToStringFunc="CompanyToString"
                             Clearable="true"
                             CoerceText="true"
                             CoerceValue="true"
                             ResetValueOnEmptyText="true"
                             MaxItems="30" />
        </MudItem>
        <MudItem xs="12" md="3">
            <MudNumericField T="int"
                             Value="_fiscalYear"
                             ValueChanged="OnYearChangedAsync"
                             Label="Năm tài chính"
                             Variant="Variant.Outlined"
                             Min="2000"
                             Max="2200" />
        </MudItem>
        <MudItem xs="12" Class="d-flex flex-wrap align-center gap-2">
            <MudButton Variant="Variant.Outlined" Color="Color.Info" OnClick="LoadReportAsync" Disabled="_busy">Xem lại</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="GenerateAsync" Disabled="_busy || IsLocked">Generate</MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="ValidateAsync" Disabled="@(_busy || _report is null)">Validate</MudButton>
            <MudButton Variant="Variant.Outlined" OnClick="ReviewAsync" Disabled="@(_busy || _report is null || IsLocked || _report.Status < B09ReportStatus.Validated)">Review</MudButton>
            <MudButton Variant="Variant.Outlined" OnClick="ApproveAsync" Disabled="@(_busy || _report is null || IsLocked || _report.Status < B09ReportStatus.Reviewed)">Approve</MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Error" OnClick="LockAsync" Disabled="@(_busy || _report is null || IsLocked || _report.Status < B09ReportStatus.Validated)">Lock</MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Warning" OnClick="UnlockAsync" Disabled="@(_busy || _report is null || !IsLocked)">Unlock</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="ExportExcelAsync" Disabled="@(_busy || _report is null)">Excel</MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

<MudTabs Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-4" Class="mt-3">
    <MudTabPanel Text="Báo cáo">
        @if (_report is not null)
        {
            <MudStack Row="true" Justify="Justify.SpaceBetween" Class="mb-2">
                <MudText Typo="Typo.h6">@CompanyToString(_report.CompanyId) — Năm @_report.FiscalYear</MudText>
                <MudChip T="string" Color="StatusColor(_report.Status)">@_report.Status</MudChip>
            </MudStack>
            <MudText Typo="Typo.caption" Class="mb-3">
                Tạo: @_report.CreatedBy @_report.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                @if (_report.GeneratedAt.HasValue) { <span> | Generate: @_report.GeneratedAt.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span> }
                @if (_report.LockedBy is not null) { <span> | Lock: @_report.LockedBy</span> }
            </MudText>

            @foreach (var group in _report.Lines.GroupBy(x => new { x.SectionCode, x.SectionName }))
            {
                <MudExpansionPanels Class="mt-2">
                    <MudExpansionPanel Text="@($"{group.Key.SectionCode}. {group.Key.SectionName}")">
                        <MudTable Items="group.ToList()" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm">
                            <HeaderContent>
                                <MudTh>Mã</MudTh>
                                <MudTh>Chỉ tiêu</MudTh>
                                <MudTh Align="Align.Right">GL năm nay</MudTh>
                                <MudTh Align="Align.Right">Đ.chỉnh NY</MudTh>
                                <MudTh Align="Align.Right">BC năm nay</MudTh>
                                <MudTh Align="Align.Right">GL năm trước</MudTh>
                                <MudTh Align="Align.Right">Đ.chỉnh NT</MudTh>
                                <MudTh Align="Align.Right">BC năm trước</MudTh>
                                <MudTh>Nguồn</MudTh>
                                <MudTh></MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="Mã">
                                    @context.Code
                                    @if (context.IsRequiredNarrative)
                                    {
                                        <MudIcon Icon="@Icons.Material.Filled.Star" Size="Size.Small" Color="Color.Warning" Title="Bắt buộc thuyết minh" />
                                    }
                                </MudTd>
                                <MudTd DataLabel="Chỉ tiêu">
                                    <MudText>@context.Name</MudText>
                                    @if (!string.IsNullOrWhiteSpace(context.Narrative))
                                    {
                                        <MudText Typo="Typo.caption">@context.Narrative</MudText>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(context.AdjustmentReason))
                                    {
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">Lý do ĐC: @context.AdjustmentReason</MudText>
                                    }
                                </MudTd>
                                <MudTd Align="Align.Right">@Format(context.CurrentSystemValue)</MudTd>
                                <MudTd Align="Align.Right">@Format(context.CurrentAdjustment == 0 ? null : context.CurrentAdjustment)</MudTd>
                                <MudTd Align="Align.Right">@Format(context.CurrentReportedValue)</MudTd>
                                <MudTd Align="Align.Right">@Format(context.PreviousSystemValue)</MudTd>
                                <MudTd Align="Align.Right">@Format(context.PreviousAdjustment == 0 ? null : context.PreviousAdjustment)</MudTd>
                                <MudTd Align="Align.Right">@Format(context.PreviousReportedValue)</MudTd>
                                <MudTd>@context.SourceType</MudTd>
                                <MudTd>
                                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="@(() => EditLineAsync(context))" />
                                </MudTd>
                            </RowTemplate>
                        </MudTable>
                    </MudExpansionPanel>
                </MudExpansionPanels>
            }
        }
        else
        {
            <MudText>Chọn công ty / năm rồi bấm <b>Xem lại</b> hoặc <b>Generate</b>.</MudText>
        }

        @if (_validation?.Items.Count > 0)
        {
            <MudPaper Class="pa-4 mt-4" Outlined="true">
                <MudText Typo="Typo.h6">Validation</MudText>
                <MudList T="string">
                    @foreach (var item in _validation.Items)
                    {
                        <MudListItem T="string" Icon="@ValidationIcon(item.Severity)">
                            <MudText>@item.Severity: @item.Message</MudText>
                        </MudListItem>
                    }
                </MudList>
            </MudPaper>
        }
    </MudTabPanel>

    <MudTabPanel Text="Snapshot đã tạo">
        <MudButton Class="mb-3" Variant="Variant.Outlined" OnClick="LoadHistoryAsync" Disabled="_busy">Tải danh sách</MudButton>
        <MudTable Items="_history" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm">
            <HeaderContent>
                <MudTh>Công ty</MudTh>
                <MudTh>Năm</MudTh>
                <MudTh>Trạng thái</MudTh>
                <MudTh>Generate</MudTh>
                <MudTh>Người tạo</MudTh>
                <MudTh></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@CompanyToString(context.CompanyId)</MudTd>
                <MudTd>@context.FiscalYear</MudTd>
                <MudTd>@context.Status</MudTd>
                <MudTd>@(context.GeneratedAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "-")</MudTd>
                <MudTd>@context.CreatedBy</MudTd>
                <MudTd>
                    <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => OpenHistoryAsync(context))">Mở</MudButton>
                </MudTd>
            </RowTemplate>
        </MudTable>
    </MudTabPanel>

    <MudTabPanel Text="Mapping TK">
        <MudText Typo="Typo.caption" Class="mb-2">Sửa prefix tài khoản / dấu. Không nhập CustomSql trên màn này. Generate lại sau khi lưu mapping.</MudText>
        <MudButton Class="mb-3" Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveMappingsAsync" Disabled="_busy || IsLocked">Lưu mapping</MudButton>
        <MudTable Items="_mappings" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm">
            <HeaderContent>
                <MudTh>Mã</MudTh>
                <MudTh>Chỉ tiêu</MudTh>
                <MudTh>Mode</MudTh>
                <MudTh>Prefix TK</MudTh>
                <MudTh>Dấu</MudTh>
                <MudTh>% ngưỡng</MudTh>
                <MudTh>Bật</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.LineCode</MudTd>
                <MudTd>@context.LineName</MudTd>
                <MudTd>
                    <MudSelect T="B09MappingMode" @bind-Value="context.Mode" Dense="true" Disabled="IsLocked || context.HasCustomSql">
                        <MudSelectItem Value="@B09MappingMode.AccountBalance">Số dư</MudSelectItem>
                        <MudSelectItem Value="@B09MappingMode.PeriodActivity">Phát sinh</MudSelectItem>
                    </MudSelect>
                </MudTd>
                <MudTd><MudTextField @bind-Value="context.AccountPrefixesCsv" Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="IsLocked" /></MudTd>
                <MudTd><MudNumericField T="decimal" @bind-Value="context.SignMultiplier" Variant="Variant.Outlined" Margin="Margin.Dense" HideSpinButtons="true" Disabled="IsLocked" /></MudTd>
                <MudTd><MudNumericField T="decimal?" @bind-Value="context.DetailThresholdPercent" Variant="Variant.Outlined" Margin="Margin.Dense" HideSpinButtons="true" Disabled="IsLocked" /></MudTd>
                <MudTd><MudSwitch T="bool" @bind-Value="context.IsEnabled" Color="Color.Primary" Disabled="IsLocked" /></MudTd>
            </RowTemplate>
        </MudTable>
    </MudTabPanel>

    <MudTabPanel Text="Bên liên quan">
        @if (_companyId == Guid.Empty)
        {
            <MudText>Chọn công ty trước.</MudText>
        }
        else
        {
            <MudGrid Class="mb-3">
                <MudItem xs="12" md="3"><MudTextField @bind-Value="_partyEdit.RelatedPartyType" Label="Loại quan hệ" Variant="Variant.Outlined" /></MudItem>
                <MudItem xs="12" md="5"><MudTextField @bind-Value="_partyEdit.RelationshipDescription" Label="Tên / mô tả bên liên quan" Variant="Variant.Outlined" /></MudItem>
                <MudItem xs="12" md="2"><MudDatePicker Date="_partyFrom" DateChanged="d => _partyFrom = d" Label="Hiệu lực từ" Variant="Variant.Outlined" /></MudItem>
                <MudItem xs="12" md="2" Class="d-flex align-center">
                    <MudSwitch T="bool" @bind-Value="_partyEdit.IsActive" Color="Color.Primary" Label="Active" />
                    <MudButton Class="ml-2" Variant="Variant.Filled" Color="Color.Primary" OnClick="SavePartyAsync" Disabled="_busy || IsLocked">Lưu</MudButton>
                </MudItem>
            </MudGrid>
            <MudTable Items="_parties" Dense="true" Hover="true">
                <HeaderContent>
                    <MudTh>Loại</MudTh>
                    <MudTh>Tên / mô tả</MudTh>
                    <MudTh>Từ</MudTh>
                    <MudTh>Active</MudTh>
                    <MudTh></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.RelatedPartyType</MudTd>
                    <MudTd>@context.RelationshipDescription</MudTd>
                    <MudTd>@context.EffectiveFrom.ToString("dd/MM/yyyy")</MudTd>
                    <MudTd>@(context.IsActive ? "Có" : "Không")</MudTd>
                    <MudTd>
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="@(() => EditParty(context))" Disabled="IsLocked" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => DeletePartyAsync(context.Id))" Disabled="IsLocked" />
                    </MudTd>
                </RowTemplate>
            </MudTable>
        }
    </MudTabPanel>

    <MudTabPanel Text="Hàng giữ hộ">
        @if (_companyId == Guid.Empty)
        {
            <MudText>Chọn công ty trước.</MudText>
        }
        else
        {
            <MudGrid Class="mb-3">
                <MudItem xs="12" md="2"><MudTextField @bind-Value="_custodyEdit.CustodyType" Label="Loại" Variant="Variant.Outlined" /></MudItem>
                <MudItem xs="12" md="3"><MudTextField @bind-Value="_custodyEdit.CommodityGroup" Label="Nhóm hàng" Variant="Variant.Outlined" /></MudItem>
                <MudItem xs="12" md="4"><MudTextField @bind-Value="_custodyEdit.Description" Label="Mô tả" Variant="Variant.Outlined" /></MudItem>
                <MudItem xs="12" md="1"><MudNumericField T="decimal?" @bind-Value="_custodyEdit.Quantity" Label="SL" Variant="Variant.Outlined" HideSpinButtons="true" /></MudItem>
                <MudItem xs="12" md="1"><MudTextField @bind-Value="_custodyEdit.Unit" Label="ĐVT" Variant="Variant.Outlined" /></MudItem>
                <MudItem xs="12" md="1" Class="d-flex align-center">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveCustodyAsync" Disabled="_busy || IsLocked">Lưu</MudButton>
                </MudItem>
            </MudGrid>
            <MudTable Items="_custody" Dense="true" Hover="true">
                <HeaderContent>
                    <MudTh>Loại</MudTh>
                    <MudTh>Nhóm hàng</MudTh>
                    <MudTh>Mô tả</MudTh>
                    <MudTh>SL</MudTh>
                    <MudTh>Ngày nhận</MudTh>
                    <MudTh>Ngày trả</MudTh>
                    <MudTh></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.CustodyType</MudTd>
                    <MudTd>@context.CommodityGroup</MudTd>
                    <MudTd>@context.Description</MudTd>
                    <MudTd>@Format(context.Quantity)</MudTd>
                    <MudTd>@(context.ReceivedDate?.ToString("dd/MM/yyyy") ?? "-")</MudTd>
                    <MudTd>@(context.ReleasedDate?.ToString("dd/MM/yyyy") ?? "-")</MudTd>
                    <MudTd>
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="@(() => EditCustody(context))" Disabled="IsLocked" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => DeleteCustodyAsync(context.Id))" Disabled="IsLocked" />
                    </MudTd>
                </RowTemplate>
            </MudTable>
        }
    </MudTabPanel>

    <MudTabPanel Text="KH/NCC ≥ 10%">
        <MudButton Class="mb-3" Variant="Variant.Outlined" OnClick="LoadConcentrationsAsync" Disabled="_busy || _companyId == Guid.Empty">Tính từ sổ cái</MudButton>
        <MudText Typo="Typo.subtitle1">Phải thu khách hàng (131) — dòng ≥ 10% tổng</MudText>
        <MudTable Items="_arRows" Dense="true" Hover="true" Class="mb-4">
            <HeaderContent>
                <MudTh>Đối tượng</MudTh>
                <MudTh Align="Align.Right">Số dư</MudTh>
                <MudTh Align="Align.Right">%</MudTh>
                <MudTh>≥10%</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.PartyLabel</MudTd>
                <MudTd Align="Align.Right">@Format(context.Amount)</MudTd>
                <MudTd Align="Align.Right">@context.PercentOfTotal.ToString("N2")</MudTd>
                <MudTd>@(context.MeetsThreshold ? "Có" : "")</MudTd>
            </RowTemplate>
        </MudTable>
        <MudText Typo="Typo.subtitle1">Phải trả người bán (331) — dòng ≥ 10% tổng</MudText>
        <MudTable Items="_apRows" Dense="true" Hover="true">
            <HeaderContent>
                <MudTh>Đối tượng</MudTh>
                <MudTh Align="Align.Right">Số dư</MudTh>
                <MudTh Align="Align.Right">%</MudTh>
                <MudTh>≥10%</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.PartyLabel</MudTd>
                <MudTd Align="Align.Right">@Format(context.Amount)</MudTd>
                <MudTd Align="Align.Right">@context.PercentOfTotal.ToString("N2")</MudTd>
                <MudTd>@(context.MeetsThreshold ? "Có" : "")</MudTd>
            </RowTemplate>
        </MudTable>
    </MudTabPanel>

    <MudTabPanel Text="TSCĐ">
        <MudButton Class="mb-3" Variant="Variant.Outlined" OnClick="LoadFixedAssetsAsync" Disabled="_busy || _companyId == Guid.Empty">Tải sổ TSCĐ</MudButton>
        <MudTable Items="_fixedAssets" Dense="true" Hover="true">
            <HeaderContent>
                <MudTh>Mã</MudTh>
                <MudTh>Tên</MudTh>
                <MudTh>Loại</MudTh>
                <MudTh Align="Align.Right">Nguyên giá</MudTh>
                <MudTh Align="Align.Right">KH lũy kế</MudTh>
                <MudTh Align="Align.Right">Còn lại</MudTh>
                <MudTh>Trạng thái</MudTh>
                <MudTh>Ghi nhận</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.AssetCode</MudTd>
                <MudTd>@context.AssetName</MudTd>
                <MudTd>@context.AssetType</MudTd>
                <MudTd Align="Align.Right">@Format(context.OriginalCost)</MudTd>
                <MudTd Align="Align.Right">@Format(context.OpeningAccumulatedDepreciation)</MudTd>
                <MudTd Align="Align.Right">@Format(context.RemainingValue)</MudTd>
                <MudTd>@context.Status</MudTd>
                <MudTd>@context.RecognitionDate.ToString("dd/MM/yyyy")</MudTd>
            </RowTemplate>
        </MudTable>
    </MudTabPanel>
</MudTabs>

@code {
    private Guid _companyId;
    private int _fiscalYear = DateTime.Today.Year;
    private bool _busy;
    private string? _userName;
    private B09ReportDto? _report;
    private B09ValidationResultDto? _validation;
    private List<M_Customer> _companies = new();
    private List<B09ReportListItemDto> _history = new();
    private List<B09MappingDto> _mappings = new();
    private List<RelatedPartyProfile> _parties = new();
    private List<CustodyAsset> _custody = new();
    private List<B09ConcentrationDto> _arRows = new();
    private List<B09ConcentrationDto> _apRows = new();
    private List<B09FixedAssetDto> _fixedAssets = new();
    private RelatedPartyProfile _partyEdit = new() { IsActive = true, EffectiveFrom = DateTime.Today };
    private DateTime? _partyFrom = DateTime.Today;
    private CustodyAsset _custodyEdit = new() { CustodyType = "GoodsHeld" };

    private bool IsLocked => _report?.Status == B09ReportStatus.Locked;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var user = state.User;
            _userName = user.Identity?.Name
                        ?? user.FindFirst("email")?.Value
                        ?? user.FindFirst("preferred_username")?.Value
                        ?? "SYSTEM";

            await using var db = await DbFactory.CreateDbContextAsync();
            _companies = await db.Customer.AsNoTracking()
                .Where(x => x.Customer_ID != Guid.Empty)
                .OrderBy(x => x.TaxCode)
                .ThenBy(x => x.COMPANY)
                .ToListAsync();

            var claimId = FindClaim(user, "CompanyId", "companyId", "company_id");
            if (Guid.TryParse(claimId, out var companyId) && _companies.Any(x => x.Customer_ID == companyId))
                _companyId = companyId;

            await B09Service.EnsureTemplateSeededAsync();
            await LoadMappingsAsync();
            await LoadHistoryAsync();
            if (_companyId != Guid.Empty)
                await LoadAllForCompanyAsync();
        }
        catch
        {
            _userName = "SYSTEM";
        }
    }

    private async Task OnCompanyChangedAsync(Guid companyId)
    {
        _companyId = companyId;
        ResetPartyEdit();
        ResetCustodyEdit();
        await LoadAllForCompanyAsync();
    }

    private async Task OnYearChangedAsync(int year)
    {
        _fiscalYear = year;
        await LoadReportAsync();
        if (_companyId != Guid.Empty)
            await LoadConcentrationsAsync();
    }

    private async Task LoadAllForCompanyAsync()
    {
        _validation = null;
        await LoadReportAsync();
        await LoadHistoryAsync();
        if (_companyId == Guid.Empty)
        {
            _parties.Clear();
            _custody.Clear();
            _arRows.Clear();
            _apRows.Clear();
            _fixedAssets.Clear();
            return;
        }

        _parties = (await B09Service.ListRelatedPartiesAsync(_companyId)).ToList();
        _custody = (await B09Service.ListCustodyAssetsAsync(_companyId)).ToList();
        await LoadConcentrationsAsync();
        await LoadFixedAssetsAsync();
    }

    private async Task LoadReportAsync()
    {
        if (_companyId == Guid.Empty)
        {
            _report = null;
            return;
        }

        _report = await B09Service.GetByCompanyYearAsync(_companyId, _fiscalYear);
        if (_report is null)
            Snackbar.Add("Chưa có snapshot cho công ty/năm này. Bấm Generate.", MudBlazor.Severity.Info);
    }

    private async Task LoadHistoryAsync()
    {
        _history = (await B09Service.ListReportsAsync(_companyId == Guid.Empty ? null : _companyId)).ToList();
    }

    private async Task LoadMappingsAsync()
    {
        _mappings = (await B09Service.GetMappingsAsync()).ToList();
    }

    private async Task OpenHistoryAsync(B09ReportListItemDto item)
    {
        _companyId = item.CompanyId;
        _fiscalYear = item.FiscalYear;
        await LoadAllForCompanyAsync();
        Snackbar.Add($"Đã mở B09 năm {item.FiscalYear}.", MudBlazor.Severity.Success);
    }

    private Task<IEnumerable<Guid>> SearchCompanyAsync(string value)
    {
        IEnumerable<M_Customer> query = _companies;
        if (!string.IsNullOrWhiteSpace(value))
        {
            var key = value.Trim();
            query = query.Where(x =>
                (x.TaxCode?.Contains(key, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (x.COMPANY?.Contains(key, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (x.BIZName?.Contains(key, StringComparison.OrdinalIgnoreCase) ?? false) ||
                CompanyToString(x.Customer_ID).Contains(key, StringComparison.OrdinalIgnoreCase));
        }
        return Task.FromResult(query.Select(x => x.Customer_ID).Take(30));
    }

    private string CompanyToString(Guid id)
    {
        if (id == Guid.Empty) return string.Empty;
        var customer = _companies.FirstOrDefault(x => x.Customer_ID == id);
        if (customer is null) return id.ToString();
        var taxCode = (customer.TaxCode ?? string.Empty).Trim();
        var companyName = (customer.COMPANY ?? customer.BIZName ?? string.Empty).Trim();
        if (!string.IsNullOrWhiteSpace(taxCode) && !string.IsNullOrWhiteSpace(companyName))
            return $"{taxCode}_{companyName}";
        if (!string.IsNullOrWhiteSpace(taxCode)) return taxCode;
        if (!string.IsNullOrWhiteSpace(companyName)) return companyName;
        return customer.Customer_ID.ToString();
    }

