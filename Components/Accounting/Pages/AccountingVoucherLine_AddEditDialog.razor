@using NVOAMASIS.Data
@using NVOAMASIS.Models
@using NVOAMASIS.Services
@using Microsoft.EntityFrameworkCore
@using MudBlazor
@using NVOAMASIS.Data
@using NVOAMASIS.Models
@inject IDbContextFactory<AppDbContext> DbFactory
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form" Model="_line">
            <MudGrid Spacing="2">
                <MudItem xs="12" md="4">
                    <MudTextField @bind-Value="_line.LineNo_" Label="STT / LineNo" Variant="Variant.Outlined" Margin="Margin.Dense" Required="true" />
                </MudItem>
                <MudItem xs="12" md="8">
                    <MudAutocomplete T="Guid"
                                     Label="Tài khoản (TK)"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Value="_selectedDmId"
                                     ValueChanged="OnDanhMucChangedAsync"
                                     SearchFunc="SearchDanhMucAsync"
                                     ToStringFunc="DanhMucToString"
                                     CoerceText="true"
                                     CoerceValue="true"
                                     ResetValueOnEmptyText="true"
                                     Clearable="false"
                                     Required="true" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="_line.LineDescription" Label="Diễn giải" Variant="Variant.Outlined" Margin="Margin.Dense" Lines="2" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudAutocomplete T="Guid?"
                                     Label="Customer"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     @bind-Value="_line.CustomerId"
                                     SearchFunc="SearchCustomerAsync"
                                     ToStringFunc="CustomerToString"
                                     Clearable="true"
                                     CoerceText="true"
                                     CoerceValue="true"
                                     ResetValueOnEmptyText="true" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudAutocomplete T="Guid?"
                                     Label="Shipment (HBL)"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     @bind-Value="_line.ShipmentId"
                                     SearchFunc="SearchHblAsync"
                                     ToStringFunc="HblToString"
                                     Clearable="true"
                                     CoerceText="true"
                                     CoerceValue="true"
                                     ResetValueOnEmptyText="true" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="ContractIdText" Label="Contract" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudDatePicker Date="@_line.InvoiceDate" DateChanged="OnInvoiceDateChanged" Label="Invoice Date" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="_line.BranchId" Label="Branch" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="DepartmentIdText" Label="DepartmentId (Guid)" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudDatePicker Date="@_line.DueDate" DateChanged="OnDueDateChanged" Label="Due Date" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="_line.InvoiceNo" Label="Invoice No" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudSelect T="string"
                               Value="@(_line.LedgerType ?? string.Empty)"
                               ValueChanged="OnLedgerTypeChanged"
                               Label="Ledger Type"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               Clearable="true">
                        @foreach (var lt in LedgerTypeOptions)
                        {
                            <MudSelectItem Value="@lt">@lt</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="_line.TaxCode" Label="Tax Code" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudNumericField T="decimal?" @bind-Value="_line.VatRate" Label="VAT Rate (%)" Variant="Variant.Outlined" Margin="Margin.Dense" HideSpinButtons="true" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudNumericField T="int?" @bind-Value="_line.SortKey" Label="Sort Key" Variant="Variant.Outlined" Margin="Margin.Dense" HideSpinButtons="true" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudCheckBox @bind-Value="_line.IsTaxBook" Label="Is Tax Book" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudCheckBox @bind-Value="_line.IsManagementBook" Label="Is Management Book" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudNumericField @bind-Value="_line.DebitAmount" Label="Nợ" Variant="Variant.Outlined" Margin="Margin.Dense" HideSpinButtons="true" Format="N2" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudNumericField @bind-Value="_line.CreditAmount" Label="Có" Variant="Variant.Outlined" Margin="Margin.Dense" HideSpinButtons="true" Format="N2" />
                </MudItem>
            </MudGrid>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="Cancel">Hủy</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync">Lưu</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private MudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public Guid VoucherId { get; set; }
    [Parameter] public M_AccountingVoucherLines? Line { get; set; }

    private MudForm _form = default!;
    private M_AccountingVoucherLines _line = new();
    private Guid _selectedDmId;
    private List<DanhMucTaiKhoan> _danhMucs = new();
    private List<M_Customer> _customers = new();
    private List<M_HBL> _hbls = new();

    private static readonly string[] LedgerTypeOptions = { "FINANCIAL", "TAX", "MANAGEMENT","GENERAL" };

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _danhMucs = await db.DanhMucTaiKhoan.AsNoTracking()
            .Where(x => !string.IsNullOrWhiteSpace(x.Taikhoan))
            .OrderBy(x => x.Taikhoan)
            .ToListAsync();
        _customers = await db.Customer.AsNoTracking()
            .Where(x => x.Customer_ID != Guid.Empty)
            .OrderBy(x => x.Customer_Code)
            .ThenBy(x => x.COMPANY)
            .ToListAsync();
        _hbls = await db.HBL.AsNoTracking()
            .Where(x => x.hblID != Guid.Empty)
            .OrderByDescending(x => x.dateupdate)
            .ThenByDescending(x => x.hbl)
            .Take(2000)
            .ToListAsync();

        if (Line is { } src && src.Id != Guid.Empty)
        {
            _line = new M_AccountingVoucherLines
            {
                Id = src.Id,
                VoucherId = src.VoucherId,
                LineNo_ = src.LineNo_,
                DanhMucTaiKhoanID = src.DanhMucTaiKhoanID,
                AccountCode = src.AccountCode,
                DebitAmount = src.DebitAmount,
                CreditAmount = src.CreditAmount,
                DebitAmountFC = src.DebitAmountFC,
                CreditAmountFC = src.CreditAmountFC,
                LineDescription = src.LineDescription,
                CustomerId = src.CustomerId,
                ShipmentId = src.ShipmentId,
                ContractId = src.ContractId,
                BranchId = src.BranchId,
                DepartmentId = src.DepartmentId,
                DueDate = src.DueDate,
                LedgerType = src.LedgerType,
                TaxCode = src.TaxCode,
                VatRate = src.VatRate,
                InvoiceNo = src.InvoiceNo,
                InvoiceDate = src.InvoiceDate,
                IsTaxBook = src.IsTaxBook,
                IsManagementBook = src.IsManagementBook,
                SortKey = src.SortKey
            };
            if (src.CustomerId is Guid customerId && customerId != Guid.Empty && _customers.All(x => x.Customer_ID != customerId))
            {
                var customer = await db.Customer.AsNoTracking().FirstOrDefaultAsync(x => x.Customer_ID == customerId);
                if (customer is not null)
                    _customers.Add(customer);
            }
            if (src.ShipmentId is Guid shipmentId && shipmentId != Guid.Empty && _hbls.All(x => x.hblID != shipmentId))
            {
                var hbl = await db.HBL.AsNoTracking().FirstOrDefaultAsync(x => x.hblID == shipmentId);
                if (hbl is not null)
                    _hbls.Add(hbl);
            }
            var dm = _danhMucs.FirstOrDefault(x => x.Id == src.DanhMucTaiKhoanID);
            if (dm is not null)
                _selectedDmId = dm.Id;
        }
        else
        {
            var next = 1;
            var existing = await db.AccountingVoucherLines.Where(x => x.VoucherId == VoucherId).Select(x => x.LineNo_).ToListAsync();
            foreach (var e in existing)
            {
                if (int.TryParse(e, out var n) && n >= next)
                    next = n + 1;
            }

            _line = new M_AccountingVoucherLines
            {
                Id = Guid.NewGuid(),
                VoucherId = VoucherId,
                LineNo_ = next.ToString(),
                DebitAmount = 0,
                CreditAmount = 0,
                DebitAmountFC = 0,
                CreditAmountFC = 0,
                IsTaxBook = false,
                IsManagementBook = false
            };
            _selectedDmId = _danhMucs.FirstOrDefault()?.Id ?? Guid.Empty;
        }

        if (_selectedDmId != Guid.Empty)
            await ApplyDanhMucAsync(_selectedDmId);
    }

    private async Task OnDanhMucChangedAsync(Guid id)
    {
        _selectedDmId = id;
        await ApplyDanhMucAsync(id);
    }

    private Task<IEnumerable<Guid>> SearchDanhMucAsync(string value)
    {
        IEnumerable<DanhMucTaiKhoan> query = _danhMucs;
        if (!string.IsNullOrWhiteSpace(value))
        {
            var k = value.Trim();
            query = query.Where(x =>
                (x.Taikhoan?.Contains(k, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (x.Tentaikhoan?.Contains(k, StringComparison.OrdinalIgnoreCase) ?? false));
        }

        return Task.FromResult(query.Select(x => x.Id).Take(50));
    }

    private string DanhMucToString(Guid id)
    {
        var dm = _danhMucs.FirstOrDefault(x => x.Id == id);
        if (dm is null)
            return string.Empty;
        var tk = dm.Taikhoan ?? string.Empty;
        var ten = dm.Tentaikhoan ?? string.Empty;
        return string.IsNullOrWhiteSpace(ten) ? tk : $"{tk} - {ten}";
    }

    private Task ApplyDanhMucAsync(Guid id)
    {
        var dm = _danhMucs.FirstOrDefault(x => x.Id == id);
        if (dm is null)
            return Task.CompletedTask;
        _line.DanhMucTaiKhoanID = dm.Id;
        _line.AccountCode = (dm.Taikhoan ?? string.Empty).Trim();
        if (string.IsNullOrWhiteSpace(_line.LineDescription))
            _line.LineDescription = string.IsNullOrWhiteSpace(dm.Diengiai) ? (dm.Tentaikhoan ?? string.Empty) : dm.Diengiai;
        _line.DebitAmountFC = _line.DebitAmount;
        _line.CreditAmountFC = _line.CreditAmount;
        return Task.CompletedTask;
    }

    private void Cancel() => MudDialog.Cancel();

    private string ContractIdText
    {
        get => _line.ContractId ?? string.Empty;
        set
        {
            if (string.IsNullOrWhiteSpace(value))
                _line.ContractId = null;
            else if (Guid.TryParse(value.Trim(), out var g))
                _line.ContractId = g.ToString();
            else
                _line.ContractId = value.Trim();
        }
    }

    private Task OnInvoiceDateChanged(DateTime? date)
    {
        _line.InvoiceDate = date;
        return Task.CompletedTask;
    }
    private Task OnDueDateChanged(DateTime? date)
    {
        _line.DueDate = date;
        return Task.CompletedTask;
    }

    private Task OnLedgerTypeChanged(string value)
    {
        _line.LedgerType = string.IsNullOrWhiteSpace(value) ? null : value.Trim();
        return Task.CompletedTask;
    }

    private string DepartmentIdText
    {
        get => _line.DepartmentId?.ToString() ?? string.Empty;
        set
        {
            if (string.IsNullOrWhiteSpace(value))
                _line.DepartmentId = null;
            else if (Guid.TryParse(value.Trim(), out var g))
                _line.DepartmentId = g;
        }
    }

    private Task<IEnumerable<Guid?>> SearchCustomerAsync(string value)
    {
        IEnumerable<M_Customer> query = _customers;
        if (!string.IsNullOrWhiteSpace(value))
        {
            var k = value.Trim();
            query = query.Where(x =>
                (x.Customer_Code?.Contains(k, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (x.COMPANY?.Contains(k, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (x.BIZName?.Contains(k, StringComparison.OrdinalIgnoreCase) ?? false));
        }
        return Task.FromResult(query.Select(x => (Guid?)x.Customer_ID).Take(30));
    }

    private string CustomerToString(Guid? id)
    {
        if (id is null || id == Guid.Empty)
            return string.Empty;
        var c = _customers.FirstOrDefault(x => x.Customer_ID == id.Value);
        if (c is null)
            return string.Empty;
        var code = c.Customer_Code?.Trim() ?? string.Empty;
        var company = !string.IsNullOrWhiteSpace(c.COMPANY) ? c.COMPANY!.Trim() : (c.BIZName?.Trim() ?? string.Empty);
        if (!string.IsNullOrWhiteSpace(code) && !string.IsNullOrWhiteSpace(company))
            return $"{code} - {company}";
        return !string.IsNullOrWhiteSpace(code) ? code : company;
    }

    private Task<IEnumerable<Guid?>> SearchHblAsync(string value)
    {
        IEnumerable<M_HBL> query = _hbls;
        if (!string.IsNullOrWhiteSpace(value))
        {
            var k = value.Trim();
            query = query.Where(x => (x.hbl?.Contains(k, StringComparison.OrdinalIgnoreCase) ?? false));
        }
        return Task.FromResult(query.Select(x => (Guid?)x.hblID).Take(30));
    }

    private string HblToString(Guid? id)
    {
        if (id is null || id == Guid.Empty)
            return string.Empty;
        var h = _hbls.FirstOrDefault(x => x.hblID == id.Value);
        return h?.hbl ?? string.Empty;
    }

    private async Task SaveAsync()
    {
        await _form.Validate();
        if (!_form.IsValid)
            return;

        if (_selectedDmId == Guid.Empty)
        {
            Snackbar.Add("Chọn tài khoản.", MudBlazor.Severity.Warning);
            return;
        }

        if (_line.DebitAmount > 0 && _line.CreditAmount > 0)
        {
            Snackbar.Add("Một dòng chỉ ghi Nợ hoặc Có.", MudBlazor.Severity.Warning);
            return;
        }

        _line.DebitAmountFC = _line.DebitAmount;
        _line.CreditAmountFC = _line.CreditAmount;
        _line.DanhMucTaiKhoanID = _selectedDmId;
        MudDialog.Close(DialogResult.Ok(_line));
    }
}
