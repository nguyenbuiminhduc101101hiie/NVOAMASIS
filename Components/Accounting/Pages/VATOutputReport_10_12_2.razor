@page "/accounting/tax/vat-output"
@page "/VATOutputReport"
@using Microsoft.EntityFrameworkCore
@using MudBlazor
@using NVOAMASIS.Data
@using NVOAMASIS.Models
@using NVOAMASIS.Resources
@attribute [Authorize]
@inject SharedServices ssv
@inject AccountService asv
@inject IDbContextFactory<AppDbContext> DbFactory
@inject ISnackbar Snackbar
@inject IStringLocalizer<SharedResource> Localizer

<PageTitle>@Localizer["VatOut122.Title"]</PageTitle>

<div class="product-price-page vat-output-page">
    <PpScreenHeader Title="@Localizer["VatOut122.Title"]" Subtitle="@Localizer["VatOut122.Subtitle"]">
        <Toolbar>
            <MudStack Row="true" Spacing="1" Class="flex-wrap">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Search" OnClick="LoadAsync" Disabled="_busy">@Localizer["Gls1061.Load"]</MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Info" Size="Size.Small" StartIcon="@Icons.Material.Filled.Refresh" OnClick="ResetFilterAsync" Disabled="_busy">@Localizer["Gls1061.Reset"]</MudButton>
            </MudStack>
        </Toolbar>
    </PpScreenHeader>

    <MudPaper Class="product-price-card pa-3 mb-2 filter-card" Elevation="0">
        <MudGrid Spacing="2" AlignItems="Center">
            <MudItem xs="12" sm="2">
                <MudSelect T="string"
                           Label="@Localizer["Gls1061.FilterBy"]"
                           Value="@_dateMode"
                           ValueChanged="OnDateModeChanged"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Dense="true">
                    <MudSelectItem T="string" Value="@("DATE_RANGE")">@Localizer["Gls1061.ByDate"]</MudSelectItem>
                    <MudSelectItem T="string" Value="@("PERIOD")">@Localizer["Gls1061.ByPeriod"]</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="2">
                <MudDatePicker Label="@Localizer["Gls1061.FromDate"]"
                               @bind-Date="_fromDate"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               DateFormat="dd/MM/yyyy"
                               Disabled="@IsPeriodMode" />
            </MudItem>
            <MudItem xs="12" sm="2">
                <MudDatePicker Label="@Localizer["Gls1061.ToDate"]"
                               @bind-Date="_toDate"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               DateFormat="dd/MM/yyyy"
                               Disabled="@IsPeriodMode" />
            </MudItem>
            <MudItem xs="6" sm="1">
                <MudNumericField T="int?"
                                 Label="@Localizer["Gls1061.Year"]"
                                 Value="_fiscalYear"
                                 ValueChanged="OnYearChanged"
                                 Variant="Variant.Outlined"
                                 Margin="Margin.Dense"
                                 Min="2000"
                                 Max="2100"
                                 Disabled="@IsDateRangeMode" />
            </MudItem>
            <MudItem xs="6" sm="1">
                <MudNumericField T="int?"
                                 Label="@Localizer["Gls1061.Month"]"
                                 Value="_periodMonth"
                                 ValueChanged="OnMonthChanged"
                                 Variant="Variant.Outlined"
                                 Margin="Margin.Dense"
                                 Min="1"
                                 Max="12"
                                 Disabled="@IsDateRangeMode" />
            </MudItem>
            <MudItem xs="12" sm="1">
                <MudSelect T="string" Label="@Localizer["Gls1061.Book"]" @bind-Value="_book" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                    <MudSelectItem T="string" Value="@("TAX")">TAX</MudSelectItem>
                    <MudSelectItem T="string" Value="@("MGMT")">MGMT</MudSelectItem>
                    <MudSelectItem T="string" Value="@("ALL")">ALL</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="2">
                <MudSelect T="string" Label="@Localizer["VatOut122.VatAccount"]" @bind-Value="_vatAccount" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                    <MudSelectItem T="string" Value="@("33311")">@Localizer["VatOut122.VatAccount_33311"]</MudSelectItem>
                    <MudSelectItem T="string" Value="@("33312")">@Localizer["VatOut122.VatAccount_33312"]</MudSelectItem>
                    <MudSelectItem T="string" Value="@("3331")">@Localizer["VatOut122.VatAccount_3331All"]</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="3">
                <MudTextField @bind-Value="_search" Label="@Localizer["Gls1061.Search"]" Placeholder="@Localizer["VatOut122.SearchPlaceholder"]" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" Clearable="true" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" />
            </MudItem>
        </MudGrid>
        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1">
            @DateModeHelpText
        </MudText>
    </MudPaper>

    <MudPaper Class="product-price-card pa-2 mb-2" Elevation="0">
        <MudGrid Spacing="2">
            <MudItem xs="12" sm="3">
                <MudPaper Class="pa-2 text-center vat-stat stat-output" Elevation="0" Outlined="true">
                    <MudText Typo="Typo.caption">@Localizer["VatOut122.Kpi_OutputCredit"]</MudText>
                    <MudText Typo="Typo.subtitle1" Class="fw-bold">@VisibleItems.Sum(x => x.VatCredit).ToString("N0")</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="3">
                <MudPaper Class="pa-2 text-center vat-stat stat-reduction" Elevation="0" Outlined="true">
                    <MudText Typo="Typo.caption">@Localizer["VatOut122.Kpi_OutputDebit"]</MudText>
                    <MudText Typo="Typo.subtitle1" Class="fw-bold">@VisibleItems.Sum(x => x.VatDebit).ToString("N0")</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="3">
                <MudPaper Class="pa-2 text-center vat-stat stat-net" Elevation="0" Outlined="true">
                    <MudText Typo="Typo.caption">@Localizer["VatOut122.Kpi_NetPayable"]</MudText>
                    <MudText Typo="Typo.subtitle1" Class="fw-bold" Color="Color.Error">@((VisibleItems.Sum(x => x.VatCredit) - VisibleItems.Sum(x => x.VatDebit)).ToString("N0"))</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="3">
                <MudPaper Class="pa-2 text-center vat-stat" Elevation="0" Outlined="true">
                    <MudText Typo="Typo.caption">@Localizer["Gls1061.Lines"]</MudText>
                    <MudText Typo="Typo.subtitle1" Class="fw-bold">@VisibleItems.Count().ToString("N0")</MudText>
                </MudPaper>
            </MudItem>
        </MudGrid>
    </MudPaper>

    <MudPaper Class="product-price-card pa-2" Elevation="0">
        <MudDataGrid @key="_gridKey" T="VatOutputRow" Items="VisibleItems" Dense="true" Striped="true" Hover="true" Bordered="true"
                     Filterable="true" FilterMode="@DataGridFilterMode.ColumnFilterRow" ColumnResizeMode="ResizeMode.Column"
                     FixedHeader="true" Height="calc(100vh - 340px)" Class="vat-output-grid" Loading="_busy">
            <Columns>
                <PropertyColumn Property="x => x.PostingDate" Title="@Localizer["Gls1061.Col_PostingDate"]" Format="dd/MM/yyyy" />
                <PropertyColumn Property="x => x.VoucherNo" Title="@Localizer["Gls1061.VoucherNo"]" />
                <TemplateColumn Title="@Localizer["VatIn121.Col_Voucher"]" Filterable="false" Sortable="false">
                    <CellTemplate>
                        <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.OpenInNew" OnClick="@(() => OpenVoucher(context.Item))">@Localizer["Gls1061.View"]</MudButton>
                    </CellTemplate>
                </TemplateColumn>
                <PropertyColumn Property="x => x.VoucherDate" Title="@Localizer["Gls1061.Col_VoucherDateShort"]" Format="dd/MM/yyyy" />
                <PropertyColumn Property="x => x.AccountCode" Title="@Localizer["VatOut122.VatAccount"]" />
                <PropertyColumn Property="x => x.CustomerName" Title="@Localizer["VatOut122.Col_Customer"]" />
                <PropertyColumn Property="x => x.InvoiceNo" Title="@Localizer["Gls1061.Col_InvoiceNo"]" />
                <PropertyColumn Property="x => x.InvoiceDate" Title="@Localizer["Gls1061.Col_InvoiceDate"]" Format="dd/MM/yyyy" />
                <PropertyColumn Property="x => x.Description" Title="@Localizer["Gls1061.Description"]" />
                <PropertyColumn Property="x => x.VatCredit" Title="@Localizer["VatIn121.Col_VatCredit"]" Format="N0" CellClass="text-end fw-bold" HeaderClass="text-end" />
                <PropertyColumn Property="x => x.VatDebit" Title="@Localizer["VatIn121.Col_VatDebit"]" Format="N0" CellClass="text-end fw-bold" HeaderClass="text-end" />
                <PropertyColumn Property="x => x.NetVat" Title="@Localizer["VatOut122.Col_NetVat"]" Format="N0" CellClass="text-end fw-bold" HeaderClass="text-end" />
                <PropertyColumn Property="x => x.CurrencyCode" Title="@Localizer["Gls1061.Col_Currency"]" />
                <PropertyColumn Property="x => x.ExchangeRate" Title="@Localizer["Gls1061.Col_ExchangeRate"]" Format="N2" CellClass="text-end" HeaderClass="text-end" />
                <PropertyColumn Property="x => x.Book" Title="@Localizer["Gls1061.Book"]" />
                <PropertyColumn Property="x => x.SourceName" Title="@Localizer["Gls1061.Source"]" />
                <PropertyColumn Property="x => x.CreatedBy" Title="@Localizer["Gls1061.Col_CreatedBy"]" />
            </Columns>
            <PagerContent>
                <MudDataGridPager T="VatOutputRow" PageSizeOptions="new int[] { 25, 50, 100, 200 }" />
            </PagerContent>
        </MudDataGrid>
    </MudPaper>
</div>

@code {
    private const string PermissionMenuName = "GeneralLedgerEntries";
    [Parameter] public EventCallback<(string Key, string Title, RenderFragment Content)> OnTabRequest { get; set; }

    private bool _busy;
    private string _usr = string.Empty;
    private int _gridKey;
    private string _dateMode = "DATE_RANGE";
    private DateTime? _fromDate = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
    private DateTime? _toDate = DateTime.Today;
    private int? _fiscalYear = DateTime.Today.Year;
    private int? _periodMonth = DateTime.Today.Month;
    private string _book = "TAX";
    private string _vatAccount = "33311";
    private string _search = string.Empty;
    private List<VatOutputRow> _rows = new();

    private IEnumerable<VatOutputRow> VisibleItems => _rows.Where(MatchesSearch);
    private bool IsPeriodMode => string.Equals(_dateMode, "PERIOD", StringComparison.OrdinalIgnoreCase);
    private bool IsDateRangeMode => string.Equals(_dateMode, "DATE_RANGE", StringComparison.OrdinalIgnoreCase);
    private string DateModeHelpText => IsDateRangeMode
        ? Localizer["Gls1061.DateModeHelpDateRange"]
        : Localizer["Gls1061.DateModeHelpPeriod"];

    protected override async Task OnInitializedAsync()
    {
        var auth = await asv.GetAuth();
        _usr = auth.User.Identity?.Name ?? string.Empty;
        EnsureDateRange();
        await LoadAsync();
    }

    private async Task OnDateModeChanged(string value)
    {
        _dateMode = string.IsNullOrWhiteSpace(value) ? "DATE_RANGE" : value;

        if (IsPeriodMode)
            UpdateDateRange();
        else
            EnsureDateRange();

        await LoadAsync();
    }

    private async Task OnYearChanged(int? year)
    {
        _fiscalYear = year;
        if (IsPeriodMode)
            UpdateDateRange();
        await LoadAsync();
    }

    private async Task OnMonthChanged(int? month)
    {
        _periodMonth = month;
        if (IsPeriodMode)
            UpdateDateRange();
        await LoadAsync();
    }

    private void UpdateDateRange()
    {
        if (!_fiscalYear.HasValue || !_periodMonth.HasValue)
            return;

        if (_periodMonth.Value < 1 || _periodMonth.Value > 12)
            return;

        _fromDate = new DateTime(_fiscalYear.Value, _periodMonth.Value, 1);
        _toDate = _fromDate.Value.AddMonths(1).AddDays(-1);
    }

    private void EnsureDateRange()
    {
        if (!_fromDate.HasValue)
            _fromDate = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);

        if (!_toDate.HasValue)
            _toDate = DateTime.Today;

        if (_fromDate.Value.Date > _toDate.Value.Date)
        {
            var temp = _fromDate;
            _fromDate = _toDate;
            _toDate = temp;
        }
    }

    private async Task ResetFilterAsync()
    {
        _dateMode = "DATE_RANGE";
        _fromDate = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
        _toDate = DateTime.Today;
        _fiscalYear = DateTime.Today.Year;
        _periodMonth = DateTime.Today.Month;
        _book = "TAX";
        _vatAccount = "33311";
        _search = string.Empty;
        EnsureDateRange();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (!await ssv.CheckPermission(_usr, "View", PermissionMenuName))
        {
            Snackbar.Add(Localizer["VatOut122.NoPermission"], MudBlazor.Severity.Warning);
            _rows.Clear();
            return;
        }

        try
        {
            _busy = true;
            await using var db = await DbFactory.CreateDbContextAsync();

            if (IsPeriodMode)
                UpdateDateRange();
            else
                EnsureDateRange();

            var fromDate = _fromDate?.Date ?? new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
            var toExclusive = (_toDate?.Date ?? DateTime.Today).Date.AddDays(1);

            var query = db.GeneralLedgerEntries.AsNoTracking().AsQueryable();

            query = query.Where(x => x.PostingDate >= fromDate && x.PostingDate < toExclusive);

            if (IsPeriodMode && _fiscalYear.HasValue)
                query = query.Where(x => x.FiscalYear == _fiscalYear.Value);

            if (IsPeriodMode && _periodMonth.HasValue)
                query = query.Where(x => x.FiscalPeriod == _periodMonth.Value);

            if (_book == "TAX") query = query.Where(x => x.IsTaxBook == true);
            if (_book == "MGMT") query = query.Where(x => x.IsManagementBook == true);

            if (_vatAccount == "3331")
                query = query.Where(x => x.AccountCode.StartsWith("3331"));
            else
                query = query.Where(x => x.AccountCode == _vatAccount);

            var data = await query.OrderBy(x => x.PostingDate).ThenBy(x => x.VoucherNo).ThenBy(x => x.CreatedAt).Take(5000).ToListAsync();

            var customerIds = data.Where(x => x.CustomerId.HasValue && x.CustomerId.Value != Guid.Empty).Select(x => x.CustomerId!.Value).Distinct().ToHashSet();
            var customerMap = new Dictionary<Guid, string>();
            if (customerIds.Count > 0)
            {
                var customers = await db.Customer.AsNoTracking()
                    .Where(c => customerIds.Contains(c.Customer_ID))
                    .Select(c => new { c.Customer_ID, c.Customer_Code, c.COMPANY })
                    .ToListAsync();

                customerMap = customers.GroupBy(x => x.Customer_ID).ToDictionary(
                    g => g.Key,
                    g =>
                    {
                        var c = g.First();
                        return string.IsNullOrWhiteSpace(c.Customer_Code) ? (c.COMPANY ?? string.Empty) : $"{c.Customer_Code} - {c.COMPANY}";
                    });
            }

            var sourceMap = await LoadSourceMapAsync(db, data);

            _rows = data.Select(x => new VatOutputRow
            {
                Id = x.Id,
                VoucherId = x.VoucherId,
                PostingDate = x.PostingDate,
                VoucherNo = x.VoucherNo ?? string.Empty,
                VoucherDate = x.VoucherDate,
                AccountCode = x.AccountCode ?? string.Empty,
                CustomerName = x.CustomerId.HasValue && customerMap.TryGetValue(x.CustomerId.Value, out var customerName) ? customerName : string.Empty,
                InvoiceNo = string.Empty,
                InvoiceDate = null,
                Description = x.Description ?? string.Empty,
                VatDebit = x.Debit,
                VatCredit = x.Credit,
                CurrencyCode = x.CurrencyCode ?? string.Empty,
                ExchangeRate = x.ExchangeRate,
                Book = x.IsTaxBook == true && x.IsManagementBook == true ? "TAX/MGMT" : x.IsTaxBook == true ? "TAX" : x.IsManagementBook == true ? "MGMT" : string.Empty,
                SourceName = !string.IsNullOrWhiteSpace(x.SourceId) && sourceMap.TryGetValue(x.SourceId.Trim(), out var sourceName) ? sourceName : x.SourceModule ?? string.Empty,
                CreatedBy = x.CreatedBy ?? string.Empty
            }).ToList();

            _gridKey++;
            Snackbar.Add(string.Format(Localizer["VatOut122.LoadedCount"], _rows.Count.ToString("N0")), MudBlazor.Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(string.Format(Localizer["Error_Message"], ex.Message), MudBlazor.Severity.Error);
        }
        finally
        {
            _busy = false;
            StateHasChanged();
        }
    }

    private async Task<Dictionary<string, string>> LoadSourceMapAsync(AppDbContext db, List<M_GeneralLedgerEntries> data)
    {
        var result = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
        var sourceIdsText = data.Where(x => !string.IsNullOrWhiteSpace(x.SourceId)).Select(x => x.SourceId!.Trim()).Distinct(StringComparer.OrdinalIgnoreCase).ToHashSet(StringComparer.OrdinalIgnoreCase);
        if (sourceIdsText.Count == 0) return result;

        var sourceVouchers = await db.AccountingVouchers.AsNoTracking()
            .Where(v => !string.IsNullOrWhiteSpace(v.SourceId) && sourceIdsText.Contains(v.SourceId))
            .Select(v => new { v.SourceId, v.VoucherNo, v.Description })
            .ToListAsync();

        foreach (var v in sourceVouchers)
        {
            if (string.IsNullOrWhiteSpace(v.SourceId)) continue;
            result[v.SourceId.Trim()] = string.IsNullOrWhiteSpace(v.Description) ? v.VoucherNo : $"{v.VoucherNo} - {v.Description}";
        }
        return result;
    }

    private async Task OpenVoucher(VatOutputRow row)
    {
        if (row is null)
        {
            Snackbar.Add(Localizer["Gls1061.NoRowForLedger"], MudBlazor.Severity.Warning);
            return;
        }

        if (!OnTabRequest.HasDelegate)
        {
            Snackbar.Add(Localizer["Gls1061.NoLedgerTab"], MudBlazor.Severity.Warning);
            return;
        }

        var accountCode = (row.AccountCode ?? string.Empty).Trim();

        if (string.IsNullOrWhiteSpace(accountCode))
        {
            Snackbar.Add(Localizer["VatOut122.NoVatAccount"], MudBlazor.Severity.Warning);
            return;
        }

        var book = string.Equals(_book, "ALL", StringComparison.OrdinalIgnoreCase)
            ? "TAX"
            : _book.Trim().ToUpperInvariant();

        RenderFragment content = builder =>
        {
            builder.OpenComponent<Components.Accounting.Pages.GeneralLedgerSummary_10_6_1>(0);
            builder.AddAttribute(1, "InitialAccountCode", accountCode);
            builder.AddAttribute(2, "InitialFiscalYear", _fiscalYear);
            builder.AddAttribute(3, "InitialPeriodMonth", _periodMonth);
            builder.AddAttribute(4, "InitialBook", book);
            builder.CloseComponent();
        };

        await OnTabRequest.InvokeAsync((
            $"GeneralLedgerSummary_{accountCode}_{_fiscalYear}_{_periodMonth}_{book}",
            string.Format(Localizer["Gls1061.LedgerTabTitle"], accountCode),
            content
        ));
    }

    private bool MatchesSearch(VatOutputRow x)
    {
        if (string.IsNullOrWhiteSpace(_search)) return true;
        var key = _search.Trim();
        return x.VoucherNo.Contains(key, StringComparison.OrdinalIgnoreCase)
            || x.PostingDate.ToString("dd/MM/yyyy").Contains(key, StringComparison.OrdinalIgnoreCase)
            || x.VoucherDate.ToString("dd/MM/yyyy").Contains(key, StringComparison.OrdinalIgnoreCase)
            || x.AccountCode.Contains(key, StringComparison.OrdinalIgnoreCase)
            || x.CustomerName.Contains(key, StringComparison.OrdinalIgnoreCase)
            || x.InvoiceNo.Contains(key, StringComparison.OrdinalIgnoreCase)
            || (x.InvoiceDate?.ToString("dd/MM/yyyy").Contains(key, StringComparison.OrdinalIgnoreCase) ?? false)
            || x.Description.Contains(key, StringComparison.OrdinalIgnoreCase)
            || x.VatDebit.ToString("N0").Contains(key, StringComparison.OrdinalIgnoreCase)
            || x.VatCredit.ToString("N0").Contains(key, StringComparison.OrdinalIgnoreCase)
            || x.NetVat.ToString("N0").Contains(key, StringComparison.OrdinalIgnoreCase)
            || x.CurrencyCode.Contains(key, StringComparison.OrdinalIgnoreCase)
            || x.Book.Contains(key, StringComparison.OrdinalIgnoreCase)
            || x.SourceName.Contains(key, StringComparison.OrdinalIgnoreCase)
            || x.CreatedBy.Contains(key, StringComparison.OrdinalIgnoreCase);
    }

    private sealed class VatOutputRow
    {
        public Guid Id { get; set; }
        public Guid VoucherId { get; set; }
        public DateTime PostingDate { get; set; }
        public string VoucherNo { get; set; } = string.Empty;
        public DateTime VoucherDate { get; set; }
        public string AccountCode { get; set; } = string.Empty;
        public string CustomerName { get; set; } = string.Empty;
        public string InvoiceNo { get; set; } = string.Empty;
        public DateTime? InvoiceDate { get; set; }
        public string Description { get; set; } = string.Empty;
        public decimal VatDebit { get; set; }
        public decimal VatCredit { get; set; }
        public decimal NetVat => VatCredit - VatDebit;
        public string CurrencyCode { get; set; } = string.Empty;
        public decimal ExchangeRate { get; set; }
        public string Book { get; set; } = string.Empty;
        public string SourceName { get; set; } = string.Empty;
        public string CreatedBy { get; set; } = string.Empty;
    }
}

<style>
    .vat-output-page {
        background: #f4fdf7;
    }

        .vat-output-page .product-price-card {
            border: 1px solid #d1fae5;
            border-radius: 14px;
            box-shadow: 0 8px 20px rgba(22, 101, 52, 0.06);
        }

        .vat-output-page .filter-card {
            background: linear-gradient(90deg, #ffffff, #ecfdf5);
        }

        .vat-output-page .vat-stat {
            border-radius: 12px;
            background: #f0fff4;
            border: 1px solid #bbf7d0;
        }

        .vat-output-page .stat-output {
            background: #fff7ed;
            border-color: #fed7aa;
        }

        .vat-output-page .stat-reduction {
            background: #eff6ff;
            border-color: #bfdbfe;
        }

        .vat-output-page .stat-net {
            background: #fef2f2;
            border-color: #fecaca;
        }

        .vat-output-page .vat-output-grid {
            font-size: 0.82rem;
        }

            .vat-output-page .vat-output-grid .mud-table-container {
                overflow-x: auto;
            }

            .vat-output-page .vat-output-grid .mud-table-root .mud-table {
                width: max-content !important;
                min-width: 100%;
            }

            .vat-output-page .vat-output-grid .mud-table-cell,
            .vat-output-page .vat-output-grid td,
            .vat-output-page .vat-output-grid th {
                padding: 4px 8px !important;
                white-space: nowrap;
            }
</style>
