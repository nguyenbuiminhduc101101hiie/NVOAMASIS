    private async Task PostVoucherToLedgerAsync(
        DbConnection connection,
        DbTransaction transaction,
        Guid voucherId)
    {
        // Chỉ post đúng chứng từ tài sản vừa tạo. Không gọi procedure post theo
        // cả kỳ để tránh vô tình ghi sổ những voucher khác cùng công ty/tháng.
        await using var command = connection.CreateCommand();
        command.Transaction = transaction;
        command.CommandText = @"
DECLARE @TotalDebit DECIMAL(18, 2);
DECLARE @TotalCredit DECIMAL(18, 2);

SELECT
    @TotalDebit = ISNULL(SUM(ISNULL(DebitAmount, 0)), 0),
    @TotalCredit = ISNULL(SUM(ISNULL(CreditAmount, 0)), 0)
FROM dbo.AccountingVoucherLines
WHERE VoucherId = @VoucherId;

IF @TotalDebit = 0 AND @TotalCredit = 0
BEGIN
    RAISERROR(N'Chứng từ tài sản không có dòng hạch toán.', 16, 1);
    RETURN;
END;

IF ABS(@TotalDebit - @TotalCredit) > 0.01
BEGIN
    RAISERROR(N'Chứng từ tài sản không cân Nợ/Có.', 16, 1);
    RETURN;
END;

IF EXISTS
(
    SELECT 1
    FROM dbo.GeneralLedgerEntries
    WHERE VoucherId = @VoucherId
)
BEGIN
    RAISERROR(N'Chứng từ tài sản đã được ghi sổ.', 16, 1);
    RETURN;
END;

INSERT INTO dbo.GeneralLedgerEntries
(
    Id,
    VoucherId,
    VoucherLineId,
    CompanyId,
    FiscalYear,
    FiscalPeriod,
    PostingDate,
    VoucherDate,
    VoucherNo,
    AccountCode,
    Debit,
    Credit,
    CurrencyCode,
    ExchangeRate,
    DebitFC,
    CreditFC,
    CustomerId,
    SupplierId,
    EmployeeId,
    ShipmentId,
    ContractId,
    BranchCode,
    Description,
    SourceModule,
    SourceId,
    CreatedAt,
    CreatedBy,
    IsTaxBook,
    IsManagementBook,
    LedgerType
)
SELECT
    NEWID(),
    V.Id,
    L.Id,
    V.CompanyId,
    V.FiscalYear,
    V.FiscalPeriod,
    CAST(ISNULL(V.PostingDate, V.VoucherDate) AS DATE),
    CAST(V.VoucherDate AS DATE),
    V.VoucherNo,
    CAST(L.AccountCode AS NVARCHAR(20)),
    ISNULL(L.DebitAmount, 0),
    ISNULL(L.CreditAmount, 0),
    ISNULL(V.CurrencyCode, N'VND'),
    ISNULL(V.ExchangeRate, 1),
    ISNULL(L.DebitAmountFC, ISNULL(L.DebitAmount, 0)),
    ISNULL(L.CreditAmountFC, ISNULL(L.CreditAmount, 0)),
    L.CustomerId,
    NULL,
    NULL,
    L.ShipmentId,
    TRY_CONVERT(UNIQUEIDENTIFIER, L.ContractId),
    L.BranchId,
    COALESCE(L.LineDescription, V.Description),
    N'ACCOUNTING_VOUCHER',
    CONVERT(NVARCHAR(100), V.Id),
    SYSDATETIME(),
    @CreatedBy,
    ISNULL(L.IsTaxBook, 1),
    ISNULL(L.IsManagementBook, 1),
    ISNULL(L.LedgerType, N'GENERAL')
FROM dbo.AccountingVouchers V
INNER JOIN dbo.AccountingVoucherLines L
    ON L.VoucherId = V.Id
WHERE V.Id = @VoucherId
  AND V.CompanyId = @CompanyId
  AND ISNULL(V.Approve, 0) = 1
  AND ISNULL(V.Status, 1) <> 3
  AND ISNULL(L.AccountCode, N'') <> N''
  AND (ISNULL(L.DebitAmount, 0) <> 0
       OR ISNULL(L.CreditAmount, 0) <> 0);

UPDATE dbo.AccountingVouchers
SET Ghiso = 1,
    Status = 2,
    PostedBy = @CreatedBy,
    PostedDate = SYSDATETIME(),
    ModifiedBy = @CreatedBy,
    ModifiedDate = SYSDATETIME()
WHERE Id = @VoucherId
  AND CompanyId = @CompanyId;
";

        AddParameter(command, "@VoucherId", voucherId);
        AddParameter(command, "@CompanyId", _companyId);
        AddParameter(command, "@CreatedBy", _userName);

        await command.ExecuteNonQueryAsync();

        await using var verifyCommand = connection.CreateCommand();
        verifyCommand.Transaction = transaction;
        verifyCommand.CommandText = @"
SELECT COUNT(*)
FROM dbo.GeneralLedgerEntries
WHERE VoucherId = @VoucherId;";
        AddParameter(verifyCommand, "@VoucherId", voucherId);

        var result = await verifyCommand.ExecuteScalarAsync();
        var count = result is null || result == DBNull.Value
            ? 0
            : Convert.ToInt32(result);

        if (count <= 0)
        {
            throw new InvalidOperationException(
                "Không tạo được GeneralLedgerEntries cho chứng từ tài sản.");
        }
    }

    private static async Task<int> GetLedgerLineCountAsync(
        DbConnection connection,
        DbTransaction transaction,
        Guid voucherId)
    {
        await using var command = connection.CreateCommand();
        command.Transaction = transaction;
        command.CommandText = @"
SELECT COUNT(*)
FROM dbo.GeneralLedgerEntries
WHERE VoucherId = @VoucherId;";
        AddParameter(command, "@VoucherId", voucherId);

        var result = await command.ExecuteScalarAsync();
        return result is null || result == DBNull.Value
            ? 0
            : Convert.ToInt32(result);
    }

    private async Task TryRollbackVoucherAsync(Guid voucherId)
    {
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var connection = db.Database.GetDbConnection();

            if (connection.State != ConnectionState.Open)
                await connection.OpenAsync();

            await using var transaction = await connection.BeginTransactionAsync();

            try
            {
                await using var command = connection.CreateCommand();
                command.Transaction = transaction;
                command.CommandText = @"
DELETE FROM dbo.GeneralLedgerEntries
WHERE VoucherId = @VoucherId;

DELETE FROM dbo.AccountingVoucherLines
WHERE VoucherId = @VoucherId;

DELETE FROM dbo.AccountingVouchers
WHERE Id = @VoucherId
  AND SourceModule = N'FIXED_ASSET_TT99';";

                AddParameter(command, "@VoucherId", voucherId);
                await command.ExecuteNonQueryAsync();
                await transaction.CommitAsync();
            }
            catch
            {
                await transaction.RollbackAsync();
            }
            finally
            {
                await connection.CloseAsync();
            }
        }
        catch
        {
            // Không che mất lỗi gốc của thao tác đưa tài sản vào sử dụng.
        }
    }

    private static void AddParameter(
        DbCommand command,
        string name,
        object? value)
    {
        var parameter = command.CreateParameter();
        parameter.ParameterName = name;
        parameter.Value = value ?? DBNull.Value;
        command.Parameters.Add(parameter);
    }

    private static string GenerateVoucherNo(DateTime voucherDate)
        => $"TSCD-{voucherDate:yyyyMMdd}-{DateTime.Now:HHmmssfff}";

    private static string GetRootMessage(Exception ex)
    {
        var root = ex;
        while (root.InnerException is not null)
            root = root.InnerException;

        return root.Message;
    }

    private sealed class PutIntoUseResult
    {
        public FixedAsset Asset { get; init; } = new();
        public Guid VoucherId { get; init; }
        public string VoucherNo { get; init; } = string.Empty;
    }

    private sealed class VoucherPostResult
    {
        public Guid VoucherId { get; init; }
        public string VoucherNo { get; init; } = string.Empty;
        public DateTime VoucherDate { get; init; }
        public int LedgerLineCount { get; init; }
    }

    private void PrepareAssetBeforeSave()
    {
        _edit.AssetCode = (_edit.AssetCode ?? string.Empty)
            .Trim()
            .ToUpperInvariant();

        _edit.AssetName = (_edit.AssetName ?? string.Empty).Trim();
        _edit.AssetGroupCode = NormalizeText(_edit.AssetGroupCode);
        _edit.Description = NormalizeText(_edit.Description);
        _edit.SerialNo = NormalizeText(_edit.SerialNo);
        _edit.ModelNo = NormalizeText(_edit.ModelNo);
        _edit.Manufacturer = NormalizeText(_edit.Manufacturer);
        _edit.CountryOfOrigin = NormalizeText(_edit.CountryOfOrigin);
        _edit.DepartmentCode = NormalizeText(_edit.DepartmentCode);
        _edit.Location = NormalizeText(_edit.Location);
        _edit.Custodian = NormalizeText(_edit.Custodian);
        _edit.SupplierCode = NormalizeText(_edit.SupplierCode);
        _edit.InvoiceNo = NormalizeText(_edit.InvoiceNo);
        _edit.VoucherNo = NormalizeText(_edit.VoucherNo);
        _edit.SourceAccount = NormalizeText(_edit.SourceAccount);
        _edit.Notes = NormalizeText(_edit.Notes);

        _edit.AssetAccount = (_edit.AssetAccount ?? string.Empty).Trim();
        _edit.DepreciationAccount =
            (_edit.DepreciationAccount ?? string.Empty).Trim();
        _edit.ExpenseAccount =
            (_edit.ExpenseAccount ?? string.Empty).Trim();

        _edit.PurchaseDate = _edit.PurchaseDate?.Date;
        _edit.RecognitionDate = (_recognitionDate ?? _edit.RecognitionDate).Date;
        _edit.DepreciationStartDate =
            (_depreciationStartDate ?? _edit.DepreciationStartDate).Date;
        _edit.InvoiceDate = _edit.InvoiceDate?.Date;
        _edit.VoucherDate = _edit.VoucherDate?.Date;

        // VAT được khấu trừ không cộng vào nguyên giá.
        _edit.OriginalCost = RoundMoney(
            _edit.PurchasePrice +
            _edit.NonRefundableTax +
            _edit.TransportCost +
            _edit.InstallationCost +
            _edit.OtherDirectCost -
            _edit.DiscountAmount);

        _edit.RemainingValue = RoundMoney(
            _edit.OriginalCost -
            _edit.OpeningAccumulatedDepreciation);
    }

    private string? ValidateAssetBeforeSave(bool putIntoUse)
    {
        if (string.IsNullOrWhiteSpace(_edit.AssetCode))
            return "Mã tài sản không được để trống.";

        if (string.IsNullOrWhiteSpace(_edit.AssetName))
            return "Tên tài sản không được để trống.";

        if (_edit.RecognitionDate == default)
            return "Ngày ghi nhận tài sản không hợp lệ.";

        if (_edit.DepreciationStartDate == default)
            return "Ngày bắt đầu khấu hao không hợp lệ.";

        if (_edit.DepreciationStartDate < _edit.RecognitionDate)
        {
            return "Ngày bắt đầu khấu hao không được trước ngày ghi nhận tài sản.";
        }

        var moneyValues = new[]
        {
            _edit.PurchasePrice,
            _edit.NonRefundableTax,
            _edit.TransportCost,
            _edit.InstallationCost,
            _edit.OtherDirectCost,
            _edit.DiscountAmount,
            _edit.RecoverableVat,
            _edit.ResidualValue,
            _edit.OpeningAccumulatedDepreciation
        };

        if (moneyValues.Any(x => x < 0))
            return "Các giá trị tiền không được nhỏ hơn 0.";

        var totalFormationCost =
            _edit.PurchasePrice +
            _edit.NonRefundableTax +
            _edit.TransportCost +
            _edit.InstallationCost +
            _edit.OtherDirectCost;

        if (_edit.DiscountAmount > totalFormationCost)
        {
            return "Chiết khấu/giảm giá không được lớn hơn tổng chi phí hình thành tài sản.";
        }

        if (_edit.OriginalCost <= 0)
            return "Nguyên giá tài sản phải lớn hơn 0.";

        if (_edit.ResidualValue > _edit.OriginalCost)
            return "Giá trị thu hồi không được lớn hơn nguyên giá.";

        if (_edit.OpeningAccumulatedDepreciation >
            _edit.OriginalCost - _edit.ResidualValue)
        {
            return "Hao mòn lũy kế đầu kỳ vượt quá giá trị được khấu hao.";
        }

        if (_edit.DepreciationMethod != DepreciationMethod.NotDepreciated &&
            _edit.UsefulLifeMonths <= 0)
        {
            return "Thời gian sử dụng phải lớn hơn 0 tháng.";
        }

        if (string.IsNullOrWhiteSpace(_edit.AssetAccount))
            return "Tài khoản nguyên giá không được để trống.";

        if (string.IsNullOrWhiteSpace(_edit.DepreciationAccount))
            return "Tài khoản hao mòn không được để trống.";

        if (string.IsNullOrWhiteSpace(_edit.ExpenseAccount))
            return "Tài khoản chi phí khấu hao không được để trống.";

        if (putIntoUse && string.IsNullOrWhiteSpace(_edit.SourceAccount))
        {
            return "Tài khoản đối ứng nguồn hình thành không được để trống khi đưa tài sản vào sử dụng.";
        }

        if (putIntoUse &&
            _edit.Id != Guid.Empty &&
            _edit.Status == FixedAssetStatus.InUse)
        {
            return "Tài sản đã được đưa vào sử dụng.";
        }

        return null;
    }

    private static string? NormalizeText(string? value)
        => string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    private async Task DeleteAsync(FixedAsset asset)
    {
        var confirmed = await DialogService.ShowMessageBox(
            "Xóa tài sản",
            $"Xóa tài sản {asset.AssetCode} - {asset.AssetName}?",
            yesText: "Xóa",
            cancelText: "Hủy");

        if (confirmed != true)
            return;

        try
        {
            await FixedAssetService.DeleteDraftAsync(
                _companyId,
                asset.Id);

            Snackbar.Add("Đã xóa tài sản nháp.", MudBlazor.Severity.Success);

            if (_edit.Id == asset.Id)
                NewAsset();

            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, MudBlazor.Severity.Error);
        }
    }

    private void OnAssetTypeChanged(FixedAssetType value)
    {
        _edit.AssetType = value;
        ApplyDefaultAccounts(value, false);
    }

    private Task OnRecognitionDateChanged(DateTime? date)
    {
        _recognitionDate = date;
        if (date.HasValue)
            _edit.RecognitionDate = date.Value;

        return Task.CompletedTask;
    }

    private Task OnDepreciationStartDateChanged(DateTime? date)
    {
        _depreciationStartDate = date;
        if (date.HasValue)
            _edit.DepreciationStartDate = date.Value;

        return Task.CompletedTask;
    }

    private void SyncDateFieldsFromEdit()
    {
        _recognitionDate = _edit.RecognitionDate;
        _depreciationStartDate = _edit.DepreciationStartDate;
    }

    private void ApplyDefaultAccounts(
        FixedAssetType assetType,
        bool force)
    {
        var isCurrentDefault =
            string.IsNullOrWhiteSpace(_edit.AssetAccount) ||
            _edit.AssetAccount is "211" or "212" or "213";

        var isDepreciationDefault =
            string.IsNullOrWhiteSpace(_edit.DepreciationAccount) ||
            _edit.DepreciationAccount is "2141" or "2142" or "2143";

        if (force || isCurrentDefault)
        {
            _edit.AssetAccount = assetType switch
            {
                FixedAssetType.Tangible => "211",
                FixedAssetType.FinanceLease => "212",
                FixedAssetType.Intangible => "213",
                _ => "211"
            };
        }

        if (force || isDepreciationDefault)
        {
            _edit.DepreciationAccount = assetType switch
            {
                FixedAssetType.Tangible => "2141",
                FixedAssetType.FinanceLease => "2142",
                FixedAssetType.Intangible => "2143",
                _ => "2141"
            };
        }
    }

    private static FixedAsset CreateDefault()
        => new()
        {
            Id = Guid.Empty,
            RecognitionDate = DateTime.Today,
            DepreciationStartDate = DateTime.Today,
            AssetType = FixedAssetType.Tangible,
            DepreciationMethod = DepreciationMethod.StraightLine,
            UsefulLifeMonths = 36,
            AssetAccount = "211",
            DepreciationAccount = "2141",
            ExpenseAccount = "642",
            SourceAccount = "331",
            Status = FixedAssetStatus.Draft
        };

    private static string GetTypeText(FixedAssetType type)
        => type switch
        {
            FixedAssetType.Tangible => "Hữu hình",
            FixedAssetType.FinanceLease => "Thuê tài chính",
            FixedAssetType.Intangible => "Vô hình",
            _ => "Khác"
        };

    private static string GetStatusText(FixedAssetStatus status)
        => status switch
        {
            FixedAssetStatus.Draft => "Nháp",
            FixedAssetStatus.InUse => "Đang sử dụng",
            FixedAssetStatus.Suspended => "Tạm ngưng",
            FixedAssetStatus.Disposed => "Đã ghi giảm",
            _ => "Không xác định"
        };

    private static string FormatMoney(decimal value)
        => value.ToString("N0");

    private static decimal RoundMoney(decimal value)
        => decimal.Round(
            value,
            2,
            MidpointRounding.AwayFromZero);
}
