    private Task SaveDraftAsync()
        => SaveAssetAsync(putIntoUse: false);

    private Task PutIntoUseAsync()
        => SaveAssetAsync(putIntoUse: true);

    private async Task SaveAssetAsync(bool putIntoUse)
    {
        if (_saving)
            return;

        if (!_companyResolved || _companyId == Guid.Empty)
        {
            Snackbar.Add(
                "Vui lòng chọn công ty trước khi lưu tài sản.",
                MudBlazor.Severity.Warning);
            return;
        }

        if (_form is null)
            return;

        await _form.Validate();

        if (!_form.IsValid)
        {
            Snackbar.Add(
                "Vui lòng kiểm tra lại các trường bắt buộc.",
                MudBlazor.Severity.Warning);
            return;
        }

        _saving = true;

        try
        {
            PrepareAssetBeforeSave();

            var validationMessage = ValidateAssetBeforeSave(putIntoUse);
            if (!string.IsNullOrWhiteSpace(validationMessage))
            {
                Snackbar.Add(validationMessage, MudBlazor.Severity.Warning);
                return;
            }

            if (!putIntoUse)
            {
                // Nút LƯU luôn gửi trạng thái Nháp. Với tài sản đã sử dụng,
                // service hiện tại sẽ giữ nguyên trạng thái và chỉ cho sửa
                // các thông tin quản lý được phép.
                _edit.Status = FixedAssetStatus.Draft;

                _edit = await FixedAssetService.SaveAsync(
                    _companyId,
                    _edit,
                    _userName);
                SyncDateFieldsFromEdit();

                await LoadAsync();

                Snackbar.Add(
                    $"Đã lưu tài sản {_edit.AssetCode} - {_edit.AssetName}.",
                    MudBlazor.Severity.Success);
                return;
            }

            if (_edit.Id != Guid.Empty &&
                _edit.Status == FixedAssetStatus.InUse)
            {
                Snackbar.Add(
                    "Tài sản đã được đưa vào sử dụng.",
                    MudBlazor.Severity.Warning);
                return;
            }

            var result = await SaveAndPutIntoUseAsync();
            _edit = result.Asset;
            SyncDateFieldsFromEdit();

            await LoadAsync();

            Snackbar.Add(
                $"Đã đưa tài sản {_edit.AssetCode} vào sử dụng. " +
                $"Chứng từ {result.VoucherNo} đã được tạo và ghi sổ.",
                MudBlazor.Severity.Success);
        }
        catch (DbUpdateConcurrencyException ex)
        {
            Snackbar.Add(
                string.IsNullOrWhiteSpace(ex.Message)
                    ? "Tài sản đã được người khác cập nhật. Hãy tải lại dữ liệu."
                    : ex.Message,
                MudBlazor.Severity.Warning);
        }
        catch (InvalidOperationException ex)
        {
            Snackbar.Add(ex.Message, MudBlazor.Severity.Warning);
        }
        catch (Exception ex)
        {
            Snackbar.Add(
                $"Không thể lưu tài sản: {GetRootMessage(ex)}",
                MudBlazor.Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task<PutIntoUseResult> SaveAndPutIntoUseAsync()
    {
        // Bước 1: lưu hồ sơ ở trạng thái nháp trước. Nếu phần chứng từ lỗi,
        // hồ sơ vẫn còn ở Nháp và không bị đánh dấu Đang sử dụng sai.
        _edit.Status = FixedAssetStatus.Draft;

        var savedDraft = await FixedAssetService.SaveAsync(
            _companyId,
            _edit,
            _userName);

        _edit = savedDraft;

        VoucherPostResult? postedVoucher = null;

        try
        {
            postedVoucher = await CreateVoucherAndPostLedgerAsync(savedDraft);

            // Chỉ chuyển tài sản sang Đang sử dụng sau khi voucher và ledger
            // đã được tạo thành công.
            savedDraft.Status = FixedAssetStatus.InUse;
            savedDraft.VoucherNo = postedVoucher.VoucherNo;
            savedDraft.VoucherDate = postedVoucher.VoucherDate;

            var inUseAsset = await FixedAssetService.SaveAsync(
                _companyId,
                savedDraft,
                _userName);

            return new PutIntoUseResult
            {
                Asset = inUseAsset,
                VoucherId = postedVoucher.VoucherId,
                VoucherNo = postedVoucher.VoucherNo
            };
        }
        catch
        {
            // Service lưu tài sản và phần kế toán đang dùng hai DbContext khác
            // nhau. Nếu bước cập nhật trạng thái cuối cùng lỗi, xóa voucher và
            // ledger vừa tạo để tránh tài sản/voucher lệch trạng thái.
            if (postedVoucher is not null)
            {
                await TryRollbackVoucherAsync(postedVoucher.VoucherId);
            }

            throw;
        }
    }

    private async Task<VoucherPostResult> CreateVoucherAndPostLedgerAsync(
        FixedAsset asset)
    {
        if (asset.Id == Guid.Empty)
            throw new InvalidOperationException("Tài sản chưa được lưu.");

        var sourceAccount = asset.SourceAccount?.Trim();
        if (string.IsNullOrWhiteSpace(sourceAccount))
        {
            throw new InvalidOperationException(
                "Vui lòng nhập tài khoản đối ứng nguồn hình thành.");
        }

        var assetAccount = asset.AssetAccount?.Trim();
        if (string.IsNullOrWhiteSpace(assetAccount))
        {
            throw new InvalidOperationException(
                "Vui lòng nhập tài khoản nguyên giá.");
        }

        var voucherDate = (asset.VoucherDate ?? asset.RecognitionDate).Date;
        var voucherNo = string.IsNullOrWhiteSpace(asset.VoucherNo)
            ? GenerateVoucherNo(voucherDate)
            : asset.VoucherNo.Trim().ToUpperInvariant();

        var description =
            $"Ghi tăng và đưa vào sử dụng TSCĐ " +
            $"{asset.AssetCode} - {asset.AssetName}";

        var voucherId = Guid.NewGuid();
        var totalCredit = RoundMoney(
            asset.OriginalCost + asset.RecoverableVat);

        await using var db = await DbFactory.CreateDbContextAsync();
        var connection = db.Database.GetDbConnection();

        if (connection.State != ConnectionState.Open)
            await connection.OpenAsync();

        await using var transaction = await connection.BeginTransactionAsync();

        try
        {
            await EnsureVoucherNotExistsAsync(
                connection,
                transaction,
                asset.Id);

            var assetAccountId = await ResolveAccountIdAsync(
                connection,
                transaction,
                assetAccount);

            var sourceAccountId = await ResolveAccountIdAsync(
                connection,
                transaction,
                sourceAccount);

            Guid? vatAccountId = null;
            if (asset.RecoverableVat > 0)
            {
                vatAccountId = await ResolveAccountIdAsync(
                    connection,
                    transaction,
                    "1332");
            }

            await InsertVoucherAsync(
                connection,
                transaction,
                voucherId,
                asset,
                voucherNo,
                voucherDate,
                description);

            var lineNo = 1;

            await InsertVoucherLineAsync(
                connection,
                transaction,
                voucherId,
                lineNo++,
                assetAccountId,
                assetAccount,
                debit: asset.OriginalCost,
                credit: 0,
                description: description,
                invoiceNo: asset.InvoiceNo,
                invoiceDate: asset.InvoiceDate ?? voucherDate);

            if (asset.RecoverableVat > 0 && vatAccountId.HasValue)
            {
                await InsertVoucherLineAsync(
                    connection,
                    transaction,
                    voucherId,
                    lineNo++,
                    vatAccountId.Value,
                    "1332",
                    debit: asset.RecoverableVat,
                    credit: 0,
                    description: $"Thuế GTGT được khấu trừ của TSCĐ {asset.AssetCode}",
                    invoiceNo: asset.InvoiceNo,
                    invoiceDate: asset.InvoiceDate ?? voucherDate);
            }

            await InsertVoucherLineAsync(
                connection,
                transaction,
                voucherId,
                lineNo,
                sourceAccountId,
                sourceAccount,
                debit: 0,
                credit: totalCredit,
                description: description,
                invoiceNo: asset.InvoiceNo,
                invoiceDate: asset.InvoiceDate ?? voucherDate);

            await PostVoucherToLedgerAsync(
                connection,
                transaction,
                voucherId);

            var ledgerLineCount = await GetLedgerLineCountAsync(
                connection,
                transaction,
                voucherId);

            if (ledgerLineCount <= 0)
            {
                throw new InvalidOperationException(
                    "Chứng từ đã tạo nhưng chưa sinh được dòng sổ cái.");
            }

            await transaction.CommitAsync();

            return new VoucherPostResult
            {
                VoucherId = voucherId,
                VoucherNo = voucherNo,
                VoucherDate = voucherDate,
                LedgerLineCount = ledgerLineCount
            };
        }
        catch
        {
            await transaction.RollbackAsync();
            throw;
        }
        finally
        {
            await connection.CloseAsync();
        }
    }

    private async Task EnsureVoucherNotExistsAsync(
        DbConnection connection,
        DbTransaction transaction,
        Guid assetId)
    {
        await using var command = connection.CreateCommand();
        command.Transaction = transaction;
        command.CommandText = @"
SELECT TOP (1) VoucherNo
FROM dbo.AccountingVouchers
WHERE CompanyId = @CompanyId
  AND SourceModule = N'FIXED_ASSET_TT99'
  AND CONVERT(NVARCHAR(100), SourceId) = @SourceId;";

        AddParameter(command, "@CompanyId", _companyId);
        AddParameter(command, "@SourceId", assetId.ToString());

        var existing = await command.ExecuteScalarAsync();
        if (existing is not null && existing != DBNull.Value)
        {
            throw new InvalidOperationException(
                $"Tài sản đã có chứng từ ghi tăng {existing}.");
        }
    }

    private static async Task<Guid> ResolveAccountIdAsync(
        DbConnection connection,
        DbTransaction transaction,
        string accountCode)
    {
        await using var command = connection.CreateCommand();
        command.Transaction = transaction;
        command.CommandText = @"
SELECT TOP (1) Id
FROM dbo.DanhMucTaiKhoan
WHERE LTRIM(RTRIM(Taikhoan)) = @AccountCode
ORDER BY Id;";

        AddParameter(command, "@AccountCode", accountCode.Trim());

        var value = await command.ExecuteScalarAsync();

        if (value is Guid accountId && accountId != Guid.Empty)
            return accountId;

        if (value is not null &&
            value != DBNull.Value &&
            Guid.TryParse(Convert.ToString(value), out accountId) &&
            accountId != Guid.Empty)
        {
            return accountId;
        }

        throw new InvalidOperationException(
            $"Không tìm thấy tài khoản {accountCode} trong DanhMucTaiKhoan.");
    }

