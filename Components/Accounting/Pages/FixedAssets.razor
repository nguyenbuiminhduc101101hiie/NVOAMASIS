@page "/accounting/fixed-assets"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using Microsoft.Extensions.Localization
@using MudBlazor
@using NVOAMASIS.Models.Accounting
@using NVOAMASIS.Resources
@using NVOAMASIS.Services.Accounting

@inject IFixedAssetService FixedAssetService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IStringLocalizer<SharedResource> Localizer

<PageTitle>@Localizer["Fa1044.Title"]</PageTitle>

<MudStack Spacing="2">
    <MudPaper Class="pa-4" Elevation="1">
        <MudStack Row="true"
                  AlignItems="AlignItems.Center"
                  Justify="Justify.SpaceBetween">
            <div>
                <MudText Typo="Typo.h5">@Localizer["Fa1044.Heading"]</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    @Localizer["Fa1044.Subtitle"]
                </MudText>
            </div>

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add"
                       OnClick="NewAsset">
                @Localizer["Fa1044.New"]
            </MudButton>
        </MudStack>
    </MudPaper>

    <MudPaper Class="pa-4" Elevation="1">
        <MudForm @ref="_form" Model="@_edit">
            <MudTabs Rounded="true"
                     Border="true"
                     ApplyEffectsToContainer="true"
                     PanelClass="pa-4">

                <MudTabPanel Text="@Localizer["Fa1044.Tab_General"]"
                             Icon="@Icons.Material.Filled.Apartment">
                    <MudGrid Spacing="2">
                        <MudItem xs="12" md="3">
                            <MudTextField T="string"
                                          Label="@Localizer["Fa1044.AssetCode"]"
                                          @bind-Value="_edit.AssetCode"
                                          For="@(() => _edit.AssetCode)"
                                          Required="true"
                                          MaxLength="50"
                                          Immediate="true" />
                        </MudItem>

                        <MudItem xs="12" md="6">
                            <MudTextField T="string"
                                          Label="@Localizer["Fa1044.AssetName"]"
                                          @bind-Value="_edit.AssetName"
                                          For="@(() => _edit.AssetName)"
                                          Required="true"
                                          MaxLength="250"
                                          Immediate="true" />
                        </MudItem>

                        <MudItem xs="12" md="3">
                            <MudSelect T="FixedAssetType"
                                       Label="@Localizer["Fa1044.AssetType"]"
                                       Value="_edit.AssetType"
                                       ValueChanged="OnAssetTypeChanged"
                                       For="@(() => _edit.AssetType)"
                                       Required="true">
                                <MudSelectItem T="FixedAssetType"
                                               Value="@FixedAssetType.Tangible">
                                    @Localizer["Fa1044.Type_Tangible"]
                                </MudSelectItem>
                                <MudSelectItem T="FixedAssetType"
                                               Value="@FixedAssetType.FinanceLease">
                                    @Localizer["Fa1044.Type_FinanceLease"]
                                </MudSelectItem>
                                <MudSelectItem T="FixedAssetType"
                                               Value="@FixedAssetType.Intangible">
                                    @Localizer["Fa1044.Type_Intangible"]
                                </MudSelectItem>
                            </MudSelect>
                        </MudItem>

                        <MudItem xs="12" md="3">
                            <MudTextField T="string"
                                          Label="@Localizer["Fa1044.AssetGroup"]"
                                          @bind-Value="_edit.AssetGroupCode"
                                          MaxLength="50" />
                        </MudItem>

                        <MudItem xs="12" md="3">
                            <MudTextField T="string"
                                          Label="@Localizer["Fa1044.SerialNo"]"
                                          @bind-Value="_edit.SerialNo"
                                          MaxLength="100" />
                        </MudItem>

                        <MudItem xs="12" md="3">
                            <MudTextField T="string"
                                          Label="@Localizer["Fa1044.Model"]"
                                          @bind-Value="_edit.ModelNo"
                                          MaxLength="100" />
                        </MudItem>

                        <MudItem xs="12" md="3">
                            <MudTextField T="string"
                                          Label="@Localizer["Fa1044.Manufacturer"]"
                                          @bind-Value="_edit.Manufacturer"
                                          MaxLength="200" />
                        </MudItem>

                        <MudItem xs="12" md="3">
                            <MudTextField T="string"
                                          Label="@Localizer["Fa1044.Department"]"
                                          @bind-Value="_edit.DepartmentCode"
                                          MaxLength="50" />
                        </MudItem>

                        <MudItem xs="12" md="5">
                            <MudTextField T="string"
                                          Label="@Localizer["Fa1044.Location"]"
                                          @bind-Value="_edit.Location"
                                          MaxLength="250" />
                        </MudItem>

                        <MudItem xs="12" md="4">
                            <MudTextField T="string"
                                          Label="@Localizer["Fa1044.Custodian"]"
                                          @bind-Value="_edit.Custodian"
                                          MaxLength="200" />
                        </MudItem>

                        <MudItem xs="12">
                            <MudTextField T="string"
                                          Label="@Localizer["Fa1044.Description"]"
                                          @bind-Value="_edit.Description"
                                          Lines="2"
                                          MaxLength="1000" />
                        </MudItem>
                    </MudGrid>
                </MudTabPanel>

                <MudTabPanel Text="@Localizer["Fa1044.Tab_Cost"]"
                             Icon="@Icons.Material.Filled.ReceiptLong">
                    <MudGrid Spacing="2">
                        <MudItem xs="12" md="3">
                            <MudDatePicker Label="@Localizer["Fa1044.PurchaseDate"]"
                                           @bind-Date="_edit.PurchaseDate"
                                           DateFormat="dd/MM/yyyy"
                                           Clearable="true" />
                        </MudItem>

                        <MudItem xs="12" md="3">
                            <MudDatePicker Label="@Localizer["Fa1044.RecognitionDate"]"
                                           Date="_edit.RecognitionDate"
                                           DateChanged="d => { if (d.HasValue) _edit.RecognitionDate = d.Value; }"
                                           DateFormat="dd/MM/yyyy"
                                           Required="true" />
                        </MudItem>

                        <MudItem xs="12" md="3">
                            <MudTextField T="string"
                                          Label="@Localizer["Fa1044.SupplierCode"]"
                                          @bind-Value="_edit.SupplierCode"
                                          MaxLength="50" />
                        </MudItem>

                        <MudItem xs="12" md="3">
                            <MudTextField T="string"
                                          Label="@Localizer["Fa1044.InvoiceNo"]"
                                          @bind-Value="_edit.InvoiceNo"
                                          MaxLength="50" />
                        </MudItem>

                        <MudItem xs="12" md="3">
                            <MudDatePicker Label="@Localizer["Fa1044.InvoiceDate"]"
                                           @bind-Date="_edit.InvoiceDate"
                                           DateFormat="dd/MM/yyyy"
                                           Clearable="true" />
                        </MudItem>

                        <MudItem xs="12" md="3">
                            <MudTextField T="string"
                                          Label="@Localizer["Fa1044.VoucherNo"]"
                                          @bind-Value="_edit.VoucherNo"
                                          MaxLength="50" />
                        </MudItem>

                        <MudItem xs="12" md="3">
                            <MudDatePicker Label="@Localizer["Fa1044.VoucherDate"]"
                                           @bind-Date="_edit.VoucherDate"
                                           DateFormat="dd/MM/yyyy"
                                           Clearable="true" />
                        </MudItem>

                        <MudItem xs="12" md="3">
                            <MudCheckBox T="bool"
                                         Label="@Localizer["Fa1044.IsOpeningBalance"]"
                                         @bind-Value="_edit.IsOpeningBalance" />
                        </MudItem>

                        <MudItem xs="12" md="3">
                            <MudNumericField T="decimal"
                                             Label="@Localizer["Fa1044.PurchasePrice"]"
                                             @bind-Value="_edit.PurchasePrice"
                                             Min="0"
                                             Format="N0"
                                             HideSpinButtons="true" />
                        </MudItem>

                        <MudItem xs="12" md="3">
                            <MudNumericField T="decimal"
                                             Label="@Localizer["Fa1044.NonRefundableTax"]"
                                             @bind-Value="_edit.NonRefundableTax"
                                             Min="0"
                                             Format="N0"
                                             HideSpinButtons="true" />
                        </MudItem>

                        <MudItem xs="12" md="3">
                            <MudNumericField T="decimal"
                                             Label="@Localizer["Fa1044.TransportCost"]"
                                             @bind-Value="_edit.TransportCost"
                                             Min="0"
                                             Format="N0"
                                             HideSpinButtons="true" />
                        </MudItem>

                        <MudItem xs="12" md="3">
                            <MudNumericField T="decimal"
                                             Label="@Localizer["Fa1044.InstallationCost"]"
                                             @bind-Value="_edit.InstallationCost"
                                             Min="0"
                                             Format="N0"
                                             HideSpinButtons="true" />
                        </MudItem>

                        <MudItem xs="12" md="3">
                            <MudNumericField T="decimal"
                                             Label="@Localizer["Fa1044.OtherDirectCost"]"
                                             @bind-Value="_edit.OtherDirectCost"
                                             Min="0"
                                             Format="N0"
                                             HideSpinButtons="true" />
                        </MudItem>

                        <MudItem xs="12" md="3">
                            <MudNumericField T="decimal"
                                             Label="@Localizer["Fa1044.DiscountAmount"]"
                                             @bind-Value="_edit.DiscountAmount"
                                             Min="0"
                                             Format="N0"
                                             HideSpinButtons="true" />
                        </MudItem>

                        <MudItem xs="12" md="3">
                            <MudNumericField T="decimal"
                                             Label="@Localizer["Fa1044.RecoverableVat"]"
                                             @bind-Value="_edit.RecoverableVat"
                                             Min="0"
                                             Format="N0"
                                             HideSpinButtons="true" />
                        </MudItem>

                        <MudItem xs="12" md="3">
                            <MudPaper Class="pa-3 summary-box" Outlined="true">
                                <MudText Typo="Typo.caption">@Localizer["Fa1044.EstimatedOriginalCost"]</MudText>
                                <MudText Typo="Typo.h6">
                                    @FormatMoney(CalculatedOriginalCost)
                                </MudText>
                            </MudPaper>
                        </MudItem>
                    </MudGrid>
                </MudTabPanel>

                <MudTabPanel Text="@Localizer["Fa1044.Tab_Depreciation"]"
                             Icon="@Icons.Material.Filled.Calculate">
                    <MudGrid Spacing="2">
                        <MudItem xs="12" md="3">
                            <MudDatePicker Label="@Localizer["Fa1044.DepreciationStartDate"]"
                                           Date="_edit.DepreciationStartDate"
                                           DateChanged="d => { if (d.HasValue) _edit.DepreciationStartDate = d.Value; }"
                                           DateFormat="dd/MM/yyyy"
                                           Required="true" />
                        </MudItem>

                        <MudItem xs="12" md="3">
                            <MudNumericField T="int"
                                             Label="@Localizer["Fa1044.UsefulLifeMonths"]"
                                             @bind-Value="_edit.UsefulLifeMonths"
                                             Min="0"
                                             HideSpinButtons="true" />
                        </MudItem>

                        <MudItem xs="12" md="3">
                            <MudSelect T="DepreciationMethod"
                                       Label="@Localizer["Fa1044.DepreciationMethod"]"
                                       @bind-Value="_edit.DepreciationMethod"
                                       For="@(() => _edit.DepreciationMethod)">
                                <MudSelectItem T="DepreciationMethod"
                                               Value="@DepreciationMethod.StraightLine">
                                    @Localizer["Fa1044.Method_StraightLine"]
                                </MudSelectItem>
                                <MudSelectItem T="DepreciationMethod"
                                               Value="@DepreciationMethod.DecliningBalance">
                                    @Localizer["Fa1044.Method_DecliningBalance"]
                                </MudSelectItem>
                                <MudSelectItem T="DepreciationMethod"
                                               Value="@DepreciationMethod.UnitsOfProduction">
                                    @Localizer["Fa1044.Method_UnitsOfProduction"]
                                </MudSelectItem>
                                <MudSelectItem T="DepreciationMethod"
                                               Value="@DepreciationMethod.NotDepreciated">
                                    @Localizer["Fa1044.Method_NotDepreciated"]
                                </MudSelectItem>
                            </MudSelect>
                        </MudItem>

                        <MudItem xs="12" md="3">
                            <MudNumericField T="decimal"
                                             Label="@Localizer["Fa1044.ResidualValue"]"
                                             @bind-Value="_edit.ResidualValue"
                                             Min="0"
                                             Format="N0"
                                             HideSpinButtons="true" />
                        </MudItem>

                        <MudItem xs="12" md="3">
                            <MudNumericField T="decimal"
                                             Label="@Localizer["Fa1044.OpeningAccumDep"]"
                                             @bind-Value="_edit.OpeningAccumulatedDepreciation"
                                             Min="0"
                                             Format="N0"
                                             HideSpinButtons="true" />
                        </MudItem>

                        <MudItem xs="12" md="3">
                            <MudTextField T="string"
                                          Label="@Localizer["Fa1044.AssetAccount"]"
                                          @bind-Value="_edit.AssetAccount"
                                          For="@(() => _edit.AssetAccount)"
                                          Required="true"
                                          MaxLength="20" />
                        </MudItem>

                        <MudItem xs="12" md="3">
                            <MudTextField T="string"
                                          Label="@Localizer["Fa1044.DepreciationAccount"]"
                                          @bind-Value="_edit.DepreciationAccount"
                                          For="@(() => _edit.DepreciationAccount)"
                                          Required="true"
                                          MaxLength="20" />
                        </MudItem>

                        <MudItem xs="12" md="3">
                            <MudTextField T="string"
                                          Label="@Localizer["Fa1044.ExpenseAccount"]"
                                          @bind-Value="_edit.ExpenseAccount"
                                          For="@(() => _edit.ExpenseAccount)"
                                          Required="true"
                                          MaxLength="20" />
                        </MudItem>

                        <MudItem xs="12" md="3">
                            <MudTextField T="string"
                                          Label="@Localizer["Fa1044.SourceAccount"]"
                                          @bind-Value="_edit.SourceAccount"
                                          MaxLength="20" />
                        </MudItem>

                        <MudItem xs="12" md="3">
                            <MudPaper Class="pa-3 summary-box" Outlined="true">
                                <MudText Typo="Typo.caption">@Localizer["Fa1044.EstimatedMonthlyDep"]</MudText>
                                <MudText Typo="Typo.h6">
                                    @FormatMoney(CalculatedMonthlyDepreciation)
                                </MudText>
                            </MudPaper>
                        </MudItem>

                        <MudItem xs="12" md="3">
                            <MudPaper Class="pa-3 summary-box" Outlined="true">
                                <MudText Typo="Typo.caption">@Localizer["Fa1044.RemainingValue"]</MudText>
                                <MudText Typo="Typo.h6">
                                    @FormatMoney(CalculatedRemainingValue)
                                </MudText>
                            </MudPaper>
                        </MudItem>
                    </MudGrid>
                </MudTabPanel>

                <MudTabPanel Text="@Localizer["Fa1044.Tab_Status"]"
                             Icon="@Icons.Material.Filled.FactCheck">
                    <MudGrid Spacing="2">
                        <MudItem xs="12" md="4">
                            <MudSelect T="FixedAssetStatus"
                                       Label="@Localizer["Fa1044.Status"]"
                                       @bind-Value="_edit.Status">
                                <MudSelectItem T="FixedAssetStatus"
                                               Value="@FixedAssetStatus.Draft">
                                    @Localizer["Fa1044.Status_Draft"]
                                </MudSelectItem>
                                <MudSelectItem T="FixedAssetStatus"
                                               Value="@FixedAssetStatus.InUse">
                                    @Localizer["Fa1044.Status_InUse"]
                                </MudSelectItem>
                                <MudSelectItem T="FixedAssetStatus"
                                               Value="@FixedAssetStatus.Suspended">
                                    @Localizer["Fa1044.Status_Suspended"]
                                </MudSelectItem>
                                <MudSelectItem T="FixedAssetStatus"
                                               Value="@FixedAssetStatus.Disposed">
                                    @Localizer["Fa1044.Status_Disposed"]
                                </MudSelectItem>
                            </MudSelect>
                        </MudItem>

                        <MudItem xs="12">
                            <MudTextField T="string"
                                          Label="@Localizer["Fa1044.Notes"]"
                                          @bind-Value="_edit.Notes"
                                          Lines="4"
                                          MaxLength="2000" />
                        </MudItem>
                    </MudGrid>
                </MudTabPanel>
            </MudTabs>

            <MudDivider Class="my-4" />

            <MudStack Row="true" Spacing="2">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Save"
                           Disabled="@_saving"
                           OnClick="SaveDraftAsync">
                    @(_saving ? Localizer["Fa1044.Saving"] : Localizer["Fa1044.Save"])
                </MudButton>

                <MudButton Variant="Variant.Filled"
                           Color="Color.Success"
                           StartIcon="@Icons.Material.Filled.PlayArrow"
                           Disabled="@_saving"
                           OnClick="PutIntoUseAsync">
                    @Localizer["Fa1044.SaveAndUse"]
                </MudButton>

                <MudButton Variant="Variant.Outlined"
                           Color="Color.Default"
                           Disabled="_saving"
                           OnClick="NewAsset">
                    @Localizer["Fa1044.ResetForm"]
                </MudButton>
            </MudStack>
        </MudForm>
    </MudPaper>

    <MudPaper Class="pa-4" Elevation="1">
        <MudStack Row="true"
                  AlignItems="AlignItems.Center"
                  Spacing="2"
                  Class="mb-3">
            <MudTextField T="string"
                          Label="@Localizer["Fa1044.SearchPlaceholder"]"
                          @bind-Value="_keyword"
                          Immediate="true"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Class="flex-grow-1" />

            <MudButton Variant="Variant.Outlined"
                       StartIcon="@Icons.Material.Filled.Refresh"
                       OnClick="LoadAsync">
                @Localizer["Fa1044.Reload"]
            </MudButton>
        </MudStack>

        <MudTable T="FixedAsset"
                  Items="@FilteredItems"
                  Dense="true"
                  Hover="true"
                  Bordered="true"
                  Loading="_loading"
                  Breakpoint="Breakpoint.Sm">
            <HeaderContent>
                <MudTh>@Localizer["Fa1044.AssetCode"]</MudTh>
                <MudTh>@Localizer["Fa1044.AssetName"]</MudTh>
                <MudTh>@Localizer["Fa1044.AssetType"]</MudTh>
                <MudTh>@Localizer["Fa1044.Col_RecognitionDate"]</MudTh>
                <MudTh Align="Right">@Localizer["Fa1044.Col_OriginalCost"]</MudTh>
                <MudTh Align="Right">@Localizer["Fa1044.Col_Remaining"]</MudTh>
                <MudTh>@Localizer["Fa1044.Status"]</MudTh>
                <MudTh></MudTh>
            </HeaderContent>

            <RowTemplate>
                <MudTd DataLabel="@Localizer["Fa1044.AssetCode"]">@context.AssetCode</MudTd>
                <MudTd DataLabel="@Localizer["Fa1044.AssetName"]">@context.AssetName</MudTd>
                <MudTd DataLabel="@Localizer["Fa1044.AssetType"]">@GetTypeText(context.AssetType)</MudTd>
                <MudTd DataLabel="@Localizer["Fa1044.Col_RecognitionDate"]">
                    @context.RecognitionDate.ToString("dd/MM/yyyy")
                </MudTd>
                <MudTd DataLabel="@Localizer["Fa1044.Col_OriginalCost"]" Align="Right">
                    @FormatMoney(context.OriginalCost)
                </MudTd>
                <MudTd DataLabel="@Localizer["Fa1044.Col_Remaining"]" Align="Right">
                    @FormatMoney(context.RemainingValue)
                </MudTd>
                <MudTd DataLabel="@Localizer["Fa1044.Status"]">
                    @GetStatusText(context.Status)
                </MudTd>
                <MudTd>
                    <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                   Color="Color.Primary"
                                   Size="Size.Small"
                                   OnClick="@(() => EditAsync(context.Id))" />

                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                   Color="Color.Error"
                                   Size="Size.Small"
                                   Disabled="@(context.Status != FixedAssetStatus.Draft)"
                                   OnClick="@(() => DeleteAsync(context))" />
                </MudTd>
            </RowTemplate>

            <NoRecordsContent>
                <MudText Class="pa-4">@Localizer["Fa1044.NoRecords"]</MudText>
            </NoRecordsContent>
        </MudTable>
    </MudPaper>
</MudStack>

<style>
    .summary-box {
        min-height: 76px;
        background: var(--mud-palette-background-grey);
    }

    .flex-grow-1 {
        flex-grow: 1;
    }
</style>

@code {
    private MudForm? _form;
    private FixedAsset _edit = CreateDefault();
    private List<FixedAsset> _items = [];
    // Hệ thống không phân tách TSCĐ theo công ty.
    // Guid.Empty chỉ được truyền để tương thích chữ ký service hiện tại.
    private static readonly Guid GlobalCompanyId = Guid.Empty;
    private string _userName = "system";
    private string? _keyword;
    private bool _loading;
    private bool _saving;

    private IEnumerable<FixedAsset> FilteredItems
    {
        get
        {
            var keyword = _keyword?.Trim();

            if (string.IsNullOrWhiteSpace(keyword))
                return _items;

            return _items.Where(x =>
                x.AssetCode.Contains(keyword, StringComparison.OrdinalIgnoreCase) ||
                x.AssetName.Contains(keyword, StringComparison.OrdinalIgnoreCase) ||
                (x.SerialNo?.Contains(keyword, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (x.DepartmentCode?.Contains(keyword, StringComparison.OrdinalIgnoreCase) ?? false));
        }
    }

    private decimal CalculatedOriginalCost =>
        RoundMoney(Math.Max(
            0,
            _edit.PurchasePrice +
            _edit.NonRefundableTax +
            _edit.TransportCost +
            _edit.InstallationCost +
            _edit.OtherDirectCost -
            _edit.DiscountAmount));

    private decimal CalculatedRemainingValue =>
        RoundMoney(Math.Max(
            0,
            CalculatedOriginalCost -
            _edit.OpeningAccumulatedDepreciation));

    private decimal CalculatedMonthlyDepreciation
    {
        get
        {
            if (_edit.DepreciationMethod == DepreciationMethod.NotDepreciated ||
                _edit.UsefulLifeMonths <= 0)
            {
                return 0;
            }

            var depreciable = Math.Max(
                0,
                CalculatedOriginalCost - _edit.ResidualValue);

            return RoundMoney(depreciable / _edit.UsefulLifeMonths);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var state =
            await AuthenticationStateProvider.GetAuthenticationStateAsync();

        _userName = state.User.Identity?.Name ?? "system";

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;

        try
        {
            _items = (await FixedAssetService.SearchAsync(
                GlobalCompanyId,
                null)).ToList();
        }
        catch (Exception ex)
        {
            Snackbar.Add(
                string.Format(Localizer["Error_Message"], ex.Message),
                MudBlazor.Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private void NewAsset()
    {
        _edit = CreateDefault();
        ApplyDefaultAccounts(_edit.AssetType, true);
        _form?.ResetValidation();
    }

    private async Task EditAsync(Guid id)
    {
        try
        {
            var item = await FixedAssetService.GetAsync(GlobalCompanyId, id);

            if (item is null)
            {
                Snackbar.Add(Localizer["Fa1044.NotFound"], MudBlazor.Severity.Warning);
                return;
            }

            _edit = item;
            _form?.ResetValidation();
        }
        catch (Exception ex)
        {
            Snackbar.Add(
                string.Format(Localizer["Error_Message"], ex.Message),
                MudBlazor.Severity.Error);
        }
    }

    private Task SaveDraftAsync()
        => SaveAssetAsync(putIntoUse: false);

    private Task PutIntoUseAsync()
        => SaveAssetAsync(putIntoUse: true);

    private async Task SaveAssetAsync(bool putIntoUse)
    {
        if (_saving)
            return;

        if (_form is null)
            return;

        await _form.Validate();

        if (!_form.IsValid)
        {
            Snackbar.Add(
                Localizer["Fa1044.ValidateRequired"],
                MudBlazor.Severity.Warning);
            return;
        }

        _saving = true;

        try
        {
            PrepareAssetBeforeSave();

            var validationMessage = ValidateAssetBeforeSave();
            if (!string.IsNullOrWhiteSpace(validationMessage))
            {
                Snackbar.Add(validationMessage, MudBlazor.Severity.Warning);
                return;
            }

            // Nút LƯU luôn gửi trạng thái Nháp. Với tài sản đã sử dụng,
            // service sẽ giữ nguyên trạng thái và chỉ cho sửa thông tin quản lý.
            _edit.Status = putIntoUse
                ? FixedAssetStatus.InUse
                : FixedAssetStatus.Draft;

            var savedAsset = await FixedAssetService.SaveAsync(
                GlobalCompanyId,
                _edit,
                _userName);

            // Nhận lại Id, RowVersion và trạng thái thực tế sau khi SQL lưu xong.
            _edit = savedAsset;

            await LoadAsync();

            Snackbar.Add(
                putIntoUse
                    ? string.Format(
                        Localizer["Fa1044.SaveAndUseSuccess"],
                        _edit.AssetCode)
                    : string.Format(
                        Localizer["Fa1044.SaveSuccess"],
                        _edit.AssetCode,
                        _edit.AssetName),
                MudBlazor.Severity.Success);
        }
        catch (DbUpdateConcurrencyException ex)
        {
            Snackbar.Add(
                string.IsNullOrWhiteSpace(ex.Message)
                    ? Localizer["Fa1044.ConcurrencyWarning"]
                    : ex.Message,
                MudBlazor.Severity.Warning);
        }
        catch (InvalidOperationException ex)
        {
            Snackbar.Add(ex.Message, MudBlazor.Severity.Warning);
        }
        catch (Exception ex)
        {
            Snackbar.Add(
                string.Format(Localizer["Fa1044.SaveFailed"], ex.Message),
                MudBlazor.Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private void PrepareAssetBeforeSave()
    {
        _edit.AssetCode = (_edit.AssetCode ?? string.Empty)
            .Trim()
            .ToUpperInvariant();

        _edit.AssetName = (_edit.AssetName ?? string.Empty).Trim();
        _edit.AssetGroupCode = NormalizeText(_edit.AssetGroupCode);
        _edit.Description = NormalizeText(_edit.Description);
        _edit.SerialNo = NormalizeText(_edit.SerialNo);
        _edit.ModelNo = NormalizeText(_edit.ModelNo);
        _edit.Manufacturer = NormalizeText(_edit.Manufacturer);
        _edit.CountryOfOrigin = NormalizeText(_edit.CountryOfOrigin);
        _edit.DepartmentCode = NormalizeText(_edit.DepartmentCode);
        _edit.Location = NormalizeText(_edit.Location);
        _edit.Custodian = NormalizeText(_edit.Custodian);
        _edit.SupplierCode = NormalizeText(_edit.SupplierCode);
        _edit.InvoiceNo = NormalizeText(_edit.InvoiceNo);
        _edit.VoucherNo = NormalizeText(_edit.VoucherNo);
        _edit.SourceAccount = NormalizeText(_edit.SourceAccount);
        _edit.Notes = NormalizeText(_edit.Notes);

        _edit.AssetAccount = (_edit.AssetAccount ?? string.Empty).Trim();
        _edit.DepreciationAccount =
            (_edit.DepreciationAccount ?? string.Empty).Trim();
        _edit.ExpenseAccount =
            (_edit.ExpenseAccount ?? string.Empty).Trim();

        _edit.PurchaseDate = _edit.PurchaseDate?.Date;
        _edit.RecognitionDate = _edit.RecognitionDate.Date;
        _edit.DepreciationStartDate = _edit.DepreciationStartDate.Date;
        _edit.InvoiceDate = _edit.InvoiceDate?.Date;
        _edit.VoucherDate = _edit.VoucherDate?.Date;

        // VAT được khấu trừ không cộng vào nguyên giá.
        _edit.OriginalCost = RoundMoney(
            _edit.PurchasePrice +
            _edit.NonRefundableTax +
            _edit.TransportCost +
            _edit.InstallationCost +
            _edit.OtherDirectCost -
            _edit.DiscountAmount);

        _edit.RemainingValue = RoundMoney(
            _edit.OriginalCost -
            _edit.OpeningAccumulatedDepreciation);
    }

    private string? ValidateAssetBeforeSave()
    {
        if (string.IsNullOrWhiteSpace(_edit.AssetCode))
            return Localizer["Fa1044.Val_AssetCodeRequired"];

        if (string.IsNullOrWhiteSpace(_edit.AssetName))
            return Localizer["Fa1044.Val_AssetNameRequired"];

        if (_edit.RecognitionDate == default)
            return Localizer["Fa1044.Val_RecognitionDate"];

        if (_edit.DepreciationStartDate == default)
            return Localizer["Fa1044.Val_DepStartDate"];

        if (_edit.DepreciationStartDate < _edit.RecognitionDate)
            return Localizer["Fa1044.Val_DepBeforeRecognition"];

        var moneyValues = new[]
        {
            _edit.PurchasePrice,
            _edit.NonRefundableTax,
            _edit.TransportCost,
            _edit.InstallationCost,
            _edit.OtherDirectCost,
            _edit.DiscountAmount,
            _edit.RecoverableVat,
            _edit.ResidualValue,
            _edit.OpeningAccumulatedDepreciation
        };

        if (moneyValues.Any(x => x < 0))
            return Localizer["Fa1044.Val_NegativeMoney"];

        var totalFormationCost =
            _edit.PurchasePrice +
            _edit.NonRefundableTax +
            _edit.TransportCost +
            _edit.InstallationCost +
            _edit.OtherDirectCost;

        if (_edit.DiscountAmount > totalFormationCost)
            return Localizer["Fa1044.Val_DiscountTooLarge"];

        if (_edit.OriginalCost <= 0)
            return Localizer["Fa1044.Val_OriginalCostPositive"];

        if (_edit.ResidualValue > _edit.OriginalCost)
            return Localizer["Fa1044.Val_ResidualTooLarge"];

        if (_edit.OpeningAccumulatedDepreciation >
            _edit.OriginalCost - _edit.ResidualValue)
            return Localizer["Fa1044.Val_OpeningDepTooLarge"];

        if (_edit.DepreciationMethod != DepreciationMethod.NotDepreciated &&
            _edit.UsefulLifeMonths <= 0)
            return Localizer["Fa1044.Val_UsefulLife"];

        if (string.IsNullOrWhiteSpace(_edit.AssetAccount))
            return Localizer["Fa1044.Val_AssetAccountRequired"];

        if (string.IsNullOrWhiteSpace(_edit.DepreciationAccount))
            return Localizer["Fa1044.Val_DepAccountRequired"];

        if (string.IsNullOrWhiteSpace(_edit.ExpenseAccount))
            return Localizer["Fa1044.Val_ExpenseAccountRequired"];

        return null;
    }

    private static string? NormalizeText(string? value)
        => string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    private async Task DeleteAsync(FixedAsset asset)
    {
        var confirmed = await DialogService.ShowMessageBox(
            Localizer["Fa1044.DeleteTitle"],
            string.Format(
                Localizer["Fa1044.DeleteConfirm"],
                asset.AssetCode,
                asset.AssetName),
            yesText: Localizer["Fa1044.DeleteYes"],
            cancelText: Localizer["Fa1044.Cancel"]);

        if (confirmed != true)
            return;

        try
        {
            await FixedAssetService.DeleteDraftAsync(
                GlobalCompanyId,
                asset.Id);

            Snackbar.Add(Localizer["Fa1044.DeleteSuccess"], MudBlazor.Severity.Success);

            if (_edit.Id == asset.Id)
                NewAsset();

            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(
                string.Format(Localizer["Error_Message"], ex.Message),
                MudBlazor.Severity.Error);
        }
    }

    private void OnAssetTypeChanged(FixedAssetType value)
    {
        _edit.AssetType = value;
        ApplyDefaultAccounts(value, false);
    }

    private void ApplyDefaultAccounts(
        FixedAssetType assetType,
        bool force)
    {
        var isCurrentDefault =
            string.IsNullOrWhiteSpace(_edit.AssetAccount) ||
            _edit.AssetAccount is "211" or "212" or "213";

        var isDepreciationDefault =
            string.IsNullOrWhiteSpace(_edit.DepreciationAccount) ||
            _edit.DepreciationAccount is "2141" or "2142" or "2143";

        if (force || isCurrentDefault)
        {
            _edit.AssetAccount = assetType switch
            {
                FixedAssetType.Tangible => "211",
                FixedAssetType.FinanceLease => "212",
                FixedAssetType.Intangible => "213",
                _ => "211"
            };
        }

        if (force || isDepreciationDefault)
        {
            _edit.DepreciationAccount = assetType switch
            {
                FixedAssetType.Tangible => "2141",
                FixedAssetType.FinanceLease => "2142",
                FixedAssetType.Intangible => "2143",
                _ => "2141"
            };
        }
    }

    private static FixedAsset CreateDefault()
        => new()
        {
            Id = Guid.Empty,
            RecognitionDate = DateTime.Today,
            DepreciationStartDate = DateTime.Today,
            AssetType = FixedAssetType.Tangible,
            DepreciationMethod = DepreciationMethod.StraightLine,
            UsefulLifeMonths = 36,
            AssetAccount = "211",
            DepreciationAccount = "2141",
            ExpenseAccount = "642",
            SourceAccount = "331",
            Status = FixedAssetStatus.Draft
        };

    private string GetTypeText(FixedAssetType type)
        => type switch
        {
            FixedAssetType.Tangible => Localizer["Fa1044.TypeShort_Tangible"],
            FixedAssetType.FinanceLease => Localizer["Fa1044.TypeShort_FinanceLease"],
            FixedAssetType.Intangible => Localizer["Fa1044.TypeShort_Intangible"],
            _ => Localizer["Fa1044.TypeShort_Other"]
        };

    private string GetStatusText(FixedAssetStatus status)
        => status switch
        {
            FixedAssetStatus.Draft => Localizer["Fa1044.StatusShort_Draft"],
            FixedAssetStatus.InUse => Localizer["Fa1044.StatusShort_InUse"],
            FixedAssetStatus.Suspended => Localizer["Fa1044.StatusShort_Suspended"],
            FixedAssetStatus.Disposed => Localizer["Fa1044.StatusShort_Disposed"],
            _ => Localizer["Fa1044.StatusShort_Unknown"]
        };

    private static string FormatMoney(decimal value)
        => value.ToString("N0");

    private static decimal RoundMoney(decimal value)
        => decimal.Round(
            value,
            2,
            MidpointRounding.AwayFromZero);
}
