@page "/accounting/fixed-assets/depreciation"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.Extensions.Localization
@using MudBlazor
@using NVOAMASIS.Models.Accounting
@using NVOAMASIS.Resources
@using NVOAMASIS.Services.Accounting

@inject IFixedAssetDepreciationService DepreciationService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IStringLocalizer<SharedResource> Localizer

<PageTitle>@Localizer["Fadc1045.Title"]</PageTitle>

<MudStack Spacing="2">
    <MudPaper Class="pa-4" Elevation="1">
        <MudStack Row="true"
                  AlignItems="AlignItems.Center"
                  Justify="Justify.SpaceBetween">
            <div>
                <MudText Typo="Typo.h5">@Localizer["Fadc1045.Heading"]</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    @Localizer["Fadc1045.Subtitle"]
                </MudText>
            </div>

            <MudButton Variant="Variant.Outlined"
                       StartIcon="@Icons.Material.Filled.Refresh"
                       Disabled="@_busy"
                       OnClick="CalculateAsync">
                @Localizer["Fa1044.Reload"]
            </MudButton>
        </MudStack>
    </MudPaper>

        <MudPaper Class="pa-4" Elevation="1">
            <MudGrid Spacing="2" AlignItems="AlignItems.End">
                <MudItem xs="12" sm="6" md="3">
                    <MudNumericField T="int"
                                     Label="@Localizer["Fadc1045.FiscalYear"]"
                                     @bind-Value="_fiscalYear"
                                     Min="2000"
                                     Max="9999"
                                     HideSpinButtons="true" />
                </MudItem>

                <MudItem xs="12" sm="6" md="3">
                    <MudSelect T="int"
                               Label="@Localizer["Fadc1045.FiscalPeriod"]"
                               @bind-Value="_fiscalPeriod">
                        @for (var month = 1; month <= 12; month++)
                        {
                            var monthValue = month;
                            <MudSelectItem T="int" Value="@monthValue">
                                @string.Format(Localizer["Fadc1045.MonthLabel"], monthValue)
                            </MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudSwitch T="bool"
                               Color="Color.Primary"
                               @bind-Value="_prorateByDay">
                        @Localizer["Fadc1045.ProrateByDay"]
                    </MudSwitch>
                </MudItem>

                <MudItem xs="12">
                    <MudStack Row="true" Spacing="1">
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Calculate"
                                   Disabled="@_busy"
                                   OnClick="CalculateAsync">
                            @Localizer["Fadc1045.Calculate"]
                        </MudButton>

                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Success"
                                   StartIcon="@Icons.Material.Filled.Save"
                                   Disabled="@(_busy || SelectedSavableCount == 0)"
                                   OnClick="SaveDraftAsync">
                            @Localizer["Fadc1045.SaveDraft"]
                        </MudButton>

                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Warning"
                                   StartIcon="@Icons.Material.Filled.AccountBalance"
                                   Disabled="@(_busy || SelectedDraftCount == 0)"
                                   OnClick="PostDraftAsync">
                            @Localizer["Fadc1045.Post"]
                        </MudButton>

                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Error"
                                   StartIcon="@Icons.Material.Filled.Delete"
                                   Disabled="@(_busy || SelectedDraftCount == 0)"
                                   OnClick="DeleteDraftAsync">
                            @Localizer["Fadc1045.DeleteDraft"]
                        </MudButton>
                    </MudStack>
                </MudItem>
            </MudGrid>

            <MudDivider Class="my-4" />

            <MudGrid Spacing="2">
                <MudItem xs="12" md="6">
                    <MudTextField T="string"
                                  Label="@Localizer["Fadc1045.SearchPlaceholder"]"
                                  @bind-Value="_keyword"
                                  Immediate="true"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Search" />
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudTextField T="string"
                                  Label="@Localizer["Fadc1045.DepartmentFilter"]"
                                  @bind-Value="_departmentFilter"
                                  Immediate="true"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Apartment" />
                </MudItem>
            </MudGrid>
        </MudPaper>

        <MudAlert Severity="MudBlazor.Severity.Info" Variant="Variant.Outlined">
            @Localizer["Fadc1045.InfoAlert"]
        </MudAlert>

        @if (_busy)
        {
            <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
        }

        <MudGrid Spacing="2">
            <MudItem xs="12" sm="6" md="3">
                <MudPaper Class="pa-3 summary-box" Outlined="true">
                    <MudText Typo="Typo.caption">@Localizer["Fadc1045.Kpi_VisibleAssets"]</MudText>
                    <MudText Typo="Typo.h6">@VisibleRowCount</MudText>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" sm="6" md="3">
                <MudPaper Class="pa-3 summary-box" Outlined="true">
                    <MudText Typo="Typo.caption">@Localizer["Fadc1045.Kpi_SelectedSave"]</MudText>
                    <MudText Typo="Typo.h6">@SelectedSavableCount</MudText>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" sm="6" md="3">
                <MudPaper Class="pa-3 summary-box" Outlined="true">
                    <MudText Typo="Typo.caption">@Localizer["Fadc1045.Kpi_SelectedOriginalCost"]</MudText>
                    <MudText Typo="Typo.h6">@FormatMoney(SelectedOriginalCost)</MudText>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" sm="6" md="3">
                <MudPaper Class="pa-3 summary-box" Outlined="true">
                    <MudText Typo="Typo.caption">@Localizer["Fadc1045.Kpi_SelectedDepAmount"]</MudText>
                    <MudText Typo="Typo.h6">@FormatMoney(SelectedDepreciationAmount)</MudText>
                </MudPaper>
            </MudItem>
        </MudGrid>

        <MudPaper Class="pa-3" Elevation="1">
            <MudTable T="FixedAssetDepreciationRow"
                      Items="@FilteredRows"
                      Dense="true"
                      Hover="true"
                      Bordered="true"
                      Striped="true"
                      FixedHeader="true"
                      Height="520px"
                      Breakpoint="Breakpoint.Sm">
                <HeaderContent>
                    <MudTh Style="width:50px">
                        <MudCheckBox T="bool"
                                     Value="@AllSelectableSelected"
                                     ValueChanged="ToggleAll" />
                    </MudTh>
                    <MudTh>@Localizer["Fa1044.AssetCode"]</MudTh>
                    <MudTh>@Localizer["Fa1044.AssetName"]</MudTh>
                    <MudTh>@Localizer["Fa1044.Department"]</MudTh>
                    <MudTh>@Localizer["Fadc1045.Col_DepStart"]</MudTh>
                    <MudTh Align="Right">@Localizer["Fa1044.Col_OriginalCost"]</MudTh>
                    <MudTh Align="Right">@Localizer["Fadc1045.Col_OpeningDep"]</MudTh>
                    <MudTh Align="Right">@Localizer["Fadc1045.Col_MonthlyDep"]</MudTh>
                    <MudTh Align="Center">@Localizer["Fadc1045.Col_DepDays"]</MudTh>
                    <MudTh Align="Right">@Localizer["Fadc1045.Col_PeriodDep"]</MudTh>
                    <MudTh Align="Right">@Localizer["Fadc1045.Col_ClosingDep"]</MudTh>
                    <MudTh Align="Right">@Localizer["Fa1044.Col_Remaining"]</MudTh>
                    <MudTh>@Localizer["Fadc1045.Col_DebitAccount"]</MudTh>
                    <MudTh>@Localizer["Fadc1045.Col_CreditAccount"]</MudTh>
                    <MudTh>@Localizer["Fa1044.Status"]</MudTh>
                </HeaderContent>

                <RowTemplate>
                    <MudTd DataLabel="@Localizer["Fadc1045.Col_Select"]">
                        <MudCheckBox T="bool"
                                     @bind-Value="context.Selected"
                                     Disabled="@(!context.CanSave)" />
                    </MudTd>

                    <MudTd DataLabel="@Localizer["Fa1044.AssetCode"]">
                        <MudText Typo="Typo.body2"><b>@context.AssetCode</b></MudText>
                    </MudTd>

                    <MudTd DataLabel="@Localizer["Fa1044.AssetName"]">@context.AssetName</MudTd>
                    <MudTd DataLabel="@Localizer["Fa1044.Department"]">@context.DepartmentCode</MudTd>
                    <MudTd DataLabel="@Localizer["Fadc1045.Col_DepStart"]">
                        @context.DepreciationStartDate.ToString("dd/MM/yyyy")
                    </MudTd>

                    <MudTd DataLabel="@Localizer["Fa1044.Col_OriginalCost"]" Align="Right">
                        @FormatMoney(context.OriginalCost)
                    </MudTd>

                    <MudTd DataLabel="@Localizer["Fadc1045.Col_OpeningDep"]" Align="Right">
                        @FormatMoney(context.OpeningAccumulatedDepreciation)
                    </MudTd>

                    <MudTd DataLabel="@Localizer["Fadc1045.Col_MonthlyDep"]" Align="Right">
                        @FormatMoney(context.MonthlyDepreciation)
                    </MudTd>

                    <MudTd DataLabel="@Localizer["Fadc1045.Col_DepDays"]" Align="Center">
                        @context.DepreciableDays/@context.DaysInPeriod
                    </MudTd>

                    <MudTd DataLabel="@Localizer["Fadc1045.Col_PeriodDep"]" Align="Right">
                        <b>@FormatMoney(context.DepreciationAmount)</b>
                    </MudTd>

                    <MudTd DataLabel="@Localizer["Fadc1045.Col_ClosingDep"]" Align="Right">
                        @FormatMoney(context.ClosingAccumulatedDepreciation)
                    </MudTd>

                    <MudTd DataLabel="@Localizer["Fa1044.Col_Remaining"]" Align="Right">
                        @FormatMoney(context.ClosingRemainingValue)
                    </MudTd>

                    <MudTd DataLabel="@Localizer["Fadc1045.Col_DebitAccount"]">
                        <MudTextField T="string"
                                      @bind-Value="context.ExpenseAccount"
                                      Disabled="@(!context.CanSave)"
                                      MaxLength="20"
                                      Margin="Margin.Dense" />
                    </MudTd>

                    <MudTd DataLabel="@Localizer["Fadc1045.Col_CreditAccount"]">
                        <MudTextField T="string"
                                      @bind-Value="context.DepreciationAccount"
                                      Disabled="@(!context.CanSave)"
                                      MaxLength="20"
                                      Margin="Margin.Dense" />
                    </MudTd>

                    <MudTd DataLabel="@Localizer["Fa1044.Status"]">
                        <MudText Typo="Typo.caption"
                                 Color="@(GetStatusColor(context))">
                            @GetStatusText(context)
                        </MudText>

                        @if (!string.IsNullOrWhiteSpace(context.Message))
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                @context.Message
                            </MudText>
                        }
                    </MudTd>
                </RowTemplate>

                <NoRecordsContent>
                    <MudText Class="pa-4">
                        @Localizer["Fadc1045.NoRecords"]
                    </MudText>
                </NoRecordsContent>

                <PagerContent>
                    <MudTablePager PageSizeOptions="@(new int[] { 20, 50, 100 })" />
                </PagerContent>
            </MudTable>
        </MudPaper>
</MudStack>

<style>
    .summary-box {
        min-height: 78px;
        background: var(--mud-palette-background-grey);
    }
</style>

@code {
    // Màn hình khấu hao dùng dữ liệu TSCĐ chung toàn hệ thống.
    // Guid.Empty chỉ giữ để tương thích chữ ký service hiện tại.
    private static readonly Guid GlobalCompanyId = Guid.Empty;

    private string _userName = "system";
    private bool _busy;

    private int _fiscalYear = DateTime.Today.Year;
    private int _fiscalPeriod = DateTime.Today.Month;
    private bool _prorateByDay = true;
    private string? _keyword;
    private string? _departmentFilter;

    private List<FixedAssetDepreciationRow> _rows = [];

    private IEnumerable<FixedAssetDepreciationRow> FilteredRows
    {
        get
        {
            IEnumerable<FixedAssetDepreciationRow> query = _rows;

            var keyword = _keyword?.Trim();
            if (!string.IsNullOrWhiteSpace(keyword))
            {
                query = query.Where(x =>
                    x.AssetCode.Contains(
                        keyword,
                        StringComparison.OrdinalIgnoreCase) ||
                    x.AssetName.Contains(
                        keyword,
                        StringComparison.OrdinalIgnoreCase));
            }

            var department = _departmentFilter?.Trim();
            if (!string.IsNullOrWhiteSpace(department))
            {
                query = query.Where(x =>
                    x.DepartmentCode?.Contains(
                        department,
                        StringComparison.OrdinalIgnoreCase) ?? false);
            }

            return query;
        }
    }

    private int VisibleRowCount => FilteredRows.Count();

    private int SelectedSavableCount =>
        _rows.Count(x => x.Selected && x.CanSave);

    private int SelectedDraftCount =>
        _rows.Count(x => x.Selected && x.IsSavedDraft && !x.IsPosted);

    private decimal SelectedOriginalCost =>
        _rows
            .Where(x => x.Selected && x.CanSave)
            .Sum(x => x.OriginalCost);

    private decimal SelectedDepreciationAmount =>
        _rows
            .Where(x => x.Selected && x.CanSave)
            .Sum(x => x.DepreciationAmount);

    private bool AllSelectableSelected
    {
        get
        {
            var selectable = FilteredRows
                .Where(x => x.CanSave)
                .ToList();

            return selectable.Count > 0 &&
                   selectable.All(x => x.Selected);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthenticationStateProvider
            .GetAuthenticationStateAsync();

        _userName = state.User.Identity?.Name ?? "system";

        await CalculateAsync();
    }

    private async Task CalculateAsync()
    {
        if (_busy)
            return;

        _busy = true;

        try
        {
            _rows = (await DepreciationService.CalculateAsync(
                GlobalCompanyId,
                _fiscalYear,
                _fiscalPeriod,
                _prorateByDay)).ToList();

            if (_rows.Count == 0)
            {
                Snackbar.Add(
                    Localizer["Fadc1045.NoEligibleAssets"],
                    MudBlazor.Severity.Info);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(
                string.Format(Localizer["Error_Message"], ex.Message),
                MudBlazor.Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SaveDraftAsync()
    {
        if (_busy)
            return;

        var selectedRows = _rows
            .Where(x => x.Selected && x.CanSave)
            .ToList();

        if (selectedRows.Count == 0)
        {
            Snackbar.Add(
                Localizer["Fadc1045.NoSelectedSave"],
                MudBlazor.Severity.Warning);
            return;
        }

        var invalidAccountRow = selectedRows.FirstOrDefault(x =>
            string.IsNullOrWhiteSpace(x.ExpenseAccount) ||
            string.IsNullOrWhiteSpace(x.DepreciationAccount));

        if (invalidAccountRow is not null)
        {
            Snackbar.Add(
                string.Format(
                    Localizer["Fadc1045.MissingAccounts"],
                    invalidAccountRow.AssetCode),
                MudBlazor.Severity.Warning);
            return;
        }

        _busy = true;

        try
        {
            var saved = await DepreciationService.SaveDraftAsync(
                GlobalCompanyId,
                _fiscalYear,
                _fiscalPeriod,
                _prorateByDay,
                selectedRows,
                _userName);

            Snackbar.Add(
                string.Format(
                    Localizer["Fadc1045.SaveDraftSuccess"],
                    saved,
                    _fiscalPeriod,
                    _fiscalYear),
                MudBlazor.Severity.Success);

            _rows = (await DepreciationService.CalculateAsync(
                GlobalCompanyId,
                _fiscalYear,
                _fiscalPeriod,
                _prorateByDay)).ToList();
        }
        catch (Exception ex)
        {
            Snackbar.Add(
                string.Format(Localizer["Error_Message"], ex.Message),
                MudBlazor.Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task PostDraftAsync()
    {
        if (_busy)
            return;

        var selectedDrafts = _rows
            .Where(x => x.Selected && x.IsSavedDraft && !x.IsPosted)
            .ToList();

        if (selectedDrafts.Count == 0)
        {
            Snackbar.Add(
                Localizer["Fadc1045.NoSelectedPost"],
                MudBlazor.Severity.Warning);
            return;
        }

        var totalAmount = selectedDrafts.Sum(x => x.DepreciationAmount);

        var confirmed = await DialogService.ShowMessageBox(
            Localizer["Fadc1045.PostDialogTitle"],
            string.Format(
                Localizer["Fadc1045.PostDialogMessage"],
                selectedDrafts.Count,
                _fiscalPeriod,
                _fiscalYear,
                FormatMoney(totalAmount)),
            yesText: Localizer["Fadc1045.Post"],
            cancelText: Localizer["Fa1044.Cancel"]);

        if (confirmed != true)
            return;

        _busy = true;

        try
        {
            var result = await DepreciationService.PostDraftAsync(
                GlobalCompanyId,
                _fiscalYear,
                _fiscalPeriod,
                selectedDrafts
                    .Select(x => x.FixedAssetId)
                    .ToList(),
                _userName);

            Snackbar.Add(
                string.Format(
                    Localizer["Fadc1045.PostSuccess"],
                    result.VoucherNo,
                    result.PostedAssetCount,
                    result.LedgerLineCount,
                    FormatMoney(result.TotalAmount)),
                MudBlazor.Severity.Success);

            _rows = (await DepreciationService.CalculateAsync(
                GlobalCompanyId,
                _fiscalYear,
                _fiscalPeriod,
                _prorateByDay)).ToList();
        }
        catch (Exception ex)
        {
            Snackbar.Add(
                string.Format(Localizer["Fadc1045.PostFailed"], ex.Message),
                MudBlazor.Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task DeleteDraftAsync()
    {
        if (_busy)
            return;

        var selectedDrafts = _rows
            .Where(x => x.Selected && x.IsSavedDraft && !x.IsPosted)
            .ToList();

        if (selectedDrafts.Count == 0)
        {
            Snackbar.Add(
                Localizer["Fadc1045.NoSelectedDelete"],
                MudBlazor.Severity.Warning);
            return;
        }

        var confirmed = await DialogService.ShowMessageBox(
            Localizer["Fadc1045.DeleteDialogTitle"],
            string.Format(
                Localizer["Fadc1045.DeleteDialogMessage"],
                selectedDrafts.Count,
                _fiscalPeriod,
                _fiscalYear),
            yesText: Localizer["Fa1044.DeleteYes"],
            cancelText: Localizer["Fa1044.Cancel"]);

        if (confirmed != true)
            return;

        _busy = true;

        try
        {
            var deleted = await DepreciationService.DeleteDraftAsync(
                GlobalCompanyId,
                _fiscalYear,
                _fiscalPeriod,
                selectedDrafts.Select(x => x.FixedAssetId).ToList());

            Snackbar.Add(
                string.Format(Localizer["Fadc1045.DeleteSuccess"], deleted),
                MudBlazor.Severity.Success);

            _rows = (await DepreciationService.CalculateAsync(
                GlobalCompanyId,
                _fiscalYear,
                _fiscalPeriod,
                _prorateByDay)).ToList();
        }
        catch (Exception ex)
        {
            Snackbar.Add(
                string.Format(Localizer["Error_Message"], ex.Message),
                MudBlazor.Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private void ToggleAll(bool value)
    {
        foreach (var row in FilteredRows.Where(x => x.CanSave))
            row.Selected = value;
    }

    private string GetStatusText(FixedAssetDepreciationRow row)
    {
        if (row.IsPosted)
            return Localizer["Fadc1045.Status_Posted"];

        if (row.IsSavedDraft)
            return Localizer["Fadc1045.Status_Draft"];

        if (!row.CanSave)
            return Localizer["Fadc1045.Status_NotCalculated"];

        return Localizer["Fadc1045.Status_Unsaved"];
    }

    private static Color GetStatusColor(
        FixedAssetDepreciationRow row)
    {
        if (row.IsPosted)
            return Color.Success;

        if (row.IsSavedDraft)
            return Color.Primary;

        if (!row.CanSave)
            return Color.Warning;

        return Color.Default;
    }

    private static string FormatMoney(decimal value)
        => value.ToString("N0");
}
