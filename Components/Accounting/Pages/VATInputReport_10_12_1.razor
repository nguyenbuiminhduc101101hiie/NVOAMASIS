@page "/accounting/tax/vat-input"
@page "/VATInputReport"
@using Microsoft.EntityFrameworkCore
@using MudBlazor
@using NVOAMASIS.Data
@using NVOAMASIS.Models
@using NVOAMASIS.Resources
@attribute [Authorize]
@inject SharedServices ssv
@inject AccountService asv
@inject IDbContextFactory<AppDbContext> DbFactory
@inject ISnackbar Snackbar

<PageTitle>10.12.1 VAT Input (1331)</PageTitle>

<div class="product-price-page vat-input-page">
    <PpScreenHeader Title="10.12.1 VAT Input (1331)" Subtitle="Báo cáo thuế GTGT đầu vào">
        <Toolbar>
            <MudStack Row="true" Spacing="1" Class="flex-wrap">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Search" OnClick="LoadAsync" Disabled="_busy">Load</MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Info" Size="Size.Small" StartIcon="@Icons.Material.Filled.Refresh" OnClick="ResetFilterAsync" Disabled="_busy">Reset</MudButton>
            </MudStack>
        </Toolbar>
    </PpScreenHeader>

    <MudPaper Class="product-price-card pa-3 mb-2" Elevation="0">
        <MudGrid Spacing="2" AlignItems="Center">
            <MudItem xs="12" sm="2">
                <MudDatePicker Label="Từ ngày" @bind-Date="_fromDate" Variant="Variant.Outlined" Margin="Margin.Dense" DateFormat="dd/MM/yyyy" />
            </MudItem>
            <MudItem xs="12" sm="2">
                <MudDatePicker Label="Đến ngày" @bind-Date="_toDate" Variant="Variant.Outlined" Margin="Margin.Dense" DateFormat="dd/MM/yyyy" />
            </MudItem>
            <MudItem xs="6" sm="1">
                <MudNumericField T="int?" Label="Year" @bind-Value="_fiscalYear" Variant="Variant.Outlined" Margin="Margin.Dense" Min="2000" Max="2100" />
            </MudItem>
            <MudItem xs="6" sm="1">
                <MudNumericField T="int?" Label="Month" @bind-Value="_periodMonth" Variant="Variant.Outlined" Margin="Margin.Dense" Min="1" Max="12" />
            </MudItem>
            <MudItem xs="12" sm="1">
                <MudSelect T="string" Label="Book" @bind-Value="_book" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                    <MudSelectItem T="string" Value="@("TAX")">TAX</MudSelectItem>
                    <MudSelectItem T="string" Value="@("MGMT")">MGMT</MudSelectItem>
                    <MudSelectItem T="string" Value="@("ALL")">ALL</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="2">
                <MudSelect T="string" Label="VAT Account" @bind-Value="_vatAccount" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                    <MudSelectItem T="string" Value="@("1331")">1331</MudSelectItem>
                    <MudSelectItem T="string" Value="@("1332")">1332</MudSelectItem>
                    <MudSelectItem T="string" Value="@("133")">133*</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="3">
                <MudTextField @bind-Value="_search" Label="Search" Placeholder="Voucher, khách hàng, hóa đơn, diễn giải..." Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" Clearable="true" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" />
            </MudItem>
        </MudGrid>
    </MudPaper>

    <MudPaper Class="product-price-card pa-2 mb-2" Elevation="0">
        <MudGrid Spacing="2">
            <MudItem xs="12" sm="3"><MudPaper Class="pa-2 text-center vat-stat" Elevation="0" Outlined="true"><MudText Typo="Typo.caption">VAT Input Debit</MudText><MudText Typo="Typo.subtitle1" Class="fw-bold">@VisibleItems.Sum(x => x.VatDebit).ToString("N0")</MudText></MudPaper></MudItem>
            <MudItem xs="12" sm="3"><MudPaper Class="pa-2 text-center vat-stat" Elevation="0" Outlined="true"><MudText Typo="Typo.caption">VAT Input Credit</MudText><MudText Typo="Typo.subtitle1" Class="fw-bold">@VisibleItems.Sum(x => x.VatCredit).ToString("N0")</MudText></MudPaper></MudItem>
            <MudItem xs="12" sm="3"><MudPaper Class="pa-2 text-center vat-stat" Elevation="0" Outlined="true"><MudText Typo="Typo.caption">Net VAT</MudText><MudText Typo="Typo.subtitle1" Class="fw-bold" Color="Color.Success">@((VisibleItems.Sum(x => x.VatDebit) - VisibleItems.Sum(x => x.VatCredit)).ToString("N0"))</MudText></MudPaper></MudItem>
            <MudItem xs="12" sm="3"><MudPaper Class="pa-2 text-center vat-stat" Elevation="0" Outlined="true"><MudText Typo="Typo.caption">Lines</MudText><MudText Typo="Typo.subtitle1" Class="fw-bold">@VisibleItems.Count().ToString("N0")</MudText></MudPaper></MudItem>
        </MudGrid>
    </MudPaper>

    <MudPaper Class="product-price-card pa-2" Elevation="0">
        <MudDataGrid @key="_gridKey" T="VatInputRow" Items="VisibleItems" Dense="true" Striped="true" Hover="true" Bordered="true"
                     Filterable="true" FilterMode="@DataGridFilterMode.ColumnFilterRow" ColumnResizeMode="ResizeMode.Column"
                     FixedHeader="true" Height="calc(100vh - 340px)" Class="vat-input-grid" Loading="_busy">
            <Columns>
                <PropertyColumn Property="x => x.PostingDate" Title="Ngày HT" Format="dd/MM/yyyy" />
                <PropertyColumn Property="x => x.VoucherNo" Title="Số chứng từ" />
                <TemplateColumn Title="Voucher" Filterable="false" Sortable="false">
                    <CellTemplate>
                        <MudButton Size="Size.Small"
                                   Variant="Variant.Outlined"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.OpenInNew"
                                   OnClick="@(() => OpenVoucher(context.Item))">
                            Xem
                        </MudButton>
                    </CellTemplate>
                </TemplateColumn>
                <PropertyColumn Property="x => x.VoucherDate" Title="Ngày CT" Format="dd/MM/yyyy" />
                <PropertyColumn Property="x => x.AccountCode" Title="TK VAT" />
                <PropertyColumn Property="x => x.SupplierCustomerName" Title="Nhà cung cấp / Đối tượng" />
                <PropertyColumn Property="x => x.InvoiceNo" Title="Số hóa đơn" />
                <PropertyColumn Property="x => x.InvoiceDate" Title="Ngày hóa đơn" Format="dd/MM/yyyy" />
                <PropertyColumn Property="x => x.Description" Title="Diễn giải" />
                <PropertyColumn Property="x => x.VatDebit" Title="VAT Nợ" Format="N0" CellClass="text-end fw-bold" HeaderClass="text-end" />
                <PropertyColumn Property="x => x.VatCredit" Title="VAT Có" Format="N0" CellClass="text-end fw-bold" HeaderClass="text-end" />
                <PropertyColumn Property="x => x.CurrencyCode" Title="Tiền tệ" />
                <PropertyColumn Property="x => x.ExchangeRate" Title="Tỷ giá" Format="N2" CellClass="text-end" HeaderClass="text-end" />
                <PropertyColumn Property="x => x.Book" Title="Book" />
                <PropertyColumn Property="x => x.SourceName" Title="Nguồn" />
                <PropertyColumn Property="x => x.CreatedBy" Title="Người tạo" />
            </Columns>
            <PagerContent>
                <MudDataGridPager T="VatInputRow" PageSizeOptions="new int[] { 25, 50, 100, 200 }" />
            </PagerContent>
        </MudDataGrid>
    </MudPaper>
</div>

@code {
    private const string PermissionMenuName = "GeneralLedgerEntries";
    private bool _busy;
    private string _usr = string.Empty;
    private int _gridKey;
    private DateTime? _fromDate = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
    private DateTime? _toDate = DateTime.Today;
    private int? _fiscalYear = DateTime.Today.Year;
    private int? _periodMonth = DateTime.Today.Month;
    private string _book = "TAX";
    private string _vatAccount = "1331";
    private string _search = string.Empty;
    private List<VatInputRow> _rows = new();

    [Parameter] public EventCallback<(string Key, string Title, RenderFragment Content)> OnTabRequest { get; set; }

    private IEnumerable<VatInputRow> VisibleItems => _rows.Where(MatchesSearch);

    protected override async Task OnInitializedAsync()
    {
        var auth = await asv.GetAuth();
        _usr = auth.User.Identity?.Name ?? string.Empty;
        await LoadAsync();
    }

    private async Task ResetFilterAsync()
    {
        _fromDate = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
        _toDate = DateTime.Today;
        _fiscalYear = DateTime.Today.Year;
        _periodMonth = DateTime.Today.Month;
        _book = "TAX";
        _vatAccount = "1331";
        _search = string.Empty;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (!await ssv.CheckPermission(_usr, "View", PermissionMenuName))
        {
            Snackbar.Add("Bạn không có quyền xem báo cáo thuế.", MudBlazor.Severity.Warning);
            _rows.Clear();
            return;
        }

        try
        {
            _busy = true;
            await using var db = await DbFactory.CreateDbContextAsync();

            var query = db.GeneralLedgerEntries.AsNoTracking().AsQueryable();

            if (_fromDate.HasValue) query = query.Where(x => x.PostingDate >= _fromDate.Value.Date);
            if (_toDate.HasValue) query = query.Where(x => x.PostingDate <= _toDate.Value.Date);
            if (_fiscalYear.HasValue) query = query.Where(x => x.FiscalYear == _fiscalYear.Value);
            if (_periodMonth.HasValue) query = query.Where(x => x.FiscalPeriod == _periodMonth.Value);

            if (_book == "TAX") query = query.Where(x => x.IsTaxBook == true);
            if (_book == "MGMT") query = query.Where(x => x.IsManagementBook == true);

            if (_vatAccount == "133")
                query = query.Where(x => x.AccountCode.StartsWith("133"));
            else
                query = query.Where(x => x.AccountCode == _vatAccount);

            var data = await query.OrderBy(x => x.PostingDate).ThenBy(x => x.VoucherNo).ThenBy(x => x.CreatedAt).Take(5000).ToListAsync();

            var customerIds = data.Where(x => x.CustomerId.HasValue && x.CustomerId.Value != Guid.Empty).Select(x => x.CustomerId!.Value).Distinct().ToHashSet();
            var customerMap = new Dictionary<Guid, string>();
            if (customerIds.Count > 0)
            {
                var customers = await db.Customer.AsNoTracking()
                    .Where(c => customerIds.Contains(c.Customer_ID))
                    .Select(c => new { c.Customer_ID, c.Customer_Code, c.COMPANY })
                    .ToListAsync();

                customerMap = customers.GroupBy(x => x.Customer_ID).ToDictionary(
                    g => g.Key,
                    g =>
                    {
                        var c = g.First();
                        return string.IsNullOrWhiteSpace(c.Customer_Code) ? (c.COMPANY ?? string.Empty) : $"{c.Customer_Code} - {c.COMPANY}";
                    });
            }

            var sourceMap = await LoadSourceMapAsync(db, data);

            _rows = data.Select(x => new VatInputRow
            {
                Id = x.Id,
                VoucherId = x.VoucherId,
                PostingDate = x.PostingDate,
                VoucherNo = x.VoucherNo ?? string.Empty,
                VoucherDate = x.VoucherDate,
                AccountCode = x.AccountCode ?? string.Empty,
                SupplierCustomerName = x.CustomerId.HasValue && customerMap.TryGetValue(x.CustomerId.Value, out var customerName) ? customerName : string.Empty,
                // InvoiceNo = x.InvoiceNo ?? string.Empty,
                // InvoiceDate = x.InvoiceDate,
                Description = x.Description ?? string.Empty,
                VatDebit = x.Debit,
                VatCredit = x.Credit,
                CurrencyCode = x.CurrencyCode ?? string.Empty,
                ExchangeRate = x.ExchangeRate,
                Book = x.IsTaxBook == true && x.IsManagementBook == true ? "TAX/MGMT" : x.IsTaxBook == true ? "TAX" : x.IsManagementBook == true ? "MGMT" : string.Empty,
                SourceName = !string.IsNullOrWhiteSpace(x.SourceId) && sourceMap.TryGetValue(x.SourceId.Trim(), out var sourceName) ? sourceName : x.SourceModule ?? string.Empty,
                CreatedBy = x.CreatedBy ?? string.Empty
            }).ToList();

            _gridKey++;
            Snackbar.Add($"Loaded {_rows.Count:N0} VAT input lines.", MudBlazor.Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, MudBlazor.Severity.Error);
        }
        finally
        {
            _busy = false;
            StateHasChanged();
        }
    }

    private async Task<Dictionary<string, string>> LoadSourceMapAsync(AppDbContext db, List<M_GeneralLedgerEntries> data)
    {
        var result = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
        var sourceIdsText = data.Where(x => !string.IsNullOrWhiteSpace(x.SourceId)).Select(x => x.SourceId!.Trim()).Distinct(StringComparer.OrdinalIgnoreCase).ToHashSet(StringComparer.OrdinalIgnoreCase);
        if (sourceIdsText.Count == 0) return result;

        var sourceVouchers = await db.AccountingVouchers.AsNoTracking()
            .Where(v => !string.IsNullOrWhiteSpace(v.SourceId) && sourceIdsText.Contains(v.SourceId))
            .Select(v => new { v.SourceId, v.VoucherNo, v.Description })
            .ToListAsync();

        foreach (var v in sourceVouchers)
        {
            if (string.IsNullOrWhiteSpace(v.SourceId)) continue;
            result[v.SourceId.Trim()] = string.IsNullOrWhiteSpace(v.Description) ? v.VoucherNo : $"{v.VoucherNo} - {v.Description}";
        }
        return result;
    }

    private async Task OpenVoucher(VatInputRow row)
    {
        if (row == null || row.VoucherId == Guid.Empty)
            return;

        if (OnTabRequest.HasDelegate)
        {
            await OnTabRequest.InvokeAsync((
                $"AccountingVouchers584_{row.VoucherId}",
                $"10.4 Chứng Từ Kế Toán - {row.VoucherNo}",
                builder =>
                {
                    builder.OpenComponent<Components.Accounting.Pages.AccountingVouchers_5_8_4_Index>(0);
                    builder.AddAttribute(1, "InitialVoucherId", row.VoucherId);
                    builder.CloseComponent();
                }
            ));
        }
        else
        {
            Snackbar.Add("Không mở được tab Voucher vì chưa truyền OnTabRequest.", MudBlazor.Severity.Warning);
        }
    }

    private bool MatchesSearch(VatInputRow x)
    {
        if (string.IsNullOrWhiteSpace(_search)) return true;
        var key = _search.Trim();
        return x.VoucherNo.Contains(key, StringComparison.OrdinalIgnoreCase)
            || x.PostingDate.ToString("dd/MM/yyyy").Contains(key, StringComparison.OrdinalIgnoreCase)
            || x.VoucherDate.ToString("dd/MM/yyyy").Contains(key, StringComparison.OrdinalIgnoreCase)
            || x.AccountCode.Contains(key, StringComparison.OrdinalIgnoreCase)
            || x.SupplierCustomerName.Contains(key, StringComparison.OrdinalIgnoreCase)
            || x.InvoiceNo.Contains(key, StringComparison.OrdinalIgnoreCase)
            || (x.InvoiceDate?.ToString("dd/MM/yyyy").Contains(key, StringComparison.OrdinalIgnoreCase) ?? false)
            || x.Description.Contains(key, StringComparison.OrdinalIgnoreCase)
            || x.VatDebit.ToString("N0").Contains(key, StringComparison.OrdinalIgnoreCase)
            || x.VatCredit.ToString("N0").Contains(key, StringComparison.OrdinalIgnoreCase)
            || x.CurrencyCode.Contains(key, StringComparison.OrdinalIgnoreCase)
            || x.Book.Contains(key, StringComparison.OrdinalIgnoreCase)
            || x.SourceName.Contains(key, StringComparison.OrdinalIgnoreCase)
            || x.CreatedBy.Contains(key, StringComparison.OrdinalIgnoreCase);
    }

    private sealed class VatInputRow
    {
        public Guid Id { get; set; }
        public Guid VoucherId { get; set; }
        public DateTime PostingDate { get; set; }
        public string VoucherNo { get; set; } = string.Empty;
        public DateTime VoucherDate { get; set; }
        public string AccountCode { get; set; } = string.Empty;
        public string SupplierCustomerName { get; set; } = string.Empty;
        public string InvoiceNo { get; set; } = string.Empty;
        public DateTime? InvoiceDate { get; set; }
        public string Description { get; set; } = string.Empty;
        public decimal VatDebit { get; set; }
        public decimal VatCredit { get; set; }
        public string CurrencyCode { get; set; } = string.Empty;
        public decimal ExchangeRate { get; set; }
        public string Book { get; set; } = string.Empty;
        public string SourceName { get; set; } = string.Empty;
        public string CreatedBy { get; set; } = string.Empty;
    }
}

<style>
    .vat-input-page {
        background: #f4fdf7;
    }

        .vat-input-page .product-price-card {
            border: 1px solid #d1fae5;
            border-radius: 14px;
            box-shadow: 0 8px 20px rgba(22, 101, 52, 0.06);
        }

        .vat-input-page .vat-stat {
            border-radius: 10px;
            background: #f0fff4;
            border: 1px solid #bbf7d0;
        }

        .vat-input-page .vat-input-grid {
            font-size: 0.82rem;
        }

            .vat-input-page .vat-input-grid .mud-table-container {
                overflow-x: auto;
            }

            .vat-input-page .vat-input-grid .mud-table-root .mud-table {
                width: max-content !important;
                min-width: 100%;
            }

            .vat-input-page .vat-input-grid .mud-table-cell,
            .vat-input-page .vat-input-grid td,
            .vat-input-page .vat-input-grid th {
                padding: 4px 8px !important;
                white-space: nowrap;
            }
</style>
