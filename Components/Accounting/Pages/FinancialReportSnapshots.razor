    private async Task DeleteLine()
    {
        if (!CanWorkWithLines)
        {
            if (_headerSession == HeaderSessionMode.None)
                CallSnack(Localizer["FinancialReportSnapshot.SelectOrNewFirst"], MudBlazor.Severity.Warning);
            else
                CallSnack(Localizer["FinancialReportSnapshot.SaveHeaderFirstMsg"], MudBlazor.Severity.Warning);
            return;
        }

        if (!await ssv.CheckPermission(_usr, "Delete", PermissionMenuName))
        {
            CallSnack(Localizer["FinancialReportSnapshot.NoAccessDelete"], MudBlazor.Severity.Warning);
            return;
        }

        var line = await Db.FinancialReportSnapshotLines
            .FirstOrDefaultAsync(x => x.Id == _line.Id);

        if (line == null)
        {
            CallSnack(Localizer["FinancialReportSnapshot.NoLineSelected"], MudBlazor.Severity.Warning);
            return;
        }

        Db.FinancialReportSnapshotLines.Remove(line);
        await Db.SaveChangesAsync();

        await LoadLines(_snapshot.Id);
        await SaveSnapshotTotalsAsync();

        CallSnack(Localizer["Common.DeletedSuccessfully"], MudBlazor.Severity.Success);
        NewLine();
    }

    private void RecalculateHeaderFromLines()
    {
        var reportCode = NormalizeReportCode(_snapshot.ReportCode);

        if (reportCode == "BALANCE_SHEET"
            || reportCode == "BALANCE_SHEET_INTERIM_FULL"
            || reportCode == "BALANCE_SHEET_INTERIM_SUMMARY")
        {
            _snapshot.TotalAssets = _lines.FirstOrDefault(x => x.LineCode == "270")?.Amount ?? 0;
            _snapshot.TotalLiabilities = _lines.FirstOrDefault(x => x.LineCode == "300")?.Amount ?? 0;
            _snapshot.TotalEquity = _lines.FirstOrDefault(x => x.LineCode == "400")?.Amount ?? 0;
            _snapshot.TotalSource = _lines.FirstOrDefault(x => x.LineCode == "440")?.Amount ?? 0;
            _snapshot.Difference = _snapshot.TotalAssets - _snapshot.TotalSource;
            return;
        }

        if (reportCode == "BALANCE_SHEET_NON_GOING_CONCERN")
        {
            _snapshot.TotalAssets = _lines.FirstOrDefault(x => x.LineCode == "KLT_200")?.Amount ?? 0;       // Tổng cộng tài sản
            _snapshot.TotalLiabilities = _lines.FirstOrDefault(x => x.LineCode == "KLT_390")?.Amount ?? 0;  // Tổng cộng nợ phải trả
            _snapshot.TotalEquity = _lines.FirstOrDefault(x => x.LineCode == "KLT_490")?.Amount ?? 0;       // Tổng cộng vốn chủ sở hữu
            _snapshot.TotalSource = _lines.FirstOrDefault(x => x.LineCode == "KLT_500")?.Amount ?? 0;       // Tổng cộng nguồn vốn
            _snapshot.Difference = _lines.FirstOrDefault(x => x.LineCode == "KLT_999")?.Amount
                ?? (_snapshot.TotalAssets - _snapshot.TotalSource);
            return;
        }

        if (reportCode == "INCOME_STATEMENT" || reportCode == "INCOME_STATEMENT_INTERIM_FULL" || reportCode == "INCOME_STATEMENT_INTERIM_SUMMARY")
        {
            _snapshot.TotalAssets = _lines.FirstOrDefault(x => x.LineCode == "B02_10")?.Amount ?? 0;       // Doanh thu thuần
            _snapshot.TotalLiabilities = _lines.FirstOrDefault(x => x.LineCode == "B02_11")?.Amount ?? 0;  // Giá vốn
            _snapshot.TotalEquity = _lines.FirstOrDefault(x => x.LineCode == "B02_60")?.Amount ?? 0;       // LNST
            _snapshot.TotalSource = _lines.FirstOrDefault(x => x.LineCode == "B02_50")?.Amount ?? 0;       // LNTT
            _snapshot.Difference = _snapshot.TotalEquity;
            return;
        }

        if (reportCode == "CASH_FLOW_DIRECT" || reportCode == "CASH_FLOW_INTERIM_FULL_DIRECT" || reportCode == "CASH_FLOW_INTERIM_SUMMARY_DIRECT")
        {
            _snapshot.TotalAssets = _lines.FirstOrDefault(x => x.LineCode == "B03D_20")?.Amount ?? 0;       // LCTT từ HĐKD
            _snapshot.TotalLiabilities = _lines.FirstOrDefault(x => x.LineCode == "B03D_30")?.Amount ?? 0;  // LCTT từ HĐĐT
            _snapshot.TotalEquity = _lines.FirstOrDefault(x => x.LineCode == "B03D_40")?.Amount ?? 0;       // LCTT từ HĐTC
            _snapshot.TotalSource = _lines.FirstOrDefault(x => x.LineCode == "B03D_50")?.Amount ?? 0;       // LCTT thuần trong kỳ

            var beginCash = _lines.FirstOrDefault(x => x.LineCode == "B03D_60")?.Amount ?? 0;
            var fxEffect = _lines.FirstOrDefault(x => x.LineCode == "B03D_61")?.Amount ?? 0;
            var endCash = _lines.FirstOrDefault(x => x.LineCode == "B03D_70")?.Amount ?? 0;

            _snapshot.Difference = endCash - (beginCash + _snapshot.TotalSource + fxEffect);
            return;
        }

        if (reportCode == "CASH_FLOW_INDIRECT" || reportCode == "CASH_FLOW_INTERIM_FULL_INDIRECT" || reportCode == "CASH_FLOW_INTERIM_SUMMARY_INDIRECT")
        {
            _snapshot.TotalAssets = _lines.FirstOrDefault(x => x.LineCode == "B03I_20")?.Amount ?? 0;       // LCTT từ HĐKD
            _snapshot.TotalLiabilities = _lines.FirstOrDefault(x => x.LineCode == "B03I_30")?.Amount ?? 0;  // LCTT từ HĐĐT
            _snapshot.TotalEquity = _lines.FirstOrDefault(x => x.LineCode == "B03I_40")?.Amount ?? 0;       // LCTT từ HĐTC
            _snapshot.TotalSource = _lines.FirstOrDefault(x => x.LineCode == "B03I_50")?.Amount ?? 0;       // LCTT thuần trong kỳ

            var beginCash = _lines.FirstOrDefault(x => x.LineCode == "B03I_60")?.Amount ?? 0;
            var fxEffect = _lines.FirstOrDefault(x => x.LineCode == "B03I_61")?.Amount ?? 0;
            var endCash = _lines.FirstOrDefault(x => x.LineCode == "B03I_70")?.Amount ?? 0;

            _snapshot.Difference = endCash - (beginCash + _snapshot.TotalSource + fxEffect);
            return;
        }

        if (reportCode == "NOTES_TO_FINANCIAL_STATEMENTS" || reportCode == "NOTES_INTERIM_SELECTED")
        {
            var cash = _lines.FirstOrDefault(x => x.LineCode == "B09_111")?.Amount ?? 0;
            var shortTermInvestments = _lines.FirstOrDefault(x => x.LineCode == "B09_121")?.Amount ?? 0;
            var receivables = _lines.FirstOrDefault(x => x.LineCode == "B09_131")?.Amount ?? 0;
            var inventory = _lines.FirstOrDefault(x => x.LineCode == "B09_141")?.Amount ?? 0;
            var prepaid = _lines.FirstOrDefault(x => x.LineCode == "B09_151")?.Amount ?? 0;
            var fixedAssetsNet = _lines.FirstOrDefault(x => x.LineCode == "B09_164")?.Amount ?? 0;

            _snapshot.TotalAssets = cash + shortTermInvestments + receivables + inventory + prepaid + fixedAssetsNet;

            var payables = _lines.FirstOrDefault(x => x.LineCode == "B09_171")?.Amount ?? 0;
            var taxPayable = _lines.FirstOrDefault(x => x.LineCode == "B09_181")?.Amount ?? 0;
            var borrowings = _lines.FirstOrDefault(x => x.LineCode == "B09_191")?.Amount ?? 0;

            _snapshot.TotalLiabilities = payables + taxPayable + borrowings;
            _snapshot.TotalEquity = _lines.FirstOrDefault(x => x.LineCode == "B09_201")?.Amount ?? 0;
            _snapshot.TotalSource = _snapshot.TotalLiabilities + _snapshot.TotalEquity;
            _snapshot.Difference = _snapshot.TotalAssets - _snapshot.TotalSource;
            return;
        }


        if (reportCode == "NOTES_TO_FINANCIAL_STATEMENTS_NGC")
        {
            _snapshot.TotalAssets = _lines.FirstOrDefault(x => x.LineCode == "NGC_B09_200")?.Amount ?? 0;       // Tổng tài sản theo cơ sở không hoạt động liên tục
            _snapshot.TotalLiabilities = _lines.FirstOrDefault(x => x.LineCode == "NGC_B09_390")?.Amount ?? 0;  // Tổng nợ phải trả theo cơ sở không hoạt động liên tục
            _snapshot.TotalEquity = _lines.FirstOrDefault(x => x.LineCode == "NGC_B09_490")?.Amount ?? 0;       // Tổng vốn chủ sở hữu
            _snapshot.TotalSource = _lines.FirstOrDefault(x => x.LineCode == "NGC_B09_500")?.Amount ?? 0;       // Tổng nguồn vốn
            _snapshot.Difference = _lines.FirstOrDefault(x => x.LineCode == "NGC_B09_999")?.Amount
                ?? (_snapshot.TotalAssets - _snapshot.TotalSource);
            return;
        }

        _snapshot.TotalAssets = 0;
        _snapshot.TotalLiabilities = 0;
        _snapshot.TotalEquity = 0;
        _snapshot.TotalSource = 0;
        _snapshot.Difference = 0;
    }

    private string SnapshotRowClass(FinancialReportSnapshot row, int _) =>
        CanSaveHeader && row.Id == _snapshot.Id ? "selected" : string.Empty;

    private string LineRowClass(FinancialReportSnapshotLine row, int _) =>
        row.Id == _line.Id ? "selected" : string.Empty;

    private static Color GetStatusColor(string? status) => status switch
    {
        "FINAL" => Color.Success,
        "LOCKED" => Color.Warning,
        _ => Color.Default
    };

    private string GetLineStyle(FinancialReportSnapshotLine row)
    {
        var padding = row.LevelNo * 20;
        var fontWeight = row.IsBold ? "font-weight:700;" : "";
        return $"{fontWeight} padding-left:{padding}px;";
    }

    private void CallSnack(string message, MudBlazor.Severity severity)
    {
        Snackbar.Configuration.SnackbarVariant = Variant.Filled;
        Snackbar.Configuration.MaxDisplayedSnackbars = 3;
        Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopRight;
        Snackbar.Add(message, severity);
    }
}
