@using System.Globalization
@inject ISnackbar Snackbar
@inject AccountService asv
@inject TrainScheduleServices trainsv
@inject IStringLocalizer<SharedResource> Localizer
@inject SharedServices ssv
@inject LocalChargesServices lcsv
@inject SupportServices supsv
@inject LenhDieuXeServices ldxsv
@inject TKHQ_Services tkhqsv
@inject GlobalServices gsv
@inject Bieugianangha_Services BGRRsv
@inject IJSRuntime JSRuntime

<MudDialog>
    <DialogContent>
        <MudContainer Class="pa-3">
            <MudCard Elevation="0" Class="pa-2">
                <MudForm Model="@_BieuGiaKTCL_Detail" @ref="@form">
                    <MudCardContent Class="pa-3">
                        <MudGrid Spacing="1">
                            <MudItem xs="12">
                                <MudGrid Spacing="1">
                                    <MudItem xs="12" sm="1">
                                        <MudButton Style="background-color: #007BFF; color: white;" Size="Size.Small" Color="Color.Primary"
                                            Disabled="@(Status == "edit")"
                                            OnClick="() => Get_BGNHNo()">>>></MudButton>
                                    </MudItem>
                                    <MudItem xs="12" sm="5">
                                        <MudTextField @bind-Value="_BieuGiaKTCL_Detail.BieuGiaKTCLNo" Disabled="true" Label="@Localizer["BieuGiaKTCLNo"]"
                                            Class="custom-label" Margin="Margin.Dense" Required="true" />
                                    </MudItem>
                                </MudGrid>
                            </MudItem>
                            <MudItem xs="12">
                                <MudGrid Spacing="1">
                                    <MudItem xs="12" sm="6">
                                        <MudSelect @bind-Value="_BieuGiaKTCL_Detail.DichVuKiemTra" Label="@Localizer["DichVuKiemTra"]" Class="custom-label" Margin="Margin.Dense">
                                            <MudSelectItem Value="@("Kiểm tra chất lượng hàng nhập khẩu (TT19/2019/TT-BKHCN)")">Kiểm tra chất lượng hàng nhập khẩu (TT19/2019/TT-BKHCN)</MudSelectItem>
                                            <MudSelectItem Value="@("Kiểm nghiệm thực phẩm, mỹ phẩm, dược")">Kiểm nghiệm thực phẩm, mỹ phẩm, dược</MudSelectItem>
                                            <MudSelectItem Value="@("Test CQ/COA theo yêu cầu buyer")">Test CQ/COA theo yêu cầu buyer</MudSelectItem>
                                            <MudSelectItem Value="@("Kiểm tra hàm lượng, độ ẩm, thành phần nông sản")">Kiểm tra hàm lượng, độ ẩm, thành phần nông sản</MudSelectItem>
                                        </MudSelect>
                                    </MudItem>
                                    <MudItem xs="12" sm="6">
                                        <MudDatePicker Class="custom-label" @bind-Date="_BieuGiaKTCL_Detail.NgayHieuLuc"
                                            For="@(() => _BieuGiaKTCL_Detail.NgayHieuLuc)"
                                            Label="@Localizer["NgayHieuLuc"]"
                                            Margin="Margin.Dense"
                                            DateFormat="dd/MM/yyyy"
                                            Required="true" />
                                    </MudItem>
                                    <MudItem xs="12" sm="6">
                                        <MudSelect @bind-Value="_BieuGiaKTCL_Detail.TrangThai" Label="@Localizer["status"]" Class="custom-label" Margin="Margin.Dense">
                                            @foreach (var item in trangthais)
                                            {
                                                <MudSelectItem Value="@item">@item</MudSelectItem>
                                            }
                                        </MudSelect>
                                    </MudItem>
                                    <MudItem xs="12" sm="6">
                                        <MudSelect @bind-Value="_BieuGiaKTCL_Detail.CoQuanThucHien" Label="@Localizer["CoQuanThucHien"]" Class="custom-label" Margin="Margin.Dense">
                                            <MudSelectItem Value="@("Trung tâm kiểm định, phòng thí nghiệm đạt chuẩn (QUATEST 1, 2, 3...)")">Trung tâm kiểm định, phòng thí nghiệm đạt chuẩn (QUATEST 1, 2, 3...)</MudSelectItem>
                                            <MudSelectItem Value="@("Viện kiểm nghiệm, đơn vị được cấp phép")">Viện kiểm nghiệm, đơn vị được cấp phép</MudSelectItem>
                                            <MudSelectItem Value="@("Trung tâm giám định như SGS, Intertek, Bureau Veritas...")">Trung tâm giám định như SGS, Intertek, Bureau Veritas...</MudSelectItem>
                                            <MudSelectItem Value="@("Trung tâm phân tích thí nghiệm địa phương")">Trung tâm phân tích thí nghiệm địa phương</MudSelectItem>
                                        </MudSelect>
                                    </MudItem>
                                    <MudItem xs="12" sm="6">
                                        <MudSelect @bind-Value="_BieuGiaKTCL_Detail.LoaiHoaDon" Label="@Localizer["LoaiHoaDon"]" Class="custom-label" Margin="Margin.Dense">
                                            <MudSelectItem Value="@("Hóa đơn GTGT từ trung tâm kiểm định")">Hóa đơn GTGT từ trung tâm kiểm định</MudSelectItem>
                                            <MudSelectItem Value="@("Hóa đơn kiểm nghiệm (có chi tiết mẫu, xét nghiệm, chỉ tiêu đo)")">Hóa đơn kiểm nghiệm (có chi tiết mẫu, xét nghiệm, chỉ tiêu đo)</MudSelectItem>
                                            <MudSelectItem Value="@("Hóa đơn dịch vụ giám định quốc tế")">Hóa đơn dịch vụ giám định quốc tế</MudSelectItem>
                                            <MudSelectItem Value="@("Hóa đơn dịch vụ kiểm tra chất lượng")">Hóa đơn dịch vụ kiểm tra chất lượng</MudSelectItem>
                                        </MudSelect>
                                    </MudItem>
                                    <MudItem xs="12" sm="6">
                                        <MudTextField @bind-Value="_BieuGiaKTCL_Detail.NoiDungDichVu" Label="@Localizer["NoiDungDichVu"]" Class="custom-label" Margin="Margin.Dense" />
                                    </MudItem>
                                    <MudItem xs="12" sm="6">
                                        <MudSelect @bind-Value="_BieuGiaKTCL_Detail.LoaiMucPhi" Label="@Localizer["LoaiMucPhi"]" Class="custom-label" Margin="Margin.Dense">
                                            <MudSelectItem Value="@("Phí lấy mẫu")">Phí lấy mẫu</MudSelectItem>
                                            <MudSelectItem Value="@("Phí kiểm định / phân tích / thử nghiệm")">Phí kiểm định / phân tích / thử nghiệm</MudSelectItem>
                                            <MudSelectItem Value="@("Phí cấp chứng nhận / cấp kết quả")">Phí cấp chứng nhận / cấp kết quả</MudSelectItem>
                                            <MudSelectItem Value="@("Phí xử lý mẫu / chuẩn bị mẫu")">Phí xử lý mẫu / chuẩn bị mẫu</MudSelectItem>
                                            <MudSelectItem Value="@("Phí lưu mẫu")">Phí lưu mẫu</MudSelectItem>
                                            <MudSelectItem Value="@("Phí test nhanh / kiểm tra gấp")">Phí test nhanh / kiểm tra gấp</MudSelectItem>
                                            <MudSelectItem Value="@("Phí dịch vụ hành chính")">Phí dịch vụ hành chính</MudSelectItem>
                                            <MudSelectItem Value="@("Phí giám định tại chỗ")">Phí giám định tại chỗ</MudSelectItem>
                                            <MudSelectItem Value="@("Phí dịch vụ tư vấn")">Phí dịch vụ tư vấn</MudSelectItem>
                                        </MudSelect>
                                    </MudItem>
                                    <MudItem xs="12" sm="6" md="3">
                                        <MudNumericField @bind-Value="_BieuGiaKTCL_Detail.SoLuong"
                                            Label="@Localizer["Quantity"]" Format="#,##0.##" Culture="@_en" T="double?" HideSpinButtons="true"
                                            Class="text-right custom-label" Margin="Margin.Dense" OnBlur="TinhTotals" />
                                    </MudItem>
                                    <MudItem xs="12" sm="6" md="3">
                                        <MudNumericField @bind-Value="_BieuGiaKTCL_Detail.DonGia"
                                            Label="@Localizer["unitprice"]" Format="#,##0.##" Culture="@_en" T="double?" HideSpinButtons="true"
                                            Class="text-right custom-label" Margin="Margin.Dense" OnBlur="TinhTotals" />
                                    </MudItem>
                                    <MudItem xs="12" sm="6" md="3">
                                        <MudSelect @bind-Value="_BieuGiaKTCL_Detail.TienTe" Label="@Localizer["Loaitiente"]" Class="custom-label" Margin="Margin.Dense">
                                            <MudSelectItem Value="@("VND")">VND</MudSelectItem>
                                            <MudSelectItem Value="@("USD")">USD</MudSelectItem>
                                        </MudSelect>
                                    </MudItem>
                                    <MudItem xs="12" sm="6" md="3">
                                        <MudTextField @bind-Value="_BieuGiaKTCL_Detail.DonViTinh" Label="@Localizer["unit"]" Class="custom-label" Margin="Margin.Dense" />
                                    </MudItem>
                                    <MudItem xs="12" sm="6" md="3">
                                        <MudNumericField @bind-Value="_BieuGiaKTCL_Detail.ThanhTien"
                                            Label="@Localizer["ThanhTien"]" Format="#,##0.##" Culture="@_en" T="double?" HideSpinButtons="true"
                                            Class="text-right custom-label" Margin="Margin.Dense" />
                                    </MudItem>
                                </MudGrid>
                            </MudItem>
                        </MudGrid>
                    </MudCardContent>
                </MudForm>
            </MudCard>
        </MudContainer>
    </DialogContent>
    <DialogActions>

        <MudButton OnClick="@(async () => await Submit())">Save</MudButton>
        <MudButton OnClick="Cancel">Cancel</MudButton>

    </DialogActions>
</MudDialog>



@code {
    [CascadingParameter] MudDialogInstance? MudDialog { get; set; }
    [Parameter] public Models.M_BieuGiaKTCL _BieuGiaKTCL_Detail { get; set; }

    [Parameter] public string Status { get; set; }
    MudForm form;
    List<string> trangthais = new List<string>();
    private List<Models.TrangThai> M_Trangthais = new List<Models.TrangThai>();
    public CultureInfo _en = CultureInfo.GetCultureInfo("en-US");
    private List<Terminal_> Terminals = new List<Terminal_>();
    private List<Terminal_> Terminals_Address = new List<Terminal_>();
    List<M_BieuGiaKTCL> BGRRs = new List<M_BieuGiaKTCL>();
    string UserHanding;
    private List<string> ListUser { get; set; } = new List<string>();
    protected async override Task OnInitializedAsync()
    {
        if (Status == "Duplicate")
        {
            _BieuGiaKTCL_Detail.BieuGiaKTCLID = Guid.Empty;
            _BieuGiaKTCL_Detail.BieuGiaKTCLNo = "";
            _BieuGiaKTCL_Detail.Approve = false;
        }
        M_Trangthais = await supsv.GetListTrangThai();
        var tts = await supsv.GetListTrangThai();
        trangthais = tts.Where(x => x.Tieude == "BieugiaKTCL").OrderBy(x => x.Noidung).Select(x => x.Noidung).ToList();
        BGRRs = await BGRRsv.GetList_BieuGiaKTCL();
        Terminals_Address = await gsv.GetList_Terminal_add();
        Terminals = await gsv.GetList_Terminal();
        ListUser = await asv.GetList_User_handle() ?? new List<string>();

    }

    private async Task Get_BGNHNo()
    {

        int formattedYear = DateTime.Now.Year;
        int formattedMonth = DateTime.Now.Month;

        string usr = asv.GetAuth().Result.User.Identity!.Name!;
        var refno = await supsv.GetRefNoByFunc("KTCL", formattedMonth, formattedYear, usr);

        var rs = asv.GetUserDetail();
        var cn = rs.Branch;
        _BieuGiaKTCL_Detail.BieuGiaKTCLNo = cn + "BGKTCL_" + formattedYear.ToString() + formattedMonth.ToString() + refno.Value.ToString("D4");
    }

    private async Task Submit()
    {
        if ((await ssv.CheckPermission(asv.GetAuth().Result.User.Identity.Name, "Edit", "BieuGiaKTCL") || await ssv.CheckPermission(asv.GetAuth().Result.User.Identity.Name, "New", "BieuGiaKTCL")))
        {

            await form.Validate();

            if (form.IsValid)
            {

                var UserName = asv.GetAuth().Result.User.Identity!.Name!;
                _BieuGiaKTCL_Detail.Approve = true;
                _BieuGiaKTCL_Detail.Continued = true;
                _BieuGiaKTCL_Detail.DateUpdate = DateTime.Now.ToString("dd/MMM/yyyy");
                _BieuGiaKTCL_Detail.UserUpdate = UserName;
                MudDialog!.Close(_BieuGiaKTCL_Detail);

            }
        }

    }
    void Cancel() => MudDialog.Cancel();

    void CallSnackBar(string message, MudBlazor.Severity severity)
    {
        
        Snackbar.Configuration.SnackbarVariant = Variant.Filled;
        Snackbar.Configuration.MaxDisplayedSnackbars = 3;
        Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopRight;
        Snackbar.Add(message, severity);
    }
  
    // private void OnTerminalBlur(FocusEventArgs e)
    // {
    //     var company = Terminals_Address.FirstOrDefault(x => x.TermiNalName == _BieuGiaKTCL_Detail.ChiCucKiemDich);
    //     if (company != null)
    //     {
    //         _BieuGiaKTCL_Detail.DiaChiChiCuc = company.Address;
    //     }
    // }

    private async Task<IEnumerable<string>> SearchTerminal(string text)
    {
        try
        {
            if (string.IsNullOrWhiteSpace(text))
            {
                return Terminals.Where(x => !string.IsNullOrEmpty(x.TermiNalName))
               .Select(x => x.TermiNalName);
            }
            // MBL.Porname = mst_Consignee;
            return Terminals.Where(x => !string.IsNullOrEmpty(x.TermiNalName) &&
                            x.TermiNalName.Contains(text, StringComparison.OrdinalIgnoreCase))
               .Select(x => x.TermiNalName);
        }
        catch (Exception)
        {
            throw;
        }
    }
    private void TinhTotals(FocusEventArgs e)
    {
        if (_BieuGiaKTCL_Detail.SoLuong.HasValue && _BieuGiaKTCL_Detail.DonGia.HasValue)
        {
            double soluong_ = _BieuGiaKTCL_Detail.SoLuong ?? 0;
            double DonGia_ = _BieuGiaKTCL_Detail.DonGia ?? 0;
            _BieuGiaKTCL_Detail.ThanhTien = Math.Round(soluong_ * DonGia_, 2);
        }


    }
}
