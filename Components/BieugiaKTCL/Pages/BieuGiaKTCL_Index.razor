@page "/BieugiaKTCL"
@using System.Globalization
@attribute [Authorize]
@inject GlobalServices gsv
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject AccountService asv
@inject SharedServices ssv
@inject BookingService bksv
@inject IJSRuntime JSRuntime
@inject SupportServices supsv
@inject IStringLocalizer<SharedResource> Localizer
@inject LocalChargesServices lcsv
@inject Bieugianangha_Services Bgnhsv
@inject HistoryLogService HistoryLogService
@using System.Text.Json;

<style>
    .price-ui-title { font-weight: 800; color: #0f3557; }
    .price-ui-toolbar { background: #fff; border: 1px solid #e2e8f0; border-radius: 14px; padding: 10px 12px; margin: 8px 12px; }
    .price-ui-toolbar .mud-button-root { border-radius: 999px; text-transform: none; font-weight: 700; }
    .price-ui-grid { border-radius: 14px; border: 1px solid #e2e8f0 !important; overflow: hidden; }
    .price-ui-grid .mud-table-head th, .price-ui-grid .mud-table thead th { background: linear-gradient(180deg,#118ab2 0%,#0d6f91 100%) !important; color: #fff !important; font-weight: 800 !important; }
</style>


<PageTitle>@Localizer["BieugiaKTCL"] </PageTitle>
<MudText Class="pa-2 price-ui-title" Typo="Typo.h6">@Localizer["BieugiaKTCL"]</MudText>
<MudStack Row Justify="Justify.FlexStart" Class="pa-4 price-ui-toolbar">
    <MudButton HtmlTag="label"
               OnClick="Refresh"
               Size="Size.Small" Color="Color.Primary" Variant="   Variant.Filled"
               StartIcon="@Icons.Material.Filled.Refresh">
        @Localizer["reload"]
    </MudButton>
    <MudButton HtmlTag="label"
               @onclick="@((e) => OpenCreateDialog(new Models.M_BieuGiaKTCL()))"
               Size="Size.Small" Color="Color.Secondary" Variant="Variant.Filled"
               StartIcon="@Icons.Material.Filled.Add">
        @Localizer["new"]
    </MudButton>

    <MudButton HtmlTag="label"
               @onclick="@((e) => OpenEditDialog(detail))"
               Size="Size.Small" Color="Color.Info" Variant="Variant.Filled"
               StartIcon="@Icons.Material.Filled.Edit">
        @Localizer["edit"]
    </MudButton>
    <MudButton HtmlTag="label"
               @onclick="@((e) => OpenDuplicateDialog(detail))"
               Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled"
               StartIcon="@Icons.Material.Filled.CopyAll">
        @Localizer["duplicate"]
    </MudButton>
</MudStack>

<MudDataGrid T="M_BieuGiaKTCL" Items="@Listdata" Filterable="true" @ref="mudTable" Class="pa-4 price-ui-grid" Bordered="true"
             FilterMode="@DataGridFilterMode.ColumnFilterRow" Dense="true" Virtualize="true" QuickFilter="@FilterFunc1"
             FixedHeader="true" FixedFooter="true" HeaderClass="no-wrap" FooterClass="no-wrap"
             ReadOnly="false" CommittedItemChanges="@CommittedItem" RowClassFunc="@SelectedRowClassFunc"
             RowClick="@RowClicked" EditDialogOptions="@options"
             ColumnResizeMode="@(ResizeMode.Column)" Loading="_loading">
    <Columns>
        <HierarchyColumn T="M_BieuGiaKTCL" />
        <TemplateColumn CellClass="d-flex justify-end">
            <CellTemplate>

                <MudIconButton Icon="@Icons.Material.Outlined.Delete" OnClick="@(()=>DeleteItem(context.Item))" />
            </CellTemplate>
        </TemplateColumn>

        <PropertyColumn Property="x=>x.BieuGiaKTCLNo" Title="@Localizer["BieuGiaKTCLNo"]" Required="false" CellStyleFunc="_cellStyleFunc">
        </PropertyColumn>

        <PropertyColumn Property="x=>x.NgayHieuLuc" Title="@Localizer["NgayHieuLuc"]" Required="false" CellStyleFunc="_cellStyleFunc" Format="dd/MM/yyyy">
        </PropertyColumn>
        <PropertyColumn Property="x=>x.DichVuKiemTra" Title="@Localizer["DichVuKiemTra"]" Required="false" CellStyleFunc="_cellStyleFunc">
        </PropertyColumn>
        <PropertyColumn Property="x=>x.CoQuanThucHien" Title="@Localizer["CoQuanThucHien"]" Required="false" CellStyleFunc="_cellStyleFunc">
        </PropertyColumn>
              <PropertyColumn Property="x=>x.TrangThai" Title="@Localizer["status"]" Required="false" CellStyleFunc="_cellStyleFunc">
        </PropertyColumn>
        <PropertyColumn Property="x=>x.LoaiHoaDon" Title="@Localizer["LoaiHoaDon"]" Required="false" CellStyleFunc="_cellStyleFunc">
        </PropertyColumn>
        <PropertyColumn Property="x=>x.NoiDungDichVu" Title="@Localizer["NoiDungDichVu"]" Required="false" CellStyleFunc="_cellStyleFunc">
        </PropertyColumn>
        <PropertyColumn Property="x=>x.LoaiMucPhi" Title="@Localizer["LoaiMucPhi"]" Required="false" CellStyleFunc="_cellStyleFunc">
        </PropertyColumn>
        <PropertyColumn Property="x=>x.SoLuong" Title="@Localizer["Quantity"]" Required="false" Format="#,##0.##" Culture="@_en" CellStyleFunc="_cellStyleFunc" CellClass="custom-right-align">
        </PropertyColumn>

        <PropertyColumn Property="x => x.DonGia" Title="@Localizer["unitprice"]" Required="false" Format="#,##0.##" Culture="@_en" CellClass="custom-right-align">
        </PropertyColumn>
        <PropertyColumn Property="x=>x.DonViTinh" Title="@Localizer["Unit"]" Required="false" CellStyleFunc="_cellStyleFunc">
        </PropertyColumn>

        <PropertyColumn Property="x=>x.ThanhTien" Title="@Localizer["ThanhTien"]" Required="false" Format="#,##0.##" Culture="@_en" CellStyleFunc="_cellStyleFunc" CellClass="custom-right-align">
        </PropertyColumn>

        <PropertyColumn Property="x=>x.TienTe" Title="@Localizer["Loaitiente"]" Required="false" CellStyleFunc="_cellStyleFunc">
        </PropertyColumn>

        <TemplateColumn Title="@Localizer["Approve"]">
            <CellTemplate>
                <MudCheckBox @bind-Checked="context.Item.Approve" @bind-Value="context.Item.Approve" @bind-Value:after="@(()=> OnApproveCheckboxWrapper(context.Item))">
                </MudCheckBox>
            </CellTemplate>
        </TemplateColumn>
        <PropertyColumn Property="x=>x.Continued" Title="@Localizer["Continued"]" Required="false" CellStyleFunc="_cellStyleFunc">
        </PropertyColumn>
    </Columns>

    <PagerContent>
        <MudDataGridPager T="Models.M_BieuGiaKTCL" PageSizeOptions="@(new int[] { 8, 10, 20 })" />
    </PagerContent>
</MudDataGrid>

@code {
    List<M_BieuGiaKTCL> Listdata = new List<M_BieuGiaKTCL>();
    MudDataGrid<M_BieuGiaKTCL> mudTable;
    AuthUser user;
    string mailtp, mailpp;
    string usr;
    private List<string> ListUser { get; set; } = new List<string>();
    string UserHanding;
    List<string> trangthais = new List<string>();
    private List<Models.TrangThai> M_Trangthais = new List<Models.TrangThai>();
    private string searchText_pol = "";
    private string searchText_pod = "";
    private List<PortModel> filteredPorts = new List<PortModel>();
    private List<PortModel> filteredPorts_pod = new List<PortModel>();
    private List<PortModel> Ports = new List<PortModel>();
    private bool _resizeColumn;
    M_BieuGiaKTCL detail;

    private List<M_Customer> filteredCarr = new List<M_Customer>();
    private List<M_Customer> Cuss_Carr = new List<M_Customer>();
    private List<Terminal_> Terminals = new List<Terminal_>();

    public CultureInfo _en = CultureInfo.GetCultureInfo("en-US");

    protected async override Task OnInitializedAsync()
    {
        M_Trangthais = await supsv.GetListTrangThai();
        var tts = await supsv.GetListTrangThai();
        trangthais = tts.Where(x => x.Tieude == "BieugiaKTCL").OrderBy(x => x.Noidung).Select(x => x.Noidung).ToList();

        Terminals = await gsv.GetList_Terminal();
        ListUser = await asv.GetList_User_handle() ?? new List<string>();
        usr = asv.GetAuth().Result.User.Identity!.Name!;
        Cuss_Carr = await lcsv.GetList_Customer_line();
        // await Refresh();
    }



    bool _loading = false;
    async Task Refresh()
    {
        try
        {
            await Bgnhsv.UpdateTrangThai_HetHieuLuc_KTCL();
            detail = null!;
            _loading = true;
            Listdata.Clear();

            await Task.Delay(500);
            if (!await ssv.CheckPermission(usr, "View", "BieugiaKTCL"))
            {
                CallSnackBar(Localizer["NoPermission_View"], MudBlazor.Severity.Warning);
                return;
            }
            Listdata = await Bgnhsv.GetList_BieuGiaKTCL();
            StateHasChanged();
            if (Listdata.Count == 0)
            {
                CallSnackBar(Localizer["NoData"], MudBlazor.Severity.Warning);
                _loading = false;
                return;
            }
        }
        catch (Exception ex)
        {
            CallSnackBar(string.Format(Localizer["SomethingWentWrong"], ex.Message), MudBlazor.Severity.Warning);
        }
        finally
        {
            _loading = false;
        }

    }

    void CallSnackBar(string message, MudBlazor.Severity severity)
    {
        
        Snackbar.Configuration.SnackbarVariant = Variant.Filled;
        Snackbar.Configuration.MaxDisplayedSnackbars = 3;
        Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopRight;
        Snackbar.Add(message, severity);
    }
    void RowClicked(DataGridRowClickEventArgs<M_BieuGiaKTCL> args)
    {
        detail = args.Item;
    }
    private int selectedRowNumber = -1;
    private string SelectedRowClassFunc(M_BieuGiaKTCL m, int rowNumber)
    {
        if (selectedRowNumber == rowNumber)
        {
            selectedRowNumber = -1;
            return string.Empty;
        }
        else if (mudTable.SelectedItem != null && mudTable.SelectedItem.Equals(m))
        {
            selectedRowNumber = rowNumber;
            return "selected";
        }
        else
        {
            return string.Empty;
        }
    }

    async Task CommittedItem(M_BieuGiaKTCL item)
    {
        item.UserUpdate = asv.GetAuth().Result.User.Identity!.Name!;
        item.DateUpdate = DateTime.Now.ToString("dd/MMM/yyyy");
        var rs = item.BieuGiaKTCLID != Guid.Empty ? await Bgnhsv.UpdateBieugiaKTCL_Detail(item) : await Bgnhsv.CreateBieugiaKTCL_Detail(item);
        CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);

        await Refresh();
    }
    int? index_no;

    async Task DeleteItem(M_BieuGiaKTCL item)
    {
        if (item.Approve == true)
        {
            CallSnackBar(Localizer["PriceListAlreadyApproved"], MudBlazor.Severity.Warning);
            return;
        }
        if (!await ssv.CheckPermission(usr, "Delete", "BieugiaKTCL"))
        {
            CallSnackBar(Localizer["NoPermission_Delete"], MudBlazor.Severity.Warning);
            return;
        }
        var resultMess = await DialogService.ShowMessageBox(
                Localizer["Warning"],
                Localizer["DeleteConfirmBody"],
                yesText: Localizer["delete"], cancelText: Localizer["cancel"]);

        if (resultMess.HasValue)
        {
            var rs = await Bgnhsv.DeleteBieugiaKTCL_Detail(item);
            await HistoryLogService.LogAsync(usr, "Delete Bieu Gia KTCL", "BieugiaKTCL", item.BieuGiaKTCLID, item.BieuGiaKTCLNo, new { OldData = item });
            CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
            await Refresh();
        }

    }
    DialogOptions options = new DialogOptions
        {
            ClassBackground = "class-dialog-custom",
            FullWidth = true,
            MaxWidth = MaxWidth.Medium,
            CloseOnEscapeKey = false,
            DisableBackdropClick = true
        };
    string search;

    private bool FilterFunc1(M_BieuGiaKTCL sbd) => FilterFunc(sbd, search);

    private bool FilterFunc(M_BieuGiaKTCL sbd, string searchString)
    {
        if (string.IsNullOrWhiteSpace(sbd.BieuGiaKTCLNo))
            return true;
        if (string.IsNullOrWhiteSpace(searchString))
            return true;
        if (sbd.BieuGiaKTCLNo!.Contains(searchString, StringComparison.OrdinalIgnoreCase))
            return true;
        if ($"{sbd.BieuGiaKTCLNo} ".Contains(searchString))
            return true;
        return false;
    }

    private Func<M_BieuGiaKTCL, string> _cellStyleFunc => x =>
       {
           string style = "";

           if (string.IsNullOrEmpty(x.TrangThai))
               return "color: #000000";

           var rs = M_Trangthais
           .Where(t => (t.Noidung).Contains(x.TrangThai, StringComparison.InvariantCultureIgnoreCase)
               && t.Tieude.Equals("BieugiaKTCL", StringComparison.InvariantCultureIgnoreCase))
           .Select(t => t.Mamau)
           .FirstOrDefault();
           return "color: " + rs;


       };

    private async Task OpenCreateDialog(Models.M_BieuGiaKTCL tr)
    {
        var optionsdialog = new DialogOptions { ClassBackground = "class-dialog-custom", FullWidth = true, MaxWidth = MaxWidth.Medium };

        if (await ssv.CheckPermission(asv.GetAuth().Result.User.Identity.Name, "Add", "BieugiaKTCL"))
        {

            DialogOptions closeOnEscapeKey = new DialogOptions() { CloseOnEscapeKey = true };
            var parameters = new DialogParameters<ADD> { { x => x._BieuGiaKTCL_Detail, tr }, { x => x.Status, "add" } };

            var dialog = await DialogService.ShowAsync<ADD>(tr.BieuGiaKTCLID == Guid.Empty ? Localizer["BGKTCL_Create"] : Localizer["BGKTCL_Edit"], parameters, optionsdialog);
            var result = await dialog.Result;
            if (!result.Canceled)
            {
                var data = (M_BieuGiaKTCL)result.Data;
                var rs = await Bgnhsv.UpdateCreateBieugiaKTCL(data);
                await HistoryLogService.LogAsync(usr, "ADD Bieu Gia KTCL", "BieugiaKTCL", data.BieuGiaKTCLID, data.BieuGiaKTCLNo, data);
                MudBlazor.Severity severity;
                if (rs[1] == "1")
                    severity = MudBlazor.Severity.Success;
                else
                    severity = MudBlazor.Severity.Error;

                CallSnackBar(rs[0], severity);

                await HandleRefresh_create(data.BieuGiaKTCLID);

            }

            return;

        }
        else
        {
            CallSnackBar(Localizer["NoPermission_Add"], MudBlazor.Severity.Warning);
            return;
        }

    }

    async Task HandleRefresh_create(Guid? id)
    {
        try
        {

            detail = null;

            Listdata.Clear();

            await Task.Delay(500);

            if (!await ssv.CheckPermission(asv.GetAuth().Result.User.Identity.Name, "View", "BieugiaKTCL"))
            {
                CallSnackBar(Localizer["NoPermission_View"], MudBlazor.Severity.Warning);

                return;
            }
            Listdata = await Bgnhsv.GetListBieugiaKTCL_create(id);
            StateHasChanged();
        }
        finally
        {


        }
    }

    private async Task OpenEditDialog(Models.M_BieuGiaKTCL tr)
    {
        var optionsdialog = new DialogOptions { ClassBackground = "class-dialog-custom", FullWidth = true, MaxWidth = MaxWidth.Medium };
        if (tr == null)
        {
            CallSnackBar(Localizer["PleaseSelectData"], MudBlazor.Severity.Warning);
            return;
        }
        if (tr.Approve == true)
        {
            CallSnackBar(Localizer["PriceListAlreadyApproved"], MudBlazor.Severity.Warning);
            return;
        }
        if (await ssv.CheckPermission(asv.GetAuth().Result.User.Identity.Name, "Edit", "BieugiaKTCL"))
        {

            var OldData = JsonSerializer.Deserialize<M_BieuGiaKTCL>(JsonSerializer.Serialize(tr));

            DialogOptions closeOnEscapeKey = new DialogOptions() { CloseOnEscapeKey = true };
            var parameters = new DialogParameters<ADD> { { x => x._BieuGiaKTCL_Detail, tr }, { x => x.Status, "edit" } };

            var dialog = await DialogService.ShowAsync<ADD>(Localizer["BGKTCL_Edit"], parameters, optionsdialog);
            var result = await dialog.Result;
            // Giữ nguyên dòng được chọn
            selectedRowNumber = selectedRowNumber;
            StateHasChanged();

            if (!result.Canceled)
            {
                var data = (M_BieuGiaKTCL)result.Data;
                var rs = await Bgnhsv.UpdateCreateBieugiaKTCL(data);
                await HistoryLogService.LogAsync(usr, "Update Bieu Gia KTCL", "BieugiaKTCL", data.BieuGiaKTCLID, data.BieuGiaKTCLNo, new { OldData = OldData, NewData = data });
                MudBlazor.Severity severity;
                if (rs[1] == "1")
                    severity = MudBlazor.Severity.Success;
                else
                    severity = MudBlazor.Severity.Error;

                CallSnackBar(rs[0], severity);
            }

            return;

        }
        else
        {
            CallSnackBar(Localizer["NoPermission_Edit"], MudBlazor.Severity.Warning);
            return;
        }

    }

    private async Task<IEnumerable<string>> searchTerminal(string text)
    {
        try
        {
            if (string.IsNullOrWhiteSpace(text))
            {
                return Terminals.Where(x => !string.IsNullOrEmpty(x.TermiNalName))
               .Select(x => x.TermiNalName);
            }
            // MBL.Porname = mst_Consignee;
            return Terminals.Where(x => !string.IsNullOrEmpty(x.TermiNalName) &&
                            x.TermiNalName.Contains(text, StringComparison.OrdinalIgnoreCase))
               .Select(x => x.TermiNalName);
        }
        catch (Exception)
        {
            throw;
        }
    }

    private async Task GetT_BieugiananghaNo(M_BieuGiaKTCL item)
    {

        int formattedYear = DateTime.Now.Year;
        int formattedMonth = DateTime.Now.Month;

        string usr = asv.GetAuth().Result.User.Identity!.Name!;
        var refno = await supsv.GetRefNoByFunc("KTCL", formattedMonth, formattedYear, usr);

        var rs = asv.GetUserDetail();
        var cn = rs.Branch;
        item.BieuGiaKTCLNo = cn + "BGKTCL_" + formattedYear.ToString() + formattedMonth.ToString() + refno.Value.ToString("D4");

    }

    private async Task OnApproveCheckboxWrapper(M_BieuGiaKTCL item)
    {
        if (await ssv.CheckPermission(asv.GetAuth().Result.User.Identity.Name, "Approve", "BieugiaKTCL"))
        {
            var rs = await Bgnhsv.UpdateCreateBieugiaKTCL(item);
        }
        else
        {
            CallSnackBar(Localizer["NoPermission_Approve"], MudBlazor.Severity.Warning);
            return;
        }
    }


    private async Task OpenDuplicateDialog(Models.M_BieuGiaKTCL tr)
    {
        var optionsdialog = new DialogOptions { ClassBackground = "class-dialog-custom", FullWidth = true, MaxWidth = MaxWidth.Medium };
        if (tr == null)
        {
            CallSnackBar(Localizer["PleaseSelectData"], MudBlazor.Severity.Warning);
            return;
        }

        if (await ssv.CheckPermission(asv.GetAuth().Result.User.Identity.Name, "Add", "BieugiaKTCL"))
        {

            var OldData = JsonSerializer.Deserialize<M_BieuGiaKTCL>(JsonSerializer.Serialize(tr));
            DialogOptions closeOnEscapeKey = new DialogOptions() { CloseOnEscapeKey = true };
            var parameters = new DialogParameters<ADD> { { x => x._BieuGiaKTCL_Detail, tr }, { x => x.Status, "Duplicate" } };

            var dialog = await DialogService.ShowAsync<ADD>(Localizer["BGKTCL_Create"], parameters, optionsdialog);
            var result = await dialog.Result;
            // Giữ nguyên dòng được chọn
            selectedRowNumber = selectedRowNumber;
            StateHasChanged();

            if (!result.Canceled)
            {
                var data = (M_BieuGiaKTCL)result.Data;
                var rs = await Bgnhsv.UpdateCreateBieugiaKTCL(data);
                await HistoryLogService.LogAsync(usr, "Duplicate Bieu Gia KTCL", "BieugiaKTCL", data.BieuGiaKTCLID, data.BieuGiaKTCLNo, new { OldData = OldData, NewData = data });
                MudBlazor.Severity severity;
                if (rs[1] == "1")
                    severity = MudBlazor.Severity.Success;
                else
                    severity = MudBlazor.Severity.Error;

                CallSnackBar(rs[0], severity);
            }

            return;


        }
        else
        {
            CallSnackBar(Localizer["NoPermission_Add"], MudBlazor.Severity.Warning);
            return;
        }

    }
}
