@inherits NVOAMASIS.Components.Hr.HrPageBase

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form">
            <MudStack Spacing="2">
                <MudTextField T="string" @bind-Value="Code" Label="@L("hr_code")" MaxLength="50"
                              Variant="Variant.Outlined" Margin="Margin.Dense"
                              Required="true" RequiredError="@L("hr_err_code_required")"
                              Disabled="@CodeLocked" HelperText="@(CodeLocked ? L("hr_dept_code_locked_hint") : L("hr_dept_code_hint"))" />
                <MudTextField T="string" @bind-Value="Name" Label="@L("hr_name")" MaxLength="200"
                              Variant="Variant.Outlined" Margin="Margin.Dense"
                              Required="true" RequiredError="@L("hr_err_name_required")" />
                <MudTextField T="string" @bind-Value="Remarks" Label="@L("hr_note")" Lines="2"
                              Variant="Variant.Outlined" Margin="Margin.Dense" MaxLength="1000" />
            </MudStack>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="@(() => MudDialog.Cancel())">@L("cancel")</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync">@L("save")</MudButton>
    </DialogActions>
</MudDialog>

@code {
    public sealed record Result(string Code, string Name, string? Remarks);

    [CascadingParameter] private MudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public string Code { get; set; } = string.Empty;
    [Parameter] public string Name { get; set; } = string.Empty;
    [Parameter] public string? Remarks { get; set; }
    /// <summary>Mã đang được tài khoản (UserList.Department) sử dụng → không cho đổi.</summary>
    [Parameter] public bool CodeLocked { get; set; }

    private MudForm? _form;

    private async Task SaveAsync()
    {
        if (_form is null) return;
        await _form.Validate();
        if (!_form.IsValid) return;
        MudDialog.Close(DialogResult.Ok(new Result(Code.Trim(), Name.Trim(), Remarks)));
    }
}
