@inherits NVOAMASIS.Components.Hr.HrPageBase

<MudDialog>
    <DialogContent>
        @if (!string.IsNullOrWhiteSpace(Message))
        {
            <MudText Typo="Typo.body2" Class="mb-2">@Message</MudText>
        }
        <MudTextField T="string" @bind-Value="_comment" Label="@L("hr_comment")" Lines="3" MaxLength="500"
                      Variant="Variant.Outlined" Margin="Margin.Dense"
                      Required="@Required" RequiredError="@L("hr_err_comment_required")" />
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="@(() => MudDialog.Cancel())">@L("cancel")</MudButton>
        <MudButton Variant="Variant.Filled" Color="@ConfirmColor" OnClick="Ok">@ConfirmText</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private MudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public string? Message { get; set; }
    [Parameter] public string ConfirmText { get; set; } = "OK";
    [Parameter] public Color ConfirmColor { get; set; } = Color.Primary;
    [Parameter] public bool Required { get; set; }

    private string? _comment;

    private void Ok()
    {
        if (Required && string.IsNullOrWhiteSpace(_comment))
        {
            Notify(L("hr_err_comment_required"), Severity.Warning);
            return;
        }
        MudDialog.Close(DialogResult.Ok(_comment?.Trim() ?? string.Empty));
    }
}
