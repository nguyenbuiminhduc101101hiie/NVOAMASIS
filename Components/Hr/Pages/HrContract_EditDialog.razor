@inherits NVOAMASIS.Components.Hr.HrPageBase
@inject HrContractService ContractSvc
@inject HrEmployeeService EmployeeSvc

<MudDialog>
    <DialogContent>
        @if (_loading)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
        }
        else
        {
            <MudForm @ref="_form">
                <MudGrid Spacing="2">
                    <MudItem xs="12">
                        <MudAutocomplete T="HrLookupItem" Value="_employee" ValueChanged="OnEmployeeChanged"
                                         Label="@L("hr_employee")" SearchFunc="SearchEmployee"
                                         ToStringFunc="@(x => x?.Display ?? string.Empty)"
                                         ResetValueOnEmptyText="true" Clearable="@(!FixedEmployee)" CoerceText="true"
                                         MaxItems="50" Variant="Variant.Outlined" Margin="Margin.Dense"
                                         Disabled="@(FixedEmployee || IsEdit)"
                                         Required="true" RequiredError="@L("hr_err_employee_required")" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField T="string" @bind-Value="Model.ContractNo" Label="@L("hr_contract_no")"
                                      Variant="Variant.Outlined" Margin="Margin.Dense" MaxLength="50"
                                      Required="true" RequiredError="@L("hr_err_contract_no_required")" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudSelect T="int" Value="Model.ContractType" ValueChanged="OnTypeChanged" Label="@L("hr_contract_type")"
                                   Variant="Variant.Outlined" Margin="Margin.Dense">
                            @foreach (var t in HrContractType.All)
                            {
                                <MudSelectItem T="int" Value="@t">@L(HrContractType.Key(t))</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="4">
                        <MudDatePicker @bind-Date="Model.SignDate" Label="@L("hr_sign_date")" DateFormat="dd/MM/yyyy"
                                       Editable="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </MudItem>
                    <MudItem xs="12" sm="4">
                        <MudDatePicker Date="Model.StartDate" DateChanged="OnStartChanged" Label="@L("hr_start_date")"
                                       DateFormat="dd/MM/yyyy" Editable="true" Variant="Variant.Outlined" Margin="Margin.Dense"
                                       Required="true" />
                    </MudItem>
                    <MudItem xs="12" sm="4">
                        @if (Model.ContractType == HrContractType.Indefinite)
                        {
                            <MudTextField T="string" Value="@L("hr_indefinite")" Label="@L("hr_end_date")" ReadOnly="true"
                                          Variant="Variant.Outlined" Margin="Margin.Dense" />
                        }
                        else
                        {
                            <MudDatePicker @bind-Date="Model.EndDate" Label="@L("hr_end_date")" DateFormat="dd/MM/yyyy"
                                           Editable="true" Variant="Variant.Outlined" Margin="Margin.Dense"
                                           Required="true" RequiredError="@L("hr_err_end_date_required")" />
                        }
                    </MudItem>

                    @if (CanViewSalary)
                    {
                        <MudItem xs="12" sm="4">
                            <MudNumericField T="decimal?" @bind-Value="Model.BaseSalary" Label="@L("hr_base_salary")"
                                             Format="N0" Min="0" HideSpinButtons="true" ReadOnly="@(!CanEditSalary)"
                                             Variant="Variant.Outlined" Margin="Margin.Dense" />
                        </MudItem>
                        <MudItem xs="12" sm="4">
                            <MudNumericField T="decimal?" @bind-Value="Model.InsuranceSalary" Label="@L("hr_insurance_salary")"
                                             Format="N0" Min="0" HideSpinButtons="true" ReadOnly="@(!CanEditSalary)"
                                             Variant="Variant.Outlined" Margin="Margin.Dense" />
                        </MudItem>
                        <MudItem xs="12" sm="4">
                            <MudNumericField T="decimal?" @bind-Value="Model.Allowance" Label="@L("hr_allowance")"
                                             Format="N0" Min="0" HideSpinButtons="true" ReadOnly="@(!CanEditSalary)"
                                             Variant="Variant.Outlined" Margin="Margin.Dense" />
                        </MudItem>
                        @if (!CanEditSalary)
                        {
                            <MudItem xs="12">
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@L("hr_salary_readonly_hint")</MudText>
                            </MudItem>
                        }
                    }
                    else
                    {
                        <MudItem xs="12">
                            <MudAlert Severity="Severity.Info" Dense="true">@L("hr_salary_hidden_hint")</MudAlert>
                        </MudItem>
                    }

                    @if (IsEdit)
                    {
                        <MudItem xs="12" sm="6">
                            <MudSelect T="int" @bind-Value="Model.Status" Label="@L("hr_status")"
                                       Variant="Variant.Outlined" Margin="Margin.Dense">
                                <MudSelectItem T="int" Value="@HrContractStatus.Active">@L("hr_contract_status_active")</MudSelectItem>
                                <MudSelectItem T="int" Value="@HrContractStatus.Terminated">@L("hr_contract_status_terminated")</MudSelectItem>
                            </MudSelect>
                        </MudItem>
                        @if (Model.Status == HrContractStatus.Terminated)
                        {
                            <MudItem xs="12" sm="6">
                                <MudDatePicker @bind-Date="Model.TerminatedDate" Label="@L("hr_terminated_date")" DateFormat="dd/MM/yyyy"
                                               Editable="true" Variant="Variant.Outlined" Margin="Margin.Dense"
                                               Required="true" RequiredError="@L("hr_err_terminated_date_required")" />
                            </MudItem>
                        }
                    }

                    <MudItem xs="12">
                        <MudTextField T="string" @bind-Value="Model.Note" Label="@L("hr_note")" Lines="2"
                                      Variant="Variant.Outlined" Margin="Margin.Dense" MaxLength="2000" />
                    </MudItem>

                    @if (!IsEdit)
                    {
                        <MudItem xs="12">
                            <MudCheckBox T="bool" @bind-Checked="_terminatePrevious" Color="Color.Primary"
                                         Label="@L("hr_opt_terminate_previous")" />
                            @if (_employeeStatus == HrEmployeeStatus.Probation && Model.ContractType != HrContractType.Probation)
                            {
                                <MudCheckBox T="bool" @bind-Checked="_promote" Color="Color.Primary"
                                             Label="@L("hr_opt_promote_official")" />
                            }
                            @if (_employeeStatus == HrEmployeeStatus.Probation && Model.ContractType == HrContractType.Probation)
                            {
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@L("hr_probation_sync_hint")</MudText>
                            }
                        </MudItem>
                    }
                </MudGrid>
            </MudForm>
        }
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="@(() => MudDialog.Cancel())" Disabled="_saving">@L("cancel")</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync" Disabled="_saving || _loading">@L("save")</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private MudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public HrContract Model { get; set; } = new();
    [Parameter] public bool IsEdit { get; set; }
    [Parameter] public bool FixedEmployee { get; set; }
    [Parameter] public bool CanViewSalary { get; set; }
    [Parameter] public bool CanEditSalary { get; set; }

    private MudForm? _form;
    private bool _loading = true;
    private bool _saving;
    private List<HrLookupItem> _employees = new();
    private HrLookupItem? _employee;
    private int? _employeeStatus;
    private bool _terminatePrevious = true;
    private bool _promote = true;

    protected override async Task OnInitializedAsync()
    {
        await InitUserAsync();
        try
        {
            // Khi sửa HĐ của NV đã nghỉ vẫn phải hiển thị được tên.
            _employees = await EmployeeSvc.GetEmployeeLookupAsync(includeResigned: IsEdit || FixedEmployee);
            _employee = _employees.FirstOrDefault(x => x.Id == Model.EmployeeId);
            if (_employee != null)
                _employeeStatus = await ContractSvc.GetEmployeeStatusAsync(_employee.Id);
        }
        catch (Exception ex)
        {
            Notify($"{L("hr_err_load")}: {ex.GetBaseException().Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private Task<IEnumerable<HrLookupItem>> SearchEmployee(string value)
    {
        IEnumerable<HrLookupItem> rs = string.IsNullOrWhiteSpace(value)
            ? _employees
            : _employees.Where(x => x.Display.Contains(value, StringComparison.OrdinalIgnoreCase));
        return Task.FromResult(rs);
    }

    private async Task OnEmployeeChanged(HrLookupItem? item)
    {
        _employee = item;
        Model.EmployeeId = item?.Id ?? Guid.Empty;
        _employeeStatus = item is null ? null : await ContractSvc.GetEmployeeStatusAsync(item.Id);
    }

    private void OnTypeChanged(int type)
    {
        Model.ContractType = type;
        if (IsEdit) return;
        // Gợi ý ngày kết thúc theo loại HĐ (người dùng sửa lại được).
        Model.EndDate = type switch
        {
            HrContractType.Probation => Model.StartDate.AddMonths(2).AddDays(-1),
            HrContractType.FixedTerm => Model.StartDate.AddMonths(12).AddDays(-1),
            HrContractType.Service => Model.StartDate.AddMonths(3).AddDays(-1),
            _ => null
        };
    }

    private void OnStartChanged(DateTime? date)
    {
        if (date is null) return;
        var oldStart = Model.StartDate;
        Model.StartDate = date.Value.Date;
        if (!IsEdit && Model.EndDate.HasValue)
            Model.EndDate = Model.EndDate.Value.AddDays((Model.StartDate - oldStart).TotalDays);
    }

    private async Task SaveAsync()
    {
        if (_form is null) return;
        await _form.Validate();
        if (!_form.IsValid || Model.EmployeeId == Guid.Empty)
        {
            Notify(L("hr_err_form_invalid"), Severity.Warning);
            return;
        }

        _saving = true;
        var rs = await ContractSvc.SaveAsync(Model, new HrContractService.SaveOptions
        {
            TerminatePreviousActive = !IsEdit && _terminatePrevious,
            PromoteToOfficial = !IsEdit && _promote,
            CanEditSalary = CanEditSalary
        }, Usr);
        _saving = false;
        Notify(rs);
        if (rs.Success)
            MudDialog.Close(DialogResult.Ok(rs.Id!.Value));
    }
}
