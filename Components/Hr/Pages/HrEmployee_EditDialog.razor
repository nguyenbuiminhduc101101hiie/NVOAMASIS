@inherits NVOAMASIS.Components.Hr.HrPageBase
@inject HrEmployeeService EmployeeSvc

<MudDialog>
    <DialogContent>
        @if (_loading)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
        }
        else
        {
            <MudForm @ref="_form">
                <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pt-3">
                    <MudTabPanel Text="@L("hr_tab_general")" Icon="@Icons.Material.Filled.Person">
                        <MudGrid Spacing="2">
                            <MudItem xs="12" sm="4" md="3">
                                <MudTextField T="string" @bind-Value="M.EmployeeCode" Label="@L("hr_employee_code")"
                                              Variant="Variant.Outlined" Margin="Margin.Dense" MaxLength="30"
                                              Required="true" RequiredError="@L("hr_err_code_required")" />
                            </MudItem>
                            <MudItem xs="12" sm="8" md="5">
                                <MudTextField T="string" @bind-Value="M.FullName" Label="@L("hr_full_name")"
                                              Variant="Variant.Outlined" Margin="Margin.Dense" MaxLength="200"
                                              Required="true" RequiredError="@L("hr_err_name_required")" />
                            </MudItem>
                            <MudItem xs="6" md="2">
                                <MudSelect T="int" @bind-Value="M.Gender" Label="@L("hr_gender")"
                                           Variant="Variant.Outlined" Margin="Margin.Dense">
                                    @foreach (var g in HrGender.All)
                                    {
                                        <MudSelectItem T="int" Value="@g">@L(HrGender.Key(g))</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="6" md="2">
                                <MudDatePicker @bind-Date="M.DateOfBirth" Label="@L("hr_dob")" DateFormat="dd/MM/yyyy"
                                               Editable="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
                            </MudItem>
                            <MudItem xs="12" md="4">
                                <MudTextField T="string" @bind-Value="M.PlaceOfBirth" Label="@L("hr_place_of_birth")"
                                              Variant="Variant.Outlined" Margin="Margin.Dense" MaxLength="200" />
                            </MudItem>
                            <MudItem xs="12" sm="6" md="4">
                                <MudTextField T="string" @bind-Value="M.Phone" Label="@L("hr_phone")"
                                              Variant="Variant.Outlined" Margin="Margin.Dense" MaxLength="30" />
                            </MudItem>
                            <MudItem xs="12" sm="6" md="4">
                                <MudTextField T="string" @bind-Value="M.PersonalEmail" Label="@L("hr_personal_email")"
                                              Variant="Variant.Outlined" Margin="Margin.Dense" MaxLength="200"
                                              Validation="@(new EmailAddressAttribute { ErrorMessage = L("hr_err_email") })" />
                            </MudItem>
                            <MudItem xs="12" md="6">
                                <MudTextField T="string" @bind-Value="M.PermanentAddress" Label="@L("hr_permanent_address")"
                                              Variant="Variant.Outlined" Margin="Margin.Dense" MaxLength="500" />
                            </MudItem>
                            <MudItem xs="12" md="6">
                                <MudTextField T="string" @bind-Value="M.CurrentAddress" Label="@L("hr_current_address")"
                                              Variant="Variant.Outlined" Margin="Margin.Dense" MaxLength="500" />
                            </MudItem>
                            <MudItem xs="12" md="6">
                                <MudTextField T="string" @bind-Value="M.EmergencyContactName" Label="@L("hr_emergency_name")"
                                              Variant="Variant.Outlined" Margin="Margin.Dense" MaxLength="200" />
                            </MudItem>
                            <MudItem xs="12" md="6">
                                <MudTextField T="string" @bind-Value="M.EmergencyContactPhone" Label="@L("hr_emergency_phone")"
                                              Variant="Variant.Outlined" Margin="Margin.Dense" MaxLength="30" />
                            </MudItem>
                        </MudGrid>
                    </MudTabPanel>

                    <MudTabPanel Text="@L("hr_tab_work")" Icon="@Icons.Material.Filled.Work">
                        <MudGrid Spacing="2">
                            <MudItem xs="12" md="4">
                                <MudSelect T="Guid?" @bind-Value="M.DepartmentId" Label="@L("hr_department")" Clearable="true"
                                           Variant="Variant.Outlined" Margin="Margin.Dense">
                                    @foreach (var d in _departments)
                                    {
                                        <MudSelectItem T="Guid?" Value="@((Guid?)d.Id)">@d.Display</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="12" md="4">
                                <MudSelect T="Guid?" @bind-Value="M.PositionId" Label="@L("hr_position")" Clearable="true"
                                           Variant="Variant.Outlined" Margin="Margin.Dense">
                                    @foreach (var p in _positions)
                                    {
                                        <MudSelectItem T="Guid?" Value="@((Guid?)p.Id)">@p.Name</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="6" md="2">
                                <MudSelect T="string" @bind-Value="M.Branch" Label="@L("hr_branch")" Clearable="true"
                                           Variant="Variant.Outlined" Margin="Margin.Dense">
                                    @foreach (var b in Branches)
                                    {
                                        <MudSelectItem T="string" Value="@b">@b</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="6" md="2">
                                <MudTextField T="string" @bind-Value="M.CompanyCode" Label="@L("hr_company_code")"
                                              Variant="Variant.Outlined" Margin="Margin.Dense" MaxLength="50" />
                            </MudItem>
                            <MudItem xs="12" md="6">
                                <MudAutocomplete T="HrLookupItem" @bind-Value="_manager" Label="@L("hr_manager")"
                                                 SearchFunc="SearchManager" ToStringFunc="@(x => x?.Display ?? string.Empty)"
                                                 ResetValueOnEmptyText="true" Clearable="true" CoerceText="true"
                                                 MaxItems="50" Variant="Variant.Outlined" Margin="Margin.Dense" />
                            </MudItem>
                            <MudItem xs="12" md="6">
                                <MudAutocomplete T="HrUserLookup" @bind-Value="_user" Label="@L("hr_account")"
                                                 HelperText="@L("hr_account_helper")"
                                                 SearchFunc="SearchUser" ToStringFunc="@(x => x?.Display ?? string.Empty)"
                                                 ResetValueOnEmptyText="true" Clearable="true" CoerceText="true"
                                                 MaxItems="50" Variant="Variant.Outlined" Margin="Margin.Dense" />
                            </MudItem>
                            <MudItem xs="12" md="6">
                                <MudTextField T="string" @bind-Value="M.WorkEmail" Label="@L("hr_work_email")"
                                              Variant="Variant.Outlined" Margin="Margin.Dense" MaxLength="200"
                                              Validation="@(new EmailAddressAttribute { ErrorMessage = L("hr_err_email") })" />
                            </MudItem>
                            <MudItem xs="12" md="6">
                                <MudSelect T="int" @bind-Value="M.Status" Label="@L("hr_status")"
                                           Variant="Variant.Outlined" Margin="Margin.Dense">
                                    @foreach (var s in HrEmployeeStatus.All)
                                    {
                                        <MudSelectItem T="int" Value="@s">@L(HrEmployeeStatus.Key(s))</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="6" md="4">
                                <MudDatePicker @bind-Date="M.JoinDate" Label="@L("hr_join_date")" DateFormat="dd/MM/yyyy"
                                               Editable="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
                            </MudItem>
                            <MudItem xs="6" md="4">
                                <MudDatePicker @bind-Date="M.ProbationEndDate" Label="@L("hr_probation_end")" DateFormat="dd/MM/yyyy"
                                               Editable="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
                            </MudItem>
                            <MudItem xs="6" md="4">
                                <MudDatePicker @bind-Date="M.OfficialDate" Label="@L("hr_official_date")" DateFormat="dd/MM/yyyy"
                                               Editable="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
                            </MudItem>
                            @if (M.Status == HrEmployeeStatus.Resigned)
                            {
                                <MudItem xs="6" md="4">
                                    <MudDatePicker @bind-Date="M.ResignDate" Label="@L("hr_resign_date")" DateFormat="dd/MM/yyyy"
                                                   Editable="true" Variant="Variant.Outlined" Margin="Margin.Dense"
                                                   Required="true" RequiredError="@L("hr_err_resign_date_required")" />
                                </MudItem>
                                <MudItem xs="12" md="8">
                                    <MudTextField T="string" @bind-Value="M.ResignReason" Label="@L("hr_resign_reason")"
                                                  Variant="Variant.Outlined" Margin="Margin.Dense" MaxLength="500" />
                                </MudItem>
                            }
                        </MudGrid>
                    </MudTabPanel>

                    <MudTabPanel Text="@L("hr_tab_legal")" Icon="@Icons.Material.Filled.Badge">
                        <MudGrid Spacing="2">
                            <MudItem xs="12" md="4">
                                <MudTextField T="string" @bind-Value="M.IdCardNo" Label="@L("hr_id_card_no")"
                                              Variant="Variant.Outlined" Margin="Margin.Dense" MaxLength="20" />
                            </MudItem>
                            <MudItem xs="12" md="3">
                                <MudDatePicker @bind-Date="M.IdCardIssueDate" Label="@L("hr_id_card_issue_date")" DateFormat="dd/MM/yyyy"
                                               Editable="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
                            </MudItem>
                            <MudItem xs="12" md="5">
                                <MudTextField T="string" @bind-Value="M.IdCardIssuePlace" Label="@L("hr_id_card_issue_place")"
                                              Variant="Variant.Outlined" Margin="Margin.Dense" MaxLength="200" />
                            </MudItem>
                            <MudItem xs="12" md="4">
                                <MudTextField T="string" @bind-Value="M.PersonalTaxCode" Label="@L("hr_tax_code")"
                                              Variant="Variant.Outlined" Margin="Margin.Dense" MaxLength="20" />
                            </MudItem>
                            <MudItem xs="12" md="4">
                                <MudTextField T="string" @bind-Value="M.SocialInsuranceNo" Label="@L("hr_social_insurance_no")"
                                              Variant="Variant.Outlined" Margin="Margin.Dense" MaxLength="20" />
                            </MudItem>
                            <MudItem xs="12" md="4">
                                <MudNumericField T="int" @bind-Value="M.DependentCount" Label="@L("hr_dependent_count")"
                                                 Min="0" Max="20" Variant="Variant.Outlined" Margin="Margin.Dense" />
                            </MudItem>
                            <MudItem xs="12" md="4">
                                <MudTextField T="string" @bind-Value="M.BankAccountNo" Label="@L("hr_bank_account")"
                                              Variant="Variant.Outlined" Margin="Margin.Dense" MaxLength="30" />
                            </MudItem>
                            <MudItem xs="12" md="4">
                                <MudTextField T="string" @bind-Value="M.BankName" Label="@L("hr_bank_name")"
                                              Variant="Variant.Outlined" Margin="Margin.Dense" MaxLength="200" />
                            </MudItem>
                            <MudItem xs="12" md="4">
                                <MudTextField T="string" @bind-Value="M.BankBranch" Label="@L("hr_bank_branch")"
                                              Variant="Variant.Outlined" Margin="Margin.Dense" MaxLength="200" />
                            </MudItem>
                            <MudItem xs="12">
                                <MudTextField T="string" @bind-Value="M.Note" Label="@L("hr_note")" Lines="3"
                                              Variant="Variant.Outlined" Margin="Margin.Dense" MaxLength="2000" />
                            </MudItem>
                        </MudGrid>
                    </MudTabPanel>
                </MudTabs>
            </MudForm>
        }
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="Cancel" Disabled="_saving">@L("cancel")</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync" Disabled="_saving || _loading">
            @if (_saving)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
            }
            @L("save")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    public static readonly string[] Branches = { "SGN", "HAN", "HPH", "DAD" };

    [CascadingParameter] private MudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public HrEmployee Model { get; set; } = new();
    [Parameter] public bool IsEdit { get; set; }

    private HrEmployee M => Model;
    private MudForm? _form;
    private bool _loading = true;
    private bool _saving;
    private List<HrLookupItem> _departments = new();
    private List<HrLookupItem> _positions = new();
    private List<HrLookupItem> _employees = new();
    private List<HrUserLookup> _users = new();
    private HrLookupItem? _manager;
    private HrUserLookup? _user;

    protected override async Task OnInitializedAsync()
    {
        await InitUserAsync();
        try
        {
            _departments = await EmployeeSvc.GetDepartmentLookupAsync();
            _positions = await EmployeeSvc.GetPositionLookupAsync(activeOnly: true);
            _employees = (await EmployeeSvc.GetEmployeeLookupAsync()).Where(x => x.Id != Model.Id).ToList();
            _users = await EmployeeSvc.GetUnlinkedUsersAsync(Model.UserId);

            // Giữ chức vụ đang gán dù đã ngưng dùng
            if (Model.PositionId.HasValue && _positions.All(x => x.Id != Model.PositionId))
            {
                var all = await EmployeeSvc.GetPositionLookupAsync(activeOnly: false);
                var cur = all.FirstOrDefault(x => x.Id == Model.PositionId);
                if (cur != null) _positions.Add(cur);
            }

            _manager = _employees.FirstOrDefault(x => x.Id == Model.ManagerEmployeeId);
            if (_manager is null && Model.ManagerEmployeeId.HasValue)
            {
                var all = await EmployeeSvc.GetEmployeeLookupAsync(includeResigned: true);
                _manager = all.FirstOrDefault(x => x.Id == Model.ManagerEmployeeId);
            }
            _user = _users.FirstOrDefault(x => x.UsrId == Model.UserId);
        }
        catch (Exception ex)
        {
            Notify($"{L("hr_err_load")}: {ex.GetBaseException().Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private Task<IEnumerable<HrLookupItem>> SearchManager(string value)
    {
        IEnumerable<HrLookupItem> rs = string.IsNullOrWhiteSpace(value)
            ? _employees
            : _employees.Where(x => x.Display.Contains(value, StringComparison.OrdinalIgnoreCase));
        return Task.FromResult(rs);
    }

    private Task<IEnumerable<HrUserLookup>> SearchUser(string value)
    {
        IEnumerable<HrUserLookup> rs = string.IsNullOrWhiteSpace(value)
            ? _users
            : _users.Where(x => x.Display.Contains(value, StringComparison.OrdinalIgnoreCase)
                                || (x.Email ?? "").Contains(value, StringComparison.OrdinalIgnoreCase));
        return Task.FromResult(rs);
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task SaveAsync()
    {
        if (_form is null) return;
        await _form.Validate();
        if (!_form.IsValid)
        {
            Notify(L("hr_err_form_invalid"), Severity.Warning);
            return;
        }

        Model.ManagerEmployeeId = _manager?.Id;
        Model.UserId = _user?.UsrId;
        if (Model.Status != HrEmployeeStatus.Resigned)
        {
            Model.ResignDate = null;
            Model.ResignReason = null;
        }
        if (string.IsNullOrWhiteSpace(Model.WorkEmail) && _user != null && !string.IsNullOrWhiteSpace(_user.Email))
            Model.WorkEmail = _user.Email;

        _saving = true;
        var rs = await EmployeeSvc.SaveAsync(Model, Usr);
        _saving = false;
        Notify(rs);
        if (rs.Success)
            MudDialog.Close(DialogResult.Ok(rs.Id!.Value));
    }
}
