@inherits NVOAMASIS.Components.Hr.HrPageBase

<MudDialog>
    <DialogContent>
        <MudStack Row="true" Spacing="2">
            <MudSelect T="int" @bind-Value="Month" Label="@L("hr_month")" Variant="Variant.Outlined" Margin="Margin.Dense">
                @for (var m = 1; m <= 12; m++)
                {
                    var mm = m;
                    <MudSelectItem T="int" Value="@mm">@mm</MudSelectItem>
                }
            </MudSelect>
            <MudSelect T="int" @bind-Value="Year" Label="@L("hr_year")" Variant="Variant.Outlined" Margin="Margin.Dense">
                @foreach (var y in Enumerable.Range(DateTime.Today.Year - 2, 4).Reverse())
                {
                    <MudSelectItem T="int" Value="@y">@y</MudSelectItem>
                }
            </MudSelect>
        </MudStack>
        <MudText Typo="Typo.caption" Class="mt-2 d-block">@L("hr_pay_new_period_hint")</MudText>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="@(() => MudDialog.Cancel())">@L("cancel")</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => MudDialog.Close(DialogResult.Ok(new DateTime(Year, Month, 1))))">
            @L("hr_pay_create_calc")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private MudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public int Year { get; set; } = DateTime.Today.Year;
    [Parameter] public int Month { get; set; } = DateTime.Today.Month;
}
