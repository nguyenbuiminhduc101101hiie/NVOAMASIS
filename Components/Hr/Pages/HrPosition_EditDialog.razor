@inherits NVOAMASIS.Components.Hr.HrPageBase

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form">
            <MudStack Spacing="2">
                <MudTextField T="string" @bind-Value="Model.Code" Label="@L("hr_code")" MaxLength="30"
                              Variant="Variant.Outlined" Margin="Margin.Dense"
                              Required="true" RequiredError="@L("hr_err_code_required")" />
                <MudTextField T="string" @bind-Value="Model.Name" Label="@L("hr_name")" MaxLength="200"
                              Variant="Variant.Outlined" Margin="Margin.Dense"
                              Required="true" RequiredError="@L("hr_err_name_required")" />
                <MudNumericField T="int" @bind-Value="Model.SortOrder" Label="@L("hr_sort_order")"
                                 HelperText="@L("hr_sort_order_hint")" Min="0"
                                 Variant="Variant.Outlined" Margin="Margin.Dense" />
                <MudTextField T="string" @bind-Value="Model.Description" Label="@L("hr_note")" Lines="2"
                              Variant="Variant.Outlined" Margin="Margin.Dense" MaxLength="1000" />
                <MudSwitch T="bool" @bind-Checked="Model.IsActive" Color="Color.Primary" Label="@L("hr_active")" />
            </MudStack>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="@(() => MudDialog.Cancel())">@L("cancel")</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync">@L("save")</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private MudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public HrPosition Model { get; set; } = new();

    private MudForm? _form;

    private async Task SaveAsync()
    {
        if (_form is null) return;
        await _form.Validate();
        if (!_form.IsValid) return;
        MudDialog.Close(DialogResult.Ok(Model));
    }
}
