@attribute [Authorize]
@inherits NVOAMASIS.Components.Hr.HrPageBase
@inject HrTimesheetService TimesheetSvc
@inject HrEmployeeService EmployeeSvc
@inject IJSRuntime JS

<PageTitle>@L("hr_timesheet")</PageTitle>

<div class="product-price-page">
    <PpScreenHeader Title="@($"12.7 {L("hr_timesheet")}")" Subtitle="@L("hr_timesheet_subtitle")">
        <Toolbar>
            <MudStack Row="true" Spacing="1" Class="flex-wrap">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.PlayArrow"
                           OnClick="LoadAsync" Disabled="_busy || !_perm.View">@L("hr_ts_build")</MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Success" Size="Size.Small" StartIcon="@Icons.Material.Filled.FileDownload"
                           OnClick="ExportAsync" Disabled="_busy || _sheet is null || _sheet.Rows.Count == 0">@L("hr_export_excel")</MudButton>
            </MudStack>
        </Toolbar>
    </PpScreenHeader>

    <MudPaper Class="product-price-card pa-3" Elevation="0">
        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="mb-2 flex-wrap">
            <MudSelect T="int" @bind-Value="_filter.Month" Label="@L("hr_month")" Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width:100px">
                @for (var m = 1; m <= 12; m++)
                {
                    var mm = m;
                    <MudSelectItem T="int" Value="@mm">@mm</MudSelectItem>
                }
            </MudSelect>
            <MudSelect T="int" @bind-Value="_filter.Year" Label="@L("hr_year")" Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width:110px">
                @foreach (var y in Enumerable.Range(DateTime.Today.Year - 3, 5).Reverse())
                {
                    <MudSelectItem T="int" Value="@y">@y</MudSelectItem>
                }
            </MudSelect>
            <MudSelect T="Guid?" @bind-Value="_filter.DepartmentId" Label="@L("hr_department")" Clearable="true"
                       Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width:240px">
                @foreach (var d in _departments)
                {
                    <MudSelectItem T="Guid?" Value="@((Guid?)d.Id)">@d.Display</MudSelectItem>
                }
            </MudSelect>
            <MudSelect T="string" @bind-Value="_filter.Branch" Label="@L("hr_branch")" Clearable="true"
                       Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width:130px">
                @foreach (var b in HrEmployee_EditDialog.Branches)
                {
                    <MudSelectItem T="string" Value="@b">@b</MudSelectItem>
                }
            </MudSelect>
            <MudTextField T="string" @bind-Value="_filter.Search" Label="@L("hr_search")" Clearable="true"
                          OnKeyUp="@(async (KeyboardEventArgs e) => { if (e.Key == "Enter") await LoadAsync(); })"
                          Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width:220px" />
            @if (_sheet != null)
            {
                <MudSpacer />
                <MudText Typo="Typo.body2">
                    @string.Format(L("hr_ts_summary"), _sheet.Rows.Count, _sheet.StandardDays.ToString("0.##"))
                </MudText>
            }
        </MudStack>

        <MudText Typo="Typo.caption" Class="mb-2 d-block">@L("hr_ts_legend_inline")</MudText>

        @if (_busy)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
        }
        else if (_sheet != null)
        {
            <div class="hr-ts-wrap">
                <table class="hr-ts">
                    <thead>
                        <tr>
                            <th class="sticky c1">@L("hr_employee_code")</th>
                            <th class="sticky c2">@L("hr_full_name")</th>
                            @foreach (var d in _sheet.Days)
                            {
                                <th class="@DayClass(d.Kind)" title="@(d.HolidayName ?? d.Date.ToString("dddd dd/MM"))">
                                    @d.Date.Day<br /><span class="dow">@Dow(d.Date)</span>
                                </th>
                            }
                            <th class="tot">@L("hr_ts_standard")</th>
                            <th class="tot">@L("hr_ts_worked")</th>
                            <th class="tot">@L("hr_ts_remote")</th>
                            <th class="tot">@L("hr_ts_annual")</th>
                            <th class="tot">@L("hr_ts_sick")</th>
                            <th class="tot">@L("hr_ts_personal")</th>
                            <th class="tot">@L("hr_ts_unpaid")</th>
                            <th class="tot">@L("hr_ts_holiday")</th>
                            <th class="tot">@L("hr_ts_absent")</th>
                            <th class="tot">@L("hr_ts_goout")</th>
                            <th class="tot">@L("hr_ts_paid")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in _sheet.Rows)
                        {
                            <tr>
                                <td class="sticky c1">@r.EmployeeCode</td>
                                <td class="sticky c2" title="@r.DepartmentName">
                                    @r.FullName
                                    @if (!r.HasAccount)
                                    {
                                        <span class="noacc" title="@L("hr_without_account")"> ⚠</span>
                                    }
                                </td>
                                @for (var i = 0; i < r.Cells.Length; i++)
                                {
                                    var c = r.Cells[i];
                                    <td class="@($"{DayClass(_sheet.Days[i].Kind)} {(c.Warn ? "warn" : "")}")" title="@c.Tip">@c.Code</td>
                                }
                                <td class="tot">@F(r.Standard)</td>
                                <td class="tot"><b>@F(r.Worked)</b></td>
                                <td class="tot">@F(r.Remote)</td>
                                <td class="tot">@F(r.Annual)</td>
                                <td class="tot">@F(r.Sick)</td>
                                <td class="tot">@F(r.Personal)</td>
                                <td class="tot">@F(r.Unpaid)</td>
                                <td class="tot">@F(r.Holiday)</td>
                                <td class="tot @(r.Absent > 0 ? "warn" : "")">@F(r.Absent)</td>
                                <td class="tot">@(r.GoOutCount == 0 ? "" : r.GoOutCount.ToString())</td>
                                <td class="tot"><b>@F(r.Paid)</b></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <MudText Typo="Typo.caption" Class="mt-2 d-block">@L("hr_ts_note")</MudText>
        }
    </MudPaper>
</div>

<style>
    .hr-ts-wrap { overflow: auto; max-height: calc(100vh - 300px); border: 1px solid #ddd; }
    .hr-ts { border-collapse: separate; border-spacing: 0; font-size: 12px; white-space: nowrap; }
    .hr-ts th, .hr-ts td { border-right: 1px solid #e0e0e0; border-bottom: 1px solid #e0e0e0; padding: 2px 4px; text-align: center; min-width: 28px; }
    .hr-ts thead th { position: sticky; top: 0; background: #f5f5f5; z-index: 2; }
    .hr-ts .sticky { position: sticky; background: var(--mud-palette-surface, #fff); z-index: 1; text-align: left; }
    .hr-ts thead .sticky { z-index: 3; background: #f5f5f5; }
    .hr-ts .c1 { left: 0; min-width: 70px; }
    .hr-ts .c2 { left: 70px; min-width: 170px; border-right: 2px solid #bdbdbd; }
    .hr-ts .off { background: #eeeeee; color: #9e9e9e; }
    .hr-ts .holiday { background: #fff3e0; }
    .hr-ts .half { background: #f1f8e9; }
    .hr-ts .warn { color: #d32f2f; font-weight: 600; }
    .hr-ts .tot { background: #e3f2fd; min-width: 44px; }
    .hr-ts .dow { font-size: 10px; color: #757575; }
    .hr-ts .noacc { color: #f57c00; }
</style>

@code {
    private bool _busy;
    private HrPerm _perm = HrPerm.None;
    private readonly HrTimesheetFilter _filter = new();
    private List<HrLookupItem> _departments = new();
    private HrTimesheet? _sheet;

    protected override async Task OnInitializedAsync()
    {
        await InitUserAsync();
        _perm = await PermSvc.GetAsync(Usr, HrMenus.Timesheet);
        if (!_perm.View)
        {
            NoPermission("View");
            return;
        }
        _departments = await EmployeeSvc.GetDepartmentLookupAsync();
    }

    private async Task LoadAsync()
    {
        if (!_perm.View) { NoPermission("View"); return; }
        try
        {
            _busy = true;
            _sheet = await TimesheetSvc.BuildAsync(_filter);
        }
        catch (Exception ex)
        {
            Notify($"{L("hr_err_load")}: {ex.GetBaseException().Message}", Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ExportAsync()
    {
        if (_sheet is null) return;
        try
        {
            var bytes = HrTimesheetService.ExportExcel(_sheet, L);
            await JS.InvokeVoidAsync("downloadFileFromStream",
                $"BangCong_{_sheet.Year}{_sheet.Month:D2}.xlsx", Convert.ToBase64String(bytes));
        }
        catch (Exception ex)
        {
            Notify($"{L("hr_err_export")}: {ex.GetBaseException().Message}", Severity.Error);
        }
    }

    private static string F(decimal v) => v == 0 ? "" : v.ToString("0.##");

    private static string DayClass(HrDayKind k) => k switch
    {
        HrDayKind.Off => "off",
        HrDayKind.Holiday => "holiday",
        HrDayKind.HalfWork => "half",
        _ => ""
    };

    private static string Dow(DateTime d) => d.DayOfWeek switch
    {
        DayOfWeek.Sunday => "CN",
        DayOfWeek.Monday => "T2",
        DayOfWeek.Tuesday => "T3",
        DayOfWeek.Wednesday => "T4",
        DayOfWeek.Thursday => "T5",
        DayOfWeek.Friday => "T6",
        _ => "T7"
    };
}
