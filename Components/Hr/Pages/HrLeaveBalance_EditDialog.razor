@inherits NVOAMASIS.Components.Hr.HrPageBase
@inject HrLeaveService LeaveSvc

<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.subtitle2" Class="mb-2">@Row.EmployeeCode - @Row.FullName · @Row.Year</MudText>
        <MudGrid Spacing="2">
            <MudItem xs="6">
                <MudNumericField T="decimal" @bind-Value="_entitled" Label="@L("hr_bal_entitled")" Min="0" Step="0.5m"
                                 Format="0.##" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="6">
                <MudNumericField T="decimal" @bind-Value="_seniority" Label="@L("hr_bal_seniority")" Min="0" Step="0.5m"
                                 Format="0.##" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="6">
                <MudNumericField T="decimal" @bind-Value="_carried" Label="@L("hr_bal_carried")" Min="0" Step="0.5m"
                                 Format="0.##" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="6">
                <MudNumericField T="decimal" @bind-Value="_adjustment" Label="@L("hr_bal_adjustment")" Step="0.5m"
                                 Format="0.##" HelperText="@L("hr_bal_adjustment_hint")"
                                 Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12">
                <MudTextField T="string" @bind-Value="_note" Label="@L("hr_note")" Lines="2" MaxLength="1000"
                              Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12">
                <MudAlert Severity="Severity.Info" Dense="true">
                    @string.Format(L("hr_bal_preview"), (_entitled + _seniority + _carried + _adjustment).ToString("0.##"),
                        Row.Used.ToString("0.##"), (_entitled + _seniority + _carried + _adjustment - Row.Used).ToString("0.##"))
                </MudAlert>
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="@(() => MudDialog.Cancel())" Disabled="_saving">@L("cancel")</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync" Disabled="_saving">@L("save")</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private MudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public HrLeaveBalanceRow Row { get; set; } = new();

    private decimal _entitled, _seniority, _carried, _adjustment;
    private string? _note;
    private bool _saving;

    protected override async Task OnInitializedAsync()
    {
        await InitUserAsync();
        _entitled = Row.Entitled;
        _seniority = Row.SeniorityBonus;
        _carried = Row.CarriedOver;
        _adjustment = Row.Adjustment;
        _note = Row.Note;
    }

    private async Task SaveAsync()
    {
        _saving = true;
        var rs = await LeaveSvc.SaveBalanceAsync(Row.EmployeeId, Row.Year, _entitled, _seniority, _carried, _adjustment, _note, Usr);
        _saving = false;
        Notify(rs);
        if (rs.Success) MudDialog.Close(DialogResult.Ok(true));
    }
}
