@inherits NVOAMASIS.Components.Hr.HrPageBase
@inject HrPayrollService PayrollSvc

<MudDialog>
    <DialogContent>
        <MudGrid Spacing="2">
            <MudItem xs="12" sm="4">
                <MudDatePicker Date="M.EffectiveFrom" DateChanged="@((DateTime? d) => { if (d.HasValue) M.EffectiveFrom = d.Value; })"
                               Label="@L("hr_pay_effective_from")" DateFormat="dd/MM/yyyy" Editable="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            @Num(L("hr_pay_reference_wage"), () => M.ReferenceWage, v => M.ReferenceWage = v, "N0", 4)
            @Num(L("hr_pay_cap_multiplier"), () => M.CapMultiplier, v => M.CapMultiplier = v, "0.##", 4)
            @Num(L("hr_pay_min_wage_1"), () => M.MinWageRegion1, v => M.MinWageRegion1 = v, "N0", 3)
            @Num(L("hr_pay_min_wage_2"), () => M.MinWageRegion2, v => M.MinWageRegion2 = v, "N0", 3)
            @Num(L("hr_pay_min_wage_3"), () => M.MinWageRegion3, v => M.MinWageRegion3 = v, "N0", 3)
            @Num(L("hr_pay_min_wage_4"), () => M.MinWageRegion4, v => M.MinWageRegion4 = v, "N0", 3)
            <MudItem xs="12"><MudText Typo="Typo.subtitle2">@L("hr_pay_rates_employee")</MudText></MudItem>
            @Num("BHXH %", () => M.EmpSocialRate, v => M.EmpSocialRate = v, "0.##", 4)
            @Num("BHYT %", () => M.EmpHealthRate, v => M.EmpHealthRate = v, "0.##", 4)
            @Num("BHTN %", () => M.EmpUnemploymentRate, v => M.EmpUnemploymentRate = v, "0.##", 4)
            <MudItem xs="12"><MudText Typo="Typo.subtitle2">@L("hr_pay_rates_employer")</MudText></MudItem>
            @Num("BHXH %", () => M.CoSocialRate, v => M.CoSocialRate = v, "0.##", 3)
            @Num("BHYT %", () => M.CoHealthRate, v => M.CoHealthRate = v, "0.##", 3)
            @Num("BHTN %", () => M.CoUnemploymentRate, v => M.CoUnemploymentRate = v, "0.##", 3)
            @Num("KPCĐ %", () => M.CoUnionFeeRate, v => M.CoUnionFeeRate = v, "0.##", 3)
            <MudItem xs="12"><MudText Typo="Typo.subtitle2">@L("hr_pay_pit_params")</MudText></MudItem>
            @Num(L("hr_pay_self_deduction"), () => M.SelfDeduction, v => M.SelfDeduction = v, "N0", 6)
            @Num(L("hr_pay_dependent_deduction"), () => M.DependentDeduction, v => M.DependentDeduction = v, "N0", 6)
            <MudItem xs="12">
                <MudTextField T="string" @bind-Value="M.TaxBrackets" Label="@L("hr_pay_tax_brackets")" HelperText="@L("hr_pay_tax_brackets_hint")"
                              Variant="Variant.Outlined" Margin="Margin.Dense" MaxLength="500" />
            </MudItem>
            @Num(L("hr_pay_flat_rate"), () => M.FlatTaxRate, v => M.FlatTaxRate = v, "0.##", 6)
            @Num(L("hr_pay_flat_threshold"), () => M.FlatTaxThreshold, v => M.FlatTaxThreshold = v, "N0", 6)
            <MudItem xs="12">
                <MudTextField T="string" @bind-Value="M.Note" Label="@L("hr_note")" Lines="2" MaxLength="1000"
                              Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="@(() => MudDialog.Cancel())" Disabled="_saving">@L("cancel")</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync" Disabled="_saving">@L("save")</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private MudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public HrPayrollParam M { get; set; } = new();
    private bool _saving;

    protected override async Task OnInitializedAsync() => await InitUserAsync();

    private RenderFragment Num(string label, Func<decimal> get, Action<decimal> set, string format, int sm) => __builder =>
    {
        <MudItem xs="12" sm="@sm">
            <MudNumericField T="decimal" Value="@get()" ValueChanged="@((decimal v) => set(v))" Label="@label" Min="0"
                             Format="@format" HideSpinButtons="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
        </MudItem>
    };

    private async Task SaveAsync()
    {
        _saving = true;
        var rs = await PayrollSvc.SaveParamAsync(M, Usr);
        _saving = false;
        Notify(rs);
        if (rs.Success) MudDialog.Close(DialogResult.Ok(true));
    }
}
