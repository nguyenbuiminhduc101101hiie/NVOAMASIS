@inherits NVOAMASIS.Components.Hr.HrPageBase

<MudDialog>
    <DialogContent>
        <div class="hr-payslip">
            <MudText Typo="Typo.h6" Align="Align.Center">@L("hr_pay_payslip") @PeriodName</MudText>
            <MudText Typo="Typo.body2" Align="Align.Center" Class="mb-3">
                <b>@S.EmployeeCode - @S.FullName</b> · @S.DepartmentName · @L("hr_contract_no"): @S.ContractNo
            </MudText>
            <MudSimpleTable Dense="true" Bordered="true">
                <tbody>
                    @Section(L("hr_pay_sec_days"))
                    @Line(L("hr_ts_standard"), S.StandardDays.ToString("0.##"))
                    @Line(L("hr_pay_paid_days"), S.PaidDays.ToString("0.##") + (S.PaidDaysOverride.HasValue ? " *" : ""))

                    @Section(L("hr_pay_sec_income"))
                    @Line(L("hr_base_salary"), N(S.BaseSalary))
                    @Line(L("hr_pay_salary_by_days"), N(S.SalaryByDays))
                    @Line(L("hr_pay_allowance_amount"), N(S.AllowanceAmount))
                    @LineIf(L("hr_pay_overtime"), S.Overtime)
                    @LineIf(L("hr_pay_bonus"), S.Bonus)
                    @LineIf(L("hr_pay_other_income"), S.OtherIncome)
                    @LineIf(L("hr_pay_non_taxable"), S.NonTaxableIncome)
                    @Line(L("hr_pay_gross"), N(S.GrossIncome), true)

                    @Section(L("hr_pay_sec_deduction"))
                    @Line($"{L("hr_pay_emp_social")} ({N(S.InsuranceBase)})", N(S.EmpSocial))
                    @Line(L("hr_pay_emp_health"), N(S.EmpHealth))
                    @Line(L("hr_pay_emp_unemployment"), N(S.EmpUnemployment))
                    @if (S.TaxMode == HrTaxMode.Progressive)
                    {
                        @Line($"{L("hr_pay_family_deduction")} ({S.Dependents} {L("hr_pay_dependents_short")})", N(S.FamilyDeduction))
                        @Line(L("hr_pay_assessable"), N(S.AssessableIncome))
                    }
                    @Line($"{L("hr_pay_pit")} ({L(HrTaxMode.Key(S.TaxMode))})", N(S.PersonalIncomeTax))
                    @LineIf(L("hr_pay_advance"), S.Advance)
                    @LineIf(L("hr_pay_other_deduction"), S.OtherDeduction)
                    @Line(L("hr_pay_total_deduction"), N(S.TotalDeduction), true)

                    <tr style="background:#e8f5e9">
                        <td><b>@L("hr_pay_net")</b></td>
                        <td style="text-align:right"><MudText Typo="Typo.h6"><b>@N(S.NetPay)</b></MudText></td>
                    </tr>
                    @if (!string.IsNullOrWhiteSpace(S.BankAccountNo))
                    {
                        @Line(L("hr_bank_account"), $"{S.BankAccountNo} - {S.BankName}")
                    }
                    @if (!string.IsNullOrWhiteSpace(S.Note))
                    {
                        @Line(L("hr_note"), S.Note)
                    }
                </tbody>
            </MudSimpleTable>
            @if (ShowEmployerPart)
            {
                <MudText Typo="Typo.caption" Class="mt-2 d-block">
                    @string.Format(L("hr_pay_employer_part"), N(S.CoSocial), N(S.CoHealth), N(S.CoUnemployment), N(S.CoUnionFee), N(S.EmployerCost))
                </MudText>
            }
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => MudDialog.Close())">@L("hr_close")</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private MudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public HrPayslip S { get; set; } = new();
    [Parameter] public string PeriodName { get; set; } = string.Empty;
    [Parameter] public bool ShowEmployerPart { get; set; }

    private RenderFragment Section(string title) => __builder =>
    {
        <tr style="background:#f5f5f5"><td colspan="2"><b>@title</b></td></tr>
    };

    private RenderFragment Line(string label, string? value, bool bold = false) => __builder =>
    {
        <tr>
            <td>@(bold ? (MarkupString)$"<b>{System.Net.WebUtility.HtmlEncode(label)}</b>" : (MarkupString)System.Net.WebUtility.HtmlEncode(label))</td>
            <td style="text-align:right">@(bold ? (MarkupString)$"<b>{System.Net.WebUtility.HtmlEncode(value ?? "")}</b>" : (MarkupString)System.Net.WebUtility.HtmlEncode(value ?? ""))</td>
        </tr>
    };

    private RenderFragment LineIf(string label, decimal v) => __builder =>
    {
        if (v != 0)
        {
            @Line(label, N(v))
        }
    };
}
