@inherits NVOAMASIS.Components.Hr.HrPageBase
@inject HrEmployeeService EmployeeSvc

<MudDataGrid T="HrEmployeeHistory" Items="_items" Dense="true" Striped="true" Bordered="true" Hover="true"
             Loading="_loading" Height="440px" FixedHeader="true">
    <Columns>
        <PropertyColumn Property="x => x.CreatedAt" Title="@L("hr_recorded_at")" Format="dd/MM/yyyy HH:mm" />
        <PropertyColumn Property="x => x.EffectiveDate" Title="@L("hr_effective_date")" Format="dd/MM/yyyy" />
        <TemplateColumn Title="@L("hr_change_type")">
            <CellTemplate>@L(HrChangeType.Key(context.Item.ChangeType))</CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="@L("hr_old_value")">
            <CellTemplate>@LMaybe(context.Item.OldValue)</CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="@L("hr_new_value")">
            <CellTemplate><b>@LMaybe(context.Item.NewValue)</b></CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="@L("hr_note")">
            <CellTemplate>@LMaybe(context.Item.Note)</CellTemplate>
        </TemplateColumn>
        <PropertyColumn Property="x => x.CreatedBy" Title="@L("hr_by_user")" />
    </Columns>
    <NoRecordsContent>
        <MudText Typo="Typo.body2">@L("hr_no_items")</MudText>
    </NoRecordsContent>
</MudDataGrid>

@code {
    [Parameter] public Guid EmployeeId { get; set; }

    private bool _loading = true;
    private List<HrEmployeeHistory> _items = new();

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            _loading = true;
            _items = await EmployeeSvc.GetHistoryAsync(EmployeeId);
        }
        finally
        {
            _loading = false;
        }
    }
}
