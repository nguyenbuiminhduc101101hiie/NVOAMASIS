@using MudBlazor

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Ghi chú trên Hóa đơn</MudText>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mb-2" Color="Color.Secondary">
            Nội dung này sẽ được gửi thành 1 item riêng trên Hóa đơn (ItemTypeID = 4). Bạn có thể chỉnh sửa trước khi lưu.
        </MudText>
        <MudTextField @bind-Value="_text"
                      Label="Nội dung ghi chú"
                      Lines="4"
                      AutoGrow="true"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense" />
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="Cancel">Hủy</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Ok">Lưu ghi chú</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private MudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public string InitialText { get; set; } = string.Empty;

    private string _text = string.Empty;

    protected override void OnInitialized()
    {
        _text = InitialText;
    }

    private void Cancel() => MudDialog.Cancel();

    private void Ok() => MudDialog.Close(DialogResult.Ok(_text));
}
