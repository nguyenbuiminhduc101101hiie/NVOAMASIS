    private async Task RunAction(Func<BkavInvoiceGroup, Task<BkavInvoiceOperationResult>> action, string actionName)
    {
        if (!HasSelectedGroup)
        {
            SetMessage(Localizer["BkavNew.SelectRequired"].Value, MudBlazor.Severity.Warning);
            return;
        }

        var current = new BkavInvoiceGroup
        {
            InternalInvoiceNo = _internalInvoiceNo.Trim(),
            CustomerId = _selectedCustomerId
        };

        try
        {
            _busy = true;
            var result = await action(current);
            if (!string.IsNullOrWhiteSpace(result.ObjectText))
                _lastObjectText = result.ObjectText;
            else if (!string.IsNullOrWhiteSpace(result.Message))
                _lastObjectText = result.Message;

            var visibleResult = FirstNonEmpty(result.ObjectText, result.Message, result.Link, result.FilePath);
            if (actionName is "GetInfo" or "GetStatus" or "GetHistory")
                _step2Result = visibleResult;
            else if (actionName is "Update204" or "Update200" or "Update203" or "Replace120" or "Adjust121")
                _step3Result = visibleResult;

            if (result.Group != null)
                ApplyGroupFields(result.Group);

            var detail = FirstNonEmpty(result.Message, result.Link, result.FilePath);
            SetMessage($"{actionName}: {detail}", result.Success ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
            await DownloadResultFileAsync(result);

            // Refresh list quietly so grid shows latest BKAV fields
            _groups = await bkavsv.GetInvoiceGroupsAsync();
            if (result.Group != null)
            {
                var refreshed = _groups.FirstOrDefault(x =>
                    x.CustomerId == result.Group.CustomerId &&
                    string.Equals(x.InternalInvoiceNo, result.Group.InternalInvoiceNo, StringComparison.OrdinalIgnoreCase));
                if (refreshed != null)
                    ApplyGroupFields(refreshed);
            }
        }
        catch (Exception ex)
        {
            SetMessage($"{actionName}: {ex.Message}", MudBlazor.Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private BkavInvoiceActionInput BuildInput()
