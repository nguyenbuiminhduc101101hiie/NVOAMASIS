            invoiceNo = parsed;

        return new BkavInvoiceActionInput
        {
            CommandType = _createCommandType,
            InvoiceForm = _invoiceForm,
            InvoiceSerial = _invoiceSerial,
            InvoiceNo = invoiceNo,
            OriginalInvoiceIdentify = _originalIdentify,
            Reason = _reason,
            AdjustmentIsIncrease = _adjustmentIsIncrease,
            InvoiceGuid = _invoiceGuid,
            PartnerInvoiceID = ParsePartnerInvoiceId(_partnerInvoiceId),
            SumItemAmount = _sumItemAmount,
            SumDiscountAmount = _sumDiscountAmount,
            SumTaxAmount = _sumTaxAmount,
            SumPaymentAmount = _sumPaymentAmount,
            PayMethodID = _payMethodId,
            TaxCode = _taxCode,
            // Status local; CreateDraft/Publish map theo CmdType FAQ (1/11/2), không gửi InvoiceStatusID lên wire
            InvoiceStatusID = _selected?.BkavStatusID ?? BkavInvoiceStatusIds.WaitingSign
        };
    }

    private BkavInvoiceRuntimeCredentials? GetRuntimeCredentials()
    {
        if (string.IsNullOrWhiteSpace(PartnerGuid) && string.IsNullOrWhiteSpace(PartnerToken))
            return null;

        return new BkavInvoiceRuntimeCredentials
        {
            PartnerGuid = PartnerGuid,
            PartnerToken = PartnerToken
        };
    }

    private async Task OpenCredentialDialog()
    {
        var parameters = new DialogParameters
        {
            [nameof(InvoiceBkavCredentialDialog.PartnerGuid)] = PartnerGuid,
            [nameof(InvoiceBkavCredentialDialog.PartnerToken)] = PartnerToken,
            [nameof(InvoiceBkavCredentialDialog.SavedAt)] = CredentialSavedAt,
            [nameof(InvoiceBkavCredentialDialog.HasServerCredentials)] = bkavsv.HasServerCredentials
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true };
        var dialog = await DialogService.ShowAsync<InvoiceBkavCredentialDialog>(Localizer["BkavInvoice.Credential.Title"], parameters, options);
        var result = await dialog.Result;

        if (result.Canceled || result.Data is not InvoiceBkavCredentialDialog.Result credentialResult)
            return;

        if (credentialResult.Action == InvoiceBkavCredentialDialog.ResultAction.Clear)
        {
            await JSRuntime.InvokeVoidAsync("nvoccClearBkavInvoiceCredentials");
            PartnerGuid = string.Empty;
            PartnerToken = string.Empty;
            CredentialSavedAt = string.Empty;
            SetMessage(Localizer["BkavInvoice.Credential.Cleared"].Value, MudBlazor.Severity.Info);
            return;
        }

        var saved = await JSRuntime.InvokeAsync<BkavBrowserCredentials?>("nvoccSetBkavInvoiceCredentials", credentialResult.PartnerGuid, credentialResult.PartnerToken);
        PartnerGuid = credentialResult.PartnerGuid;
        PartnerToken = credentialResult.PartnerToken;
        CredentialSavedAt = FormatSavedAt(saved?.SavedAt);
        SetMessage(Localizer["BkavInvoice.Credential.Saved"].Value, MudBlazor.Severity.Success);
    }

    private async Task LoadBrowserCredentialsAsync()
    {
        try
        {
            var credentials = await JSRuntime.InvokeAsync<BkavBrowserCredentials?>("nvoccGetBkavInvoiceCredentials");
            if (credentials == null)
                return;

            PartnerGuid = credentials.PartnerGuid?.Trim() ?? string.Empty;
            PartnerToken = credentials.PartnerToken?.Trim() ?? string.Empty;
            CredentialSavedAt = FormatSavedAt(credentials.SavedAt);
        }
        catch
        {
            PartnerGuid = string.Empty;
            PartnerToken = string.Empty;
            CredentialSavedAt = string.Empty;
        }
    }

    private void SetMessage(string message, MudBlazor.Severity severity)
    {
        _message = message;
        _msgSeverity = severity;
        Snackbar.Configuration.SnackbarVariant = Variant.Filled;
        Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopRight;
        Snackbar.Add(message, severity);
    }

    private static bool Contains(string? value, string filter)
        => value?.Contains(filter, StringComparison.OrdinalIgnoreCase) == true;

    private static Task<IEnumerable<string>> SearchInvoiceForms(string value)
    {
        IEnumerable<string> result = string.IsNullOrWhiteSpace(value)
            ? InvoiceFormOptions
            : InvoiceFormOptions.Where(x => x.Contains(value, StringComparison.OrdinalIgnoreCase));
        return Task.FromResult(result);
    }

    private static Task<IEnumerable<string>> SearchInvoiceSerials(string value)
    {
        IEnumerable<string> result = string.IsNullOrWhiteSpace(value)
            ? InvoiceSerialOptions
            : InvoiceSerialOptions.Where(x => x.Contains(value, StringComparison.OrdinalIgnoreCase));
        return Task.FromResult(result);
    }

    private static string FormatSavedAt(string? savedAt)
    {
        if (string.IsNullOrWhiteSpace(savedAt))
            return string.Empty;

        return DateTimeOffset.TryParse(savedAt, CultureInfo.InvariantCulture, DateTimeStyles.AssumeUniversal, out var parsed)
            ? parsed.LocalDateTime.ToString("dd/MM/yyyy HH:mm:ss", CultureInfo.CurrentCulture)
            : savedAt;
    }

    private static string FirstNonEmpty(params string?[] values)
        => values.FirstOrDefault(x => !string.IsNullOrWhiteSpace(x))?.Trim() ?? string.Empty;

    private static long? ParsePartnerInvoiceId(string? value)
        => long.TryParse(value?.Trim(), NumberStyles.Integer, CultureInfo.InvariantCulture, out var parsed) && parsed > 0
            ? parsed
            : null;

    private void ApplyInvoiceTotals(BkavInvoiceGroup group)
    {
        _sumItemAmount = group.TotalBeforeTax;
        _sumDiscountAmount = 0;
        _sumTaxAmount = group.TotalAfterTax - group.TotalBeforeTax;
        _sumPaymentAmount = group.TotalAfterTax;
    }

    private async Task<bool> ConfirmFractionalTotalsAsync()
    {
        var fractionalValues = new[]
        {
            (Label: "Tổng tiền hàng trước thuế", Value: _sumItemAmount),
            (Label: "Tổng chiết khấu", Value: _sumDiscountAmount),
            (Label: "Tổng tiền thuế", Value: _sumTaxAmount),
            (Label: "Tổng thanh toán", Value: _sumPaymentAmount)
        }
        .Where(x => x.Value.HasValue && HasFractionalPart(x.Value.Value))
        .Select(x => $"• {x.Label}: {x.Value!.Value.ToString("N2", CultureInfo.CurrentCulture)}")
        .ToList();

        if (fractionalValues.Count == 0)
            return true;

        var message =
            "Các tổng tiền sau đang có phần lẻ:\n\n" +
            string.Join("\n", fractionalValues) +
            "\n\nBạn có thể quay lại chỉnh thành số nguyên hoặc vẫn tiếp tục gửi BKAV.";

        SetMessage("Cảnh báo: tổng tiền hóa đơn đang có phần lẻ.", MudBlazor.Severity.Warning);
        var confirmed = await DialogService.ShowMessageBox(
            "Cảnh báo số tiền lẻ",
            message,
            yesText: "Vẫn gửi",
            cancelText: "Quay lại chỉnh");

        return confirmed == true;
    }

    private static bool HasFractionalPart(double value)
        => Math.Abs(value - Math.Round(value)) > 0.0000001d;

    private async Task DownloadResultFileAsync(BkavInvoiceOperationResult result)
    {
        if (!result.Success || string.IsNullOrWhiteSpace(result.FilePath))
            return;

        // FilePath do service trả về là đường dẫn tương đối dưới wwwroot.
        // Thêm '/' để trình duyệt tải từ application root thay vì route hiện tại.
        var downloadUrl = "/" + result.FilePath.Trim().TrimStart('/', '\\').Replace('\\', '/');
        await JSRuntime.InvokeVoidAsync("downloadFileFromUrl", downloadUrl);
    }

    private sealed class BkavBrowserCredentials
    {
        [JsonPropertyName("partnerGuid")]
        public string? PartnerGuid { get; set; }

        [JsonPropertyName("partnerToken")]
        public string? PartnerToken { get; set; }

        [JsonPropertyName("savedAt")]
        public string? SavedAt { get; set; }
    }
