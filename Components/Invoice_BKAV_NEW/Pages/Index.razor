@inject BkavInvoiceService bkavsv
@inject IStringLocalizer<SharedResource> Localizer
@inject IDialogService DialogService
@inject IJSRuntime JSRuntime
@inject ISnackbar Snackbar
@attribute [Authorize]
@using System.Globalization
@using System.Text.Json.Serialization
@using NVOAMASIS.Components.Invoice_BKAV.Pages

<PageTitle>@Localizer["BkavNew.Title"]</PageTitle>

<div class="product-price-page">
    <PpScreenHeader Title="@Localizer["BkavNew.Title"]" Subtitle="@Localizer["BkavNew.Subtitle"]" />
    <MudPaper Class="product-price-card" Elevation="0">
        <MudContainer MaxWidth="MaxWidth.False" Class="pa-3">
            @if (!IsBkavConfigured)
            {
                <MudAlert Severity="MudBlazor.Severity.Warning" Dense="true" Class="mb-3">
                    @Localizer["BkavInvoice.ConfigMissing"]
                </MudAlert>
            }

            <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center" Class="mb-3 flex-wrap">
                <MudTooltip Text="@Localizer["BkavInvoice.Credential.Title"]">
                    <MudIconButton OnClick="@OpenCredentialDialog"
                                   Size="Size.Small"
                                   Color="@(IsBkavConfigured ? Color.Success : Color.Warning)"
                                   Variant="Variant.Filled"
                                   Icon="@Icons.Material.Filled.Key"
                                   Disabled="@_busy" />
                </MudTooltip>
                <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined">
                    Mode=@(_useXmlLabel)
                </MudChip>
                <MudSpacer />
                <MudText Typo="Typo.caption" Color="Color.Secondary">@Localizer["BkavNew.Note"]</MudText>
            </MudStack>

            @* ===== Bước 0 ===== *@
            <MudPaper Class="pa-3 mb-3" Outlined="true">
                <MudStack Spacing="2">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <MudText Typo="Typo.subtitle1"><b>@Localizer["BkavNew.Step0"]</b></MudText>
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.CloudDownload"
                                   OnClick="@LoadGroups"
                                   Disabled="@_busy">
                            @Localizer["BkavNew.LoadInvoices"]
                        </MudButton>
                        <MudTextField @bind-Value="_filter"
                                      Placeholder="@Localizer["BkavNew.Filter"]"
                                      Immediate="true"
                                      Dense="true"
                                      Margin="Margin.Dense"
                                      Variant="Variant.Outlined"
                                      Style="max-width:260px" />
                    </MudStack>

                    <MudDataGrid T="BkavInvoiceGroup"
                                 Items="@FilteredGroups"
                                 Dense="true"
                                 Bordered="true"
                                 Hover="true"
                                 Loading="_loading"
                                 Height="220px"
                                 FixedHeader="true"
                                 Virtualize="true"
                                 RowClick="@OnGroupRowClick"
                                 Class="bkav-new-grid">
                        <Columns>
                            <TemplateColumn Title="" Filterable="false" Sortable="false" Width="70px">
                                <CellTemplate>
                                    <MudButton Size="Size.Small"
                                               Variant="Variant.Text"
                                               Color="Color.Primary"
                                               OnClick="@(() => SelectGroup(context.Item))">
                                        @Localizer["BkavNew.Select"]
                                    </MudButton>
                                </CellTemplate>
                            </TemplateColumn>
                            <PropertyColumn Property="x => x.InternalInvoiceNo" Title="@Localizer["BkavNew.Col.InternalNo"]" />
                            <PropertyColumn Property="x => x.HblNo" Title="@Localizer["BkavNew.Col.HblNo"]" />
                            <PropertyColumn Property="x => x.CustomerName" Title="@Localizer["Customer"]" />
                            <PropertyColumn Property="x => x.ItemNames" Title="@Localizer["BkavNew.Col.Items"]" />
                            <PropertyColumn Property="x => x.InvoiceDate" Title="@Localizer["BkavNew.Col.Date"]" Format="dd/MM/yyyy" />
                            <PropertyColumn Property="x => x.LineCount" Title="@Localizer["BkavNew.Col.Lines"]" />
                            <PropertyColumn Property="x => x.TotalBeforeTax" Title="@Localizer["BkavNew.Col.Amount"]" Format="N0" />
                            <PropertyColumn Property="x => x.TotalAfterTax" Title="@Localizer["BkavNew.Col.AmountVat"]" Format="N0" />
                            <PropertyColumn Property="x => x.Currency" Title="@Localizer["BkavNew.Col.Currency"]" />
                            <PropertyColumn Property="x => x.ElectronicInvoiceNo" Title="@Localizer["BkavNew.Col.EInvoice"]" />
                            <PropertyColumn Property="x => x.BkavPartnerInvoiceID" Title="PartnerInvoiceID" />
                            <PropertyColumn Property="x => x.BkavInvoiceGUID" Title="InvoiceGUID" />
                            <PropertyColumn Property="x => x.BkavInvoiceNo" Title="InvoiceNo" />
                            <PropertyColumn Property="x => x.BkavStatusID" Title="Status" />
                        </Columns>
                    </MudDataGrid>

                    @if (_selected != null)
                    {
                        <MudAlert Severity="MudBlazor.Severity.Info" Dense="true">
                            @Localizer["BkavNew.Selected"]: <b>@_selected.InternalInvoiceNo</b> — @_selected.CustomerName
                        </MudAlert>
                    }
                </MudStack>
            </MudPaper>

            @* ===== Bước 1 ===== *@
            <MudPaper Class="pa-3 mb-3" Outlined="true">
                <MudText Typo="Typo.subtitle1" Class="mb-2"><b>@Localizer["BkavNew.Step1"]</b></MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-2">
                    @Localizer["BkavNew.Step1.Hint"]
                </MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-2">
                    @Localizer["BkavNew.Cmd.Hint"]
                </MudText>
                <MudStack Row="true" Spacing="2" Class="flex-wrap" AlignItems="AlignItems.End">
                    <MudTextField @bind-Value="_internalInvoiceNo"
                                  Label="@Localizer["BkavNew.Col.InternalNo"]"
                                  Dense="true"
                                  Margin="Margin.Dense"
                                  Variant="Variant.Outlined"
                                  Style="min-width:180px" />
                    <MudSelect T="int"
                               @bind-Value="_createCommandType"
                               Label="@Localizer["BkavInvoice.Input.Command"]"
                               Dense="true"
                               Margin="Margin.Dense"
                               Variant="Variant.Outlined"
                               Style="min-width:420px">
                        <MudSelectItem T="int" Value="@BkavInvoiceCommandTypes.CreateInvoiceMT">
                            100 — @Localizer["BkavNew.Cmd.100"]
                        </MudSelectItem>
                        <MudSelectItem T="int" Value="@BkavInvoiceCommandTypes.CreateInvoiceTR">
                            101 — @Localizer["BkavNew.Cmd.101"]
                        </MudSelectItem>
                        <MudSelectItem T="int" Value="@BkavInvoiceCommandTypes.CreateInvoiceWithFormSerial">
                            110 — @Localizer["BkavNew.Cmd.110"]
                        </MudSelectItem>
                        <MudSelectItem T="int" Value="@BkavInvoiceCommandTypes.CreateInvoiceWithFormSerialNo">
                            111 — @Localizer["BkavNew.Cmd.111"]
                        </MudSelectItem>
                        <MudSelectItem T="int" Value="@BkavInvoiceCommandTypes.CreateInvoiceWithFormSerialBkavNo">
                            112 — @Localizer["BkavNew.Cmd.112"]
                        </MudSelectItem>
                    </MudSelect>
                    <MudSelect T="int"
                               @bind-Value="_payMethodId"
                               Label="@Localizer["BkavInvoice.Input.Pay"]"
                               Dense="true"
                               Margin="Margin.Dense"
                               Variant="Variant.Outlined"
                               Style="min-width:140px">
                        <MudSelectItem T="int" Value="1">@Localizer["BkavInvoice.Pay.Cash"]</MudSelectItem>
                        <MudSelectItem T="int" Value="2">@Localizer["BkavInvoice.Pay.Transfer"]</MudSelectItem>
                        <MudSelectItem T="int" Value="3">@Localizer["BkavInvoice.Pay.CashTransfer"]</MudSelectItem>
                    </MudSelect>
                    <MudAutocomplete T="string"
                                     @bind-Value="_invoiceForm"
                                     Label="@Localizer["BkavInvoice.Input.Form"]"
                                     SearchFunc="SearchInvoiceForms"
                                     CoerceText="true"
                                     CoerceValue="true"
                                     Strict="false"
                                     Clearable="true"
                                     Dense="true"
                                     Margin="Margin.Dense"
                                     Variant="Variant.Outlined"
                                     Style="min-width:120px" />
                    <MudAutocomplete T="string"
                                     @bind-Value="_invoiceSerial"
                                     Label="@Localizer["BkavInvoice.Input.Serial"]"
                                     SearchFunc="SearchInvoiceSerials"
                                     CoerceText="true"
                                     CoerceValue="true"
                                     Strict="false"
                                     Clearable="true"
                                     Dense="true"
                                     Margin="Margin.Dense"
                                     Variant="Variant.Outlined"
                                     Style="min-width:140px" />
                    <MudTextField @bind-Value="_invoiceNoText"
                                  Label="@Localizer["BkavInvoice.Input.No"]"
                                  Dense="true"
                                  Margin="Margin.Dense"
                                  Variant="Variant.Outlined"
                                  Style="min-width:100px" />
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Warning"
                               Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.Save"
                                   OnClick="@CreateDraft"
                                   Disabled="@(_busy || !IsBkavConfigured || !HasSelectedGroup || !BkavInvoiceCommandTypes.IsDraftCreateCommandType(_createCommandType))">
                        @Localizer["BkavNew.CreateDraft"]
                    </MudButton>
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Error"
                               Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.Verified"
                                   OnClick="@PublishInvoice"
                                   Disabled="@(_busy || !IsBkavConfigured || !HasSelectedGroup || (!HasInvoiceGuid && !BkavInvoiceCommandTypes.IsIssueCreateCommandType(_createCommandType)))">
                        @Localizer["BkavNew.Publish"]
                    </MudButton>
                </MudStack>
                <MudStack Row="true" Spacing="2" Class="mt-3 flex-wrap" AlignItems="AlignItems.End">
                    <MudNumericField T="double?" @bind-Value="_sumItemAmount"
                                     Label="Tổng tiền hàng trước thuế"
                                     Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined"
                                     Format="N2" Style="min-width:210px" />
                    <MudNumericField T="double?" @bind-Value="_sumDiscountAmount"
                                     Label="Tổng chiết khấu"
                                     Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined"
                                     Format="N2" Style="min-width:180px" />
                    <MudNumericField T="double?" @bind-Value="_sumTaxAmount"
                                     Label="Tổng tiền thuế"
                                     Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined"
                                     Format="N2" Style="min-width:180px" />
                    <MudNumericField T="double?" @bind-Value="_sumPaymentAmount"
                                     Label="Tổng thanh toán"
                                     Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined"
                                     Format="N2" Style="min-width:180px" />
                </MudStack>
            </MudPaper>

            @* ===== Bước 2 ===== *@
            <MudPaper Class="pa-3 mb-3" Outlined="true">
                <MudText Typo="Typo.subtitle1" Class="mb-2"><b>@Localizer["BkavNew.Step2"]</b></MudText>
                <MudStack Row="true" Spacing="2" Class="flex-wrap" AlignItems="AlignItems.End">
                    <MudTextField @bind-Value="_invoiceGuid"
                                  Label="InvoiceGUID"
                                  Dense="true"
                                  Margin="Margin.Dense"
                                  Variant="Variant.Outlined"
                                  Style="min-width:320px" />
                    <MudButton Variant="Variant.Outlined" Color="Color.Info" Size="Size.Small" OnClick="@GetInfo" Disabled="@BusyOrNoConfig">
                        @Localizer["BkavNew.GetInfo"]
                    </MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Info" Size="Size.Small" OnClick="@GetStatus" Disabled="@BusyOrNoConfig">
                        @Localizer["BkavNew.GetStatus"]
                    </MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Info" Size="Size.Small" OnClick="@GetHistory" Disabled="@BusyOrNoConfig">
                        @Localizer["BkavNew.GetHistory"]
                    </MudButton>
                </MudStack>
                @if (!string.IsNullOrWhiteSpace(_step2Result))
                {
                    <MudTextField Value="@_step2Result"
                                  Label="Kết quả Step 2"
                                  Lines="10"
                                  ReadOnly="true"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Class="mt-3 bkav-result-payload" />
                }
            </MudPaper>

            @* ===== Bước 3 ===== *@
            <MudPaper Class="pa-3 mb-3" Outlined="true">
                <MudText Typo="Typo.subtitle1" Class="mb-2"><b>@Localizer["BkavNew.Step3"]</b></MudText>
                <MudStack Row="true" Spacing="2" Class="flex-wrap" AlignItems="AlignItems.End">
                    <MudTextField @bind-Value="_partnerInvoiceId"
                                  Label="PartnerInvoiceID"
                                  Dense="true"
                                  Margin="Margin.Dense"
                                  Variant="Variant.Outlined"
                                  Style="min-width:200px" />
                    <MudTextField @bind-Value="_originalIdentify"
                                  Label="@Localizer["BkavInvoice.Input.OriginalIdentify"]"
                                  Dense="true"
                                  Margin="Margin.Dense"
                                  Variant="Variant.Outlined"
                                  Style="min-width:280px" />
                    <MudTextField @bind-Value="_reason"
                                  Label="Lý do thay thế/điều chỉnh"
                                  Dense="true"
                                  Margin="Margin.Dense"
                                  Variant="Variant.Outlined"
                                  Style="min-width:280px" />
                    <MudSelect T="bool?"
                               @bind-Value="_adjustmentIsIncrease"
                               Label="Hướng điều chỉnh"
                               Dense="true"
                               Margin="Margin.Dense"
                               Variant="Variant.Outlined"
                               Clearable="true"
                               Style="min-width:180px">
                        <MudSelectItem T="bool?" Value="@((bool?)true)">Điều chỉnh tăng</MudSelectItem>
                        <MudSelectItem T="bool?" Value="@((bool?)false)">Điều chỉnh giảm</MudSelectItem>
                    </MudSelect>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" OnClick="@UpdateByGuid" Disabled="@BusyOrNoConfig">
                        @Localizer["BkavNew.UpdateByGuid"]
                    </MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" OnClick="@UpdateByPartner" Disabled="@BusyOrNoConfig">
                        @Localizer["BkavNew.UpdateByPartner"]
                    </MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" OnClick="@UpdateByFormSerialNo" Disabled="@BusyOrNoConfig">
                        Update by Form/Serial/No (203)
                    </MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Warning" Size="Size.Small" OnClick="@ReplaceInvoice" Disabled="@BusyOrNoConfig">
                        @Localizer["BkavNew.Replace"]
                    </MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Warning" Size="Size.Small" OnClick="@AdjustInvoice" Disabled="@BusyOrNoConfig">
                        @Localizer["BkavNew.Adjust"]
                    </MudButton>
                </MudStack>
                @if (!string.IsNullOrWhiteSpace(_step3Result))
                {
                    <MudTextField Value="@_step3Result"
                                  Label="Kết quả Step 3"
                                  Lines="10"
                                  ReadOnly="true"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Class="mt-3 bkav-result-payload" />
                }
            </MudPaper>

            @* ===== Bước 4 ===== *@
            <MudPaper Class="pa-3 mb-3" Outlined="true">
                <MudText Typo="Typo.subtitle1" Class="mb-2"><b>@Localizer["BkavNew.Step4"]</b></MudText>
                <MudStack Row="true" Spacing="2" Class="flex-wrap" AlignItems="AlignItems.End">
                    <MudTextField @bind-Value="_cancelPartnerInvoiceId"
                                  Label="PartnerInvoiceID"
                                  Dense="true"
                                  Margin="Margin.Dense"
                                  Variant="Variant.Outlined"
                                  Style="min-width:280px" />
                    <MudButton Variant="Variant.Filled" Color="Color.Error" Size="Size.Small" OnClick="@CancelByGuid" Disabled="@BusyOrNoConfig">
                        @Localizer["BkavNew.CancelByGuid"]
                    </MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Error" Size="Size.Small" OnClick="@CancelByPartner" Disabled="@BusyOrNoConfig">
                        @Localizer["BkavNew.CancelByPartner"]
                    </MudButton>
                </MudStack>
            </MudPaper>

            @* ===== Bước 5 ===== *@
            <MudPaper Class="pa-3 mb-3" Outlined="true">
                <MudText Typo="Typo.subtitle1" Class="mb-2"><b>@Localizer["BkavNew.Step5"]</b></MudText>
                <MudStack Row="true" Spacing="2" Class="flex-wrap" AlignItems="AlignItems.End">
                    <MudTextField @bind-Value="_deletePartnerInvoiceId"
                                  Label="PartnerInvoiceID"
                                  Dense="true"
                                  Margin="Margin.Dense"
                                  Variant="Variant.Outlined"
                                  Style="min-width:280px" />
                    <MudButton Variant="Variant.Filled" Color="Color.Error" Size="Size.Small" OnClick="@DeleteByGuid" Disabled="@BusyOrNoConfig">
                        @Localizer["BkavNew.DeleteByGuid"]
                    </MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Error" Size="Size.Small" OnClick="@DeleteByPartner" Disabled="@BusyOrNoConfig">
                        @Localizer["BkavNew.DeleteByPartner"]
                    </MudButton>
                </MudStack>
            </MudPaper>

            @* ===== Bước 6 ===== *@
            <MudPaper Class="pa-3 mb-3" Outlined="true">
                <MudText Typo="Typo.subtitle1" Class="mb-2"><b>@Localizer["BkavNew.Step6"]</b></MudText>
                <MudStack Row="true" Spacing="2" Class="flex-wrap" AlignItems="AlignItems.End">
                    <MudTextField @bind-Value="_filePartnerInvoiceId"
                                  Label="PartnerInvoiceID"
                                  Dense="true"
                                  Margin="Margin.Dense"
                                  Variant="Variant.Outlined"
                                  Style="min-width:200px" />
                    <MudButton Variant="Variant.Filled" Color="Color.Warning" Size="Size.Small" OnClick="@DownloadPdf" Disabled="@BusyOrNoConfig">
                        @Localizer["BkavNew.GetPdf"]
                    </MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small" OnClick="@DownloadXml" Disabled="@BusyOrNoConfig">
                        @Localizer["BkavNew.GetXml"]
                    </MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Size="Size.Small" OnClick="@GetLink" Disabled="@BusyOrNoConfig">
                        @Localizer["BkavNew.GetLink"]
                    </MudButton>
                </MudStack>
            </MudPaper>

            @* ===== Bước 7 ===== *@
            <MudPaper Class="pa-3 mb-3" Outlined="true">
                <MudText Typo="Typo.subtitle1" Class="mb-2"><b>Bước 7: Ký nhiều / Đính kèm file / Trạng thái CQT / Gửi lại email / Tra cứu</b></MudText>

                <MudStack Row="true" Spacing="2" Class="flex-wrap mb-3" AlignItems="AlignItems.End">
                    <MudTextField @bind-Value="_signManyGuids"
                                  Label="Danh sách InvoiceGUID (mỗi dòng 1 GUID)"
                                  Lines="3"
                                  Dense="true"
                                  Margin="Margin.Dense"
                                  Variant="Variant.Outlined"
                                  Style="min-width:320px" />
                    <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small" OnClick="@SignMany" Disabled="@(_busy || !IsBkavConfigured)">
                        Ký nhiều (HSM 206)
                    </MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Info" Size="Size.Small" OnClick="@GetTaxStatus" Disabled="@BusyOrNoConfig">
                        Trạng thái + mã CQT (850)
                    </MudButton>
                </MudStack>

                <MudStack Row="true" Spacing="2" Class="flex-wrap mb-3" AlignItems="AlignItems.End">
                    <MudFileUpload T="IBrowserFile" FilesChanged="@OnAttachFileSelected" Accept=".pdf,.xlsx,.xls,.doc,.docx">
                        <ActivatorContent>
                            <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Size="Size.Small" StartIcon="@Icons.Material.Filled.AttachFile">
                                @(_attachFileName.Length == 0 ? "Chọn file (PDF/Excel/Word)" : _attachFileName)
                            </MudButton>
                        </ActivatorContent>
                    </MudFileUpload>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" OnClick="@AttachFileByPartner" Disabled="@(BusyOrNoConfig || _attachFileBase64.Length == 0)">
                        Đính kèm theo PartnerInvoiceID (502)
                    </MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" OnClick="@AttachFileByGuid" Disabled="@(BusyOrNoConfig || _attachFileBase64.Length == 0)">
                        Đính kèm theo InvoiceGUID (503)
                    </MudButton>
                </MudStack>

                <MudStack Row="true" Spacing="2" Class="flex-wrap mb-3" AlignItems="AlignItems.End">
                    <MudTextField @bind-Value="_resendEmail"
                                  Label="Email nhận (tùy chọn, để trống dùng cấu hình cũ)"
                                  Dense="true"
                                  Margin="Margin.Dense"
                                  Variant="Variant.Outlined"
                                  Style="min-width:220px" />
                    <MudTextField @bind-Value="_resendMobile"
                                  Label="SĐT nhận (tùy chọn)"
                                  Dense="true"
                                  Margin="Margin.Dense"
                                  Variant="Variant.Outlined"
                                  Style="min-width:160px" />
                    <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Size="Size.Small" OnClick="@ResendLookupEmail" Disabled="@BusyOrNoConfig">
                        Gửi lại email tra cứu (901)
                    </MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Size="Size.Small" OnClick="@ResendLookupEmailTo" Disabled="@(BusyOrNoConfig || (_resendEmail.Length == 0 && _resendMobile.Length == 0))">
                        Gửi tới email/SĐT chỉ định (911)
                    </MudButton>
                </MudStack>

                <MudStack Row="true" Spacing="2" Class="flex-wrap mb-3" AlignItems="AlignItems.End">
                    <MudTextField @bind-Value="_rangeInvoiceForm" Label="Mẫu số" Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined" Style="min-width:100px" />
                    <MudTextField @bind-Value="_rangeInvoiceSerial" Label="Ký hiệu" Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined" Style="min-width:120px" />
                    <MudNumericField T="int" @bind-Value="_rangeFromNo" Label="Từ số" Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined" Style="min-width:100px" />
                    <MudNumericField T="int" @bind-Value="_rangeToNo" Label="Đến số" Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined" Style="min-width:100px" />
                    <MudButton Variant="Variant.Outlined" Color="Color.Info" Size="Size.Small" OnClick="@GetInvoicesByRange" Disabled="@(_busy || !IsBkavConfigured)">
                        Tra cứu theo dải số (810)
                    </MudButton>
                </MudStack>

                <MudStack Row="true" Spacing="2" Class="flex-wrap" AlignItems="AlignItems.End">
                    <MudTextField @bind-Value="_mtc" Label="Mã tra cứu (MTC)" Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined" Style="min-width:200px" />
                    <MudButton Variant="Variant.Outlined" Color="Color.Warning" Size="Size.Small" OnClick="@DownloadDisplayByMtc" Disabled="@(_busy || !IsBkavConfigured || _mtc.Length == 0)">
                        Bản thể hiện (811)
                    </MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Warning" Size="Size.Small" OnClick="@DownloadConvertByMtc" Disabled="@(_busy || !IsBkavConfigured || _mtc.Length == 0)">
                        Bản chuyển đổi (812)
                    </MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Success" Size="Size.Small" OnClick="@DownloadXmlByMtc" Disabled="@(_busy || !IsBkavConfigured || _mtc.Length == 0)">
                        XML theo MTC (813)
                    </MudButton>
                </MudStack>
            </MudPaper>

            @* ===== Extra ===== *@
            <MudPaper Class="pa-3 mb-3" Outlined="true">
                <MudText Typo="Typo.subtitle1" Class="mb-2"><b>@Localizer["BkavNew.Extra"]</b></MudText>
                <MudStack Row="true" Spacing="2" Class="flex-wrap" AlignItems="AlignItems.End">
                    <MudTextField @bind-Value="_taxCode"
                                  Label="@Localizer["BkavInvoice.Input.TaxCode"]"
                                  Dense="true"
                                  Margin="Margin.Dense"
                                  Variant="Variant.Outlined"
                                  Style="min-width:200px" />
                    <MudButton Variant="Variant.Outlined" Color="Color.Info" Size="Size.Small" OnClick="@GetTaxInfo" Disabled="@(_busy || !IsBkavConfigured)">
                        @Localizer["BkavNew.GetTax"]
                    </MudButton>
                    <MudTextField @bind-Value="_demoAccount"
                                  Label="@Localizer["BkavNew.DemoAccount"]"
                                  Dense="true"
                                  Margin="Margin.Dense"
                                  Variant="Variant.Outlined"
                                  ReadOnly="true"
                                  Style="min-width:220px" />
                    <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Size="Size.Small" OnClick="@CreateDemoAccount" Disabled="@(_busy || !IsBkavConfigured)">
                        @Localizer["BkavNew.CreateAccount"]
                    </MudButton>
                </MudStack>
            </MudPaper>

            <MudAlert Severity="@_msgSeverity" Dense="true" Class="mb-2" Style="@(_message.Length == 0 ? "display:none" : null)">
                @_message
            </MudAlert>

            @if (!string.IsNullOrWhiteSpace(_lastObjectText))
            {
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-1">
                    Nội dung dưới đây gồm: JSON gửi lên BKAV (Request — CommandObject + CommandData đầy đủ, trước khi nén/mã hoá) và phản hồi từ BKAV (Response), dùng để đối chiếu/debug.
                </MudText>
                <MudTextField @bind-Value="_lastObjectText"
