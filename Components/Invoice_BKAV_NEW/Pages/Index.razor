    private async Task OnAttachFileSelected(IBrowserFile? file)
    {
        try
        {
            if (file == null)
                return;

            const long maxSize = 5 * 1024 * 1024;
            await using var browserStream = file.OpenReadStream(maxAllowedSize: maxSize);
            using var memory = new MemoryStream();
            await browserStream.CopyToAsync(memory);
            _attachFileBase64 = Convert.ToBase64String(memory.ToArray());
            _attachFileName = Path.GetFileNameWithoutExtension(file.Name);
            _attachFileExtension = Path.GetExtension(file.Name).TrimStart('.');
            SetMessage($"Đã chọn file: {file.Name}", MudBlazor.Severity.Info);
        }
        catch (Exception ex)
        {
            SetMessage(ex.Message, MudBlazor.Severity.Error);
        }
    }

