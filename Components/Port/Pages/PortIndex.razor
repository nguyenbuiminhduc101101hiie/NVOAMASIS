@page "/sys/port"
@inject NavigationManager navSvc
@inject ILogger<Index> Logger
@inject IJSRuntime js
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject SharedServices ssv
@inject AccountService asv
@inject CustomerService csv
@inject SupportServices supsv
@inject IStringLocalizer<SharedResource> Localizer
@attribute [Authorize]
@inject HistoryLogService HistoryLogService
@using System.Text.Json;

<PageTitle>@Localizer["List Port"]</PageTitle>

<MudStack Row="true" Justify="Justify.FlexStart" Class="pa-4">
    <MudButton HtmlTag="label"
               OnClick="Refresh"
               Size="Size.Small" Color="Color.Primary" Variant="   Variant.Filled"
               StartIcon="@Icons.Material.Filled.Refresh">
        @Localizer["reload"]
    </MudButton>
    <MudButton HtmlTag="label"
               @onclick="@(() => AddItem())"
               Size="Size.Small" Color="Color.Secondary" Variant="Variant.Filled"
               StartIcon="@Icons.Material.Filled.Add">
        @Localizer["new"]
    </MudButton>
    <MudFileUpload T="IBrowserFile" Accept=".xlsx,.xls" FilesChanged="HandleImportPort" MaximumFileCount="1">
        <ButtonTemplate Context="btnCtx">
            <MudButton HtmlTag="label"
                       for="@btnCtx"
                       Size="Size.Small"
                       Color="Color.Tertiary"
                       Variant="Variant.Filled"
                       StartIcon="@Icons.Material.Filled.UploadFile"
                       Disabled="_processingUpload">
                @if (_processingUpload)
                {
                    <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                    <span>Processing</span>
                }
                else
                {
                    <span>@Localizer["ImportExcel"]</span>
                }
            </MudButton>
        </ButtonTemplate>
    </MudFileUpload>
    <a href="HDSDhtml/HDSD_PortList.html" target="_blank">
        <MudButton Color="Color.Info" Size=Size.Small StartIcon="@Icons.Material.Filled.Info">@Localizer["Help"]</MudButton>
    </a>

</MudStack>
<MudDataGrid T="PortModel" Items="@Listdata" Filterable="true" @ref="mudTable" QuickFilter="@FilterFunc1"
             FilterMode="@DataGridFilterMode.ColumnFilterRow" Dense="true" Virtualize="true" Bordered="true"
             FixedHeader="true" FixedFooter="true" HeaderClass="no-wrap" FooterClass="no-wrap"
             ReadOnly="false" CommittedItemChanges="@CommittedItem" RowClassFunc="SelectedRowClassFunc"
             ColumnResizeMode="ResizeMode.Column" Loading="_loading" RowContextMenuClick="RowRightClicked">
    <Columns>
        <TemplateColumn CellClass="d-flex justify-end">
            <CellTemplate>
                <MudIconButton Size="@Size.Small" Icon="@Icons.Material.Outlined.Edit" OnClick="@(() => {

                                 detail = JsonSerializer.Deserialize<PortModel>(JsonSerializer.Serialize(context.Item));

                               context.Actions.StartEditingItemAsync();

                       })" />
                <MudIconButton Size="@Size.Small" Icon="@Icons.Material.Outlined.Delete" OnClick="@(()=>DeleteItem(context.Item))" />
            </CellTemplate>
        </TemplateColumn>
        <PropertyColumn Property="x => x.PORT_CODE" Title="@Localizer["PortCode"]" Required="false" >
            <FilterTemplate>
                <MudTextField @bind-Value="searchString1"/>
            </FilterTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x => x.PORT" Title="@Localizer["PortName"]" Required="false"/>
        <PropertyColumn Property="x => x.dept" Title="@Localizer["Dept"]">
            <EditTemplate>
                <MudSelect @bind-Value="context.Item.dept" Label="@Localizer["Dept"]">
                    <MudSelectItem Value="@("SEA")">SEA</MudSelectItem>
                    <MudSelectItem Value="@("AIR")">AIR</MudSelectItem>
                    <MudSelectItem Value="@("DOM")">DOM</MudSelectItem>
                    <MudSelectItem Value="@("WH")">WH</MudSelectItem>
                </MudSelect>
            </EditTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x => x.show" Title="@Localizer["Show"]" Required="false">
            <EditTemplate>
                <MudCheckBox @bind-Checked="context.Item.show" Label="@Localizer["Show"]" />
            </EditTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x => x.TEL" Title="@Localizer["Tel"]" Required="false" />
        <PropertyColumn Property="x => x.FAX" Title="@Localizer["Fax"]" Required="false" />
        <PropertyColumn Property="x => x.MARKETCODETS" Title="@Localizer["InlandCode"]" Required="false" />
        <PropertyColumn Property="x => x.MARKETCODESALE" Title="@Localizer["MarketCodeSale"]" Required="false" />
        <PropertyColumn Property="x => x.OverW20" Required="false" />
        <PropertyColumn Property="x => x.OverW40" Required="false" />
        <PropertyColumn Property="x => x.DATEEXP" Title="@Localizer["ExpireDate"]">
            <EditTemplate>
                <MudDatePicker @bind-Date="context.Item.DATEEXP" Label="@Localizer["ExpireUpdate"]" />
            </EditTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x => x.ADDRESS" Title="@Localizer["Address"]" Required="false" />
        <PropertyColumn Property="x => x.COUNTRY" Title="@Localizer["Country"]" Required="false" />
        <PropertyColumn Property="x => x.EDITABLE" Title="@Localizer["Editable"]" Required="false" />
        <PropertyColumn Property="x => x.IG" Required="false" />
        <PropertyColumn Property="x => x.TRADECODE" Title="@Localizer["WHouseCode"]" Required="false" />
        <PropertyColumn Property="x => x.APPROVE" Title="@Localizer["Approve"]" Required="false" />
        <PropertyColumn Property="x => x.USERID" Title="@Localizer["UserUpdate"]" IsEditable="false" Required="false" />
        <PropertyColumn Property="x => x.UPDATETIME" Title="@Localizer["Dateupdate"]" IsEditable="false" Required="false">
            <EditTemplate>
                <MudTextField @bind-Date="context.Item.UPDATETIME" Disabled Label="@Localizer["Dateupdate"]"/>
            </EditTemplate>
        </PropertyColumn>
    </Columns>
    <PagerContent>
        <MudDataGridPager T="PortModel" PageSizeOptions=@(new int[] {10, 15, 25}) />
    </PagerContent>
</MudDataGrid>
<script>
    window.triggerGridClick = () => {
        const gridElement = document.querySelector(".mudTable");
        if (gridElement) {
            gridElement.click();
        }
    }
</script>
@code {
    PortModel detail;
    [Parameter] public M_Customer customer { get; set; } = default!;
    void CallSnackBar(string message, MudBlazor.Severity severity)
    {

        Snackbar.Configuration.SnackbarVariant = Variant.Filled;
        Snackbar.Configuration.MaxDisplayedSnackbars = 3;
        Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopRight;
        Snackbar.Add(message, severity);
    }

    List<M_Agency> Agencys = new List<M_Agency>();
    List<PortModel> Ports = new List<PortModel>();
    protected async override Task OnInitializedAsync()
    {
        Agencys = await supsv.GetListAgency();
        Ports = await supsv.GetListPort();
        //await Refresh();
    }

    bool _loading = false;
    bool _processingUpload = false;
    List<PortModel> Listdata = new List<PortModel>();
    async Task Refresh()
    {
        try
        {
            _loading = true;
            // Simulate asynchronous loading to demonstrate a loading indicator
            Listdata.Clear();
            StateHasChanged();
            await Task.Delay(500);
            if (!await ssv.CheckPermission(asv.GetAuth().Result.User.Identity!.Name!, "View", "ListPort"))
            {
                CallSnackBar(Localizer["NoPermission_View"], MudBlazor.Severity.Warning);
                return;
            }
            Listdata = await supsv.GetListPort();
        }
        finally
        {
            _loading = false;
        }

    }
    string PODName(Guid? PODID)
    {
        var rs = Ports.FirstOrDefault(x => x.PORT_ID == PODID);
        return rs != null ? rs.PORT! : "";
    }
    string POLName(Guid? POLID)
    {
        var rs = Ports.FirstOrDefault(x => x.PORT_ID == POLID);
        return rs != null ? rs.PORT! : "";
    }
    string AgencyName(Guid? AgencyID)
    {
        var rs = Agencys.FirstOrDefault(x => x.Agency_ID == AgencyID);
        return rs != null ? rs.AgencyName! : "";
    }

    MudDataGrid<PortModel> mudTable;
    async Task AddItem()
    {
        var item = new PortModel();
        Listdata.Add(item);
        await mudTable.SetEditingItemAsync(Listdata.LastOrDefault()!);
    }

    async Task DeleteItem(PortModel item)
    {
        if (item == null)
        {
            CallSnackBar(Localizer["SelectOneRowToDelete"], MudBlazor.Severity.Warning);
            return;
        }
        var resultMess = await DialogService.ShowMessageBox(
                Localizer["Warning"],
                Localizer["DeleteConfirmBody"],
                yesText: Localizer["delete"], cancelText: Localizer["cancel"]);

        if (resultMess.HasValue)
        {
            var rs = await supsv.DeletePortDetail(item);
            CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
            await Refresh();
        }

    }
    private string searchString1 = "";
    private string search_port = "";
    private bool FilterFunc1(PortModel sbd) => FilterFunc(sbd, search_port);

    private bool FilterFunc(PortModel sbd, string search_port)
    {
        if (string.IsNullOrWhiteSpace(search_port))
            return true;
        if (sbd.PORT_CODE!.Contains(search_port, StringComparison.OrdinalIgnoreCase))
            return true;
        if ($"{sbd.PORT_CODE} ".Contains(search_port))
            return true;
        return false;
    }
    async Task CommittedItem(PortModel item)
    {
        item.USERID = asv.GetAuth().Result.User.Identity!.Name!;
        item.UPDATETIME = DateTime.Now;
        item.EDITABLE = item.APPROVE = item.CONTINUED = true;
        var rs = item.PORT_ID != Guid.Empty ? await supsv.UpdatePortDetail(item,detail) : await supsv.CreatePortDetail(item);
        CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
        await Refresh();
        await TriggerGridClick();
  

    }

    private int selectedRowNumber = -1;
    private string SelectedRowClassFunc(PortModel Sis, int rowNumber)
    {
        if (selectedRowNumber == rowNumber)
        {
            selectedRowNumber = -1;
            return string.Empty;
        }
        else if (mudTable.SelectedItem != null && mudTable.SelectedItem.Equals(Sis))
        {
            selectedRowNumber = rowNumber;
            return "selected";
        }
        else
        {
            return string.Empty;
        }
    }
    private async Task TriggerGridClick()
    {
        await js.InvokeVoidAsync("triggerGridClick");
    }

    void RowRightClicked(DataGridRowClickEventArgs<PortModel> args)
    {

        //_events.Insert(0, $"Event = RowRightClick, Index = {args.RowIndex}, Data = {System.Text.Json.JsonSerializer.Serialize(args.Item)}");
    }

    private async Task HandleImportPort(IBrowserFile? file)
    {
        if (file == null)
            return;

        MemoryStream? streamCopy = null;
        try
        {
            // Copy file bytes first. Re-rendering before OpenReadStream
            // causes Blazor "_blazorFilesById" because the JS file input is disposed.
            streamCopy = new MemoryStream();
            await using (var browserStream = file.OpenReadStream(maxAllowedSize: 20 * 1024 * 1024))
            {
                await browserStream.CopyToAsync(streamCopy);
            }
            streamCopy.Position = 0;

            _processingUpload = true;
            await InvokeAsync(StateHasChanged);

            var preview = await supsv.PreviewPortsFromExcelAsync(streamCopy);
            if (!string.IsNullOrEmpty(preview.ErrorMessage))
            {
                CallSnackBar(preview.ErrorMessage, MudBlazor.Severity.Error);
                return;
            }

            if (preview.Rows.Count == 0)
            {
                CallSnackBar("Không có dữ liệu hợp lệ trong Excel.", MudBlazor.Severity.Warning);
                return;
            }

            var parameters = new DialogParameters
            {
                { "PreviewResult", preview }
            };
            var options = new DialogOptions
            {
                MaxWidth = MaxWidth.ExtraExtraLarge,
                FullWidth = true,
                CloseButton = true,
                CloseOnEscapeKey = true
            };
            var dialog = DialogService.Show<PortPreviewDialog>("Preview Import Port", parameters, options);
            var result = await dialog.Result;

            if (result == null || result.Canceled)
                return;

            var toSave = result.Data as List<PortModel>;
            if (toSave == null || toSave.Count == 0)
            {
                CallSnackBar("Không có dòng nào được chọn để import.", MudBlazor.Severity.Warning);
                return;
            }

            var rs = await supsv.SaveImportedPortsAsync(toSave);
            CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
            if (rs.Flag)
                await Refresh();
        }
        catch (Exception ex)
        {
            CallSnackBar(string.Format(Localizer["ThrowException"], ex.Message), MudBlazor.Severity.Error);
        }
        finally
        {
            _processingUpload = false;
            if (streamCopy != null)
                await streamCopy.DisposeAsync();
        }
    }
}
