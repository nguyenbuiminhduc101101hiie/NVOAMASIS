@* Thiết lập màu và font chữ cho toàn phần mềm (lưu theo trình duyệt, áp dụng ngay). *@
@using System.Text.Json
@inject IJSRuntime JS
@inject ISnackbar Snackbar

<style>
    .tt-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 10px 16px; }
    .tt-color { display: flex; align-items: center; gap: 8px; }
    .tt-color input[type=color] { width: 44px; height: 34px; border: 1px solid #cbd5e1; border-radius: 6px; padding: 2px; cursor: pointer; background: #fff; }
    .tt-color .tt-lbl { flex: 1; font-size: 13px; }
    .tt-color .tt-clear { font-size: 11px; color: #64748b; cursor: pointer; text-decoration: underline; }
    .tt-sec { font-weight: 700; font-size: 13px; margin: 14px 0 6px; color: #334155; }
    .tt-preview { border: 1px dashed #94a3b8; border-radius: 10px; padding: 10px 12px; margin-top: 12px; }
    .tt-preview table { border-collapse: collapse; margin-top: 6px; width: 100%; }
</style>

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Màu & font chữ toàn phần mềm</MudText>
    </TitleContent>
    <DialogContent>
        <div class="tt-sec">Font chữ</div>
        <div class="tt-grid">
            <MudSelect T="string" Label="Kiểu chữ" Value="_t.FontFamily" ValueChanged="@(v => Set(() => _t.FontFamily = v))" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true">
                @foreach (var f in Fonts)
                {
                    <MudSelectItem Value="@f.Css"><span style="font-family:@f.Css">@f.Name</span></MudSelectItem>
                }
            </MudSelect>
            <MudSelect T="string" Label="Cỡ chữ chung" Value="_t.FontSize" ValueChanged="@(v => Set(() => _t.FontSize = v))" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true">
                @foreach (var s in Sizes)
                {
                    <MudSelectItem Value="@s">@s</MudSelectItem>
                }
            </MudSelect>
            <MudSelect T="string" Label="Độ đậm" Value="_t.FontWeight" ValueChanged="@(v => Set(() => _t.FontWeight = v))" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true">
                <MudSelectItem Value="@("300")">Mảnh (300)</MudSelectItem>
                <MudSelectItem Value="@("400")">Thường (400)</MudSelectItem>
                <MudSelectItem Value="@("500")">Vừa (500)</MudSelectItem>
                <MudSelectItem Value="@("600")">Đậm (600)</MudSelectItem>
            </MudSelect>
        </div>
        <MudText Typo="Typo.caption" Class="mt-1">Cỡ chữ riêng cho tiêu đề, ô nhập, lưới, menu vẫn chỉnh ở 1.10.</MudText>

        <div class="tt-sec">Màu chữ</div>
        <div class="tt-grid">
            @ColorRow("Chữ chính", _t.TextPrimary, v => _t.TextPrimary = v)
            @ColorRow("Chữ phụ (mô tả, ghi chú)", _t.TextSecondary, v => _t.TextSecondary = v)
            @ColorRow("Nhãn ô nhập (label)", _t.LabelColor, v => _t.LabelColor = v)
            @ColorRow("Chữ trong ô nhập", _t.InputColor, v => _t.InputColor = v)
            @ColorRow("Link", _t.LinkColor, v => _t.LinkColor = v)
            @ColorRow("Màu chính (nút, tab, điểm nhấn)", _t.Primary, v => _t.Primary = v)
        </div>

        <div class="tt-sec">Lưới (bảng dữ liệu)</div>
        <div class="tt-grid">
            @ColorRow("Nền tiêu đề cột", _t.GridHeaderBg, v => _t.GridHeaderBg = v)
            @ColorRow("Chữ tiêu đề cột", _t.GridHeaderText, v => _t.GridHeaderText = v)
            @ColorRow("Chữ trong lưới", _t.GridText, v => _t.GridText = v)
        </div>

        <div class="tt-sec">Nền</div>
        <div class="tt-grid">
            @ColorRow("Nền trang", _t.Background, v => _t.Background = v)
            @ColorRow("Nền khung / thẻ", _t.Surface, v => _t.Surface = v)
        </div>

        <div class="tt-preview">
            <MudText Typo="Typo.subtitle2">Xem trước</MudText>
            <MudText Typo="Typo.body2">Chữ chính · <span style="color:var(--mud-palette-text-secondary)">chữ phụ</span> · <MudLink>link</MudLink></MudText>
            <MudStack Row="true" Spacing="2" Class="mt-2" AlignItems="AlignItems.Center">
                <MudTextField T="string" Label="Nhãn ô nhập" Value="@("Nội dung ô nhập")" Variant="Variant.Outlined" Margin="Margin.Dense" />
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small">Nút chính</MudButton>
            </MudStack>
            <MudSimpleTable Dense="true" Class="mt-2">
                <thead class="mud-table-head"><tr><th class="mud-table-cell">HBL</th><th class="mud-table-cell">Customer</th><th class="mud-table-cell">POL</th></tr></thead>
                <tbody class="mud-table-body"><tr><td class="mud-table-cell">HBL0001</td><td class="mud-table-cell">CUSTOMER A</td><td class="mud-table-cell">VNSGN</td></tr></tbody>
            </MudSimpleTable>
        </div>
        <MudText Typo="Typo.caption" Class="mt-2 d-block">Thay đổi hiện ngay để xem trước. Ô để trống = dùng mặc định của phần mềm. Thiết lập lưu theo trình duyệt đang dùng.</MudText>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="ResetAsync" Color="Color.Secondary" Variant="Variant.Text">Về mặc định</MudButton>
        <MudSpacer />
        <MudButton OnClick="CancelAsync" Color="Color.Secondary">Huỷ</MudButton>
        <MudButton OnClick="SaveAsync" Color="Color.Primary" Variant="Variant.Filled">Lưu & áp dụng</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] public MudDialogInstance? MudDialog { get; set; }

    public sealed class TextTheme
    {
        public string? FontFamily { get; set; }
        public string? FontSize { get; set; }
        public string? FontWeight { get; set; }
        public string? TextPrimary { get; set; }
        public string? TextSecondary { get; set; }
        public string? LabelColor { get; set; }
        public string? InputColor { get; set; }
        public string? LinkColor { get; set; }
        public string? Primary { get; set; }
        public string? GridHeaderBg { get; set; }
        public string? GridHeaderText { get; set; }
        public string? GridText { get; set; }
        public string? Background { get; set; }
        public string? Surface { get; set; }
    }

    static readonly (string Name, string Css)[] Fonts =
    {
        ("Roboto (mặc định)", "Roboto, Helvetica, Arial, sans-serif"),
        ("Be Vietnam Pro", "'Be Vietnam Pro', Roboto, Arial, sans-serif"),
        ("Inter", "Inter, Roboto, Arial, sans-serif"),
        ("Open Sans", "'Open Sans', Roboto, Arial, sans-serif"),
        ("Noto Sans", "'Noto Sans', Roboto, Arial, sans-serif"),
        ("Segoe UI", "'Segoe UI', Roboto, Arial, sans-serif"),
        ("Arial", "Arial, Helvetica, sans-serif"),
        ("Tahoma", "Tahoma, Verdana, sans-serif"),
        ("Verdana", "Verdana, Tahoma, sans-serif"),
        ("Calibri", "Calibri, 'Segoe UI', Arial, sans-serif"),
        ("Times New Roman", "'Times New Roman', Times, serif"),
    };

    static readonly string[] Sizes = { "12px", "13px", "14px", "15px", "16px", "17px", "18px" };

    static readonly JsonSerializerOptions JsonOpts = new() { PropertyNamingPolicy = JsonNamingPolicy.CamelCase, DefaultIgnoreCondition = System.Text.Json.Serialization.JsonIgnoreCondition.WhenWritingNull };

    TextTheme _t = new();
    string _savedJson = "{}";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            _savedJson = await JS.InvokeAsync<string>("nvoccGetTextTheme") ?? "{}";
            _t = JsonSerializer.Deserialize<TextTheme>(_savedJson, JsonOpts) ?? new();
            StateHasChanged();
        }
        catch { }
    }

    RenderFragment ColorRow(string label, string? value, Action<string?> set) => __builder =>
    {
        <div class="tt-color">
            <input type="color" value="@(string.IsNullOrWhiteSpace(value) ? "#000000" : value)"
                   @onchange="@(e => Set(() => set(e.Value?.ToString())))" />
            <span class="tt-lbl">@label @if (string.IsNullOrWhiteSpace(value)) { <i style="color:#94a3b8">(mặc định)</i> } else { <b>@value</b> }</span>
            @if (!string.IsNullOrWhiteSpace(value))
            {
                <span class="tt-clear" @onclick="@(() => Set(() => set(null)))">bỏ</span>
            }
        </div>
    };

    async Task Set(Action change)
    {
        change();
        await PreviewAsync();
    }

    string ToJson() => JsonSerializer.Serialize(_t, JsonOpts);

    async Task PreviewAsync()
    {
        try { await JS.InvokeVoidAsync("nvoccPreviewTextTheme", ToJson()); } catch { }
    }

    async Task SaveAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("nvoccSaveTextTheme", ToJson());
            Snackbar.Add("Đã lưu màu & font chữ", MudBlazor.Severity.Success);
            MudDialog?.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, MudBlazor.Severity.Error);
        }
    }

    async Task ResetAsync()
    {
        _t = new TextTheme();
        await PreviewAsync();
    }

    async Task CancelAsync()
    {
        try { await JS.InvokeVoidAsync("nvoccPreviewTextTheme", _savedJson); } catch { }
        MudDialog?.Cancel();
    }
}
