@using MudBlazor
@inject IJSRuntime JS
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudStack Spacing="3">
            <MudText Typo="Typo.subtitle1" Class="mb-2 mt-2">Shipment grid colors</MudText>

            <MudText Typo="Typo.subtitle2">1) Header row</MudText>
            <MudStack Row Spacing="2" AlignItems="AlignItems.Center">
                <input type="color" value="@shipmentHeaderBg"
                       @onchange="@((ChangeEventArgs e) => shipmentHeaderBg = e.Value?.ToString() ?? shipmentHeaderBg)"
                       style="width: 80px; height: 40px; border: 1px solid #ccc; border-radius: 4px; cursor: pointer;" />
                <MudTextField @bind-Value="shipmentHeaderBg"
                              Label="Color"
                              Variant="Variant.Outlined"
                              Style="flex: 1;" />
            </MudStack>

            <MudText Typo="Typo.subtitle2">2) Selected row</MudText>
            <MudStack Row Spacing="2" AlignItems="AlignItems.Center">
                <input type="color" value="@shipmentSelectedRowBg"
                       @onchange="@((ChangeEventArgs e) => shipmentSelectedRowBg = e.Value?.ToString() ?? shipmentSelectedRowBg)"
                       style="width: 80px; height: 40px; border: 1px solid #ccc; border-radius: 4px; cursor: pointer;" />
                <MudTextField @bind-Value="shipmentSelectedRowBg"
                              Label="Color"
                              Variant="Variant.Outlined"
                              Style="flex: 1;" />
            </MudStack>

            <MudText Typo="Typo.subtitle2">3) Tab toolbar</MudText>
            <MudStack Row Spacing="2" AlignItems="AlignItems.Center">
                <input type="color" value="@shipmentTabToolbarBg"
                       @onchange="@((ChangeEventArgs e) => shipmentTabToolbarBg = e.Value?.ToString() ?? shipmentTabToolbarBg)"
                       style="width: 80px; height: 40px; border: 1px solid #ccc; border-radius: 4px; cursor: pointer;" />
                <MudTextField @bind-Value="shipmentTabToolbarBg"
                              Label="Color"
                              Variant="Variant.Outlined"
                              Style="flex: 1;" />
            </MudStack>
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="ResetToDefault" Color="Color.Secondary" Variant="Variant.Text">
            Reset
        </MudButton>
        <MudSpacer />
        <MudButton OnClick="Cancel" Color="Color.Secondary">Close</MudButton>
        <MudButton OnClick="ApplyChanges" Color="Color.Primary" Variant="Variant.Filled">
            Apply
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] public MudDialogInstance? MudDialog { get; set; }

    // Defaults should match values in wwwroot/app.css (:root + legacy).
    private string shipmentHeaderBg = "#0077b6";
    private string shipmentSelectedRowBg = "#1E88E5";
    private string shipmentTabToolbarBg = "#ffffff";

    private sealed class ShipmentColorSettingsDto
    {
        public string? headerBg { get; set; }
        public string? selectedBg { get; set; }
        public string? tabToolbarBg { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadFromStorage();
    }

    private async Task LoadFromStorage()
    {
        try
        {
            var settings = await JS.InvokeAsync<ShipmentColorSettingsDto?>("nvoccGetShipmentColorSettings");
            if (settings == null)
                return;

            if (!string.IsNullOrWhiteSpace(settings.headerBg))
                shipmentHeaderBg = settings.headerBg;
            if (!string.IsNullOrWhiteSpace(settings.selectedBg))
                shipmentSelectedRowBg = settings.selectedBg;
            if (!string.IsNullOrWhiteSpace(settings.tabToolbarBg))
                shipmentTabToolbarBg = settings.tabToolbarBg;
        }
        catch
        {
            // ignore storage errors; use defaults
        }
    }

    private async Task ApplyChanges()
    {
        await JS.InvokeVoidAsync(
            "nvoccApplyShipmentColorSettings",
            shipmentHeaderBg,
            shipmentSelectedRowBg,
            shipmentTabToolbarBg);

        Snackbar.Add("Shipment grid colors updated.", MudBlazor.Severity.Success);
        MudDialog?.Close(DialogResult.Ok(true));
    }

    private async Task ResetToDefault()
    {
        shipmentHeaderBg = "#0077b6";
        shipmentSelectedRowBg = "#1E88E5";
        shipmentTabToolbarBg = "#ffffff";
        await ApplyChanges();
    }

    private void Cancel()
    {
        MudDialog?.Cancel();
    }
}

