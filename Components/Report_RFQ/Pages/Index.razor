@using MudBlazor
@using System.Globalization
@using System.Linq
@using MudBlazor.Components
@attribute [Authorize]
@inject GlobalServices gsv
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject AccountService asv
@inject SharedServices ssv
@inject BookingService bksv
@inject IJSRuntime JSRuntime
@inject SupportServices supsv
@inject IStringLocalizer<SharedResource> Localizer
@inject LocalChargesServices lcsv
@inject CustomerService Cussv
@inject PhieuThu_Chi_Services thuchisv
@inject ReportServices rpsv
@inject QuotationService Quosv
@inject IJSRuntime JSRuntime

<PageTitle>@Localizer["ReportRFQ"] </PageTitle>
<MudText Class="pa-2" Typo="Typo.h6">@Localizer["ReportRFQ"]</MudText>


<MudGrid Class="pa-6">
    <!-- Picker chiếm 4/12 cột -->
    <MudItem xs="4">
        <MudDateRangePicker Label="@Localizer["searchdatefromto"]"
                            @bind-DateRange="_dateRange" />
    </MudItem>

    <!-- Button chiếm 3/12 cột -->
    <MudItem xs="2">
        <MudButton HtmlTag="label"
                   OnClick="Search"
                   Size="Size.Small"
                   Color="Color.Primary"
                   Variant="Variant.Filled"
                   StartIcon="@Icons.Material.Filled.Refresh">
            @Localizer["Search"]
        </MudButton>
    </MudItem>

    <!-- From Month -->
    <MudItem xs="1">
        <MudSelect T="int" Label="Từ tháng" @bind-Value="fromThang" Dense="true">
            @foreach (var m in Months)
            {
                <MudSelectItem T="int" Value="m">@m</MudSelectItem>
            }
        </MudSelect>
    </MudItem>

    <!-- From Year -->
    <MudItem xs="1">
        <MudSelect T="int" Label="Từ năm" @bind-Value="fromNam" Dense="true">
            @foreach (var y in Years)
            {
                <MudSelectItem T="int" Value="y">@y</MudSelectItem>
            }
        </MudSelect>
    </MudItem>

    <MudItem xs="1">
        <MudSelect T="int" Label="Đến tháng" @bind-Value="toThang" Dense="true">
            @foreach (var m in Months)
            {
                <MudSelectItem T="int" Value="m">@m</MudSelectItem>
            }
        </MudSelect>
    </MudItem>

    <!-- To Year -->
    <MudItem xs="1">
        <MudSelect T="int" Label="Đến năm" @bind-Value="toNam" Dense="true">
            @foreach (var y in Years)
            {
                <MudSelectItem T="int" Value="y">@y</MudSelectItem>
            }
        </MudSelect>
    </MudItem>

    <MudItem xs="2">
        <MudButton HtmlTag="label"
        OnClick="Search_By_months"
        Size="Size.Small" Color="Color.Primary" Variant="   Variant.Filled"
        StartIcon="@Icons.Material.Filled.Refresh">
            @Localizer["Search Months"]
        </MudButton>
    </MudItem>

</MudGrid>


<MudContainer MaxWidth="MudBlazor.MaxWidth.False" Class="mt-4">
    <MudGrid>
        <!-- Phần bên trái: Report -->
        <MudItem xs="12">
            <MudDataGrid T="M_Report_RFQ" Items="@Listdata" Bordered="true" Striped="true" Hover="true" Loading="_loading">
                <Columns>
                    <PropertyColumn Property="x => x.RFQ_No" Title="@Localizer["RFQNo"]" CellStyleFunc="_cellStyleFunc" />
                    <PropertyColumn Property="x => CustomerName(x.Customer_id)" Title="@Localizer["Customer"]" CellStyleFunc="_cellStyleFunc" />
                    <PropertyColumn Property="x => x.Status" Title="@Localizer["status"]" CellStyleFunc="_cellStyleFunc" />
                    <PropertyColumn Property="x => x.Date_Created" Title="@Localizer["NGAY"]" Format="dd/MMM/yyyy" CellStyleFunc="_cellStyleFunc" />
                    <PropertyColumn Property="x => x.Total_Amount_VND" Format="#,##0.##" Title="@Localizer["Total_Amount_VND"]" Culture="_en" CellClass="custom-right-align" CellStyleFunc="_cellStyleFunc" />
                    <PropertyColumn Property="x => x.Total_Amount_USD" Format="#,##0.##" Title="@Localizer["Total_Amount_USD"]" Culture="_en" CellClass="custom-right-align" CellStyleFunc="_cellStyleFunc" />
                    <PropertyColumn Property="x => x.Note" Title="@Localizer["ghichu"]" />
                </Columns>

                <PagerContent>
                    <MudDataGridPager T="M_Report_RFQ" PageSizeOptions="@(new int[] { 8, 10, 20 })" />
                </PagerContent>
            </MudDataGrid>
        </MudItem>



        <!-- Phần bên phải: Biểu đồ -->
        <MudItem xs="12">
            @if (type_search == "search_month")
            {
                <MudGrid>
                    <MudItem xs="12">
                        <MudChart ChartType="ChartType.Bar" ChartSeries="@Series" XAxisLabels="@XAxisLabels" Width="100%" Height="350px" ChartOptions="@options">
                            <CustomGraphics>
                                <style>
                                    .heavy {
                                    font: bold 30px Helvetica;
                                    }

                                    .Rrrrr {
                                    font: italic 40px Helvetica;
                                    fill: rgb(62,44,221);
                                    }
                                </style>

                            </CustomGraphics>
                        </MudChart>



                    </MudItem>
                </MudGrid>
            }
            else
            {
                <MudGrid>
                    <MudItem xs="12">
                        <MudChart ChartType="ChartType.Bar"
                        ChartSeries="@Series"
                        XAxisLabels="@XAxisLabels"
                        Width="100%"
                                  Height="400px" ChartOptions="@options">
                            <CustomGraphics>
                                <style>
                                    .mud-chart text {
                                    font-size: 10px !important; /* Nhỏ hơn một chút */
                                    fill: black;
                                    font-weight: bold;
                                    text-shadow: 1px 1px 2px rgba(0,0,0,0.5);
                                    }
                                </style>
                                @if (Series != null && Series.Count > 0)
                                {
                                    var barWidth = 30;  // Giảm từ 60 xuống 30
                                    var gap = 15;       // Giảm từ 30 xuống 15

                                    @for (int i = 0; i < Series[0].Data.Length; i++)
                                    {
                                        var x = gap + i * (barWidth + 5);         // Điều chỉnh vị trí X
                                        var barHeight = Series[0].Data[i] * 5;    // Giảm tỷ lệ chiều cao xuống 1/2
                                        var y = 150 - barHeight;                  // Căn chỉnh lại trục Y cho phù hợp chiều cao mới

                                        @:<rect x="@x" y="@y" width="@barWidth" height="@barHeight" fill="blue" />
                                        @:<text x="@(x + barWidth / 2)" y="@(y - 15)" text-anchor="middle" dominant-baseline="middle">@Series[0].Data[i]</text>
                                    }
                                }
                            </CustomGraphics>
                        </MudChart>

                    </MudItem>


                    <MudItem xs="12">
                        <MudChart ChartType="ChartType.Pie"
                        InputData="@inputData"
                        InputLabels="@inputLabels"
                        Width="300px" Height="300px" />
                    </MudItem>
                </MudGrid>
            }
        </MudItem>
    </MudGrid>
</MudContainer>

@code {
    private DateRange _dateRange = new DateRange(DateTime.Now.Date, DateTime.Now.AddDays(5).Date);

    private List<M_Report_RFQ> Listdata = new();
    private List<M_Customer> List_Cus = new List<M_Customer>();
    private double? soducuoiky;
    private double? sodudauky;
    private double? tongsotien;
    private double? tongsotienthu;
    private double? tongsotienchi;
    private string _Cur = "VND";// Giá trị mặc định
    private bool _processingUpload = false;
    public CultureInfo _en = CultureInfo.GetCultureInfo("en-US");
    // Selected values
    private int fromThang;
    private int fromNam;
    private int toThang;
    private int toNam;
    private string type_search;
    // Data sources
    private readonly int[] Months = Enumerable.Range(1, 12).ToArray();

    // Ví dụ: năm từ 2020 đến 2030
    private readonly int[] Years = Enumerable.Range(2020, 11).ToArray();


    protected async override Task OnInitializedAsync()
    {
        List_Cus = await Cussv.GetList();
        M_Trangthais = await supsv.GetListTrangThai();
        var tts = await supsv.GetListTrangThai();
        trangthais = tts.Where(x => x.Tieude == "RFQ").OrderBy(x => x.Noidung).Select(x => x.Noidung).ToList();
    }
    public class RFQCountByMonthAndStatus
    {
        public string MonthYear { get; set; } // ví dụ: "03/2025"
        public string Status { get; set; }    // ví dụ: "Open", "Closed"
        public int Count { get; set; }
    }
    public class M_Report_RFQ
    {
        public string? RFQ_No { get; set; }
        public Guid? Customer_id { get; set; }
        public string? Status { get; set; }
        public DateTime? Date_Created { get; set; }

        public double? Total_Amount_VND { get; set; }
        public double? Total_Amount_USD { get; set; }
        public string? Note { get; set; }

    }
    public List<ChartSeries> Series = new();
    public string[] XAxisLabels = Array.Empty<string>();
    List<string> trangthais = new List<string>();
    private List<Models.TrangThai> M_Trangthais = new List<Models.TrangThai>();
    private double[] PieData = Array.Empty<double>();
    private string[] PieLabels = Array.Empty<string>();
    double[] inputData;
    private string[] inputLabels;
    bool _loading = false;

    async Task Search()
    {
        _loading = true;
        type_search = "search";
        var startDate = _dateRange.Start.Value;
        var endDate = _dateRange.End.Value;

        if (startDate != null && endDate != null)
        {
            Listdata = await Quosv.GetReport_RFQ(startDate, endDate);

            //Bar
            var groupedData = Listdata
                .Where(x => !string.IsNullOrEmpty(x.Status))
                .GroupBy(x => x.Status)
                .Select(g => new { Status = g.Key, Count = g.Count() })
                .ToList();


            XAxisLabels = groupedData.Select(x => x.Status ?? "").ToArray();
            Series = new List<ChartSeries>()
            {
                new ChartSeries
                {
                    Name = "Số lượng RFQ",
                    Data = Listdata
                        .GroupBy(x => x.Status)
                        .OrderBy(x => x.Key)
                        .Select(g => (double)g.Count())
                        .ToArray()
                }
            };

            XAxisLabels = Listdata
                .GroupBy(x => x.Status)
                .OrderBy(x => x.Key)
                .Select(g => g.Key ?? "Unknown")
                .ToArray();

            //Pie
            var grouped = Listdata
        .GroupBy(x => x.Status)
        .Select(g => new { Status = g.Key, Count = g.Count() })
        .ToList();

            double total = Listdata.Count;

            inputData = grouped.Select(x => (double)x.Count).ToArray();
            inputLabels = grouped
                .Select(x => $"{x.Status} ({(100.0 * x.Count / total):F1}%)")
                .ToArray();

            _loading = false;
        }
    }
    async Task Search_By_months()
    {

        type_search = "search_month";

        if (fromThang != null && fromNam != null && toThang != null && toNam != null && fromThang != 0 && fromNam != 0 && toThang != 0 && toNam != 0)
        {
            // 1. Lấy dữ liệu
            Listdata = await Quosv.GetReport_RFQ_by_month(fromThang, fromNam, toThang, toNam);

            // 2. Danh sách tất cả các tháng/năm có trong dữ liệu
            var allMonthYears = Listdata
                .Where(x => x.Date_Created.HasValue)
                .Select(x => new
                {
                    Year = x.Date_Created.Value.Year,
                    Month = x.Date_Created.Value.Month
                })
                .Distinct()
                .OrderBy(x => x.Year)
                .ThenBy(x => x.Month)
                .Select(x => $"{x.Month:D2}/{x.Year}")
                .ToList();
            if (allMonthYears.Count <= 3)
            {
                // Lấy tháng đầu tiên và cuối cùng để thêm tháng ảo trước/sau
                var first = allMonthYears.First();
                var last = allMonthYears.Last();

                // Parse tháng đầu tiên
                var firstParts = first.Split('/');
                int firstMonth = int.Parse(firstParts[0]);
                int firstYear = int.Parse(firstParts[1]);
                DateTime prev = new DateTime(firstYear, firstMonth, 1).AddMonths(-1);
                allMonthYears.Insert(0, $"{prev.Month:D2}/{prev.Year}");

                // Parse tháng cuối cùng
                var lastParts = last.Split('/');
                int lastMonth = int.Parse(lastParts[0]);
                int lastYear = int.Parse(lastParts[1]);
                DateTime next = new DateTime(lastYear, lastMonth, 1).AddMonths(1);
                allMonthYears.Add($"{next.Month:D2}/{next.Year}");
            }
            // 3. Danh sách tất cả các trạng thái
            var allStatuses = Listdata
                .Where(x => !string.IsNullOrWhiteSpace(x.Status) && x.Date_Created.HasValue)
                .Select(x => x.Status)
                .Distinct()
                .ToList();

            // 4. Tạo các series cho từng trạng thái
            Series = allStatuses.Select(status => new ChartSeries
                {
                    Name = status,
                    Data = allMonthYears.Select(monthYear =>
                    {
                        var parts = monthYear.Split('/');
                        int month = int.Parse(parts[0]);
                        int year = int.Parse(parts[1]);

                        return Listdata.Count(x =>
                            x.Status == status &&
                            x.Date_Created.HasValue &&
                            x.Date_Created.Value.Month == month &&
                            x.Date_Created.Value.Year == year);
                    }).Select(count => (double)count).ToArray()
                }).ToList();

            // 5. Gán nhãn trục X
            XAxisLabels = allMonthYears.ToArray();

            _loading = false;

        }
        else
        {
            _loading = false;
            CallSnackBar("Select Date Time Range", MudBlazor.Severity.Warning);
            return;
        }
    }

    void CallSnackBar(string message, MudBlazor.Severity severity)
    {

        Snackbar.Configuration.SnackbarVariant = Variant.Filled;
        Snackbar.Configuration.MaxDisplayedSnackbars = 3;
        Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopRight;
        Snackbar.Add(message, severity);
    }

    string CustomerName(Guid? customerID)
    {
        var rs = List_Cus.FirstOrDefault(x => x.Customer_ID == customerID);
        return rs != null ? rs.COMPANY! : "";
    }

    private Func<M_Report_RFQ, string> _cellStyleFunc => x =>
     {
         string style = "";

         if (string.IsNullOrEmpty(x.Status))
             return "color: #000000";

         var rs = M_Trangthais
     .Where(t => (t.Noidung).Contains(x.Status, StringComparison.InvariantCultureIgnoreCase)
         && t.Tieude.Equals("RFQ", StringComparison.InvariantCultureIgnoreCase))
     .Select(t => t.Mamau)
     .FirstOrDefault();
         return "color: " + rs;

     };

    private ChartOptions options = new ChartOptions
        {
            InterpolationOption = InterpolationOption.NaturalSpline,
            YAxisFormat = "#,##0"
        };
}


