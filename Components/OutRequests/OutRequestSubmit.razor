@using MudBlazor
@using Microsoft.EntityFrameworkCore
@inject NotificationService NotificationService
@inject ISnackbar Snackbar

<MudPaper Class="pa-4" Elevation="2">
    <MudText Typo="Typo.h5" Class="mb-4">Xin ra ngoài</MudText>
    <MudForm @ref="_form">
        <MudGrid>
            <MudItem xs="12" sm="6">
                <MudDatePicker @bind-Date="_fromDate" Label="Từ ngày" Dense="true" DisableToolbar="true" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTimePicker @bind-Time="_fromTime" Label="Giờ bắt đầu" Dense="true" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudDatePicker @bind-Date="_toDate" Label="Đến ngày" Dense="true" DisableToolbar="true" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTimePicker @bind-Time="_toTime" Label="Giờ kết thúc" Dense="true" />
            </MudItem>
            <MudItem xs="12">
                <MudTextField @bind-Value="_reason" Label="Lý do" Lines="3" Required="true" Immediate="true" />
            </MudItem>
            <MudItem xs="12">
                <MudButton OnClick="Send" Variant="Variant.Filled" Color="Color.Primary" Disabled="_sending">Gửi</MudButton>
            </MudItem>
        </MudGrid>
    </MudForm>
</MudPaper>

@code {
    private MudForm? _form;
    private DateTime? _fromDate = DateTime.Today;
    private TimeSpan? _fromTime = DateTime.Now.TimeOfDay;
    private DateTime? _toDate = DateTime.Today;
    private TimeSpan? _toTime = DateTime.Now.AddHours(1).TimeOfDay;
    private string _reason = string.Empty;
    private bool _sending = false;

    private async Task Send()
    {
        if (_form is null) return;
        await _form.Validate();
        if (!_form.IsValid) return;
        if (!_fromDate.HasValue || !_fromTime.HasValue || !_toDate.HasValue || !_toTime.HasValue)
        {
            Snackbar.Add("Thiếu thời gian", MudBlazor.Severity.Error); return;
        }
        var from = _fromDate.Value.Date + _fromTime.Value;
        var to = _toDate.Value.Date + _toTime.Value;
        _sending = true;
        var rs = await NotificationService.SendOutRequestAsync(from, to, _reason);
        _sending = false;
    Snackbar.Add(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
        if (rs.Flag)
        {
            _reason = string.Empty;
        }
    }
}
