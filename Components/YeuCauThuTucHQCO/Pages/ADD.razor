@using System.Globalization
@inject ISnackbar Snackbar
@inject AccountService asv
@inject TrainScheduleServices trainsv
@inject IStringLocalizer<SharedResource> Localizer
@inject SharedServices ssv
@inject LocalChargesServices lcsv
@inject SupportServices supsv
@inject LenhDieuXeServices ldxsv
@inject TKHQ_Services tkhqsv
@inject GlobalServices gsv
@inject CustomerService Cussv
@inject TKHQ_Services tkhqsv
@inject IJSRuntime JSRuntime
@inject NotificationService _notificationService

<MudDialog>
    <DialogContent>
        <MudSpacer></MudSpacer>
        <MudContainer>

            <MudCard>
                <MudForm Model="@_YeuCauTuVan_HQCO_Detail" @ref="@form">
                    <MudCardContent>
                        <MudGrid>
                            <MudGrid>

                                <MudItem xs="2">
                                    <MudButton Style="background-color: #007BFF; color: white;" Size="Size.Small" Color="Color.Primary"
                                    Disabled="@(Status == "edit")"
                                    OnClick="() => Get_Sotokhai()">>>></MudButton>
                                </MudItem>

                                <MudItem xs="5">
                                    <MudTextField @bind-Value="_YeuCauTuVan_HQCO_Detail.SoYeuCau" Disabled="true" Label="@Localizer["soyeucau"]" Required="true" />
                                </MudItem>
                                <MudItem xs="5">
                                    <MudTextField @bind-Value="_YeuCauTuVan_HQCO_Detail.UserYeuCau" Label="@Localizer["nguoiyeucau"]" Disabled="true" Required="true" />
                                </MudItem>
                            </MudGrid>


                            <div style="background-color: lightcyan;" class="border border-solid mud-border-primary pa-4">
                                <MudGrid>
                                    <MudItem xs="4">

                                        <MudDatePicker Class="custom-label" @bind-Date="_YeuCauTuVan_HQCO_Detail.ThoiGianBatDau"
                                        For="@(() => _YeuCauTuVan_HQCO_Detail.ThoiGianBatDau)"
                                        Label="@Localizer["thoigianbatdau"]"
                                        Required="true" />
                                    </MudItem>

                                    <MudItem xs="4">

                                        <MudDatePicker Class="custom-label" @bind-Date="_YeuCauTuVan_HQCO_Detail.ThoiGianKetThuc"
                                        For="@(() => _YeuCauTuVan_HQCO_Detail.ThoiGianKetThuc)"
                                        Label="@Localizer["thoigianketthuc"]"
                                        Required="true" />
                                    </MudItem>

                                    <MudItem xs="4">
                                        <MudSelect @bind-Value="_YeuCauTuVan_HQCO_Detail.TrangThai" Label="@Localizer["status"]" class="custom-label">
                                            @foreach (var item in trangthais)
                                            {
                                                <MudSelectItem Value="item">@item</MudSelectItem>
                                            }
                                        </MudSelect>
                                    </MudItem>


                                    <MudItem xs="12">
                                        <MudAutocomplete @bind-Value="_YeuCauTuVan_HQCO_Detail.Congty" Label="@Localizer["Congty"]" class="custom-label" Required
                                        SearchFunc="SearchCompanyNK"
                                        OnBlur="OnCompanyNKBlur" />
                                    </MudItem>



                                    <MudItem xs="12">
                                        <MudTextField @bind-Value="_YeuCauTuVan_HQCO_Detail.masothue" Label="@Localizer["mst"]" Class="custom-label"
                                        InputType="InputType.Text" />
                                    </MudItem>

                                    <MudItem xs="12">
                                        <MudTextField @bind-Value="_YeuCauTuVan_HQCO_Detail.diachi" Label="@Localizer["Address"]" Class="custom-label"
                                        InputType="InputType.Text" />
                                    </MudItem>


                                    <MudItem xs="12">
                                        <MudSelect @bind-Value="_YeuCauTuVan_HQCO_Detail.YKien" Label="@Localizer["YKien"]" class="custom-label">
                                            @foreach (var item in ykiens)
                                            {
                                                <MudSelectItem Value="item">@item</MudSelectItem>
                                            }
                                        </MudSelect>
                                    </MudItem>


                                    <MudItem xs="12">
                                        <MudTextField @bind-Value="_YeuCauTuVan_HQCO_Detail.TieuDeYeuCau" Lines="3" AutoGrow Label="@Localizer["tieudeyeucau"]" class="custom-label" Required="false" />
                                    </MudItem>
                                    <MudItem xs="12">
                                        <MudTextField @bind-Value="_YeuCauTuVan_HQCO_Detail.NoiDung" Lines="3" AutoGrow Label="@Localizer["noidung"]" class="custom-label" Required="false" />
                                    </MudItem>

                                    <MudItem xs="2">
                                        <MudAutocomplete Class="pl-4 labelCustomColor custom-label" T="string"
                                        @bind-Value="UserHanding"
                                        Label="User:"
                                        SearchFunc="Search_User"
                                        Immediate="true"
                                        CoerceText="true"
                                        Clearable="true"
                                        MaxItems="100">
                                        </MudAutocomplete>
                                    </MudItem>

                                    <MudItem xs="1">
                                        <MudButton Class="pl-4 labelCustomColor" Style="background-color: #007BFF; color: white;" Size="Size.Small" Color="Color.Primary"
                                        OnClick="() => Getuser()">>>></MudButton>
                                    </MudItem>

                                    <MudItem xs="3">
                                        <MudTextField @bind-Value="_YeuCauTuVan_HQCO_Detail.UserTraLoi" class="custom-label" HelperTextOnFocus HelperText="từ 2 mail trở lên vui lòng ngăn cách bằng dấu ','"
                                        Lines="3" AutoGrow Label="@Localizer["usertraloi"]" Required="false" />
                                    </MudItem>

                                    <MudItem xs="2">
                                        <MudButton HtmlTag="label" Disabled="_processingUpload"
                                        @onclick="@(() => SendMailnotify())"
                                        Size="Size.Small" Color="Color.Tertiary" Variant="Variant.Filled"
                                        StartIcon="@Icons.Material.Filled.Email">
                                            @if (_processingUpload)
                                            {
                                                <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                                                <MudText Class="ms-2">Processing</MudText>
                                            }
                                            else
                                            {
                                                <MudText>Send Email</MudText>
                                            }
                                        </MudButton>
                                    </MudItem>

                                    <MudItem xs="2">
                                        <MudButton HtmlTag="label" Disabled="_processingUploadzalo"
                                        @onclick="@(() => SendZalonotify())"
                                        Size="Size.Small" Color="Color.Tertiary" Variant="Variant.Filled"
                                        StartIcon="@Icons.Material.Filled.Send">
                                            @if (_processingUploadzalo)
                                            {
                                                <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                                                <MudText Class="ms-2">Processing</MudText>
                                            }
                                            else
                                            {
                                                <MudText>Send Zalo</MudText>
                                            }
                                        </MudButton>
                                    </MudItem>

                                      <MudItem xs="2">
                                        <MudButton HtmlTag="label" Disabled="_processingUpload_message"
                                                   @onclick="@(() => SendMessage(_YeuCauTuVan_HQCO_Detail))"
                                                   Size="Size.Small" Color="Color.Tertiary" Variant="Variant.Filled"
                                                   StartIcon="@Icons.Material.Filled.Email">
                                            @if (_processingUpload_message)
                                            {
                                                <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                                                <MudText Class="ms-2">Processing</MudText>
                                            }
                                            else
                                            {
                                                <MudText>@Localizer["message"]</MudText>
                                            }
                                        </MudButton>
                                    </MudItem>

                                    <MudItem xs="12">
                                        <MudStack Row>
                                            <MudContainer Class="pa-4; max-height:200px; overflow-y: auto; custom-label;">
                                                <MudText class="custom-label" Typo="Typo.h6">Hình ảnh mô tả</MudText>
                                                @foreach (var item in Linksplit(_YeuCauTuVan_HQCO_Detail.Links!))
                                                {
                                                    <MudPaper Elevation="3" Style="position: relative; display: inline-block;">
                                                        <MudImage Src="@item.Replace("ftp","http")" Alt="@item.Replace("ftp","http")"
                                                        Height="150" Elevation="25" Class="rounded-lg ma-4" />

                                                        <MudIconButton Icon="@Icons.Material.Filled.Visibility" OnClick="@(() => SeeDetail(item))"
                                                        Style="position: absolute; top: 5px; left: 5px; padding: 0; min-width: 0;" />

                                                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error"
                                                        OnClick="@(() => Deleteimg(_YeuCauTuVan_HQCO_Detail,item))"
                                                        Style="position: absolute; top: 5px; right: 5px; padding: 0; min-width: 0;" />
                                                    </MudPaper>
                                                }
                                            </MudContainer>

                                            <MudFileUpload T="IBrowserFile" Accept=".png,.jpg,.jpeg" FilesChanged="@((t) => AttachFileToFTP(t,_YeuCauTuVan_HQCO_Detail))">
                                                <ButtonTemplate Context="context1">
                                                    <MudIconButton HtmlTag="label" for="@context1" Size="Size.Small" Color="Color.Secondary"
                                                    Icon="@Icons.Material.Filled.AttachFile" />
                                                </ButtonTemplate>
                                            </MudFileUpload>

                                        </MudStack>
                                    </MudItem>

                                  



                                </MudGrid>
                            </div>


                        </MudGrid>



                    </MudCardContent>
                </MudForm>

            </MudCard>
        </MudContainer>
    </DialogContent>
    <DialogActions>

        <MudButton OnClick="@(async () => await Submit())">Save</MudButton>
        <MudButton OnClick="Cancel">Cancel</MudButton>

    </DialogActions>
</MudDialog>



@code {
    [CascadingParameter] MudDialogInstance? MudDialog { get; set; }
    [Parameter] public Models.M_YeuCauTuVanTTHQ _YeuCauTuVan_HQCO_Detail { get; set; }

    [Parameter] public string Status { get; set; }
    MudForm form;
    private List<PortModel> List_pod = new List<PortModel>();
    private List<PortModel> List_pol = new List<PortModel>();
    private string NumCrew { get; set; }
    private List<M_Customer> filteredCarr = new List<M_Customer>();
    private List<M_Customer> Cuss_Carr = new List<M_Customer>();
    public CultureInfo _de = CultureInfo.GetCultureInfo("de-DE");
    public CultureInfo _en = CultureInfo.GetCultureInfo("en-US");
    private List<M_Customer> customers = new List<M_Customer>();
    private List<M_Customer> List_Company_XK = new List<M_Customer>();
    string UserHanding;
    private List<string> ListUser { get; set; } = new List<string>();
    List<string> trangthais = new List<string>();
    List<string> ykiens = new List<string>();

    private List<Models.TrangThai> M_Trangthais = new List<Models.TrangThai>();
    private List<Models.M_Ykien_HQCO> M_ykiens = new List<Models.M_Ykien_HQCO>();
    private List<M_Customer> List_Company = new List<M_Customer>();

    protected async override Task OnInitializedAsync()
    {
        if (Status == "Duplicate")
        {
            _YeuCauTuVan_HQCO_Detail.YctvtthqcoID=Guid.Empty;
            _YeuCauTuVan_HQCO_Detail.Approve = false;
            _YeuCauTuVan_HQCO_Detail.SoYeuCau = "";
        }
        List_Company = await tkhqsv.GetList_Cusl();
        customers = await Cussv.GetList();
        M_Trangthais = await supsv.GetListTrangThai();
        var tts = await supsv.GetListTrangThai();
        trangthais = tts.Where(x => x.Tieude == "YeuCauThuTucHQCO").OrderBy(x => x.Noidung).Select(x => x.Noidung).ToList();
     
        var yks = await supsv.GetListYkien_HQCO();
        ykiens = yks.OrderBy(x => x.Ykien).Select(x => x.Ykien).ToList();

        if (Status == "add")
        {
            _YeuCauTuVan_HQCO_Detail.UserYeuCau = asv.GetAuth().Result.User.Identity!.Name!;
        }
        ListUser = await asv.GetList_User_handle() ?? new List<string>();

    }
    private async Task<IEnumerable<string>> Searchpol(string text)
    {
        try
        {
            if (string.IsNullOrWhiteSpace(text))
            {
                return List_pol.Where(x => !string.IsNullOrEmpty(x.PORT))
               .Select(x => x.PORT);
            }
            // MBL.Porname = mst_Consignee;
            return List_pol.Where(x => !string.IsNullOrEmpty(x.PORT) &&
                            x.PORT.Contains(text, StringComparison.OrdinalIgnoreCase))
               .Select(x => x.PORT);
        }
        catch (Exception)
        {
            throw;
        }
    }
    private async Task<IEnumerable<string>> Searchpod(string text)
    {
        try
        {
            if (string.IsNullOrWhiteSpace(text))
            {
                return List_pod.Where(x => !string.IsNullOrEmpty(x.PORT))
               .Select(x => x.PORT);
            }

            return List_pod.Where(x => !string.IsNullOrEmpty(x.PORT) &&
                            x.PORT.Contains(text, StringComparison.OrdinalIgnoreCase))
               .Select(x => x.PORT);
        }
        catch (Exception)
        {
            throw;
        }
    }
    private async Task Get_Sotokhai()
    {

        int formattedYear = DateTime.Now.Year;
        int formattedMonth = DateTime.Now.Month;

        string usr = asv.GetAuth().Result.User.Identity!.Name!;
        var refno = await supsv.GetRefNoByFunc("YeuCauTuVanHQ", formattedMonth, formattedYear, usr);
        var tiepdaungu = await supsv.GetTiepDauNguByFunc("YeuCauTuVanHQ");
        var rs = asv.GetUserDetail();
        var cn = rs.Branch;
        _YeuCauTuVan_HQCO_Detail.SoYeuCau = cn + "HQCO_" + formattedYear.ToString() + formattedMonth.ToString() + refno.Value.ToString("D4");
    }

    private async Task Submit()
    {
        if ((await ssv.CheckPermission(asv.GetAuth().Result.User.Identity.Name, "Edit", "TKHQ") || await ssv.CheckPermission(asv.GetAuth().Result.User.Identity.Name, "New", "TKHQ")))
        {

            await form.Validate();

            if (form.IsValid)
            {

                var UserName = asv.GetAuth().Result.User.Identity!.Name!;
                _YeuCauTuVan_HQCO_Detail.Dateupdate = DateTime.Now.ToString("dd-MMM-yyyy");
                _YeuCauTuVan_HQCO_Detail.UserUPdate = UserName;
                MudDialog!.Close(_YeuCauTuVan_HQCO_Detail);

            }
        }

    }
    void Cancel() => MudDialog.Cancel();

    void CallSnackBar(string message, MudBlazor.Severity severity)
    {
        
        Snackbar.Configuration.SnackbarVariant = Variant.Filled;
        Snackbar.Configuration.MaxDisplayedSnackbars = 3;
        Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopRight;
        Snackbar.Add(message, severity);
    }
  
    private async Task<IEnumerable<string>> Search_User(string value)
    {
        if (string.IsNullOrEmpty(value))
            return ListUser;

        return ListUser.Where(x => x.Contains(value, StringComparison.InvariantCultureIgnoreCase));
    }
    private async Task Getuser()
    {
        if (string.IsNullOrEmpty(_YeuCauTuVan_HQCO_Detail.UserTraLoi))
        {
            _YeuCauTuVan_HQCO_Detail.UserTraLoi = UserHanding;
        }
        else
        {
            _YeuCauTuVan_HQCO_Detail.UserTraLoi += "," + UserHanding + ",";
        }
    }
    private bool _processingUpload = false;
    async Task SendMailnotify()
    {
        try
        {
            string[] users = _YeuCauTuVan_HQCO_Detail.UserTraLoi.Split(',');
            List<string> emails = new List<string>(); // Danh sách động, có thể thêm thoải mái

            int index = 0;
            foreach (var user in users)
            {
                if (string.IsNullOrEmpty(user))
                {

                }
                else
                {
                    string inputemail = "";
                    inputemail = await gsv.GetEmailAsync(user);
                    if (!string.IsNullOrEmpty(inputemail))
                    {
                        emails.Add(inputemail);
                    }

                }
            }
            string[] emailarray = emails.ToArray();
            _processingUpload = true;
            await Task.Delay(1);
            StateHasChanged();
            if (emails != null && emailarray.Length > 0)
            {
                var rs = await gsv.GuiThongBaoYeuCauTuVanHQ(_YeuCauTuVan_HQCO_Detail, emailarray);
                if (rs.Flag == true)
                {
                    if (_YeuCauTuVan_HQCO_Detail.YctvtthqcoID == Guid.Empty)
                    {
                        _YeuCauTuVan_HQCO_Detail.TrangThai = "Emailed";
                    }
                    else
                    {
                        _YeuCauTuVan_HQCO_Detail.TrangThai = "Emailed";
                        await gsv.UpdateYeuCauTuVanHQCODetail(_YeuCauTuVan_HQCO_Detail);
                    
                    }
                }
                CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);

            }
            else
            {

                CallSnackBar("Email is empty!", MudBlazor.Severity.Warning);
                return;
            }

        }
        catch (Exception ex)
        {
            CallSnackBar("Somethings went wrong!, error code: " + ex.Message, MudBlazor.Severity.Error);
        }
        finally
        {
            _processingUpload = false;
        }

    }

    private bool _processingUploadzalo = false;
    async Task SendZalonotify()
    {
        try
        {
            _processingUploadzalo = true;
            await Task.Delay(1);
            StateHasChanged();

            if (string.IsNullOrEmpty(_YeuCauTuVan_HQCO_Detail.UserTraLoi))
            {
                CallSnackBar("User is empty!", MudBlazor.Severity.Warning);
                return;
            }

            string[] users = _YeuCauTuVan_HQCO_Detail.UserTraLoi.Split(',');
            List<string> zaloid = new List<string>(); // Danh sách động, có thể thêm thoải mái

            int index = 0;
            foreach (var user in users)
            {
                if (string.IsNullOrEmpty(user))
                {

                }
                else
                {


                    var userinfo = await asv.GetUserDetail_byname(user);
                    if (!string.IsNullOrEmpty(userinfo.Zaloid))
                    {
                        zaloid.Add(userinfo.Zaloid);
                    }

                }
            }

            foreach (var u in zaloid)
            {

                var rs = await gsv.SendMessageAsync(u, _YeuCauTuVan_HQCO_Detail.SoYeuCau, _YeuCauTuVan_HQCO_Detail.TieuDeYeuCau, _YeuCauTuVan_HQCO_Detail.NoiDung);
                if (!rs.Flag)
                {
                    CallSnackBar(rs.Message, MudBlazor.Severity.Error);
                    return;
                }
            }
            CallSnackBar("✅ Send Success!", MudBlazor.Severity.Success);
        }
        catch (Exception ex)
        {
            CallSnackBar("Somethings went wrong!, error code: " + ex.Message, MudBlazor.Severity.Error);
        }
        finally
        {
            _processingUploadzalo = false;
        }

    }

    List<string> Linksplit(string links)
    {
        if (string.IsNullOrEmpty(links))
            return new List<string>();
        return links.Split(';').ToList();
    }

    async Task SeeDetail(string link)
    {

        await JSRuntime.InvokeVoidAsync("open", link.Replace("ftp", "http"), "_blank");
    }
    async Task AttachFileToFTP(IBrowserFile file, M_YeuCauTuVanTTHQ item)
    {
        try
        {
            var rs = await ssv.UploadfiletoFTP_YeuCauTuVanHQCO(file, (object)item);
            CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
        }
        catch (Exception ex)
        {
            CallSnackBar("Throw exception code: " + ex.Message, MudBlazor.Severity.Error);
        }
    }

    async Task Deleteimg(M_YeuCauTuVanTTHQ item, string link)
    {
        try
        {
            if (item.Links!.Contains(";"))
                link = link + ";";
            item.Links = item.Links!.Replace(link, string.Empty);
       
            StateHasChanged();
        }
        catch (Exception ex)
        {
            CallSnackBar("Throw exception code: " + ex.Message, MudBlazor.Severity.Error);
        }
    }
    private async Task<IEnumerable<string>> SearchCompanyNK(string text)
    {
        try
        {
            if (string.IsNullOrWhiteSpace(text))
            {
                return List_Company.Where(x => !string.IsNullOrEmpty(x.COMPANY))
               .Select(x => x.COMPANY);
            }
            // MBL.Porname = mst_Consignee;
            return List_Company.Where(x => !string.IsNullOrEmpty(x.COMPANY) &&
                            x.COMPANY.Contains(text, StringComparison.OrdinalIgnoreCase))
               .Select(x => x.COMPANY);
        }
        catch (Exception)
        {
            throw;
        }
    }


    private void OnCompanyNKBlur(FocusEventArgs e)
    {
        var company = List_Company.FirstOrDefault(x => x.COMPANY == _YeuCauTuVan_HQCO_Detail.Congty);
        if (company != null)
        {
            _YeuCauTuVan_HQCO_Detail.diachi = company.Address;
                  _YeuCauTuVan_HQCO_Detail.masothue = company.TaxCode;
        }
    }

    private bool _processingUpload_message = false;
    async Task SendMessage(M_YeuCauTuVanTTHQ item)
    {
        try
        {
            string[] users = item.UserTraLoi.Split(',');
            List<string> listid = new List<string?>(); // Danh sách động, có thể thêm thoải mái

            int index = 0;
            foreach (var user in users)
            {
                if (string.IsNullOrEmpty(user))
                {

                }
                else
                {

                    Guid? inputid = await gsv.GetIdfromUser(user);
                    if (inputid != null)
                    {
                        listid.Add(inputid.ToString());
                    }

                }
            }
            string[] Idarray = listid.ToArray();
            _processingUpload_message = true;
            await Task.Delay(1);
            StateHasChanged();
            string noidung = "Request customs clearance consultation C/O - Request No :" + item.SoYeuCau;
            if (listid != null && Idarray.Length > 0)
            {
                await _notificationService.SendNotificationAsync(Idarray, noidung);


            }
            else
            {

                CallSnackBar("User is empty!", MudBlazor.Severity.Warning);
                return;
            }

        }
        catch (Exception ex)
        {
            CallSnackBar("Somethings went wrong!, error code: " + ex.Message, MudBlazor.Severity.Error);
        }
        finally
        {
            _processingUpload_message = false;
        }
    }

}
