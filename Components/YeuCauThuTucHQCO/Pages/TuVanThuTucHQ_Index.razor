    private async Task FilterPorts_pod()
    {

        // searchText = text;
        if (string.IsNullOrWhiteSpace(searchText_pod))
        {
            filteredPorts_pod = Ports;
        }
        else
        {
            filteredPorts_pod = Ports
             .Where(x => x.PORT != null &&
                         x.PORT.StartsWith(searchText_pod, StringComparison.OrdinalIgnoreCase) &&
                         x.PORT.Contains(searchText_pod, StringComparison.OrdinalIgnoreCase))
             .OrderBy(x => x.PORT)
             .ToList();
        }

        await InvokeAsync(StateHasChanged); // Cập nhật giao diện
    }
    private bool _processingUploadzalo = false;
    async Task SendZalonotify(M_YeuCauTuVanTTHQ item)
    {
        try
        {
            _processingUploadzalo = true;
            await Task.Delay(1);
            StateHasChanged();

            if (string.IsNullOrEmpty(item.UserTraLoi))
            {
                CallSnackBar("User is empty!", MudBlazor.Severity.Warning);
                return;
            }

            string[] users = item.UserTraLoi.Split(',');
            List<string> zaloid = new List<string>(); // Danh sách động, có thể thêm thoải mái

            int index = 0;
            foreach (var user in users)
            {
                if(string.IsNullOrEmpty(user)){

                }else{
             

                    var userinfo = await asv.GetUserDetail_byname(user);
                    if (!string.IsNullOrEmpty(userinfo.Zaloid))
                    {
                        zaloid.Add(userinfo.Zaloid);
                    }

                }
            }

            foreach (var u in zaloid)
            {
               
                var rs = await gsv.SendMessageAsync(u, item.SoYeuCau , item.TieuDeYeuCau ,item.NoiDung);
                if (!rs.Flag)
                {
                    CallSnackBar(rs.Message, MudBlazor.Severity.Error);
                    return;
                }
            }
            CallSnackBar("✅ Send Success!", MudBlazor.Severity.Success);
        }
        catch (Exception ex)
        {
            CallSnackBar("Somethings went wrong!, error code: " + ex.Message, MudBlazor.Severity.Error);
        }
        finally
        {
            _processingUploadzalo = false;
        }

    }

