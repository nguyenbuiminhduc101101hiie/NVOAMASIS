        @Localizer["Add Details"]
    </MudButton>

</MudStack>
        </Toolbar>
    </PpScreenHeader>

    <MudPaper Class="product-price-card" Elevation="0">
<MudDataGrid    T="M_YeuCauTuVanTTHQ" Items="@Listdata" Filterable="true" @ref="mudTable" Class="pa-4" 
                FilterMode="@DataGridFilterMode.ColumnFilterRow" Dense="true" Virtualize="true" QuickFilter="@FilterFunc1"
             FixedHeader="true" FixedFooter="true" HeaderClass="no-wrap" FooterClass="no-wrap" Bordered="true"
                ReadOnly="false" CommittedItemChanges="@CommittedItem" RowClassFunc="@SelectedRowClassFunc"
                RowClick="@RowClicked" EditDialogOptions="@options"
             ColumnResizeMode="@(_resizeColumn ? ResizeMode.Column : ResizeMode.Container)" Loading="_loading">
    <Columns>

        <HierarchyColumn T="M_YeuCauTuVanTTHQ" />
        <TemplateColumn CellClass="d-flex justify-end">
            <CellTemplate>

                <MudIconButton Icon="@Icons.Material.Outlined.Delete" OnClick="@(()=>DeleteItem(context.Item))" />
            </CellTemplate>
        </TemplateColumn>

      @*   <PropertyColumn Property="x=> Listdata.IndexOf(x)+1" Title="No." IsEditable="false" Required="false" Filterable="false" CellStyleFunc="_cellStyleFunc" /> *@
        <PropertyColumn Property="x=>x.SoYeuCau" Title="@Localizer["soyeucau"]" Required="false" CellStyleFunc="_cellStyleFunc">
            <EditTemplate>
                <MudStack Row>
                    <MudItem xs="2">
                        <MudButton Class="pl-4 pa-10" Style="background-color: #007BFF; color: white;" Size="Size.Small" Color="Color.Primary" OnClick="() => GetT_SoYeuCau(context.Item)">>>></MudButton>
                    </MudItem>

                    <MudItem xs="5">
                        <MudTextField @bind-Value="context.Item.SoYeuCau" Label="@Localizer["soyeucau"]" class="custom-label" Required="true" />
                    </MudItem>

                    <MudItem xs="5">
                        <MudTextField @bind-Value="context.Item.UserYeuCau" Label="@Localizer["nguoiyeucau"]" Disabled="true" Required="true" />
                    </MudItem>
                </MudStack>
            </EditTemplate>
        </PropertyColumn>

         <PropertyColumn Property="x=>x.Congty" Title="@Localizer["Congty"]" Required="false" CellStyleFunc="_cellStyleFunc">
            <EditTemplate>
                <MudTextField @bind-Value="context.Item.Congty" AutoGrow Label="@Localizer["Congty"]" class="custom-label" Required="false" />
            </EditTemplate>
        </PropertyColumn>

        <PropertyColumn Property="x=>x.masothue" Title="@Localizer["mst"]" Required="false" CellStyleFunc="_cellStyleFunc">
            <EditTemplate>
                <MudTextField @bind-Value="context.Item.masothue" AutoGrow Label="@Localizer["mst"]" class="custom-label" Required="false" />
            </EditTemplate>
        </PropertyColumn>

        <PropertyColumn Property="x=>x.diachi" Title="@Localizer["Address"]" Required="false" CellStyleFunc="_cellStyleFunc">
            <EditTemplate>
                <MudTextField @bind-Value="context.Item.diachi" AutoGrow Label="@Localizer["Address"]" class="custom-label" Required="false" />
            </EditTemplate>
        </PropertyColumn>

        <PropertyColumn Property="x=>x.TieuDeYeuCau" Title="@Localizer["tieudeyeucau"]" Required="false" CellStyleFunc="_cellStyleFunc">
            <EditTemplate>
                <MudTextField @bind-Value="context.Item.TieuDeYeuCau" Lines="3" AutoGrow Label="@Localizer["tieudeyeucau"]" class="custom-label" Required="false" />
            </EditTemplate>
        </PropertyColumn>

        <PropertyColumn Property="x=>x.NoiDung" Title="@Localizer["noidung"]" Required="false" CellStyleFunc="_cellStyleFunc">
            <EditTemplate>
                <MudTextField @bind-Value="context.Item.NoiDung" Lines="3" AutoGrow Label="@Localizer["noidung"]" class="custom-label" Required="false" />
            </EditTemplate>
        </PropertyColumn>

        <PropertyColumn Property="x=>x.ThoiGianBatDau" Title="@Localizer["thoigianbatdau"]" Required="false" Format="dd/MM/yyyy" CellStyleFunc="_cellStyleFunc">
            <EditTemplate>
                <MudDatePicker @bind-Date="context.Item.ThoiGianBatDau" Label="@Localizer["thoigianbatdau"]" class="custom-label" Required="false" />
            </EditTemplate>
        </PropertyColumn>

         <PropertyColumn Property="x=>x.ThoiGianKetThuc" Title="@Localizer["thoigianketthuc"]" Required="false" Format="dd/MM/yyyy" CellStyleFunc="_cellStyleFunc">
            <EditTemplate>
                <MudDatePicker @bind-Date="context.Item.ThoiGianKetThuc" Label="@Localizer["thoigianketthuc"]" class="custom-label" Required="false" />
            </EditTemplate>
        </PropertyColumn>

        <PropertyColumn Property="x=>x.YKien" Title="@Localizer["YKien"]" Required="false" CellStyleFunc="_cellStyleFunc">
            <EditTemplate>
                <MudSelect @bind-Value="context.Item.YKien" Label="@Localizer["YKien"]" class="custom-label">
                    @foreach (var item in ykiens)
                    {
                        <MudSelectItem Value="item">@item</MudSelectItem>
                    }
                </MudSelect>
            </EditTemplate>
        </PropertyColumn>

        <PropertyColumn Property="x=>x.TrangThai" Title="@Localizer["status"]" Required="false" CellStyleFunc="_cellStyleFunc">
            <EditTemplate>
                <MudSelect @bind-Value="context.Item.TrangThai" Label="@Localizer["status"]" class="custom-label">
                    @foreach (var item in trangthais)
                    {
                        <MudSelectItem Value="item">@item</MudSelectItem>
                    }
                </MudSelect>
            </EditTemplate>
        </PropertyColumn>

        <PropertyColumn Property="x=>x.UserTraLoi" Title="@Localizer["usertraloi"]" Required="false" CellStyleFunc="_cellStyleFunc" >
            <EditTemplate>
                <MudStack Row>
                    <MudItem>
                        <MudAutocomplete Class="pl-4 labelCustomColor custom-label" T="string"
                        @bind-Value="UserHanding"
                        Label="User:"
                        SearchFunc="Search_User"
                        Immediate="true"
                        CoerceText="true"
                        Clearable="true"
                        MaxItems="100">
                        </MudAutocomplete>
                    </MudItem>

                    <MudItem>
                        <MudButton Class="pl-4 labelCustomColor" Style="background-color: #007BFF; color: white;" Size="Size.Small" Color="Color.Primary" OnClick="() => Getuser(context.Item)">>>></MudButton>
                    </MudItem>

                    <MudTextField @bind-Value="context.Item.UserTraLoi" class="custom-label" HelperTextOnFocus HelperText="từ 2 mail trở lên vui lòng ngăn cách bằng dấu ','"
                    Lines="3" AutoGrow Label="@Localizer["usernhanemail"]" Required="false" />

                    <MudButton HtmlTag="label" Disabled="_processingUpload"
                    @onclick="@(() => SendMailnotify(context.Item))" 
                    Size="Size.Small" Color="Color.Tertiary" Variant="Variant.Filled"
                    StartIcon="@Icons.Material.Filled.Email">
                        @if (_processingUpload)
                        {
                            <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                            <MudText Class="ms-2">Processing</MudText>
                        }
                        else
                        {
                            <MudText>Send Email</MudText>
                        }
                    </MudButton>

                    <MudButton HtmlTag="label" Disabled="_processingUploadzalo"
                    @onclick="@(() => SendZalonotify(context.Item))"
                    Size="Size.Small" Color="Color.Tertiary" Variant="Variant.Filled"
                    StartIcon="@Icons.Material.Filled.Send">
                        @if (_processingUploadzalo)
                        {
                            <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                            <MudText Class="ms-2">Processing</MudText>
                        }
                        else
                        {
                            <MudText>Send Zalo</MudText>
                        }
                    </MudButton>
                </MudStack>
            </EditTemplate>
        </PropertyColumn>

        
            <TemplateColumn Title="@Localizer["Approve"]">
                <CellTemplate>
                    <MudCheckBox @bind-Checked="context.Item.Approve" @bind-Value="context.Item.Approve" @bind-Value:after="@(()=> OnApproveCheckboxWrapper(context.Item))">
                    </MudCheckBox>
                </CellTemplate>
            </TemplateColumn>

        <PropertyColumn Property="x=>x.UserUPdate" Title="User Update" Required="false" IsEditable="false" CellStyleFunc="_cellStyleFunc"/>
        <PropertyColumn Property="x=>x.Dateupdate" Title="Date Update" Required="false" IsEditable="false" CellStyleFunc="_cellStyleFunc" />

        <PropertyColumn Property="x=>x.Links" Title="Links Image" Required="false" CellStyleFunc="_cellStyleFunc" CellClass="no-wrap-cell" >
            <EditTemplate>
                <MudStack Row>
                    <MudContainer Class="pa-4; max-height:200px; overflow-y: auto; custom-label;">
                        <MudText Typo="Typo.h6">Hình ảnh mô tả</MudText>
                        @foreach (var item in Linksplit(context.Item.Links!))
                        {
                            <MudPaper Elevation="3" Style="position: relative; display: inline-block;">
                                <MudImage Src="@item.Replace("ftp","http")" Alt="@item.Replace("ftp","http")"
                                Height="150" Elevation="25" Class="rounded-lg ma-4" />

                                <MudIconButton Icon="@Icons.Material.Filled.Visibility" OnClick="@(() => SeeDetail(item))"
                                Style="position: absolute; top: 5px; left: 5px; padding: 0; min-width: 0;" />

                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error"
                                OnClick="@(() => Deleteimg(context.Item,item))"
                                Style="position: absolute; top: 5px; right: 5px; padding: 0; min-width: 0;" />
                            </MudPaper>
                        }
                    </MudContainer>

                    <MudFileUpload T="IBrowserFile" Accept=".png,.jpg,.jpeg" FilesChanged="@((t) => AttachFileToFTP(t,context.Item))">
                        <ButtonTemplate Context="context1">
                            <MudIconButton HtmlTag="label" for="@context1" Size="Size.Small" Color="Color.Secondary"
                            Icon="@Icons.Material.Filled.AttachFile" />
                        </ButtonTemplate>
                    </MudFileUpload>

                </MudStack>
            </EditTemplate>
        </PropertyColumn>

        <TemplateColumn Title="@Localizer["Approve"]">
            <CellTemplate>
                <MudCheckBox @bind-Checked="context.Item.Approve" @bind-Value="context.Item.Approve" @bind-Value:after="@(()=> OnApproveCheckboxWrapper(context.Item))">
                </MudCheckBox>
            </CellTemplate>
        </TemplateColumn>
    </Columns>
    <ChildRowContent>
        <MudTabs>
            <MudTabPanel Text="Product Price Detail">
                <AddDetails _YeuCauTuVanTTHQ_Details="context.Item" />
            </MudTabPanel>
        </MudTabs>
    </ChildRowContent>

     <PagerContent>
        <MudDataGridPager T="Models.M_YeuCauTuVanTTHQ" PageSizeOptions="@(new int[] { 8, 10, 20 })" />
    </PagerContent>
</MudDataGrid>
    </MudPaper>
</div>

@code {
    List<M_YeuCauTuVanTTHQ> Listdata = new List<M_YeuCauTuVanTTHQ>();
    MudDataGrid<M_YeuCauTuVanTTHQ> mudTable;
    AuthUser user;
    string mailtp, mailpp;
    string usr;
    private List<string> ListUser { get; set; } = new List<string>();
    string UserHanding;
    List<string> trangthais = new List<string>();
    private List<M_Customer> List_Company_NK = new List<M_Customer>();
    private List<Models.TrangThai> M_Trangthais = new List<Models.TrangThai>();
    private List<Models.M_Ykien_HQCO> ykiens = new List<Models.M_Ykien_HQCO>();
    private string searchText_pol = "";
    private string searchText_pod = "";
    private List<PortModel> filteredPorts = new List<PortModel>();
    private List<PortModel> filteredPorts_pod = new List<PortModel>();
    private List<PortModel> Ports = new List<PortModel>();
    private bool _resizeColumn;
    string useryeucau_ = "";
    protected async override Task OnInitializedAsync()
    {
        List_Company_NK = await tkhqsv.GetList_Cusl();
        useryeucau_ = asv.GetAuth().Result.User.Identity!.Name!;
        Ports = await bksv.GetList_PORT();
        M_Trangthais = await supsv.GetListTrangThai();
        var tts = await supsv.GetListTrangThai();
        trangthais = tts.Where(x => x.Tieude == "YeuCauThuTucHQCO").OrderBy(x => x.Noidung).Select(x => x.Noidung).ToList();
     
        ykiens = await supsv.GetListYkien_HQCO();
        // user = await asv.GetUserAsync();
        ListUser = await asv.GetList_User_handle() ?? new List<string>();
        usr = asv.GetAuth().Result.User.Identity!.Name!;
        // await Refresh();
    }
    M_YeuCauTuVanTTHQ detail;
    bool _loading = false;
    async Task Refresh()
    {
        try
        {
            detail = null!;
            _loading = true;
            Listdata.Clear();
     
            await Task.Delay(500);
            if (!await ssv.CheckPermission(usr, "View", "YeuCauThuTucHQCO"))
            {
                CallSnackBar("You have not access to view", MudBlazor.Severity.Warning);
                return;
            }
            Listdata = await HQCOsv.GetListYeuCauThuTucHQCO_request();
               StateHasChanged();
        }
        catch(Exception ex)
        {
            CallSnackBar("Something went wrong!, error code: " + ex.Message, MudBlazor.Severity.Warning);
        }
        finally
        {
            _loading = false;
        }

    }

    void CallSnackBar(string message, MudBlazor.Severity severity)
    {
        
        Snackbar.Configuration.SnackbarVariant = Variant.Filled;
        Snackbar.Configuration.MaxDisplayedSnackbars = 3;
        Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopRight;
        Snackbar.Add(message, severity);
    }
    void RowClicked(DataGridRowClickEventArgs<M_YeuCauTuVanTTHQ> args)
    {
        detail = args.Item;
    }
    private int selectedRowNumber = -1;
    private string SelectedRowClassFunc(M_YeuCauTuVanTTHQ m, int rowNumber)
    {
        if (selectedRowNumber == rowNumber)
        {
            selectedRowNumber = -1;
            return string.Empty;
        }
        else if (mudTable.SelectedItem != null && mudTable.SelectedItem.Equals(m))
        {
            selectedRowNumber = rowNumber;
            return "selected";
        }
        else
        {
            return string.Empty;
        }
    }

    async Task CommittedItem(M_YeuCauTuVanTTHQ item)
    {

        item.UserUPdate = asv.GetAuth().Result.User.Identity!.Name!;
        item.Dateupdate = DateTime.Now.ToString("dd/MMM/yyyy");
        var rs = item.YctvtthqcoID != Guid.Empty ? await HQCOsv.UpdateHQCODetail(item) : await HQCOsv.CreateHQCOsvDetail(item);
        CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);

        await Refresh();
    }

    async Task AddItem()
    {
        if (!await ssv.CheckPermission(usr, "Add", "YeuCauThuTucHQCO"))
        {
            CallSnackBar("You have not access to Add", MudBlazor.Severity.Warning);
            return;
        }
        var item = new M_YeuCauTuVanTTHQ
        {
       
            Approve = false,
            Editable= false,
            Continued = true
        };
        item.UserUPdate = asv.GetAuth().Result.User.Identity!.Name!;
        item.Dateupdate = DateTime.Now.ToString("dd/MMM/yyyy");
        Listdata.Add(item);
        await mudTable.SetEditingItemAsync(Listdata.LastOrDefault()!);
    }

    async Task DeleteItem(M_YeuCauTuVanTTHQ item)
    {
        if (item.Approve == true)
        {
            CallSnackBar("Data đã được Approve!!! , vui lòng bỏ Approve", MudBlazor.Severity.Warning);
            return;
        }
        if (!await ssv.CheckPermission(usr, "Delete", "YeuCauThuTucHQCO"))
        {
            CallSnackBar("You have not access to Delete", MudBlazor.Severity.Warning);
            return;
        }
        var resultMess = await DialogService.ShowMessageBox(
                "Warning",
                "Deleting can not be undone!",
                yesText: "Delete!", cancelText: "Cancel");

        if (resultMess.HasValue)
        {
            var rs = await HQCOsv.DeleteHQCODetail(item);
            await HQCOsv.DeleteDetail_HQCO(item.YctvtthqcoID);
            await HistoryLogService.LogAsync(usr, "Delete Yeu Cau Thu Tuc HQCO", "YeuCauThuTucHQCO", item.YctvtthqcoID, item.SoYeuCau, new { OldData = item });
            CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
            await Refresh();
        }

    }
    DialogOptions options = new DialogOptions 
    {
        ClassBackground = "class-dialog-custom",
        FullWidth = true,
        MaxWidth = MaxWidth.Medium,
        CloseOnEscapeKey = false,
        DisableBackdropClick = true
    };
    string search;

    private bool FilterFunc1(M_YeuCauTuVanTTHQ sbd) => FilterFunc(sbd, search);

    private bool FilterFunc(M_YeuCauTuVanTTHQ sbd, string searchString)
    {
        if (string.IsNullOrWhiteSpace(sbd.SoYeuCau))
            return true;
        if (string.IsNullOrWhiteSpace(searchString))
            return true;
        if (sbd.SoYeuCau!.Contains(searchString, StringComparison.OrdinalIgnoreCase))
            return true;
        if ($"{sbd.SoYeuCau} ".Contains(searchString))
            return true;
        return false;
    }

    private Func<M_YeuCauTuVanTTHQ, string> _cellStyleFunc => x =>
      {
          string style = "";

          if (string.IsNullOrEmpty(x.TrangThai))
              return "color: #000000";

          var rs = M_Trangthais
          .Where(t => (t.Noidung).Contains(x.TrangThai, StringComparison.InvariantCultureIgnoreCase)
              && t.Tieude.Equals("YeuCauThuTucHQCO", StringComparison.InvariantCultureIgnoreCase))
          .Select(t => t.Mamau)
          .FirstOrDefault();
          return "color: " + rs;


      };

    async Task AttachFileToFTP(IBrowserFile file, M_YeuCauTuVanTTHQ item)
    {
        try
        {
            var rs = await ssv.UploadfiletoFTP_YeuCauTuVanHQCO(file, (object)item);
            CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
        }
        catch(Exception ex)
        {
            CallSnackBar("Throw exception code: " + ex.Message, MudBlazor.Severity.Error);
        }
    }

    async Task Deleteimg(M_YeuCauTuVanTTHQ item ,string link)
    {
        try
        {
            if (item.Links!.Contains(";"))
                link = link + ";";
            item.Links = item.Links!.Replace(link, string.Empty);
            //var rs = ssv.DeleteFileFromFTP(link);
            //CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
            StateHasChanged();
        }
        catch(Exception ex)
        {
            CallSnackBar("Throw exception code: " + ex.Message, MudBlazor.Severity.Error);
        }
    }
    async Task SeeDetail(string link)
    {

        await JSRuntime.InvokeVoidAsync("open", link.Replace("ftp", "http"), "_blank");
    }
    List<string>Linksplit(string links)
    {
        if (string.IsNullOrEmpty(links))
            return new List<string>();
        return links.Split(';').ToList(); 
    }
    private bool _processingUpload = false;
    async Task SendMailnotify(M_YeuCauTuVanTTHQ item)
    {
        try
        {
            string[] users = item.UserTraLoi.Split(',');
            List<string> emails = new List<string>(); // Danh sách động, có thể thêm thoải mái

            int index = 0;
            foreach (var user in users)
            {
                if(string.IsNullOrEmpty(user)){

                }else{
                    string inputemail ="";
                    inputemail = await gsv.GetEmailAsync(user);
                    if (!string.IsNullOrEmpty(inputemail))
                    {
                        emails.Add(inputemail);
                    }

                }
            }
            string[] emailarray = emails.ToArray();
            _processingUpload = true;
            await Task.Delay(1);
            StateHasChanged();
            if (emails != null && emailarray.Length > 0)
            {
                var rs = await gsv.GuiThongBaoYeuCauTuVanHQ(item, emailarray);
                if(rs.Flag == true){
                    if (item.YctvtthqcoID == Guid.Empty)
                    {
                        item.TrangThai = "Emailed";
                    }else{
                        item.TrangThai = "Emailed";
                        await gsv.UpdateYeuCauTuVanHQCODetail(item);
                        await Refresh();
                    }
                }
                CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);

            }else{

                CallSnackBar("Email is empty!", MudBlazor.Severity.Warning);
                return;
            }




        }
        catch (Exception ex)
        {
            CallSnackBar("Somethings went wrong!, error code: " + ex.Message, MudBlazor.Severity.Error);
        }
        finally
        {
            _processingUpload = false;
        }

    }

    private async Task<IEnumerable<string>> Search_User(string value)
    {
        if (string.IsNullOrEmpty(value))
            return ListUser;

        return ListUser.Where(x => x.Contains(value, StringComparison.InvariantCultureIgnoreCase));
    }

    private async Task Getuser(M_YeuCauTuVanTTHQ item)
    {
        if (string.IsNullOrEmpty(item.UserTraLoi))
        {
            item.UserTraLoi = UserHanding;
        }
        else
        {
            item.UserTraLoi += "," + UserHanding + ",";
        }
    }

    private async Task GetT_SoYeuCau(M_YeuCauTuVanTTHQ item)
    {

        int formattedYear = DateTime.Now.Year;
        int formattedMonth = DateTime.Now.Month;

        string usr = asv.GetAuth().Result.User.Identity!.Name!;
        var refno = await supsv.GetRefNoByFunc("YeuCauTuVanHQ", formattedMonth, formattedYear, usr);
        var tiepdaungu = await supsv.GetTiepDauNguByFunc("YeuCauTuVanHQ");
        var rs = asv.GetUserDetail();
        var cn = rs.Branch;
        item.SoYeuCau = cn + "HQCO_" + formattedYear.ToString() + formattedMonth.ToString() + refno.Value.ToString("D4");

    }

  
    private async Task FilterPorts_pol()
    {

        // searchText = text;
        if (string.IsNullOrWhiteSpace(searchText_pol))
        {
            filteredPorts = Ports;
        }
        else
        {
            filteredPorts = Ports
            .Where(x => x.PORT != null &&
                        x.PORT.StartsWith(searchText_pol, StringComparison.OrdinalIgnoreCase) &&
                        x.PORT.Contains(searchText_pol, StringComparison.OrdinalIgnoreCase))
            .OrderBy(x => x.PORT)
            .ToList();
        }

        await InvokeAsync(StateHasChanged); // Cập nhật giao diện
