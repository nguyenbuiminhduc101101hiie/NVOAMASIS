@page "/YeuCauThuTucHQCO"

@attribute [Authorize]
@inject GlobalServices gsv
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject AccountService asv
@inject SharedServices ssv
@inject BookingService bksv 
@inject IJSRuntime JSRuntime
@inject SupportServices supsv
@inject ThuTucTuVanHQ_Services HQCOsv
@inject TKHQ_Services tkhqsv
@inject IStringLocalizer<SharedResource> Localizer
@inject HistoryLogService HistoryLogService
@using System.Text.Json;

<PageTitle>Project</PageTitle>
<div class="product-price-page">
    <PpScreenHeader Title="@Localizer["YeuCauThuTucHQ"]" Subtitle="Customs consultation C/O requests">
        <Toolbar>
<MudStack Row Justify="Justify.FlexStart" Class="pa-2 flex-wrap">
    <MudButton  HtmlTag="label"
                OnClick="Refresh"
                Size="Size.Small" Color="Color.Primary" Variant="   Variant.Filled"
                StartIcon="@Icons.Material.Filled.Refresh">
        Reload
    </MudButton>
    @* <MudButton  HtmlTag="label"
                @onclick="@(() => AddItem())"
                Size="Size.Small" Color="Color.Secondary" Variant="Variant.Filled"
                StartIcon="@Icons.Material.Filled.Add">
        New
    </MudButton> *@

    <MudButton  HtmlTag="label"
                 @onclick="@((e) => OpenCreateDialog(new Models.M_YeuCauTuVanTTHQ()))"
