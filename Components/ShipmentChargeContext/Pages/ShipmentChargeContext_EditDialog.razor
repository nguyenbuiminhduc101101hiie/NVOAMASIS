@using Microsoft.EntityFrameworkCore
@using Microsoft.Extensions.Localization
@using MudBlazor
@using NVOAMASIS.Data
@using NVOAMASIS.Models
@using NVOAMASIS.Resources
@inject IDbContextFactory<AppDbContext> DbFactory
@inject ISnackbar Snackbar
@inject IStringLocalizer<SharedResource> Localizer

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form">
            <MudGrid @key="DialogKey" Spacing="2">
                <MudItem xs="12" md="6">
                    <MudAutocomplete T="LookupItem"
                                     Value="_hblItem"
                                     ValueChanged="OnHblItemChangedAsync"
                                     Label="@Localizer["Scc_Lbl_HBL"]"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Required="true"
                                     ToStringFunc="@(x => x?.Display ?? string.Empty)"
                                     EqualsFunc="@LookupEquals"
                                     SearchFunc="SearchHblAsync"
                                     MinCharacters="0"
                                     MaxItems="50"
                                     ShowProgressIndicator="true"
                                     Clearable="true"
                                     Dense="true"
                                     CoerceText="false"
                                     Strict="false"
                                     ResetValueOnEmptyText="true" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudAutocomplete T="LookupItem"
                                     @bind-Value="_containerItem"
                                     Label="@Localizer["Scc_Lbl_Container"]"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Required="true"
                                     Disabled="@(_hblItem is null || _hblItem.Id == Guid.Empty)"
                                     ToStringFunc="@(x => x?.Display ?? string.Empty)"
                                     EqualsFunc="@LookupEquals"
                                     SearchFunc="SearchContainersAsync"
                                     MinCharacters="0"
                                     MaxItems="50"
                                     ShowProgressIndicator="true"
                                     Clearable="true"
                                     Dense="true"
                                     CoerceText="false"
                                     Strict="false"
                                     ResetValueOnEmptyText="true" />
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudAutocomplete T="LookupItem"
                                     Value="_tariffHeaderItem"
                                     ValueChanged="OnTariffHeaderChangedAsync"
                                     Label="@Localizer["TariffHeader_Lbl_TariffCode"]"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     ToStringFunc="@(x => x?.Display ?? string.Empty)"
                                     EqualsFunc="@LookupEquals"
                                     SearchFunc="SearchTariffHeadersAsync"
                                     MinCharacters="0"
                                     MaxItems="50"
                                     ShowProgressIndicator="true"
                                     Clearable="true"
                                     Dense="true"
                                     CoerceText="false"
                                     Strict="false"
                                     ResetValueOnEmptyText="true" />
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudAutocomplete T="LookupItem"
                                     @bind-Value="_chargeTypeItem"
                                     Label="@Localizer["Scc_Lbl_ChargeType"]"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Required="true"
                                     ToStringFunc="@(x => x?.Display ?? string.Empty)"
                                     EqualsFunc="@LookupEquals"
                                     SearchFunc="SearchChargeTypesByNameAsync"
                                     MinCharacters="0"
                                     MaxItems="50"
                                     ShowProgressIndicator="true"
                                     Clearable="true"
                                     Dense="true"
                                     CoerceText="false"
                                     Strict="false"
                                     ResetValueOnEmptyText="true" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudAutocomplete T="LookupItem"
                                     @bind-Value="_customerItem"
                                     Label="@Localizer["Scc_Lbl_Customer"]"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Required="true"
                                     ToStringFunc="@(x => x?.Display ?? string.Empty)"
                                     EqualsFunc="@LookupEquals"
                                     SearchFunc="SearchCustomersAsync"
                                     MinCharacters="0"
                                     MaxItems="50"
                                     ShowProgressIndicator="true"
                                     Clearable="true"
                                     Dense="true"
                                     CoerceText="false"
                                     Strict="false"
                                     ResetValueOnEmptyText="true" />
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudAutocomplete T="LookupItem"
                                     @bind-Value="_shippingLineItem"
                                     Label="@Localizer["Scc_Lbl_ShippingLine"]"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Required="true"
                                     ToStringFunc="@(x => x?.Display ?? string.Empty)"
                                     EqualsFunc="@LookupEquals"
                                     SearchFunc="SearchShippingLinesAsync"
                                     MinCharacters="0"
                                     MaxItems="50"
                                     ShowProgressIndicator="true"
                                     Clearable="true"
                                     Dense="true"
                                     CoerceText="false"
                                     Strict="false"
                                     ResetValueOnEmptyText="true" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudAutocomplete T="LookupItem"
                                     @bind-Value="_depotItem"
                                     Label="@Localizer["Scc_Lbl_Depot"]"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Required="true"
                                     ToStringFunc="@(x => x?.Display ?? string.Empty)"
                                     EqualsFunc="@LookupEquals"
                                     SearchFunc="SearchPortsAsync"
                                     MinCharacters="0"
                                     MaxItems="50"
                                     ShowProgressIndicator="true"
                                     Clearable="true"
                                     Dense="true"
                                     CoerceText="false"
                                     Strict="false"
                                     ResetValueOnEmptyText="true" />
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudAutocomplete T="LookupItem"
                                     @bind-Value="_terminalItem"
                                     Label="@Localizer["Scc_Lbl_Terminal"]"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Required="true"
                                     ToStringFunc="@(x => x?.Display ?? string.Empty)"
                                     EqualsFunc="@LookupEquals"
                                     SearchFunc="SearchTerminalsAsync"
                                     MinCharacters="0"
                                     MaxItems="50"
                                     ShowProgressIndicator="true"
                                     Clearable="true"
                                     Dense="true"
                                     CoerceText="false"
                                     Strict="false"
                                     ResetValueOnEmptyText="true" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudAutocomplete T="string"
                                     @bind-Value="_containerType"
                                     Label="@Localizer["Scc_Lbl_ContainerType"]"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Required="true"
                                     SearchFunc="SearchContainerTypesAsync"
                                     MinCharacters="0"
                                     MaxItems="50"
                                     CoerceValue="true"
                                     CoerceText="true"
                                     Clearable="true"
                                     Dense="true" />
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="_direction" Label="@Localizer["Scc_Lbl_Direction"]" Variant="Variant.Outlined" Margin="Margin.Dense" MaxLength="64" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="_currencyCode" Label="@Localizer["Scc_Lbl_Currency"]" Variant="Variant.Outlined" Margin="Margin.Dense" MaxLength="16" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudNumericField T="decimal?"
                                     @bind-Value="_amount"
                                     Label="Amount"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Min="0"
                                     HideSpinButtons="true"
                                     Format="N2" />
                </MudItem>
                <MudItem xs="12" md="2" Class="d-flex align-end">
                    <MudButton Variant="Variant.Filled" Color="Color.Info" OnClick="TinhTienAsync">Tính Tiền</MudButton>
                </MudItem>

                <MudItem xs="12" md="4">
                    <MudDatePicker @bind-Date="_emptyPickupDate" Label="@Localizer["Scc_Lbl_EmptyPickup"]" Variant="Variant.Outlined" Margin="Margin.Dense" DateFormat="dd/MM/yyyy" Clearable="true" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudDatePicker @bind-Date="_fullDischargeDate" Label="@Localizer["Scc_Lbl_FullDischarge"]" Variant="Variant.Outlined" Margin="Margin.Dense" DateFormat="dd/MM/yyyy" Clearable="true" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudDatePicker @bind-Date="_fullDeliveryDate" Label="@Localizer["Scc_Lbl_FullDelivery"]" Variant="Variant.Outlined" Margin="Margin.Dense" DateFormat="dd/MM/yyyy" Clearable="true" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudDatePicker @bind-Date="_emptyReturnDate" Label="@Localizer["Scc_Lbl_EmptyReturn"]" Variant="Variant.Outlined" Margin="Margin.Dense" DateFormat="dd/MM/yyyy" Clearable="true" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudDatePicker @bind-Date="_storageInDate" Label="@Localizer["Scc_Lbl_StorageIn"]" Variant="Variant.Outlined" Margin="Margin.Dense" DateFormat="dd/MM/yyyy" Clearable="true" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudDatePicker @bind-Date="_storageOutDate" Label="@Localizer["Scc_Lbl_StorageOut"]" Variant="Variant.Outlined" Margin="Margin.Dense" DateFormat="dd/MM/yyyy" Clearable="true" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudNumericField T="int" @bind-Value="_freeDays" Label="@Localizer["Scc_Lbl_FreeDays"]" Variant="Variant.Outlined" Margin="Margin.Dense" Min="0" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudNumericField T="int?" @bind-Value="_billableDays" Label="@Localizer["Scc_Lbl_BillableDays"]" Variant="Variant.Outlined" Margin="Margin.Dense" Min="0" Clearable="true" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="_remarks" Label="@Localizer["Scc_Lbl_Remarks"]" Variant="Variant.Outlined" Margin="Margin.Dense" Lines="3" MaxLength="4000" />
                </MudItem>
            </MudGrid>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="Cancel">@Localizer["cancel"]</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync">@Localizer["save"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private const int ComboResultLimit = 50;

    private sealed class LookupItem
    {
        public Guid Id { get; init; }
        public string Display { get; init; } = string.Empty;
    }

    private static bool LookupEquals(LookupItem? a, LookupItem? b) =>
        ReferenceEquals(a, b) || (a is not null && b is not null && a.Id == b.Id);

    [CascadingParameter] private MudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public M_ShipmentChargeContext? Model { get; set; }
    [Parameter] public bool IsEdit { get; set; }
    [Parameter] public int DialogKey { get; set; }

    public sealed class ShipmentChargeContextDialogResult
    {
        public bool IsEdit { get; init; }
        public M_ShipmentChargeContext Entity { get; init; } = new();
    }

    private static readonly string[] ContainerTypes =
    {
        "20DC", "40DC", "40HC", "40RH", "45HC", "20RF", "40RF", "20OT", "40OT", "20FR", "40FR",
        "20GP", "40GP", "45GP", "20NOR", "40NOR", "45RT", "53HC", "20TK", "40TK", "20ST", "40ST",
        "20HCRF", "40HCRF", "20PL", "40PL", "20HT", "40HT", "20GOH", "40GOH", "20RE", "40RE",
        "20ISOTANK", "40ISOTANK", "20SOC", "40SOC", "48HC", "40PW", "20PW", "45HW", "48PW",
        "20NB", "40NB", "20AC", "40AC", "20VV", "40VV", "20MX", "40MX", "L5G1", "20VH", "40VH"
    };

    private MudForm? _form;
    private int _lastDialogKey = int.MinValue;

    private LookupItem? _hblItem;
    private LookupItem? _containerItem;
    private LookupItem? _tariffHeaderItem;
    private LookupItem? _chargeTypeItem;
    private LookupItem? _customerItem;
    private LookupItem? _shippingLineItem;
    private LookupItem? _depotItem;
    private LookupItem? _terminalItem;
    private string _containerType = "20DC";
    private string? _direction;
    private string? _currencyCode = "USD";
    private int _freeDays;
    private int? _billableDays;
    private DateTime? _emptyPickupDate;
    private DateTime? _fullDischargeDate;
    private DateTime? _fullDeliveryDate;
    private DateTime? _emptyReturnDate;
    private DateTime? _storageInDate;
    private DateTime? _storageOutDate;
    private string? _remarks;
    private decimal? _amount;

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();
        if (DialogKey == _lastDialogKey)
            return;
        _lastDialogKey = DialogKey;
        await LoadFromModelAsync();
    }

    private async Task LoadFromModelAsync()
    {
        if (Model is null)
            return;

        _direction = Model.Direction;
        _currencyCode = string.IsNullOrWhiteSpace(Model.CurrencyCode) ? "USD" : Model.CurrencyCode;
        _freeDays = Model.FreeDays;
        _billableDays = Model.BillableDays;
        _emptyPickupDate = Model.EmptyPickupDate;
        _fullDischargeDate = Model.FullDischargeDate;
        _fullDeliveryDate = Model.FullDeliveryDate;
        _emptyReturnDate = Model.EmptyReturnDate;
        _storageInDate = Model.StorageInDate;
        _storageOutDate = Model.StorageOutDate;
        _remarks = Model.Remarks;
        _amount = Model.Amount;
        _containerType = string.IsNullOrWhiteSpace(Model.ContainerTypeId) ? "20DC" : Model.ContainerTypeId!;

        await using var db = await DbFactory.CreateDbContextAsync();

        if (Model.ShipmentId != Guid.Empty)
        {
            var h = await db.HBL.AsNoTracking().FirstOrDefaultAsync(x => x.hblID == Model.ShipmentId);
            _hblItem = h is null ? null : new LookupItem { Id = h.hblID, Display = HblDisplay(h) };
        }
        else
            _hblItem = null;

        if (Model.ContainerId != Guid.Empty)
        {
            var c = await db.Container.AsNoTracking().FirstOrDefaultAsync(x => x.CTN_ID == Model.ContainerId);
            _containerItem = c is null ? null : new LookupItem { Id = c.CTN_ID, Display = ContainerDisplay(c) };
        }
        else
            _containerItem = null;

        if (Model.tariffcode_id is Guid tid && tid != Guid.Empty)
        {
            var th = await db.TariffHeader.AsNoTracking().FirstOrDefaultAsync(x => x.Id == tid);
            _tariffHeaderItem = th is null ? null : new LookupItem { Id = th.Id, Display = TariffHeaderDisplay(th) };
        }
        else
            _tariffHeaderItem = null;

        if (Model.ChargeTypeId != Guid.Empty)
        {
            var ct = await db.ChargeType.AsNoTracking().FirstOrDefaultAsync(x => x.Id == Model.ChargeTypeId);
            _chargeTypeItem = ct is null ? null : new LookupItem { Id = ct.Id, Display = ChargeTypeDisplay(ct) };
        }
        else
            _chargeTypeItem = null;

        if (Model.CustomerId != Guid.Empty)
        {
            var cu = await db.Customer.AsNoTracking().FirstOrDefaultAsync(x => x.Customer_ID == Model.CustomerId);
            _customerItem = cu is null ? null : new LookupItem { Id = cu.Customer_ID, Display = CustomerDisplay(cu) };
        }
        else
            _customerItem = null;

        if (Model.ShippingLineId != Guid.Empty)
        {
            var s = await db.Customer.AsNoTracking().FirstOrDefaultAsync(x => x.Customer_ID == Model.ShippingLineId);
            _shippingLineItem = s is null ? null : new LookupItem { Id = s.Customer_ID, Display = CustomerDisplay(s) };
        }
        else
            _shippingLineItem = null;

        if (!string.IsNullOrWhiteSpace(Model.DepotId) && Guid.TryParse(Model.DepotId, out var depotGuid))
        {
            var p = await db.Port.AsNoTracking().FirstOrDefaultAsync(x => x.PORT_ID == depotGuid);
            _depotItem = p is null ? null : new LookupItem { Id = p.PORT_ID, Display = PortDisplay(p) };
        }
        else
            _depotItem = null;

        if (!string.IsNullOrWhiteSpace(Model.PortId) && Guid.TryParse(Model.PortId, out var termGuid))
        {
            var t = await db.Terminal.AsNoTracking().FirstOrDefaultAsync(x => x.TerminalID == termGuid);
            _terminalItem = t is null ? null : new LookupItem { Id = t.TerminalID, Display = TerminalDisplay(t) };
        }
        else
            _terminalItem = null;
    }

    private static string HblDisplay(M_HBL h)
    {
        var no = h.hbl?.Trim();
        if (!string.IsNullOrEmpty(no))
            return no;
        var bk = h.bkno?.Trim();
        if (!string.IsNullOrEmpty(bk))
            return bk;
        return h.hblID.ToString();
    }

    private static string ContainerDisplay(M_Container c)
    {
        if (!string.IsNullOrWhiteSpace(c.CONTAINER_NO))
            return c.CONTAINER_NO.Trim();
        return c.CTN_ID.ToString();
    }

    private static string ChargeTypeDisplay(M_ChargeType x)
    {
        var name = x.Name?.Trim() ?? "";
        var code = x.Code?.Trim() ?? "";
        if (!string.IsNullOrEmpty(name) && !string.IsNullOrEmpty(code))
            return $"{name} ({code})";
        return !string.IsNullOrEmpty(name) ? name : (!string.IsNullOrEmpty(code) ? code : x.Id.ToString());
    }

    private static string CustomerDisplay(M_Customer x)
    {
        var code = !string.IsNullOrWhiteSpace(x.Customer_Code)
            ? x.Customer_Code.Trim()
            : (!string.IsNullOrWhiteSpace(x.MainCode) ? x.MainCode.Trim() : "");
        var en = !string.IsNullOrWhiteSpace(x.EnglishName) ? x.EnglishName.Trim() : "";
        if (!string.IsNullOrEmpty(code) && !string.IsNullOrEmpty(en))
            return $"{code}_{en}";
        if (!string.IsNullOrEmpty(en))
            return en;
        if (!string.IsNullOrEmpty(code))
            return code;
        if (!string.IsNullOrWhiteSpace(x.COMPANY))
            return x.COMPANY.Trim();
        return x.Customer_ID.ToString();
    }

    private static string PortDisplay(PortModel x)
    {
        if (!string.IsNullOrWhiteSpace(x.PORT) && !string.IsNullOrWhiteSpace(x.PORT_CODE))
            return $"{x.PORT} ({x.PORT_CODE})";
        return x.PORT ?? x.PORT_CODE ?? x.PORT_ID.ToString();
    }

    private static string TerminalDisplay(Terminal_ x)
    {
        if (!string.IsNullOrWhiteSpace(x.TermiNalName))
            return x.TermiNalName!;
        if (!string.IsNullOrWhiteSpace(x.Code))
            return x.Code!;
        return x.TerminalID.ToString();
    }

    private static string TariffHeaderDisplay(M_TariffHeader h)
    {
        var code = h.TariffCode?.Trim();
        return !string.IsNullOrEmpty(code) ? code : h.Id.ToString();
    }

    private async Task OnTariffHeaderChangedAsync(LookupItem? value)
    {
        _tariffHeaderItem = value;
        if (value is null || value.Id == Guid.Empty)
            return;

        await using var db = await DbFactory.CreateDbContextAsync();
        var th = await db.TariffHeader.AsNoTracking().FirstOrDefaultAsync(x => x.Id == value.Id);
        if (th is null)
            return;

        await ApplyTariffHeaderToFieldsAsync(db, th);
    }

    private async Task ApplyTariffHeaderToFieldsAsync(AppDbContext db, M_TariffHeader th)
    {
        if (th.ChargeTypeId != Guid.Empty)
        {
            var ct = await db.ChargeType.AsNoTracking().FirstOrDefaultAsync(x => x.Id == th.ChargeTypeId);
            _chargeTypeItem = ct is null ? null : new LookupItem { Id = ct.Id, Display = ChargeTypeDisplay(ct) };
        }

        if (th.CustomerId != Guid.Empty)
        {
            var cu = await db.Customer.AsNoTracking().FirstOrDefaultAsync(x => x.Customer_ID == th.CustomerId);
            _customerItem = cu is null ? null : new LookupItem { Id = cu.Customer_ID, Display = CustomerDisplay(cu) };
        }

        if (th.ShippingLineId != Guid.Empty)
        {
            var sl = await db.Customer.AsNoTracking().FirstOrDefaultAsync(x => x.Customer_ID == th.ShippingLineId);
            _shippingLineItem = sl is null ? null : new LookupItem { Id = sl.Customer_ID, Display = CustomerDisplay(sl) };
        }

        if (th.DepotId != Guid.Empty)
        {
            var p = await db.Port.AsNoTracking().FirstOrDefaultAsync(x => x.PORT_ID == th.DepotId);
            _depotItem = p is null ? null : new LookupItem { Id = p.PORT_ID, Display = PortDisplay(p) };
        }

        if (th.PortId != Guid.Empty)
        {
            var t = await db.Terminal.AsNoTracking().FirstOrDefaultAsync(x => x.TerminalID == th.PortId);
            _terminalItem = t is null ? null : new LookupItem { Id = t.TerminalID, Display = TerminalDisplay(t) };
        }

        _direction = string.IsNullOrWhiteSpace(th.Direction) ? null : th.Direction.Trim();
        _containerType = string.IsNullOrWhiteSpace(th.ContainerTypeId) ? "20DC" : th.ContainerTypeId.Trim();
    }

    private async Task OnHblItemChangedAsync(LookupItem? value)
    {
        var prevId = _hblItem?.Id;
        _hblItem = value;
        var newId = value?.Id ?? Guid.Empty;

        if (newId == Guid.Empty)
        {
            _containerItem = null;
            _freeDays = 0;
            return;
        }

        if (prevId == newId)
            return;

        await using var db = await DbFactory.CreateDbContextAsync();
        var hbl = await db.HBL.AsNoTracking().FirstOrDefaultAsync(x => x.hblID == newId);
        if (hbl is not null)
            _freeDays = ComputeFreeDaysFromHbl(hbl);

        if (_containerItem is null)
            return;

        var c = await db.Container.AsNoTracking().FirstOrDefaultAsync(x => x.CTN_ID == _containerItem.Id);
        if (c?.hblid != newId)
            _containerItem = null;
    }

    private static int ComputeFreeDaysFromHbl(M_HBL hbl)
    {
        var total = (hbl.Det ?? 0d) + (hbl.Dem ?? 0d) + (hbl.Combine ?? 0d);
        if (total <= 0)
            return 0;
        return (int)Math.Round(total, MidpointRounding.AwayFromZero);
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task TinhTienAsync()
    {
        if (_tariffHeaderItem is null || _tariffHeaderItem.Id == Guid.Empty)
        {
            Snackbar.Add("Vui lòng chọn TariffCode trước khi tính tiền.", MudBlazor.Severity.Warning);
            return;
        }

        await using var dbCtx = await DbFactory.CreateDbContextAsync();
        var chargeTypeId = _chargeTypeItem?.Id;
        if (chargeTypeId is null || chargeTypeId == Guid.Empty)
        {
            var thForCt = await dbCtx.TariffHeader.AsNoTracking()
                .FirstOrDefaultAsync(x => x.Id == _tariffHeaderItem.Id);
            if (thForCt is not null && thForCt.ChargeTypeId != Guid.Empty)
                chargeTypeId = thForCt.ChargeTypeId;
        }

        M_ChargeType? chargeType = null;
        if (chargeTypeId is Guid cid && cid != Guid.Empty)
            chargeType = await dbCtx.ChargeType.AsNoTracking().FirstOrDefaultAsync(x => x.Id == cid);

        var demDetStoKind = ClassifyDemDetStoCharge(chargeType?.Code);
        if (demDetStoKind is not null)
        {
            if (!TryComputeBillableDaysDemDetSto(demDetStoKind.Value, out var computed, out var computeError))
            {
                Snackbar.Add(computeError, MudBlazor.Severity.Warning);
                return;
            }

            _billableDays = computed;
        }
        else if (!_billableDays.HasValue || _billableDays.Value < 0)
        {
            Snackbar.Add("Vui lòng nhập Billable days hợp lệ (hoặc chọn loại phí DEM/DET/STO để tự tính).", MudBlazor.Severity.Warning);
            return;
        }

        var amount = await TinhTienAsync(_tariffHeaderItem.Id, _billableDays.Value);
        if (!amount.HasValue)
        {
            Snackbar.Add("Không tìm thấy dòng TariffTier phù hợp với Billable days.", MudBlazor.Severity.Warning);
            return;
        }

        _amount = (decimal?)amount.Value;
    }

    private enum DemDetStoKind { Dem, Det, Sto }

    private static DemDetStoKind? ClassifyDemDetStoCharge(string? code)
    {
        if (string.IsNullOrWhiteSpace(code))
            return null;
        var head = code.Trim();
        if (head.Length < 3)
            return null;
        head = head[..3];
        if (string.Equals(head, "DEM", StringComparison.OrdinalIgnoreCase))
            return DemDetStoKind.Dem;
        if (string.Equals(head, "DET", StringComparison.OrdinalIgnoreCase))
            return DemDetStoKind.Det;
        if (string.Equals(head, "STO", StringComparison.OrdinalIgnoreCase))
            return DemDetStoKind.Sto;
        return null;
    }

    /// <summary>
    /// DEM/DET/STO theo hướng dẫn: DEM = (lấy − dỡ) − free; DET = (trả rỗng − lấy) − free; STO = (ra − vào) − free. Số ngày = khoảng cách lịch, tối thiểu 0.
    /// </summary>
    private bool TryComputeBillableDaysDemDetSto(DemDetStoKind kind, out int billableDays, out string? error)
    {
        billableDays = 0;
        error = null;

        DateTime? start;
        DateTime? end;
        string needMsg;

        switch (kind)
        {
            case DemDetStoKind.Dem:
                start = _fullDischargeDate;
                end = _emptyPickupDate;
                needMsg = "DEM: nhập Ngày dỡ hàng và Ngày lấy rỗng (theo công thức: lấy − dỡ − free time).";
                break;
            case DemDetStoKind.Det:
                start = _emptyPickupDate;
                end = _emptyReturnDate;
                needMsg = "DET: nhập Ngày lấy rỗng và Ngày trả rỗng (theo công thức: trả rỗng − lấy − free time).";
                break;
            case DemDetStoKind.Sto:
                start = _storageInDate;
                end = _storageOutDate;
                needMsg = "STO: nhập Ngày vào kho và Ngày ra kho (theo công thức: ra − vào − free time).";
                break;
            default:
                error = "Không xác định loại DEM/DET/STO.";
                return false;
        }

        if (!start.HasValue || !end.HasValue)
        {
            error = needMsg;
            return false;
        }

        var spanDays = (end.Value.Date - start.Value.Date).Days;
        if (spanDays < 0)
        {
            error = "Ngày kết thúc phải sau hoặc bằng ngày bắt đầu.";
            return false;
        }

        var raw = spanDays - _freeDays;
        billableDays = raw < 0 ? 0 : raw;
        return true;
    }

    private async Task<double?> TinhTienAsync(Guid tariffHeaderId, int billableDays)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var tier = await db.TariffTier
            .AsNoTracking()
            .Where(x => x.TariffHeaderId == tariffHeaderId
                        && x.FromDay <= billableDays
                        && (!x.ToDay.HasValue || x.ToDay.Value >= billableDays))
            .OrderBy(x => x.FromDay)
            .ThenBy(x => x.SequenceNo)
            .FirstOrDefaultAsync();

        if (tier is null)
            return null;

        return Convert.ToDouble(tier.Rate);
    }

    private async Task SaveAsync()
    {
        if (_form is null)
            return;
        await _form.Validate();
        if (!_form.IsValid)
            return;

        if (_hblItem is null || _hblItem.Id == Guid.Empty
            || _containerItem is null || _containerItem.Id == Guid.Empty
            || _chargeTypeItem is null || _chargeTypeItem.Id == Guid.Empty
            || _customerItem is null || _customerItem.Id == Guid.Empty
            || _shippingLineItem is null || _shippingLineItem.Id == Guid.Empty
            || _depotItem is null || _depotItem.Id == Guid.Empty
            || _terminalItem is null || _terminalItem.Id == Guid.Empty)
        {
            Snackbar.Add(Localizer["Scc_Msg_SelectLinks"], MudBlazor.Severity.Warning);
            return;
        }

        if (string.IsNullOrWhiteSpace(_containerType))
        {
            Snackbar.Add(Localizer["Scc_Msg_ContainerTypeRequired"], MudBlazor.Severity.Warning);
            return;
        }

        var entity = Model ?? new M_ShipmentChargeContext { Id = Guid.Empty };
        entity.ShipmentId = _hblItem.Id;
        entity.ContainerId = _containerItem.Id;
        entity.ChargeTypeId = _chargeTypeItem.Id;
        entity.CustomerId = _customerItem.Id;
        entity.ShippingLineId = _shippingLineItem.Id;
        entity.DepotId = _depotItem.Id.ToString("D");
        entity.PortId = _terminalItem.Id.ToString("D");
        entity.ContainerTypeId = _containerType.Trim();
        entity.Direction = string.IsNullOrWhiteSpace(_direction) ? null : _direction.Trim();
        entity.CurrencyCode = string.IsNullOrWhiteSpace(_currencyCode) ? null : _currencyCode.Trim();
        entity.FreeDays = _freeDays;
        entity.BillableDays = _billableDays;
        entity.EmptyPickupDate = _emptyPickupDate;
        entity.FullDischargeDate = _fullDischargeDate;
        entity.FullDeliveryDate = _fullDeliveryDate;
        entity.EmptyReturnDate = _emptyReturnDate;
        entity.StorageInDate = _storageInDate;
        entity.StorageOutDate = _storageOutDate;
        entity.Remarks = string.IsNullOrWhiteSpace(_remarks) ? null : _remarks.Trim();
        entity.Amount = _amount ?? 0m;
        entity.tariffcode_id = _tariffHeaderItem is not null && _tariffHeaderItem.Id != Guid.Empty
            ? _tariffHeaderItem.Id
            : null;

        MudDialog.Close(DialogResult.Ok(new ShipmentChargeContextDialogResult { IsEdit = IsEdit, Entity = entity }));
    }

    private async Task<IEnumerable<LookupItem>> SearchHblAsync(string value)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var q = db.HBL.AsNoTracking();
        if (!string.IsNullOrWhiteSpace(value))
        {
            var v = value.Trim();
            q = q.Where(x =>
                (x.hbl != null && x.hbl.Contains(v)) ||
                (x.bkno != null && x.bkno.Contains(v)));
        }

        var list = await q.OrderBy(x => x.hbl).ThenBy(x => x.bkno).Take(ComboResultLimit).ToListAsync();
        var result = list.Select(x => new LookupItem { Id = x.hblID, Display = HblDisplay(x) }).ToList();
        if (_hblItem is not null && _hblItem.Id != Guid.Empty && !result.Exists(x => x.Id == _hblItem.Id))
            result.Insert(0, _hblItem);
        return result;
    }

    private async Task<IEnumerable<LookupItem>> SearchContainersAsync(string value)
    {
        if (_hblItem is null || _hblItem.Id == Guid.Empty)
            return Array.Empty<LookupItem>();

        var hblId = _hblItem.Id;
        await using var db = await DbFactory.CreateDbContextAsync();
        var q = db.Container.AsNoTracking().Where(x => x.hblid == hblId);
        if (!string.IsNullOrWhiteSpace(value))
        {
            var v = value.Trim();
            q = q.Where(x => x.CONTAINER_NO != null && x.CONTAINER_NO.Contains(v));
        }

        var list = await q.OrderBy(x => x.CONTAINER_NO).Take(ComboResultLimit).ToListAsync();
        var result = list.Select(x => new LookupItem { Id = x.CTN_ID, Display = ContainerDisplay(x) }).ToList();
        if (_containerItem is not null && _containerItem.Id != Guid.Empty && !result.Exists(x => x.Id == _containerItem.Id))
        {
            var keep = await db.Container.AsNoTracking()
                .FirstOrDefaultAsync(x => x.CTN_ID == _containerItem.Id && x.hblid == hblId);
            if (keep != null)
                result.Insert(0, new LookupItem { Id = keep.CTN_ID, Display = ContainerDisplay(keep) });
        }

        return result;
    }

