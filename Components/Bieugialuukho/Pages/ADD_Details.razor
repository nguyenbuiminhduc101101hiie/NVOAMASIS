
@using System.Globalization
@attribute [Authorize]
@inject GlobalServices gsv
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject AccountService asv
@inject SharedServices ssv
@inject BookingService bksv 
@inject LenhDieuXeServices ldxsv
@inject IJSRuntime JSRuntime
@inject SupportServices supsv
@inject IStringLocalizer<SharedResource> Localizer
@inject LocalChargesServices lcsv
@inject TKHQ_Services tkhqsv
@inject Bieugianangha_Services BGNHsv
@inject HistoryLogService HistoryLogService
@using System.Text.Json;

<style>
    .price-ui-title { font-weight: 800; color: #0f3557; }
    .price-ui-toolbar { background: #fff; border: 1px solid #e2e8f0; border-radius: 14px; padding: 10px 12px; margin: 8px 12px; }
    .price-ui-toolbar .mud-button-root { border-radius: 999px; text-transform: none; font-weight: 700; }
    .price-ui-grid { border-radius: 14px; border: 1px solid #e2e8f0 !important; overflow: hidden; }
    .price-ui-grid .mud-table-head th, .price-ui-grid .mud-table thead th { background: linear-gradient(180deg,#118ab2 0%,#0d6f91 100%) !important; color: #fff !important; font-weight: 800 !important; }
</style>



<MudText Class="pa-2 price-ui-title" Typo="Typo.h6">@Localizer["ChiTietBieuGiaLuuKho"]</MudText>
<MudStack Row Justify="Justify.FlexStart" Class="pa-4 price-ui-toolbar">
    <MudButton  HtmlTag="label"
                OnClick="Refresh"
                Size="Size.Small" Color="Color.Primary" Variant="   Variant.Filled"
                StartIcon="@Icons.Material.Filled.Refresh">
        @Localizer["reload"]
    </MudButton>

    <MudButton HtmlTag="label"
               @onclick="@(() => AddItem())"
               Size="Size.Small" Color="Color.Secondary" Variant="Variant.Filled"
               StartIcon="@Icons.Material.Filled.Add">
        New
    </MudButton>



</MudStack>



<MudDataGrid T="M_ChiTietBieuGiaLuuKho" Items="@Listdata.ToList()" Filterable="true" @ref="mudTable" Class="price-ui-grid"
            FilterMode="@DataGridFilterMode.ColumnFilterRow" Dense="true" Virtualize="true"
            FixedHeader="true" FixedFooter="true" HeaderClass="no-wrap" FooterClass="no-wrap"
            ReadOnly="false" CommittedItemChanges="@CommittedItem"
            ColumnResizeMode="@(_resizeColumn ? ResizeMode.Column : ResizeMode.Container)">

    <Columns>
        <HierarchyColumn T="M_ChiTietBieuGiaLuuKho" />
        <TemplateColumn CellClass="d-flex justify-end">
            <CellTemplate>
                <MudIconButton Icon="@Icons.Material.Outlined.Edit"
                               OnClick="@(() => {

                                 detail_BG = JsonSerializer.Deserialize<M_ChiTietBieuGiaLuuKho>(JsonSerializer.Serialize(context.Item));

                               context.Actions.StartEditingItemAsync();

                       })" />>
                <MudIconButton Icon="@Icons.Material.Outlined.Delete" OnClick="@(()=>DeleteItem(context.Item))" />
            </CellTemplate>
        </TemplateColumn>

        <PropertyColumn Property="x=>x.DienGiai" Title="@Localizer["Diengiai"]" Required="false" CellStyleFunc="_cellStyleFunc">
            <EditTemplate>
                <MudTextField @bind-Value="context.Item.DienGiai" Label="@Localizer["Diengiai"]" Class="custom-label" Lines="3"
                              InputType="InputType.Text" />
            </EditTemplate>
        </PropertyColumn>

        <PropertyColumn Property="x=>x.LoaiContainerHangHoa" Title="@Localizer["loaicont"]" Required="false" CellStyleFunc="_cellStyleFunc">
            <EditTemplate>

                <MudAutocomplete @bind-Value="context.Item.LoaiContainerHangHoa" Label="@Localizer["loaicont"]"
                                 class="custom-label" CoerceValue SearchFunc="SearchLoaiCont" />

            </EditTemplate>
        </PropertyColumn>

           <PropertyColumn Property="x=>x.DonViTinh" Title="@Localizer["Unit"]" Required="false" CellStyleFunc="_cellStyleFunc">
            <EditTemplate>

                <MudAutocomplete @bind-Value="context.Item.DonViTinh" Label="@Localizer["Unit"]"
                                 class="custom-label" CoerceValue SearchFunc="SearchUnit" />
            </EditTemplate>
        </PropertyColumn>

        <PropertyColumn Property="x=>x.GiaTien" Title="@Localizer["sotien"]" Required="false" Format="#,##0.##" Culture="@_en" CellStyleFunc="_cellStyleFunc">
            <EditTemplate>
                <MudNumericField @bind-Value="context.Item.GiaTien"
                                 Label="@Localizer["sotien"]" Format="#,##0.##" Culture="@_en" T="double?" HideSpinButtons="true"
                                 Class="text-right custom-label" />
            </EditTemplate>
        </PropertyColumn>

        <PropertyColumn Property="x=>x.TienTe" Title="@Localizer["Loaitiente"]" Required="false" CellStyleFunc="_cellStyleFunc">
            <EditTemplate>
                <MudSelect @bind-Value="context.Item.TienTe" Label="@Localizer["Loaitiente"]" Class="custom-label">

                    <MudSelectItem Value="@("VND")">VND</MudSelectItem>
                    <MudSelectItem Value="@("USD")">USD</MudSelectItem>
                </MudSelect>
            </EditTemplate>
        </PropertyColumn>

        <PropertyColumn Property="x=>x.GhiChuHangHoa" Title="@Localizer["ghichu"]" Required="false" CellStyleFunc="_cellStyleFunc">
            <EditTemplate>
                <MudTextField @bind-Value="context.Item.GhiChuHangHoa" Label="@Localizer["ghichu"]" Class="custom-label" Lines="3"
                              InputType="InputType.Text" />
            </EditTemplate>
        </PropertyColumn>


        <PropertyColumn Property="x=>x.UserUpdate" Title="@Localizer["UserUpdate"]" Required="false" CellStyleFunc="_cellStyleFunc">
            <EditTemplate>
                <MudTextField @bind-Value="context.Item.UserUpdate" Label="@Localizer["UserUpdate"]" Class="custom-label" Disabled="true"
                              InputType="InputType.Text" />
            </EditTemplate>
        </PropertyColumn>

         <PropertyColumn Property="x=>x.Dateupdate" Title="@Localizer["Dateupdate"]" Required="false" CellStyleFunc="_cellStyleFunc">
            <EditTemplate>
                <MudTextField @bind-Value="context.Item.Dateupdate" Label="@Localizer["Dateupdate"]" Class="custom-label" Disabled="true"
                              InputType="InputType.Text" />
            </EditTemplate>
        </PropertyColumn>
    </Columns>

</MudDataGrid>

@code {
    List<M_ChiTietBieuGiaLuuKho> Listdata = new List<M_ChiTietBieuGiaLuuKho>();
    [Parameter] public Models.M_BieuGiaLuuKho _BGLK_details { get; set; }
    MudDataGrid<M_ChiTietBieuGiaLuuKho> mudTable;
    AuthUser user;
    string mailtp, mailpp;
    string usr;
    private List<string> ListUser { get; set; } = new List<string>();
    string UserHanding;
    List<string> trangthais = new List<string>();
    private List<Models.TrangThai> M_Trangthais = new List<Models.TrangThai>();
    private string searchText_pol = "";
    private string searchText_pod = "";
    private List<PortModel> filteredPorts = new List<PortModel>();
    private List<PortModel> filteredPorts_pod = new List<PortModel>();
    private List<PortModel> Ports = new List<PortModel>();
    private bool _resizeColumn;
    M_ChiTietBieuGiaLuuKho detail;
    private List<PortModel> List_pod = new List<PortModel>();
    private List<PortModel> List_pol = new List<PortModel>();
    private List<M_Customer> filteredCarr = new List<M_Customer>();
    M_ChiTietBieuGiaLuuKho detail_BG;
    private List<M_Customer> Cuss_Carr = new List<M_Customer>();
    public CultureInfo _de = CultureInfo.GetCultureInfo("de-DE");
    public CultureInfo _en = CultureInfo.GetCultureInfo("en-US");

    private List<M_ChiTietBieuGiaLuuKho> M_CTBGLKs = new List<M_ChiTietBieuGiaLuuKho>();

    protected async override Task OnInitializedAsync()
    {
        M_CTBGLKs = await BGNHsv.GetList_CTBGLK_All();

        usr = asv.GetAuth().Result.User.Identity!.Name!;
        await Refresh();
    }



    bool _loading = false;
    async Task Refresh()
    {
        try
        {
            detail = null!;
            _loading = true;
            Listdata.Clear();

            await Task.Delay(500);
            if (!await ssv.CheckPermission(usr, "Add", "ChiTietBieuGiaLuuKho"))
            {
                CallSnackBar(Localizer["NoPermission_View"], MudBlazor.Severity.Warning);
                return;
            }
            Listdata = await BGNHsv.GetListChitietBgLuuKho(_BGLK_details.BieuGiaLuuKhoID);
            StateHasChanged();
        }
        catch(Exception ex)
        {
            CallSnackBar(string.Format(Localizer["SomethingWentWrong"], ex.Message), MudBlazor.Severity.Warning);
        }
        finally
        {
            _loading = false;
        }

    }

    void CallSnackBar(string message, MudBlazor.Severity severity)
    {

        Snackbar.Configuration.SnackbarVariant = Variant.Filled;
        Snackbar.Configuration.MaxDisplayedSnackbars = 3;
        Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopRight;
        Snackbar.Add(message, severity);
    }
    void RowClicked(DataGridRowClickEventArgs<M_ChiTietBieuGiaLuuKho> args)
    {
        detail = args.Item;
    }
    private int selectedRowNumber = -1;
    private string SelectedRowClassFunc(M_ChiTietBieuGiaLuuKho m, int rowNumber)
    {
        if (selectedRowNumber == rowNumber)
        {
            selectedRowNumber = -1;
            return string.Empty;
        }
        else if (mudTable.SelectedItem != null && mudTable.SelectedItem.Equals(m))
        {
            selectedRowNumber = rowNumber;
            return "selected";
        }
        else
        {
            return string.Empty;
        }
    }

    async Task CommittedItem(M_ChiTietBieuGiaLuuKho item)
    {
        var UserName = asv.GetAuth().Result.User.Identity!.Name!;
        item.Approve = true;
        item.Continued = true;
        item.Dateupdate = DateTime.Now.ToString("dd/MMM/yyyy");
        item.UserUpdate = UserName;
        var rs = item.ChiTietBieuGiaLuuKhoID != Guid.Empty ? await BGNHsv.UpdateChitietBGLuuKho_Detail(item, detail_BG) : await BGNHsv.CreateChitietBGLuuKho_Detail(item);
        CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);

        await Refresh();
    }
    int? index_no;
    async Task AddItem()
    {

        if (!await ssv.CheckPermission(usr, "Add", "ChiTietBieuGiaLuuKho"))
        {
            CallSnackBar(Localizer["NoPermission_Add"], MudBlazor.Severity.Warning);
            return;
        }
        var item = new M_ChiTietBieuGiaLuuKho
        {

        };
        item.Approve = true;
        item.Continued =true ;
        item.BieuGiaLuuKhoID = _BGLK_details.BieuGiaLuuKhoID;
        item.UserUpdate = asv.GetAuth().Result.User.Identity!.Name!;
        item.Dateupdate = DateTime.Now.ToString("dd/MMM/yyyy");
        Listdata.Add(item);
        await mudTable.SetEditingItemAsync(Listdata.LastOrDefault()!);
    }

    async Task DeleteItem(M_ChiTietBieuGiaLuuKho item)
    {
        if (!await ssv.CheckPermission(usr, "Delete", "ChiTietBieuGiaLuuKho"))
        {
            CallSnackBar(Localizer["NoPermission_Delete"], MudBlazor.Severity.Warning);
            return;
        }
        var resultMess = await DialogService.ShowMessageBox(
                Localizer["Warning"],
                Localizer["DeleteConfirmBody"],
                yesText: Localizer["delete"], cancelText: Localizer["cancel"]);

        if (resultMess.HasValue)
        {
            var rs = await BGNHsv.DeleteChitietBGLuuKhoL_Detail(item);
            string No = await BGNHsv.GetBGNo_ByID(item.BieuGiaLuuKhoID);
            await HistoryLogService.LogAsync(usr, "Delete Chi Tiet Bieu Gia Luu Kho", "ChiTietBieuGiaLuuKho", item.ChiTietBieuGiaLuuKhoID, No, new { OldData = item });
            CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
            await Refresh();
        }

    }
    DialogOptions options = new DialogOptions 
    {
        ClassBackground = "class-dialog-custom",
        FullWidth = true,
        MaxWidth = MaxWidth.Medium,
        CloseOnEscapeKey = false,
        DisableBackdropClick = true
    };
    string search;

 
    private Func<M_ChiTietBieuGiaLuuKho, string> _cellStyleFunc => x =>
      {


          return "color: #000000";
      };


    private async Task<IEnumerable<string?>> SearchUnit(string? text)
    {
        try
        {
            var items = M_CTBGLKs.Select(x => x.DonViTinh).Distinct();
            if (string.IsNullOrEmpty(text))
            {
                return items;
            }
            // MBL.Porname = mst_Consignee;
            return items.Where(x => x != null && x.Equals(text));
        }
        catch (Exception)
        {
            throw;
        }
    }

     private async Task<IEnumerable<string?>> SearchLoaiCont(string? text)
    {
        try
        {
            var items = M_CTBGLKs.Select(x => x.LoaiContainerHangHoa).Distinct();
            if (string.IsNullOrEmpty(text))
            {
                return items;
            }
            // MBL.Porname = mst_Consignee;
            return items.Where(x => x != null && x.Equals(text));
        }
        catch (Exception)
        {
            throw;
        }
    }
  
}
