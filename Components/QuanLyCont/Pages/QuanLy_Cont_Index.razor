@page "/quan-ly-cont"
@using System.Text.Json
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.EntityFrameworkCore
@using MudBlazor
@using NVOAMASIS.Data
@using NVOAMASIS.Models
@using NVOAMASIS.Services
@using NVOAMASIS.Components.Shipment.Pages
@attribute [Authorize]
@inject SharedServices ssv
@inject AccountService asv
@inject IDbContextFactory<AppDbContext> DbFactory
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject ShipmentService shipsv
@inject IStringLocalizer<SharedResource> Localizer

<PageTitle>@Localizer["QuanLyCont_Title"]</PageTitle>

<div class="product-price-page">
    <PpScreenHeader Title="@Localizer["QuanLyCont_Title"]" Subtitle="@Localizer["QuanLyCont_Subtitle"]">
        <Toolbar>
            <MudStack Row="true" Spacing="1" Class="flex-wrap">
                <MudButton Variant="Variant.Filled" Color="Color.Secondary" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Add" OnClick="OpenNewDialog" Disabled="_busy">
                    Thêm
                </MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Info" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Edit" OnClick="OpenEditDialog"
                           Disabled="_selected is null || _busy">
                    Sửa
                </MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Error" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Delete" OnClick="DeleteSelectedAsync"
                           Disabled="_selected is null || _busy">
                    Xóa
                </MudButton>
                <MudDivider Vertical="true" FlexItem="true" Class="mx-1" />
                <MudButton Variant="Variant.Filled"
                           Size="Size.Small"
                           Class="@GetDcButtonClass(true)"
                           StartIcon="@Icons.Material.Filled.Receipt"
                           OnClick="OpenDebitDialog"
                           Disabled="_selected is null || _busy">
                    Debit
                </MudButton>
                <MudButton Variant="Variant.Filled"
                           Size="Size.Small"
                           Class="@GetDcButtonClass(false)"
                           StartIcon="@Icons.Material.Filled.CreditScore"
                           OnClick="OpenCreditDialog"
                           Disabled="_selected is null || _busy">
                    Credit
                </MudButton>
                <MudDivider Vertical="true" FlexItem="true" Class="mx-1" />
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Refresh" OnClick="LoadListAsync" Disabled="_busy">
                    Tải lại
                </MudButton>
                <MudDivider Vertical="true" FlexItem="true" Class="mx-1" />
                <MudSelect T="string" @bind-Value="_importFileType"
                           Label="Loại file"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Dense="true"
                           Style="min-width: 210px;">
                    @foreach (var opt in EorImportDefinitions.FileTypeOptions)
                    {
                        <MudSelectItem T="string" Value="@opt.Key">@opt.Label</MudSelectItem>
                    }
                </MudSelect>
                <MudTooltip Text="@($"Import {CurrentImportTypeLabel} — tạo container + phí Credit từ file")">
                    <MudButton HtmlTag="label"
                               Variant="Variant.Filled"
                               Color="Color.Warning"
                               Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Upload"
                               Disabled="@(_busy || _importing)"
                               Class="btn-compact"
                               Style="min-width: 36px; height: 30px; padding: 0 6px;">
                        <InputFile OnChange="OnImportInputChanged" accept=".xlsx,.xls" style="display:none" />
                    </MudButton>
                </MudTooltip>
            </MudStack>
        </Toolbar>
    </PpScreenHeader>

    <MudPaper Class="product-price-card pa-3" Elevation="0">
        <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center" Class="mb-2 flex-wrap">
            <MudTextField @bind-Value="_searchText"
                          Label="Tìm container, HBL, tàu, principal..."
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Clearable="true"
                          Immediate="true"
                          Style="max-width: 420px;" />
        </MudStack>

        <MudDataGrid T="QuanLy_Cont"
                     Items="VisibleItems"
                     Dense="true"
                     Striped="true"
                     Bordered="true"
                     Hover="true"
                     RowClick="OnRowClick"
                     RowClassFunc="RowClassFunc"
                     Height="calc(100vh - 180px)"
                     FixedHeader="true"
                     Loading="_busy"
                     ColumnResizeMode="ResizeMode.Column">
            <Columns>
                <HierarchyColumn T="QuanLy_Cont" />
                <PropertyColumn Property="x => x.Container" Title="@Localizer["QuanLyCont_Container"]" />
                <PropertyColumn Property="x => x.Principal" Title="@Localizer["QuanLyCont_Principal"]" />
                <PropertyColumn Property="x => x.ChuCont" Title="@Localizer["QuanLyCont_Owner"]" />
                <PropertyColumn Property="x => x.ContSize" Title="@Localizer["Size"]" />
                <PropertyColumn Property="x => x.ContType" Title="@Localizer["Type"]" />
                <PropertyColumn Property="x => x.HBL_No" Title="@Localizer["HBL No"]" />
                <PropertyColumn Property="x => x.POL" Title="@Localizer["POL"]" />
                <PropertyColumn Property="x => x.POD" Title="@Localizer["POD"]" />
                <PropertyColumn Property="x => x.Vessel" Title="@Localizer["Vessel"]" />
                <PropertyColumn Property="x => x.Voy" Title="@Localizer["Voy"]" />
                <PropertyColumn Property="x => x.ETA" Title="ETA" Format="dd/MM/yyyy" />
                <PropertyColumn Property="x => x.GateOut" Title="@Localizer["QuanLyCont_GateOut"]" Format="dd/MM/yyyy" />
                <PropertyColumn Property="x => x.EmptyDate" Title="@Localizer["QuanLyCont_EmptyReturn"]" Format="dd/MM/yyyy" />
                <PropertyColumn Property="x => x.Yard" Title="@Localizer["QuanLyCont_Yard"]" />
                <PropertyColumn Property="x => x.Collect" Title="@Localizer["Collect"]" Format="N2" />
                <PropertyColumn Property="x => x.Status" Title="@Localizer["Status"]" />
            </Columns>
            <ChildRowContent>
                <QuanLy_DebitCredit_ChildPanel QuanLyCont="context.Item"
                                               Title="@string.Format(Localizer["DebitCreditFor"], context.Item.Container)" />
            </ChildRowContent>
            <PagerContent>
                <MudDataGridPager T="QuanLy_Cont" PageSizeOptions="new int[] { 10, 25, 50, 100 }" />
            </PagerContent>
        </MudDataGrid>
    </MudPaper>
</div>

@code {
    private const string PermissionMenuName = "QuanLyCont";

    private bool _busy;
    private bool _importing;
    private List<QuanLy_Cont> _items = new();
    private QuanLy_Cont? _selected;
    private string usr = string.Empty;
    private string _searchText = string.Empty;
    private string _importFileType = "EOR_ASR";
    private List<M_Customer> _importCustomers = new();
    private List<ChargeModel> _importCharges = new();

    private string CurrentImportTypeLabel =>
        EorImportDefinitions.FileTypeOptions.FirstOrDefault(x => x.Key == _importFileType).Label ?? _importFileType;

    private IEnumerable<QuanLy_Cont> VisibleItems
    {
        get
        {
            if (string.IsNullOrWhiteSpace(_searchText))
                return _items;

            var t = _searchText.Trim();
            return _items.Where(x =>
                ContainsIc(x.Container, t) ||
                ContainsIc(x.Principal, t) ||
                ContainsIc(x.ChuCont, t) ||
                ContainsIc(x.HBL_No, t) ||
                ContainsIc(x.Vessel, t) ||
                ContainsIc(x.Voy, t) ||
                ContainsIc(x.POL, t) ||
                ContainsIc(x.POD, t) ||
                ContainsIc(x.Status, t) ||
                ContainsIc(x.Yard, t));
        }
    }

    private static bool ContainsIc(string? s, string needle) =>
        !string.IsNullOrEmpty(s) && s.Contains(needle, StringComparison.OrdinalIgnoreCase);

    protected override async Task OnInitializedAsync()
    {
        var auth = await asv.GetAuth();
        usr = auth.User.Identity?.Name ?? string.Empty;
        await LoadListAsync();
        await LoadImportLookupsAsync();
    }

    private async Task LoadImportLookupsAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _importCharges = await db.Charge.AsNoTracking()
            .Where(x => x.CHARGE_CODE == null || !EF.Functions.Like(x.CHARGE_CODE, "%COMMISSION%"))
            .OrderByDescending(x => x.UPDATETIME)
            .ToListAsync();
        _importCustomers = await db.Customer.AsNoTracking().OrderBy(x => x.shortname).ToListAsync();
    }

    private void CallSnackBar(string message, MudBlazor.Severity severity)
    {
        Snackbar.Configuration.SnackbarVariant = Variant.Filled;
        Snackbar.Configuration.MaxDisplayedSnackbars = 3;
        Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopRight;
        Snackbar.Add(message, severity);
    }

    private async Task LoadListAsync()
    {
        if (!await ssv.CheckPermission(usr, "View", PermissionMenuName))
        {
            CallSnackBar(Localizer["NoPermission_View"], MudBlazor.Severity.Warning);
            _items = new List<QuanLy_Cont>();
            _selected = null;
            return;
        }

        try
        {
            _busy = true;
            await using var db = await DbFactory.CreateDbContextAsync();
            _items = await db.QuanLy_Cont
                .AsNoTracking()
                .OrderByDescending(x => x.ETA)
                .ThenBy(x => x.Container)
                .ToListAsync();
            _selected = null;
        }
        catch (Exception ex)
        {
            CallSnackBar(string.Format(Localizer["LoadDataFailed"], ex.Message), MudBlazor.Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private void OnRowClick(DataGridRowClickEventArgs<QuanLy_Cont> args) =>
        _selected = CloneRow(args.Item);

    private string GetDcButtonClass(bool isDebit) =>
        _selected is null
            ? string.Empty
            : isDebit ? "dc-btn-debit-active" : "dc-btn-credit-active";

    private async Task OpenDebitDialog()
    {
        if (_selected is null)
            return;

        await DialogService.ShowAsync<QuanLy_DebitCredit_Dialog>(
            $"Debit — {_selected.Container}",
            new DialogParameters
            {
                ["QuanLyCont"] = _selected,
                ["IsDebit"] = true,
                ["Title"] = $"Debit — Container {_selected.Container}"
            },
            new DialogOptions { MaxWidth = MaxWidth.ExtraLarge, FullWidth = true, CloseOnEscapeKey = true });
    }

    private async Task OpenCreditDialog()
    {
        if (_selected is null)
            return;

        await DialogService.ShowAsync<QuanLy_DebitCredit_Dialog>(
            $"Credit — {_selected.Container}",
            new DialogParameters
            {
                ["QuanLyCont"] = _selected,
                ["IsDebit"] = false,
                ["Title"] = $"Credit — Container {_selected.Container}"
            },
            new DialogOptions { MaxWidth = MaxWidth.ExtraLarge, FullWidth = true, CloseOnEscapeKey = true });
    }

    private static QuanLy_Cont CloneRow(QuanLy_Cont row) => new()
    {
        Id = row.Id,
        Principal = row.Principal,
        ChuCont = row.ChuCont,
        Container = row.Container,
        ContSize = row.ContSize,
        ContType = row.ContType,
        HBL_No = row.HBL_No,
        POL = row.POL,
        POD = row.POD,
        Vessel = row.Vessel,
        Voy = row.Voy,
        Remark = row.Remark,
        ETA = row.ETA,
        GateOut = row.GateOut,
        EmptyDate = row.EmptyDate,
        Yard = row.Yard,
        Estimate = row.Estimate,
        Collect = row.Collect,
        Status = row.Status
    };

    private string RowClassFunc(QuanLy_Cont row, int _) =>
        _selected != null && _selected.Id == row.Id ? "quanlycont-selected-row" : string.Empty;

    private async Task OpenNewDialog()
    {
        if (!await ssv.CheckPermission(usr, "Add", PermissionMenuName))
        {
            CallSnackBar(Localizer["NoPermission_Add"], MudBlazor.Severity.Warning);
            return;
        }

        var dlg = DialogService.Show<QuanLy_Cont_EditDialog>(
            "Thêm container",
            new DialogParameters
            {
                ["Model"] = new QuanLy_Cont { Id = Guid.Empty, Container = string.Empty },
                ["IsEdit"] = false
            },
            new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true, CloseOnEscapeKey = true });

        var rs = await dlg.Result;
        if (rs.Canceled || rs.Data is not QuanLy_Cont_EditDialog.QuanLyContDialogResult data)
            return;

        await SaveAsync(data);
    }

    private async Task OpenEditDialog()
    {
        if (_selected is null)
            return;

        if (!await ssv.CheckPermission(usr, "Edit", PermissionMenuName))
        {
            CallSnackBar(Localizer["NoPermission_Edit"], MudBlazor.Severity.Warning);
            return;
        }

        var dlg = DialogService.Show<QuanLy_Cont_EditDialog>(
            "Sửa container",
            new DialogParameters
            {
                ["Model"] = _selected,
                ["IsEdit"] = true
            },
            new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true, CloseOnEscapeKey = true });

        var rs = await dlg.Result;
        if (rs.Canceled || rs.Data is not QuanLy_Cont_EditDialog.QuanLyContDialogResult data)
            return;

        await SaveAsync(data);
    }

    private async Task SaveAsync(QuanLy_Cont_EditDialog.QuanLyContDialogResult data)
    {
        try
        {
            _busy = true;
            await using var db = await DbFactory.CreateDbContextAsync();

            if (!data.IsEdit)
            {
                db.QuanLy_Cont.Add(new QuanLy_Cont
                {
                    Id = Guid.NewGuid(),
                    Principal = data.Principal,
                    ChuCont = data.ChuCont,
                    Container = data.Container,
                    ContSize = data.ContSize,
                    ContType = data.ContType,
                    HBL_No = data.HBL_No,
                    POL = data.POL,
                    POD = data.POD,
                    Vessel = data.Vessel,
                    Voy = data.Voy,
                    Remark = data.Remark,
                    ETA = data.ETA,
                    GateOut = data.GateOut,
                    EmptyDate = data.EmptyDate,
                    Yard = data.Yard,
                    Estimate = data.Estimate,
                    Collect = data.Collect,
                    Status = data.Status
                });
            }
            else
            {
                var entity = await db.QuanLy_Cont.FirstOrDefaultAsync(x => x.Id == data.Id);
                if (entity is null)
                {
                    CallSnackBar(Localizer["RecordNotFound"], MudBlazor.Severity.Warning);
                    return;
                }

                entity.Principal = data.Principal;
                entity.ChuCont = data.ChuCont;
                entity.Container = data.Container;
                entity.ContSize = data.ContSize;
                entity.ContType = data.ContType;
                entity.HBL_No = data.HBL_No;
                entity.POL = data.POL;
                entity.POD = data.POD;
                entity.Vessel = data.Vessel;
                entity.Voy = data.Voy;
                entity.Remark = data.Remark;
                entity.ETA = data.ETA;
                entity.GateOut = data.GateOut;
                entity.EmptyDate = data.EmptyDate;
                entity.Yard = data.Yard;
                entity.Estimate = data.Estimate;
                entity.Collect = data.Collect;
                entity.Status = data.Status;
            }

            await db.SaveChangesAsync();
            _selected = null;
            await LoadListAsync();
            CallSnackBar(Localizer["SaveSuccess"], MudBlazor.Severity.Success);
        }
        catch (Exception ex)
        {
            CallSnackBar(string.Format(Localizer["SaveFailed"], ex.Message), MudBlazor.Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task DeleteSelectedAsync()
    {
        if (_selected is null)
            return;

        if (!await ssv.CheckPermission(usr, "Delete", PermissionMenuName))
        {
            CallSnackBar(Localizer["NoPermission_Delete"], MudBlazor.Severity.Warning);
            return;
        }

        var confirm = await DialogService.ShowMessageBox(
            "Xác nhận",
            $"Xóa container {_selected.Container}?",
            yesText: "Xóa",
            cancelText: "Hủy");

        if (confirm != true)
            return;

        try
        {
            _busy = true;
            await using var db = await DbFactory.CreateDbContextAsync();
            var entity = await db.QuanLy_Cont.FirstOrDefaultAsync(x => x.Id == _selected.Id);
            if (entity is null)
            {
                CallSnackBar(Localizer["RecordNotFound"], MudBlazor.Severity.Warning);
                return;
            }

            db.QuanLy_Cont.Remove(entity);
            await db.SaveChangesAsync();
            _selected = null;
            CallSnackBar(Localizer["DeleteSuccess"], MudBlazor.Severity.Success);
            await LoadListAsync();
        }
        catch (Exception ex)
        {
            CallSnackBar(string.Format(Localizer["DeleteFailed"], ex.Message), MudBlazor.Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task OnImportInputChanged(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file is null)
            return;

        if (!EorImportDefinitions.Maps.TryGetValue(_importFileType, out var map))
        {
            CallSnackBar("Loại file chưa được hỗ trợ.", MudBlazor.Severity.Warning);
            return;
        }

        await ImportContainersFromExcelAsync(file, map);
    }

    /// <summary>Import file EOR/HDS: tự tạo (hoặc khớp) container theo số container trong file, rồi thêm phí Credit cho từng container.</summary>
    private async Task ImportContainersFromExcelAsync(IBrowserFile file, EorColumnMap map)
    {
        if (!await ssv.CheckPermission(usr, "Add", PermissionMenuName))
        {
            CallSnackBar(Localizer["NoPermission_Add"], MudBlazor.Severity.Warning);
            return;
        }

        var isXlsx = file.Name.EndsWith(".xlsx", StringComparison.OrdinalIgnoreCase);
        var isXls = !isXlsx && file.Name.EndsWith(".xls", StringComparison.OrdinalIgnoreCase);
        if (!isXlsx && !isXls)
        {
            CallSnackBar("Chỉ nhận file Excel .xlsx hoặc .xls.", MudBlazor.Severity.Warning);
            return;
        }

        if (isXls && !map.RequiresXls)
        {
            CallSnackBar("Loại file này chỉ hỗ trợ .xlsx. Vui lòng lưu lại file dưới dạng .xlsx trước khi import.", MudBlazor.Severity.Warning);
            return;
        }

        // Phải đọc file vào memory TRƯỚC khi mở dialog / StateHasChanged,
        // nếu không InputFile bị dispose → lỗi _blazorFilesById.
        using var memoryStream = new MemoryStream();
        try
        {
            await using (var uploadStream = file.OpenReadStream(50 * 1024 * 1024))
            {
                await uploadStream.CopyToAsync(memoryStream);
            }
            memoryStream.Position = 0;
        }
        catch (Exception ex)
        {
            CallSnackBar("Không đọc được file Excel: " + ex.Message, MudBlazor.Severity.Error);
            return;
        }

        try
        {
            _importing = true;

            EorParseResult parseResult;
            try
            {
                parseResult = EorExcelParser.Parse(memoryStream, map);
            }
            catch (InvalidOperationException ex)
            {
                CallSnackBar(ex.Message, MudBlazor.Severity.Warning);
                return;
            }

            var groups = parseResult.Rows
                .Where(r => !string.IsNullOrWhiteSpace(r.ContainerNo))
                .GroupBy(r => r.ContainerNo!.Trim(), StringComparer.OrdinalIgnoreCase)
                .ToList();

            if (groups.Count == 0)
            {
                CallSnackBar("Không tìm thấy số container nào trong file.", MudBlazor.Severity.Warning);
                return;
            }

            var containerKeys = groups.Select(g => g.Key.ToUpperInvariant()).ToHashSet();
            HashSet<string> existingContainers;
            await using (var previewDb = await DbFactory.CreateDbContextAsync())
            {
                existingContainers = (await previewDb.QuanLy_Cont.AsNoTracking()
                        .Where(x => containerKeys.Contains(x.Container.Trim().ToUpper()))
                        .Select(x => x.Container.Trim().ToUpper())
                        .ToListAsync())
                    .ToHashSet();
            }

            var previewDialog = await DialogService.ShowAsync<EorImportPreviewDialog>(
                "Xem trước dữ liệu import",
                new DialogParameters
                {
                    ["Rows"] = parseResult.Rows,
                    ["SkippedRowCount"] = parseResult.SkippedRowCount,
                    ["FileTypeLabel"] = CurrentImportTypeLabel,
                    ["ExistingContainers"] = existingContainers
                },
                new DialogOptions { MaxWidth = MaxWidth.ExtraLarge, FullWidth = true, CloseOnEscapeKey = true });
            var previewResult = await previewDialog.Result;
            if (previewResult is null || previewResult.Canceled)
            {
                CallSnackBar("Đã hủy import.", MudBlazor.Severity.Info);
                return;
            }

            var customerDialog = await DialogService.ShowAsync<CreDitTab_QuanLy_ImportCustomerDialog>(
                "Chọn Customer",
                new DialogParameters { ["Customers"] = _importCustomers },
                new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true });
            var customerResult = await customerDialog.Result;
            if (customerResult is null || customerResult.Canceled || customerResult.Data is not Guid customerId || customerId == Guid.Empty)
            {
                CallSnackBar("Đã hủy import — chưa chọn Customer.", MudBlazor.Severity.Info);
                return;
            }

            var laborCharge = _importCharges.FirstOrDefault(x =>
                string.Equals(x.CHARGE?.Trim(), "LABOR COST", StringComparison.OrdinalIgnoreCase));
            var materialCharge = _importCharges.FirstOrDefault(x =>
                string.Equals(x.CHARGE?.Trim(), "MATERIAL COST", StringComparison.OrdinalIgnoreCase));
            if (laborCharge is null || materialCharge is null)
            {
                CallSnackBar("Không tìm thấy Charge \"LABOR COST\" hoặc \"MATERIAL COST\".", MudBlazor.Severity.Error);
                return;
            }

            var usdRate = await Vcbsv.Getexchange_cur("USD");
            var createdContainers = 0;
            var matchedContainers = 0;
            var feeCount = 0;

            await using var db = await DbFactory.CreateDbContextAsync();
            var hblCandidates = await db.HBL.AsNoTracking()
                .Where(x => x.hbl != null && x.hbl != string.Empty)
                .ToListAsync();

            foreach (var group in groups)
            {
                var containerNo = group.Key;
                var entity = await db.QuanLy_Cont.FirstOrDefaultAsync(x => x.Container.Trim().ToUpper() == containerNo.ToUpper());
                var firstSizeText = group.Select(r => r.Size).FirstOrDefault(s => !string.IsNullOrWhiteSpace(s));

                if (entity is null)
                {
                    var (contSize, contType) = ParseContainerSizeText(firstSizeText);
                    entity = new QuanLy_Cont
                    {
                        Id = Guid.NewGuid(),
                        Container = containerNo,
                        ContSize = contSize,
                        ContType = contType
                    };
                    db.QuanLy_Cont.Add(entity);
                    await db.SaveChangesAsync();
                    createdContainers++;
                }
                else
                {
                    matchedContainers++;
                    if (entity.ContSize is null)
                    {
                        var (contSize, contType) = ParseContainerSizeText(firstSizeText);
                        if (contSize.HasValue)
                        {
                            entity.ContSize = contSize;
                            entity.ContType ??= contType;
                            await db.SaveChangesAsync();
                        }
                    }
                }

                var hblId = Guid.Empty;
                if (!string.IsNullOrWhiteSpace(entity.HBL_No))
                {
                    var hbl = hblCandidates.FirstOrDefault(x =>
                        string.Equals(x.hbl?.Trim(), entity.HBL_No!.Trim(), StringComparison.OrdinalIgnoreCase));
                    hblId = hbl?.hblID ?? Guid.Empty;
                }

                foreach (var row in group)
                {
                    var baseCredit = new M_Credit
                    {
                        customerid = customerId,
                        hblid = hblId,
                        Quanly_contid = entity.Id,
                        tiente = row.Currency,
                        Date_Of_EST = row.DateOfEst,
                        Date_In_Yard = row.DateInYard,
                        Manufacturing_Date = row.ManufacturingDate,
                        ContainerNo = containerNo,
                        Size = row.Size,
                        IT = row.IT,
                        Com_Code = row.ComCode,
                        COMPONENTS_DETAILS = row.ComponentDetails,
                        LOC = row.Loc,
                        DM_Code = row.DamCode,
                        RP_Code = row.RepCode,
                        LHT = row.Lht,
                        WDT = row.Wdt,
                        R = row.R,
                        soluong = 1,
                        Hours = row.Hours,
                        Labor_Cost = row.LaborCost,
                        Material_Cost = row.MaterialCost,
                        Labor_Rate = row.LaborRate,
                        Billing = row.Billing,
                        Owner = row.Owner,
                        Location = row.Location,
                        EstNo = row.EstNo,
                        Grade = row.Grade,
                        DamageDetail = row.DamageDetail,
                        Remark = row.Remark,
                        type = "CONT",
                        thue = 0,
                        tigiacredit = usdRate,
                        tigiahoadondauvao = usdRate,
                        userupdate = usr,
                        dateupdate = DateTime.Now.ToString("dd/MM/yyyy HH:mm:ss")
                    };

                    if (row.LaborCost.HasValue && row.LaborCost != 0)
                    {
                        var laborFee = CloneCredit(baseCredit);
                        laborFee.itemid = laborCharge.CHARGE_ID;
                        laborFee.dongia = row.LaborCost;
                        laborFee.thanhtien = row.LaborCost;
                        laborFee.thanhtiensauthue = row.LaborCost;
                        var rs = await shipsv.CreateCreditMBL(laborFee);
                        if (rs.Flag) feeCount++;
                    }

                    if (row.MaterialCost.HasValue && row.MaterialCost != 0)
                    {
                        var materialFee = CloneCredit(baseCredit);
                        materialFee.itemid = materialCharge.CHARGE_ID;
                        materialFee.dongia = row.MaterialCost;
                        materialFee.thanhtien = row.MaterialCost;
                        materialFee.thanhtiensauthue = row.MaterialCost;
                        var rs = await shipsv.CreateCreditMBL(materialFee);
                        if (rs.Flag) feeCount++;
                    }
                }
            }

            await LoadListAsync();
            CallSnackBar(
                $"Import {CurrentImportTypeLabel}: tạo mới {createdContainers} container, khớp {matchedContainers} container có sẵn, thêm {feeCount} phí Credit." +
                (parseResult.SkippedRowCount > 0 ? $" Bỏ qua {parseResult.SkippedRowCount} dòng." : string.Empty),
                feeCount > 0 ? MudBlazor.Severity.Success : MudBlazor.Severity.Warning);
        }
        catch (Exception ex)
        {
            CallSnackBar("Import Excel lỗi: " + ex.Message, MudBlazor.Severity.Error);
        }
        finally
        {
            _importing = false;
        }
    }

    /// <summary>Tách "20DC"/"45G0"/"20'DC" thành (Size=20/45, Type="DC"/"G0").</summary>
    private static (int? Size, string? Type) ParseContainerSizeText(string? text)
    {
        if (string.IsNullOrWhiteSpace(text))
            return (null, null);

        var cleaned = text.Replace("'", "").Trim();
        var match = Regex.Match(cleaned, @"^(\d+)\s*(.*)$");
        if (!match.Success)
            return (null, null);

        var size = int.TryParse(match.Groups[1].Value, out var s) ? s : (int?)null;
        var type = match.Groups[2].Value.Trim();
        return (size, string.IsNullOrWhiteSpace(type) ? null : type);
    }

    private static M_Credit CloneCredit(M_Credit source) =>
        JsonSerializer.Deserialize<M_Credit>(JsonSerializer.Serialize(source))!;
}

