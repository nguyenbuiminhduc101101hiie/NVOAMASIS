@using System.Globalization
@inject ISnackbar Snackbar
@inject AccountService asv
@inject TrainScheduleServices trainsv
@inject IStringLocalizer<SharedResource> Localizer
@inject SharedServices ssv
@inject LocalChargesServices lcsv
@inject SupportServices supsv
@inject LenhDieuXeServices ldxsv
@inject TKHQ_Services tkhqsv
@inject GlobalServices gsv
@inject Bieugianangha_Services Bgnhsv
@inject CustomerService Cussv
@inject PhieuThu_Chi_Services Thuchisv
@inject ShipmentService shipmentsv
@inject IJSRuntime JSRuntime



<MudDialog>
    <DialogContent>
        <MudSpacer></MudSpacer>
        <MudContainer>

            <MudCard>
                <MudForm Model="@_Danhmuctaikhoan_Detail" @ref="@form">
                    <MudCardContent>
                        <MudGrid>

                            <MudGrid>

                                <MudItem xs="6">
                                    <MudTextField @bind-Value="_Danhmuctaikhoan_Detail.Taikhoan" Label="@Localizer["Taikhoan"]" class="custom-label" />
                                </MudItem>

                                <MudItem xs="6">
                                    <MudTextField @bind-Value="_Danhmuctaikhoan_Detail.Tentaikhoan" Label="@Localizer["Tentaikhoan"]" class="custom-label"  />
                                </MudItem>

                                <MudItem xs="12">
                                    <MudTextField @bind-Value="_Danhmuctaikhoan_Detail.Diengiai" Label="Diễn giải (mặc định dòng chứng từ)" class="custom-label" Lines="2" />
                                </MudItem>

                                <MudItem xs="6">
                                    <MudTextField @bind-Value="_Danhmuctaikhoan_Detail.Accountname"  Label="@Localizer["Accountname"]" class="custom-label" />
                                </MudItem>

                                <MudItem xs="6">
                                    <MudSelect @bind-Value="_Danhmuctaikhoan_Detail.Manguyente" Label="@Localizer["Loaitiente"]" class="custom-label">
                                        <MudSelectItem Value="@("USD")">USD</MudSelectItem>
                                        <MudSelectItem Value="@("VND")">VND</MudSelectItem>

                                    </MudSelect>
                                </MudItem>

                                <MudItem xs="6">
                                    <MudSelect T="string" @bind-Value="_Danhmuctaikhoan_Detail.AccountType" Label="AccountType" class="custom-label">
                                        <MudSelectItem Value="@("Asset")">Asset</MudSelectItem>
                                        <MudSelectItem Value="@("Liability")">Liability</MudSelectItem>
                                        <MudSelectItem Value="@("Equity")">Equity</MudSelectItem>
                                        <MudSelectItem Value="@("Revenue")">Revenue</MudSelectItem>
                                        <MudSelectItem Value="@("Expense")">Expense</MudSelectItem>
                                    </MudSelect>
                                </MudItem>

                                <MudItem xs="6">
                                    <MudCheckBox T="bool?" @bind-Value="_Danhmuctaikhoan_Detail.IsPosting" Label="IsPosting" />
                                </MudItem>

                                <MudItem xs="6">
                                    <MudCheckBox T="bool?" @bind-Value="_Danhmuctaikhoan_Detail.RequiresCustomer" Label="RequiresCustomer" />
                                </MudItem>

                                <MudItem xs="6">
                                    <MudCheckBox T="bool?" @bind-Value="_Danhmuctaikhoan_Detail.RequiresSupplier" Label="RequiresSupplier" />
                                </MudItem>

                                <MudItem xs="6">
                                    <MudCheckBox T="bool?" @bind-Value="_Danhmuctaikhoan_Detail.RequiresEmployee" Label="RequiresEmployee" />
                                </MudItem>

                                <MudItem xs="6">
                                    <MudCheckBox T="bool?" @bind-Value="_Danhmuctaikhoan_Detail.RequiresShipment" Label="RequiresShipment" />
                                </MudItem>

                                <MudItem xs="6">
                                    <MudCheckBox T="bool?" @bind-Value="_Danhmuctaikhoan_Detail.IsActive" Label="IsActive" />
                                </MudItem>


                            </MudGrid>
                        </MudGrid>
                    </MudCardContent>
                </MudForm>

            </MudCard>
        </MudContainer>
    </DialogContent>
    <DialogActions>

        <MudButton OnClick="@(async () => await Submit())">Save</MudButton>
        <MudButton OnClick="Cancel">Cancel</MudButton>

    </DialogActions>
</MudDialog>



@code {
    [CascadingParameter] MudDialogInstance? MudDialog { get; set; }
    [Parameter] public Models.DanhMucTaiKhoan _Danhmuctaikhoan_Detail { get; set; }

    [Parameter] public string Status { get; set; }
    MudForm form;
    List<string> trangthais = new List<string>();
    private List<Models.TrangThai> M_Trangthais = new List<Models.TrangThai>();
    public CultureInfo _en = CultureInfo.GetCultureInfo("en-US");
    private List<Terminal_> Terminals = new List<Terminal_>();
    private List<Terminal_> Terminals_Address = new List<Terminal_>();
    List<DanhMucTaiKhoan> Phieuchis = new List<DanhMucTaiKhoan>();
    string UserHanding;
    private List<string> ListUser { get; set; } = new List<string>();
    List<M_Customer> Customers = new List<M_Customer>();
    List<M_MBL> MBLs = new List<M_MBL>();
    protected async override Task OnInitializedAsync()
    {

        Customers =await Cussv.GetList();
   
        ListUser = await asv.GetList_User_handle() ?? new List<string>();
      
    }
   
  

    private async Task Submit()
    {
        if ((await ssv.CheckPermission(asv.GetAuth().Result.User.Identity.Name, "Edit", "Danhmuctaikhoan") || await ssv.CheckPermission(asv.GetAuth().Result.User.Identity.Name, "New", "Danhmuctaikhoan")))
        {

            await form.Validate();

            if (form.IsValid)
            {

                var UserName = asv.GetAuth().Result.User.Identity!.Name!;
                _Danhmuctaikhoan_Detail.Dateupdate = DateTime.Now.ToString("dd/MMM/yyyy");
                _Danhmuctaikhoan_Detail.Userupdate = UserName;
                _Danhmuctaikhoan_Detail.Approve = true;

                MudDialog!.Close(_Danhmuctaikhoan_Detail);

            }
        }

    }
    void Cancel() => MudDialog.Cancel();

    void CallSnackBar(string message, MudBlazor.Severity severity)
    {
        
        Snackbar.Configuration.SnackbarVariant = Variant.Filled;
        Snackbar.Configuration.MaxDisplayedSnackbars = 3;
        Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopRight;
        Snackbar.Add(message, severity);
    }

   
}
