@using NVOAMASIS.Models
@using NVOAMASIS.Services
@using Microsoft.Extensions.Localization
@using NVOAMASIS.Resources
@inject PricingRateService Service
@inject IStringLocalizer<SharedResource> Localizer

<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mb-3">@Localizer["PricingOceanFreight_DeleteByLaneHint"]</MudText>

        <MudSelect T="string" Label="@Localizer["PricingOceanFreight_Col_FileName"]" @bind-Value="_fileName" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3">
            @foreach (var name in FileNames)
            {
                <MudSelectItem Value="@name">@name</MudSelectItem>
            }
        </MudSelect>

        <MudSelect T="string" Label="@Localizer["PricingOceanFreight_Col_Lane"]" @bind-Value="_tradeLane" Variant="Variant.Outlined" Margin="Margin.Dense">
            @foreach (var lane in PricingRateLane.All)
            {
                <MudSelectItem Value="@lane.Code">@Localizer[lane.TitleKey]</MudSelectItem>
            }
        </MudSelect>

        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <MudAlert Severity="MudBlazor.Severity.Error" Class="mt-3" Dense="true">@_error</MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@Localizer["cancel"]</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete"
                   Disabled="@(_deleting || string.IsNullOrWhiteSpace(_fileName) || string.IsNullOrWhiteSpace(_tradeLane))"
                   OnClick="DeleteAsync">
            @Localizer["delete"]
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private MudDialogInstance MudDialog { get; set; } = default!;
    [Parameter, EditorRequired] public List<string> FileNames { get; set; } = new();

    private string? _fileName;
    private string? _tradeLane;
    private bool _deleting;
    private string? _error;

    private async Task DeleteAsync()
    {
        if (string.IsNullOrWhiteSpace(_fileName) || string.IsNullOrWhiteSpace(_tradeLane))
            return;

        _deleting = true;
        _error = null;
        try
        {
            var result = await Service.DeleteByFileAndLaneAsync(_fileName, _tradeLane);
            if (!result.Ok)
            {
                _error = result.Error;
                return;
            }

            MudDialog.Close(DialogResult.Ok(true));
        }
        finally
        {
            _deleting = false;
        }
    }

    private void Cancel() => MudDialog.Cancel();
}
