@using NVOAMASIS.Models
@using Microsoft.Extensions.Localization
@using NVOAMASIS.Resources
@inject IStringLocalizer<SharedResource> Localizer

<MudDialog>
    <DialogContent>
        <MudAlert Severity="MudBlazor.Severity.Info" Class="mb-3" Dense="true">
            @Localizer["PricingOceanFreight_PreviewWarning", FileName, Rows.Count]
        </MudAlert>

        <MudTabs>
            @foreach (var lane in PricingRateLane.All)
            {
                var laneRows = _rowsByLane.TryGetValue(lane.Code, out var list) ? list : new List<M_PricingRate>();
                <MudTabPanel Text="@($"{Localizer[lane.TitleKey]} ({laneRows.Count})")">
                    <MudDataGrid T="M_PricingRate" Items="@laneRows" Dense="true" Striped="true" Bordered="true"
                                 Virtualize="true" FixedHeader="true" Height="50vh">
                        <Columns>
                            <PropertyColumn Property="x => x.Carrier" Title="@Localizer["PricingOceanFreight_Col_Carrier"]" />
                            <PropertyColumn Property="x => x.Country" Title="@Localizer["PricingOceanFreight_Col_Country"]" />
                            <PropertyColumn Property="x => x.Pol" Title="POL" />
                            <PropertyColumn Property="x => x.Pod" Title="POD" />
                            <TemplateColumn Title="EFF"><CellTemplate>@context.Item.EffDate?.ToString("dd/MM/yyyy")</CellTemplate></TemplateColumn>
                            <TemplateColumn Title="VALID"><CellTemplate>@context.Item.ValidDate?.ToString("dd/MM/yyyy")</CellTemplate></TemplateColumn>
                            <PropertyColumn Property="x => x.OfRateCom20" Title="O/F+COM 20" Format="#,##0.##" />
                            <PropertyColumn Property="x => x.OfRateCom40" Title="O/F+COM 40" Format="#,##0.##" />
                            <PropertyColumn Property="x => x.OfRateCom40Hc" Title="O/F+COM 40HC" Format="#,##0.##" />
                            <PropertyColumn Property="x => x.TotalOf20" Title="TOTAL O/F 20" Format="#,##0.##" />
                            <PropertyColumn Property="x => x.TotalOf40" Title="TOTAL O/F 40" Format="#,##0.##" />
                            <PropertyColumn Property="x => x.TotalOf40Hc" Title="TOTAL O/F 40HC" Format="#,##0.##" />
                            <PropertyColumn Property="x => x.FreeTimeAtPod" Title="@Localizer["PricingOceanFreight_Col_FreeTime"]" />
                            <PropertyColumn Property="x => x.Remark" Title="@Localizer["PricingOceanFreight_Col_Remark"]" />
                        </Columns>
                    </MudDataGrid>
                </MudTabPanel>
            }
        </MudTabs>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@Localizer["cancel"]</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.CheckCircle" OnClick="Confirm">
            @Localizer["PricingOceanFreight_ConfirmImport"]
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private MudDialogInstance MudDialog { get; set; } = default!;
    [Parameter, EditorRequired] public List<M_PricingRate> Rows { get; set; } = new();
    [Parameter, EditorRequired] public string FileName { get; set; } = string.Empty;

    private Dictionary<string, List<M_PricingRate>> _rowsByLane = new();

    protected override void OnInitialized()
    {
        _rowsByLane = Rows.GroupBy(x => x.TradeLane).ToDictionary(g => g.Key, g => g.ToList());
    }

    private void Confirm() => MudDialog.Close(DialogResult.Ok(true));
    private void Cancel() => MudDialog.Cancel();
}
