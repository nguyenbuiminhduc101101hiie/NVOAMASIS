@using NVOAMASIS.Models
@using Microsoft.Extensions.Localization
@using NVOAMASIS.Resources
@inject IStringLocalizer<SharedResource> Localizer

<MudDialog>
    <DialogContent>
        <MudAlert Severity="MudBlazor.Severity.Info" Class="mb-3" Dense="true">
            @Localizer["PricingOceanFreight_PreviewWarning", FileName, Rows.Count]
        </MudAlert>

        <MudTabs>
            @foreach (var lane in PricingRateLane.All)
            {
                var laneRows = _rowsByLane.TryGetValue(lane.Code, out var list) ? list : new List<M_PricingRate>();
                <MudTabPanel Text="@($"{Localizer[lane.TitleKey]} ({laneRows.Count})")">
                    <MudDataGrid T="M_PricingRate" Items="@laneRows" Dense="true" Striped="true" Bordered="true"
                                 Virtualize="true" FixedHeader="true" Height="50vh">
                        <Columns>
                            <PropertyColumn Property="x => x.ExtraNote" Title="A: Note" />
                            <TemplateColumn Title="B: EFF"><CellTemplate>@context.Item.EffDate?.ToString("dd/MM/yyyy")</CellTemplate></TemplateColumn>
                            <TemplateColumn Title="C: VALID"><CellTemplate>@context.Item.ValidDate?.ToString("dd/MM/yyyy")</CellTemplate></TemplateColumn>
                            <PropertyColumn Property="x => x.Carrier" Title="@($"D: {Localizer["PricingOceanFreight_Col_Carrier"]}")" />
                            <PropertyColumn Property="x => x.Country" Title="@($"E: {Localizer["PricingOceanFreight_Col_Country"]}")" />
                            <PropertyColumn Property="x => x.Pol" Title="F: POL" />
                            <PropertyColumn Property="x => x.Pod" Title="G: POD" />
                            <PropertyColumn Property="x => x.OfRateCom20" Title="H: O/F+COM 20" Format="#,##0.##" />
                            <PropertyColumn Property="x => x.OfRateCom40" Title="I: O/F+COM 40" Format="#,##0.##" />
                            <PropertyColumn Property="x => x.OfRateCom40Hc" Title="J: O/F+COM 40HC" Format="#,##0.##" />
                            <PropertyColumn Property="x => x.CommissionHdl20" Title="K: Commission/HDL 20" Format="#,##0.##" />
                            <PropertyColumn Property="x => x.CommissionHdl40" Title="L: Commission/HDL 40" Format="#,##0.##" />
                            <PropertyColumn Property="x => x.CommissionHdl40Hc" Title="M: Commission/HDL 40HC" Format="#,##0.##" />
                            <PropertyColumn Property="x => x.Remark" Title="@($"N: {Localizer["PricingOceanFreight_Col_Remark"]}")" />
                            <PropertyColumn Property="x => x.FreeTimeAtPod" Title="@($"O: {Localizer["PricingOceanFreight_Col_FreeTime"]}")" />
                            <PropertyColumn Property="x => x.BasicOfNet20" Title="P: Basic O/F NET 20" Format="#,##0.##" />
                            <PropertyColumn Property="x => x.BasicOfNet40" Title="Q: Basic O/F NET 40" Format="#,##0.##" />
                            <PropertyColumn Property="x => x.BasicOfNet40Hc" Title="R: Basic O/F NET 40HC" Format="#,##0.##" />
                            <PropertyColumn Property="x => x.SurchargeFuelEnv20" Title="S: LSS/OBS/BAF/FAF/PCS 20" Format="#,##0.##" />
                            <PropertyColumn Property="x => x.SurchargeFuelEnv40" Title="T: LSS/OBS/BAF/FAF/PCS 40" Format="#,##0.##" />
                            <PropertyColumn Property="x => x.SurchargeFuelEnv40Hc" Title="U: LSS/OBS/BAF/FAF/PCS 40HC" Format="#,##0.##" />
                            <PropertyColumn Property="x => x.SurchargeMisc20" Title="V: ISO/Premium/WRP/PIS 20" Format="#,##0.##" />
                            <PropertyColumn Property="x => x.SurchargeMisc40" Title="W: ISO/Premium/WRP/PIS 40" Format="#,##0.##" />
                            <PropertyColumn Property="x => x.SurchargeMisc40Hc" Title="X: ISO/Premium/WRP/PIS 40HC" Format="#,##0.##" />
                            <PropertyColumn Property="x => x.SurchargeSecurityEnv20" Title="Y: ISPS/ECA/CRS/GSF 20" Format="#,##0.##" />
                            <PropertyColumn Property="x => x.SurchargeSecurityEnv40" Title="Z: ISPS/ECA/CRS/GSF 40" Format="#,##0.##" />
                            <PropertyColumn Property="x => x.SurchargeSecurityEnv40Hc" Title="AA: ISPS/ECA/CRS/GSF 40HC" Format="#,##0.##" />
                            <PropertyColumn Property="x => x.TotalOf20" Title="AB: TOTAL O/F 20" Format="#,##0.##" />
                            <PropertyColumn Property="x => x.TotalOf40" Title="AC: TOTAL O/F 40" Format="#,##0.##" />
                            <PropertyColumn Property="x => x.TotalOf40Hc" Title="AD: TOTAL O/F 40HC" Format="#,##0.##" />
                            <PropertyColumn Property="x => x.VatCom20" Title="AE: VAT COM 20" Format="#,##0.##" />
                            <PropertyColumn Property="x => x.VatCom40" Title="AF: VAT COM 40" Format="#,##0.##" />
                            <PropertyColumn Property="x => x.VatCom40Hc" Title="AG: VAT COM 40HC" Format="#,##0.##" />
                        </Columns>
                    </MudDataGrid>
                </MudTabPanel>
            }
        </MudTabs>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@Localizer["cancel"]</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.CheckCircle" OnClick="Confirm">
            @Localizer["PricingOceanFreight_ConfirmImport"]
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private MudDialogInstance MudDialog { get; set; } = default!;
    [Parameter, EditorRequired] public List<M_PricingRate> Rows { get; set; } = new();
    [Parameter, EditorRequired] public string FileName { get; set; } = string.Empty;

    private Dictionary<string, List<M_PricingRate>> _rowsByLane = new();

    protected override void OnInitialized()
    {
        _rowsByLane = Rows.GroupBy(x => x.TradeLane).ToDictionary(g => g.Key, g => g.ToList());
    }

    private void Confirm() => MudDialog.Close(DialogResult.Ok(true));
    private void Cancel() => MudDialog.Cancel();
}
