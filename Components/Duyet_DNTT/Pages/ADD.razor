    [Parameter] public double? sotiensauthue { get; set; }
    [Parameter] public string? HBL { get; set; }
    [Parameter] public string? BKNO { get; set; }
    [Parameter] public string? TYPE { get; set; }
    [Parameter] public string? CUR { get; set; }
    [Parameter] public double? TIGIA { get; set; }
    [Parameter] public string? STK { get; set; }
    List<string> currs = new List<string>();

    MudForm form;
    List<string> trangthais = new List<string>();
    private List<Models.TrangThai> M_Trangthais = new List<Models.TrangThai>();
    public CultureInfo _en = CultureInfo.GetCultureInfo("en-US");
    private List<Terminal_> Terminals = new List<Terminal_>();
