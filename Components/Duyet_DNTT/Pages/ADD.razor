    // List<M_DNTU> DNTUs_by_id = new List<M_DNTU>;
    // public M_DNTU DNTUs_by_id { get; set; }
    string? reportUrl;
    protected async override Task OnInitializedAsync()
    {
        await GenerateReportPreview(_DNTT_Detail.Id);
    }

    private async Task GenerateReportPreview(Guid id)
    {
        try
        {
            var report = new StiReport();
            var rpt = Path.Combine(_env.WebRootPath, "Reports", "PhieuDNTT.mrt");

            StiBlazorHelper.Initialize(JSRuntime);

            report.Load(rpt);
            report.Culture = "en-US";
            report.Dictionary.Variables["ID"].Value = id.ToString();

            var list_PT = await DNTUSV.GetListDNTT_id(id);

            foreach (var item_PT in list_PT)
            {
                report.Dictionary.Variables["sodntt"].Value = item_PT.So;
            }

            report.Render();

            using var ms = new MemoryStream();
            report.ExportDocument(StiExportFormat.Pdf, ms);
            var base64 = Convert.ToBase64String(ms.ToArray());
            reportUrl = $"data:application/pdf;base64,{base64}";
        }
        catch (Exception ex)
        {
            Console.WriteLine("Report generation failed: " + ex.Message);
        }
    }

    private async Task Submit()
    {
        if ((await ssv.CheckPermission(asv.GetAuth().Result.User.Identity.Name, "Edit", "DNTT") || await ssv.CheckPermission(asv.GetAuth().Result.User.Identity.Name, "New", "DNTT")))
        {

            await form.Validate();

            if (form.IsValid)
            {

                var UserName = asv.GetAuth().Result.User.Identity!.Name!;
                if (_DNTT_Detail.Approve == true)
                {
                    _DNTT_Detail.timeDuyet = DateTime.Now.ToString("dd/MMM/yyyy");
                }
                else
                {
                    _DNTT_Detail.timeDuyet ="";
                }


                //----update sotienhoanung , Conlai

                MudDialog!.Close(_DNTT_Detail);

            }
        }

    }
    void Cancel() => MudDialog.Cancel();

    void CallSnackBar(string message, MudBlazor.Severity severity)
    {
        Snackbar.Clear();
        Snackbar.Configuration.SnackbarVariant = Variant.Filled;
        Snackbar.Configuration.MaxDisplayedSnackbars = 3;
        Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopRight;
        Snackbar.Add(message, severity);
    }


    
}
