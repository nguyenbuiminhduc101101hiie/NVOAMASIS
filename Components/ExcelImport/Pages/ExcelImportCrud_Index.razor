@page "/ExcelImportCrud"
@attribute [Authorize]
@using System.Text.Json
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.Extensions.Localization
@using NVOAMASIS.Models
@using NVOAMASIS.Resources
@using NVOAMASIS.Services
@inject ExcelImportCrudService Service
@inject AccountService asv
@inject SharedServices ssv
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IStringLocalizer<SharedResource> Localizer

<PageTitle>@Localizer["Ym_Title"]</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="pa-2">
    <MudText Typo="Typo.h5" Class="mb-3">5.8.9 @Localizer["Ym_Title"]</MudText>

    <MudTabs @bind-ActivePanelIndex="_activeTab">
        <MudTabPanel Text="@Localizer["Ym_Tab_HDS"]">
            @RenderToolbar()
            <MudDataGrid T="M_StockGateOut_HDS_08042026" Items="@_hdsItems" Dense="true" Striped="true" Hover="true" Bordered="true" RowClick="OnHdsRowClick">
                <Columns>
                    <PropertyColumn Property="x => x.SoCont" Title="@Localizer["Ym_Col_SoCont"]" />
                    <PropertyColumn Property="x => x.TenTau" Title="@Localizer["Ym_Col_TenTau"]" />
                    <TemplateColumn Title="@Localizer["Ym_Col_NgayCapBen"]"><CellTemplate>@context.Item.NgayCapBen?.ToString("dd/MM/yyyy HH:mm")</CellTemplate></TemplateColumn>
                    <PropertyColumn Property="x => x.SoBooking" Title="@Localizer["Ym_Col_SoBooking"]" />
                    <PropertyColumn Property="x => x.SoBL" Title="@Localizer["Ym_Col_SoBL"]" />
                    <PropertyColumn Property="x => x.PhuongAn" Title="@Localizer["Ym_Col_PhuongAn"]" />
                    <PropertyColumn Property="x => x.TTHaiQuan" Title="@Localizer["Ym_Col_TTHaiQuan"]" />
                </Columns>
                <PagerContent><MudDataGridPager T="M_StockGateOut_HDS_08042026" /></PagerContent>
            </MudDataGrid>
        </MudTabPanel>

        <MudTabPanel Text="@Localizer["Ym_Tab_AG"]">
            @RenderToolbar()
            <MudDataGrid T="M_YardReport_AG_2026040307" Items="@_agItems" Dense="true" Striped="true" Hover="true" Bordered="true" RowClick="OnAgRowClick">
                <Columns>
                    <PropertyColumn Property="x => x.SourceSheet" Title="@Localizer["Ym_Col_SourceSheet"]" />
                    <PropertyColumn Property="x => x.CNTRNO" Title="@Localizer["Ym_Col_CNTRNO"]" />
                    <PropertyColumn Property="x => x.SZ" Title="@Localizer["Ym_Col_SZ"]" />
                    <PropertyColumn Property="x => x.TP" Title="@Localizer["Ym_Col_TP"]" />
                    <PropertyColumn Property="x => x.ST" Title="@Localizer["Ym_Col_ST"]" />
                    <PropertyColumn Property="x => x.Location" Title="@Localizer["Ym_Col_Location"]" />
                    <PropertyColumn Property="x => x.Customer" Title="@Localizer["Ym_Col_Customer"]" />
                </Columns>
                <PagerContent><MudDataGridPager T="M_YardReport_AG_2026040307" /></PagerContent>
            </MudDataGrid>
        </MudTabPanel>

        <MudTabPanel Text="@Localizer["Ym_Tab_VSS"]">
            @RenderToolbar()
            <MudDataGrid T="M_YardMovement_VSS_26040808" Items="@_vssItems" Dense="true" Striped="true" Hover="true" Bordered="true" RowClick="OnVssRowClick">
                <Columns>
                    <PropertyColumn Property="x => x.SourceSheet" Title="@Localizer["Ym_Col_SourceSheet"]" />
                    <PropertyColumn Property="x => x.SOCONT" Title="@Localizer["Ym_Col_SOCONT"]" />
                    <PropertyColumn Property="x => x.KICHCO" Title="@Localizer["Ym_Col_KICHCO"]" />
                    <PropertyColumn Property="x => x.TRANGTHAI" Title="@Localizer["Ym_Col_TRANGTHAI"]" />
                    <TemplateColumn Title="@Localizer["Ym_Col_EXEC_TS"]"><CellTemplate>@context.Item.EXEC_TS?.ToString("dd/MM/yyyy HH:mm")</CellTemplate></TemplateColumn>
                    <PropertyColumn Property="x => x.BOOK_NO" Title="@Localizer["Ym_Col_BOOK_NO"]" />
                    <PropertyColumn Property="x => x.GIAO" Title="@Localizer["Ym_Col_GIAO"]" />
                </Columns>
                <PagerContent><MudDataGridPager T="M_YardMovement_VSS_26040808" /></PagerContent>
            </MudDataGrid>
        </MudTabPanel>

        <MudTabPanel Text="@Localizer["Ym_Tab_AMS"]">
            @RenderToolbar()
            <MudDataGrid T="M_YardMovement_AMS_26040816" Items="@_amsItems" Dense="true" Striped="true" Hover="true" Bordered="true" RowClick="OnAmsRowClick">
                <Columns>
                    <PropertyColumn Property="x => x.SOCONT" Title="@Localizer["Ym_Col_SOCONT"]" />
                    <PropertyColumn Property="x => x.KICHCO" Title="@Localizer["Ym_Col_KICHCO"]" />
                    <PropertyColumn Property="x => x.TRANGTHAI" Title="@Localizer["Ym_Col_TRANGTHAI"]" />
                    <TemplateColumn Title="@Localizer["Ym_Col_EXEC_TS"]"><CellTemplate>@context.Item.EXEC_TS?.ToString("dd/MM/yyyy HH:mm")</CellTemplate></TemplateColumn>
                    <PropertyColumn Property="x => x.BOOK_NO" Title="@Localizer["Ym_Col_BOOK_NO"]" />
                    <PropertyColumn Property="x => x.GIAO" Title="@Localizer["Ym_Col_GIAO"]" />
                </Columns>
                <PagerContent><MudDataGridPager T="M_YardMovement_AMS_26040816" /></PagerContent>
            </MudDataGrid>
        </MudTabPanel>
    </MudTabs>
</MudContainer>

@code {
    private int _activeTab;
    private bool _loading;
    private const string PermissionMenuName = "YardMovement";
    private readonly JsonSerializerOptions _jsonOptions = new() { PropertyNameCaseInsensitive = true };
    private bool _canView;
    private bool _canAdd;
    private bool _canEdit;
    private bool _canDelete;

    private List<M_StockGateOut_HDS_08042026> _hdsItems = new();
    private List<M_YardReport_AG_2026040307> _agItems = new();
    private List<M_YardMovement_VSS_26040808> _vssItems = new();
    private List<M_YardMovement_AMS_26040816> _amsItems = new();

    private M_StockGateOut_HDS_08042026? _selectedHds;
    private M_YardReport_AG_2026040307? _selectedAg;
    private M_YardMovement_VSS_26040808? _selectedVss;
    private M_YardMovement_AMS_26040816? _selectedAms;

    protected override async Task OnInitializedAsync()
    {
        await LoadPermissionAsync();
        if (!_canView)
        {
            Snackbar.Add(Localizer["Ym_NoAccessView"], MudBlazor.Severity.Warning);
            return;
        }

        await RefreshCurrentTabAsync();
    }

    private RenderFragment RenderToolbar() => @<MudPaper Class="pa-2 mb-2 d-flex flex-wrap gap-2">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Refresh" OnClick="RefreshCurrentTabAsync" Disabled="_loading">@Localizer["reload"]</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.Add" OnClick="AddCurrentAsync" Disabled="_loading || !_canAdd">@Localizer["new"]</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Info" StartIcon="@Icons.Material.Filled.Edit" OnClick="EditCurrentAsync" Disabled="_loading || !_canEdit">@Localizer["edit"]</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete" OnClick="DeleteCurrentAsync" Disabled="_loading || !_canDelete">@Localizer["delete"]</MudButton>
        <MudButton HtmlTag="label" Variant="Variant.Filled" Color="Color.Tertiary" StartIcon="@Icons.Material.Filled.UploadFile" Disabled="_loading || !_canAdd">
            @Localizer["Ym_ImportExcel"]
            <InputFile OnChange="ImportCurrentAsync" accept=".xlsx,.xls" style="display:none" />
        </MudButton>
    </MudPaper>;

    private async Task RefreshCurrentTabAsync()
    {
        _loading = true;
        try
        {
            switch ((ExcelCrudTab)_activeTab)
            {
                case ExcelCrudTab.HDS:
                    _hdsItems = await Service.GetHdsAsync();
                    break;
                case ExcelCrudTab.AG:
                    _agItems = await Service.GetAgAsync();
                    break;
                case ExcelCrudTab.VSS:
                    _vssItems = await Service.GetVssAsync();
                    break;
                case ExcelCrudTab.AMS:
                    _amsItems = await Service.GetAmsAsync();
                    break;
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(Localizer["Ym_LoadError", ex.Message], MudBlazor.Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task ImportCurrentAsync(InputFileChangeEventArgs e)
    {
        if (!_canAdd)
        {
            Snackbar.Add(Localizer["Ym_NoAccessAdd"], MudBlazor.Severity.Warning);
            return;
        }

        if (e.FileCount == 0)
            return;

        _loading = true;
        try
        {
            await using var stream = e.File.OpenReadStream(50 * 1024 * 1024);
            await using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            ms.Position = 0;

            var result = await Service.ImportAsync((ExcelCrudTab)_activeTab, ms);
            if (!string.IsNullOrWhiteSpace(result.ErrorMessage))
            {
                Snackbar.Add(Localizer["Ym_ImportError", result.ErrorMessage], MudBlazor.Severity.Error);
                return;
            }

            Snackbar.Add(Localizer["Ym_ImportSuccess", result.Inserted], MudBlazor.Severity.Success);
            await RefreshCurrentTabAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(Localizer["Ym_ImportError", ex.Message], MudBlazor.Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task AddCurrentAsync()
    {
        if (!_canAdd)
        {
            Snackbar.Add(Localizer["Ym_NoAccessAdd"], MudBlazor.Severity.Warning);
            return;
        }

        switch ((ExcelCrudTab)_activeTab)
        {
            case ExcelCrudTab.HDS:
                await OpenDialogAndSaveAsync(new M_StockGateOut_HDS_08042026 { Id = Guid.NewGuid(), CreatedAt = DateTime.UtcNow });
                break;
            case ExcelCrudTab.AG:
                await OpenDialogAndSaveAsync(new M_YardReport_AG_2026040307 { Id = Guid.NewGuid(), SourceSheet = "Manual", CreatedAt = DateTime.UtcNow });
                break;
            case ExcelCrudTab.VSS:
                await OpenDialogAndSaveAsync(new M_YardMovement_VSS_26040808 { Id = Guid.NewGuid(), SourceSheet = "Manual", CreatedAt = DateTime.UtcNow });
                break;
            case ExcelCrudTab.AMS:
                await OpenDialogAndSaveAsync(new M_YardMovement_AMS_26040816 { Id = Guid.NewGuid(), CreatedAt = DateTime.UtcNow });
                break;
        }
    }

    private async Task EditCurrentAsync()
    {
        if (!_canEdit)
        {
            Snackbar.Add(Localizer["Ym_NoAccessEdit"], MudBlazor.Severity.Warning);
            return;
        }

        switch ((ExcelCrudTab)_activeTab)
        {
            case ExcelCrudTab.HDS when _selectedHds != null:
                await OpenDialogAndSaveAsync(Clone(_selectedHds));
                break;
            case ExcelCrudTab.AG when _selectedAg != null:
                await OpenDialogAndSaveAsync(Clone(_selectedAg));
                break;
            case ExcelCrudTab.VSS when _selectedVss != null:
                await OpenDialogAndSaveAsync(Clone(_selectedVss));
                break;
            case ExcelCrudTab.AMS when _selectedAms != null:
                await OpenDialogAndSaveAsync(Clone(_selectedAms));
                break;
            default:
                Snackbar.Add(Localizer["Ym_SelectOneRowToEdit"], MudBlazor.Severity.Warning);
                break;
        }
    }

    private async Task DeleteCurrentAsync()
    {
        if (!_canDelete)
        {
            Snackbar.Add(Localizer["Ym_NoAccessDelete"], MudBlazor.Severity.Warning);
            return;
        }

        var confirm = await DialogService.ShowMessageBox(Localizer["Ym_Warning"], Localizer["Ym_DeleteConfirm"], yesText: Localizer["delete"].Value, cancelText: Localizer["cancel"].Value);
        if (confirm != true)
            return;

        (bool Ok, string? Error) result = (false, Localizer["Ym_NoRowSelected"].Value);

        switch ((ExcelCrudTab)_activeTab)
        {
            case ExcelCrudTab.HDS when _selectedHds != null:
                result = await Service.DeleteAsync<M_StockGateOut_HDS_08042026>(_selectedHds.Id);
                break;
            case ExcelCrudTab.AG when _selectedAg != null:
                result = await Service.DeleteAsync<M_YardReport_AG_2026040307>(_selectedAg.Id);
                break;
            case ExcelCrudTab.VSS when _selectedVss != null:
                result = await Service.DeleteAsync<M_YardMovement_VSS_26040808>(_selectedVss.Id);
                break;
            case ExcelCrudTab.AMS when _selectedAms != null:
                result = await Service.DeleteAsync<M_YardMovement_AMS_26040816>(_selectedAms.Id);
                break;
        }

        if (!result.Ok)
        {
            Snackbar.Add(result.Error ?? Localizer["Ym_DeleteFailed"].Value, MudBlazor.Severity.Error);
            return;
        }

        Snackbar.Add(Localizer["Ym_Deleted"], MudBlazor.Severity.Success);
        await RefreshCurrentTabAsync();
    }

    private async Task OpenDialogAndSaveAsync<T>(T model) where T : class, IExcelImportEntity
    {
        var dialog = DialogService.Show<ExcelImport_RowDialog>(Localizer["Ym_EditDialogTitle"], new DialogParameters { ["Model"] = model }, new DialogOptions { MaxWidth = MaxWidth.ExtraLarge, FullWidth = true, CloseOnEscapeKey = true });
        var result = await dialog.Result;
        if (result.Canceled || result.Data is not T data)
            return;

        var saveResult = await Service.UpsertAsync(data);
        if (!saveResult.Ok)
        {
            Snackbar.Add(saveResult.Error ?? Localizer["Ym_SaveFailed"].Value, MudBlazor.Severity.Error);
            return;
        }

        Snackbar.Add(Localizer["Ym_Saved"], MudBlazor.Severity.Success);
        await RefreshCurrentTabAsync();
    }

    private T Clone<T>(T source)
    {
        var json = JsonSerializer.Serialize(source, _jsonOptions);
        return JsonSerializer.Deserialize<T>(json, _jsonOptions)!;
    }

    private void OnHdsRowClick(DataGridRowClickEventArgs<M_StockGateOut_HDS_08042026> args) => _selectedHds = args.Item;
    private void OnAgRowClick(DataGridRowClickEventArgs<M_YardReport_AG_2026040307> args) => _selectedAg = args.Item;
    private void OnVssRowClick(DataGridRowClickEventArgs<M_YardMovement_VSS_26040808> args) => _selectedVss = args.Item;
    private void OnAmsRowClick(DataGridRowClickEventArgs<M_YardMovement_AMS_26040816> args) => _selectedAms = args.Item;

    private async Task LoadPermissionAsync()
    {
        var authState = await asv.GetAuth();
        var username = authState.User?.Identity?.Name;
        if (string.IsNullOrWhiteSpace(username))
            return;

        _canView = await ssv.CheckPermission(username, "View", PermissionMenuName);
        _canAdd = await ssv.CheckPermission(username, "Add", PermissionMenuName);
        _canEdit = await ssv.CheckPermission(username, "Edit", PermissionMenuName);
        _canDelete = await ssv.CheckPermission(username, "Delete", PermissionMenuName);
    }
}
