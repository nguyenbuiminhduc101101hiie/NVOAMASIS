@using Microsoft.EntityFrameworkCore
@using MudBlazor
@using NVOAMASIS.Data
@using NVOAMASIS.Models
@inject IDbContextFactory<AppDbContext> DbFactory
@inject AccountService asv
@inject GlobalServices gsv
@inject NotificationService _notificationService
@inject ISnackbar Snackbar

<style>
    .fb-notify-section {
        border: 1px solid rgba(17, 138, 178, .18);
        border-radius: 12px;
        background: #f0f9ff;
        padding: 14px 16px;
        margin-top: 8px;
    }

    .fb-notify-title {
        display: flex;
        align-items: center;
        gap: 8px;
        font-weight: 800;
        font-size: 13px;
        text-transform: uppercase;
        letter-spacing: .4px;
        color: #0f6f91;
        margin-bottom: 10px;
    }

    .fb-notify-row {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        align-items: flex-end;
    }

    .fb-notify-user {
        flex: 1 1 200px;
        min-width: 180px;
    }

    .fb-notify-email {
        flex: 2 1 240px;
        min-width: 220px;
    }

    .fb-add-btn {
        min-width: 44px !important;
        height: 40px;
        border-radius: 8px !important;
        font-weight: 800 !important;
    }

    .fb-send-btn {
        height: 40px;
        border-radius: 8px !important;
        font-weight: 700 !important;
        white-space: nowrap;
        flex: 0 0 auto;
    }
</style>

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form">
            <MudGrid Spacing="2">
                <MudItem xs="12" sm="6" md="4">
                    <MudAutocomplete T="Booking"
                                     Value="_booking"
                                     ValueChanged="OnBookingChangedAsync"
                                     ToStringFunc="@(b => b == null ? null : b.BookingNo)"
                                     Label="Booking No"
                                     Required="true"
                                     RequiredError="Vui lòng chọn Booking No"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     SearchFunc="SearchBookingAsync"
                                     CoerceText="true"
                                     ResetValueOnEmptyText="true"
                                     Clearable="true" />
                </MudItem>
                <MudItem xs="12" sm="6" md="4">
                    <MudDatePicker @bind-Date="_ngay" Label="Ngày" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" />
                </MudItem>
                <MudItem xs="12" sm="6" md="4">
                    <MudAutocomplete T="string"
                                     Value="_sale"
                                     ValueChanged="OnSaleChangedAsync"
                                     Label="Sale"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     SearchFunc="SearchSaleAsync"
                                     CoerceText="true"
                                     ResetValueOnEmptyText="true"
                                     Clearable="true" />
                </MudItem>
                <MudItem xs="12" sm="6" md="4">
                    <MudTextField @bind-Value="_line" Label="Line" Variant="Variant.Outlined" Margin="Margin.Dense" MaxLength="100" />
                </MudItem>
                <MudItem xs="12" sm="6" md="4">
                    <MudAutocomplete T="M_Customer"
                                     Value="_shipper"
                                     ValueChanged="OnShipperChangedAsync"
                                     ToStringFunc="@(c => c == null ? null : GetCustomerDisplay(c))"
                                     Label="Shipper"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     SearchFunc="SearchCustomerAsync"
                                     CoerceText="true"
                                     ResetValueOnEmptyText="true"
                                     Clearable="true" />
                </MudItem>
                <MudItem xs="12" sm="6" md="4">
                    <MudTextField @bind-Value="_volume" Label="Volume" Variant="Variant.Outlined" Margin="Margin.Dense" MaxLength="100" />
                </MudItem>
                <MudItem xs="12" sm="6" md="4">
                    <MudTextField @bind-Value="_polPod" Label="POL/POD" Variant="Variant.Outlined" Margin="Margin.Dense" MaxLength="200" />
                </MudItem>
                <MudItem xs="12" sm="6" md="4">
                    <MudDatePicker @bind-Date="_etd" Label="ETD" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" />
                </MudItem>
                <MudItem xs="12" sm="6" md="4">
                    <MudTextField @bind-Value="_freeTime" Label="Free Time" Variant="Variant.Outlined" Margin="Margin.Dense" MaxLength="100" />
                </MudItem>
                <MudItem xs="12" sm="6" md="4">
                    <MudSelect T="string" @bind-Value="_ppCc" Label="PP/CC" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true">
                        <MudSelectItem T="string" Value="@("PP")">PP</MudSelectItem>
                        <MudSelectItem T="string" Value="@("CC")">CC</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6" md="4">
                    <MudNumericField @bind-Value="_buyRate" Label="Buy Rate" Variant="Variant.Outlined" Margin="Margin.Dense" Format="N2" />
                </MudItem>
                <MudItem xs="12" sm="6" md="4">
                    <MudTextField @bind-Value="_acc" Label="Acc" Variant="Variant.Outlined" Margin="Margin.Dense" MaxLength="100" />
                </MudItem>
                <MudItem xs="12" sm="6" md="4">
                    <MudTextField @bind-Value="_typeBill" Label="Type Bill" Variant="Variant.Outlined" Margin="Margin.Dense" MaxLength="500" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="_description" Label="Description" Variant="Variant.Outlined" Margin="Margin.Dense" Lines="3" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="_remark" Label="Remark" Variant="Variant.Outlined" Margin="Margin.Dense" Lines="3" />
                </MudItem>

                <MudItem xs="12">
                    <div class="fb-notify-section">
                        <div class="fb-notify-title">
                            <MudIcon Icon="@Icons.Material.Filled.NotificationsActive" Size="Size.Small" />
                            <span>Assign & Notify</span>
                        </div>
                        @if (!IsEdit)
                        {
                            <MudAlert Severity="MudBlazor.Severity.Info" Dense="true" Class="mb-3">
                                Vui lòng lưu Form Booking trước, sau đó mở lại để gửi email / thông báo.
                            </MudAlert>
                        }
                        <div class="fb-notify-row">
                            <div class="fb-notify-user">
                                <MudAutocomplete T="string"
                                                 @bind-Value="_userHanding"
                                                 Label="User"
                                                 Variant="Variant.Outlined"
                                                 Margin="Margin.Dense"
                                                 SearchFunc="SearchUser"
                                                 Immediate="true"
                                                 CoerceText="true"
                                                 Clearable="true"
                                                 MaxItems="100" />
                            </div>
                            <MudButton Class="fb-add-btn" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" OnClick="AddUserHandle">>>></MudButton>
                            <div class="fb-notify-email">
                                <MudTextField @bind-Value="_userHandle"
                                              Variant="Variant.Outlined"
                                              Margin="Margin.Dense"
                                              HelperTextOnFocus
                                              HelperText="từ 2 mail trở lên vui lòng ngăn cách bằng dấu ','"
                                              Clearable="true"
                                              Label="Email nhận" />
                            </div>
                            <MudButton Class="fb-send-btn"
                                       Variant="Variant.Filled"
                                       Color="Color.Tertiary"
                                       Size="Size.Small"
                                       Disabled="!IsEdit || _processingUpload"
                                       OnClick="SendMailNotifyAsync"
                                       StartIcon="@Icons.Material.Filled.Email">
                                @if (_processingUpload)
                                {
                                    <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                                    <MudText Class="ms-2">Processing</MudText>
                                }
                                else
                                {
                                    <MudText>Gửi Email</MudText>
                                }
                            </MudButton>
                            <MudButton Class="fb-send-btn"
                                       Variant="Variant.Filled"
                                       Color="Color.Tertiary"
                                       Size="Size.Small"
                                       Disabled="!IsEdit || _processingUpload_message"
                                       OnClick="SendMessageAsync"
                                       StartIcon="@Icons.Material.Filled.Message">
                                @if (_processingUpload_message)
                                {
                                    <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                                    <MudText Class="ms-2">Processing</MudText>
                                }
                                else
                                {
                                    <MudText>Thông báo</MudText>
                                }
                            </MudButton>
                        </div>
                    </div>
                </MudItem>
            </MudGrid>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="Cancel">Hủy</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync">Lưu</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private MudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public M_FormBooking? Model { get; set; }
    [Parameter] public bool IsEdit { get; set; }

    public sealed class FormBookingDialogResult
    {
        public Guid Id { get; init; }
        public DateTime? Ngay { get; init; }
        public string? Sale { get; init; }
        public string? Line { get; init; }
        public Guid? Shipper { get; init; }
        public string? Volume { get; init; }
        public string? POL_POD { get; init; }
        public DateTime? ETD { get; init; }
        public string? FreeTime { get; init; }
        public string? PP_CC { get; init; }
        public string? Description { get; init; }
        public double? Buy_Rate { get; init; }
        public string? Remark { get; init; }
        public string? Acc { get; init; }
        public string? Type_Bill { get; init; }
        public Guid? BookingId { get; init; }
        public bool IsEdit { get; init; }
    }

    private MudForm? _form;
    private DateTime? _ngay;
    private string? _sale;
    private string? _line;
    private M_Customer? _shipper;
    private Booking? _booking;
    private string? _volume;
    private string? _polPod;
    private DateTime? _etd;
    private string? _freeTime;
    private string? _ppCc;
    private double? _buyRate;
    private string? _acc;
    private string? _typeBill;
    private string? _description;
    private string? _remark;

    private List<string> ListUser = new();
    private string? _userHanding;
    private string? _userHandle;
    private bool _processingUpload;
    private bool _processingUpload_message;

    protected override async Task OnInitializedAsync()
    {
        ListUser = await asv.GetList_User_handle() ?? new List<string>();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (Model is null)
            return;

        _ngay = Model.Ngay;
        _sale = Model.Sale;
        _line = Model.Line;
        _volume = Model.Volume;
        _polPod = Model.POL_POD;
        _etd = Model.ETD;
        _freeTime = Model.FreeTime;
        _ppCc = Model.PP_CC;
        _buyRate = Model.Buy_Rate;
        _acc = Model.Acc;
        _typeBill = Model.Type_Bill;
        _description = Model.Description;
        _remark = Model.Remark;

        await using var db = await DbFactory.CreateDbContextAsync();

        _shipper = Model.Shipper.HasValue
            ? await db.Customer.AsNoTracking().FirstOrDefaultAsync(x => x.Customer_ID == Model.Shipper.Value)
            : null;

        _booking = Model.BookingId.HasValue
            ? await db.CONTAINEROUTBOUNDNOTIFY_sale.AsNoTracking().FirstOrDefaultAsync(x => x.ContainerOutBoundNotifyId == Model.BookingId.Value)
            : null;
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task SaveAsync()
    {
        if (_form is null)
            return;

        await _form.Validate();
        if (!_form.IsValid)
            return;

        if (_booking is null)
            return;

        MudDialog.Close(DialogResult.Ok(new FormBookingDialogResult
        {
            Id = Model?.id ?? Guid.Empty,
            Ngay = _ngay,
            Sale = TrimOrNull(_sale),
            Line = TrimOrNull(_line),
            Shipper = _shipper?.Customer_ID,
            Volume = TrimOrNull(_volume),
            POL_POD = TrimOrNull(_polPod),
            ETD = _etd,
            FreeTime = TrimOrNull(_freeTime),
            PP_CC = TrimOrNull(_ppCc),
            Description = TrimOrNull(_description),
            Buy_Rate = _buyRate,
            Remark = TrimOrNull(_remark),
            Acc = TrimOrNull(_acc),
            Type_Bill = TrimOrNull(_typeBill),
            BookingId = _booking?.ContainerOutBoundNotifyId,
            IsEdit = IsEdit
        }));
    }

    private static string? TrimOrNull(string? value) =>
        string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    private Task OnShipperChangedAsync(M_Customer? value)
    {
        _shipper = value;
        return Task.CompletedTask;
    }

    private Task OnSaleChangedAsync(string? value)
    {
        _sale = value;
        return Task.CompletedTask;
    }

    private async Task OnBookingChangedAsync(Booking? value)
    {
        _booking = value;
        if (value is null)
            return;

        _line = TrimOrNull(value.Vessel);
        _sale = TrimOrNull(value.SaleName);
        _polPod = $"{value.hano_POL} - {value.hano_POD}";
        _volume = TrimOrNull(value.hanoFCL_Quality);
        _etd = value.ETD;

        if (value.CONSIGNEEID.HasValue)
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            _shipper = await db.Customer.AsNoTracking()
                .FirstOrDefaultAsync(x => x.Customer_ID == value.CONSIGNEEID.Value);
        }
        else
        {
            _shipper = null;
        }
    }

    private static string GetCustomerDisplay(M_Customer c) =>
        !string.IsNullOrWhiteSpace(c.COMPANY) ? c.COMPANY! :
        !string.IsNullOrWhiteSpace(c.BIZName) ? c.BIZName! :
        !string.IsNullOrWhiteSpace(c.EnglishName) ? c.EnglishName! :
        c.MaDT ?? string.Empty;

    private async Task<IEnumerable<M_Customer>> SearchCustomerAsync(string value)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var query = db.Customer.AsNoTracking().AsQueryable();

        if (!string.IsNullOrWhiteSpace(value))
        {
            var k = value.Trim();
            query = query.Where(x =>
                (x.COMPANY != null && x.COMPANY.Contains(k)) ||
                (x.BIZName != null && x.BIZName.Contains(k)) ||
                (x.EnglishName != null && x.EnglishName.Contains(k)) ||
                (x.MaDT != null && x.MaDT.Contains(k)));
        }

        return await query.OrderBy(x => x.COMPANY).Take(50).ToListAsync();
    }

    private async Task<IEnumerable<string>> SearchSaleAsync(string value)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var users = await db.UserList.AsNoTracking()
            .Select(x => x.Name)
            .ToListAsync();

        IEnumerable<string> query = users.Where(x => !string.IsNullOrWhiteSpace(x))!;
        if (!string.IsNullOrWhiteSpace(value))
        {
            var k = value.Trim();
            query = query.Where(x => x!.Contains(k, StringComparison.OrdinalIgnoreCase));
        }

        return query
            .Select(x => x!.Trim())
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(x => x, StringComparer.OrdinalIgnoreCase)
            .Take(50);
    }

    private async Task<IEnumerable<Booking>> SearchBookingAsync(string value)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var query = db.CONTAINEROUTBOUNDNOTIFY_sale.AsNoTracking().AsQueryable();

        if (!string.IsNullOrWhiteSpace(value))
        {
            var k = value.Trim();
            query = query.Where(x => x.BookingNo != null && x.BookingNo.Contains(k));
        }

        return await query.OrderByDescending(x => x.ETD).Take(50).ToListAsync();
    }

    private void CallSnackBar(string message, MudBlazor.Severity severity)
    {
        Snackbar.Configuration.SnackbarVariant = Variant.Filled;
        Snackbar.Configuration.MaxDisplayedSnackbars = 3;
        Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopRight;
        Snackbar.Add(message, severity);
    }

    private Task<IEnumerable<string>> SearchUser(string value)
    {
        if (string.IsNullOrEmpty(value))
            return Task.FromResult<IEnumerable<string>>(ListUser);

        return Task.FromResult(ListUser.Where(x => x.Contains(value, StringComparison.InvariantCultureIgnoreCase)));
    }

    private void AddUserHandle()
    {
        if (string.IsNullOrWhiteSpace(_userHanding))
            return;

        _userHandle = string.IsNullOrWhiteSpace(_userHandle)
            ? _userHanding
            : _userHandle + "," + _userHanding;
    }

    private string BuildNotifyContent() =>
        $"Form Booking No: {_booking?.BookingNo} - Sale: {_sale} - Line: {_line} - POL/POD: {_polPod}";

    private string BuildEmailBody()
    {
        const string th = "border:1px solid #333;padding:6px 8px;background:#f0f9ff;font-weight:bold;text-align:center;";
        const string td = "border:1px solid #333;padding:6px 8px;";
        const string tdCenter = td + "text-align:center;";

        var shipperName = _shipper is null ? string.Empty : GetCustomerDisplay(_shipper);

        return $@"
<div style='font-family:Arial,sans-serif;font-size:13px;color:#222;'>
    <p style='text-align:center;font-weight:bold;font-style:italic;text-decoration:underline;font-size:16px;'>FORM BOOKING INFORMATION</p>
    <p style='text-align:center;'><u><b>Ngày :</b></u> {_ngay:dd/MM/yyyy}</p>
    <p style='text-align:center;'><u><b>Sale :</b></u> {_sale}</p>
    <table style='border-collapse:collapse;width:100%;margin-top:8px;'>
        <tr>
            <th style='{th}'>LINE</th>
            <th style='{th}'>SHIPPER</th>
            <th style='{th}'>VOLUME</th>
            <th style='{th}'>POL/POD</th>
            <th style='{th}'>ETD</th>
            <th style='{th}'>FREE TIME</th>
            <th style='{th}'>PP/CC</th>
            <th style='{th}'>THÔNG TIN/ YÊU CẦU KHÁC<br/>( TÊN HÀNG,HS CODE/G.W..)</th>
        </tr>
        <tr>
            <td style='{td}'>{_line}</td>
            <td style='{td}'>{shipperName}</td>
            <td style='{td}'>{_volume}</td>
            <td style='{td}'>{_polPod}</td>
            <td style='{tdCenter}'>{_etd:dd-MMM}</td>
            <td style='{td}'>{_freeTime}</td>
            <td style='{tdCenter}'>{_ppCc}</td>
            <td style='{td}'>{_description}</td>
        </tr>
        <tr>
            <td style='{td}' colspan='2'><b>BUY RATE: {_buyRate:0.####}</b></td>
            <td style='{td}' colspan='4'></td>
            <td style='{th}'>REMARK</td>
            <td style='{td}'>{_remark}</td>
        </tr>
        <tr>
            <td style='{td}'><b>ACC</b></td>
            <td style='{td}' colspan='5'>{_acc}</td>
            <td style='{td}' colspan='2'>{_typeBill}</td>
        </tr>
    </table>
</div>";
    }

    private async Task SendMailNotifyAsync()
    {
        if (!IsEdit)
        {
            CallSnackBar("Vui lòng lưu Form Booking trước khi gửi email", MudBlazor.Severity.Warning);
            return;
        }

        if (string.IsNullOrWhiteSpace(_userHandle))
        {
            CallSnackBar("Danh sách email nhận trống", MudBlazor.Severity.Warning);
            return;
        }

        try
        {
            _processingUpload = true;

            var users = _userHandle.Split(',');
            var emails = new List<string>();
            foreach (var user in users)
            {
                if (string.IsNullOrWhiteSpace(user))
                    continue;

                var email = await gsv.GetEmailAsync(user.Trim());
                if (!string.IsNullOrEmpty(email))
                    emails.Add(email);
            }

            if (emails.Count == 0)
            {
                CallSnackBar("Danh sách email nhận trống", MudBlazor.Severity.Warning);
                return;
            }

            var subject = $"Form Booking Information - {_booking?.BookingNo}";
            var body = BuildEmailBody();
            var rs = await gsv.SendMail(emails, new List<string>(), subject, body);
            CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
        }
        catch (Exception ex)
        {
            CallSnackBar($"Có lỗi xảy ra: {ex.Message}", MudBlazor.Severity.Error);
        }
        finally
        {
            _processingUpload = false;
        }
    }

    private async Task SendMessageAsync()
    {
        if (!IsEdit)
        {
            CallSnackBar("Vui lòng lưu Form Booking trước khi gửi thông báo", MudBlazor.Severity.Warning);
            return;
        }

        if (string.IsNullOrWhiteSpace(_userHandle))
        {
            CallSnackBar("Danh sách user nhận trống", MudBlazor.Severity.Warning);
            return;
        }

        try
        {
            _processingUpload_message = true;

            var users = _userHandle.Split(',');
            var ids = new List<string>();
            foreach (var user in users)
            {
                if (string.IsNullOrWhiteSpace(user))
                    continue;

                var id = await gsv.GetIdfromUser(user.Trim());
                if (id.HasValue)
                    ids.Add(id.Value.ToString());
            }

            if (ids.Count == 0)
            {
                CallSnackBar("Danh sách user nhận trống", MudBlazor.Severity.Warning);
                return;
            }

            await _notificationService.SendNotificationAsync(ids.ToArray(), BuildNotifyContent());
            CallSnackBar("Đã gửi thông báo", MudBlazor.Severity.Success);
        }
        catch (Exception ex)
        {
            CallSnackBar($"Có lỗi xảy ra: {ex.Message}", MudBlazor.Severity.Error);
        }
        finally
        {
            _processingUpload_message = false;
        }
    }
}
