@using System.Globalization
@inject ISnackbar Snackbar
@inject AccountService asv
@inject TrainScheduleServices trainsv
@inject IStringLocalizer<SharedResource> Localizer
@inject SharedServices ssv
@inject LocalChargesServices lcsv
@inject SupportServices supsv
@inject LenhDieuXeServices ldxsv
@inject TKHQ_Services tkhqsv
@inject GlobalServices gsv
@inject Bieugianangha_Services BGRRsv
@inject CustomerService CusSV
@inject DNTUServices DNTUSV
@inject BookingService Bksv
@inject ShipmentService shipmentsv
@inject NavigationManager NavigationManager
@inject ProductPriceServices prsv
@inject NotificationService _notificationService
@inject IJSRuntime JSRuntime

<MudDialog>
    <DialogContent>
        <MudContainer Class="pa-3">
            <MudCard Elevation="0" Class="pa-2">
                <MudForm Model="@_ProductPrice_KTCL_Details" @ref="@form">
                    <MudCardContent Class="pa-3">
                        <MudGrid Spacing="1">
                            <MudItem xs="12">
                                <MudGrid Spacing="1">
                                    <MudItem xs="12" sm="1">
                                        <MudButton Style="background-color: #007BFF; color: white;" Size="Size.Small" Color="Color.Primary"
                                                   Disabled="@(Status == "edit")"
                                                   OnClick="() => Get_BGNHNo()">>>></MudButton>
                                    </MudItem>
                                    <MudItem xs="12" sm="5">
                                        <MudTextField @bind-Value="_ProductPrice_KTCL_Details.MaRFQ" Disabled="true" Label="@Localizer["MaRFQ"]"
                                                      Class="custom-label" Margin="Margin.Dense" Required="true" />
                                    </MudItem>
                                    <MudItem xs="12" sm="6">
                                        <MudDatePicker Class="custom-label" @bind-Date="_ProductPrice_KTCL_Details.NgayYeuCau"
                                                       For="@(() => _ProductPrice_KTCL_Details.NgayYeuCau)"
                                                       Label="@Localizer["Ngayguiyeucau"]"
                                                       Margin="Margin.Dense"
                                                       DateFormat="dd/MM/yyyy"
                                                       Required="true" />
                                    </MudItem>
                                </MudGrid>
                            </MudItem>
                            <MudItem xs="12">
                                <MudGrid Spacing="1">
                                    <MudItem xs="12" sm="4">
                                        <MudTextField @bind-Value="_ProductPrice_KTCL_Details.Tenhang" Label="@Localizer["TenHang_gs"]"
                                                      Class="custom-label" Margin="Margin.Dense" />
                                    </MudItem>
                                    <MudItem xs="12" sm="4">
                                        <MudAutocomplete @bind-Value="_ProductPrice_KTCL_Details.Loaihinh" Label="@Localizer["Loaihinh"]"
                                                         Class="custom-label" Margin="Margin.Dense" CoerceValue SearchFunc="SearchType" />
                                    </MudItem>
                                    <MudItem xs="12" sm="4">
                                        <MudTextField @bind-Value="_ProductPrice_KTCL_Details.Noidung" Label="@Localizer["noidung"]"
                                                      Class="custom-label" Margin="Margin.Dense" />
                                    </MudItem>
                                </MudGrid>
                            </MudItem>
                            <MudItem xs="12">
                                <MudGrid Spacing="1">
                                    <MudItem xs="12" sm="4">
                                        <MudSelect @bind-Value="_ProductPrice_KTCL_Details.Trangthai" Label="@Localizer["status"]"
                                                   Class="custom-label" Margin="Margin.Dense">
                                            @foreach (var item in trangthais)
                                            {
                                                <MudSelectItem Value="@item">@item</MudSelectItem>
                                            }
                                        </MudSelect>
                                    </MudItem>

                                    <MudItem xs="12" sm="8">
                                        <MudGrid Spacing="1">
                                            <MudItem xs="12">
                                                <MudText Typo="Typo.subtitle2" Class="mt-1 mb-0">
                                                    @Localizer["User"] / User Nhận Email
                                                </MudText>
                                            </MudItem>
                                            <MudItem xs="12">
                                                <MudGrid Spacing="1">
                                                    <MudItem xs="12" md="5">
                                                        <MudAutocomplete Class="custom-label" T="string"
                                                                         @bind-Value="UserHanding"
                                                                         Label="@Localizer["User"]"
                                                                         Margin="Margin.Dense"
                                                                         SearchFunc="Search_User"
                                                                         Immediate="true"
                                                                         CoerceText="true"
                                                                         Clearable="true"
                                                                         MaxItems="100" />
                                                    </MudItem>
                                                    <MudItem xs="12" md="2" Class="d-flex align-end">
                                                        <MudButton Style="background-color: #007BFF; color: white;" Size="Size.Small" Color="Color.Primary"
                                                                   OnClick="() => Getuser(_ProductPrice_KTCL_Details)">>>></MudButton>
                                                    </MudItem>
                                                    <MudItem xs="12" md="5">
                                                        <MudTextField @bind-Value="_ProductPrice_KTCL_Details.Userhandle" Class="custom-label"
                                                                      Margin="Margin.Dense" HelperTextOnFocus
                                                                      HelperText="từ 2 mail trở lên vui lòng ngăn cách bằng dấu ','"
                                                                      Lines="2" AutoGrow Label="@Localizer["EmailRecipient"]" Required="false" />
                                                    </MudItem>
                                                </MudGrid>
                                            </MudItem>
                                            <MudItem xs="12">
                                                <MudStack Row="true" Spacing="1" Justify="Justify.FlexEnd">
                                                    <MudButton HtmlTag="label" Disabled="_processingUpload"
                                                               @onclick="@(() => SendMailnotify(_ProductPrice_KTCL_Details))"
                                                               Size="Size.Small" Color="Color.Tertiary" Variant="Variant.Filled"
                                                               StartIcon="@Icons.Material.Filled.Email">
                                                        @if (_processingUpload)
                                                        {
                                                            <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                                                            <MudText Class="ms-2">Processing</MudText>
                                                        }
                                                        else
                                                        {
                                                            <MudText>@Localizer["sendemail"]</MudText>
                                                        }
                                                    </MudButton>
                                                    <MudButton HtmlTag="label" Disabled="_processingUpload_message"
                                                               @onclick="@(() => SendMessage(_ProductPrice_KTCL_Details))"
                                                               Size="Size.Small" Color="Color.Tertiary" Variant="Variant.Filled"
                                                               StartIcon="@Icons.Material.Filled.Email">
                                                        @if (_processingUpload_message)
                                                        {
                                                            <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                                                            <MudText Class="ms-2">Processing</MudText>
                                                        }
                                                        else
                                                        {
                                                            <MudText>@Localizer["message"]</MudText>
                                                        }
                                                    </MudButton>
                                                </MudStack>
                                            </MudItem>
                                        </MudGrid>
                                    </MudItem>
                                </MudGrid>
                            </MudItem>
                        </MudGrid>
                        <AttachmentField @ref="_attach" @bind-Value="_ProductPrice_KTCL_Details.AttachmentIds" Folder="KTCL" Title="Attachments" />
                    </MudCardContent>
                </MudForm>
            </MudCard>
        </MudContainer>
    </DialogContent>
    <DialogActions>

        <MudButton OnClick="@(async () => await Submit())">Save</MudButton>
        <MudButton OnClick="Cancel">Cancel</MudButton>

    </DialogActions>
</MudDialog>


@code {
    [CascadingParameter] MudDialogInstance? MudDialog { get; set; }
    [Parameter] public Models.M_KTCLCostRequest _ProductPrice_KTCL_Details { get; set; }
    [Parameter] public string Status { get; set; }
    List<PortModel> Ports = new List<PortModel>();
    List<string> trangthais = new List<string>();
    private List<Models.TrangThai> M_Trangthais = new List<Models.TrangThai>();
    public CultureInfo _en = CultureInfo.GetCultureInfo("en-US");
    List<M_KTCLCostRequest> ImportCosts = new List<M_KTCLCostRequest>();
    public string? UserHanding;
    MudForm form;
    private List<string> ListUser { get; set; } = new List<string>();

    List<string> List_Incoterm = new List<string>
    {
        "EXW-Giao hàng tại xưởng-người mua chịu toàn bộ chi phí và rủi ro",
        "FOB-Giao lên tàu-người bán chịu chi phí đến cảng xuất khẩu",
        "CIF-Người bán chịu chi phí + bảo hiểm đến cảng nhập khẩu",
        "DDP-Giao đã nộp thuế-người bán lo chi phí đến tận nơi mua",
        "FCA-Giao cho người vận chuyển chị định",
        "CPT-Cước phí trả tới nơi-người bán trả cước vận chuyển"
    };

    List<string> List_Type = new List<string>
    {
        "FCL",
        "LCL",
        "AIR Air Freight",
        "EXPRESS",
        "TRUCK",
        "WAREHOUSE",
        "CUSTOMS",
        "DOOR",
        "PROJECT",
        "OTHERS"
    };

    protected async override Task OnInitializedAsync()
    {
        if (Status == "Duplicate")
        {
            _ProductPrice_KTCL_Details.MaRFQ = "";
            _ProductPrice_KTCL_Details.Id = Guid.Empty;
            _ProductPrice_KTCL_Details.Approve = false;
            _ProductPrice_KTCL_Details.Continued = true;
            _ProductPrice_KTCL_Details.Editable = true;
        }
        Ports = await Bksv.GetList_PORT();
        M_Trangthais = await supsv.GetListTrangThai();
        var tts = await supsv.GetListTrangThai();
        trangthais = tts.Where(x => x.Tieude == "ProductPrice").OrderBy(x => x.Noidung).Select(x => x.Noidung).ToList();
        // ImportCosts = await prsv.GetProduct_Price_import();
        ListUser = await asv.GetList_User_handle() ?? new List<string>();
    }

    private async Task<IEnumerable<string>> SearchPorts(string text)
    {
        try
        {
            if (string.IsNullOrWhiteSpace(text))
            {
                return Ports
                    .Where(x => !string.IsNullOrEmpty(x.PORT))
                    .Select(x => x.PORT)
                    .Distinct();
            }

            return Ports
                .Where(x => !string.IsNullOrEmpty(x.PORT) &&
                            x.PORT.Contains(text, StringComparison.OrdinalIgnoreCase))
                .Select(x => x.PORT)
                .Distinct();
        }
        catch (Exception)
        {
            throw;
        }
    }

    private async Task Submit()
    {
        await form.Validate();

        if (form.IsValid)
        {
            var UserName = asv.GetAuth().Result.User.Identity!.Name!;
            if (Status == "add")
            {
                _ProductPrice_KTCL_Details.CreateAt = DateTime.Now.ToString();
                _ProductPrice_KTCL_Details.Usercreate = UserName;
                _ProductPrice_KTCL_Details.Approve = false;
                _ProductPrice_KTCL_Details.Continued = true;
                _ProductPrice_KTCL_Details.Editable = true;
            }

            _ProductPrice_KTCL_Details.DateUpdate = DateTime.Now.ToString();
            _ProductPrice_KTCL_Details.Userupdate = UserName;
            if (_attach != null) await _attach.CommitAsync();
            MudDialog!.Close(_ProductPrice_KTCL_Details);


        }

    }
    AttachmentField? _attach;
    async Task Cancel()
    {
        if (_attach != null) await _attach.RollbackAsync();
        MudDialog.Cancel();
    }

    void CallSnackBar(string message, MudBlazor.Severity severity)
    {

        Snackbar.Configuration.SnackbarVariant = Variant.Filled;
        Snackbar.Configuration.MaxDisplayedSnackbars = 3;
        Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopRight;
        Snackbar.Add(message, severity);
    }
    // private async Task<IEnumerable<string?>> SearchUnit(string? text)
    // {
    //     try
    //     {
    //         var items = ImportCosts.Select(x => x.Donvitinh).Distinct();
    //         if (string.IsNullOrEmpty(text))
    //         {
    //             return items;
    //         }
    //         // MBL.Porname = mst_Consignee;
    //         return items.Where(x => x != null && x.Equals(text));
    //     }
    //     catch (Exception)
    //     {
    //         throw;
    //     }
    // }
    private async Task Get_BGNHNo()
    {

        int formattedYear = DateTime.Now.Year;
        int formattedMonth = DateTime.Now.Month;

        string usr = asv.GetAuth().Result.User.Identity!.Name!;
        var refno = await supsv.GetRefNoByFunc("ProductPrice_KTCL", formattedMonth, formattedYear, usr);

        var rs = asv.GetUserDetail();
        var cn = rs.Branch;
        _ProductPrice_KTCL_Details.MaRFQ = cn + "PR_KTCL_" + formattedYear.ToString() + formattedMonth.ToString() + refno.Value.ToString("D4");
    }
    private async Task<IEnumerable<string?>> SearchIncoterm(string? text)
    {
        try
        {
            var items = List_Incoterm.Distinct();
            if (string.IsNullOrWhiteSpace(text))
            {
                return items;
            }

            return items.Where(x => x != null && x.Contains(text, StringComparison.OrdinalIgnoreCase));
        }
        catch (Exception)
        {
            throw;
        }
    }
    private async Task<IEnumerable<string?>> SearchType(string? text)
    {
        try
        {
            var items = List_Type.Distinct();
            if (string.IsNullOrWhiteSpace(text))
            {
                return items;
            }

            return items.Where(x => x != null && x.Contains(text, StringComparison.OrdinalIgnoreCase));
        }
        catch (Exception)
        {
            throw;
        }
    }

    private async Task<IEnumerable<string>> Search_User(string value)
    {
        if (string.IsNullOrEmpty(value))
            return ListUser;

        return ListUser.Where(x => x.Contains(value, StringComparison.InvariantCultureIgnoreCase));
    }

    private async Task Getuser(M_KTCLCostRequest item)
    {
        if (string.IsNullOrEmpty(item.Userhandle))
        {
            item.Userhandle = UserHanding;
        }
        else
        {
            item.Userhandle += "," + UserHanding + ",";
        }
    }

    private bool _processingUpload = false;
    async Task SendMailnotify(M_KTCLCostRequest item)
    {
        try
        {
            string[] users = item.Userhandle.Split(',');
            List<string> emails = new List<string>(); // Danh sách động, có thể thêm thoải mái

            int index = 0;
            foreach (var user in users)
            {
                if (string.IsNullOrEmpty(user))
                {

                }
                else
                {
                    string inputemail = "";
                    inputemail = await gsv.GetEmailAsync(user);
                    if (!string.IsNullOrEmpty(inputemail))
                    {
                        emails.Add(inputemail);
                    }

                }
            }
            string[] emailarray = emails.ToArray();
            _processingUpload = true;
            await Task.Delay(1);
            StateHasChanged();

            if (emails != null && emailarray.Length > 0)
            {

                var rs = await gsv.GuiThongBaoProject_product_price_KTCL(item, emailarray);

                CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);

            }
            else
            {

                CallSnackBar(Localizer["EmailEmpty"], MudBlazor.Severity.Warning);
                return;
            }


        }
        catch (Exception ex)
        {
            CallSnackBar(string.Format(Localizer["SomethingWentWrong"], ex.Message), MudBlazor.Severity.Error);
        }
        finally
        {
            _processingUpload = false;
        }

    }

    private bool _processingUpload_message = false;
    async Task SendMessage(M_KTCLCostRequest item)
    {
        try
        {
            string[] users = item.Userhandle.Split(',');
            List<string> listid = new List<string?>(); // Danh sách động, có thể thêm thoải mái

            int index = 0;
            foreach (var user in users)
            {
                if (string.IsNullOrEmpty(user))
                {

                }
                else
                {

                    Guid? inputid = await gsv.GetIdfromUser(user);
                    if (inputid != null)
                    {
                        listid.Add(inputid.ToString());
                    }

                }
            }
            string[] Idarray = listid.ToArray();
            _processingUpload_message = true;
            await Task.Delay(1);
            StateHasChanged();
            string noidung = "Cost Request Quality Control FRQ No:" + item.MaRFQ;
            if (listid != null && Idarray.Length > 0)
            {
                await _notificationService.SendNotificationAsync(Idarray, noidung);


            }
            else
            {

                CallSnackBar(Localizer["UserEmpty"], MudBlazor.Severity.Warning);
                return;
            }

        }
        catch (Exception ex)
        {
            CallSnackBar(string.Format(Localizer["SomethingWentWrong"], ex.Message), MudBlazor.Severity.Error);
        }
        finally
        {
            _processingUpload_message = false;
        }
    }

}
