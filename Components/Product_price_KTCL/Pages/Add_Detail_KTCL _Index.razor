@using System.Globalization
@inject ProductPriceServices prsv;
@inject GlobalServices gsv;
@inject EmailService emsv
@inject QuotationService QuoSv
@inject SharedServices ssv
@inject TrainScheduleServices trainsv
@inject BookingService bksv
@inject AccountService asv
@inject CustomerService Cussv
@inject IStringLocalizer<SharedResource> Localizer
@inject SupportServices supsv
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject FontService FontSizeService

<style>
    .ktcl-detail-view {
        padding: 10px;
        border-radius: 16px;
        background: linear-gradient(180deg, #f8fbff 0%, #f1f7fb 100%);
    }

    .ktcl-detail-card {
        border-radius: 16px;
        border: 1px solid rgba(17, 138, 178, .16);
        background: #ffffff;
        overflow: hidden;
        box-shadow: 0 8px 22px rgba(15, 23, 42, .07);
    }

    .ktcl-detail-header {
        padding: 10px 14px;
        border-bottom: 1px solid #e2e8f0;
        background: linear-gradient(180deg, #ffffff 0%, #f8fafc 100%);
    }

    .ktcl-detail-title {
        font-weight: 800 !important;
        color: #0f3557;
        letter-spacing: .2px;
    }

    .ktcl-detail-subtitle {
        color: #64748b;
        font-size: 12px;
        margin-top: 2px;
    }

    .ktcl-detail-grid-wrap {
        padding: 10px;
    }

    .ktcl-detail-grid {
        border-radius: 14px;
        overflow: hidden;
        border: 1px solid #e2e8f0 !important;
        background: #ffffff;
    }

        .ktcl-detail-grid .mud-table-container {
            max-height: 420px;
            min-height: 220px;
        }

        .ktcl-detail-grid .mud-table {
            font-size: 12px;
        }

            .ktcl-detail-grid .mud-table-head th,
            .ktcl-detail-grid .mud-table thead th {
                background: linear-gradient(180deg, #118ab2 0%, #0d6f91 100%) !important;
                color: #ffffff !important;
                font-weight: 800 !important;
                white-space: nowrap;
                padding: 7px 10px !important;
                border-bottom: none !important;
            }

        .ktcl-detail-grid .mud-table-row td {
            padding: 6px 10px !important;
            white-space: nowrap;
            max-width: 220px;
            overflow: hidden;
            text-overflow: ellipsis;
            border-bottom: 1px solid #eef2f7 !important;
        }

        .ktcl-detail-grid .mud-table-row:hover td {
            background-color: #eef8ff !important;
        }

        .ktcl-detail-grid .mud-table-foot tr,
        .ktcl-detail-grid .mud-table-foot td {
            background: #f8fafc !important;
            color: #0f3557 !important;
            font-weight: 700;
        }

        .ktcl-detail-grid .mud-checkbox .mud-icon-root {
            font-size: 18px;
        }

        .ktcl-detail-grid .mud-input-root,
        .ktcl-detail-grid .mud-input-control {
            font-size: 12px !important;
        }

    .text-right input {
        text-align: right !important;
    }

    .custom-right-align {
        text-align: right !important;
    }

    .no-wrap {
        white-space: nowrap;
    }

    .labelCustomColor label,
    .custom-label .mud-input-label {
        font-weight: 700;
        color: #118AB2 !important;
    }
</style>

<div class="ktcl-detail-view">
    <MudPaper Class="ktcl-detail-card" Elevation="0">
        <div class="ktcl-detail-header">
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                <MudStack Spacing="0">
                    <MudText Typo="Typo.subtitle2" Class="ktcl-detail-title">@Localizer["ADD_Detail"]</MudText>
                    <MudText Class="ktcl-detail-subtitle">
                        @Localizer["Product_Price_KTCL"] - @(_ProductPrice_KTCL_Details?.MaRFQ)
                    </MudText>
                </MudStack>

                @if (cusmarket_loading)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                }
            </MudStack>
        </div>

        <div class="ktcl-detail-grid-wrap">
            <MudDataGrid T="M_Product_Price_detail_ALL" Items="@listTruck.ToList()" Filterable="true" @ref="muddetails"
                         Class="ktcl-detail-grid"
                         FilterMode="@DataGridFilterMode.Simple" Dense="true" Virtualize="true"
                         FixedHeader="true" FixedFooter="true" HeaderClass="no-wrap" FooterClass="no-wrap"
                         ReadOnly="false" Loading="@cusmarket_loading" CommittedItemChanges="@CommittedItemDebitInfo"
                         ColumnResizeMode="@(_resizeColumn ? ResizeMode.Column : ResizeMode.Container)">
                <Columns>

                    <PropertyColumn Property="x => x.Ngaybaogia" Title="@Localizer["NgayBaoGia"]" Format="dd/MM/yyyy">
                        <EditTemplate>
                            <MudDatePicker Class="custom-label" @bind-Date="context.Item.Ngaybaogia"
                                           For="@(() => context.Item.Ngaybaogia)"
                                           Label="@Localizer["NgayBaoGia"]"
                                           Margin="Margin.Dense"
                                           DateFormat="dd/MM/yyyy"
                                           Required="true" />
                        </EditTemplate>
                    </PropertyColumn>

                    <PropertyColumn Property="x => ItemidtoChargeName(x.Itemid)" Title="@Localizer["Item"]" Required="false">
                        <EditTemplate>
                            <MudAutocomplete T="Guid?" Label="@Localizer["Item"]" Class="custom-label"
                                             @bind-Value="context.Item.Itemid"
                                             Margin="Margin.Dense"
                                             Required="true"
                                             SearchFunc="Search_Charge"
                                             ToStringFunc="GetChargeLabel" />
                        </EditTemplate>
                    </PropertyColumn>

                    <PropertyColumn Property="x => x.Dongia" Title="@Localizer["unitprice"]" Format="#,##0.##" CellClass="custom-right-align" Required="false">
                        <EditTemplate>
                            <MudNumericField @bind-Value="context.Item.Dongia"
                                             Label="@Localizer["unitprice"]" Format="#,##0.##" Culture="@_en" T="double?"
                                             Margin="Margin.Dense"
                                             HideSpinButtons="true"
                                             Class="text-right custom-label" />
                        </EditTemplate>
                    </PropertyColumn>

                    <PropertyColumn Property="x => x.Vat" Title="@Localizer["vat"]" Format="#,##0.##" CellClass="custom-right-align" Required="false">
                        <EditTemplate>
                            <MudNumericField @bind-Value="context.Item.Vat"
                                             Label="@Localizer["vat"]" Format="#,##0.##" Culture="@_en" T="double?"
                                             Margin="Margin.Dense"
                                             HideSpinButtons="true"
                                             Class="text-right custom-label" />
                        </EditTemplate>
                    </PropertyColumn>

                    <PropertyColumn Property="x => x.Thanhtien" Title="@Localizer["ThanhTien"]" Format="#,##0.##" CellClass="custom-right-align" Required="false">
                        <EditTemplate>
                            <MudNumericField @bind-Value="context.Item.Thanhtien"
                                             Label="@Localizer["ThanhTien"]" Format="#,##0.##" Culture="@_en" T="double?"
                                             Margin="Margin.Dense"
                                             HideSpinButtons="true"
                                             Class="text-right custom-label" />
                        </EditTemplate>
                    </PropertyColumn>

                    <PropertyColumn Property="x => x.Cur" Title="@Localizer["Loaitiente"]" Required="false">
                        <EditTemplate>
                            <MudSelect @bind-Value="context.Item.Cur" Label="@Localizer["Loaitiente"]" Class="custom-label" Margin="Margin.Dense">
                                <MudSelectItem Value="@("VND")">VND</MudSelectItem>
                                <MudSelectItem Value="@("USD")">USD</MudSelectItem>
                            </MudSelect>
                        </EditTemplate>
                    </PropertyColumn>

                    <PropertyColumn Property="x => x.Tigia" Title="@Localizer["tigia"]" Format="#,##0.##" CellClass="custom-right-align" Required="false">
                        <EditTemplate>
                            <MudNumericField @bind-Value="context.Item.Tigia"
                                             Label="@Localizer["tigia"]" Format="#,##0.##" Culture="@_en" T="double?" Required="true" HideSpinButtons="true"
                                             Margin="Margin.Dense"
                                             Class="text-right custom-label" />
                        </EditTemplate>
                    </PropertyColumn>

                    <PropertyColumn Property="x => x.loaicont" Title="@Localizer["Cont. Size Type"]" Required="false">
                    </PropertyColumn>

                    <PropertyColumn Property="x => x.Dieukhoanthanhtoan" Title="@Localizer["dieukhoanthanhtoan"]" Required="false">
                        <EditTemplate>
                            <MudTextField @bind-Value="context.Item.Dieukhoanthanhtoan"
                                          Label="@Localizer["dieukhoanthanhtoan"]"
                                          Class="custom-label"
                                          Margin="Margin.Dense" />
                        </EditTemplate>
                    </PropertyColumn>

                    <TemplateColumn Title="@Localizer["Approve"]">
                        <CellTemplate>
                            <MudCheckBox @bind-Checked="context.Item.Approve"
                                         @bind-Value="context.Item.Approve"
                                         @bind-Value:after="@(()=> OnApproveCheckboxWrapper(context.Item))">
                            </MudCheckBox>
                        </CellTemplate>

                        <EditTemplate>
                            <MudCheckBox @bind-Value="context.Item.Approve" Label="@Localizer["Approve"]" Class="custom-label" />
                        </EditTemplate>
                    </TemplateColumn>

                    <PropertyColumn Property="x => x.Createat" Title="@Localizer["CreatedAt"]" Class="custom-label" IsEditable="false">
                    </PropertyColumn>

                    <PropertyColumn Property="x => x.Usercreate" Title="@Localizer["Nguoilap"]" Class="custom-label" IsEditable="false">
                    </PropertyColumn>

                </Columns>
            </MudDataGrid>
        </div>
    </MudPaper>
</div>

@code {
    [CascadingParameter] MudDialogInstance? MudDialog { get; set; }
    [Parameter] public Models.M_KTCLCostRequest _ProductPrice_KTCL_Details { get; set; }
    [Parameter] public string Status { get; set; }
    private List<Models.ChargeModel> charges = new List<Models.ChargeModel>();
    private List<Models.M_Product_Price_detail_ALL> listTruck = new List<Models.M_Product_Price_detail_ALL>();
    bool cusmarket_loading = false;
    private MudDataGrid<Models.M_Product_Price_detail_ALL> muddetails;
    private string searchText_item = "";
    private List<ChargeModel> filteredCharges = new List<ChargeModel>();
    private bool _resizeColumn;
    public CultureInfo _de = CultureInfo.GetCultureInfo("de-DE");
    public CultureInfo _en = CultureInfo.GetCultureInfo("en-US");

    protected async override Task OnInitializedAsync()
    {
        charges = await QuoSv.Getcharge();

        await RefreshInfo();
    }

    async Task RefreshInfo()
    {
        try
        {
            cusmarket_loading = true;
            listTruck.Clear();
            StateHasChanged();

            await Task.Delay(500);

            if (!await ssv.CheckPermission(asv.GetAuth().Result.User.Identity!.Name!, "View", "Product_Price_KTCL"))
            {
                CallSnackBar("You have not access to view", MudBlazor.Severity.Warning);
                return;
            }
            listTruck = await prsv.GetListProductPriceDetails_ALL(_ProductPrice_KTCL_Details.Id);
        }
        finally
        {
            cusmarket_loading = false;
        }

    }

    void CallSnackBar(string message, MudBlazor.Severity severity)
    {

        Snackbar.Configuration.SnackbarVariant = Variant.Filled;
        Snackbar.Configuration.MaxDisplayedSnackbars = 3;
        Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopRight;
        Snackbar.Add(message, severity);
    }
    async Task AddItemMarketInfo()
    {
        if (!await ssv.CheckPermission(asv.GetAuth().Result.User.Identity!.Name!, "View", "Product_Price_KTCL"))
        {
            CallSnackBar("You have not access to view", MudBlazor.Severity.Warning);
            return;
        }
        var item = new M_Product_Price_detail_ALL();
        item.Createat = DateTime.Now.ToString();
        var UserName = asv.GetAuth().Result.User.Identity!.Name!;
        item.Usercreate = UserName;
        listTruck.Add(item);

        await muddetails.SetEditingItemAsync(listTruck.LastOrDefault()!);
    }

    async Task CommittedItemDebitInfo(M_Product_Price_detail_ALL item)
    {
        // if (!await ssv.CheckPermission(asv.GetAuth().Result.User.Identity!.Name!, "View", "Product_Price_KTCL"))
        // {
        //     CallSnackBar("You have not access to view", MudBlazor.Severity.Warning);
        //     return;
        // }
        // item.RFQ_Id = _ProductPrice_KTCL_Details.Id;
        // item.Userupdate = asv.GetAuth().Result.User.Identity!.Name!;
        // item.Dateupdate = DateTime.Now.ToString("dd/MMM/yyyy");
        // var rs = item.Id != Guid.Empty ? await prsv.UpdateProductPrice_details_Truck(item) : await prsv.CreateProductPrice_details_truck(item);
