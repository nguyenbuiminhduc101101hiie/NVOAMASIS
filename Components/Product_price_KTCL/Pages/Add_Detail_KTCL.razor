@using System.Globalization
@inject ProductPriceServices prsv;
@inject GlobalServices gsv;
@inject EmailService emsv
@inject QuotationService QuoSv
@inject SharedServices ssv
@inject TrainScheduleServices trainsv
@inject BookingService bksv
@inject AccountService asv
@inject CustomerService Cussv
@inject IStringLocalizer<SharedResource> Localizer
@inject SupportServices supsv
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject FontService FontSizeService
@inject NotificationService _notificationService
@using System.Text.Json;
@inject HistoryLogService HistoryLogService
@inject ShipmentService shipsv
@inject tigiaVCBservices Vcbsv
<style>
    .text-right input {
    text-align: right !important;
    }

    .custom-right-align {
    text-align: right !important;
    }
</style>

<MudStack Row="true" Justify="Justify.FlexStart" Class="pa-2" Spacing="1">
    <MudButton HtmlTag="label" OnClick="RefreshInfo"
        Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled"
        StartIcon="@Icons.Material.Filled.Refresh">
        @Localizer["reload"]
    </MudButton>
    <MudButton HtmlTag="label" @onclick="@(() => AddItemMarketInfo())"
        Size="Size.Small" Color="Color.Secondary" Variant="Variant.Filled"
        StartIcon="@Icons.Material.Filled.Add">
        @Localizer["new"]
    </MudButton>
</MudStack>

<MudDataGrid T="M_Product_Price_detail_ALL" Items="@listTruck.ToList()" Filterable="true" @ref="muddetails"
FilterMode="@DataGridFilterMode.Simple" Dense="true" Virtualize="true"
FixedHeader="true" FixedFooter="true" HeaderClass="no-wrap" FooterClass="no-wrap"
ReadOnly="false"  CommittedItemChanges="@CommittedItemDebitInfo"
ColumnResizeMode="ResizeMode.Column">

    <Columns>
        <TemplateColumn CellClass="d-flex justify-end">
            <CellTemplate>

                <MudIconButton Icon="@Icons.Material.Outlined.Edit"
                OnClick="@(() => {
                           if (context.Item.Approve == false)
                           {
                                detail = JsonSerializer.Deserialize<M_Product_Price_detail_ALL>(JsonSerializer.Serialize(context.Item));
                               context.Actions.StartEditingItemAsync();
                           }else{
                                CallSnackBar("Request Pricing đã được Approve!!! , vui lòng bỏ Approve", MudBlazor.Severity.Warning);
                                return;
                          }
                       })" />
                <MudIconButton Size="@Size.Small" Icon="@Icons.Material.Outlined.Delete" OnClick="@(()=>DeleteItemDebitInfo(context.Item))" />
            </CellTemplate>
        </TemplateColumn>

        <PropertyColumn Property="x => x.Ngaybaogia" Title="@Localizer["NgayBaoGia"]" Format="dd/MM/yyyy">
            <EditTemplate>
                <MudDatePicker Class="custom-label" @bind-Date="context.Item.Ngaybaogia"
                    For="@(() => context.Item.Ngaybaogia)"
                    Label="@Localizer["NgayBaoGia"]"
                    Margin="Margin.Dense"
                    DateFormat="dd/MM/yyyy"
                    Required="true" />

            </EditTemplate>
        </PropertyColumn>

        <PropertyColumn Property="x => ItemidtoChargeName(x.Itemid)" Title="@Localizer["Item"]" Required="false">
            <EditTemplate>
                <MudAutocomplete T="Guid?" Label="@Localizer["Item"]" Class="custom-label"
                    @bind-Value="context.Item.Itemid"
                    Margin="Margin.Dense"
                    Required="true"
                    SearchFunc="Search_Charge"
                    ToStringFunc="GetChargeLabel" />

            </EditTemplate>
        </PropertyColumn>

        <PropertyColumn Property="x => x.Dongia" Title="@Localizer["unitprice"]" Format="#,##0.##" CellClass="custom-right-align" Required="false">
            <EditTemplate>
                <MudNumericField @bind-Value="context.Item.Dongia"
                    Label="@Localizer["unitprice"]" Format="#,##0.##" Culture="@_en" T="double?"
                    Margin="Margin.Dense"
                    Class="text-right custom-label" TextChanged="@(e => CalculateTotal(context.Item))" HideSpinButtons="true" />

            </EditTemplate>
        </PropertyColumn>


        <PropertyColumn Property="x => x.Vat" Title="@Localizer["vat"]" Format="#,##0.##" CellClass="custom-right-align" Required="false">
            <EditTemplate>
                <MudNumericField @bind-Value="context.Item.Vat"
                    Label="@Localizer["vat"]" Format="#,##0.##" Culture="@_en" T="double?" TextChanged="@(e => CalculateTotal(context.Item))"
                    Margin="Margin.Dense"
                    Class="text-right custom-label" HideSpinButtons="true" />

            </EditTemplate>
        </PropertyColumn>

        <PropertyColumn Property="x => x.Thanhtien" Title="@Localizer["ThanhTien"]" Format="#,##0.##" CellClass="custom-right-align" Required="false">
            <EditTemplate>
                <MudNumericField @bind-Value="context.Item.Thanhtien"
                    Label="@Localizer["ThanhTien"]" Format="#,##0.##" Culture="@_en" T="double?" HideSpinButtons="true"
                    Margin="Margin.Dense"
                    Class="text-right custom-label" />

            </EditTemplate>
        </PropertyColumn>

         <PropertyColumn Property="x => x.Cur" Title="@Localizer["Loaitiente"]" Required="false">
            <EditTemplate>
                  <MudAutocomplete @bind-Value="context.Item.Cur" Label="@Localizer["Loaitiente"]" Required="true" Class="custom-label" Margin="Margin.Dense" CoerceValue SearchFunc="SearchCurr" />
            </EditTemplate>
        </PropertyColumn>

       <PropertyColumn Property="x => x.Tigia" Title="@Localizer["tigia"]" Format="#,##0.##" CellClass="custom-right-align" Required="false">
            <EditTemplate>
                <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                    <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small"
                        Style="min-width: 80px; height: 36px; padding: 5px 10px;"
                        OnClick="@(() => GetTigia(context.Item))">
                        @Localizer["gettigia"]
                    </MudButton>
                    <MudNumericField @bind-Value="context.Item.Tigia"
                        Label="@Localizer["tigia"]"
                        Format="#,##0.##" Culture="@_en"
                        T="double?" Required="true" HideSpinButtons="true"
                        Margin="Margin.Dense"
                        Class="text-right custom-label" />
                </MudStack>
            </EditTemplate>
        </PropertyColumn>

         <PropertyColumn Property="x => x.loaicont" Title="@Localizer["Cont. Size Type"]" Required="false">
            <EditTemplate>
                <MudAutocomplete @bind-Value="context.Item.loaicont" Label="@Localizer["Cont. Size Type"]" Required="true" Class="custom-label" Margin="Margin.Dense" CoerceValue SearchFunc="SearchContSizeType" />
            </EditTemplate>
        </PropertyColumn>


        <PropertyColumn Property="x => x.Dieukhoanthanhtoan" Title="@Localizer["dieukhoanthanhtoan"]" Required="false">
            <EditTemplate>
                <MudTextField @bind-Value="context.Item.Dieukhoanthanhtoan" Label="@Localizer["dieukhoanthanhtoan"]" Class="custom-label" Margin="Margin.Dense" />

            </EditTemplate>
        </PropertyColumn>

        <TemplateColumn Title="@Localizer["Approve"]">
            <CellTemplate>
                <MudCheckBox @bind-Checked="context.Item.Approve" @bind-Value="context.Item.Approve" @bind-Value:after="@(()=> OnApproveCheckboxWrapper(context.Item))">
                </MudCheckBox>
            </CellTemplate>

            <EditTemplate>
                <MudCheckBox @bind-Value="context.Item.Approve" Label="@Localizer["Approve"]" Class="custom-label" />
            </EditTemplate>
        </TemplateColumn>


        <PropertyColumn Property="x=>x.UserRespond" Title="@Localizer["UserRespond"]">
            <EditTemplate>
                <MudGrid Spacing="1">
                    <MudItem xs="12" sm="3">
                        <MudAutocomplete Class="custom-label" T="string"
                            @bind-Value="UserRespond"
                            Label="@Localizer["User"]"
                            Margin="Margin.Dense"
                            SearchFunc="Search_User"
                            Immediate="true"
                            CoerceText="true"
                            Clearable="true"
                            MaxItems="100" />
                    </MudItem>
                    <MudItem xs="12" sm="1" Class="d-flex align-end">
                        <MudButton Style="background-color: #007BFF; color: white;" Size="Size.Small" Color="Color.Primary"
                            OnClick="() => Getuser(context.Item)">>>></MudButton>
                    </MudItem>
                    <MudItem xs="12" sm="4">
                        <MudTextField @bind-Value="context.Item.UserRespond" Class="custom-label"
                            Margin="Margin.Dense" Lines="2" Required="false" />
                    </MudItem>
                    <MudItem xs="12" sm="2" Class="d-flex align-end">
                        <MudButton HtmlTag="label" Disabled="_processingUpload_message"
                            @onclick="@(() => SendMessage(context.Item))"
                            Size="Size.Small" Color="Color.Tertiary" Variant="Variant.Filled"
                            StartIcon="@Icons.Material.Filled.Email">
                            @if (_processingUpload_message)
                            {
                                <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                                <MudText Class="ms-2">Processing</MudText>
                            }
                            else
                            {
                                <MudText>@Localizer["message"]</MudText>
                            }
                        </MudButton>
                    </MudItem>
                </MudGrid>
            </EditTemplate>
        </PropertyColumn>

        <PropertyColumn Property="x=>x.Createat" Title="@Localizer["CreatedAt"]" Class="custom-label" IsEditable="false">
        </PropertyColumn>

        <PropertyColumn Property="x=>x.Usercreate" Title="@Localizer["Nguoilap"]" Class="custom-label" IsEditable="false">
        </PropertyColumn>


    </Columns>
</MudDataGrid>

@code {
    [CascadingParameter] MudDialogInstance? MudDialog { get; set; }
    [Parameter] public Models.M_KTCLCostRequest _ProductPrice_KTCL_Details { get; set; }
    [Parameter] public string Status { get; set; }
    private List<Models.ChargeModel> charges = new List<Models.ChargeModel>();
    private List<Models.M_Product_Price_detail_ALL> listTruck = new List<Models.M_Product_Price_detail_ALL>();
    bool cusmarket_loading = false;
    private MudDataGrid<Models.M_Product_Price_detail_ALL> muddetails;
    private string searchText_item = "";
    private List<ChargeModel> filteredCharges = new List<ChargeModel>();
    string usr;
    public CultureInfo _de = CultureInfo.GetCultureInfo("de-DE");
    public CultureInfo _en = CultureInfo.GetCultureInfo("en-US");
    private List<string> ListUser { get; set; } = new List<string>();
    public string? UserRespond;
    M_Product_Price_detail_ALL detail;
      List<M_Container> Conts = new List<M_Container>();

          List<string> currs = new List<string>();

      private async Task<IEnumerable<string>> SearchCurr(string? text)
    {
        if (string.IsNullOrWhiteSpace(text))
            return currs;

        return currs.Where(x => !string.IsNullOrEmpty(x) && x.Contains(text, StringComparison.OrdinalIgnoreCase));
    }

    protected async override Task OnInitializedAsync()
    {
        Conts = shipsv.GetListContainerAll();
        ListUser = await asv.GetList_User_handle() ?? new List<string>();
        charges = await QuoSv.Getcharge();
        usr = asv.GetAuth().Result.User.Identity!.Name!;
        currs = await Vcbsv.GetCur();
        await RefreshInfo();
    }
     private async Task<IEnumerable<string?>> SearchContSizeType(string? text)
    {
        try
        {
            var items = Conts.Select(x => x.CTN_SIZE_TYPE).Distinct();
 
            if (string.IsNullOrEmpty(text))
            {
                return items;
            }
            // MBL.Porname = mst_Consignee;
            return items.Where(x => !string.IsNullOrEmpty(x) && x.Contains(text, StringComparison.OrdinalIgnoreCase));
        }
        catch (Exception)
        {
            throw;
        }
    }
    async Task RefreshInfo()
    {
        try
        {
            cusmarket_loading = true;
            listTruck.Clear();
            StateHasChanged();

            await Task.Delay(500);

            if (!await ssv.CheckPermission(asv.GetAuth().Result.User.Identity!.Name!, "View", "Product_Price_KTCL"))
            {
                CallSnackBar("You have not access to view", MudBlazor.Severity.Warning);
                return;
            }
            listTruck = await prsv.GetListProductPriceDetails_ALL(_ProductPrice_KTCL_Details.Id);
        }
        finally
        {
            cusmarket_loading = false;
        }

    }

    void CallSnackBar(string message, MudBlazor.Severity severity)
    {

        Snackbar.Configuration.SnackbarVariant = Variant.Filled;
        Snackbar.Configuration.MaxDisplayedSnackbars = 3;
        Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopRight;
        Snackbar.Add(message, severity);
    }
    async Task AddItemMarketInfo()
    {
        if (!await ssv.CheckPermission(asv.GetAuth().Result.User.Identity!.Name!, "View", "Product_Price_KTCL"))
        {
            CallSnackBar("You have not access to view", MudBlazor.Severity.Warning);
            return;
        }

        var item = new M_Product_Price_detail_ALL();
        item.Createat = DateTime.Now.ToString();
        var UserName = asv.GetAuth().Result.User.Identity!.Name!;
        item.Usercreate = UserName;
        item.Type = "KTCL";
        item.UserRespond = _ProductPrice_KTCL_Details.Usercreate;
        listTruck.Add(item);

        await muddetails.SetEditingItemAsync(listTruck.LastOrDefault()!);
    }

    async Task CommittedItemDebitInfo(M_Product_Price_detail_ALL item)
    {
        if (!await ssv.CheckPermission(asv.GetAuth().Result.User.Identity!.Name!, "View", "Product_Price_KTCL"))
        {
            CallSnackBar("You have not access to view", MudBlazor.Severity.Warning);
            return;
        }
        item.RFQ_Id = _ProductPrice_KTCL_Details.Id;
        item.Userupdate = asv.GetAuth().Result.User.Identity!.Name!;
        item.Dateupdate = DateTime.Now.ToString("dd/MMM/yyyy");
        // item.date = DateTime.Now.ToString();

        // item.userupdate = asv.GetAuth().Result.User.Identity!.Name!;
        var rs = item.Id != Guid.Empty ? await prsv.UpdateProductPrice_details_Truck(item,detail) : await prsv.CreateProductPrice_details_truck(item);
        CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);

        _ProductPrice_KTCL_Details.Trangthai = "Completed";
        await prsv.UpdateCreateProduct_KTCL(_ProductPrice_KTCL_Details);
        await RefreshInfo();
    }

    async Task DeleteItemDebitInfo(M_Product_Price_detail_ALL item)
    {
        if (item == null)
        {
            CallSnackBar("you must select 1 row.", MudBlazor.Severity.Warning);
            return;
        }
        if (item.Approve == true)
        {
            CallSnackBar("Data đã được Approve!!! , vui lòng bỏ Approve", MudBlazor.Severity.Warning);
            return;
        }
        var resultMess = await DialogService.ShowMessageBox(
                "Warning",
                "Deleting can not be undone!",
                yesText: "Delete!", cancelText: "Cancel");

        if (resultMess.HasValue)
        {
            var rs = await prsv.DeletepRODUCTdETAILS_Truck(item);
            string RFQNo = await prsv.GetMaRFQ_ByID_KTCL(item.RFQ_Id);
            await HistoryLogService.LogAsync(usr, "DeleteDetails", "Product_Price_detail_ALL", item.Id,RFQNo, new { OldData = item });
            CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
            await RefreshInfo();
        }

    }

    string ItemidtoChargeName(Guid? itemid)
    {
        if (itemid == null || itemid == Guid.Empty)
            return string.Empty;
        var rs = charges.FirstOrDefault(x => x.CHARGE_ID == itemid);
        return rs == null ? string.Empty : rs.CHARGE!;
    }

    private async Task FilterCharge()
    {

        if (string.IsNullOrWhiteSpace(searchText_item))
        {
            filteredCharges = charges;
        }
        else
        {
            filteredCharges = charges.Where(x => x.CHARGE != null)
                .Where(c => c.CHARGE_CODE.Contains(searchText_item, StringComparison.OrdinalIgnoreCase) ||
                            c.CHARGE.Contains(searchText_item, StringComparison.OrdinalIgnoreCase))
                .ToList();
        }

        await InvokeAsync(StateHasChanged); // Cập nhật giao diện
    }

    private string GetChargeLabel(Guid? id)
    {
        var customer = charges.FirstOrDefault(x => x.CHARGE_ID == id);
        return customer != null ? customer.CHARGE : string.Empty;
    }

    private async Task<IEnumerable<Guid?>> Search_Charge(string value)
    {
        if (string.IsNullOrEmpty(value))
            return charges.Select(x => (Guid?)x.CHARGE_ID);

        return charges
            .Where(x => (x.CHARGE).Contains(value, StringComparison.InvariantCultureIgnoreCase))
            .Select(x => (Guid?)x.CHARGE_ID);
    }

    private async Task OnApproveCheckboxWrapper(M_Product_Price_detail_ALL item)
    {
        if (await ssv.CheckPermission(asv.GetAuth().Result.User.Identity.Name, "Approve", "Product_Price_KTCL"))
        {
            var rs = await prsv.UpdateCreateProduct_Detail_truck(item);
            MudBlazor.Severity severity;
            if (rs[1] == "1")
                severity = MudBlazor.Severity.Success;
            else
                severity = MudBlazor.Severity.Error;

            CallSnackBar(rs[0], severity);

        }
        else
        {
            CallSnackBar("You have not access to Approve", MudBlazor.Severity.Warning);
            return;
        }

    }

    private void CalculateTotal(M_Product_Price_detail_ALL item)
    {
        if (item.Dongia.HasValue && item.Vat.HasValue)
        {

            double Vat = item.Vat ?? 0;
            double dongia = item.Dongia ?? 0;
            item.Thanhtien = Math.Round(dongia * (Vat / 100 + 1), 2);
            // CalculateThanhtiensauthue(item);
        }


    }

    private bool _processingUpload_message = false;

    async Task SendMessage(M_Product_Price_detail_ALL item)
    {
        try
        {
            string[] users = item.UserRespond.Split(',');
            List<string> listid = new List<string?>(); // Danh sách động, có thể thêm thoải mái

            int index = 0;
            foreach (var user in users)
            {
                if (string.IsNullOrEmpty(user))
                {

                }
                else
                {

                    Guid? inputid = await gsv.GetIdfromUser(user);
                    if (inputid != null)
                    {
                        listid.Add(inputid.ToString());
                    }

                }
            }
            string[] Idarray = listid.ToArray();
            _processingUpload_message = true;
            await Task.Delay(1);
            StateHasChanged();
           
            string noidung = "Respond Cost Request Quality Control FRQ No: " +
                _ProductPrice_KTCL_Details.MaRFQ +
                " Fee: " + ItemidtoChargeName(item.Itemid) +
                " Amount: " + (item.Thanhtien.HasValue ? item.Thanhtien.Value.ToString("#,##0.##") : "") +
                " " + item.Cur;

            if (listid != null && Idarray.Length > 0)
            {
                await _notificationService.SendNotificationAsync(Idarray, noidung);


            }
            else
            {

                CallSnackBar("User is empty!", MudBlazor.Severity.Warning);
                return;
            }

        }
        catch (Exception ex)
        {
            CallSnackBar("Somethings went wrong!, error code: " + ex.Message, MudBlazor.Severity.Error);
        }
        finally
        {
            _processingUpload_message = false;
        }
    }
    private async Task Getuser(M_Product_Price_detail_ALL item)
    {
        if (string.IsNullOrEmpty(item.UserRespond))
        {
            item.UserRespond = UserRespond;
        }
        else
        {
            item.UserRespond += "," + UserRespond + ",";
        }
    }
    private async Task<IEnumerable<string>> Search_User(string value)
    {
        if (string.IsNullOrEmpty(value))
            return ListUser;

        return ListUser.Where(x => x.Contains(value, StringComparison.InvariantCultureIgnoreCase));
    }

     private async Task GetTigia(M_Product_Price_detail_ALL item)
    {
        double? tigia_ = await Vcbsv.Getexchange_cur(item.Cur);
        item.Tigia = tigia_;
    }

}
