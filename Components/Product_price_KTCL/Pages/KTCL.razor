@using System.Globalization
@attribute [Authorize]
@inject GlobalServices gsv
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject AccountService asv
@inject SharedServices ssv
@inject BookingService bksv
@inject IJSRuntime JSRuntime
@inject SupportServices supsv
@inject IStringLocalizer<SharedResource> Localizer
@inject LocalChargesServices lcsv
@inject Bieugianangha_Services Bgnhsv
@inject CustomerService Cussv
@inject DNTUServices DNTUSV
@inject ProductPriceServices prsv;
@inject HistoryLogService HistoryLogService
@using System.Text.Json;

<style>
    .product-price-page {
        padding: 12px;
        background: linear-gradient(180deg, #f8fbff 0%, #f3f7fb 100%);
        min-height: calc(100vh - 72px);
    }

    .product-price-header {
        border-radius: 18px;
        border: 1px solid rgba(17, 138, 178, .16);
        background: #ffffff;
        box-shadow: 0 10px 28px rgba(15, 23, 42, .07);
        padding: 14px 16px;
        margin-bottom: 12px;
    }

    .product-price-title {
        font-weight: 800 !important;
        letter-spacing: .2px;
        color: #0f3557;
    }

    .product-price-subtitle {
        color: #64748b;
        font-size: 12px;
        margin-top: 2px;
    }

    .product-price-toolbar {
        gap: 8px;
        flex-wrap: wrap;
    }

        .product-price-toolbar .mud-button-root {
            border-radius: 999px !important;
            min-height: 32px;
            font-weight: 700;
            text-transform: none;
            box-shadow: 0 4px 12px rgba(15, 23, 42, .08);
        }

    .product-price-card {
        border-radius: 18px;
        border: 1px solid rgba(17, 138, 178, .14);
        overflow: hidden;
        background: #ffffff;
        box-shadow: 0 10px 28px rgba(15, 23, 42, .07);
    }

    .product-price-grid-wrap {
        padding: 10px;
    }

    .product-price-grid {
        border-radius: 14px;
        overflow: hidden;
        border: 1px solid #e2e8f0 !important;
    }

        .product-price-grid .mud-table-container {
            max-height: calc(100vh - 300px);
            min-height: 360px;
        }

        .product-price-grid .mud-table {
            font-size: 12px;
        }

            .product-price-grid .mud-table-head th,
            .product-price-grid .mud-table thead th {
                background: linear-gradient(180deg, #118ab2 0%, #0d6f91 100%) !important;
                color: #ffffff !important;
                font-weight: 800 !important;
                white-space: nowrap;
                padding: 7px 10px !important;
                border-bottom: none !important;
            }

        .product-price-grid .mud-table-row td {
            padding: 6px 10px !important;
            white-space: nowrap;
            max-width: 220px;
            overflow: hidden;
            text-overflow: ellipsis;
            border-bottom: 1px solid #eef2f7 !important;
        }

        .product-price-grid .mud-table-row:hover td {
            background-color: #eef8ff !important;
        }

        .product-price-grid .selected td,
        .product-price-grid .mud-table-row.selected td {
            background: #d8efff !important;
            color: #075985 !important;
            font-weight: 700;
            border-top: 1px solid #7dd3fc !important;
            border-bottom: 1px solid #7dd3fc !important;
        }

            .product-price-grid .selected td:first-child {
                border-left: 4px solid #0284c7 !important;
            }

        .product-price-grid .mud-checkbox .mud-icon-root {
            font-size: 18px;
        }

        .product-price-grid .mud-icon-button {
            padding: 4px !important;
            border-radius: 10px !important;
        }

        .product-price-grid .mud-input-root,
        .product-price-grid .mud-input-control {
            font-size: 12px !important;
        }

        .product-price-grid .mud-table-foot tr,
        .product-price-grid .mud-table-foot td {
            background: #f8fafc !important;
            color: #0f3557 !important;
            font-weight: 700;
        }

    .product-price-child-panel {
        margin: 8px 12px 12px 44px;
        padding: 10px;
        border-radius: 14px;
        border: 1px solid #bae6fd;
        background: #f0f9ff;
        box-shadow: inset 4px 0 0 #38bdf8;
    }

    .chart-card {
        margin-top: 12px;
        border-radius: 18px;
        border: 1px solid rgba(17, 138, 178, .14);
        background: #ffffff;
        box-shadow: 0 10px 28px rgba(15, 23, 42, .07);
        overflow: hidden;
    }

    .chart-card-header {
        padding: 12px 16px 4px 16px;
        font-weight: 800;
        color: #0f3557;
    }

    .chart-card-body {
        padding: 6px 14px 14px 14px;
    }

    .no-wrap {
        white-space: nowrap;
    }

    .text-right input {
        text-align: right !important;
    }

    .labelCustomColor label,
    .custom-label .mud-input-label {
        font-weight: 700;
        color: #118AB2 !important;
    }

    .class-dialog-custom {
        backdrop-filter: blur(10px);
        transition: none !important;
        animation: none !important;
    }

    .mud-menu {
        display: none;
    }
</style>

<PageTitle>@Localizer["Product_Price_KTCL"]</PageTitle>

<div class="product-price-page">
    <MudPaper Class="product-price-header" Elevation="0">
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Spacing="2">
            <MudStack Spacing="0">
                <MudText Typo="Typo.h6" Class="product-price-title">@Localizer["Product_Price_KTCL"]</MudText>
                <MudText Class="product-price-subtitle">Cost request quality control / quản lý báo giá kiểm tra chất lượng</MudText>
            </MudStack>

            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.FlexEnd" Class="product-price-toolbar">
                <MudButton HtmlTag="label"
                           OnClick="Refresh"
                           Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled"
                           StartIcon="@Icons.Material.Filled.Refresh">
                    @Localizer["reload"]
                </MudButton>

                <MudButton HtmlTag="label"
                           @onclick="@((e) => OpenCreateDialog(new Models.M_KTCLCostRequest()))"
                           Size="Size.Small" Color="Color.Secondary" Variant="Variant.Filled"
                           StartIcon="@Icons.Material.Filled.Add">
                    @Localizer["new"]
                </MudButton>

                <MudButton HtmlTag="label"
                           @onclick="@((e) => OpenEditDialog(detail))"
                           Size="Size.Small" Color="Color.Info" Variant="Variant.Filled"
                           StartIcon="@Icons.Material.Filled.Edit">
                    @Localizer["edit"]
                </MudButton>

                <MudButton HtmlTag="label"
                           @onclick="@(() => OpenAddDetailDialog(detail))"
                           Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled"
                           StartIcon="@Icons.Material.Filled.PlaylistAdd">
                    @Localizer["ADD_Detail"]
                </MudButton>

                <MudButton HtmlTag="label"
                           @onclick="@((e) => OpenDuplicateDialog(detail))"
                           Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled"
                           StartIcon="@Icons.Material.Filled.CopyAll">
                    @Localizer["duplicate"]
                </MudButton>
            </MudStack>
        </MudStack>
    </MudPaper>

    <MudPaper Class="product-price-card" Elevation="0">
        <div class="product-price-grid-wrap">
            <MudDataGrid T="M_KTCLCostRequest" Items="@Listdata" Filterable="true" @ref="mudTable" Class="product-price-grid" Bordered="false"
                         FilterMode="@DataGridFilterMode.ColumnFilterRow" Dense="true" Virtualize="true" QuickFilter="@FilterFunc1"
                         FixedHeader="true" FixedFooter="true" HeaderClass="no-wrap" FooterClass="no-wrap"
                         ReadOnly="false" RowClassFunc="@SelectedRowClassFunc"
                         RowClick="@RowClicked" EditDialogOptions="@options"
                         ColumnResizeMode="@(_resizeColumn ? ResizeMode.Column : ResizeMode.Container)" Loading="_loading">
                <Columns>
                    <HierarchyColumn T="M_KTCLCostRequest"></HierarchyColumn>

                    <TemplateColumn Title="" CellClass="d-flex justify-end">
                        <CellTemplate>
                            <MudIconButton Icon="@Icons.Material.Outlined.Delete"
                                           Size="Size.Small"
                                           Color="Color.Error"
                                           OnClick="@(()=>DeleteItem(context.Item))" />
                        </CellTemplate>
                    </TemplateColumn>

                    <PropertyColumn Property="x => x.MaRFQ" Title="@Localizer["MaRFQ"]" CellStyleFunc="_cellStyleFunc"></PropertyColumn>
                    <PropertyColumn Property="x => x.Tenhang" Title="@Localizer["TenHang_gs"]" CellStyleFunc="_cellStyleFunc"></PropertyColumn>
                    <PropertyColumn Property="x => x.Loaihinh" Title="@Localizer["Loaihinh"]" CellStyleFunc="_cellStyleFunc"></PropertyColumn>
                    <PropertyColumn Property="x => x.NgayYeuCau" Title="@Localizer["Ngayguiyeucau"]" Format="dd/MM/yyyy" CellStyleFunc="_cellStyleFunc"></PropertyColumn>
                    <PropertyColumn Property="x => x.Trangthai" Title="@Localizer["status"]" CellStyleFunc="_cellStyleFunc"></PropertyColumn>
                    <PropertyColumn Property="x => x.Userhandle" Title="@Localizer["Userhandle"]" CellStyleFunc="_cellStyleFunc"></PropertyColumn>

                    <TemplateColumn Title="@Localizer["Approve"]">
                        <CellTemplate>
                            <MudCheckBox @bind-Checked="context.Item.Approve"
                                         @bind-Value="context.Item.Approve"
                                         @bind-Value:after="@(()=> OnApproveCheckboxWrapper(context.Item))">
                            </MudCheckBox>
                        </CellTemplate>
                    </TemplateColumn>

                    <PropertyColumn Property="x => x.Noidung" Title="@Localizer["noidung"]" CellStyleFunc="_cellStyleFunc" Hidden="true"></PropertyColumn>
                    <PropertyColumn Property="x => x.Continued" Title="@Localizer["Continued"]" CellStyleFunc="_cellStyleFunc" Hidden="true"></PropertyColumn>
                    <PropertyColumn Property="x => x.Editable" Title="@Localizer["Editable"]" CellStyleFunc="_cellStyleFunc" Hidden="true"></PropertyColumn>
                    <PropertyColumn Property="x => x.Userupdate" Title="@Localizer["Userupdate"]" CellStyleFunc="_cellStyleFunc" Hidden="true"></PropertyColumn>
                    <PropertyColumn Property="x => x.DateUpdate" Title="@Localizer["Dateupdate"]" CellStyleFunc="_cellStyleFunc" Hidden="true"></PropertyColumn>
                    <PropertyColumn Property="x => x.CreateAt" Title="@Localizer["CreatedAt"]" CellStyleFunc="_cellStyleFunc" Hidden="true"></PropertyColumn>
                    <PropertyColumn Property="x => x.Usercreate" Title="@Localizer["Nguoilap"]" CellStyleFunc="_cellStyleFunc" Hidden="true"></PropertyColumn>
                </Columns>

                <ChildRowContent>
                    <div class="product-price-child-panel">
                        <Add_Detail_KTCL__Index _ProductPrice_KTCL_Details="context.Item" />
                    </div>
                </ChildRowContent>

                <PagerContent>
                    <MudDataGridPager T="M_KTCLCostRequest" PageSizeOptions="@(new int[] { 8, 10, 20 })" />
                </PagerContent>
            </MudDataGrid>
        </div>
    </MudPaper>

    <MudPaper Class="chart-card" Elevation="0">
        <div class="chart-card-header">Fee Chart</div>
        <div class="chart-card-body">
            <MudChart ChartType="ChartType.Bar"
                      ChartSeries="@Series"
                      XAxisLabels="@XAxisLabels"
                      Height="350px" Width="100%"
                      ChartOptions="options_chart" />
        </div>
    </MudPaper>
</div>

@code {
    List<M_KTCLCostRequest> Listdata = new List<M_KTCLCostRequest>();
    MudDataGrid<M_KTCLCostRequest> mudTable;
    AuthUser user;
    string mailtp, mailpp;
    string usr;
    private List<string> ListUser { get; set; } = new List<string>();
    string UserHanding;
    List<string> trangthais = new List<string>();
    private List<Models.TrangThai> M_Trangthais = new List<Models.TrangThai>();
    private string searchText_pol = "";
    private string searchText_pod = "";
    private List<PortModel> filteredPorts = new List<PortModel>();
    private List<PortModel> filteredPorts_pod = new List<PortModel>();
    private List<PortModel> Ports = new List<PortModel>();
    private bool _resizeColumn;
    M_KTCLCostRequest detail;
    private List<Models.M_Customer> CustomerList = new List<Models.M_Customer>();
    private List<M_DNTT_Logistics> DNTTs = new List<M_DNTT_Logistics>();
    public CultureInfo _en = CultureInfo.GetCultureInfo("en-US");
    private List<M_Product_Price_detail_ALL> M_details_Alls = new List<M_Product_Price_detail_ALL>();
    private List<M_Product_Price_detail_ALL> List_detail = new List<M_Product_Price_detail_ALL>();
    private List<ChargeModel> List_Charge = new List<ChargeModel>();

    public List<ChartSeries> Series = new List<ChartSeries>
    {
        new ChartSeries() { Name = "Fee", Data = new double[] { } }
    };
    public string[] XAxisLabels = { };

    protected async override Task OnInitializedAsync()
    {
        CustomerList = await Cussv.GetList();
        M_Trangthais = await supsv.GetListTrangThai();
        var tts = await supsv.GetListTrangThai();
        trangthais = tts.Where(x => x.Tieude == "ProductPrice").OrderBy(x => x.Noidung).Select(x => x.Noidung).ToList();
        DNTTs = DNTUSV.GetListDNTT_all();
        List_Charge = await supsv.GetListCharge();
        ListUser = await asv.GetList_User_handle() ?? new List<string>();
        usr = asv.GetAuth().Result.User.Identity!.Name!;

        // await Refresh();
    }

    string CustomerName(Guid? iddntt)
    {
        var rs = DNTTs.FirstOrDefault(x => x.Id == iddntt);
        return rs != null ? rs.So! : "";
    }

    bool _loading = false;
    async Task Refresh()
    {
        try
        {
            detail = null!;
            _loading = true;
            Listdata.Clear();

            await Task.Delay(500);
            if (!await ssv.CheckPermission(usr, "View", "Product_Price_KTCL"))
            {
                CallSnackBar("You have not access to view", MudBlazor.Severity.Warning);
                return;
            }

            Listdata = await prsv.GetProduct_Price_KTCL();
            await GetChart();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            CallSnackBar("Something went wrong!, error code: " + ex.Message, MudBlazor.Severity.Warning);
        }
        finally
        {
            _loading = false;
        }
    }

    void CallSnackBar(string message, MudBlazor.Severity severity)
    {
        Snackbar.Clear();
        Snackbar.Configuration.SnackbarVariant = Variant.Filled;
        Snackbar.Configuration.MaxDisplayedSnackbars = 3;
        Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopRight;
        Snackbar.Add(message, severity);
    }

    void RowClicked(DataGridRowClickEventArgs<M_KTCLCostRequest> args)
    {
        detail = args.Item;
    }

    private int selectedRowNumber = -1;
    private string SelectedRowClassFunc(M_KTCLCostRequest m, int rowNumber)
    {
        if (selectedRowNumber == rowNumber)
        {
            selectedRowNumber = -1;
            return string.Empty;
        }
        else if (mudTable.SelectedItem != null && mudTable.SelectedItem.Equals(m))
        {
            selectedRowNumber = rowNumber;
            return "selected";
        }
        else
        {
            return string.Empty;
        }
    }

    int? index_no;

    async Task DeleteItem(M_KTCLCostRequest item)
    {
        if (item.Approve == true)
        {
            CallSnackBar("Data đã được Approve!!! , vui lòng bỏ Approve", MudBlazor.Severity.Warning);
            return;
        }

        if (!await ssv.CheckPermission(usr, "Delete", "Product_Price_KTCL"))
        {
            CallSnackBar("You have not access to Delete", MudBlazor.Severity.Warning);
            return;
        }

        var resultMess = await DialogService.ShowMessageBox(
                "Warning",
                "Deleting can not be undone!",
                yesText: "Delete!", cancelText: "Cancel");

        if (resultMess.HasValue)
        {
            var rs = await prsv.DeleteProductPrice_KTCL(item);
            await prsv.DeleteDetail_All(item.Id);

            await HistoryLogService.LogAsync(usr, "Delete", "Product_Price_KTCL", item.Id, item.MaRFQ, new { OldData = item });
            CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
            await Refresh();
        }
    }

    DialogOptions options = new DialogOptions
    {
        ClassBackground = "class-dialog-custom",
        FullWidth = true,
        MaxWidth = MaxWidth.Medium,
        CloseOnEscapeKey = false,
        DisableBackdropClick = true
    };

    string search;

    private bool FilterFunc1(M_KTCLCostRequest sbd) => FilterFunc(sbd, search);

    private bool FilterFunc(M_KTCLCostRequest sbd, string searchString)
    {
        if (string.IsNullOrWhiteSpace(sbd.MaRFQ))
            return true;
        if (string.IsNullOrWhiteSpace(searchString))
            return true;
        if (sbd.MaRFQ!.Contains(searchString, StringComparison.OrdinalIgnoreCase))
            return true;
        if ($"{sbd.MaRFQ} ".Contains(searchString))
            return true;
        return false;
    }

    private Func<M_KTCLCostRequest, string> _cellStyleFunc => x =>
    {
        string style = "";

        if (string.IsNullOrEmpty(x.Trangthai))
            return "color: #000000";

        var rs = M_Trangthais
        .Where(t => (t.Noidung).Contains(x.Trangthai, StringComparison.InvariantCultureIgnoreCase)
            && t.Tieude.Equals("ProductPrice", StringComparison.InvariantCultureIgnoreCase))
        .Select(t => t.Mamau)
        .FirstOrDefault();

        return "color: " + rs;
    };

    private async Task OpenCreateDialog(Models.M_KTCLCostRequest tr)
    {
        var optionsdialog = new DialogOptions { ClassBackground = "class-dialog-custom", FullWidth = true, MaxWidth = MaxWidth.Medium };

        if (await ssv.CheckPermission(asv.GetAuth().Result.User.Identity.Name, "Add", "Product_Price_KTCL"))
        {
            DialogOptions closeOnEscapeKey = new DialogOptions() { CloseOnEscapeKey = true };
            var parameters = new DialogParameters<Add_KTCL> { { x => x._ProductPrice_KTCL_Details, tr }, { x => x.Status, "add" } };

            var dialog = await DialogService.ShowAsync<Add_KTCL>(tr.Id == Guid.Empty ? "Cost Request Quality Control Create" : "Cost Request Quality Control Edit", parameters, optionsdialog);
            var result = await dialog.Result;

            if (!result.Canceled)
            {
                var data = (M_KTCLCostRequest)result.Data;
                var rs = await prsv.UpdateCreateProduct_KTCL(data);
                await HistoryLogService.LogAsync(usr, "ADD", "Product_Price_KTCL", data.Id, data.MaRFQ, data);

                MudBlazor.Severity severity;
                if (rs[1] == "1")
                    severity = MudBlazor.Severity.Success;
                else
                    severity = MudBlazor.Severity.Error;

                CallSnackBar(rs[0], severity);

                await HandleRefresh_create(data.Id);
            }

            return;
        }
        else
        {
            CallSnackBar("You have not access to Create", MudBlazor.Severity.Warning);
            return;
        }
    }

    async Task HandleRefresh_create(Guid? id)
    {
        try
        {
            detail = null;

            if (Listdata != null)
            {
                Listdata.Clear();
            }

            await Task.Delay(500);

            if (!await ssv.CheckPermission(asv.GetAuth().Result.User.Identity.Name, "View", "Product_Price_KTCL"))
            {
                CallSnackBar("You have not access to view", MudBlazor.Severity.Warning);
                return;
            }

            Listdata = await prsv.GetProduct_price_KTCL_create(id);
            StateHasChanged();
        }
        finally
        {
        }
    }

    private async Task OpenEditDialog(Models.M_KTCLCostRequest tr)
    {
        var optionsdialog = new DialogOptions { ClassBackground = "class-dialog-custom", FullWidth = true, MaxWidth = MaxWidth.Medium };

        if (tr == null)
        {
            CallSnackBar("Please select Data", MudBlazor.Severity.Warning);
            return;
        }

        if (tr.Approve == true)
        {
            CallSnackBar("Data đã được Approve!!! , vui lòng bỏ Approve", MudBlazor.Severity.Warning);
            return;
        }

        if (await ssv.CheckPermission(asv.GetAuth().Result.User.Identity.Name, "Edit", "Product_Price_KTCL"))
        {
            var OldData = JsonSerializer.Deserialize<M_KTCLCostRequest>(JsonSerializer.Serialize(tr));
            DialogOptions closeOnEscapeKey = new DialogOptions() { CloseOnEscapeKey = true };
            var parameters = new DialogParameters<Add_KTCL> { { x => x._ProductPrice_KTCL_Details, tr }, { x => x.Status, "edit" } };

            var dialog = await DialogService.ShowAsync<Add_KTCL>(tr.Id == Guid.Empty ? "Cost Request Quality Control Edit" : "Cost Request Quality Control Edit", parameters, optionsdialog);
            var result = await dialog.Result;

            selectedRowNumber = selectedRowNumber;
            StateHasChanged();

            if (!result.Canceled)
            {
                var data = (M_KTCLCostRequest)result.Data;
                var rs = await prsv.UpdateCreateProduct_KTCL(data);
                await HistoryLogService.LogAsync(usr, "Update", "Product_Price_KTCL", data.Id, data.MaRFQ, new { OldData = OldData, NewData = data });

                MudBlazor.Severity severity;
                if (rs[1] == "1")
                    severity = MudBlazor.Severity.Success;
                else
                    severity = MudBlazor.Severity.Error;

                CallSnackBar(rs[0], severity);
            }

            return;
        }
        else
        {
            CallSnackBar("You have not access to Edit", MudBlazor.Severity.Warning);
            return;
        }
    }

    private async Task OpenAddDetailDialog(Models.M_KTCLCostRequest tr)
    {
        var optionsdialog = new DialogOptions { ClassBackground = "class-dialog-custom", FullWidth = true, MaxWidth = MaxWidth.ExtraExtraLarge };

        if (tr == null)
        {
            CallSnackBar("Please select Data", MudBlazor.Severity.Warning);
            return;
        }

        if (tr.Approve == true)
        {
            CallSnackBar("Data đã được Approve!!! , vui lòng bỏ Approve", MudBlazor.Severity.Warning);
            return;
        }

        if (await ssv.CheckPermission(asv.GetAuth().Result.User.Identity.Name, "Add", "Product_Price_KTCL"))
        {
            DialogOptions closeOnEscapeKey = new DialogOptions() { CloseOnEscapeKey = true };
            var parameters = new DialogParameters<Add_Detail_KTCL> { { x => x._ProductPrice_KTCL_Details, tr }, { x => x.Status, "edit" } };

            var dialog = await DialogService.ShowAsync<Add_Detail_KTCL>(tr.Id == Guid.Empty ? "Add Detail Cost Request Quality Control" : "Add Detail Cost Request Quality Control", parameters, optionsdialog);
            var result = await dialog.Result;

            selectedRowNumber = selectedRowNumber;
            StateHasChanged();

            if (!result.Canceled)
            {
                var data = (M_KTCLCostRequest)result.Data;
                var rs = await prsv.UpdateCreateProduct_KTCL(data);

                MudBlazor.Severity severity;
                if (rs[1] == "1")
                    severity = MudBlazor.Severity.Success;
                else
                    severity = MudBlazor.Severity.Error;

                CallSnackBar(rs[0], severity);
            }

            return;
        }
        else
        {
            CallSnackBar("You have not access to Create", MudBlazor.Severity.Warning);
            return;
        }
    }

    private async Task OpenDuplicateDialog(Models.M_KTCLCostRequest tr)
    {
        Guid id_temp = tr.Id;
        var optionsdialog = new DialogOptions { ClassBackground = "class-dialog-custom", FullWidth = true, MaxWidth = MaxWidth.Medium };

        if (tr == null)
        {
            CallSnackBar("Please select Data", MudBlazor.Severity.Warning);
            return;
        }

        if (await ssv.CheckPermission(asv.GetAuth().Result.User.Identity.Name, "Add", "Product_Price_KTCL"))
        {
            var OldData = JsonSerializer.Deserialize<M_KTCLCostRequest>(JsonSerializer.Serialize(tr));
            DialogOptions closeOnEscapeKey = new DialogOptions() { CloseOnEscapeKey = true };
            var parameters = new DialogParameters<Add_KTCL> { { x => x._ProductPrice_KTCL_Details, tr }, { x => x.Status, "Duplicate" } };

            var dialog = await DialogService.ShowAsync<Add_KTCL>(tr.Id == Guid.Empty ? "Cost Request Quality Control Create" : "Cost Request Quality Control Create", parameters, optionsdialog);
            var result = await dialog.Result;

            selectedRowNumber = selectedRowNumber;
            StateHasChanged();

            if (!result.Canceled)
            {
                var data = (M_KTCLCostRequest)result.Data;
                var rs = await prsv.UpdateCreateProduct_KTCL(data);
                await HistoryLogService.LogAsync(usr, "Duplicate", "Product_Price_KTCL", data.Id, data.MaRFQ, new { OldData = OldData, NewData = data });

                MudBlazor.Severity severity;
                if (rs[1] == "1")
                    severity = MudBlazor.Severity.Success;
                else
                    severity = MudBlazor.Severity.Error;

                CallSnackBar(rs[0], severity);

                if (rs[1] == "1")
                {
                    M_details_Alls = await prsv.GetListProductPriceDetails_ALL(id_temp);
                    foreach (var item in M_details_Alls)
                    {
                        item.Id = Guid.Empty;
                        item.RFQ_Id = tr.Id;
                        item.Ngaybaogia = DateTime.Now;
                        item.Createat = DateTime.Now.ToString();
                        var UserName = asv.GetAuth().Result.User.Identity!.Name!;
                        item.Usercreate = UserName;
                        item.Userupdate = UserName;
                        item.Dateupdate = DateTime.Now.ToString("dd/MMM/yyyy");
                        item.Continued = true;
                        item.Editable = true;
                        item.Approve = false;
                        await prsv.UpdateCreateProduct_Detail_truck(item);
                    }
                }

                await HandleRefresh_create(data.Id);
            }

            return;
        }
        else
        {
            CallSnackBar("You have not access to Create", MudBlazor.Severity.Warning);
            return;
        }
    }

    private async Task OnApproveCheckboxWrapper(M_KTCLCostRequest item)
    {
        if (await ssv.CheckPermission(asv.GetAuth().Result.User.Identity.Name, "Approve", "Product_Price_KTCL"))
        {
            var rs = await prsv.UpdateCreateProduct_KTCL(item);

            MudBlazor.Severity severity;
            if (rs[1] == "1")
                severity = MudBlazor.Severity.Success;
            else
                severity = MudBlazor.Severity.Error;

            CallSnackBar(rs[0], severity);
        }
        else
        {
            CallSnackBar("You have not access to Approve", MudBlazor.Severity.Warning);
            return;
        }
    }

    private ChartOptions options_chart = new ChartOptions
    {
        YAxisFormat = "#,##0"
    };

    public async Task GetChart()
    {
        List_detail = await prsv.GetProduct_Price_Detail_ByType("KTCL");

        if (List_detail.Count == 0)
        {
            CallSnackBar("No Data Chart", MudBlazor.Severity.Warning);
            return;
        }

        List_Charge = await supsv.GetListCharge();

        var xLabels = new[]
        {
            "",
            "",
            ""
        };

        var chartData = List_detail
             .GroupBy(x => x.Itemid)
             .Select(g =>
             {
                 var itemName = List_Charge.FirstOrDefault(c => c.CHARGE_ID == g.Key)?.CHARGE ?? $"Unknown ({g.Key})";

                 double totalAmount = g.Sum(x => x.Cur == "USD"
                     ? Convert.ToDouble((x.Thanhtien ?? 0) * (x.Tigia ?? 1))
                     : Convert.ToDouble(x.Thanhtien ?? 0));

                 return new
                 {
                     ItemName = itemName,
                     TotalAmount = totalAmount
                 };
             }).ToList();

        XAxisLabels = chartData.Select(x => x.ItemName).ToArray();

        Series = chartData.Select(x => new ChartSeries
        {
            Name = x.ItemName,
            Data = new double[] { 0, x.TotalAmount, 0 }
        }).ToList();

        XAxisLabels = new string[] { "" };
    }
