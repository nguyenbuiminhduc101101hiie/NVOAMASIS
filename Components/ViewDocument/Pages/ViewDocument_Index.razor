@inject IStringLocalizer<SharedResource> Localizer
@inject ISnackbar Snackbar

<div class="view-doc-page">
    <MudPaper Class="pa-4 view-doc-shell" Elevation="0">
        <MudStack Spacing="1" Class="mb-3">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                <MudIcon Icon="@Icons.Material.Filled.FindInPage" Color="Color.Primary" />
                <MudText Typo="Typo.h6" Class="view-doc-title">@Localizer["View Document"]</MudText>
            </MudStack>
            <MudText Typo="Typo.body2" Class="view-doc-subtitle">
                Nhập một (hoặc nhiều) thông tin: Job No, MBL, HBL, Booking, Container — sau đó chọn giao diện muốn mở.
            </MudText>
        </MudStack>

        <MudGrid Spacing="2">
            <MudItem xs="12" sm="6" md="4">
                <MudTextField @bind-Value="_jobNo"
                              Label="Job No"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Work"
                              Clearable="true" />
            </MudItem>
            <MudItem xs="12" sm="6" md="4">
                <MudTextField @bind-Value="_mbl"
                              Label="MBL No"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.DirectionsBoat"
                              Clearable="true" />
            </MudItem>
            <MudItem xs="12" sm="6" md="4">
                <MudTextField @bind-Value="_hbl"
                              Label="HBL No"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Description"
                              Clearable="true" />
            </MudItem>
            <MudItem xs="12" sm="6" md="4">
                <MudTextField @bind-Value="_bk"
                              Label="Booking No"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.BookOnline"
                              Clearable="true" />
            </MudItem>
            <MudItem xs="12" sm="6" md="4">
                <MudTextField @bind-Value="_container"
                              Label="Container No"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.ViewInAr"
                              Clearable="true" />
            </MudItem>
            <MudItem xs="12" sm="6" md="4">
                <MudSelect T="string"
                           @bind-Value="_targetView"
                           Label="Mở trên giao diện"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           AdornmentIcon="@Icons.Material.Filled.OpenInNew"
                           Adornment="Adornment.Start">
                    <MudSelectItem Value="@("2.1")">2.1 @Localizer["Shipment"]</MudSelectItem>
                    <MudSelectItem Value="@("5.0")">5.0 @Localizer["Shipment"]</MudSelectItem>
                    <MudSelectItem Value="@("6.0")">6.0 @Localizer["Shipment"]</MudSelectItem>
                </MudSelect>
            </MudItem>
        </MudGrid>

        <MudStack Row="true" Spacing="2" Class="mt-4" AlignItems="AlignItems.Center">
            <MudButton OnClick="OpenShipment"
                       Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Search"
                       Class="view-doc-btn">
                Mở lô hàng
            </MudButton>
            <MudButton OnClick="ClearAll"
                       Variant="Variant.Outlined"
                       Color="Color.Default"
                       StartIcon="@Icons.Material.Filled.ClearAll"
                       Class="view-doc-btn">
                Xóa
            </MudButton>
            <MudSpacer />
            @if (HasAnyInput())
            {
                <MudChip T="string" Color="Color.Info" Variant="Variant.Outlined" Size="Size.Small">
                    @ActiveFiltersText()
                </MudChip>
            }
        </MudStack>
    </MudPaper>
</div>

<style>
    .view-doc-page {
        padding: 16px;
    }

    .view-doc-shell {
        border-radius: 16px;
        border: 1px solid #e2e8f0;
        background: linear-gradient(135deg, #ffffff 0%, #f8fbff 100%);
        box-shadow: 0 12px 32px rgba(15, 23, 42, 0.06);
    }

    .view-doc-title {
        font-weight: 800 !important;
        color: #0f172a !important;
    }

    .view-doc-subtitle {
        color: #64748b !important;
    }

    .view-doc-btn.mud-button-root {
        text-transform: none;
        font-weight: 700;
        border-radius: 999px;
        padding: 6px 18px;
    }
</style>

@code {
    [Parameter] public EventCallback<(string Key, string Title, RenderFragment Content)> OnTabRequest { get; set; }

    private string? _jobNo;
    private string? _mbl;
    private string? _hbl;
    private string? _bk;
    private string? _container;
    private string _targetView = "2.1";

    private bool HasAnyInput()
        => !string.IsNullOrWhiteSpace(_jobNo)
        || !string.IsNullOrWhiteSpace(_mbl)
        || !string.IsNullOrWhiteSpace(_hbl)
        || !string.IsNullOrWhiteSpace(_bk)
        || !string.IsNullOrWhiteSpace(_container);

    private string ActiveFiltersText()
    {
        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(_jobNo)) parts.Add($"Job: {_jobNo}");
        if (!string.IsNullOrWhiteSpace(_mbl)) parts.Add($"MBL: {_mbl}");
        if (!string.IsNullOrWhiteSpace(_hbl)) parts.Add($"HBL: {_hbl}");
        if (!string.IsNullOrWhiteSpace(_bk)) parts.Add($"BK: {_bk}");
        if (!string.IsNullOrWhiteSpace(_container)) parts.Add($"Cont: {_container}");
        return string.Join(" • ", parts);
    }

    private async Task OpenShipment()
    {
        if (!HasAnyInput())
        {
            Snackbar.Add("Vui lòng nhập ít nhất một thông tin: Job/MBL/HBL/BK/Container.", MudBlazor.Severity.Warning);
            return;
        }

        if (!OnTabRequest.HasDelegate)
        {
            Snackbar.Add("Không mở được tab. Thiếu OnTabRequest callback.", MudBlazor.Severity.Warning);
            return;
        }

        Type componentType;
        string viewLabel;
        string viewPrefix;
        switch (_targetView)
        {
            case "5.0":
                componentType = typeof(Components.Shipment.Pages.Payment.Shipment_5_0_Index);
                viewPrefix = "Shipment5.0_VD";
                viewLabel = $"5.0 {Localizer["Shipment"]}";
                break;
            case "6.0":
                componentType = typeof(Components.Shipment.Pages.TaskNav.Shipment_6_0_Index);
                viewPrefix = "Shipment6.0_VD";
                viewLabel = $"6.0 {Localizer["Shipment"]}";
                break;
            default:
                componentType = typeof(Components.Shipment.Pages.ShipmentIndex);
                viewPrefix = "Shipment2.1_VD";
                viewLabel = $"2.1 {Localizer["Shipment"]}";
                break;
        }

        var jobNo = _jobNo?.Trim();
        var mbl = _mbl?.Trim();
        var hbl = _hbl?.Trim();
        var bk = _bk?.Trim();
        var container = _container?.Trim();

        RenderFragment content = builder =>
        {
            builder.OpenComponent(0, componentType);
            builder.AddAttribute(1, "InitialJobNo", jobNo);
            builder.AddAttribute(2, "InitialMBL", mbl);
            builder.AddAttribute(3, "InitialHBL", hbl);
            builder.AddAttribute(4, "InitialBK", bk);
            builder.AddAttribute(5, "InitialContainer", container);
            builder.CloseComponent();
        };

        var key = $"{viewPrefix}_{ActiveFiltersText().GetHashCode():X}";
        await OnTabRequest.InvokeAsync((key, viewLabel, content));
    }

    private void ClearAll()
    {
        _jobNo = _mbl = _hbl = _bk = _container = null;
    }
}
