@using System.Globalization
@inject ISnackbar Snackbar
@inject AccountService asv
@inject TrainScheduleServices trainsv
@inject IStringLocalizer<SharedResource> Localizer
@inject SharedServices ssv
@inject LocalChargesServices lcsv
@inject LenhDieuXeServices ldxsv
@inject SupportServices supsv
@inject YeuCauTruckingServices yctsv
@inject GlobalServices gsv
@inject IJSRuntime JSRuntime
@inject NotificationService _notificationService

<MudDialog>
    <DialogContent>
        <MudSpacer></MudSpacer>
        <MudContainer>

            <MudCard>
                <MudForm Model="@_YeuCauTrucking_Detail" @ref="@form">
                    <MudCardContent>
                      
                        <MudGrid>

                            
                                <div style="background-color: lightcyan;" class="border border-solid mud-border-primary pa-4">
                                  
                                    <MudGrid>

                                        <MudItem xs="1">
                                            <MudButton Style="background-color: #007BFF; color: white;" Size="Size.Small" Color="Color.Primary"
                                            Disabled="@(Status == "edit")"
                                                       OnClick="() => GetT_YCTruckingNo()">>>></MudButton>
                                        </MudItem>

                                        <MudItem xs="7">
                                        <MudTextField @bind-Value="_YeuCauTrucking_Detail.YeuCauTruckingNo" Disabled="true" Label="@Localizer["yeucautruckingno"]" Required="true" />
                                        </MudItem>
                                        <MudItem xs="4">
                                        <MudTextField @bind-Value="_YeuCauTrucking_Detail.Nguoiyeucau" Label="@Localizer["nguoiyeucau"]" Disabled="true" Required="true" />
                                        </MudItem>

                                        <MudItem xs="12">
                                        <MudTextField @bind-Value="_YeuCauTrucking_Detail.TieuDeEmail" Lines="3" AutoGrow Label="@Localizer["tieudeemail"]" class="custom-label" Required="false" />
                                        </MudItem>
                                        <MudItem xs="12">
                                        <MudTextField @bind-Value="_YeuCauTrucking_Detail.NoidungEmail" Lines="3" AutoGrow Label="@Localizer["noidung"]" class="custom-label" Required="false" />
                                        </MudItem>

                                   
                                        <MudItem xs="12">
                                        <MudTextField @bind-Value="_YeuCauTrucking_Detail.NoidungChitietEmail" Lines="3" AutoGrow Label="@Localizer["chitietnoidung"]" class="custom-label" Required="false" />
                                        </MudItem>
                                 
                                        <MudItem xs="2">
                                            <MudAutocomplete Class="pl-4 labelCustomColor custom-label" T="string"
                                                             @bind-Value="UserHanding"
                                                         Label="@Localizer["emailnguoiphutrach"]"
                                                             SearchFunc="Search_User"
                                                             Immediate="true"
                                                             CoerceText="true"
                                                             Clearable="true"
                                                             MaxItems="100">
                                            </MudAutocomplete>
                                        </MudItem>
                                   
                                         <MudItem xs="1">
                                            <MudButton Class="pl-4 labelCustomColor" Style="background-color: #007BFF; color: white;" Size="Size.Small" Color="Color.Primary"
                                            OnClick="() => Getuser()">>>></MudButton>
                                        </MudItem>

                                        <MudItem xs="3">
                                            <MudTextField @bind-Value="_YeuCauTrucking_Detail.Nguoitraloi" class="custom-label" HelperTextOnFocus HelperText="từ 2 mail trở lên vui lòng ngăn cách bằng dấu ','"
                                                      Lines="3" AutoGrow Label="@Localizer["emailnguoiphutrach"]" Required="false" />
                                        </MudItem>

                                      <MudItem xs="2">
                                            <MudButton HtmlTag="label" Disabled="_processingUpload"
                                                       @onclick="@(() => SendMailnotify())"
                                                       Size="Size.Small" Color="Color.Tertiary" Variant="Variant.Filled"
                                                       StartIcon="@Icons.Material.Filled.Email">
                                                @if (_processingUpload)
                                                {
                                                    <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                                                    <MudText Class="ms-2">Processing</MudText>
                                                }
                                                else
                                                {
                                                <MudText>@Localizer["sendemail"]</MudText>
                                                }
                                            </MudButton>
                                        </MudItem>

                                        <MudItem xs="2">
                                              <MudButton HtmlTag="label" Disabled="_processingUploadzalo"
                                                        @onclick="@(() => SendZalonotify())"
                                                        Size="Size.Small" Color="Color.Tertiary" Variant="Variant.Filled"
                                                        StartIcon="@Icons.Material.Filled.Send">
                                                @if (_processingUploadzalo)
                                                {
                                                    <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                                                    <MudText Class="ms-2">Processing</MudText>
                                                }
                                                else
                                                {
                                                <MudText>@Localizer["sendzalo"]</MudText>
                                                }
                                            </MudButton>
                                        </MudItem>

                                    <MudItem xs="2">
                                        <MudButton HtmlTag="label" Disabled="_processingUpload_message"
                                                   @onclick="@(() => SendMessage(_YeuCauTrucking_Detail))"
                                                   Size="Size.Small" Color="Color.Tertiary" Variant="Variant.Filled"
                                                   StartIcon="@Icons.Material.Filled.Email">
                                            @if (_processingUpload_message)
                                            {
                                                <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                                                <MudText Class="ms-2">Processing</MudText>
                                            }
                                            else
                                            {
                                                <MudText>@Localizer["message"]</MudText>
                                            }
                                        </MudButton>
                                    </MudItem>

                                    </MudGrid>

                                </div>
  
                        </MudGrid>

                        <MudGrid>
                            <MudItem>

                            </MudItem>
                        </MudGrid>
                        <MudGrid>
                            <MudCard Class="border border-solid mud-border-primary pa-4">
                                <MudCardContent>
                                    <MudGrid>
                                        <MudItem xs="12">
                                            <MudGrid>
                                                <MudItem xs="4">
                                                    <MudAutocomplete @bind-Value="_YeuCauTrucking_Detail.DiaDiemNhanHang" Label="@Localizer["diadiemgiaohang"]"
                                                                     class="custom-label" Required
                                                        SearchFunc="Searchpol" />
                                                </MudItem>

                                                <MudItem xs="4">
                                                    <MudAutocomplete @bind-Value="_YeuCauTrucking_Detail.DiaDiemTraHang" Label="@Localizer["diadiemnhanhang"]" class="custom-label" Required
                                                                     SearchFunc="Searchpod" />
                                                </MudItem>

                                                <MudItem xs="4">
                                                    <MudTextField @bind-Value="_YeuCauTrucking_Detail.LoaiCont" Label="@Localizer["loaicont"]" class="custom-label" Required="false" />
                                                </MudItem>

                                                <MudItem xs="4">
                                                    <MudDatePicker @bind-Date="_YeuCauTrucking_Detail.NgayDukienLayHang" class="custom-label"
                                                                   Label="@Localizer["Ngaylayhang"]"
                                                                   Required="true" />
                                                </MudItem>

                                
                                                <MudItem xs="4">
                                                    <MudDatePicker @bind-Date="_YeuCauTrucking_Detail.NgayDuKienTraHang" class="custom-label"
                                                                   Label="@Localizer["Ngaytrahang"]"
                                                                   Required="true" />
                                                </MudItem>
                                                <MudItem xs="4">
                                                    <MudSelect @bind-Value="_YeuCauTrucking_Detail.Trangthai" Label="@Localizer["status"]" class="custom-label">
                                                        @foreach (var item in trangthais)
                                                        {
                                                            <MudSelectItem Value="item">@item</MudSelectItem>
                                                        }
                                                    </MudSelect>
                                                </MudItem>
                                                <MudItem xs="12">
                                                    <MudTextField @bind-Value="_YeuCauTrucking_Detail.GhiChu" Label="@Localizer["ghichu"]" InputType="InputType.Text" Lines="3"
                                                                  class="custom-label" />
                                                </MudItem>

                                                <MudItem xs="12">
                                                    <MudStack Row>
                                                        <MudContainer Class="pa-4; max-height:200px; overflow-y: auto; custom-label;">
                                                            <MudText class="custom-label" Typo="Typo.h6">@Localizer["Linkhinhanh"]</MudText>
                                                            @foreach (var item in Linksplit(_YeuCauTrucking_Detail.Links!))
                                                            {
                                                                <MudPaper Elevation="3" Style="position: relative; display: inline-block;">
                                                                    <MudImage Src="@item.Replace("ftp","http")" Alt="@item.Replace("ftp","http")"
                                                                              Height="150" Elevation="25" Class="rounded-lg ma-4" />

                                                                    <MudIconButton Icon="@Icons.Material.Filled.Visibility" OnClick="@(() => SeeDetail(item))"
                                                                                   Style="position: absolute; top: 5px; left: 5px; padding: 0; min-width: 0;" />

                                                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error"
                                                                                   OnClick="@(() => Deleteimg(_YeuCauTrucking_Detail,item))"
                                                                                   Style="position: absolute; top: 5px; right: 5px; padding: 0; min-width: 0;" />
                                                                </MudPaper>
                                                            }
                                                        </MudContainer>

                                                        <MudFileUpload T="IBrowserFile" Accept=".png,.jpg,.jpeg" FilesChanged="@((t) => AttachFileToFTP(t,_YeuCauTrucking_Detail))">
                                                            <ButtonTemplate Context="context1">
                                                                <MudIconButton HtmlTag="label" for="@context1" Size="Size.Small" Color="Color.Secondary"
                                                                               Icon="@Icons.Material.Filled.AttachFile" />
                                                            </ButtonTemplate>
                                                        </MudFileUpload>

                                                    </MudStack>
                                                </MudItem>
                                            </MudGrid>
                                        </MudItem>


                                    </MudGrid>
                                </MudCardContent>
                            </MudCard>
                        </MudGrid>
                    </MudCardContent>
                </MudForm>

            </MudCard>
        </MudContainer>
    </DialogContent>
    <DialogActions>

        <MudButton OnClick="@(async () => await Submit())">Save</MudButton>
        <MudButton OnClick="Cancel">Cancel</MudButton>

    </DialogActions>
</MudDialog>



@code {
    [CascadingParameter] MudDialogInstance? MudDialog { get; set; }
    [Parameter] public Models.M_YeuCauTrucking _YeuCauTrucking_Detail { get; set; }

    [Parameter] public string Status { get; set; }
    MudForm form;
    private string searchCarr = "";
    private string NumCrew { get; set; }
    private List<M_Customer> filteredCarr = new List<M_Customer>();
    private List<M_Customer> Cuss_Carr = new List<M_Customer>();
    public CultureInfo _de = CultureInfo.GetCultureInfo("de-DE");
    public CultureInfo _en = CultureInfo.GetCultureInfo("en-US");
    private List<M_Customer> List_nvdieuxe = new List<M_Customer>();
    private List<M_Customer> List_Taixe = new List<M_Customer>();
    private List<M_Customer> List_Phuxe = new List<M_Customer>();
    private List<M_Customer> List_Nhaxe = new List<M_Customer>();
    private List<M_Customer> List_soxe = new List<M_Customer>();
    private List<PortModel> List_pod = new List<PortModel>();
    private List<PortModel> List_pol = new List<PortModel>();
       List<string> trangthais = new List<string>();
    private List<string> ListUser { get; set; } = new List<string>();
    private List<Models.TrangThai> M_Trangthais = new List<Models.TrangThai>();
    string UserHanding;
    string usr;
    protected async override Task OnInitializedAsync()
    {
        if(Status =="add"){
            _YeuCauTrucking_Detail.Nguoiyeucau = asv.GetAuth().Result.User.Identity!.Name!;
        }
        if (Status == "Duplicate")
        {
            _YeuCauTrucking_Detail.Nguoiyeucau = asv.GetAuth().Result.User.Identity!.Name!;
            _YeuCauTrucking_Detail.YeuCauTruckingID = Guid.Empty;
            _YeuCauTrucking_Detail.Approve = false;
            _YeuCauTrucking_Detail.YeuCauTruckingNo = "";
        }

        Cuss_Carr = await lcsv.GetList_Customer_line();
        List_nvdieuxe = await ldxsv.GetList_Cus_Personal();
        List_Taixe = await ldxsv.GetList_Cus_Driver();
        List_Phuxe = await ldxsv.GetList_Cus_Driver();
        List_Nhaxe = await ldxsv.GetList_Cus_Personal();
        List_soxe = await ldxsv.GetList_Cus_Trucking();
        List_pol = await ldxsv.GetList_port();
        List_pod = await ldxsv.GetList_port();
        M_Trangthais = await supsv.GetListTrangThai();
        var tts = await supsv.GetListTrangThai();
        trangthais = tts.Where(x => x.Tieude == "YeuCauTrucking").OrderBy(x => x.Noidung).Select(x => x.Noidung).ToList();
        ListUser = await asv.GetList_User_handle() ?? new List<string>();
        usr = asv.GetAuth().Result.User.Identity!.Name!;
        if (Status == "add")
        {
            // _YeuCauTrucking_Detail.Index_ = await lcsv.Get_index();
        }

    }
    private async Task Getuser()
    {
        if (string.IsNullOrEmpty(_YeuCauTrucking_Detail.Nguoitraloi))
        {
            _YeuCauTrucking_Detail.Nguoitraloi = UserHanding;
        }
        else
        {
            _YeuCauTrucking_Detail.Nguoitraloi += "," + UserHanding + ",";
        }
    }
    private async Task<IEnumerable<string>> Search_User(string value)
    {
        if (string.IsNullOrEmpty(value))
            return ListUser;

        return ListUser.Where(x => x.Contains(value, StringComparison.InvariantCultureIgnoreCase));
    }
   

    private async Task GetT_YCTruckingNo()
    {

        int formattedYear = DateTime.Now.Year;
        int formattedMonth = DateTime.Now.Month;

        string usr = asv.GetAuth().Result.User.Identity!.Name!;
        var refno = await supsv.GetRefNoByFunc("YeuCauTrucking", formattedMonth, formattedYear, usr);

        var rs = asv.GetUserDetail();
        var cn = rs.Branch;
        _YeuCauTrucking_Detail.YeuCauTruckingNo = cn + "YCTrucking_" + formattedYear.ToString() + formattedMonth.ToString() + refno.Value.ToString("D4");

    }
    List<string> Linksplit(string links)
    {
        if (string.IsNullOrEmpty(links))
            return new List<string>();
        return links.Split(';').ToList();
    }

       async Task SeeDetail(string link)
    {

        await JSRuntime.InvokeVoidAsync("open", link.Replace("ftp", "http"), "_blank");
    }
    async Task Deleteimg(M_YeuCauTrucking item, string link)
    {
        try
        {
            if (item.Links!.Contains(";"))
                link = link + ";";
            item.Links = item.Links!.Replace(link, string.Empty);
            //var rs = ssv.DeleteFileFromFTP(link);
            //CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
            StateHasChanged();
        }
        catch (Exception ex)
        {
            CallSnackBar("Throw exception code: " + ex.Message, MudBlazor.Severity.Error);
        }
    }
     async Task AttachFileToFTP(IBrowserFile file, M_YeuCauTrucking item)
    {
        try
        {
            var rs = await ssv.UploadfiletoFTP_YeuCauTrucking(file, (object)item);
            CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
        }
        catch(Exception ex)
        {
            CallSnackBar("Throw exception code: " + ex.Message, MudBlazor.Severity.Error);
        }
    }
    private bool _processingUpload = false;
    async Task SendMailnotify()
    {
        try
        {
            string[] users = _YeuCauTrucking_Detail.Nguoitraloi.Split(',');
            List<string> emails = new List<string>(); // Danh sách động, có thể thêm thoải mái

            int index = 0;
            foreach (var user in users)
            {
                if (string.IsNullOrEmpty(user))
                {

                }
                else
                {
                    string inputemail = "";
                    inputemail = await gsv.GetEmailAsync(user);
                    if (!string.IsNullOrEmpty(inputemail))
                    {
                        emails.Add(inputemail);
                    }

                }
            }
            string[] emailarray = emails.ToArray();
            _processingUpload = true;
            await Task.Delay(1);
            StateHasChanged();
            if (emails != null && emailarray.Length > 0)
            {
                var rs = await gsv.GuiThongBao_YeuCauTrucking(_YeuCauTrucking_Detail, emailarray);
                if (rs.Flag == true)
                {
                    if (_YeuCauTrucking_Detail.YeuCauTruckingID == Guid.Empty)
                    {
                        _YeuCauTrucking_Detail.Trangthai = "Emailed";
                    }
                    else
                    {
                        _YeuCauTrucking_Detail.Trangthai = "Emailed";
                        await yctsv.UpdateYCTruckingDetail(_YeuCauTrucking_Detail);
                    
                    }
                }
                CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);

            }
            else
            {

                CallSnackBar("Email is empty!", MudBlazor.Severity.Warning);
                return;
            }




        }
        catch (Exception ex)
        {
            CallSnackBar("Somethings went wrong!, error code: " + ex.Message, MudBlazor.Severity.Error);
        }
        finally
        {
            _processingUpload = false;
        }

    }

    private bool _processingUploadzalo = false;
    async Task SendZalonotify()
    {
        try
        {
            _processingUploadzalo = true;
            await Task.Delay(1);
            StateHasChanged();

            if (string.IsNullOrEmpty(_YeuCauTrucking_Detail.Nguoitraloi))
            {
                CallSnackBar("User is empty!", MudBlazor.Severity.Warning);
                return;
            }

            string[] users = _YeuCauTrucking_Detail.Nguoitraloi.Split(',');
            List<string> zaloid = new List<string>(); // Danh sách động, có thể thêm thoải mái

            int index = 0;
            foreach (var user in users)
            {
                if (string.IsNullOrEmpty(user))
                {

                }
                else
                {


                    var userinfo = await asv.GetUserDetail_byname(user);
                    if (!string.IsNullOrEmpty(userinfo.Zaloid))
                    {
                        zaloid.Add(userinfo.Zaloid);
                    }

                }
            }

            foreach (var u in zaloid)
            {

                var rs = await gsv.SendMessageAsync(u, _YeuCauTrucking_Detail.TieuDeEmail, _YeuCauTrucking_Detail.NoidungEmail, _YeuCauTrucking_Detail.NoidungChitietEmail);
                if (!rs.Flag)
                {
                    CallSnackBar(rs.Message, MudBlazor.Severity.Error);
                    return;
                }
            }
            CallSnackBar("✅ Send Success!", MudBlazor.Severity.Success);
        }
        catch (Exception ex)
        {
            CallSnackBar("Somethings went wrong!, error code: " + ex.Message, MudBlazor.Severity.Error);
        }
        finally
        {
            _processingUploadzalo = false;
        }

    }
    private async Task<IEnumerable<string>> Searchpol(string text)
    {
        try
        {
            if (string.IsNullOrWhiteSpace(text))
            {
                return List_pol.Where(x => !string.IsNullOrEmpty(x.PORT))
               .Select(x => x.PORT);
            }
            // MBL.Porname = mst_Consignee;
            return List_pol.Where(x => !string.IsNullOrEmpty(x.PORT) &&
                            x.PORT.Contains(text, StringComparison.OrdinalIgnoreCase))
               .Select(x => x.PORT);
        }
        catch (Exception)
        {
            throw;
        }
    }
    private async Task<IEnumerable<string>> Searchpod(string text)
    {
        try
        {
            if (string.IsNullOrWhiteSpace(text))
            {
                return List_pod.Where(x => !string.IsNullOrEmpty(x.PORT))
               .Select(x => x.PORT);
            }

            return List_pod.Where(x => !string.IsNullOrEmpty(x.PORT) &&
                            x.PORT.Contains(text, StringComparison.OrdinalIgnoreCase))
               .Select(x => x.PORT);
        }
        catch (Exception)
        {
            throw;
        }
    }
    private async Task Submit()
    {
        if ((await ssv.CheckPermission(asv.GetAuth().Result.User.Identity.Name, "Edit", "YeuCauTrucking") || await ssv.CheckPermission(asv.GetAuth().Result.User.Identity.Name, "New", "YeuCauTrucking")))
        {

            await form.Validate();

            if (form.IsValid)
            {

                var UserName = asv.GetAuth().Result.User.Identity!.Name!;
                _YeuCauTrucking_Detail.Dateupdate = DateTime.Now.ToString();
                _YeuCauTrucking_Detail.Userupdate = UserName;
                MudDialog!.Close(_YeuCauTrucking_Detail);

            }
        }

    }
    void Cancel() => MudDialog.Cancel();

    void CallSnackBar(string message, MudBlazor.Severity severity)
    {
        
        Snackbar.Configuration.SnackbarVariant = Variant.Filled;
        Snackbar.Configuration.MaxDisplayedSnackbars = 3;
        Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopRight;
        Snackbar.Add(message, severity);
    }
    private bool _processingUpload_message = false;
    async Task SendMessage(M_YeuCauTrucking item)
    {
        try
        {
            string[] users = item.Nguoitraloi.Split(',');
            List<string> listid = new List<string?>(); // Danh sách động, có thể thêm thoải mái

            int index = 0;
            foreach (var user in users)
            {
                if (string.IsNullOrEmpty(user))
                {

                }
                else
                {

                    Guid? inputid = await gsv.GetIdfromUser(user);
                    if (inputid != null)
                    {
                        listid.Add(inputid.ToString());
                    }

                }
            }
            string[] Idarray = listid.ToArray();
            _processingUpload_message = true;
            await Task.Delay(1);
            StateHasChanged();
            string noidung = "Trucking Requirements -  No: " + item.YeuCauTruckingNo;
            if (listid != null && Idarray.Length > 0)
            {
                await _notificationService.SendNotificationAsync(Idarray, noidung);


            }
            else
            {

                CallSnackBar("User is empty!", MudBlazor.Severity.Warning);
                return;
            }

        }
        catch (Exception ex)
        {
            CallSnackBar("Somethings went wrong!, error code: " + ex.Message, MudBlazor.Severity.Error);
        }
        finally
        {
            _processingUpload_message = false;
        }
    }
   
}
