@code {
    List<M_YeuCauTrucking> Listdata = new List<M_YeuCauTrucking>();
    MudDataGrid<M_YeuCauTrucking> mudTable;
    AuthUser user;
    string mailtp, mailpp;
    string usr;
    private List<string> ListUser { get; set; } = new List<string>();
    string UserHanding;
    List<string> trangthais = new List<string>();
    private List<Models.TrangThai> M_Trangthais = new List<Models.TrangThai>();
    private string searchText_pol = "";
    private string searchText_pod = "";

    string _addressFrom = string.Empty;
    string _addressTo = string.Empty;
    string _distanceKmDisplay = string.Empty;
    bool _distanceLoading = false;
    string _distanceError = string.Empty;

    private bool _resizeColumn;
    private List<PortModel> List_pod = new List<PortModel>();
    private List<PortModel> List_pol = new List<PortModel>();
    protected async override Task OnInitializedAsync()
    {
        List_pol = await ldxsv.GetList_port();
        List_pod = await ldxsv.GetList_port();

        M_Trangthais = await supsv.GetListTrangThai();
        var tts = await supsv.GetListTrangThai();
        trangthais = tts.Where(x => x.Tieude == "YeuCauTrucking").OrderBy(x => x.Noidung).Select(x => x.Noidung).ToList();

        ListUser = await asv.GetList_User_handle() ?? new List<string>();
        usr = asv.GetAuth().Result.User.Identity!.Name!;
        // await Refresh();
    }
    M_YeuCauTrucking detail;
    bool _loading = false;
    async Task Refresh()
    {
        try
        {
            detail = null!;
            _loading = true;
            Listdata.Clear();

            await Task.Delay(500);
            if (!await ssv.CheckPermission(usr, "View", "YeuCauTrucking"))
            {
                CallSnackBar("You have not access to view", MudBlazor.Severity.Warning);
                return;
            }
            Listdata = await yctsv.GetListYCTrucking();
            StateHasChanged();
        }
        catch(Exception ex)
        {
            CallSnackBar("Something went wrong!, error code: " + ex.Message, MudBlazor.Severity.Warning);
        }
        finally
        {
            _loading = false;
        }

    }

    async Task CalculateDistanceAsync()
    {
        _distanceError = string.Empty;
        _distanceKmDisplay = string.Empty;
        if (string.IsNullOrWhiteSpace(_addressFrom) || string.IsNullOrWhiteSpace(_addressTo))
        {
            CallSnackBar("Vui lòng nhập đủ 2 địa chỉ", MudBlazor.Severity.Warning);
            return;
        }
        try
        {
            _distanceLoading = true;
            StateHasChanged();
            var url = $"api/maps/distance?origin={Uri.EscapeDataString(_addressFrom)}&destination={Uri.EscapeDataString(_addressTo)}";
            var absUri = Navigation.ToAbsoluteUri(url);
            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(15));
            var resp = await Http.GetAsync(absUri, cts.Token);
            var body = await resp.Content.ReadAsStringAsync(cts.Token);
            if (!resp.IsSuccessStatusCode)
            {
                try
                {
                    using var errDoc = System.Text.Json.JsonDocument.Parse(body);
                    if (errDoc.RootElement.TryGetProperty("message", out var msgEl))
                    {
                        _distanceError = msgEl.GetString();
                    }
                    else
                    {
                        _distanceError = "Không tính được khoảng cách (HTTP " + ((int)resp.StatusCode) + ")";
                    }
                }
                catch
                {
                    _distanceError = "Không tính được khoảng cách (HTTP " + ((int)resp.StatusCode) + ")";
                }
                CallSnackBar(_distanceError, MudBlazor.Severity.Error);
                return;
            }
            using var doc = System.Text.Json.JsonDocument.Parse(body);
            var km = doc.RootElement.GetProperty("kilometers").GetDouble();
            _distanceKmDisplay = km.ToString("0.00");
        }
        catch (Exception ex)
        {
            _distanceError = ex.Message;
            CallSnackBar("Có lỗi khi tính khoảng cách: " + ex.Message, MudBlazor.Severity.Error);
        }
        finally
        {
            _distanceLoading = false;
        }
    }

    void CallSnackBar(string message, MudBlazor.Severity severity)
    {

        Snackbar.Configuration.SnackbarVariant = Variant.Filled;
        Snackbar.Configuration.MaxDisplayedSnackbars = 3;
        Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopRight;
        Snackbar.Add(message, severity);
    }
    void RowClicked(DataGridRowClickEventArgs<M_YeuCauTrucking> args)
    {
        detail = args.Item;
    }
    private int selectedRowNumber = -1;
    private string SelectedRowClassFunc(M_YeuCauTrucking m, int rowNumber)
    {
        if (selectedRowNumber == rowNumber)
        {
            selectedRowNumber = -1;
            return string.Empty;
        }
        else if (mudTable.SelectedItem != null && mudTable.SelectedItem.Equals(m))
        {
            selectedRowNumber = rowNumber;
            return "selected";
        }
        else
        {
            return string.Empty;
        }
    }

    async Task CommittedItem(M_YeuCauTrucking item)
    {
        item.Nguoiyeucau = asv.GetAuth().Result.User.Identity!.Name!;
        item.Userupdate = asv.GetAuth().Result.User.Identity!.Name!;
        item.Dateupdate = DateTime.Now.ToString("dd/MMM/yyyy");
        var rs = item.YeuCauTruckingID != Guid.Empty ? await yctsv.UpdateYCTruckingDetail(item) : await yctsv.CreateYCTruckingDetail(item);
        CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);

        await Refresh();
    }
    async Task AddItem()
    {
        if (!await ssv.CheckPermission(usr, "Add", "YeuCauTrucking"))
        {
            CallSnackBar("You have not access to Add", MudBlazor.Severity.Warning);
            return;
        }
        var item = new M_YeuCauTrucking
        {
            Approve = false,
            Editable= false,
            Continued = true
        };
        item.Nguoiyeucau = asv.GetAuth().Result.User.Identity!.Name!;
        item.Userupdate = asv.GetAuth().Result.User.Identity!.Name!;
        item.Dateupdate = DateTime.Now.ToString("dd/MMM/yyyy");
        Listdata.Add(item);
        await mudTable.SetEditingItemAsync(Listdata.LastOrDefault()!);
    }
    async Task DeleteItem(M_YeuCauTrucking item)
    {
        if (item.Approve == true)
        {
            CallSnackBar("Data đã được Approve!!! , vui lòng bỏ Approve", MudBlazor.Severity.Warning);
            return;
        }
        if (!await ssv.CheckPermission(usr, "Delete", "YeuCauTrucking"))
        {
            CallSnackBar("You have not access to Delete", MudBlazor.Severity.Warning);
            return;
        }

        var resultMess = await DialogService.ShowMessageBox(
                "Warning",
                "Deleting can not be undone!",
                yesText: "Delete!", cancelText: "Cancel");

        if (resultMess.HasValue)
        {
            var rs = await yctsv.DeleteYCTruckingDetail(item);
            
            await HistoryLogService.LogAsync(usr, "Delete Yeu Cau Trucking", "YeuCauTrucking", item.YeuCauTruckingID, item.YeuCauTruckingNo, new { OldData = item });
            CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
            await Refresh();
        }

    }
    DialogOptions options = new DialogOptions 
    {
        ClassBackground = "class-dialog-custom",
        FullWidth = true,
        MaxWidth = MaxWidth.Medium,
        CloseOnEscapeKey = false,
        DisableBackdropClick = true
    };
    string search;

    private bool FilterFunc1(M_YeuCauTrucking sbd) => FilterFunc(sbd, search);

    private bool FilterFunc(M_YeuCauTrucking sbd, string searchString)
    {
        if (string.IsNullOrWhiteSpace(sbd.YeuCauTruckingNo))
            return true;
        if (string.IsNullOrWhiteSpace(searchString))
            return true;
        if (sbd.YeuCauTruckingNo!.Contains(searchString, StringComparison.OrdinalIgnoreCase))
            return true;
        if ($"{sbd.YeuCauTruckingNo} ".Contains(searchString))
            return true;
        return false;
    }

    private Func<M_YeuCauTrucking, string> _cellStyleFunc => x =>
      {
          string style = "";

          if (string.IsNullOrEmpty(x.Trangthai))
              return "color: #000000";

          var rs = M_Trangthais
          .Where(t => (t.Noidung).Contains(x.Trangthai, StringComparison.InvariantCultureIgnoreCase)
              && t.Tieude.Equals("YeuCauTrucking", StringComparison.InvariantCultureIgnoreCase))
          .Select(t => t.Mamau)
          .FirstOrDefault();
          return "color: " + rs;


      };

