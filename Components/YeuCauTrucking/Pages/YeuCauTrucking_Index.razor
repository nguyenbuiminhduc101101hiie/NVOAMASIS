            StateHasChanged();
        }
        catch(Exception ex)
        {
            CallSnackBar("Throw exception code: " + ex.Message, MudBlazor.Severity.Error);
        }
    }
    async Task SeeDetail(string link)
    {

        await JSRuntime.InvokeVoidAsync("open", link.Replace("ftp", "http"), "_blank");
    }
    List<string>Linksplit(string links)
    {
        if (string.IsNullOrEmpty(links))
            return new List<string>();
        return links.Split(';').ToList(); 
    }
    private bool _processingUpload = false;
    async Task SendMailnotify(M_YeuCauTrucking item)
    {
        try
        {
            string[] users = item.Nguoitraloi.Split(',');
            List<string> emails = new List<string>(); // Danh sách động, có thể thêm thoải mái

            int index = 0;
            foreach (var user in users)
            {
                if(string.IsNullOrEmpty(user)){

                }else{
                    string inputemail ="";
                    inputemail = await gsv.GetEmailAsync(user);
                    if (!string.IsNullOrEmpty(inputemail))
                    {
                        emails.Add(inputemail);
                    }

                }
            }
            string[] emailarray = emails.ToArray();
            _processingUpload = true;
            await Task.Delay(1);
            StateHasChanged();
            if (emails != null && emailarray.Length > 0)
            {
                var rs = await gsv.GuiThongBao_YeuCauTrucking(item, emailarray);
                if(rs.Flag == true){
                    if (item.YeuCauTruckingID == Guid.Empty)
                    {
                        item.Trangthai = "Emailed";
                    }else{
                        item.Trangthai = "Emailed";
                        await yctsv.UpdateYCTruckingDetail(item);
                        await Refresh();
                    }
