    private async Task GetT_YCTruckingNo(M_YeuCauTrucking item)
    {

        int formattedYear = DateTime.Now.Year;
        int formattedMonth = DateTime.Now.Month;

        string usr = asv.GetAuth().Result.User.Identity!.Name!;
        var refno = await supsv.GetRefNoByFunc("YeuCauTrucking", formattedMonth, formattedYear, usr);

