                                            <MudSelectItem Value="@("Chi cục KDTV vùng II - Bắc Trung Bộ - Nghệ An")">II Chi cục KDTV vùng II - Bắc Trung Bộ - Nghệ An</MudSelectItem>
                                            <MudSelectItem Value="@("Chi cục KDTV vùng III - Nam Trung Bộ - Đà Nẵng")">III Chi cục KDTV vùng III - Nam Trung Bộ - Đà Nẵng</MudSelectItem>
                                            <MudSelectItem Value="@("Chi cục KDTV vùng IV - Tây Nguyên - Đắk Lắk")">IV Chi cục KDTV vùng IV - Tây Nguyên - Đắk Lắk</MudSelectItem>
                                            <MudSelectItem Value="@("Chi cục KDTV vùng V - Đông Nam Bộ - TP. Hồ Chí Minh")">V Chi cục KDTV vùng V - Đông Nam Bộ - TP. Hồ Chí Minh</MudSelectItem>
                                            <MudSelectItem Value="@("Chi cục KDTV vùng VI - Tây Nam Bộ (ĐBSCL) - Cần Thơ")">VI Chi cục KDTV vùng VI - Tây Nam Bộ (ĐBSCL) - Cần Thơ</MudSelectItem>
                                            <MudSelectItem Value="@("Chi cục KDTV vùng VII - Biên giới Tây Nam, các cửa khẩu phía Tây - Tây Ninh")">VII Chi cục KDTV vùng VII - Biên giới Tây Nam, các cửa khẩu phía Tây - Tây Ninh</MudSelectItem>
                                        </MudSelect>
                                    </MudItem>
                                    <MudItem xs="12" sm="6">
                                        <MudDatePicker Class="custom-label" @bind-Date="_BieuGiaKDTV_Detail.NgayApDung"
                                            For="@(() => _BieuGiaKDTV_Detail.NgayApDung)"
                                            Label="@Localizer["NgayApDung"]"
                                            Margin="Margin.Dense"
                                            DateFormat="dd/MM/yyyy"
                                            Required="true" />
                                    </MudItem>
                                    <MudItem xs="12" sm="6">
                                        <MudTextField @bind-Value="_BieuGiaKDTV_Detail.DiaChiChiCuc" Label="@Localizer["Address"]"
