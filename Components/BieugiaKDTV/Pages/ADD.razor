                                            <MudCardContent Class="pa-2">
                                                <MudGrid Spacing="1">
                                                    <MudItem xs="12"><MudNumericField @bind-Value="_BieuGiaKDTV_Detail.CONT40_1" Label="@Localizer["CONT40_1"]" Format="#,##0.##" Culture="@_en" T="double?" HideSpinButtons="true" Margin="Margin.Dense" Class="text-right custom-label" /></MudItem>
                                                    <MudItem xs="12"><MudNumericField @bind-Value="_BieuGiaKDTV_Detail.CONT40_2" Label="@Localizer["CONT40_2"]" Format="#,##0.##" Culture="@_en" T="double?" HideSpinButtons="true" Margin="Margin.Dense" Class="text-right custom-label" /></MudItem>
                                                    <MudItem xs="12"><MudNumericField @bind-Value="_BieuGiaKDTV_Detail.CONT40_3" Label="@Localizer["CONT40_3"]" Format="#,##0.##" Culture="@_en" T="double?" HideSpinButtons="true" Margin="Margin.Dense" Class="text-right custom-label" /></MudItem>
                                                    <MudItem xs="12"><MudNumericField @bind-Value="_BieuGiaKDTV_Detail.CONT40_4" Label="@Localizer["CONT40_4"]" Format="#,##0.##" Culture="@_en" T="double?" HideSpinButtons="true" Margin="Margin.Dense" Class="text-right custom-label" /></MudItem>
                                                    <MudItem xs="12"><MudNumericField @bind-Value="_BieuGiaKDTV_Detail.CONT40_5" Label="@Localizer["CONT40_5"]" Format="#,##0.##" Culture="@_en" T="double?" HideSpinButtons="true" Margin="Margin.Dense" Class="text-right custom-label" /></MudItem>
                                                </MudGrid>
                                            </MudCardContent>
                                        </MudCard>
