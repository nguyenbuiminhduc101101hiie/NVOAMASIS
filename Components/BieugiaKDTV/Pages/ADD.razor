    </DialogContent>
    <DialogActions>

        <MudButton OnClick="@(async () => await Submit())">Save</MudButton>
        <MudButton OnClick="Cancel">Cancel</MudButton>

    </DialogActions>
</MudDialog>



@code {
    [CascadingParameter] MudDialogInstance? MudDialog { get; set; }
    [Parameter] public Models.M_BieuGiaKDTV _BieuGiaKDTV_Detail { get; set; }

    [Parameter] public string Status { get; set; }
    MudForm form;
    List<string> trangthais = new List<string>();
    private List<Models.TrangThai> M_Trangthais = new List<Models.TrangThai>();
    public CultureInfo _en = CultureInfo.GetCultureInfo("en-US");
    private List<Terminal_> Terminals = new List<Terminal_>();
    private List<Terminal_> Terminals_Address = new List<Terminal_>();
    List<M_BieuGiaKDTV> BGRRs = new List<M_BieuGiaKDTV>();
    string UserHanding;
    private List<string> ListUser { get; set; } = new List<string>();
    protected async override Task OnInitializedAsync()
    {
        if (Status == "Duplicate")
        {
            _BieuGiaKDTV_Detail.KDTVID = Guid.Empty;
            _BieuGiaKDTV_Detail.BieuGiaKDTVNo = "";
            _BieuGiaKDTV_Detail.Approve = false;
        }
        M_Trangthais = await supsv.GetListTrangThai();
        var tts = await supsv.GetListTrangThai();
        trangthais = tts.Where(x => x.Tieude == "BieuGiaKDTV").OrderBy(x => x.Noidung).Select(x => x.Noidung).ToList();
        BGRRs = await BGRRsv.GetList_BieuGiaKDTV();
        Terminals_Address = await gsv.GetList_Terminal_add();
        Terminals = await gsv.GetList_Terminal();
        ListUser = await asv.GetList_User_handle() ?? new List<string>();

    }

    private async Task Get_BGNHNo()
    {

        int formattedYear = DateTime.Now.Year;
        int formattedMonth = DateTime.Now.Month;

        string usr = asv.GetAuth().Result.User.Identity!.Name!;
        var refno = await supsv.GetRefNoByFunc("KDTV", formattedMonth, formattedYear, usr);

        var rs = asv.GetUserDetail();
        var cn = rs.Branch;
        _BieuGiaKDTV_Detail.BieuGiaKDTVNo = cn + "BGKDTV_" + formattedYear.ToString() + formattedMonth.ToString() + refno.Value.ToString("D4");
    }

    private async Task Submit()
    {
        if ((await ssv.CheckPermission(asv.GetAuth().Result.User.Identity.Name, "Edit", "BieuGiaKDTV") || await ssv.CheckPermission(asv.GetAuth().Result.User.Identity.Name, "New", "BieuGiaKDTV")))
        {

            await form.Validate();

            if (form.IsValid)
            {

                var UserName = asv.GetAuth().Result.User.Identity!.Name!;
                _BieuGiaKDTV_Detail.Approve = true;
                _BieuGiaKDTV_Detail.Continued = true;
                _BieuGiaKDTV_Detail.DateUpdate = DateTime.Now.ToString("dd/MMM/yyyy");
                _BieuGiaKDTV_Detail.Userupdate = UserName;
                MudDialog!.Close(_BieuGiaKDTV_Detail);

            }
        }

    }
    void Cancel() => MudDialog.Cancel();

    void CallSnackBar(string message, MudBlazor.Severity severity)
    {
        
        Snackbar.Configuration.SnackbarVariant = Variant.Filled;
        Snackbar.Configuration.MaxDisplayedSnackbars = 3;
        Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopRight;
        Snackbar.Add(message, severity);
    }
  
    // private void OnTerminalBlur(FocusEventArgs e)
    // {
    //     var company = Terminals_Address.FirstOrDefault(x => x.TermiNalName == _BieuGiaKDTV_Detail.ChiCucKiemDich);
    //     if (company != null)
    //     {
    //         _BieuGiaKDTV_Detail.DiaChiChiCuc = company.Address;
    //     }
    // }

    private async Task<IEnumerable<string>> SearchTerminal(string text)
    {
        try
        {
            if (string.IsNullOrWhiteSpace(text))
            {
                return Terminals.Where(x => !string.IsNullOrEmpty(x.TermiNalName))
               .Select(x => x.TermiNalName);
            }
            // MBL.Porname = mst_Consignee;
            return Terminals.Where(x => !string.IsNullOrEmpty(x.TermiNalName) &&
                            x.TermiNalName.Contains(text, StringComparison.OrdinalIgnoreCase))
               .Select(x => x.TermiNalName);
        }
        catch (Exception)
        {
            throw;
        }
    }

}
