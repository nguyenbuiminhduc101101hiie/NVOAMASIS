                                        </MudSelect>
                                    </MudItem>
                                    <MudItem xs="12" sm="6">
                                        <MudTextField @bind-Value="_BieuGiaKDTV_Detail.DienThoai" Label="@Localizer["DienThoai"]" Class="custom-label" Margin="Margin.Dense" />
                                    </MudItem>
                                    <MudItem xs="12" sm="6">
                                        <MudSelect @bind-Value="_BieuGiaKDTV_Detail.LoaiHinhKiemDich" Label="@Localizer["LoaiHinhKiemDich"]" Class="custom-label" Margin="Margin.Dense">
