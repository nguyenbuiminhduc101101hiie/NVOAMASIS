                                                    <MudItem xs="12"><MudNumericField @bind-Value="_BieuGiaKDTV_Detail.CONT20_2" Label="@Localizer["CONT20_2"]" Format="#,##0.##" Culture="@_en" T="double?" HideSpinButtons="true" Margin="Margin.Dense" Class="text-right custom-label" /></MudItem>
                                                    <MudItem xs="12"><MudNumericField @bind-Value="_BieuGiaKDTV_Detail.CONT20_3" Label="@Localizer["CONT20_3"]" Format="#,##0.##" Culture="@_en" T="double?" HideSpinButtons="true" Margin="Margin.Dense" Class="text-right custom-label" /></MudItem>
                                                    <MudItem xs="12"><MudNumericField @bind-Value="_BieuGiaKDTV_Detail.CONT20_4" Label="@Localizer["CONT20_4"]" Format="#,##0.##" Culture="@_en" T="double?" HideSpinButtons="true" Margin="Margin.Dense" Class="text-right custom-label" /></MudItem>
                                                    <MudItem xs="12"><MudNumericField @bind-Value="_BieuGiaKDTV_Detail.CONT20_5" Label="@Localizer["CONT20_5"]" Format="#,##0.##" Culture="@_en" T="double?" HideSpinButtons="true" Margin="Margin.Dense" Class="text-right custom-label" /></MudItem>
