@inject IStringLocalizer<SharedResource> Localizer

<MudDialog>
    <DialogContent>
        <MudStack Spacing="3" Class="pa-1">
            <div>
                <MudText Typo="Typo.subtitle1">@Localizer["BkavInvoice.Help.FlowTitle"]</MudText>
                <ul>
                    <li>@Localizer["BkavInvoice.Help.Flow1"]</li>
                    <li>@Localizer["BkavInvoice.Help.Flow2"]</li>
                    <li>@Localizer["BkavInvoice.Help.Flow3"]</li>
                    <li>@Localizer["BkavInvoice.Help.Flow4"]</li>
                </ul>
            </div>

            <div>
                <MudText Typo="Typo.subtitle1">@Localizer["BkavInvoice.Help.InputTitle"]</MudText>
                <ul>
                    <li>@Localizer["BkavInvoice.Help.InputCommand"]</li>
                    <li>@Localizer["BkavInvoice.Help.InputPay"]</li>
                    <li>@Localizer["BkavInvoice.Help.InputFormSerialNo"]</li>
                    <li>@Localizer["BkavInvoice.Help.InputOriginal"]</li>
                    <li>@Localizer["BkavInvoice.Help.InputTaxCode"]</li>
                </ul>
            </div>

            <div>
                <MudText Typo="Typo.subtitle1">@Localizer["BkavInvoice.Help.ButtonTitle"]</MudText>
                <MudTable Items="@ButtonHelpRows" Dense="true" Hover="true" Elevation="0">
                    <HeaderContent>
                        <MudTh>@Localizer["BkavInvoice.Help.ButtonColumn"]</MudTh>
                        <MudTh>@Localizer["BkavInvoice.Help.FunctionColumn"]</MudTh>
                    </HeaderContent>
                    <RowTemplate Context="row">
                        <MudTd DataLabel="@Localizer["BkavInvoice.Help.ButtonColumn"]">@Localizer[row.ButtonKey]</MudTd>
                        <MudTd DataLabel="@Localizer["BkavInvoice.Help.FunctionColumn"]">@Localizer[row.DescriptionKey]</MudTd>
                    </RowTemplate>
                </MudTable>
            </div>

            <div>
                <MudText Typo="Typo.subtitle1">@Localizer["BkavInvoice.Help.NoteTitle"]</MudText>
                <ul>
                    <li>@Localizer["BkavInvoice.Help.NoteSelection"]</li>
                    <li>@Localizer["BkavInvoice.Help.NoteCommand110111"]</li>
                    <li>@Localizer["BkavInvoice.Help.NoteReplaceAdjust"]</li>
                    <li>@Localizer["BkavInvoice.Help.NoteFiles"]</li>
                </ul>
            </div>
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudSpacer />
        <MudButton OnClick="@Close" Color="Color.Primary" Variant="Variant.Filled">@Localizer["Close"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] public MudDialogInstance? MudDialog { get; set; }

    private readonly List<ButtonHelpRow> ButtonHelpRows =
    [
        new("BkavInvoice.Action.Reload", "BkavInvoice.Help.ButtonReload"),
        new("BkavInvoice.Action.Issue", "BkavInvoice.Help.ButtonIssue"),
        new("BkavInvoice.Action.Update200", "BkavInvoice.Help.ButtonUpdate200"),
        new("BkavInvoice.Action.Update204", "BkavInvoice.Help.ButtonUpdate204"),
        new("BkavInvoice.Action.Replace120", "BkavInvoice.Help.ButtonReplace120"),
        new("BkavInvoice.Action.Adjust121", "BkavInvoice.Help.ButtonAdjust121"),
        new("BkavInvoice.Action.Cancel201", "BkavInvoice.Help.ButtonCancel201"),
        new("BkavInvoice.Action.Cancel202", "BkavInvoice.Help.ButtonCancel202"),
        new("BkavInvoice.Action.Delete303", "BkavInvoice.Help.ButtonDelete303"),
        new("BkavInvoice.Action.Delete301", "BkavInvoice.Help.ButtonDelete301"),
        new("BkavInvoice.Action.Info800", "BkavInvoice.Help.ButtonInfo800"),
        new("BkavInvoice.Action.Status801", "BkavInvoice.Help.ButtonStatus801"),
        new("BkavInvoice.Action.History802", "BkavInvoice.Help.ButtonHistory802"),
        new("BkavInvoice.Action.Link804", "BkavInvoice.Help.ButtonLink804"),
        new("BkavInvoice.Action.Pdf808", "BkavInvoice.Help.ButtonPdf808"),
        new("BkavInvoice.Action.Xml809", "BkavInvoice.Help.ButtonXml809"),
        new("BkavInvoice.Action.Tax904", "BkavInvoice.Help.ButtonTax904"),
        new("BkavInvoice.Action.Account902", "BkavInvoice.Help.ButtonAccount902"),
        new("BkavInvoice.Action.Dll1001", "BkavInvoice.Help.ButtonDll1001")
    ];

    private void Close() => MudDialog?.Close();

    private sealed record ButtonHelpRow(string ButtonKey, string DescriptionKey);
}
