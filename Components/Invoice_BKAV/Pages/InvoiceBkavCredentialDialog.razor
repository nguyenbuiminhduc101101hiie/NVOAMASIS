@inject IStringLocalizer<SharedResource> Localizer

<MudDialog>
    <DialogContent>
        <MudStack Spacing="2" Class="pa-1">
            <MudAlert Severity="MudBlazor.Severity.Info" Dense="true">
                @Localizer["BkavInvoice.Credential.LocalStorageNote"]
            </MudAlert>

            @if (HasServerCredentials)
            {
                <MudAlert Severity="MudBlazor.Severity.Success" Dense="true">
                    @Localizer["BkavInvoice.Credential.ServerFallback"]
                </MudAlert>
            }

            @if (!string.IsNullOrWhiteSpace(_error))
            {
                <MudAlert Severity="MudBlazor.Severity.Warning" Dense="true">
                    @_error
                </MudAlert>
            }

            <MudTextField T="string"
                          @bind-Value="_partnerGuid"
                          Label="@Localizer["BkavInvoice.Credential.PartnerGuid"]"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Dense="true"
                          Immediate="true" />

            <MudTextField T="string"
                          @bind-Value="_partnerToken"
                          Label="@Localizer["BkavInvoice.Credential.PartnerToken"]"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Dense="true"
                          Immediate="true"
                          InputType="@(_showToken ? InputType.Text : InputType.Password)"
                          Adornment="Adornment.End"
                          AdornmentIcon="@(_showToken ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                          OnAdornmentClick="@ToggleToken" />

            @if (!string.IsNullOrWhiteSpace(SavedAt))
            {
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    @Localizer["BkavInvoice.Credential.SavedAt", SavedAt]
                </MudText>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@ClearBrowserCache" Color="Color.Error" Variant="Variant.Text">
            @Localizer["BkavInvoice.Credential.Clear"]
        </MudButton>
        <MudSpacer />
        <MudButton OnClick="@Cancel" Variant="Variant.Text">
            @Localizer["Close"]
        </MudButton>
        <MudButton OnClick="@Save" Color="Color.Primary" Variant="Variant.Filled">
            @Localizer["BkavInvoice.Credential.Save"]
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] public MudDialogInstance? MudDialog { get; set; }

    [Parameter] public string PartnerGuid { get; set; } = string.Empty;
    [Parameter] public string PartnerToken { get; set; } = string.Empty;
    [Parameter] public string SavedAt { get; set; } = string.Empty;
    [Parameter] public bool HasServerCredentials { get; set; }

    private string _partnerGuid = string.Empty;
    private string _partnerToken = string.Empty;
    private string _error = string.Empty;
    private bool _showToken;

    protected override void OnInitialized()
    {
        _partnerGuid = PartnerGuid;
        _partnerToken = PartnerToken;
    }

    private void ToggleToken()
    {
        _showToken = !_showToken;
    }

    private void Save()
    {
        _error = string.Empty;

        if (string.IsNullOrWhiteSpace(_partnerGuid) || string.IsNullOrWhiteSpace(_partnerToken))
        {
            _error = Localizer["BkavInvoice.Credential.Required"].ToString();
            return;
        }

        MudDialog?.Close(DialogResult.Ok(new Result
        {
            Action = ResultAction.Save,
            PartnerGuid = _partnerGuid.Trim(),
            PartnerToken = _partnerToken.Trim()
        }));
    }

    private void ClearBrowserCache()
    {
        MudDialog?.Close(DialogResult.Ok(new Result { Action = ResultAction.Clear }));
    }

    private void Cancel() => MudDialog?.Cancel();

    public sealed class Result
    {
        public ResultAction Action { get; set; }
        public string PartnerGuid { get; set; } = string.Empty;
        public string PartnerToken { get; set; } = string.Empty;
    }

    public enum ResultAction
    {
        Save,
        Clear
    }
}
