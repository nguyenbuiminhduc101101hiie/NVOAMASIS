    private BkavInvoiceActionInput BuildInput()
    {
        int? invoiceNo = null;
        if (int.TryParse(InvoiceNoText, NumberStyles.Integer, CultureInfo.InvariantCulture, out var parsedInvoiceNo))
            invoiceNo = parsedInvoiceNo;

        return new BkavInvoiceActionInput
        {
            CommandType = CreateCommandType,
            InvoiceForm = InvoiceForm,
            InvoiceSerial = InvoiceSerial,
            InvoiceNo = invoiceNo,
            OriginalInvoiceIdentify = OriginalInvoiceIdentify,
            PayMethodID = PayMethodID,
            TaxCode = TaxCode
        };
    }

