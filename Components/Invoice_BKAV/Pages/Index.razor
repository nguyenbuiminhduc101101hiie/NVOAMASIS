    private async Task RunForSelection(Func<BkavInvoiceGroup, Task<BkavInvoiceOperationResult>> action, string actionName)
    {
        var items = SelectedGroups.ToList();
        if (items.Count == 0)
        {
            CallSnackBar(T("BkavInvoice.SelectGroupRequired"), MudBlazor.Severity.Warning);
            return;
        }

        await RunItems(items, action, actionName);
    }

    private Task RunSingle(BkavInvoiceGroup group, Func<BkavInvoiceGroup, Task<BkavInvoiceOperationResult>> action, string actionName)
        => RunItems([group], action, actionName);

    private async Task RunItems(List<BkavInvoiceGroup> items, Func<BkavInvoiceGroup, Task<BkavInvoiceOperationResult>> action, string actionName)
    {
        try
        {
            _busy = true;
            var success = 0;
            var failed = 0;
            var lastMessage = string.Empty;

            foreach (var item in items)
            {
                var result = await action(item);
                lastMessage = FirstNonEmpty(result.Message, result.Link, result.FilePath);
                if (!string.IsNullOrWhiteSpace(result.ObjectText))
                    LastObjectText = result.ObjectText;

                if (result.Success)
                    success++;
                else
                    failed++;
            }

            await Refresh();

            var severity = failed == 0 ? MudBlazor.Severity.Success : success == 0 ? MudBlazor.Severity.Error : MudBlazor.Severity.Warning;
            CallSnackBar(TF("BkavInvoice.ActionSummary", actionName, success, failed, lastMessage), severity);
        }
        catch (Exception ex)
        {
            CallSnackBar(TF("BkavInvoice.ActionFailed", actionName, ex.Message), MudBlazor.Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task RunTool(Func<Task<BkavInvoiceOperationResult>> action, string actionName)
    {
        try
        {
            _busy = true;
            var result = await action();
            if (!string.IsNullOrWhiteSpace(result.ObjectText))
                LastObjectText = result.ObjectText;

            CallSnackBar(TF("BkavInvoice.ToolSummary", actionName, result.Message), result.Success ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
        }
        catch (Exception ex)
        {
            CallSnackBar(TF("BkavInvoice.ActionFailed", actionName, ex.Message), MudBlazor.Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private string FormatMoney(double? value)
        => value.HasValue ? value.Value.ToString("##,##0.##", _en) : string.Empty;

    private static string FormatSavedAt(string? savedAt)
    {
        if (string.IsNullOrWhiteSpace(savedAt))
            return string.Empty;

        return DateTimeOffset.TryParse(savedAt, CultureInfo.InvariantCulture, DateTimeStyles.AssumeUniversal, out var parsed)
            ? parsed.LocalDateTime.ToString("dd/MM/yyyy HH:mm:ss", CultureInfo.CurrentCulture)
            : savedAt;
    }

    private static string ToHref(string path)
    {
        if (Uri.TryCreate(path, UriKind.Absolute, out _))
            return path;

        return "/" + path.TrimStart('/', '\\').Replace('\\', '/');
    }

    private string T(string key) => Localizer[key].ToString();

    private string TF(string key, params object[] args) => Localizer[key, args].ToString();

    private static string FirstNonEmpty(params string?[] values)
        => values.FirstOrDefault(x => !string.IsNullOrWhiteSpace(x))?.Trim() ?? string.Empty;

    private void CallSnackBar(string message, MudBlazor.Severity severity)
    {
        Snackbar.Configuration.SnackbarVariant = Variant.Filled;
        Snackbar.Configuration.MaxDisplayedSnackbars = 3;
        Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopRight;
        Snackbar.Add(message, severity);
    }

