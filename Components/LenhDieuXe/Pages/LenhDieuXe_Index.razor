@code {
    List<M_LenhDieuXe> Listdata = new List<M_LenhDieuXe>();
    MudDataGrid<M_LenhDieuXe> mudTable;
    AuthUser user;
    string usr;
    private List<string> ListUser { get; set; } = new List<string>();
    string UserHanding;
    List<string> trangthais = new List<string>();
    private List<Models.TrangThai> M_Trangthais = new List<Models.TrangThai>();
    M_LenhDieuXe detail;
    private List<M_Customer> List_nvdieuxe = new List<M_Customer>();
    private List<M_Customer> List_Taixe= new List<M_Customer>();
    private List<M_Customer> List_Phuxe = new List<M_Customer>();
    private List<M_Customer> List_Nhaxe = new List<M_Customer>();
    private List<M_Customer> List_soxe = new List<M_Customer>();
    private List<PortModel> List_pod = new List<PortModel>();
    private List<PortModel> List_pol = new List<PortModel>();
    private string searchCarr = "";
    private List<M_Customer> Cuss_Carr = new List<M_Customer>();
    public CultureInfo _de = CultureInfo.GetCultureInfo("de-DE");
    public CultureInfo _en = CultureInfo.GetCultureInfo("en-US");
    private bool _processingUpload = false;
    string status="";
    private List<M_YeuCauTrucking> YCTKs = new List<M_YeuCauTrucking>();
    private bool _resizeColumn;
    protected async override Task OnInitializedAsync()
    {
        YCTKs = await YCTKSv.GetListYCTrucking();
        status = "normal";
        List_nvdieuxe = await ldxsv.GetList_Cus_Personal();
        List_Taixe = await ldxsv.GetList_Cus_Driver();
        List_Phuxe = await ldxsv.GetList_Cus_Driver();
        List_Nhaxe = await ldxsv.GetList_Cus_Personal();
        List_soxe = await ldxsv.GetList_Cus_Trucking();
        List_pol = await ldxsv.GetList_port();
        List_pod = await ldxsv.GetList_port();
        ListUser = await asv.GetList_User_handle() ?? new List<string>();
        usr = asv.GetAuth().Result.User.Identity!.Name!;
        Cuss_Carr = await lcsv.GetList_Customer_line();
        M_Trangthais = await supsv.GetListTrangThai();
        var tts = await supsv.GetListTrangThai();
        trangthais = tts.Where(x => x.Tieude == "LenhDieuXe").OrderBy(x => x.Noidung).Select(x => x.Noidung).ToList();
        // await Refresh();
    }


    bool _loading = false;
    async Task Refresh()
    {
        try
        {
            detail = null!;
            _loading = true;
            Listdata.Clear();

            await Task.Delay(500);
            if (!await ssv.CheckPermission(usr, "View", "LenhDieuXe"))
            {
                CallSnackBar("You have not access to view", MudBlazor.Severity.Warning);
                return;
            }
            Listdata = await ldxsv.GetListLenhDieuXe();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            CallSnackBar("Something went wrong!, error code: " + ex.Message, MudBlazor.Severity.Warning);
        }
        finally
        {
            _loading = false;
        }

    }

    void CallSnackBar(string message, MudBlazor.Severity severity)
    {
        
        Snackbar.Configuration.SnackbarVariant = Variant.Filled;
        Snackbar.Configuration.MaxDisplayedSnackbars = 3;
        Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopRight;
        Snackbar.Add(message, severity);
    }
    void RowClicked(DataGridRowClickEventArgs<M_LenhDieuXe> args)
    {
        detail = args.Item;
    }
    private int selectedRowNumber = -1;
    private string SelectedRowClassFunc(M_LenhDieuXe m, int rowNumber)
    {
        if (selectedRowNumber == rowNumber)
        {
            selectedRowNumber = -1;
            return string.Empty;
        }
        else if (mudTable.SelectedItem != null && mudTable.SelectedItem.Equals(m))
        {
            selectedRowNumber = rowNumber;
            return "selected";
        }
        else
        {
            return string.Empty;
        }
    }

    async Task CommittedItem(M_LenhDieuXe item)
    {
        item.Userupdate = asv.GetAuth().Result.User.Identity!.Name!;
        item.Dateupdate = DateTime.Now.ToString("dd/MMM/yyyy");
        var rs = item.Id != Guid.Empty ? await ldxsv.UpdateLenhDieuXe_Detail(item) : await ldxsv.CreateLenhDieuXe_Detail(item);
        CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);

        await Refresh();
    }
    int? lenhdieuxe_no;
    async Task AddItem()
    {

        if (!await ssv.CheckPermission(usr, "Add", "LenhDieuXe"))
        {
            CallSnackBar("You have not access to Add", MudBlazor.Severity.Warning);
            return;
        }
        var item = new M_LenhDieuXe
        {

        };

        item.Userupdate = asv.GetAuth().Result.User.Identity!.Name!;
        item.Dateupdate = DateTime.Now.ToString("dd/MMM/yyyy");
        Listdata.Add(item);
        await mudTable.SetEditingItemAsync(Listdata.LastOrDefault()!);
    }
    async Task DeleteItem(M_LenhDieuXe item)
    {
        if (item.Approve == true)
        {
            CallSnackBar("Data đã được Approve!!! , vui lòng bỏ Approve", MudBlazor.Severity.Warning);
            return;
        }
        if (!await ssv.CheckPermission(usr, "Delete", "LenhDieuXe"))
        {
            CallSnackBar("You have not access to Delete", MudBlazor.Severity.Warning);
            return;
        }
        var resultMess = await DialogService.ShowMessageBox(
                "Warning",
                "Deleting can not be undone!",
                yesText: "Delete!", cancelText: "Cancel");

        if (resultMess.HasValue)
        {
            var rs = await ldxsv.DeleteLenhDieuXe_Detail(item);
            await HistoryLogService.LogAsync(usr, "Delete Lenh Dieu Xe", "LenhDieuXe", item.Id, item.Lenhdieuxeno, new { OldData = item });
            CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
            await Refresh();
        }

    }
    DialogOptions options = new DialogOptions
        {
            ClassBackground = "class-dialog-custom",
            FullWidth = true,
            MaxWidth = MaxWidth.Medium,
            CloseOnEscapeKey = false,
            DisableBackdropClick = true
        };
    string search;

    private bool FilterFunc1(M_LenhDieuXe sbd) => FilterFunc(sbd, search);

    private bool FilterFunc(M_LenhDieuXe sbd, string searchString)
    {
        if (string.IsNullOrWhiteSpace(sbd.Lenhdieuxeno))
            return true;
        if (string.IsNullOrWhiteSpace(searchString))
            return true;
        if (sbd.Lenhdieuxeno!.Contains(searchString, StringComparison.OrdinalIgnoreCase))
            return true;
        if ($"{sbd.Lenhdieuxeno} ".Contains(searchString))
            return true;
        return false;
    }

        private Func<M_LenhDieuXe, string> _cellStyleFunc => x =>
         {
             string style = "";

         if (string.IsNullOrEmpty(x.TrangthaiCt))
                 return "color: #000000";

             var rs = M_Trangthais
             .Where(t => (t.Noidung).Contains(x.TrangthaiCt, StringComparison.InvariantCultureIgnoreCase)
                 && t.Tieude.Equals("LenhDieuXe", StringComparison.InvariantCultureIgnoreCase))
             .Select(t => t.Mamau)
             .FirstOrDefault();
             return "color: " + rs;


         };
    private async Task OpenCreateDialog(Models.M_LenhDieuXe tr)
    {
        var optionsdialog = new DialogOptions { ClassBackground = "class-dialog-custom", FullWidth = true, MaxWidth = MaxWidth.Medium };

        if (await ssv.CheckPermission(asv.GetAuth().Result.User.Identity.Name, "Add", "LenhDieuXe"))
        {

            DialogOptions closeOnEscapeKey = new DialogOptions() { CloseOnEscapeKey = true };
            var parameters = new DialogParameters<ADD> { { x => x._LenhDieuXe_Detail, tr }, { x => x.Status, "add" } };
            
            var dialog = await DialogService.ShowAsync<ADD>(tr.Id == Guid.Empty ? "Lệnh Điều Xe Create" : "Lệnh Điều Xe Edit", parameters, optionsdialog);
            var result = await dialog.Result;
            if (!result.Canceled)
            {
                var data = (M_LenhDieuXe)result.Data;
                var rs = await ldxsv.UpdateCreateLenhDieuXe(data);
                await HistoryLogService.LogAsync(usr, "ADD Lenh Dieu Xe", "LenhDieuXe", data.Id, data.Lenhdieuxeno, data);
                MudBlazor.Severity severity;
                if (rs[1] == "1")
                    severity = MudBlazor.Severity.Success;
                else
                    severity = MudBlazor.Severity.Error;

                CallSnackBar(rs[0], severity);

                await HandleRefresh_create(data.Id);

            }

            return;

        }
        else
        {
            CallSnackBar("You have not access to Create", MudBlazor.Severity.Warning);
            return;
        }

    }

    async Task HandleRefresh_create(Guid? id)
    {
        try
        {

            detail = null;

            Listdata.Clear();

            await Task.Delay(500);

            if (!await ssv.CheckPermission(asv.GetAuth().Result.User.Identity.Name, "View", "LenhDieuXe"))
            {
                CallSnackBar("You have not access to view", MudBlazor.Severity.Warning);

                return;
            }
            Listdata = await ldxsv.GetListLDX_create(id);
            StateHasChanged();
        }
        finally
        {


        }
    }
    private async Task GetT_ProductPriceNo(M_LenhDieuXe item)
    {

        int formattedYear = DateTime.Now.Year;
        int formattedMonth = DateTime.Now.Month;

        string usr = asv.GetAuth().Result.User.Identity!.Name!;
        var refno = await supsv.GetRefNoByFunc("LenhDieuXe", formattedMonth, formattedYear, usr);

        var rs = asv.GetUserDetail();
        var cn = rs.Branch;
        item.Lenhdieuxeno = cn + "LDX" + formattedYear.ToString() + formattedMonth.ToString() + refno.Value.ToString("D4");

    }
    private async Task OpenEditDialog(Models.M_LenhDieuXe tr)
    {
        var optionsdialog = new DialogOptions { ClassBackground = "class-dialog-custom", FullWidth = true, MaxWidth = MaxWidth.Medium };
        if (tr == null)
        {
            CallSnackBar("Please select Data", MudBlazor.Severity.Warning);
