    private async Task<IEnumerable<string>> SearchNhanVien(string text)
    {
        try
        {
            if (string.IsNullOrWhiteSpace(text))
            {
                return List_nvdieuxe.Where(x => !string.IsNullOrEmpty(x.COMPANY))
               .Select(x => x.COMPANY);
            }
            // MBL.Porname = mst_Consignee;
            return List_nvdieuxe.Where(x => !string.IsNullOrEmpty(x.COMPANY) &&
                            x.COMPANY.Contains(text, StringComparison.OrdinalIgnoreCase))
               .Select(x => x.COMPANY);
        }
        catch (Exception)
        {
            throw;
        }
    }

