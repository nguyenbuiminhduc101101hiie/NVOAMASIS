                                                    <MudTextField @bind-Value="_LenhDieuXe_Detail.Ghichu" Label="Ghi chú" InputType="InputType.Text" Lines="3"
                                                    class="custom-label" />
                                                </MudItem>
                                            </MudGrid>
                                        </MudItem>


                                    </MudGrid>
                                </MudCardContent>
                            </MudCard>
                        </MudGrid>


