    private async Task Submit()
    {
        if ((await ssv.CheckPermission(asv.GetAuth().Result.User.Identity.Name, "Edit", "LenhDieuXe") || await ssv.CheckPermission(asv.GetAuth().Result.User.Identity.Name, "New", "LenhDieuXe")))
        {

            await form.Validate();

            if (form.IsValid)
            {

                var UserName = asv.GetAuth().Result.User.Identity!.Name!;
                _LenhDieuXe_Detail.Dateupdate = DateTime.Now.ToString();
                _LenhDieuXe_Detail.Userupdate = UserName;
                MudDialog!.Close(_LenhDieuXe_Detail);

            }
        }

    }
    void Cancel() => MudDialog.Cancel();

    void CallSnackBar(string message, MudBlazor.Severity severity)
    {
        
        Snackbar.Configuration.SnackbarVariant = Variant.Filled;
        Snackbar.Configuration.MaxDisplayedSnackbars = 3;
        Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopRight;
        Snackbar.Add(message, severity);
    }
    private async Task<IEnumerable<Guid?>> Search_YCTKNo(string value)
    {
        if (string.IsNullOrEmpty(value))
            return YeuCauTruckings.Select(x => (Guid?)x.YeuCauTruckingID);

        return YeuCauTruckings
            .Where(x => (x.YeuCauTruckingNo).Contains(value, StringComparison.InvariantCultureIgnoreCase))
            .Select(x => (Guid?)x.YeuCauTruckingID);
    }

    private string GetYCTKNoLabel(Guid? id)
    {
        var customer = YeuCauTruckings.FirstOrDefault(x => x.YeuCauTruckingID == id);
        return customer != null ? customer.YeuCauTruckingNo : string.Empty;
    }

   
