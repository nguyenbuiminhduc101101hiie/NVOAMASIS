                                                <MudSelectItem Value="@("C40HC")">C40HC</MudSelectItem>
                                                <MudSelectItem Value="@("C45HC")">C45HC</MudSelectItem>
                                                <MudSelectItem Value="@("C20RF")">C20RF</MudSelectItem>
                                                <MudSelectItem Value="@("C40RF")">C40RF</MudSelectItem>
