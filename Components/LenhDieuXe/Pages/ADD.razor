                                                <MudSelectItem Value="@("C20FL")">C20FL</MudSelectItem>
                                                <MudSelectItem Value="@("C40FL")">C40FL</MudSelectItem>
                                                <MudSelectItem Value="@("C20TK")">C20TK</MudSelectItem>
                                                <MudSelectItem Value="@("C40TK")">C40TK</MudSelectItem>
                                                <MudSelectItem Value="@("T2T")">T2T</MudSelectItem>
                                                <MudSelectItem Value="@("T5T")">T5T</MudSelectItem>
                                                <MudSelectItem Value="@("T10T")">T10T</MudSelectItem>
                                                <MudSelectItem Value="@("T15T")">T15T</MudSelectItem>
                                                <MudSelectItem Value="@("T20T")">T20T</MudSelectItem>
                                                <MudSelectItem Value="@("TRC")">TRC</MudSelectItem>
                                                <MudSelectItem Value="@("TRS")">TRS</MudSelectItem>
                                                <MudSelectItem Value="@("MOOCFL")">MOOCFL</MudSelectItem>
                                                <MudSelectItem Value="@("MOOCCL")">MOOCCL</MudSelectItem>
                                                <MudSelectItem Value="@("MOOCRT")">MOOCRT</MudSelectItem>
                                                <MudSelectItem Value="@("MOOCLT")">MOOCLT</MudSelectItem>
                                                <MudSelectItem Value="@("MOOCB")">MOOCB</MudSelectItem>
                                            </MudSelect>
