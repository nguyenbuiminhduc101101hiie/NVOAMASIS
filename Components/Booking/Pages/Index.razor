    // ---------- Chọn cột hiển thị (lưu theo trình duyệt) ----------
    const string BkColsStorageKey = "booking61.hiddenCols";
    static readonly string[] BkDefaultHidden = { "dept", "imex", "code", "sale", "attn", "agency", "principle", "carrier", "coload", "vessel", "voy", "por", "pot",
        "commodity", "volume", "weight", "payment", "sicutoff", "vgm", "cargoclosing", "depot", "pickup", "dropoff", "ops", "remarks" };
    HashSet<string> _bkHidden = new(BkDefaultHidden);
    bool _bkColsLoaded;

    List<(string Key, string Label)> BkColumnDefs => new()
    {
        ("bkcarrier", BkCarrierTitle), ("customer", Localizer["Customer"]), ("status", Localizer["status"]), ("type", "FCL / LCL / Air"),
        ("pol", "POL"), ("pod", "POD"), ("eta", "ETA"), ("etd", "ETD"), ("approve", Localizer["Approve"]), ("user", Localizer["UserUpdate"]),
        ("updatetime", Localizer["Dateupdate"]), ("quotation", "Quotation"),
        ("dept", "Dept."), ("imex", "IM / EX"), ("code", "Code"), ("sale", "Sale"), ("attn", "Attn"), ("agency", Localizer["Agency_Name"]), ("principle", "Principle"),
        ("carrier", "Carrier"), ("coload", "VIA (Coload)"), ("vessel", "Vessel"), ("voy", "Voy"), ("por", "POR"), ("pot", "POT"),
        ("commodity", "Commodity"), ("volume", "Volume"), ("weight", "Weight / CBM / PKG"), ("payment", "Payment"),
        ("sicutoff", "SI Cut-off"), ("vgm", "VGM Closing"), ("cargoclosing", "Cargo Closing"), ("depot", "Empty depot"),
        ("pickup", "Pickup at"), ("dropoff", "Drop off"), ("ops", "OPS"), ("remarks", "Remarks")
    };

    string BkHiddenCss => _bkHidden.Count == 0 ? string.Empty
        : string.Join(",", _bkHidden.Select(k => $".booking-grid .bkc-{k}")) + "{display:none !important;}";

    async Task SetBkColumnVisible(string key, bool visible)
    {
        if (visible) _bkHidden.Remove(key); else _bkHidden.Add(key);
        await SaveBkColumnsAsync();
    }

    async Task SetAllBkColumns(bool visible)
    {
        _bkHidden = visible ? new() : BkColumnDefs.Select(c => c.Key).ToHashSet();
        await SaveBkColumnsAsync();
    }

    async Task ResetBkColumns()
    {
        _bkHidden = new(BkDefaultHidden);
        await SaveBkColumnsAsync();
    }

    async Task SaveBkColumnsAsync()
    {
        try { await BkJs.InvokeVoidAsync("localStorage.setItem", BkColsStorageKey, string.Join(",", _bkHidden)); } catch { }
    }

    async Task LoadBkColumnsAsync()
    {
        if (_bkColsLoaded) return;
        _bkColsLoaded = true;
        try
        {
            var saved = await BkJs.InvokeAsync<string?>("localStorage.getItem", BkColsStorageKey);
            if (saved != null)
            {
                var valid = BkColumnDefs.Select(c => c.Key).ToHashSet();
                _bkHidden = saved.Split(',', StringSplitOptions.RemoveEmptyEntries).Where(valid.Contains).ToHashSet();
                StateHasChanged();
            }
        }
        catch { }
    }

    // ---------- Rê chuột vào Quotation: chi tiết + Item / Party của Debit, Credit ----------
    Dictionary<Guid, M_Quotation> _quoById = new();
    Dictionary<Guid, List<(string Item, string Party)>> _quoDebitLines = new();
    Dictionary<Guid, List<(string Item, string Party)>> _quoCreditLines = new();

    string QuoNoOf(Models.Booking b) => b.quotationID != Guid.Empty && _quoNoById.TryGetValue(b.quotationID, out var n) ? n : string.Empty;

    async Task LoadQuotationLinesAsync()
    {
        try
        {
            var ids = listImport.Select(x => x.quotationID).Where(x => x != Guid.Empty).Distinct().ToList();
            if (ids.Count == 0) return;
            await using var ctx = await BkDbFactory.CreateDbContextAsync();
            var quos = await ctx.Quotation.AsNoTracking().Where(q => ids.Contains(q.quotationID)).ToListAsync();
            var debits = await ctx.Debit.AsNoTracking().Where(d => ids.Contains(d.quotationid)).Select(d => new { d.quotationid, d.itemid, d.customerid }).ToListAsync();
            var credits = await ctx.Credit.AsNoTracking().Where(c => ids.Contains(c.quotationid)).Select(c => new { c.quotationid, c.itemid, c.customerid }).ToListAsync();
            var itemIds = debits.Select(x => x.itemid).Concat(credits.Select(x => x.itemid)).Distinct().ToList();
            var charges = await ctx.Charge.AsNoTracking().Where(c => itemIds.Contains(c.CHARGE_ID)).ToDictionaryAsync(c => c.CHARGE_ID);
            string Item(Guid id) => charges.TryGetValue(id, out var c) ? (string.IsNullOrWhiteSpace(c.CHARGE_CODE) ? c.CHARGE ?? "" : $"{c.CHARGE_CODE} - {c.CHARGE}") : "";
            string Party(Guid id) => CustomerList.FirstOrDefault(x => x.Customer_ID == id && id != Guid.Empty)?.CodeName() ?? "";
            _quoById = quos.GroupBy(q => q.quotationID).ToDictionary(g => g.Key, g => g.First());
            _quoDebitLines = debits.GroupBy(d => d.quotationid).ToDictionary(g => g.Key, g => g.Select(d => (Item(d.itemid), Party(d.customerid))).ToList());
            _quoCreditLines = credits.GroupBy(c => c.quotationid).ToDictionary(g => g.Key, g => g.Select(c => (Item(c.itemid), Party(c.customerid))).ToList());
            StateHasChanged();
        }
        catch { }
    }

    RenderFragment QuotationHoverCard(Guid qid) => __builder =>
    {
        _quoById.TryGetValue(qid, out var q);
        <div class="bk-hover-card">
            <div class="bk-hover-title">Quotation @(q?.quotationNo ?? (_quoNoById.TryGetValue(qid, out var qn) ? qn : ""))</div>
            @if (q != null)
            {
                <table>
                    @HoverRow(Localizer["Customer"], CustomerList.FirstOrDefault(x => x.Customer_ID == q.customer_id && q.customer_id != Guid.Empty)?.CodeName())
                    @HoverRow("Subject", q.Subject)
                    @HoverRow("Type", q.type)
                    @HoverRow("POL → POD", string.IsNullOrWhiteSpace(q.pol) && string.IsNullOrWhiteSpace(q.pod) ? null : $"{q.pol} → {q.pod}")
                    @HoverRow("Transit", q.Transitport)
                    @HoverRow("Carrier", q.shippingline)
                    @HoverRow("Valid", q.validDate?.ToString("dd/MM/yyyy"))
                    @HoverRow("Sale", q.SaleName)
                </table>
            }
            @QuoLinesBlock("Debit", _quoDebitLines.TryGetValue(qid, out var dl) ? dl : new())
            @QuoLinesBlock("Credit", _quoCreditLines.TryGetValue(qid, out var cl) ? cl : new())
        </div>
    };

    RenderFragment QuoLinesBlock(string caption, List<(string Item, string Party)> lines) => __builder =>
    {
        <div class="bk-quo-sub">@caption (@lines.Count)</div>
        @if (lines.Count > 0)
        {
            <table>
                @foreach (var l in lines)
                {
                    <tr><td class="bk-hover-v">@l.Item</td><td class="bk-hover-k">@l.Party</td></tr>
                }
            </table>
        }
    };
