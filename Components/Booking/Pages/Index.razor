@using Microsoft.EntityFrameworkCore
@page "/Booking_Request"
@using System.Net
@using System.Diagnostics

@inject ShipmentService shipsv
@inject SharedServices ssv
@inject TrainScheduleServices trainsv
@inject BookingService bksv
@inject AccountService asv
@inject CustomerService Cussv
@inject SupportServices supsv
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NotificationService _notificationService
@inject GlobalServices gsv

@inject IStringLocalizer<SharedResource> Localizer
@inject HistoryLogService HistoryLogService
@inject QuotationService QuoSV
@inject IJSRuntime BkJs
@inject Microsoft.EntityFrameworkCore.IDbContextFactory<NVOAMASIS.Data.AppDbContext> BkDbFactory
@using System.Reflection;
@using System.Text;
@using System.Text.Json;

@attribute [Authorize]

<PageTitle>@Localizer["Request_to_get_booking"]</PageTitle>


<div class="product-price-page">
<MudContainer MaxWidth="MaxWidth.False" Class="booking-page px-3 py-3">
    <PpScreenHeader Title="@Localizer["Request_to_get_booking"]" Subtitle="@Localizer["BookingRequest_Subtitle"]">
        <Toolbar>
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.FlexEnd" Class="booking-actions flex-wrap">
                <MudTextField @bind-Value="search_BookingNo"
                              Placeholder="Search booking no..."
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Immediate="true"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              Class="booking-search" />

                <MudMenu Icon="@Icons.Material.Filled.ViewColumn" Size="Size.Small" Dense="true" Color="Color.Primary"
                         AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft" title="Chọn cột hiển thị">
                    <div class="bk-colmenu" @onclick:stopPropagation="true">
                        <div class="bk-colmenu-head">
                            <b>Chọn cột hiển thị</b>
                            <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => SetAllBkColumns(true))">Hiện tất cả</MudButton>
                            <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="ResetBkColumns">Mặc định</MudButton>
                        </div>
                        @foreach (var col in BkColumnDefs)
                        {
                            <MudCheckBox T="bool" Value="@(!_bkHidden.Contains(col.Key))" ValueChanged="@(v => SetBkColumnVisible(col.Key, v))"
                                         Label="@col.Label" Dense="true" Size="Size.Small" Color="Color.Primary" />
                        }
                    </div>
                </MudMenu>
                <MudText Typo="Typo.caption" Style="white-space:nowrap;">Cột (@(BkColumnDefs.Count - _bkHidden.Count)/@BkColumnDefs.Count)</MudText>

                <MudButton OnClick="HandleRefresh"
                           Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled"
                           Class="action-btn"
                           StartIcon="@Icons.Material.Filled.Refresh">
                    @Localizer["reload"]
                </MudButton>

                <MudButton @onclick="@((e) => OpenCreateDialog(new Models.Booking()))"
                           Size="Size.Small" Color="Color.Secondary" Variant="Variant.Filled"
                           Class="action-btn"
                           StartIcon="@Icons.Material.Filled.Add">
                    @Localizer["new"]
                </MudButton>

                <MudButton @onclick="@((e) => OpenEditDialog(Booking_Detail))"
                           Size="Size.Small" Color="Color.Info" Variant="Variant.Filled"
                           Class="action-btn"
                           StartIcon="@Icons.Material.Filled.Edit">
                    @Localizer["edit"]
                </MudButton>

                <MudButton OnClick="Delete"
                           Size="Size.Small" Color="Color.Error" Variant="Variant.Filled"
                           Class="action-btn"
                           StartIcon="@Icons.Material.Filled.Delete">
                    @Localizer["delete"]
                </MudButton>

                <MudButton @onclick="@(() => OpenDialogDuplicate(Booking_Detail))"
                           Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined"
                           Class="action-btn"
                           StartIcon="@Icons.Material.Filled.CopyAll">
                    @Localizer["duplicate"]
                </MudButton>

                <MudButton @onclick="@(() => ExportBill())"
                           Size="Size.Small" Color="Color.Error" Variant="Variant.Outlined"
                           Class="action-btn"
                           StartIcon="@Icons.Material.Filled.Download">
                    @Localizer["Export_Bill"]
                </MudButton>

                <MudTooltip Text="Tạo Job từ booking đang chọn">
                    <MudButton OnClick="CreateJobFromBooking"
                               Size="Size.Small" Color="Color.Success" Variant="Variant.Filled"
                               Class="action-btn"
                               StartIcon="@Icons.Material.Filled.PostAdd">
                        Tạo Job
                    </MudButton>
                </MudTooltip>
            </MudStack>
        </Toolbar>
    </PpScreenHeader>

    <MudPaper Class="booking-grid-card product-price-card" Elevation="0">
        <MudDataGrid T="Models.Booking" Items="@listImport.ToList()"
                     Class="booking-grid"
                     Filterable="true" QuickFilter="@FilterFunc1"
                     FilterMode="@DataGridFilterMode.ColumnFilterRow" Dense="true" Virtualize="true"
                     RowClick="@RowClicked" Bordered="false" Hover="true" Striped="true"
                     FixedHeader="true" FixedFooter="true" Height="calc(100vh - 235px)"
                     HeaderClass="no-wrap booking-grid-header" FooterClass="no-wrap booking-grid-footer"
                     EditTrigger="DataGridEditTrigger.Manual" ReadOnly="false" CommittedItemChanges="@((t)=>CommittedItemChanges(t))"
                     RowClassFunc="@SelectedRowClassFunc"
                     ColumnResizeMode="ResizeMode.Column" @ref="mudTable"
                     Hideable="true">

            <Columns>

                <HierarchyColumn T="Models.Booking" Title="" />

                <PropertyColumn Property="x => x.ContainerOutBoundNotifyId" Title="@(Localizer["ID"])" Hidden="true">
                    <FooterTemplate>ID</FooterTemplate>
                </PropertyColumn>

                <PropertyColumn Property="x => x.BookingNo" Title="@(Localizer["BookingNo"])" CellStyleFunc="_cellStyleFunc" Hideable="false">
                    <CellTemplate>
                        <MudTooltip Arrow="true" Placement="Placement.Right">
                            <ChildContent>
                                <span class="bk-hover-no">@context.Item.BookingNo</span>
                            </ChildContent>
                            <TooltipContent>
                                @BookingHoverCard(context.Item)
                            </TooltipContent>
                        </MudTooltip>
                    </CellTemplate>
                    <FooterTemplate>@Localizer["BookingNo"]</FooterTemplate>
                </PropertyColumn>

                <PropertyColumn HeaderClass="bkc-bkcarrier" CellClass="bkc-bkcarrier" FooterClass="bkc-bkcarrier" Property="x => x.bkcarrier" Title="@BkCarrierTitle" CellStyleFunc="_cellStyleFunc">
                    <FooterTemplate>@BkCarrierTitle</FooterTemplate>
                </PropertyColumn>

                <PropertyColumn HeaderClass="bkc-customer" CellClass="bkc-customer" FooterClass="bkc-customer" Property="x => CustomerName(x.MaincusBk_Id_)" Title="@(Localizer["Customer"])" CellStyleFunc="_cellStyleFunc">
                    <EditTemplate>
                        <MudSelect @bind-Value="context.Item.MaincusBk_Id_" Label="@(Localizer["Customer"])">
                            @foreach (var item in CustomerList)
                            {
                                <MudSelectItem Value="@item.Customer_ID">@item.CodeName()</MudSelectItem>
                            }
                        </MudSelect>
                    </EditTemplate>
                    <FooterTemplate>@Localizer["Customer"]</FooterTemplate>
                </PropertyColumn>

                <PropertyColumn HeaderClass="bkc-status" CellClass="bkc-status" FooterClass="bkc-status" Property="x => x.trangthai" Title="@(Localizer["status"])" CellStyleFunc="_cellStyleFunc">
                    <FooterTemplate>@Localizer["status"]</FooterTemplate>
                </PropertyColumn>


                <PropertyColumn HeaderClass="bkc-type" CellClass="bkc-type" FooterClass="bkc-type" Property="x => x.FCL_LCL_Air" Title="@(Localizer["FCL/LCL/Air"])" CellStyleFunc="_cellStyleFunc">
                    <FooterTemplate>@Localizer["FCL_LCL_Air"]</FooterTemplate>
                </PropertyColumn>

                <PropertyColumn HeaderClass="bkc-pol" CellClass="bkc-pol" FooterClass="bkc-pol" Property="x => x.hano_POL" Title="@(Localizer["POL"])" CellStyleFunc="_cellStyleFunc">
                    <FooterTemplate>@Localizer["POL"]</FooterTemplate>
                </PropertyColumn>

                <PropertyColumn HeaderClass="bkc-pod" CellClass="bkc-pod" FooterClass="bkc-pod" Property="x => x.hano_POD" Title="@(Localizer["POD"])" CellStyleFunc="_cellStyleFunc">
                    <FooterTemplate>@Localizer["POD"]</FooterTemplate>
                </PropertyColumn>

                <PropertyColumn HeaderClass="bkc-eta" CellClass="bkc-eta" FooterClass="bkc-eta" Property="x => x.ETA" Title="@(Localizer["ETA"])" Format="dd/MM/yyyy" CellStyleFunc="_cellStyleFunc">
                    <FooterTemplate>@Localizer["ETA"]</FooterTemplate>
                </PropertyColumn>

                <PropertyColumn HeaderClass="bkc-etd" CellClass="bkc-etd" FooterClass="bkc-etd" Property="x => x.ETD" Title="@(Localizer["ETD"])" Format="dd/MM/yyyy" CellStyleFunc="_cellStyleFunc">
                    <FooterTemplate>@Localizer["ETD"]</FooterTemplate>
                </PropertyColumn>

                <TemplateColumn HeaderClass="bkc-approve" CellClass="bkc-approve" FooterClass="bkc-approve" Title="@Localizer["Approve"]">
                    <CellTemplate>
                        <MudCheckBox @bind-Checked="context.Item.Approve" @bind-Value="context.Item.Approve" @bind-Value:after="@(()=> OnApproveCheckboxWrapper(context.Item))" />
                    </CellTemplate>
                    <FooterTemplate>@Localizer["Approve"]</FooterTemplate>
                </TemplateColumn>

                <PropertyColumn HeaderClass="bkc-user" CellClass="bkc-user" FooterClass="bkc-user" Property="x => x.UserID" Title="@(Localizer["UserUpdate"])" CellStyleFunc="_cellStyleFunc">
                    <FooterTemplate>@Localizer["UserUpdate"]</FooterTemplate>
                </PropertyColumn>

                <PropertyColumn HeaderClass="bkc-updatetime" CellClass="bkc-updatetime" FooterClass="bkc-updatetime" Property="x => x.UpdateTime" Title="@(Localizer["Dateupdate"])" CellStyleFunc="_cellStyleFunc">
                    <FooterTemplate>@Localizer["Dateupdate"]</FooterTemplate>
                </PropertyColumn>

                @* ---- Cột thêm (ẩn / hiện bằng nút chọn cột) ---- *@
                <PropertyColumn HeaderClass="bkc-quotation" CellClass="bkc-quotation" FooterClass="bkc-quotation" Property="x => QuoNoOf(x)" Title="Quotation" CellStyleFunc="_cellStyleFunc">
                    <CellTemplate>
                        @if (!string.IsNullOrWhiteSpace(QuoNoOf(context.Item)))
                        {
                            <MudTooltip Arrow="true" Placement="Placement.Right">
                                <ChildContent><span class="bk-hover-no">@QuoNoOf(context.Item)</span></ChildContent>
                                <TooltipContent>@QuotationHoverCard(context.Item.quotationID)</TooltipContent>
                            </MudTooltip>
                        }
                    </CellTemplate>
                    <FooterTemplate>Quotation</FooterTemplate>
                </PropertyColumn>
                <PropertyColumn HeaderClass="bkc-dept" CellClass="bkc-dept" FooterClass="bkc-dept" Property="x => x.iol" Title="Dept." CellStyleFunc="_cellStyleFunc">
                    <FooterTemplate>Dept.</FooterTemplate>
                </PropertyColumn>
                <PropertyColumn HeaderClass="bkc-imex" CellClass="bkc-imex" FooterClass="bkc-imex" Property="x => x.Lo" Title="IM / EX" CellStyleFunc="_cellStyleFunc">
                    <FooterTemplate>IM / EX</FooterTemplate>
                </PropertyColumn>
                <PropertyColumn HeaderClass="bkc-code" CellClass="bkc-code" FooterClass="bkc-code" Property="x => x.Code" Title="Code" CellStyleFunc="_cellStyleFunc">
                    <FooterTemplate>Code</FooterTemplate>
                </PropertyColumn>
                <PropertyColumn HeaderClass="bkc-sale" CellClass="bkc-sale" FooterClass="bkc-sale" Property="x => x.SaleName" Title="Sale" CellStyleFunc="_cellStyleFunc">
                    <FooterTemplate>Sale</FooterTemplate>
                </PropertyColumn>
                <PropertyColumn HeaderClass="bkc-attn" CellClass="bkc-attn" FooterClass="bkc-attn" Property="x => x.ATTN" Title="Attn" CellStyleFunc="_cellStyleFunc">
                    <FooterTemplate>Attn</FooterTemplate>
                </PropertyColumn>
                <PropertyColumn HeaderClass="bkc-agency" CellClass="bkc-agency" FooterClass="bkc-agency" Property="x => x.agencyname_box" Title="@Localizer["Agency_Name"]" CellStyleFunc="_cellStyleFunc">
                    <FooterTemplate>@Localizer["Agency_Name"]</FooterTemplate>
                </PropertyColumn>
                <PropertyColumn HeaderClass="bkc-principle" CellClass="bkc-principle" FooterClass="bkc-principle" Property="x => x.principle" Title="Principle" CellStyleFunc="_cellStyleFunc">
                    <FooterTemplate>Principle</FooterTemplate>
                </PropertyColumn>
                <PropertyColumn HeaderClass="bkc-carrier" CellClass="bkc-carrier" FooterClass="bkc-carrier" Property="x => x.Carrier" Title="Carrier" CellStyleFunc="_cellStyleFunc">
                    <FooterTemplate>Carrier</FooterTemplate>
                </PropertyColumn>
                <PropertyColumn HeaderClass="bkc-coload" CellClass="bkc-coload" FooterClass="bkc-coload" Property="x => x.hanoLCL_BookingPIC" Title="VIA (Coload)" CellStyleFunc="_cellStyleFunc">
                    <FooterTemplate>VIA (Coload)</FooterTemplate>
                </PropertyColumn>
                <PropertyColumn HeaderClass="bkc-vessel" CellClass="bkc-vessel" FooterClass="bkc-vessel" Property="x => x.Vessel" Title="Vessel" CellStyleFunc="_cellStyleFunc">
                    <FooterTemplate>Vessel</FooterTemplate>
                </PropertyColumn>
                <PropertyColumn HeaderClass="bkc-voy" CellClass="bkc-voy" FooterClass="bkc-voy" Property="x => x.VoyNo" Title="Voy" CellStyleFunc="_cellStyleFunc">
                    <FooterTemplate>Voy</FooterTemplate>
                </PropertyColumn>
                <PropertyColumn HeaderClass="bkc-por" CellClass="bkc-por" FooterClass="bkc-por" Property="x => x.hano_POR" Title="POR" CellStyleFunc="_cellStyleFunc">
                    <FooterTemplate>POR</FooterTemplate>
                </PropertyColumn>
                <PropertyColumn HeaderClass="bkc-pot" CellClass="bkc-pot" FooterClass="bkc-pot" Property="x => x.hano_POT" Title="POT" CellStyleFunc="_cellStyleFunc">
                    <FooterTemplate>POT</FooterTemplate>
                </PropertyColumn>
                <PropertyColumn HeaderClass="bkc-commodity" CellClass="bkc-commodity" FooterClass="bkc-commodity" Property="x => x.hano_Commodity" Title="Commodity" CellStyleFunc="_cellStyleFunc">
                    <FooterTemplate>Commodity</FooterTemplate>
                </PropertyColumn>
                <PropertyColumn HeaderClass="bkc-volume" CellClass="bkc-volume" FooterClass="bkc-volume" Property="x => x.hanoFCL_Quality" Title="Volume" CellStyleFunc="_cellStyleFunc">
                    <FooterTemplate>Volume</FooterTemplate>
                </PropertyColumn>
                <PropertyColumn HeaderClass="bkc-weight" CellClass="bkc-weight" FooterClass="bkc-weight" Property="x => x.hano_WeightCBMPKG" Title="Weight / CBM / PKG" CellStyleFunc="_cellStyleFunc">
                    <FooterTemplate>Weight / CBM / PKG</FooterTemplate>
                </PropertyColumn>
                <PropertyColumn HeaderClass="bkc-payment" CellClass="bkc-payment" FooterClass="bkc-payment" Property="x => x.hano_Payment" Title="Payment" CellStyleFunc="_cellStyleFunc">
                    <FooterTemplate>Payment</FooterTemplate>
                </PropertyColumn>
                <PropertyColumn HeaderClass="bkc-sicutoff" CellClass="bkc-sicutoff" FooterClass="bkc-sicutoff" Property="x => x.SICutOff" Title="SI Cut-off" CellStyleFunc="_cellStyleFunc">
                    <FooterTemplate>SI Cut-off</FooterTemplate>
                </PropertyColumn>
                <PropertyColumn HeaderClass="bkc-vgm" CellClass="bkc-vgm" FooterClass="bkc-vgm" Property="x => x.hano_Closing" Title="VGM Closing" CellStyleFunc="_cellStyleFunc">
                    <FooterTemplate>VGM Closing</FooterTemplate>
                </PropertyColumn>
                <PropertyColumn HeaderClass="bkc-cargoclosing" CellClass="bkc-cargoclosing" FooterClass="bkc-cargoclosing" Property="x => x.hano_Closingdelivery" Title="Cargo Closing" CellStyleFunc="_cellStyleFunc">
                    <FooterTemplate>Cargo Closing</FooterTemplate>
                </PropertyColumn>
                <PropertyColumn HeaderClass="bkc-depot" CellClass="bkc-depot" FooterClass="bkc-depot" Property="x => x.Emptydepot" Title="Empty depot" CellStyleFunc="_cellStyleFunc">
                    <FooterTemplate>Empty depot</FooterTemplate>
                </PropertyColumn>
                <PropertyColumn HeaderClass="bkc-pickup" CellClass="bkc-pickup" FooterClass="bkc-pickup" Property="x => x.PickupAt" Title="Pickup at" CellStyleFunc="_cellStyleFunc">
                    <FooterTemplate>Pickup at</FooterTemplate>
                </PropertyColumn>
                <PropertyColumn HeaderClass="bkc-dropoff" CellClass="bkc-dropoff" FooterClass="bkc-dropoff" Property="x => x.DropOff" Title="Drop off" CellStyleFunc="_cellStyleFunc">
                    <FooterTemplate>Drop off</FooterTemplate>
                </PropertyColumn>
                <PropertyColumn HeaderClass="bkc-ops" CellClass="bkc-ops" FooterClass="bkc-ops" Property="x => x.OPSCode" Title="OPS" CellStyleFunc="_cellStyleFunc">
                    <FooterTemplate>OPS</FooterTemplate>
                </PropertyColumn>
                <PropertyColumn HeaderClass="bkc-remarks" CellClass="bkc-remarks" FooterClass="bkc-remarks" Property="x => x.remarksFCL" Title="Remarks" CellStyleFunc="_cellStyleFunc">
                    <FooterTemplate>Remarks</FooterTemplate>
                </PropertyColumn>

            </Columns>

            <ChildRowContent>
                <MudPaper Class="booking-detail-panel pa-3" Elevation="0">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2 booking-detail-title-wrap">
                        <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" />
                        <MudText Typo="Typo.subtitle2" Class="booking-detail-title">Chi tiết booking: @context.Item.BookingNo</MudText>
                    </MudStack>

                    <MudGrid Spacing="2">
                        <MudItem xs="12" sm="6" md="3">
                            <div class="detail-item"><span>@Localizer["vat"]</span><b>@context.Item.vat</b></div>
                        </MudItem>
                        <MudItem xs="12" sm="6" md="3">
                            <div class="detail-item"><span>@Localizer["Agency_Name"]</span><b>@context.Item.agencyname_box</b></div>
                        </MudItem>
                        <MudItem xs="12" sm="6" md="3">
                            <div class="detail-item"><span>Principle</span><b>@context.Item.principle</b></div>
                        </MudItem>
                        <MudItem xs="12" sm="6" md="3">
                            <div class="detail-item"><span>@Localizer["Master_Bill/Air"]</span><b>@context.Item.hanoAir_Freightrateterm</b></div>
                        </MudItem>
                        <MudItem xs="12" sm="6" md="3">
                            <div class="detail-item"><span>@Localizer["House_Bill"]</span><b>@context.Item.hanoAIr_MAWBHAWBNo</b></div>
                        </MudItem>
                        <MudItem xs="12" sm="6" md="3">
                            <div class="detail-item"><span>@Localizer["VIA_(Coload)"]</span><b>@context.Item.hanoLCL_BookingPIC</b></div>
                        </MudItem>
                        <MudItem xs="12" sm="6" md="3">
                            <div class="detail-item"><span>@Localizer["PackageQuantity"]</span><b>@context.Item.thoigian4</b></div>
                        </MudItem>
                        <MudItem xs="12" sm="6" md="3">
                            <div class="detail-item"><span>@Localizer["KGS"]</span><b>@context.Item.hano_WeightCBMPKG</b></div>
                        </MudItem>
                        <MudItem xs="12" sm="6" md="3">
                            <div class="detail-item"><span>@Localizer["CBM"]</span><b>@context.Item.congviecthuchien4</b></div>
                        </MudItem>
                        <MudItem xs="12" sm="6" md="3">
                            <div class="detail-item"><span>@Localizer["Vessel/Fly"]</span><b>@context.Item.Vessel</b></div>
                        </MudItem>
                        <MudItem xs="12" sm="6" md="3">
                            <div class="detail-item"><span>@Localizer["Pickup"]</span><b>@context.Item.EmpContReDate</b></div>
                        </MudItem>
                        <MudItem xs="12" sm="6" md="3">
                            <div class="detail-item"><span>@Localizer["Dest"]</span><b>@context.Item.codedest</b></div>
                        </MudItem>
                        <MudItem xs="12" sm="6" md="3">
                            <div class="detail-item"><span>@Localizer["bophan"]</span><b>@context.Item.iol</b></div>
                        </MudItem>
                    </MudGrid>
                </MudPaper>
            </ChildRowContent>

            <PagerContent>
                <MudDataGridPager T="Models.Booking" PageSizeOptions="@(new int[] { 8, 10, 20 })" />
            </PagerContent>

        </MudDataGrid>

    </MudPaper>
</MudContainer>
</div>



<style>@BkHiddenCss</style>
<style>
    .bk-colmenu { padding: 6px 12px; max-height: 70vh; overflow-y: auto; min-width: 240px; }
    .bk-colmenu-head { display: flex; align-items: center; gap: 4px; margin-bottom: 4px; }
    .bk-hover-card .bk-quo-sub { font-weight: 700; margin: 6px 0 2px; }
    /* Rê chuột vào số Booking: thẻ chi tiết */
    .bk-hover-no { cursor: help; border-bottom: 1px dotted currentColor; }
    .bk-hover-card { min-width: 280px; max-width: 420px; text-align: left; padding: 2px; }
    .bk-hover-title { font-weight: 700; font-size: 13px; margin-bottom: 4px; }
    .bk-hover-card table { border-collapse: collapse; font-size: 12px; }
    .bk-hover-card td { padding: 1px 6px 1px 0; vertical-align: top; }
    .bk-hover-k { opacity: .75; white-space: nowrap; }
    .bk-hover-v { font-weight: 600; }
    .booking-page {
        background: linear-gradient(180deg, #f8fafc 0%, #eef2f7 100%);
        min-height: calc(100vh - 64px);
    }

    .booking-toolbar,
    .booking-grid-card {
        border: 1px solid #e5e7eb;
        border-radius: 18px;
        background: rgba(255, 255, 255, 0.94);
        box-shadow: 0 12px 30px rgba(15, 23, 42, 0.06);
    }

    .booking-title {
        font-weight: 800;
        color: #0f172a;
        letter-spacing: -0.02em;
    }

    .booking-subtitle {
        color: #64748b;
        margin-top: 2px;
    }

    .booking-toolbar-content {
        gap: 16px;
        flex-wrap: wrap;
    }

    .booking-actions {
        gap: 8px;
        flex-wrap: wrap;
    }

    .booking-search {
        width: 260px;
        min-width: 220px;
    }

    .action-btn {
        border-radius: 999px;
        text-transform: none;
        font-weight: 700;
        min-height: 34px;
        box-shadow: none !important;
    }

    .booking-grid-card {
        overflow: hidden;
    }

    .booking-grid {
        font-size: 12.5px;
    }

        .booking-grid .mud-table-container,
        .booking-grid .mud-data-grid {
            border-radius: 18px;
        }

        .booking-grid th,
        .booking-grid .mud-table-head .mud-table-cell {
            background: #0f172a !important;
            color: #ffffff !important;
            font-size: 12px;
            font-weight: 800;
            letter-spacing: .01em;
            height: 42px;
            padding: 6px 10px !important;
            border-bottom: 0 !important;
            white-space: nowrap;
        }

        .booking-grid td,
        .booking-grid .mud-table-body .mud-table-cell {
            height: 38px;
            padding: 5px 10px !important;
            border-bottom: 1px solid #edf2f7 !important;
            vertical-align: middle;
            white-space: nowrap;
            max-width: 220px;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .booking-grid .mud-table-row:hover td {
            background: #eef6ff !important;
        }

        .booking-grid .selected td,
        .booking-grid tr.selected td {
            background: #dbeafe !important;
            box-shadow: inset 4px 0 0 #2563eb;
            font-weight: 700;
        }

        .booking-grid .mud-table-foot .mud-table-cell {
            background: #f8fafc !important;
            color: #475569;
            font-size: 11.5px;
            font-weight: 700;
            padding: 6px 10px !important;
            border-top: 1px solid #e5e7eb !important;
            white-space: nowrap;
        }

        .booking-grid .mud-input-root,
        .booking-grid .mud-input-slot,
        .booking-grid input {
            font-size: 12px !important;
        }

        .booking-grid .mud-checkbox {
            margin: 0 auto;
            display: flex;
            justify-content: center;
        }

        .custom-colorfillter,
        .booking-grid .mud-table-head .mud-table-row:nth-child(2) .mud-table-cell {
            background: #f1f5f9 !important;
            color: #0f172a !important;
            padding: 4px 8px !important;
        }

    .no-wrap {
        white-space: nowrap;
    }



    .booking-grid .booking-row-selected td,
    .booking-grid tr.booking-row-selected td,
    .booking-grid .selected td,
