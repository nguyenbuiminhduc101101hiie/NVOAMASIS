@page "/Booking_Request"
@using System.Net
@using System.Diagnostics

@inject ShipmentService shipsv
@inject SharedServices ssv
@inject TrainScheduleServices  trainsv
@inject BookingService bksv
@inject AccountService asv
@inject CustomerService Cussv
@inject SupportServices supsv
@inject ISnackbar Snackbar
@inject IDialogService DialogService

@inject IStringLocalizer<SharedResource> Localizer
@inject HistoryLogService HistoryLogService
@using System.Text.Json;

@attribute [Authorize]

<PageTitle>@Localizer["Request_to_get_booking"]</PageTitle>


<MudContainer MaxWidth=MaxWidth.False>
    <MudStack Class="pa-2" Style="font-size:xx-large; font-weight: bolder">@Localizer["Request_to_get_booking"]</MudStack>
    <MudStack Row="true" Justify="Justify.FlexEnd" Class="pa-2 gap-12 ">
      @*   <MudTextField @bind-Value="search_BookingNo" Placeholder="Search"
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                      IconSize="Size.Medium" AdornmentColor="Color.Primary">
        </MudTextField> *@
        <MudButton HtmlTag="label"
                   OnClick="HandleRefresh"
                   Size="Size.Small" Color="Color.Primary" Variant="   Variant.Filled"
                   StartIcon="@Icons.Material.Filled.Refresh">
            @Localizer["reload"]
        </MudButton>
        <MudButton HtmlTag="label"
                   @onclick="@((e) => OpenCreateDialog(new Models.Booking()))"
                   Size="Size.Small" Color="Color.Secondary" Variant="Variant.Filled"
                   StartIcon="@Icons.Material.Filled.Add">
            @Localizer["new"]
        </MudButton>
        <MudButton HtmlTag="label"
                   @onclick="@((e) => OpenEditDialog(Booking_Detail))"
                   Size="Size.Small" Color="Color.Info" Variant="Variant.Filled"
                   StartIcon="@Icons.Material.Filled.Edit">
            @Localizer["edit"]
        </MudButton>

        <MudButton HtmlTag="label"
                   OnClick="Delete"
                   Size="Size.Small" Color="Color.Error" Variant="Variant.Filled"
                   StartIcon="@Icons.Material.Filled.Delete">
            @Localizer["delete"]
        </MudButton>

        <MudButton HtmlTag="label"
                   @onclick="@(() => OpenDialogDuplicate(Booking_Detail))"
                   Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled"
                   StartIcon="@Icons.Material.Filled.CopyAll">
            @Localizer["duplicate"]
        </MudButton>

        <MudButton HtmlTag="label"
                   @onclick="@(() => ExportBill())"
                   Size="Size.Small" Color="Color.Error" Variant="Variant.Filled"
                   StartIcon="@Icons.Material.Filled.Download">
            @Localizer["Export_Bill"]
        </MudButton>

     
    </MudStack>
</MudContainer>

<MudSpacer></MudSpacer>
<MudSpacer></MudSpacer>


<MudContainer MaxWidth=MaxWidth.False>
    <MudDataGrid T="Models.Booking" Items="@listImport.ToList()"  
                 Filterable="true" QuickFilter="@FilterFunc1"
                 FilterMode="@DataGridFilterMode.ColumnFilterRow" Dense="true" Virtualize="true"
                 RowClick="@RowClicked" Bordered="true"
                 FixedHeader="true" FixedFooter="true" HeaderClass="no-wrap" FooterClass="no-wrap"
                 EditTrigger="DataGridEditTrigger.Manual" ReadOnly="false" CommittedItemChanges="@((t)=>CommittedItemChanges(t))"
                 RowClassFunc="@SelectedRowClassFunc"
                 ColumnResizeMode="ResizeMode.Column" @ref="mudTable"
                 Hideable="true">

        <Columns>

            <FilterHeaderCell Class="custom-colorfillter" />

            <PropertyColumn Property="x => x.ContainerOutBoundNotifyId" Title="@(Localizer["ID"])" Hidden="true" >
                <FooterTemplate>
                    ID
                </FooterTemplate>
            </PropertyColumn>

            <PropertyColumn Property="x => x.BookingNo" Title="@(Localizer["BookingNo"])" CellStyleFunc="_cellStyleFunc">
                <FooterTemplate>
                    @Localizer["BookingNo"]
                </FooterTemplate>
            </PropertyColumn>

            <PropertyColumn Property="x => x.bkcarrier" Title="@(Localizer["bkcarrier"])" CellStyleFunc="_cellStyleFunc">
                <FooterTemplate>
                    @Localizer["bkcarrier"]
                </FooterTemplate>
            </PropertyColumn>


            <PropertyColumn Property="x => CustomerName(x.MaincusBk_Id_)" Title="@(Localizer["Customer"])" CellStyleFunc="_cellStyleFunc">
                <EditTemplate>
                    <MudSelect @bind-Value="context.Item.MaincusBk_Id_" Label="@(Localizer["Customer"])">
                        @foreach (var item in CustomerList)
                        {
                            <MudSelectItem Value="@item.Customer_ID">@item.COMPANY</MudSelectItem>
                        }
                    </MudSelect>

                </EditTemplate>
                <FooterTemplate>
                    @Localizer["Customer"]
                </FooterTemplate>
            </PropertyColumn> 


            <PropertyColumn Property="x => x.vat" Title="@(Localizer["vat"])" CellStyleFunc="_cellStyleFunc">
                <FooterTemplate>
                    @Localizer["vat"]
                </FooterTemplate>
            </PropertyColumn>

            <PropertyColumn Property="x => x.trangthai" Title="@(Localizer["status"])" CellStyleFunc="_cellStyleFunc">
                <FooterTemplate>
                    @Localizer["status"]
                </FooterTemplate>
            </PropertyColumn>

            <PropertyColumn Property="x => x.agencyname_box" Title="@(Localizer["Agency_Name"])" CellStyleFunc="_cellStyleFunc">
                <FooterTemplate>
                    @Localizer["Agency_Name"]
                </FooterTemplate>
            </PropertyColumn>

            <PropertyColumn Property="x => x.hanoAir_Freightrateterm" Title="@(Localizer["Master_Bill/Air"])" CellStyleFunc="_cellStyleFunc">
                <FooterTemplate>
                    @Localizer["Master_Bill/Air"]
                </FooterTemplate>
            </PropertyColumn>

            <PropertyColumn Property="x => x.hanoAIr_MAWBHAWBNo" Title="@(Localizer["House_Bill"])" CellStyleFunc="_cellStyleFunc">
                <FooterTemplate>
                    @Localizer["House_Bill"]
                </FooterTemplate>
            </PropertyColumn>

            <PropertyColumn Property="x => x.FCL_LCL_Air" Title="@(Localizer["FCL/LCL/Air"])" CellStyleFunc="_cellStyleFunc">
                <FooterTemplate>
                    @Localizer["FCL_LCL_Air"]
                </FooterTemplate>
            </PropertyColumn>

            <PropertyColumn Property="x => x.hanoLCL_BookingPIC" Title="@(Localizer["VIA_(Coload)"])" CellStyleFunc="_cellStyleFunc">
                <FooterTemplate>
                    @Localizer["VIA_(Coload)"]
                </FooterTemplate>
            </PropertyColumn>

            <PropertyColumn Property="x => x.thoigian4" Title="@(Localizer["PackageQuantity"])" CellStyleFunc="_cellStyleFunc">
                <FooterTemplate>
                    @Localizer["PackageQuantity"]
                </FooterTemplate>
            </PropertyColumn> 

            <PropertyColumn Property="x => x.hano_WeightCBMPKG" Title="@(Localizer["KGS"])" CellStyleFunc="_cellStyleFunc">
                <FooterTemplate>
                    @Localizer["KGS"]
                </FooterTemplate>
            </PropertyColumn>

            <PropertyColumn Property="x => x.congviecthuchien4" Title="@(Localizer["CBM"])" CellStyleFunc="_cellStyleFunc">
                <FooterTemplate>
                    @Localizer["CBM"]
                </FooterTemplate>
            </PropertyColumn>

            <PropertyColumn Property="x => x.Vessel" Title="@(Localizer["Vessel/Fly"])" CellStyleFunc="_cellStyleFunc">
                <FooterTemplate>
                    @Localizer["Vessel/Fly"]
                </FooterTemplate>
            </PropertyColumn>

            <PropertyColumn Property="x => x.EmpContReDate" Title="@(Localizer["Pickup"])" CellStyleFunc="_cellStyleFunc">
                <FooterTemplate>
                    @Localizer["Pickup"]
                </FooterTemplate>
            </PropertyColumn>

            <PropertyColumn Property="x => x.hano_POL" Title="@(Localizer["POL"])" CellStyleFunc="_cellStyleFunc">
                <FooterTemplate>
                    @Localizer["POL"]
                </FooterTemplate>
            </PropertyColumn>

            <PropertyColumn Property="x => x.hano_POD" Title="@(Localizer["POD"])" CellStyleFunc="_cellStyleFunc">
                <FooterTemplate>
                    @Localizer["POD"]
                </FooterTemplate>
            </PropertyColumn>

            <PropertyColumn Property="x => x.codedest" Title="@(Localizer["Dest"])" CellStyleFunc="_cellStyleFunc">
                <FooterTemplate>
                    @Localizer["Dest"]
                </FooterTemplate>
            </PropertyColumn>

            <PropertyColumn Property="x => x.iol" Title="@(Localizer["bophan"])" CellStyleFunc="_cellStyleFunc">
                <FooterTemplate>
                    @Localizer["bophan"]
                </FooterTemplate>
            </PropertyColumn>

            <PropertyColumn Property="x => x.ETA" Title="@(Localizer["ETA"])" CellStyleFunc="_cellStyleFunc"> 
                <FooterTemplate>
                    @Localizer["ETA"]
                </FooterTemplate>
            </PropertyColumn>

            <PropertyColumn Property="x => x.ETD" Title="@(Localizer["ETD"])" CellStyleFunc="_cellStyleFunc">
                <FooterTemplate>
                    @Localizer["ETD"]
                </FooterTemplate>
            </PropertyColumn>

            <TemplateColumn Title="@Localizer["Approve"]">
                <CellTemplate>
                    <MudCheckBox @bind-Checked="context.Item.Approve" @bind-Value="context.Item.Approve" @bind-Value:after="@(()=> OnApproveCheckboxWrapper(context.Item))">
                    </MudCheckBox>
                </CellTemplate>
                <FooterTemplate>
                    @Localizer["Approve"]
                </FooterTemplate>
            </TemplateColumn>

            <PropertyColumn Property="x => x.UserID" Title="@(Localizer["UserUpdate"])" CellStyleFunc="_cellStyleFunc">
                <FooterTemplate>
                    @Localizer["UserUpdate"]
                </FooterTemplate>
            </PropertyColumn>

            <PropertyColumn Property="x => x.UpdateTime" Title="@(Localizer["Dateupdate"])" CellStyleFunc="_cellStyleFunc">
                <FooterTemplate>
