    private async Task SendBookingUpdateNotificationAsync(Booking? oldData, Booking newData)
    {
        try
        {
            var oldHandles = ParseUserHandles(oldData?.OperationCode_);
            var newHandles = ParseUserHandles(newData?.OperationCode_);
            var addedHandles = newHandles.Except(oldHandles, StringComparer.OrdinalIgnoreCase).ToList();
            var removedHandles = oldHandles.Except(newHandles, StringComparer.OrdinalIgnoreCase).ToList();

            // Gửi cho cả list cũ và list mới để user vừa thêm vào handle vẫn nhận noti.
            var recipientNames = oldHandles.Union(newHandles, StringComparer.OrdinalIgnoreCase).ToList();
            var recipients = await ResolveUserIdsFromNamesAsync(recipientNames);
            if (recipients.Count == 0)
                return;

            var summary = BuildBookingChangeSummary(oldData, newData, addedHandles, removedHandles);
            if (string.IsNullOrWhiteSpace(summary))
                return;

            await _notificationService.SendNotificationAsync(recipients.ToArray(), summary);
        }
        catch
        {
            // Save already succeeded; do not fail the edit flow if notify fails.
        }
    }

    private static List<string> ParseUserHandles(string? operationCode)
    {
        if (string.IsNullOrWhiteSpace(operationCode))
            return new List<string>();

        return operationCode
            .Split(',', StringSplitOptions.RemoveEmptyEntries)
            .Select(x => x.Trim())
            .Where(x => !string.IsNullOrEmpty(x))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

    private async Task<List<string>> ResolveUserIdsFromNamesAsync(IEnumerable<string> userNames)
    {
        var listid = new List<string>();
        foreach (var userName in userNames)
        {
            if (string.IsNullOrWhiteSpace(userName))
                continue;

            Guid? inputid = await gsv.GetIdfromUser(userName.Trim());
            if (inputid != null && inputid != Guid.Empty)
                listid.Add(inputid.ToString()!);
        }

        return listid.Distinct().ToList();
    }

    private string BuildBookingChangeSummary(Booking? oldData, Booking newData, List<string> addedHandles, List<string> removedHandles)
    {
        var bookingNo = string.IsNullOrWhiteSpace(newData.BookingNo) ? "(no number)" : newData.BookingNo;
        var header = FormatLocal("BookingUpdatedNotify", "Booking {0} đã được cập nhật bởi {1}.", bookingNo, usr);

        var changes = new List<string>();
        if (addedHandles.Count > 0)
            changes.Add(FormatLocal("BookingHandleAdded", "User handle thêm: {0}", string.Join(", ", addedHandles)));
        if (removedHandles.Count > 0)
            changes.Add(FormatLocal("BookingHandleRemoved", "User handle gỡ: {0}", string.Join(", ", removedHandles)));

        if (oldData != null)
        {
            foreach (var prop in typeof(Booking).GetProperties(BindingFlags.Public | BindingFlags.Instance))
            {
                if (!prop.CanRead || BookingNotifySkipFields.Contains(prop.Name))
                    continue;

                var oldValue = FormatBookingValue(prop.GetValue(oldData));
                var newValue = FormatBookingValue(prop.GetValue(newData));
                if (string.Equals(oldValue, newValue, StringComparison.Ordinal))
                    continue;

                var label = BookingFieldLabels.TryGetValue(prop.Name, out var mapped) ? mapped : prop.Name;
                var empty = FormatLocal("BookingEmptyValue", "(trống)");
                changes.Add($"{label}: {(string.IsNullOrEmpty(oldValue) ? empty : oldValue)} → {(string.IsNullOrEmpty(newValue) ? empty : newValue)}");
            }
        }

        if (changes.Count == 0)
            return string.Empty;

        const int maxLines = 15;
        var sb = new StringBuilder();
        sb.Append(header);
        foreach (var line in changes.Take(maxLines))
        {
            sb.Append('\n');
            sb.Append(line);
        }

        if (changes.Count > maxLines)
        {
            sb.Append('\n');
            sb.Append(FormatLocal("BookingMoreChanges", "... và {0} thay đổi khác.", changes.Count - maxLines));
        }

        return sb.ToString();
    }

    private string FormatLocal(string key, string fallback, params object[] args)
    {
        var localized = Localizer[key];
        var template = localized.ResourceNotFound ? fallback : localized.Value;
        return args.Length == 0 ? template : string.Format(template, args);
    }

    private static string FormatBookingValue(object? value)
    {
        if (value == null)
            return string.Empty;
        if (value is DateTime dt)
            return dt.TimeOfDay == TimeSpan.Zero ? dt.ToString("yyyy-MM-dd") : dt.ToString("yyyy-MM-dd HH:mm");
        if (value is Guid g)
            return g == Guid.Empty ? string.Empty : g.ToString();
        if (value is bool b)
            return b ? "Yes" : "No";

        var text = Convert.ToString(value)?.Trim() ?? string.Empty;
        return text.Length <= 80 ? text : text[..77] + "...";
    }

