@inject ISnackbar Snackbar
@inject BookingService bksv
@inject IStringLocalizer<SharedResource> Localizer

<MudDialog>
    <DialogContent>
        <MudGrid>
            <MudItem xs="2">
                <MudAutocomplete Class="pl-4 labelCustomColor" T="string"
                @bind-Value="cbofrom"
                Label="From:"
                SearchFunc="Search_port_from"
                AdornmentColor="@ColorTextFields"
                Immediate="true"
                CoerceText="true"
                Clearable="true"
                MaxItems="200">
                </MudAutocomplete>
            </MudItem>
            <MudItem xs="2">
                <MudAutocomplete Class="pl-4 labelCustomColor" T="string"
                @bind-Value="cboto"
                Label="To:"
                SearchFunc="Search_port_to"
                AdornmentColor="@ColorTextFields"
                Immediate="true"
                CoerceText="true"
                Clearable="true"
                MaxItems="200">
                </MudAutocomplete>
            </MudItem>


            <MudItem xs="1">
                <MudButton Class="pl-4 labelCustomColor" Style="background-color: #007BFF; color: white;" Size="Size.Small" Color="Color.Primary"  OnClick="@GetInvoice_No">>>></MudButton>
            </MudItem>

            <MudItem xs="4">
                <MudTextField Class="pl-4 labelCustomColor" @bind-Value="bookingno"
                              For="@(() => bookingno)"
                AdornmentColor="@ColorTextFields"
                Immediate="true"
                ReadOnly="true"
                Label="@Localizer["booking_no"]" />
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Color="Color.Secondary">Cancel</MudButton>
        <MudButton OnClick="Submit" Color="Color.Primary">Duplicate</MudButton>
    </DialogActions>
</MudDialog>

@code {
    Color ColorTextFields = Color.Primary;
    private List<string> ListPort_2char_from { get; set; } = new List<string>();
    private List<string> ListPort_2char_to { get; set; } = new List<string>();
    [CascadingParameter] MudDialogInstance? MudDialog { get; set; }


    private string selectedSheet;
    string cbofrom ="";
    string cboto = "";
    string bookingno ;

    protected override async Task OnInitializedAsync()
    {

        ListPort_2char_from = await bksv.GetList_Port_2char(cbofrom) ?? new List<string>();
        ListPort_2char_to = await bksv.GetList_Port_2char_To(cboto) ?? new List<string>();
    }
    // Phương thức hủy
    void Cancel()
    {
        MudDialog.Cancel();
    }

    // Phương thức gửi
    void Submit()
    {
        MudDialog.Close(DialogResult.Ok(bookingno));
    }
    private async Task<IEnumerable<string>> Search_port_from(string value)
    {
        if (string.IsNullOrEmpty(value))
            return ListPort_2char_from;

        return ListPort_2char_from.Where(x => x.Contains(value, StringComparison.InvariantCultureIgnoreCase));
    }
    private async Task<IEnumerable<string>> Search_port_to(string value)
    {
        if (string.IsNullOrEmpty(value))
            return ListPort_2char_to;

        return ListPort_2char_to.Where(x => x.Contains(value, StringComparison.InvariantCultureIgnoreCase));
    }

    private async Task GetInvoice_No()
    {
        string chuoirefno = "";
        int? so = await bksv.GetRefno_INV();
        var currentYear = DateTime.Now.ToString("yyyy");
        var currentMonth = DateTime.Now.ToString("MM");
        var formattedMonth = int.Parse(currentMonth).ToString();
        if (so == null)
        {
            CallSnackBar(Localizer["RefInvNumberExhausted"], MudBlazor.Severity.Warning);
            return;
        }
        else
        {

            if (so < 1000)
            {
                chuoirefno = so.ToString().PadLeft(3, '0');
            }
            var year = currentYear.Substring(2);
            string formattedRefNo = $"SGN{cbofrom}{cboto}{year}{currentMonth}{chuoirefno}";
            bookingno = formattedRefNo;
        }
    }
    void CallSnackBar(string message, MudBlazor.Severity severity)
    {
        
        Snackbar.Configuration.SnackbarVariant = Variant.Filled;
        Snackbar.Configuration.MaxDisplayedSnackbars = 3;
        Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopRight;
        Snackbar.Add(message, severity);
    }

}
