    private async Task<IEnumerable<string>> Search_Port(string value)
    {
        if (string.IsNullOrEmpty(value))
            return Ports.Select(x => (x.PORT + "_" + x.PORT_CODE)).Distinct();

        return Ports
            .Where(x => (x.PORT+"_"+x.PORT_CODE).Contains(value, StringComparison.InvariantCultureIgnoreCase))
            .Select(x => (x.PORT + "_" + x.PORT_CODE)).Distinct();
    }

    private async Task<IEnumerable<Guid?>> Search_Salecode(string value)
    {
        if (string.IsNullOrEmpty(value))
            return sales.Select(x => (Guid?)x.Sale_ID);

        return sales
            .Where(x => (x.SaleCode).Contains(value, StringComparison.InvariantCultureIgnoreCase))
            .Select(x => (Guid?)x.Sale_ID);
    }

    private string GetCustomerLabel(Guid? id)
    {
        var customer = customers.FirstOrDefault(x => x.Customer_ID== id);
        return customer != null ? customer.shortname+"___"+customer.COMPANY : string.Empty;
    }

    private string GetSaleLabel(Guid? id)
    {
        var customer = sales.FirstOrDefault(x => x.Sale_ID== id);
        return customer != null ? customer.SaleCode : string.Empty;
    }

