    private List<(byte[] Content, string FileName)> Attachments = new();
    private List<string> FileNames = new();
    private string FilesDisplay { get; set; } = string.Empty;
    private string EmailContent { get; set; } = string.Empty;
    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        Attachments.Clear();
        FileNames.Clear();
        FilesDisplay = "";
        var files = e.GetMultipleFiles();
        const long maxFileSize = 10 * 1024 * 1024; // 10MB

        foreach (var file in files)
        {
            if (file.Size > maxFileSize)
            {
                Console.WriteLine($"File {file.Name} quá lớn, bỏ qua.");
                continue;
            }

            var ms = new MemoryStream();
            using var stream = file.OpenReadStream(maxFileSize);
            await stream.CopyToAsync(ms);

            Attachments.Add((ms.ToArray(), file.Name));
            FileNames.Add(file.Name);
        }

        FilesDisplay = string.Join(", ", FileNames);
    }



