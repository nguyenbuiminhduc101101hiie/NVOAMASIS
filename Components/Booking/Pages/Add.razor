                parts.Add($"{qty.Value} x {label}");
        }

        Add(_BookingDetail.DC20, "20DC");
        Add(_BookingDetail.RF20, "20RF");
        Add(_BookingDetail.DC40, "40DC");
        Add(_BookingDetail.HC40, "40HC");
        Add(_BookingDetail.RF40, "40RF");
        Add(_BookingDetail.RH40, "40RH");
        Add(_BookingDetail.HC45, "45HC");
        Add(_BookingDetail.OT20, "20OT");
        Add(_BookingDetail.OT40, "40OT");
        Add(_BookingDetail.FR20, "20FR");
        Add(_BookingDetail.FR40, "40FR");

        _BookingDetail.hanoFCL_Quality = parts.Count == 0
            ? string.Empty
            : string.Join("; ", parts) + "; ";
    }

