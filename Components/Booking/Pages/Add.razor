        selectedDate_ATA = GetDateValue(_BookingDetail?.ANETA, useExistingValues, defaultDate);
        selectedDate_EmpContredat = GetDateValue(_BookingDetail?.EmpContReDate, useExistingValues, defaultDate);
        selectedDate_FullReturnDate = GetDateValue(_BookingDetail?.FullReturnDate, useExistingValues, defaultDate);
        selectedDate_Cancle = GetDateValue(_BookingDetail?.datecancel, useExistingValues, defaultDate);
        selectedDate_Release = GetDateValue(_BookingDetail?.dateRelease, useExistingValues, defaultDate);
    }

    private static DateTime? GetDateValue(string? rawDate, bool useExistingValues, DateTime defaultDate)
    {
        if (TryParseBookingDate(rawDate, out var parsedDate))
        {
            return parsedDate;
        }

        return useExistingValues ? null : defaultDate;
    }

    private static bool TryParseBookingDate(string? rawDate, out DateTime parsedDate)
    {
        if (string.IsNullOrWhiteSpace(rawDate))
        {
            parsedDate = default;
            return false;
        }

        if (DateTime.TryParseExact(rawDate, "yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out parsedDate))
        {
            return true;
        }

        return DateTime.TryParse(rawDate, out parsedDate);
    }
