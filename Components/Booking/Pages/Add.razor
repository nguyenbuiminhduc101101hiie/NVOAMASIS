    private void SyncDatePickersFromBookingDetail()
    {
        var defaultDate = DateTime.Today;
        var useExistingValues = string.Equals(Status, "edit", StringComparison.OrdinalIgnoreCase);

        selectedDate = GetDateValue(_BookingDetail?.SICutOff, useExistingValues, defaultDate);
        selectedDate_VGM = GetDateValue(_BookingDetail?.hano_Closing, useExistingValues, defaultDate);
        selectedDate_Cargo = GetDateValue(_BookingDetail?.hano_Closingdelivery, useExistingValues, defaultDate);
