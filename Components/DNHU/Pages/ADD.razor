@using System.Globalization
@inject ISnackbar Snackbar
@inject AccountService asv
@inject TrainScheduleServices trainsv
@inject IStringLocalizer<SharedResource> Localizer
@inject SharedServices ssv
@inject LocalChargesServices lcsv
@inject SupportServices supsv
@inject LenhDieuXeServices ldxsv
@inject TKHQ_Services tkhqsv
@inject GlobalServices gsv
@inject Bieugianangha_Services BGRRsv
@inject CustomerService CusSV
@inject DNTUServices DNTUSV
@inject BookingService Bksv
@inject  ShipmentService shipmentsv
@inject NavigationManager NavigationManager
@inject tigiaVCBservices Vcbsv

@inject IJSRuntime JSRuntime
<MudDialog>
    <DialogContent>
        <MudSpacer></MudSpacer>
        <MudContainer>

            <MudCard>
                <MudForm Model="@_DNHU_Detail" @ref="@form">
                    <MudCardContent>

                        <MudGrid>

                            <MudItem xs="2">
                                <MudButton Style="background-color: #007BFF; color: white;" Size="Size.Small" Color="Color.Primary"
                                Disabled="@(Status == "edit")"

                                OnClick="() => Get_BGNHNo()">>>></MudButton>
                            </MudItem>

                            <MudItem xs="5">
                                <MudTextField @bind-Value="_DNHU_Detail.So" Disabled="true" Label="@Localizer["So"]" Class="custom-label" Required="true" />
                            </MudItem>

                            <MudItem xs="5">
                                <MudDatePicker Class="custom-label" @bind-Date="_DNHU_Detail.Ngay"
                                For="@(() => _DNHU_Detail.Ngay)"
                                Label="@Localizer["NGAY"]"
                                DateFormat="dd/MM/yyyy"
                                Required="true" />
                            </MudItem>

                        </MudGrid>

                        <MudGrid>

                            <MudItem xs="6">
                                <MudAutocomplete @bind-Value="_DNHU_Detail.Kinhgui" Label="@Localizer["Kinhgui"]" class="custom-label" CoerceValue SearchFunc="Searchlinhgui" />
                            </MudItem>

                            <MudItem xs="6">
                                <MudAutocomplete Class="custom-label" T="Guid?" Label="@Localizer["DNTUno"]" 
                                @bind-Value="_DNHU_Detail.DeNghiTamUngID"
                                SearchFunc="Search_customer"
                                ToStringFunc="GetCustomerLabel"
                                OnBlur="@(e => FillInfo_HU(_DNHU_Detail))" />
                            </MudItem>


                            <MudItem xs="6">
                                <MudAutocomplete Class=" labelCustomColor custom-label" T="string"
                                @bind-Value="_DNHU_Detail.Tennguoidenghi"
                                Label="@Localizer["Tennguoidenghi"]"
                                SearchFunc="Search_User"
                                Immediate="true"
                                CoerceText="true"
                                Clearable="true"
                                MaxItems="100">
                                </MudAutocomplete>
                            </MudItem>

                            <MudItem xs="12">
                                <MudTextField @bind-Value="_DNHU_Detail.Noidung" Label="@Localizer["noidung"]" Class="custom-label" Lines="3" />
                            </MudItem>

                            <MudItem xs="6">
                                <MudAutocomplete @bind-Value="_DNHU_Detail.Bophan" Label="@Localizer["bophan"]" class="custom-label" CoerceValue SearchFunc="Searchbophan" />
                            </MudItem>



                            <MudItem xs="6">
                                <MudNumericField @bind-Value="_DNHU_Detail.Sotien"
                                Label="@Localizer["sotien"]" Format="#,##0.##" Culture="@_en" T="double?" HideSpinButtons="true"
                                Class="text-right custom-label " />
                            </MudItem>

                            <MudItem xs="6">
                                    <MudAutocomplete @bind-Value="_DNHU_Detail.Loaitiente" Label="@Localizer["Loaitiente"]" Required="true" Class="custom-label" CoerceValue SearchFunc="SearchCurr" />
                            </MudItem>

                            <MudItem xs="6">
                                <MudNumericField @bind-Value="_DNHU_Detail.tigia"
                                                 Label="@Localizer["tigia"]" Format="#,##0.##" Culture="@_en" T="double?" HideSpinButtons="true"
                                                 Class="text-right custom-label" Required=true />
                            </MudItem>

                            <MudItem xs="6">
                                <MudSelect @bind-Value="_DNHU_Detail.Trangthai" Label="@Localizer["status"]" class="custom-label">
                                    @foreach (var item in trangthais)
                                    {
                                        <MudSelectItem Value="item">@item</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>


                            <MudItem xs="6">

                                <MudAutocomplete @bind-Value="_DNHU_Detail.Bkno" Label="@Localizer["BookingNo"]" class="custom-label" SearchFunc="Searchbkno" />
                            </MudItem>

                            <MudItem xs="6">
                                <MudAutocomplete @bind-Value="_DNHU_Detail.Hbl" Label="@Localizer["HBL"]" class="custom-label" SearchFunc="SearchHBL" />
                            </MudItem>

                            <MudItem xs="12">
                                <MudTextField @bind-Value="_DNHU_Detail.Chungtukemtheo" Label="@Localizer["Chungtukemtheo"]" Class="custom-label" Lines="3" />
                            </MudItem>

                            <MudItem xs="12">
                                <MudStack Row>
                                    <MudFileUpload T="IBrowserFile"
                                    Accept=".pdf,.doc,.docx,.xls,.xlsx"
                                    FilesChanged="@((t) => AttachFileToFTP(t, _DNHU_Detail))">
                                        <ButtonTemplate Context="context1">
                                            <MudIconButton HtmlTag="label" for="@context1"
                                            Size="Size.Small"
                                            Color="Color.Secondary"
                                            Icon="@Icons.Material.Filled.AttachFile" />
                                        </ButtonTemplate>
                                    </MudFileUpload>

                                    <MudContainer Class="pa-4; max-height:200px; overflow-y: auto;">
                                        <MudText Typo="Typo.h6">Files</MudText>

                                        @foreach (var item in Linksplit(_DNHU_Detail.Files!))
                                        {
                                            var fileName = Path.GetFileName(item);
                                            var fileUrl = item.Replace("ftp", "http");
                                            var fileExtension = Path.GetExtension(fileName).ToLower();

                                            <MudPaper Elevation="3" Class="d-flex align-items-center justify-between ma-2 pa-2">
                                                <MudIcon Icon="@GetFileIcon(fileExtension)" Size="Size.Medium" />
                                                <MudText Class="mx-2" Style="flex-grow: 1;">@fileName</MudText>

                                                <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                                                OnClick="@(() => SeeDetail(fileUrl))"
                                                Color="Color.Primary" />

                                                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                OnClick="@(() => DeleteFiles(_DNHU_Detail, item))"
                                                Color="Color.Error" />
                                            </MudPaper>
                                        }
                                    </MudContainer>

                                </MudStack>
                            </MudItem>

                        </MudGrid>

                    </MudCardContent>
                </MudForm>

            </MudCard>
        </MudContainer>
    </DialogContent>
    <DialogActions>

        <MudButton OnClick="@(async () => await Submit())">Save</MudButton>
        <MudButton OnClick="Cancel">Cancel</MudButton>

    </DialogActions>
</MudDialog>



@code {
    [CascadingParameter] MudDialogInstance? MudDialog { get; set; }
    [Parameter] public Models.M_DNHU _DNHU_Detail { get; set; }
    List<M_Customer> customers = new List<M_Customer>();
    [Parameter] public string Status { get; set; }
    MudForm form;
    List<string> trangthais = new List<string>();
    private List<Models.TrangThai> M_Trangthais = new List<Models.TrangThai>();
    public CultureInfo _en = CultureInfo.GetCultureInfo("en-US");
    private List<Terminal_> Terminals = new List<Terminal_>();
    private List<Terminal_> Terminals_Address = new List<Terminal_>();

    string UserHanding;
    private List<string> ListUser { get; set; } = new List<string>();
    List<M_DNHU> DNHUs = new List<M_DNHU>();
    List<M_DNTU> DNTUs = new List<M_DNTU>();
    List<string> Bookings = new List<string>();
    List<Booking> M_Bookings = new List<Booking>();

    List<string> HBLs = new List<string>();
    List<M_HBL> M_HBLs = new List<M_HBL>();
    // List<M_DNTU> DNTUs_by_id = new List<M_DNTU>;
    public M_DNTU DNTUs_by_id { get; set; }

    protected async override Task OnInitializedAsync()
    {
        customers = await CusSV.GetList();
        M_Trangthais = await supsv.GetListTrangThai();
        var tts = await supsv.GetListTrangThai();
        trangthais = tts.Where(x => x.Tieude == "DNHU").OrderBy(x => x.Noidung).Select(x => x.Noidung).ToList();
        DNTUs =  DNTUSV.GetListDNTU();
        DNHUs = DNTUSV.GetListDNHU();

        Terminals_Address = await gsv.GetList_Terminal_add();
        Terminals = await gsv.GetList_Terminal();
        ListUser = await asv.GetList_User_handle() ?? new List<string>();
        M_Bookings = await Bksv.GetListSBooking();
        Bookings = M_Bookings.Select(x => x.BookingNo).ToList();

        M_HBLs = await shipmentsv.GetListHBLALL();
        HBLs = M_HBLs.Select(x => x.hbl).ToList();
    }

    private async Task Get_BGNHNo()
    {

        int formattedYear = DateTime.Now.Year;
        int formattedMonth = DateTime.Now.Month;

        string usr = asv.GetAuth().Result.User.Identity!.Name!;
        var refno = await supsv.GetRefNoByFunc("DNHU", formattedMonth, formattedYear, usr);

        var rs = asv.GetUserDetail();
        var cn = rs.Branch;
        _DNHU_Detail.So = cn + "DNHU_" + formattedYear.ToString() + formattedMonth.ToString() + refno.Value.ToString("D4");
    }

    private async Task Submit()
    {
        if ((await ssv.CheckPermission(asv.GetAuth().Result.User.Identity.Name, "Edit", "DNHU") || await ssv.CheckPermission(asv.GetAuth().Result.User.Identity.Name, "New", "DNHU")))
        {

            await form.Validate();

            if (form.IsValid)
            {

                var UserName = asv.GetAuth().Result.User.Identity!.Name!;

                _DNHU_Detail.Dateupdate = DateTime.Now.ToString("dd/MMM/yyyy");
                _DNHU_Detail.UserUpdate = UserName;
                

                //----update sotienhoanung , Conlai

                MudDialog!.Close(_DNHU_Detail);

            }
        }

    }
    void Cancel() => MudDialog.Cancel();

    void CallSnackBar(string message, MudBlazor.Severity severity)
    {
        Snackbar.Clear();
        Snackbar.Configuration.SnackbarVariant = Variant.Filled;
        Snackbar.Configuration.MaxDisplayedSnackbars = 3;
        Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopRight;
        Snackbar.Add(message, severity);
    }

    private async Task<IEnumerable<Guid?>> Search_customer(string value)
    {
        if (string.IsNullOrEmpty(value))
            return DNTUs.Select(x => (Guid?)x.Id);

        return DNTUs
            .Where(x => (x.So).Contains(value, StringComparison.InvariantCultureIgnoreCase))
            .Select(x => (Guid?)x.Id);
    }
    private string GetCustomerLabel(Guid? id)
    {
        var customer = DNTUs.FirstOrDefault(x => x.Id == id);
        return customer != null ? customer.So : string.Empty;
    }

    private async Task<IEnumerable<string>> SearchTerminal(string text)
    {
        try
        {
            if (string.IsNullOrWhiteSpace(text))
            {
                return Terminals.Where(x => !string.IsNullOrEmpty(x.TermiNalName))
               .Select(x => x.TermiNalName);
            }
            // MBL.Porname = mst_Consignee;
            return Terminals.Where(x => !string.IsNullOrEmpty(x.TermiNalName) &&
                            x.TermiNalName.Contains(text, StringComparison.OrdinalIgnoreCase))
               .Select(x => x.TermiNalName);
        }
        catch (Exception)
        {
            throw;
        }
    }
    private async Task<IEnumerable<string>> Search_User(string value)
    {
        if (string.IsNullOrEmpty(value))
            return ListUser;

        return ListUser.Where(x => x.Contains(value, StringComparison.InvariantCultureIgnoreCase));
    }

    private async Task<IEnumerable<string?>> Searchlinhgui(string? text)
    {
        try
        {
            var items = DNHUs.Select(x => x.Kinhgui).Distinct();
            if (string.IsNullOrEmpty(text))
            {
                return items;
            }
            // MBL.Porname = mst_Consignee;
            return items.Where(x => x != null && x.Equals(text));
        }
        catch (Exception)
        {
            throw;
        }
    }

    private async Task<IEnumerable<string?>> Searchbophan(string? text)
    {
        try
        {
            var items = DNHUs.Select(x => x.Bophan).Distinct();
            if (string.IsNullOrEmpty(text))
            {
                return items;
            }
            // MBL.Porname = mst_Consignee;
            return items.Where(x => x != null && x.Equals(text));
        }
        catch (Exception)
        {
            throw;
        }
    }

    private Task<IEnumerable<string>> SearchHBL(string value)
    {
        var items = M_HBLs
            .Select(x => x.hbl)
            .Where(x => !string.IsNullOrEmpty(x))
            .Distinct();

        if (string.IsNullOrWhiteSpace(value))
            return Task.FromResult(items);

        var result = items.Where(x => x.Contains(value, StringComparison.OrdinalIgnoreCase));
        return Task.FromResult(result);
    }

    private Task<IEnumerable<string>> Searchbkno(string value)
    {
        var items = M_Bookings
            .Select(x => x.BookingNo)
            .Where(x => !string.IsNullOrEmpty(x))
            .Distinct();

        if (string.IsNullOrWhiteSpace(value))
            return Task.FromResult(items);

        var result = items.Where(x => x.Contains(value, StringComparison.OrdinalIgnoreCase));
        return Task.FromResult(result);
    }

    List<string>Linksplit(string links)
    {
        if (string.IsNullOrEmpty(links))
            return new List<string>();
        return links.Split(';').ToList(); 
    }

    private string GetFileIcon(string extension)
    {
        return extension switch
        {
            ".pdf" => Icons.Material.Filled.PictureAsPdf,
            ".doc" or ".docx" => Icons.Material.Filled.Description,
            ".xls" or ".xlsx" => Icons.Material.Filled.TableChart,
            _ => Icons.Material.Filled.InsertDriveFile
        };
    }

    // private void SeeDetail(string fileUrl)
    // {
    //     NavigationManager.NavigateTo(fileUrl, true);

    // }
    async Task SeeDetail(string fileUrl)
    {
        // NavigationManager.NavigateTo(fileUrl, true);
        await JSRuntime.InvokeVoidAsync("open", fileUrl, "_blank");

    }
    async Task DeleteFiles(M_DNHU item ,string link)
    {
        try
        {
            if (item.Files!.Contains(";"))
                link = link + ";";
            item.Files = item.Files!.Replace(link, string.Empty);

            StateHasChanged();
        }
        catch(Exception ex)
        {
            CallSnackBar("Throw exception code: " + ex.Message, MudBlazor.Severity.Error);
        }
    }
    async Task AttachFileToFTP(IBrowserFile file, M_DNHU item)
    {
        try
        {
            var rs = await ssv.UploadfiletoFTP_DNHU(file, (object)item);
            CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
        }
        catch (Exception ex)
        {
            CallSnackBar("Throw exception code: " + ex.Message, MudBlazor.Severity.Error);
        }
    }

    private void FillInfo_HU(M_DNHU item)
    {
        try
        {
            var rs = DNTUSV.Get_DNTU_byID(item.DeNghiTamUngID);

            if (rs != null)
            {

                item.Noidung = rs.Noidung;
                item.Bophan = rs.Bophan;
                item.Sotien = rs.Sotien;
                item.Loaitiente = rs.Loaitiente;
                item.Bkno = rs.Bkno;
                item.Hbl = rs.Hbl;
            }
           
        }
        catch (Exception ex)
        {
            CallSnackBar("Error while bind, code: " + ex.Message, MudBlazor.Severity.Error);
        }
       
    }
    private async Task<IEnumerable<string>> SearchCurr(string? text)
    {
        if (string.IsNullOrWhiteSpace(text))
            return Vcbsv.currs;

        return Vcbsv.currs.Where(x => !string.IsNullOrEmpty(x) && x.Contains(text, StringComparison.OrdinalIgnoreCase));
    }

    private async Task GetTigia(M_Product_Price_detail_ALL item)
    {
        double? tigia_ = await Vcbsv.Getexchange_cur(item.Cur);
        item.Tigia = tigia_;
    }

}
