@inject ShipmentService shipsv
@inject IStringLocalizer<SharedResource> Localizer

<MudDialog>
    <DialogContent>
        @if (!string.IsNullOrWhiteSpace(BillNo))
        {
            <MudText Typo="Typo.body2" Class="mb-2">@Localizer["HDDVXml.BillOnInvoice"]: <b>@BillNo</b></MudText>
        }
        <MudAutocomplete T="ShipmentBillRef"
                         @bind-Value="_selected"
                         Label="@Localizer["HDDVXml.SearchBill"]"
                         SearchFunc="Search"
                         ToStringFunc="@(x => x?.Display ?? string.Empty)"
                         MinCharacters="2"
                         DebounceInterval="300"
                         ResetValueOnEmptyText="true"
                         Variant="Variant.Outlined"
                         Margin="Margin.Dense"
                         AdornmentIcon="@Icons.Material.Filled.Search" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Unlink" Color="Color.Warning">@Localizer["HDDVXml.Unlink"]</MudButton>
        <MudSpacer />
        <MudButton OnClick="Cancel">@Localizer["Cancel"]</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="@(_selected == null)" OnClick="Submit">@Localizer["Save"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] MudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public string? BillNo { get; set; }

    ShipmentBillRef? _selected;

    async Task<IEnumerable<ShipmentBillRef>> Search(string text) => await shipsv.SearchShipmentsByBill(text);

    void Submit() => MudDialog.Close(DialogResult.Ok(_selected));

    void Unlink() => MudDialog.Close(DialogResult.Ok(new ShipmentBillRef(Guid.Empty, Guid.Empty, string.Empty)));

    void Cancel() => MudDialog.Cancel();
}
