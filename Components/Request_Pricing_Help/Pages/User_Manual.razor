@page "/help"
@using MudBlazor
@inject IStringLocalizer<SharedResource> Localizer

<MudPaper Class="p-4" Elevation="1">
    <MudText Typo="Typo.h6">@Localizer["UserManual"]</MudText>
    <MudDivider Class="my-2" />
    <div class="help-links" style="display:flex;flex-direction:column;gap:0.5rem;max-width:420px;">
        <a href="HDSDhtml/HDSD_Tab1.html" target="_blank" rel="noopener noreferrer">
            <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.MenuBook" Size="Size.Small">
                @Localizer["UserManual_Section1"]
            </MudButton>
        </a>

        <a href="HDSDhtml/HDSD_Tab2.html" target="_blank" rel="noopener noreferrer">
            <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.MenuBook" Size="Size.Small">
                @Localizer["UserManual_Section2"]
            </MudButton>
        </a>

        <a href="HDSDhtml/HDSD_Tab3.html" target="_blank" rel="noopener noreferrer">
            <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.MenuBook" Size="Size.Small">
                @Localizer["UserManual_Section3"]
            </MudButton>
        </a>
    </div>
</MudPaper>
