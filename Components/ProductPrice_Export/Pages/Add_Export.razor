@using System.Globalization
@inject ISnackbar Snackbar
@inject AccountService asv
@inject TrainScheduleServices trainsv
@inject IStringLocalizer<SharedResource> Localizer
@inject SharedServices ssv
@inject LocalChargesServices lcsv
@inject SupportServices supsv
@inject LenhDieuXeServices ldxsv
@inject TKHQ_Services tkhqsv
@inject GlobalServices gsv
@inject Bieugianangha_Services BGRRsv
@inject CustomerService CusSV
@inject DNTUServices DNTUSV
@inject BookingService Bksv
@inject ShipmentService shipmentsv
@inject NavigationManager NavigationManager
@inject ProductPriceServices prsv
@inject NotificationService _notificationService
@inject IJSRuntime JSRuntime

<style>
    .pp-export-dialog-shell {
        max-height: 78vh;
        overflow-y: auto;
        width: 100%;
        background: linear-gradient(180deg, #f8fbff 0%, #ffffff 100%);
        padding: 8px;
    }

    .pp-export-card {
        border-radius: 18px;
        border: 1px solid rgba(17, 138, 178, .18);
        box-shadow: 0 10px 30px rgba(15, 23, 42, .08);
        overflow: hidden;
        background: #ffffff;
    }

    .pp-export-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 14px 18px;
        background: linear-gradient(135deg, #0f7ea8 0%, #118ab2 45%, #20a4c8 100%);
        color: #ffffff;
    }

    .pp-export-title {
        font-size: 18px;
        font-weight: 800;
        letter-spacing: .2px;
    }

    .pp-export-subtitle {
        font-size: 12px;
        opacity: .9;
        margin-top: 2px;
    }

    .pp-section {
        border: 1px solid rgba(17, 138, 178, .14);
        border-radius: 16px;
        background: #ffffff;
        padding: 12px;
        margin-bottom: 12px;
    }

    .pp-soft-section {
        background: #f0f9ff;
    }

    .pp-section-title {
        display: flex;
        align-items: center;
        gap: 8px;
        color: #0f6f91;
        font-size: 13px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: .5px;
        margin-bottom: 8px;
    }

    .pp-section-title::before {
        content: "";
        width: 5px;
        height: 18px;
        border-radius: 999px;
        background: #118ab2;
        display: inline-block;
    }

    .pp-action-button {
        min-width: 42px;
        height: 36px;
        border-radius: 10px !important;
        font-weight: 800 !important;
        box-shadow: 0 6px 16px rgba(17, 138, 178, .22);
    }

    .pp-user-panel {
        border: 1px dashed #bfd7ea;
        border-radius: 14px;
        background: #f8fbff;
        padding: 10px;
    }

    .pp-user-title {
        color: #0f6f91;
        font-size: 13px;
        font-weight: 800;
        margin-bottom: 6px;
    }

    .pp-send-button {
        height: 36px;
        border-radius: 10px !important;
        font-weight: 700 !important;
        white-space: nowrap;
    }

    .pp-dialog-actions {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        gap: 8px;
        width: 100%;
        padding: 10px 16px;
        border-top: 1px solid rgba(15, 23, 42, .08);
        background: #ffffff;
    }

    .pp-dialog-actions .mud-button-root {
        border-radius: 10px;
        min-width: 90px;
        font-weight: 700;
    }

    .labelCustomColor label,
    .custom-label label,
    .custom-label .mud-input-label,
    .labelCustomColor .mud-input-label {
        font-weight: 700 !important;
        color: #118AB2 !important;
        font-size: 12px !important;
    }

    .pp-export-dialog-shell .mud-input-root,
    .pp-export-dialog-shell .mud-select,
    .pp-export-dialog-shell .mud-picker-input-button {
        font-size: 13px;
    }

    .pp-export-dialog-shell .mud-input-control {
        margin-top: 2px;
        margin-bottom: 2px;
    }

    .pp-export-dialog-shell .mud-input > input,
    .pp-export-dialog-shell .mud-input textarea {
        font-size: 13px;
    }

    .text-right input {
        text-align: right !important;
    }

    .class-dialog-custom {
        backdrop-filter: blur(10px);
        transition: none !important;
        animation: none !important;
    }

    @@media (max-width: 768px) {
        .pp-export-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .pp-dialog-actions {
            justify-content: stretch;
        }

        .pp-dialog-actions .mud-button-root {
            flex: 1;
        }
    }
</style>

<MudDialog>
    <DialogContent>
        <div class="pp-export-dialog-shell">
            <MudContainer MaxWidth="MaxWidth.False" Class="pa-0">
                <MudCard Elevation="0" Class="pp-export-card">
                    <div class="pp-export-header">
                        <div>
                            <div class="pp-export-title">@Localizer["Product_Price_Export"]</div>
                            <div class="pp-export-subtitle">@Localizer["MaRFQ"] / @Localizer["TenHang_gs"] / @Localizer["status"]</div>
                        </div>
                    </div>

                    <MudForm Model="@_ProductPrice_Export_Details" @ref="@form">
                        <MudCardContent Class="pa-3">
                            <div class="pp-section pp-soft-section">
                                <div class="pp-section-title">RFQ Info</div>
                                <MudGrid Spacing="2">
                                    <MudItem xs="12" sm="1" Class="d-flex align-end">
                                        <MudButton Class="pp-action-button"
                                                   Variant="Variant.Filled"
                                                   Color="Color.Primary"
                                                   Size="Size.Small"
                                                   Disabled="@(Status == "edit")"
                                                   OnClick="() => Get_BGNHNo()">>>></MudButton>
                                    </MudItem>
                                    <MudItem xs="12" sm="5">
                                        <MudTextField @bind-Value="_ProductPrice_Export_Details.maRFQ"
                                                      Disabled="true"
                                                      Label="@Localizer["MaRFQ"]"
                                                      Class="custom-label"
                                                      Margin="Margin.Dense"
                                                      Required="true" />
                                    </MudItem>
                                    <MudItem xs="12" sm="6">
                                        <MudDatePicker Class="custom-label"
                                                       @bind-Date="_ProductPrice_Export_Details.ngayguiyeucau"
                                                       For="@(() => _ProductPrice_Export_Details.ngayguiyeucau)"
                                                       Label="@Localizer["Ngayguiyeucau"]"
                                                       Margin="Margin.Dense"
                                                       DateFormat="dd/MM/yyyy"
                                                       Required="true" />
                                    </MudItem>
                                </MudGrid>
                            </div>

                            <div class="pp-section">
                                <div class="pp-section-title">Product & Route</div>
                                <MudGrid Spacing="2">
                                    <MudItem xs="12" sm="6">
                                        <MudTextField @bind-Value="_ProductPrice_Export_Details.Tenhang"
                                                      Label="@Localizer["TenHang_gs"]"
                                                      Class="custom-label"
                                                      Margin="Margin.Dense" />
                                    </MudItem>
                                    <MudItem xs="12" sm="3">
                                        <MudNumericField @bind-Value="_ProductPrice_Export_Details.soluong"
                                                         Label="@Localizer["Quantity"]"
                                                         Format="#,##0.##"
                                                         Culture="@_en"
                                                         T="double?"
                                                         HideSpinButtons="true"
                                                         Margin="Margin.Dense"
                                                         Class="text-right custom-label" />
                                    </MudItem>
                                    <MudItem xs="12" sm="3">
                                        <MudAutocomplete @bind-Value="_ProductPrice_Export_Details.donvitinh"
                                                         Label="@Localizer["Unit"]"
                                                         Class="custom-label"
                                                         Margin="Margin.Dense"
                                                         CoerceValue
                                                         SearchFunc="SearchUnit" />
                                    </MudItem>

                                    <MudItem xs="12" sm="6">
                                        <MudAutocomplete Class="custom-label"
                                                         T="string"
                                                         @bind-Value="_ProductPrice_Export_Details.cangdi"
                                                         Label="@Localizer["cangdi"]"
                                                         Margin="Margin.Dense"
                                                         SearchFunc="SearchPorts"
                                                         Immediate="true"
                                                         CoerceText="true"
                                                         Clearable="true"
                                                         MaxItems="100" />
                                    </MudItem>
                                    <MudItem xs="12" sm="6">
                                        <MudAutocomplete Class="custom-label"
                                                         T="string"
                                                         @bind-Value="_ProductPrice_Export_Details.cangden"
                                                         Label="@Localizer["cangden"]"
                                                         Margin="Margin.Dense"
                                                         SearchFunc="SearchPorts"
                                                         Immediate="true"
                                                         CoerceText="true"
                                                         Clearable="true"
                                                         MaxItems="100" />
                                    </MudItem>
                                </MudGrid>
                            </div>

                            <div class="pp-section">
                                <div class="pp-section-title">Request Detail</div>
                                <MudGrid Spacing="2">
                                    <MudItem xs="12" sm="4">
                                        <MudAutocomplete @bind-Value="_ProductPrice_Export_Details.incoterm"
                                                         Label="@Localizer["Incoterm"]"
                                                         Class="custom-label"
                                                         Margin="Margin.Dense"
                                                         CoerceValue
                                                         SearchFunc="SearchIncoterm" />
                                    </MudItem>
                                    <MudItem xs="12" sm="4">
                                        <MudSelect @bind-Value="_ProductPrice_Export_Details.trangthai"
                                                   Label="@Localizer["status"]"
                                                   Class="custom-label"
                                                   Margin="Margin.Dense">
                                            @foreach (var item in trangthais)
                                            {
                                                <MudSelectItem Value="@item">@item</MudSelectItem>
                                            }
                                        </MudSelect>
                                    </MudItem>
                                    <MudItem xs="12" sm="4">
                                        <MudAutocomplete @bind-Value="_ProductPrice_Export_Details.loaihinh"
                                                         Label="@Localizer["Loaihinh"]"
                                                         Class="custom-label"
                                                         Margin="Margin.Dense"
                                                         CoerceValue
                                                         SearchFunc="SearchType" />
                                    </MudItem>
                                    <MudItem xs="12">
                                        <MudTextField @bind-Value="_ProductPrice_Export_Details.noidung"
                                                      Label="@Localizer["noidung"]"
                                                      Class="custom-label"
                                                      Margin="Margin.Dense"
                                                      Lines="2"
                                                      AutoGrow />
                                    </MudItem>
                                </MudGrid>
                            </div>

                            <div class="pp-section pp-soft-section">
                                <div class="pp-section-title">User / Notification</div>
                                <div class="pp-user-panel">
                                    <div class="pp-user-title">@Localizer["User"] / User Nhận Email</div>
                                    <MudGrid Spacing="2">
                                        <MudItem xs="12" md="5">
                                            <MudAutocomplete Class="custom-label"
                                                             T="string"
                                                             @bind-Value="UserHanding"
                                                             Label="@Localizer["User"]"
                                                             Margin="Margin.Dense"
                                                             SearchFunc="Search_User"
                                                             Immediate="true"
                                                             CoerceText="true"
                                                             Clearable="true"
                                                             MaxItems="100" />
                                        </MudItem>
                                        <MudItem xs="12" md="1" Class="d-flex align-end">
                                            <MudButton Class="pp-action-button"
                                                       Variant="Variant.Filled"
                                                       Color="Color.Primary"
                                                       Size="Size.Small"
                                                       OnClick="() => Getuser(_ProductPrice_Export_Details)">>>></MudButton>
                                        </MudItem>
                                        <MudItem xs="12" md="6">
                                            <MudTextField @bind-Value="_ProductPrice_Export_Details.Userhandle"
                                                          Class="custom-label"
                                                          Margin="Margin.Dense"
                                                          HelperTextOnFocus
                                                          HelperText="từ 2 mail trở lên vui lòng ngăn cách bằng dấu ','"
                                                          Lines="2"
                                                          AutoGrow
                                                          Label="@Localizer["EmailRecipient"]"
                                                          Required="false" />
                                        </MudItem>
                                        <MudItem xs="12" Class="d-flex justify-end">
                                            <MudStack Row="true" Spacing="1" Justify="Justify.FlexEnd">
                                                <MudButton Class="pp-send-button"
                                                           HtmlTag="label"
                                                           Disabled="_processingUpload"
                                                           @onclick="@(() => SendMailnotify(_ProductPrice_Export_Details))"
                                                           Size="Size.Small"
                                                           Color="Color.Tertiary"
                                                           Variant="Variant.Filled"
                                                           StartIcon="@Icons.Material.Filled.Email">
                                                    @if (_processingUpload)
                                                    {
                                                        <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                                                        <MudText Class="ms-2">Processing</MudText>
                                                    }
                                                    else
                                                    {
                                                        <MudText>@Localizer["sendemail"]</MudText>
                                                    }
                                                </MudButton>
                                                <MudButton Class="pp-send-button"
                                                           HtmlTag="label"
                                                           Disabled="_processingUpload_message"
                                                           @onclick="@(() => SendMessage(_ProductPrice_Export_Details))"
                                                           Size="Size.Small"
                                                           Color="Color.Tertiary"
                                                           Variant="Variant.Filled"
                                                           StartIcon="@Icons.Material.Filled.Notifications">
                                                    @if (_processingUpload_message)
                                                    {
                                                        <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                                                        <MudText Class="ms-2">Processing</MudText>
                                                    }
                                                    else
                                                    {
                                                        <MudText>@Localizer["message"]</MudText>
                                                    }
                                                </MudButton>
                                            </MudStack>
                                        </MudItem>
                                    </MudGrid>
                                </div>
                            </div>
                            <AttachmentField @ref="_attach" @bind-Value="_ProductPrice_Export_Details.AttachmentIds" Folder="Export" Title="Attachments" />
                        </MudCardContent>
                    </MudForm>
                </MudCard>
            </MudContainer>
        </div>
    </DialogContent>
    <DialogActions>
        <div class="pp-dialog-actions">
            <MudButton Variant="Variant.Text" OnClick="Cancel">Cancel</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(async () => await Submit())">Save</MudButton>
        </div>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] MudDialogInstance? MudDialog { get; set; }
    [Parameter] public Models.M_ExportCostRequest _ProductPrice_Export_Details { get; set; }
    [Parameter] public string Status { get; set; }
    List<PortModel> Ports = new List<PortModel>();
    List<string> trangthais = new List<string>();
    private List<Models.TrangThai> M_Trangthais = new List<Models.TrangThai>();
    public CultureInfo _en = CultureInfo.GetCultureInfo("en-US");
    List<M_ExportCostRequest> ExportCosts = new List<M_ExportCostRequest>();
    public string? UserHanding;
    MudForm form;
    private List<string> ListUser { get; set; } = new List<string>();


    List<string> List_Incoterm = new List<string>
    {
        "EXW-Giao hàng tại xưởng-người mua chịu toàn bộ chi phí và rủi ro",
        "FOB-Giao lên tàu-người bán chịu chi phí đến cảng xuất khẩu",
        "CIF-Người bán chịu chi phí + bảo hiểm đến cảng nhập khẩu",
        "DDP-Giao đã nộp thuế-người bán lo chi phí đến tận nơi mua",
        "FCA-Giao cho người vận chuyển chị định",
        "CPT-Cước phí trả tới nơi-người bán trả cước vận chuyển"
    };

    List<string> List_Type = new List<string>
    {
        "FCL",
        "LCL",
        "AIR Air Freight",
        "EXPRESS",
        "TRUCK",
        "WAREHOUSE",
        "CUSTOMS",
        "DOOR",
        "PROJECT",
        "OTHERS"
    };

    protected async override Task OnInitializedAsync()
    {
        if (Status == "Duplicate")
        {
            _ProductPrice_Export_Details.maRFQ = "";
            _ProductPrice_Export_Details.id = Guid.Empty;
            _ProductPrice_Export_Details.approve = false;
            _ProductPrice_Export_Details.continued = true;
            _ProductPrice_Export_Details.editable = true;
        }
        Ports = await Bksv.GetList_PORT();
        M_Trangthais = await supsv.GetListTrangThai();
        var tts = await supsv.GetListTrangThai();
        trangthais = tts.Where(x => x.Tieude == "ProductPrice").OrderBy(x => x.Noidung).Select(x => x.Noidung).ToList();
        ExportCosts = await prsv.GetProduct_Price_export();
        ListUser = await asv.GetList_User_handle() ?? new List<string>();
    }

    private async Task<IEnumerable<string>> SearchPorts(string text)
    {
        try
        {
            if (string.IsNullOrWhiteSpace(text))
            {
                return Ports
                    .Where(x => !string.IsNullOrEmpty(x.PORT))
                    .Select(x => x.PORT)
                    .Distinct();
            }

            return Ports
                .Where(x => !string.IsNullOrEmpty(x.PORT) &&
                            x.PORT.Contains(text, StringComparison.OrdinalIgnoreCase))
                .Select(x => x.PORT)
                .Distinct();
        }
        catch (Exception)
        {
            throw;
        }
    }

    private async Task Submit()
    {
        await form.Validate();

        if (form.IsValid)
        {
            var UserName = asv.GetAuth().Result.User.Identity!.Name!;
            if (Status == "add")
            {
                _ProductPrice_Export_Details.userupdate = UserName;
                _ProductPrice_Export_Details.CreateAt = DateTime.Now.ToString();
                _ProductPrice_Export_Details.approve = false;
                _ProductPrice_Export_Details.continued = true;
                _ProductPrice_Export_Details.editable = true;
            }
     
            _ProductPrice_Export_Details.dateupdate = DateTime.Now.ToString();
            _ProductPrice_Export_Details.userupdate = UserName;
            if (_attach != null) await _attach.CommitAsync();
            MudDialog!.Close(_ProductPrice_Export_Details);

           
        }

    }
    AttachmentField? _attach;
    async Task Cancel()
    {
        if (_attach != null) await _attach.RollbackAsync();
        MudDialog.Cancel();
    }

    void CallSnackBar(string message, MudBlazor.Severity severity)
    {

        Snackbar.Configuration.SnackbarVariant = Variant.Filled;
        Snackbar.Configuration.MaxDisplayedSnackbars = 3;
        Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopRight;
        Snackbar.Add(message, severity);
    }
    private async Task<IEnumerable<string?>> SearchUnit(string? text)
    {
        try
        {
            var items = ExportCosts.Select(x => x.donvitinh).Distinct();
            if (string.IsNullOrEmpty(text))
            {
                return items;
            }
            // MBL.Porname = mst_Consignee;
            return items.Where(x => x != null && x.Equals(text));
        }
        catch (Exception)
        {
            throw;
        }
    }
    private async Task Get_BGNHNo()
    {

        int formattedYear = DateTime.Now.Year;
        int formattedMonth = DateTime.Now.Month;

        string usr = asv.GetAuth().Result.User.Identity!.Name!;
        var refno = await supsv.GetRefNoByFunc("ProductPrice_Export", formattedMonth, formattedYear, usr);

        var rs = asv.GetUserDetail();
        var cn = rs.Branch;
        _ProductPrice_Export_Details.maRFQ = cn + "PR_EX_" + formattedYear.ToString() + formattedMonth.ToString() + refno.Value.ToString("D4");
    }
    private async Task<IEnumerable<string?>> SearchIncoterm(string? text)
    {
        try
        {
            var items = List_Incoterm.Distinct();
            if (string.IsNullOrWhiteSpace(text))
            {
                return items;
            }

            return items.Where(x => x != null && x.Contains(text, StringComparison.OrdinalIgnoreCase));
        }
        catch (Exception)
        {
            throw;
        }
    }
    private async Task<IEnumerable<string?>> SearchType(string? text)
    {
        try
        {
            var items = List_Type.Distinct();
            if (string.IsNullOrWhiteSpace(text))
            {
                return items;
            }

            return items.Where(x => x != null && x.Contains(text, StringComparison.OrdinalIgnoreCase));
        }
        catch (Exception)
        {
            throw;
        }
    }

    private async Task<IEnumerable<string>> Search_User(string value)
    {
        if (string.IsNullOrEmpty(value))
            return ListUser;

        return ListUser.Where(x => x.Contains(value, StringComparison.InvariantCultureIgnoreCase));
    }

    private async Task Getuser(M_ExportCostRequest item)
    {
        if (string.IsNullOrEmpty(item.Userhandle))
        {
            item.Userhandle = UserHanding;
        }
        else
        {
            item.Userhandle += "," + UserHanding + ",";
        }
    }

    private bool _processingUpload = false;
    async Task SendMailnotify(M_ExportCostRequest item)
    {
        try
        {
            string[] users = item.Userhandle.Split(',');
            List<string> emails = new List<string>(); // Danh sách động, có thể thêm thoải mái

            int index = 0;
            foreach (var user in users)
            {
                if (string.IsNullOrEmpty(user))
                {

                }
                else
                {
                    string inputemail = "";
                    inputemail = await gsv.GetEmailAsync(user);
                    if (!string.IsNullOrEmpty(inputemail))
                    {
                        emails.Add(inputemail);
                    }

                }
            }
            string[] emailarray = emails.ToArray();
            _processingUpload = true;
            await Task.Delay(1);
            StateHasChanged();
           
            if (emails != null && emailarray.Length > 0)
            {
     
                var rs = await gsv.GuiThongBaoProject_product_price_export(item, emailarray);

                CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);

            }
            else
            {

                CallSnackBar(Localizer["EmailEmpty"], MudBlazor.Severity.Warning);
                return;
            }


        }
        catch (Exception ex)
        {
            CallSnackBar(string.Format(Localizer["SomethingWentWrong"], ex.Message), MudBlazor.Severity.Error);
        }
        finally
        {
            _processingUpload = false;
        }

    }

    private bool _processingUpload_message = false;
    async Task SendMessage(M_ExportCostRequest item)
    {
        try
        {
            string[] users = item.Userhandle.Split(',');
            List<string> listid = new List<string?>(); // Danh sách động, có thể thêm thoải mái

            int index = 0;
            foreach (var user in users)
            {
                if (string.IsNullOrEmpty(user))
                {

                }
                else
                {

                    Guid? inputid = await gsv.GetIdfromUser(user);
                    if (inputid != null)
                    {
                        listid.Add(inputid.ToString());
                    }

                }
            }
            string[] Idarray = listid.ToArray();
            _processingUpload_message = true;
            await Task.Delay(1);
            StateHasChanged();
            string noidung = "Request Pricing Export FRQ No:" + item.maRFQ;
            if (listid != null && Idarray.Length > 0)
            {
                await _notificationService.SendNotificationAsync(Idarray, noidung);


            }
            else
            {

                CallSnackBar(Localizer["UserEmpty"], MudBlazor.Severity.Warning);
                return;
            }

        }
        catch (Exception ex)
        {
            CallSnackBar(string.Format(Localizer["SomethingWentWrong"], ex.Message), MudBlazor.Severity.Error);
        }
        finally
        {
            _processingUpload_message = false;
        }
    }

}
