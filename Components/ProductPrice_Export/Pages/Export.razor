<style>
    .pp-page-shell {
        background: linear-gradient(180deg, #f8fbff 0%, #ffffff 45%);
        border: 1px solid #e5edf7;
        border-radius: 20px;
        padding: 16px;
        box-shadow: 0 12px 34px rgba(15, 23, 42, .07);
    }

    .pp-page-titlebar {
        background: #ffffff;
        border: 1px solid #e6edf5;
        border-radius: 18px;
        padding: 14px 16px;
        margin-bottom: 14px;
        box-shadow: 0 8px 22px rgba(15, 23, 42, .05);
    }

    .pp-page-title {
        font-size: 20px;
        font-weight: 800;
        color: #0f4c75;
        letter-spacing: .01em;
    }

    .pp-page-subtitle {
        color: #64748b;
        font-size: 12px;
        margin-top: 2px;
    }

    .pp-actionbar {
        background: #ffffff;
        border: 1px solid #e6edf5;
        border-radius: 18px;
        padding: 10px 12px;
        margin-bottom: 14px;
        box-shadow: 0 6px 18px rgba(15, 23, 42, .05);
        flex-wrap: wrap;
    }

        .pp-actionbar .mud-button-root {
            border-radius: 999px;
            text-transform: none;
            font-weight: 700;
            letter-spacing: .01em;
            min-height: 34px;
            box-shadow: 0 4px 12px rgba(17, 138, 178, .14);
        }

    .pp-grid-card,
    .pp-chart-card {
        overflow: hidden;
        border: 1px solid #dbe7f3;
        border-radius: 20px;
        background: #ffffff;
        box-shadow: 0 10px 28px rgba(15, 23, 42, .06);
    }

    .pp-grid {
        padding: 0 !important;
        font-size: 12.5px;
    }

        .pp-grid .mud-table-container {
            border-radius: 20px;
        }

        .pp-grid .mud-table {
            border-collapse: separate;
            border-spacing: 0;
        }

            .pp-grid .mud-table-head,
            .pp-grid .mud-table thead {
                background: linear-gradient(90deg, #0f7fa5 0%, #118ab2 55%, #14a3c7 100%) !important;
            }

                .pp-grid .mud-table-head th,
                .pp-grid .mud-table thead th {
                    background: transparent !important;
                    color: #ffffff !important;
                    font-size: 12px;
                    font-weight: 800;
                    white-space: nowrap;
                    padding: 8px 10px !important;
                    border-bottom: none !important;
                }

            .pp-grid .mud-table-body td,
            .pp-grid .mud-table tbody td {
                padding: 6px 10px !important;
                vertical-align: middle;
                border-bottom: 1px solid #eef3f8 !important;
                max-width: 220px;
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
            }

        .pp-grid .mud-table-body tr:nth-child(even) {
            background-color: #fbfdff;
        }

        .pp-grid .mud-table-body tr:hover {
            background-color: #eef9ff !important;
            cursor: pointer;
        }

        .pp-grid .mud-table-body tr.selected,
        .pp-grid .mud-table-body tr.selected:hover {
            background: linear-gradient(90deg, #0ea5e9 0%, #0284c7 100%) !important;
        }

            .pp-grid .mud-table-body tr.selected td,
            .pp-grid .mud-table-body tr.selected .mud-input,
            .pp-grid .mud-table-body tr.selected .mud-input-control,
            .pp-grid .mud-table-body tr.selected .mud-input-slot {
                color: #ffffff !important;
            }

        .pp-grid .mud-icon-button {
            border-radius: 10px;
            padding: 5px;
        }

        .pp-grid .mud-checkbox {
            justify-content: center;
        }

    .pp-chart-card {
        margin-top: 16px;
        padding: 14px;
    }

    .pp-chart-title {
        font-size: 15px;
        font-weight: 800;
        color: #0f4c75;
        margin-bottom: 8px;
    }

    .no-wrap {
        white-space: nowrap;
    }

    .text-right input,
    .custom-right-align {
        text-align: right !important;
    }

    .class-dialog-custom {
        backdrop-filter: blur(10px);
        transition: none !important;
        animation: none !important;
    }

    @@media (max-width: 960px) {
        .pp-page-shell {
            padding: 8px;
            border-radius: 14px;
        }

        .pp-page-titlebar,
        .pp-actionbar {
            border-radius: 14px;
        }

        .pp-grid .mud-table-body td,
        .pp-grid .mud-table thead th {
            padding: 6px 8px !important;
        }
    }
</style>

<PageTitle>@Localizer["Product_Price_Export"]</PageTitle>

<div class="pp-page-shell">
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="pp-page-titlebar" Spacing="2">
        <MudStack Spacing="0">
            <MudText Class="pp-page-title">@Localizer["Product_Price_Export"]</MudText>
            <MudText Class="pp-page-subtitle">@Localizer["PricingExport_Subtitle"]</MudText>
        </MudStack>

        <MudChip T="string" Color="Color.Info" Variant="Variant.Outlined" Size="Size.Small">
            @Listdata?.Count @Localizer["Rows"]
        </MudChip>
    </MudStack>

    <MudStack Row="true" Justify="Justify.FlexStart" AlignItems="AlignItems.Center" Class="pp-actionbar" Spacing="1">
        <MudButton HtmlTag="label"
                   OnClick="Refresh"
                   Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled"
                   StartIcon="@Icons.Material.Filled.Refresh">
            @Localizer["reload"]
        </MudButton>

        <MudButton HtmlTag="label"
                   @onclick="@((e) => OpenCreateDialog(new Models.M_ExportCostRequest()))"
                   Size="Size.Small" Color="Color.Secondary" Variant="Variant.Filled"
                   StartIcon="@Icons.Material.Filled.Add">
            @Localizer["new"]
        </MudButton>

        <MudButton HtmlTag="label"
                   @onclick="@((e) => OpenEditDialog(detail))"
                   Size="Size.Small" Color="Color.Info" Variant="Variant.Filled"
                   StartIcon="@Icons.Material.Filled.Edit">
            @Localizer["edit"]
        </MudButton>

        <MudButton HtmlTag="label"
                   @onclick="@(() => OpenAddDetailDialog(detail))"
                   Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled"
                   StartIcon="@Icons.Material.Filled.PlaylistAdd">
            @Localizer["ADD_Detail"]
        </MudButton>

        <MudButton HtmlTag="label"
                   @onclick="@((e) => OpenDuplicateDialog(detail))"
                   Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined"
                   StartIcon="@Icons.Material.Filled.CopyAll">
            @Localizer["duplicate"]
        </MudButton>
    </MudStack>

    <div class="pp-grid-card">
        <MudDataGrid T="M_ExportCostRequest" Items="@Listdata" Filterable="true" @ref="mudTable" Class="pp-grid" Bordered="false" Hover="true"
                     FilterMode="@DataGridFilterMode.ColumnFilterRow" Dense="true" Virtualize="true" QuickFilter="@FilterFunc1"
                     FixedHeader="true" FixedFooter="true" HeaderClass="no-wrap" FooterClass="no-wrap"
                     ReadOnly="false" RowClassFunc="@SelectedRowClassFunc"
                     RowClick="@RowClicked" EditDialogOptions="@options"
                     ColumnResizeMode="ResizeMode.Column" Loading="_loading">
            <Columns>
                <HierarchyColumn T="M_ExportCostRequest"></HierarchyColumn>

                <TemplateColumn CellClass="d-flex justify-end">
                    <CellTemplate>
                        <MudIconButton Icon="@Icons.Material.Outlined.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => DeleteItem(context.Item))" />
                    </CellTemplate>
                </TemplateColumn>

                <PropertyColumn Property="x => x.maRFQ" Title="@Localizer["MaRFQ"]" CellStyleFunc="_cellStyleFunc"></PropertyColumn>
                <PropertyColumn Property="x => x.Tenhang" Title="@Localizer["TenHang_gs"]" CellStyleFunc="_cellStyleFunc"></PropertyColumn>
                <PropertyColumn Property="x => x.soluong" Title="@Localizer["Quantity"]" Format="#,##0.##" Culture="@_en" CellStyleFunc="_cellStyleFunc" CellClass="custom-right-align"></PropertyColumn>
                <PropertyColumn Property="x => x.donvitinh" Title="@Localizer["Unit"]" CellStyleFunc="_cellStyleFunc"></PropertyColumn>
                <PropertyColumn Property="x => x.cangdi" Title="@Localizer["cangdi"]" CellStyleFunc="_cellStyleFunc"></PropertyColumn>
                <PropertyColumn Property="x => x.cangden" Title="@Localizer["cangden"]" CellStyleFunc="_cellStyleFunc"></PropertyColumn>
                <PropertyColumn Property="x => x.incoterm" Title="@Localizer["Incoterm"]" CellStyleFunc="_cellStyleFunc"></PropertyColumn>
                <PropertyColumn Property="x => x.trangthai" Title="@Localizer["status"]" CellStyleFunc="_cellStyleFunc"></PropertyColumn>
                <PropertyColumn Property="x => x.ngayguiyeucau" Title="@Localizer["Ngayguiyeucau"]" Format="dd/MM/yyyy" CellStyleFunc="_cellStyleFunc"></PropertyColumn>
                <PropertyColumn Property="x => x.loaihinh" Title="@Localizer["Loaihinh"]" CellStyleFunc="_cellStyleFunc"></PropertyColumn>
                <PropertyColumn Property="x => x.noidung" Title="@Localizer["noidung"]" CellStyleFunc="_cellStyleFunc"></PropertyColumn>
                <PropertyColumn Property="x => x.Userhandle" Title="@Localizer["Userhandle"]" CellStyleFunc="_cellStyleFunc"></PropertyColumn>

                <TemplateColumn Title="@Localizer["Approve"]">
                    <CellTemplate>
                        <MudCheckBox @bind-Checked="context.Item.approve" @bind-Value="context.Item.approve" @bind-Value:after="@(()=> OnApproveCheckboxWrapper(context.Item))">
                        </MudCheckBox>
                    </CellTemplate>
                </TemplateColumn>

                <PropertyColumn Property="x => x.continued" Title="@Localizer["Continued"]" CellStyleFunc="_cellStyleFunc"></PropertyColumn>
                <PropertyColumn Property="x => x.editable" Title="@Localizer["Editable"]" CellStyleFunc="_cellStyleFunc"></PropertyColumn>
                <PropertyColumn Property="x => x.CreateAt" Title="@Localizer["CreatedAt"]" CellStyleFunc="_cellStyleFunc"></PropertyColumn>
                <PropertyColumn Property="x => x.Usercreate" Title="@Localizer["Nguoilap"]" CellStyleFunc="_cellStyleFunc"></PropertyColumn>
                <PropertyColumn Property="x => x.userupdate" Title="@Localizer["Userupdate"]" CellStyleFunc="_cellStyleFunc"></PropertyColumn>
                <PropertyColumn Property="x => x.dateupdate" Title="@Localizer["Dateupdate"]" CellStyleFunc="_cellStyleFunc"></PropertyColumn>
            </Columns>

            <ChildRowContent>
                <div class="pa-3">
                    <Add_Detail_Export__Index _ProductPrice_Export_Details="context.Item" />
                </div>
            </ChildRowContent>

            <PagerContent>
                <MudDataGridPager T="M_ExportCostRequest" PageSizeOptions="@(new int[] { 8, 10, 20 })" />
            </PagerContent>
        </MudDataGrid>
    </div>

    <div class="pp-chart-card">
        <MudText Class="pp-chart-title">@Localizer["Product_Price_Export"]</MudText>
        <MudChart ChartType="ChartType.Bar"
                  ChartSeries="@Series"
                  XAxisLabels="@XAxisLabels"
                  Height="350px" Width="100%"
                  ChartOptions="options_chart" />
    </div>
</div>

@code {
    List<M_ExportCostRequest> Listdata = new List<M_ExportCostRequest>();
    MudDataGrid<M_ExportCostRequest> mudTable;
    AuthUser user;
    string mailtp, mailpp;
    string usr;
    private List<string> ListUser { get; set; } = new List<string>();
    string UserHanding;
    List<string> trangthais = new List<string>();
    private List<Models.TrangThai> M_Trangthais = new List<Models.TrangThai>();
    private string searchText_pol = "";
    private string searchText_pod = "";
    private List<PortModel> filteredPorts = new List<PortModel>();
    private List<PortModel> filteredPorts_pod = new List<PortModel>();
    private List<PortModel> Ports = new List<PortModel>();
    private bool _resizeColumn;
    M_ExportCostRequest detail;
    private List<Models.M_Customer> CustomerList = new List<Models.M_Customer>();
    private List<M_DNTT_Logistics> DNTTs = new List<M_DNTT_Logistics>();
    public CultureInfo _en = CultureInfo.GetCultureInfo("en-US");
    private List<M_Product_Price_detail_ALL> M_details_Alls = new List<M_Product_Price_detail_ALL>();
    private List<M_Product_Price_detail_ALL> List_detail = new List<M_Product_Price_detail_ALL>();
    public List<ChartSeries> Series = new List<ChartSeries>
    {
        new ChartSeries() { Name = "Fee", Data = new double[] { } }
    };
    public string[] XAxisLabels = { };
    private List<ChargeModel> List_Charge = new List<ChargeModel>();

    protected async override Task OnInitializedAsync()
    {
        CustomerList = await Cussv.GetList();
        M_Trangthais = await supsv.GetListTrangThai();
        var tts = await supsv.GetListTrangThai();
        trangthais = tts.Where(x => x.Tieude == "ProductPrice").OrderBy(x => x.Noidung).Select(x => x.Noidung).ToList();
        DNTTs = DNTUSV.GetListDNTT_all();
        List_Charge = await supsv.GetListCharge();
        ListUser = await asv.GetList_User_handle() ?? new List<string>();
        usr = asv.GetAuth().Result.User.Identity!.Name!;

        // await Refresh();
    }

    string CustomerName(Guid? iddntt)
    {
        var rs = DNTTs.FirstOrDefault(x => x.Id == iddntt);
        return rs != null ? rs.So! : "";
    }

    bool _loading = false;
    async Task Refresh()
    {
        try
        {

            detail = null!;
            _loading = true;
            Listdata.Clear();

            await Task.Delay(500);
            if (!await ssv.CheckPermission(usr, "View", "Product_Price_Export"))
            {
                CallSnackBar(Localizer["NoPermission_View"], MudBlazor.Severity.Warning);
                return;
            }
            Listdata = await prsv.GetProduct_Price_export();
            await GetChart();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            CallSnackBar(string.Format(Localizer["SomethingWentWrong"], ex.Message), MudBlazor.Severity.Warning);
        }
        finally
        {
            _loading = false;
        }

    }

    void CallSnackBar(string message, MudBlazor.Severity severity)
    {
        Snackbar.Clear();
        Snackbar.Configuration.SnackbarVariant = Variant.Filled;
        Snackbar.Configuration.MaxDisplayedSnackbars = 3;
        Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopRight;
        Snackbar.Add(message, severity);
    }
    void RowClicked(DataGridRowClickEventArgs<M_ExportCostRequest> args)
    {
        detail = args.Item;
    }
    private int selectedRowNumber = -1;
    private string SelectedRowClassFunc(M_ExportCostRequest m, int rowNumber)
    {
        if (selectedRowNumber == rowNumber)
        {
            selectedRowNumber = -1;
            return string.Empty;
        }
        else if (mudTable.SelectedItem != null && mudTable.SelectedItem.Equals(m))
        {
            selectedRowNumber = rowNumber;
            return "selected";
        }
        else
        {
            return string.Empty;
        }
    }


    int? index_no;

    async Task DeleteItem(M_ExportCostRequest item)
    {
        if (item.approve == true)
        {
            CallSnackBar(Localizer["DataAlreadyApproved"], MudBlazor.Severity.Warning);
            return;
        }
        if (!await ssv.CheckPermission(usr, "Delete", "Product_Price_Export"))
        {
            CallSnackBar(Localizer["NoPermission_Delete"], MudBlazor.Severity.Warning);
            return;
        }
        var resultMess = await DialogService.ShowMessageBox(
                Localizer["Warning"],
                Localizer["DeleteConfirmBody"],
                yesText: Localizer["delete"], cancelText: Localizer["cancel"]);

        if (resultMess.HasValue)
        {
            var rs = await prsv.DeleteProductPrice_export(item);
            await prsv.DeleteDetail_All(item.id);
            await HistoryLogService.LogAsync(usr, "Delete Export Cost Pricing", "Product_Price_Export", item.id, "", new { OldData = item });
            CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
            await Refresh();
        }

    }
    DialogOptions options = new DialogOptions
    {
        ClassBackground = "class-dialog-custom",
        FullWidth = true,
        MaxWidth = MaxWidth.Medium,
        CloseOnEscapeKey = false,
        DisableBackdropClick = true
    };
    string search;

    private bool FilterFunc1(M_ExportCostRequest sbd) => FilterFunc(sbd, search);

    private bool FilterFunc(M_ExportCostRequest sbd, string searchString)
    {
        if (string.IsNullOrWhiteSpace(sbd.maRFQ))
            return true;
        if (string.IsNullOrWhiteSpace(searchString))
            return true;
        if (sbd.maRFQ!.Contains(searchString, StringComparison.OrdinalIgnoreCase))
            return true;
        if ($"{sbd.maRFQ} ".Contains(searchString))
            return true;
        return false;
    }

    private Func<M_ExportCostRequest, string> _cellStyleFunc => x =>
       {

           string style = "";

           if (string.IsNullOrEmpty(x.trangthai))
               return "color: #000000";

           var rs = M_Trangthais
           .Where(t => (t.Noidung).Contains(x.trangthai, StringComparison.InvariantCultureIgnoreCase)
               && t.Tieude.Equals("ProductPrice", StringComparison.InvariantCultureIgnoreCase))
           .Select(t => t.Mamau)
           .FirstOrDefault();
           return "color: " + rs;


       };

    private async Task OpenCreateDialog(Models.M_ExportCostRequest tr)
    {
        var optionsdialog = new DialogOptions { ClassBackground = "class-dialog-custom", FullWidth = true, MaxWidth = MaxWidth.Medium };

        if (await ssv.CheckPermission(asv.GetAuth().Result.User.Identity.Name, "Add", "Product_Price_Export"))
        {

            DialogOptions closeOnEscapeKey = new DialogOptions() { CloseOnEscapeKey = true };
            var parameters = new DialogParameters<Add_Export> { { x => x._ProductPrice_Export_Details, tr }, { x => x.Status, "add" } };

            var dialog = await DialogService.ShowAsync<Add_Export>(tr.id == Guid.Empty ? Localizer["PricingExport_Create"] : Localizer["PricingExport_Edit"], parameters, optionsdialog);
            var result = await dialog.Result;
            if (!result.Canceled)
            {
                var data = (M_ExportCostRequest)result.Data;
                var rs = await prsv.UpdateCreateProduct_export(data);
                await HistoryLogService.LogAsync(usr, "ADD", "Product_Price_Export", data.id, data.maRFQ, data);

                MudBlazor.Severity severity;
                if (rs[1] == "1")
                    severity = MudBlazor.Severity.Success;
                else
                    severity = MudBlazor.Severity.Error;

                CallSnackBar(rs[0], severity);

                await HandleRefresh_create(data.id);

            }

            return;

        }
        else
        {
            CallSnackBar(Localizer["NoPermission_Add"], MudBlazor.Severity.Warning);
            return;
        }

    }

    async Task HandleRefresh_create(Guid? id)
    {
        try
        {

            detail = null;


            if (Listdata != null)
            {
                Listdata.Clear();
            }

            await Task.Delay(500);

            if (!await ssv.CheckPermission(asv.GetAuth().Result.User.Identity.Name, "View", "Product_Price_Export"))
            {
                CallSnackBar(Localizer["NoPermission_View"], MudBlazor.Severity.Warning);

                return;
            }
            Listdata = await prsv.GetProduct_price_export_create(id);
            StateHasChanged();
        }
        finally
        {


        }
    }

    private async Task OpenEditDialog(Models.M_ExportCostRequest tr)
    {
        var optionsdialog = new DialogOptions { ClassBackground = "class-dialog-custom", FullWidth = true, MaxWidth = MaxWidth.Medium };
        if (tr == null)
        {
            CallSnackBar(Localizer["PleaseSelectData"], MudBlazor.Severity.Warning);
            return;
        }

        if (tr.approve == true)
        {
            CallSnackBar(Localizer["DataAlreadyApproved"], MudBlazor.Severity.Warning);
            return;
        }

        if (await ssv.CheckPermission(asv.GetAuth().Result.User.Identity.Name, "Edit", "Product_Price_Export"))
        {
            var OldData = JsonSerializer.Deserialize<M_ExportCostRequest>(JsonSerializer.Serialize(tr));
            DialogOptions closeOnEscapeKey = new DialogOptions() { CloseOnEscapeKey = true };
            var parameters = new DialogParameters<Add_Export> { { x => x._ProductPrice_Export_Details, tr }, { x => x.Status, "edit" } };

            var dialog = await DialogService.ShowAsync<Add_Export>(Localizer["PricingExport_Edit"], parameters, optionsdialog);
            var result = await dialog.Result;
            // Giữ nguyên dòng được chọn
            selectedRowNumber = selectedRowNumber;
            StateHasChanged();

            if (!result.Canceled)
            {
                var data = (M_ExportCostRequest)result.Data;
                var rs = await prsv.UpdateCreateProduct_export(data);
                await HistoryLogService.LogAsync(usr, "Update", "Product_Price_Export", data.id, data.maRFQ, new { OldData = OldData, NewData = data });
                MudBlazor.Severity severity;
                if (rs[1] == "1")
                    severity = MudBlazor.Severity.Success;
                else
                    severity = MudBlazor.Severity.Error;

                CallSnackBar(rs[0], severity);
            }

            return;

        }
        else
        {
            CallSnackBar(Localizer["NoPermission_Edit"], MudBlazor.Severity.Warning);
            return;
        }

    }

    private async Task OpenAddDetailDialog(Models.M_ExportCostRequest tr)
    {
        var optionsdialog = new DialogOptions { ClassBackground = "class-dialog-custom", FullWidth = true, MaxWidth = MaxWidth.ExtraExtraLarge };
        if (tr == null)
        {
            CallSnackBar(Localizer["PleaseSelectData"], MudBlazor.Severity.Warning);
            return;
        }
        if (tr.approve == true)
        {
            CallSnackBar(Localizer["DataAlreadyApproved"], MudBlazor.Severity.Warning);
            return;
        }

        if (await ssv.CheckPermission(asv.GetAuth().Result.User.Identity.Name, "Add", "Product_Price_Export"))
        {

            DialogOptions closeOnEscapeKey = new DialogOptions() { CloseOnEscapeKey = true };
            var parameters = new DialogParameters<Add_Detail_Export> { { x => x._ProductPrice_Export_Details, tr }, { x => x.Status, "edit" } };

            var dialog = await DialogService.ShowAsync<Add_Detail_Export>(Localizer["PricingExport_AddDetail"], parameters, optionsdialog);
            var result = await dialog.Result;
            // Giữ nguyên dòng được chọn
            selectedRowNumber = selectedRowNumber;
            StateHasChanged();

            if (!result.Canceled)
            {
                var data = (M_ExportCostRequest)result.Data;
                var rs = await prsv.UpdateCreateProduct_export(data);
                MudBlazor.Severity severity;
                if (rs[1] == "1")
                    severity = MudBlazor.Severity.Success;
                else
                    severity = MudBlazor.Severity.Error;

                CallSnackBar(rs[0], severity);
            }

            return;

        }
        else
        {
            CallSnackBar(Localizer["NoPermission_Add"], MudBlazor.Severity.Warning);
            return;
        }

    }

    private async Task OpenDuplicateDialog(Models.M_ExportCostRequest tr)
    {
        Guid id_temp = tr.id;
        var optionsdialog = new DialogOptions { ClassBackground = "class-dialog-custom", FullWidth = true, MaxWidth = MaxWidth.Medium };
        if (tr == null)
        {
            CallSnackBar(Localizer["PleaseSelectData"], MudBlazor.Severity.Warning);
            return;
        }

        if (await ssv.CheckPermission(asv.GetAuth().Result.User.Identity.Name, "Add", "Product_Price_Export"))
        {
            var OldData = JsonSerializer.Deserialize<M_ExportCostRequest>(JsonSerializer.Serialize(tr));
            DialogOptions closeOnEscapeKey = new DialogOptions() { CloseOnEscapeKey = true };
            var parameters = new DialogParameters<Add_Export> { { x => x._ProductPrice_Export_Details, tr }, { x => x.Status, "Duplicate" } };

            var dialog = await DialogService.ShowAsync<Add_Export>(Localizer["PricingExport_Create"], parameters, optionsdialog);
            var result = await dialog.Result;
            // Giữ nguyên dòng được chọn
            selectedRowNumber = selectedRowNumber;
            StateHasChanged();

            if (!result.Canceled)
            {
                var data = (M_ExportCostRequest)result.Data;
                var rs = await prsv.UpdateCreateProduct_export(data);
                await HistoryLogService.LogAsync(usr, "Duplicate", "Product_Price_Export", data.id, data.maRFQ, new { OldData = OldData, NewData = data });
                MudBlazor.Severity severity;
                if (rs[1] == "1")
                    severity = MudBlazor.Severity.Success;

                else
                    severity = MudBlazor.Severity.Error;

                CallSnackBar(rs[0], severity);

                if (rs[1] == "1")
                {
                    M_details_Alls = await prsv.GetListProductPriceDetails_ALL(id_temp);
                    foreach (var item in M_details_Alls)
                    {
                        item.Id = Guid.Empty;
                        item.RFQ_Id = tr.id;
                        item.Ngaybaogia = DateTime.Now;
                        item.Createat = DateTime.Now.ToString();
                        var UserName = asv.GetAuth().Result.User.Identity!.Name!;
                        item.Usercreate = UserName;
                        item.Userupdate = UserName;
                        item.Dateupdate = DateTime.Now.ToString("dd/MMM/yyyy");
                        item.Continued = true;
                        item.Editable = true;
                        item.Approve = false;
                        await prsv.UpdateCreateProduct_Detail_truck(item);
                    }
                }

                await HandleRefresh_create(data.id);





            }

            return;

        }
        else
        {
            CallSnackBar(Localizer["NoPermission_Add"], MudBlazor.Severity.Warning);
            return;
        }

    }

    private async Task OnApproveCheckboxWrapper(M_ExportCostRequest item)
    {
        if (await ssv.CheckPermission(asv.GetAuth().Result.User.Identity.Name, "Approve", "Product_Price_Export"))
        {
            var rs = await prsv.UpdateCreateProduct_export(item);
            MudBlazor.Severity severity;
            if (rs[1] == "1")
                severity = MudBlazor.Severity.Success;
            else
                severity = MudBlazor.Severity.Error;

            CallSnackBar(rs[0], severity);

        }
        else
        {
            CallSnackBar(Localizer["NoPermission_Approve"], MudBlazor.Severity.Warning);
            return;
        }

    }


    private ChartOptions options_chart = new ChartOptions
    {
        YAxisFormat = "#,##0"
    };

    public async Task GetChart()
    {
        List_detail = await prsv.GetProduct_Price_Detail_ByType("Export");
        if (List_detail.Count == 0)
        {
            CallSnackBar(Localizer["NoDataChart"], MudBlazor.Severity.Warning);
            return;
        }
        List_Charge = await supsv.GetListCharge();
        var xLabels = new[]
                {
                    "",
                    "",
                    ""
                };
        // Nhóm theo Itemid, lấy tên item từ List_Charge
        var chartData = List_detail
             .GroupBy(x => x.Itemid)
             .Select(g =>
             {
                 var itemName = List_Charge.FirstOrDefault(c => c.CHARGE_ID == g.Key)?.CHARGE ?? $"Unknown ({g.Key})";

                 double totalAmount = g.Sum(x => x.Cur == "USD"
                     ? Convert.ToDouble((x.Thanhtien ?? 0) * (x.Tigia ?? 1))
                     : Convert.ToDouble(x.Thanhtien ?? 0));

                 return new
                 {
                     ItemName = itemName,
                     TotalAmount = totalAmount
                 };
             }).ToList();

        // Trục X là tên từng item
        XAxisLabels = chartData.Select(x => x.ItemName).ToArray();

        // Series có 1 ChartSeries với data là tổng amount theo item, đúng thứ tự với XAxisLabels
        Series = chartData.Select(x => new ChartSeries
        {
            Name = x.ItemName,           // Tên cột là tên item
            Data = new double[] { 0, x.TotalAmount, 0 }  // 1 điểm dữ liệu (1 cột)
        }).ToList();

        // Trục X có thể là tên tháng, hoặc 1 giá trị dummy nếu bạn chỉ có 1 điểm cho mỗi series
        // Nếu biểu đồ dạng cột theo item, bạn có thể để XAxisLabels = new string[] { "" };
        XAxisLabels = new string[] { "" };

    }

