@using MudBlazor
@using System.Globalization
@using System.Linq
@using MudBlazor.Components
@attribute [Authorize]
@inject GlobalServices gsv
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject AccountService asv
@inject SharedServices ssv
@inject BookingService bksv
@inject IJSRuntime JSRuntime
@inject SupportServices supsv
@inject IStringLocalizer<SharedResource> Localizer
@inject LocalChargesServices lcsv
@inject CustomerService Cussv
@inject PhieuThu_Chi_Services thuchisv
@inject ReportServices rpsv
@inject DNTUServices DNTUsv

@inject QuotationService Quosv
@inject IJSRuntime JSRuntime

<PageTitle>@Localizer["RPT_TU_HU"] </PageTitle>
<MudText Class="pa-2" Typo="Typo.h6">@Localizer["RPT_TU_HU"]</MudText>


<MudGrid Class="pa-6">
    <!-- Picker chiếm 4/12 cột -->
    <MudItem xs="2">
        <MudDateRangePicker Label="@Localizer["searchdatefromto"]"
                            @bind-DateRange="_dateRange" />
    </MudItem>

    <!-- Button chiếm 3/12 cột -->
    <MudItem xs="2">
        <MudButton HtmlTag="label"
                   OnClick="Search"
                   Size="Size.Small"
                   Color="Color.Primary"
                   Variant="Variant.Filled"
                   StartIcon="@Icons.Material.Filled.Refresh">
            @Localizer["Search"]
        </MudButton>
    </MudItem>

    <!-- From Month -->
    <MudItem xs="1">
        <MudSelect T="int" Label="Từ tháng" @bind-Value="fromThang" Dense="true">
            @foreach (var m in Months)
            {
                <MudSelectItem T="int" Value="m">@m</MudSelectItem>
            }
        </MudSelect>
    </MudItem>

    <!-- From Year -->
    <MudItem xs="1">
        <MudSelect T="int" Label="Từ năm" @bind-Value="fromNam" Dense="true">
            @foreach (var y in Years)
            {
                <MudSelectItem T="int" Value="y">@y</MudSelectItem>
            }
        </MudSelect>
    </MudItem>

    <MudItem xs="1">
        <MudSelect T="int" Label="Đến tháng" @bind-Value="toThang" Dense="true">
            @foreach (var m in Months)
            {
                <MudSelectItem T="int" Value="m">@m</MudSelectItem>
            }
        </MudSelect>
    </MudItem>

    <!-- To Year -->
    <MudItem xs="1">
        <MudSelect T="int" Label="Đến năm" @bind-Value="toNam" Dense="true">
            @foreach (var y in Years)
            {
                <MudSelectItem T="int" Value="y">@y</MudSelectItem>
            }
        </MudSelect>
    </MudItem>

    <MudItem xs="2">
        <MudButton HtmlTag="label"
        OnClick="Search_By_months"
        Size="Size.Small" Color="Color.Primary" Variant="   Variant.Filled"
        StartIcon="@Icons.Material.Filled.Refresh">
            @Localizer["Search Months"]
        </MudButton>
    </MudItem>

    <MudItem xs="2">
        <MudSelect @bind-Value="_Cur" Label="@Localizer["Loaitiente"]" Class="label-right">
            <MudSelectItem Value="@("VND")">VND</MudSelectItem>
            <MudSelectItem Value="@("USD")">USD</MudSelectItem>
        </MudSelect>
    </MudItem>

</MudGrid>


<MudContainer MaxWidth="MudBlazor.MaxWidth.False" Class="mt-4">
    <MudGrid>
        <!-- Phần bên trái: Report -->
        <MudItem xs="12">
            <MudDataGrid T="M_RPT_TN_HU" Items="@Listdata" Bordered="true" Striped="true" Hover="true" Loading="_loading">
                <Columns>
                    <TemplateColumn Title="STT">
                        <CellTemplate>
                            @{
                                var index = Listdata.IndexOf(context.Item) + 1;
                                @index
                            }
                        </CellTemplate>
                        <FooterTemplate>
                            @Localizer["no"]  <!-- Tùy chỉnh phần footer -->
                        </FooterTemplate>
                    </TemplateColumn>

                    <PropertyColumn Property="x => x.TamungNo" Title="@Localizer["TamungNo"]" CellStyleFunc="_cellStyleFunc" />
                    <PropertyColumn Property="x => x.NgayTamUng" Title="@Localizer["NgayTamUng"]" Format="dd/MMM/yyyy" CellStyleFunc="_cellStyleFunc" />
                    <PropertyColumn Property="x => x.Tennguoitamung" Title="@Localizer["Tennguoitamung"]" CellStyleFunc="_cellStyleFunc" />
                    <PropertyColumn Property="x => x.HoanungNo" Title="@Localizer["HoanungNo"]" CellStyleFunc="_cellStyleFunc" />
                    <PropertyColumn Property="x => x.NgayHoanUng" Title="@Localizer["NgayHoanUng"]" Format="dd/MMM/yyyy" CellStyleFunc="_cellStyleFunc" />
                    <PropertyColumn Property="x => x.Tennguoihoanung" Title="@Localizer["Tennguoihoanung"]" CellStyleFunc="_cellStyleFunc" >
                        <FooterTemplate>
                            @Localizer["ThanhTien"]
                        </FooterTemplate>
                    </PropertyColumn>

                    <PropertyColumn Property="x => x.sotien_TU" Format="#,##0.##" Title="@Localizer["sotien_TU"]" Culture="_en" CellClass="custom-right-align" CellStyleFunc="_cellStyleFunc">
                        <FooterTemplate>
                            @((total_TU.HasValue ? total_TU.Value.ToString("#,##0.##", System.Globalization.CultureInfo.InvariantCulture) : ""))
                        </FooterTemplate>
                    </PropertyColumn>

                    <PropertyColumn Property="x => x.sotien_HU" Format="#,##0.##" Title="@Localizer["sotien_HU"]" Culture="_en" CellClass="custom-right-align" CellStyleFunc="_cellStyleFunc" >
                        <FooterTemplate>
                            @((total_HU.HasValue ? total_HU.Value.ToString("#,##0.##", System.Globalization.CultureInfo.InvariantCulture) : ""))
                        </FooterTemplate>
                    </PropertyColumn>

                    <PropertyColumn Property="x => x.sotien_Conlai" Format="#,##0.##" Title="@Localizer["sotien_Conlai"]" Culture="_en" CellClass="custom-right-align" CellStyleFunc="_cellStyleFunc" >
                        <FooterTemplate>
                            @((total_conlai.HasValue ? total_conlai.Value.ToString("#,##0.##", System.Globalization.CultureInfo.InvariantCulture) : ""))
                        </FooterTemplate>
                    </PropertyColumn>

                    <PropertyColumn Property="x => x.Loaitiente" Title="@Localizer["Loaitiente"]" CellStyleFunc="_cellStyleFunc" />
                    <PropertyColumn Property="x => x.bophan" Title="@Localizer["bophan"]" CellStyleFunc="_cellStyleFunc" />
                    <PropertyColumn Property="x => x.Bkno" Title="@Localizer["Bkno"]" CellStyleFunc="_cellStyleFunc" />
                    <PropertyColumn Property="x => x.HBL" Title="@Localizer["HBL"]" CellStyleFunc="_cellStyleFunc" />

                    <PropertyColumn Property="x => x.trangthai" Title="@Localizer["status"]" CellStyleFunc="_cellStyleFunc" />

                </Columns>

                <PagerContent>
                    <MudDataGridPager T="M_RPT_TN_HU" PageSizeOptions="@(new int[] { 8, 10, 20 })" />
                </PagerContent>
            </MudDataGrid>
        </MudItem>

        <!-- Phần bên phải: Biểu đồ -->
        <MudGrid Justify="Justify.Center">
            <MudItem xs="6">
                <div style="background-color:lightgoldenrodyellow; padding: 16px; border-radius: 8px;">
                    <MudChart ChartType="ChartType.Bar" ChartSeries="@Series" XAxisLabels="@XAxisLabels" Width="100%" Height="350px">
                        <CustomGraphics>
                            <style>
                                .heavy {
                                font: bold 30px Helvetica;
                                }

                                .Rrrrr {
                                font: italic 40px Helvetica;
                                fill: rgb(62,44,221);
                                }
                            </style>

                        </CustomGraphics>
                    </MudChart>
                </div>
            </MudItem>
        </MudGrid>

    </MudGrid>
</MudContainer>

@code {
    private DateRange _dateRange = new DateRange(DateTime.Now.Date, DateTime.Now.AddDays(5).Date);
    private List<M_RPT_TN_HU> Listdata = new();

    private List<M_Customer> List_Cus = new List<M_Customer>();
    private double? total_TU;
    private double? total_HU;
    private double? total_conlai;
    private double? tongsotienthu;
    private double? tongsotienchi;
    private string _Cur = "VND";// Giá trị mặc định
    private bool _processingUpload = false;
    public CultureInfo _en = CultureInfo.GetCultureInfo("en-US");
    // Selected values
    private int fromThang;
    private int fromNam;
    private int toThang;
    private int toNam;
    private string type_search;
    // Data sources
    private readonly int[] Months = Enumerable.Range(1, 12).ToArray();

    // Ví dụ: năm từ 2020 đến 2030
    private readonly int[] Years = Enumerable.Range(2020, 11).ToArray();


    protected async override Task OnInitializedAsync()
    {
        List_Cus = await Cussv.GetList();
        M_Trangthais = await supsv.GetListTrangThai();
        var tts = await supsv.GetListTrangThai();
        trangthais = tts.Where(x => x.Tieude == "DNTU").OrderBy(x => x.Noidung).Select(x => x.Noidung).ToList();
    }
    public class RFQCountByMonthAndStatus
    {
        public string MonthYear { get; set; } // ví dụ: "03/2025"
        public string Status { get; set; }    // ví dụ: "Open", "Closed"
        public int Count { get; set; }
    }
    public class M_RPT_TN_HU
    {
        public string? TamungNo { get; set; }
        public string? HoanungNo { get; set; }
        public DateTime? NgayHoanUng { get; set; }
        public DateTime? NgayTamUng { get; set; }
        public string? Tennguoihoanung { get; set; }
        public string? Tennguoitamung { get; set; }
        public string? bophan { get; set; }
        public double? sotien_TU { get; set; }
        public double? sotien_HU { get; set; }
        public double? sotien_Conlai { get; set; }
        public string? Loaitiente { get; set; }
        public string? Bkno { get; set; }
        public string? HBL { get; set; }
        public string? trangthai { get; set; }
        public Guid? DeNghiTamUngID { get; set; }
    }
    public List<ChartSeries> Series = new();
    public string[] XAxisLabels = Array.Empty<string>();
    List<string> trangthais = new List<string>();
    private List<Models.TrangThai> M_Trangthais = new List<Models.TrangThai>();
    private double[] PieData = Array.Empty<double>();
    private string[] PieLabels = Array.Empty<string>();
    double[] inputData;
    private string[] inputLabels;
    bool _loading = false;


    async Task Search()
    {
        _loading = true;
        Listdata.Clear();
        total_TU = 0;
        total_HU = 0;
        total_conlai = 0;
        var startDate = _dateRange.Start.Value;
        var endDate = _dateRange.End.Value;

        if (startDate != null && endDate != null)
        {
            var Listdata_DNTU = await DNTUsv.GetList_DNTU_bydate(startDate, endDate);
            int totalQuantity = 0;
            foreach (var item in Listdata_DNTU)
            {
                var item_DNHU = await DNTUsv.Get_DNHU_byID_DNTU(item.Id);
                if(item_DNHU != null)
                {
                    totalQuantity += 1;
                }

                double? sotien_vnd_usd_TU = 0;
                double? sotien_vnd_usd_HU = 0;
                if (_Cur == "VND")
                {
                    if (item.Loaitiente == "USD")
                    {
                        sotien_vnd_usd_TU = (item.Sotien ?? 0) * (item.tigia ?? 1);
                    }
                    else
                    {
                        sotien_vnd_usd_TU =(item.Sotien ?? 0);
                    }
                    if (item_DNHU != null)
                    {
                        if (item_DNHU.Loaitiente == "USD")
                        {
                            sotien_vnd_usd_HU = (item_DNHU.Sotien ?? 0) * (item_DNHU.tigia ?? 1);
                        }
                        else
                        {
                            sotien_vnd_usd_HU = (item_DNHU.Sotien ?? 0);
                        }
                    }
                }
                else
                {
                    if (item.Loaitiente == "VND")
                    {
                        sotien_vnd_usd_TU = Math.Round((item.Sotien ?? 0) / (item.tigia ?? 1), 3);
                    }
                    else
                    {
                        sotien_vnd_usd_TU = (item.Sotien ?? 0);
                    }
                    if (item_DNHU != null)
                    {
                        if (item_DNHU.Loaitiente == "VND")
                        {
                            sotien_vnd_usd_HU = Math.Round((item_DNHU.Sotien ?? 0) / (item_DNHU.tigia ?? 1), 3);
                        }
                        else
                        {
                            sotien_vnd_usd_HU = (item_DNHU.Sotien ?? 0);
                        }
                    }
                }

                total_TU += sotien_vnd_usd_TU ?? 0;
                total_HU += sotien_vnd_usd_HU ?? 0;
          

                var rpt = new M_RPT_TN_HU
                    {
                        TamungNo = item.So,
                        HoanungNo = item_DNHU?.So ?? "",
                        NgayTamUng = item.NGAY,
                        NgayHoanUng = item_DNHU?.Ngay,
                        Tennguoitamung = item.Tennguoidenghi,
                        Tennguoihoanung = item_DNHU?.Tennguoidenghi ?? "",
                        bophan = item.Bophan,
                        Loaitiente = item.Loaitiente,
                        sotien_TU = sotien_vnd_usd_TU ?? 0,
                        sotien_HU = sotien_vnd_usd_HU ?? 0,
                        sotien_Conlai = (sotien_vnd_usd_HU ?? 0) - sotien_vnd_usd_TU,
                        Bkno = item.Bkno,
                        HBL = item.Hbl,
                        trangthai=item.Trangthai
                    };
                Listdata.Add(rpt);
            }
            total_conlai = (total_HU ?? 0) - (total_TU ?? 0);
            int SL = Listdata_DNTU.Count;


            // Tính tỷ lệ %
            double percent = SL == 0 ? 0 : (double)totalQuantity / SL * 100;

            // Thêm 2 tháng ảo vào đầu và cuối
            var first = startDate;
            var last = endDate;

            DateTime prev = first.AddMonths(-1);
            DateTime next = last.AddMonths(1);

            // Dữ liệu biểu đồ dạng phần trăm, 2 cột ảo đầu/cuối là 0
            var seriesData = new List<double> { 0, percent, 0 };

            // Nhãn trục X
            var xAxisLabels = new string[] { $"{first:MM/dd/yyyy} - {last:MM/dd/yyyy}" };

            // Gán series
            Series = new List<ChartSeries>
                {
                    new ChartSeries
                    {
                        Name = "Tỷ Lệ Hoàn Ứng / Tạm Ứng (%)",
                        Data = seriesData.ToArray()
                    }
                };

            XAxisLabels = xAxisLabels;

            foreach(var item in Listdata)
            {

            }

            _loading = false;
        }
    }
    async Task Search_By_months()
    {
        Listdata.Clear();
        total_TU = 0;
        total_HU = 0;
        total_conlai = 0;

        if (fromThang != null && fromNam != null && toThang != null && toNam != null && fromThang != 0 && fromNam != 0 && toThang != 0 && toNam != 0)
        {
            var Listdata_DNTU = await DNTUsv.GetList_DNTU_bymonths(fromThang, fromNam, toThang, toNam);
            // Duyệt DNTU và ánh xạ sang DNHU
            foreach (var item in Listdata_DNTU)
            {
                var item_DNHU = await DNTUsv.Get_DNHU_byID_DNTU(item.Id);

                double? sotien_vnd_usd_TU = 0;
                double? sotien_vnd_usd_HU = 0;

                if (_Cur == "VND")
                {
                    if (item.Loaitiente == "USD")
                    {
                        sotien_vnd_usd_TU = (item.Sotien ?? 0) * (item.tigia ?? 1);
                    }
                    else
                    {
                        sotien_vnd_usd_TU = (item.Sotien ?? 0);
                    }

                    if (item_DNHU != null)
                    {
                        if (item_DNHU.Loaitiente == "USD")
                        {
                            sotien_vnd_usd_HU = (item_DNHU.Sotien ?? 0) * (item_DNHU.tigia ?? 1);
                        }
                        else
                        {
                            sotien_vnd_usd_HU = (item_DNHU.Sotien ?? 0);
                        }

                    }

                }
                else
                {
                    if (item.Loaitiente == "VND")
                    {
                        sotien_vnd_usd_TU = Math.Round((item.Sotien ?? 0) / (item.tigia ?? 1), 3);
                    }
                    else
                    {
                        sotien_vnd_usd_TU = (item.Sotien ?? 0);
                    }
                    if (item_DNHU != null)
                    {
                        if (item_DNHU.Loaitiente == "VND")
                        {
                            sotien_vnd_usd_HU = Math.Round((item_DNHU.Sotien ?? 0) / (item_DNHU.tigia ?? 1), 3);
                        }
                        else
                        {
                            sotien_vnd_usd_HU = (item_DNHU.Sotien ?? 0);
                        }
                    }
                }

                total_TU += sotien_vnd_usd_TU ?? 0;
                total_HU += sotien_vnd_usd_HU ?? 0;
               
                var rpt = new M_RPT_TN_HU
                    {
                        TamungNo = item.So,
                        HoanungNo = item_DNHU?.So ?? "",
                        NgayTamUng = item.NGAY,
                        NgayHoanUng = item_DNHU?.Ngay,
                        Tennguoitamung = item.Tennguoidenghi,
                        Tennguoihoanung = item_DNHU?.Tennguoidenghi ?? "",
                        bophan = item.Bophan,
                        Loaitiente = item.Loaitiente,
                        sotien_TU = sotien_vnd_usd_TU ?? 0,
                        sotien_HU = sotien_vnd_usd_HU ?? 0,
                        sotien_Conlai = (sotien_vnd_usd_HU ?? 0) - sotien_vnd_usd_TU,
                        Bkno = item.Bkno,
                        HBL = item.Hbl,
                        trangthai = item.Trangthai

                    };
                Listdata.Add(rpt);
            }
            total_conlai = (total_HU ?? 0) - (total_TU ?? 0);
            var monthRange = new List<(int Year, int Month)>();

            int currentYear = fromNam;
            int currentMonth = fromThang;

            while (currentYear < toNam || (currentYear == toNam && currentMonth <= toThang))
            {
                monthRange.Add((currentYear, currentMonth));

                // Tăng tháng
                currentMonth++;
                if (currentMonth > 12)
                {
                    currentMonth = 1;
                    currentYear++;
                }
            }
          
            // Tính phần trăm hoàn ứng theo từng tháng
            var percentByMonth = new List<double>();
            var labels = new List<string>();
       
            foreach (var (year, month) in monthRange)
            {
                var SL_hoanung = 0;
                // Danh sách DNTU trong tháng
                var tamUngInMonth = Listdata_DNTU
                    .Where(x => x.NGAY.HasValue && x.NGAY.Value.Month == month && x.NGAY.Value.Year == year)
                    .ToList();

                // SL tạm ứng trong tháng
                int totalTU = tamUngInMonth.Count;

                foreach (var item in tamUngInMonth)
                {
                    var item_DNHU = await DNTUsv.Get_DNHU_byID_DNTU(item.Id);
                    if(item_DNHU != null)
                    {
                        SL_hoanung += 1;
                    }
                }

                double percent = totalTU == 0 ? 0 : (double)SL_hoanung / totalTU * 100;

                percentByMonth.Add(percent);
                labels.Add($"{month:D2}/{year}");
            }

            // Thêm cột ảo đầu và cuối (0%)
            percentByMonth.Insert(0, 0);
            percentByMonth.Add(0);
            labels.Insert(0, "");
            labels.Add("");

            // Gán dữ liệu biểu đồ
            Series = new List<ChartSeries>
            {
                new ChartSeries
                {
                    Name = "Tỷ Lệ Hoàn Ứng / Tạm Ứng (%)",
                    Data = percentByMonth.ToArray()
                }
            };

            XAxisLabels = labels.ToArray();
            _loading = false;

        }
        else
        {
            _loading = false;
            CallSnackBar(Localizer["SelectDateTimeRange"], MudBlazor.Severity.Warning);
            return;
        }
    }

    void CallSnackBar(string message, MudBlazor.Severity severity)
    {

        Snackbar.Configuration.SnackbarVariant = Variant.Filled;
        Snackbar.Configuration.MaxDisplayedSnackbars = 3;
        Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopRight;
        Snackbar.Add(message, severity);
    }

    string CustomerName(Guid? customerID)
    {
        var rs = List_Cus.FirstOrDefault(x => x.Customer_ID == customerID);
        return rs != null ? rs.COMPANY! : "";
    }

    private Func<M_RPT_TN_HU, string> _cellStyleFunc => x =>
     {
         string style = "";

         if (string.IsNullOrEmpty(x.trangthai))
             return "color: #000000";

         var rs = M_Trangthais
     .Where(t => (t.Noidung).Contains(x.trangthai, StringComparison.InvariantCultureIgnoreCase)
         && t.Tieude.Equals("DNTU", StringComparison.InvariantCultureIgnoreCase))
     .Select(t => t.Mamau)
     .FirstOrDefault();
         return "color: " + rs;

     };
}


