<a href="HDSDhtml/Huong_dan_Customer_Email_Tab.html" target="_blank">
    <MudButton Color="Color.Info" Size=Size.Small StartIcon="@Icons.Material.Filled.Info">Trợ giúp</MudButton>
</a>
<MudStack Row Spacing="2" Class="py-2">
    <MudCard>
        <MudCardHeader>
            <MudText>Hồ Chí Minh</MudText>
        </MudCardHeader>
        <MudCardContent Class="pa-2">
            <MudStack Spacing="1">
                <MudTextField Class="pa-2 labelCustomColor" @bind-Value="customer.TaxInvoice_SGN"
                              For="@(() => customer.TaxInvoice_SGN)"
                              AdornmentColor="@ColorTextFields"
                              Immediate="true" AutoGrow
                              Label="Tax Invoice" />
                <MudTextField Class="pa-2 labelCustomColor" @bind-Value="customer.AirImport_SGN"
                              For="@(() => customer.AirImport_SGN)"
                              AdornmentColor="@ColorTextFields"
                              Immediate="true" AutoGrow
                              Label="Air Import" />
                <MudTextField Class="pa-2 labelCustomColor" @bind-Value="customer.SeaImport_SGN"
                              For="@(() => customer.SeaImport_SGN)"
                              AdornmentColor="@ColorTextFields"
                              Immediate="true" AutoGrow
                              Label="Sea Import" />
            </MudStack>
        </MudCardContent>
    </MudCard>
    <MudCard>
        <MudCardHeader>
            <MudText>Hà Nội</MudText>
        </MudCardHeader>
        <MudCardContent Class="pa-2">
            <MudStack Spacing="1">
                <MudTextField Class="pa-2 labelCustomColor" @bind-Value="customer.TaxInvoice_HAN"
                              For="@(() => customer.TaxInvoice_HAN)"
                              AdornmentColor="@ColorTextFields"
                              Immediate="true" AutoGrow
                              Label="Tax Invoice" />
                <MudTextField Class="pa-2 labelCustomColor" @bind-Value="customer.AirImport_HAN"
                              For="@(() => customer.AirImport_HAN)"
                              AdornmentColor="@ColorTextFields"
                              Immediate="true" AutoGrow
                              Label="Air Import" />
                <MudTextField Class="pa-2 labelCustomColor" @bind-Value="customer.SeaImport_HAN"
                              For="@(() => customer.SeaImport_HAN)"
                              AdornmentColor="@ColorTextFields"
                              Immediate="true" AutoGrow
                              Label="Sea Import" />
            </MudStack>
        </MudCardContent>
    </MudCard>
    <MudCard>
        <MudCardHeader>
            <MudText>Hải Phòng</MudText>
        </MudCardHeader>
        <MudCardContent Class="pa-2">
            <MudStack Spacing="1">
                <MudTextField Class="pa-2 labelCustomColor" @bind-Value="customer.TaxInvoice_HPH"
                              For="@(() => customer.TaxInvoice_HPH)"
                              AdornmentColor="@ColorTextFields"
                              Immediate="true" AutoGrow
                              Label="Tax Invoice" />
                <MudTextField Class="pa-2 labelCustomColor" @bind-Value="customer.AirImport_HPH"
                              For="@(() => customer.AirImport_HPH)"
                              AdornmentColor="@ColorTextFields"
                              Immediate="true" AutoGrow
                              Label="Air Import" />
                <MudTextField Class="pa-2 labelCustomColor" @bind-Value="customer.SeaImport_HPH"
                              For="@(() => customer.SeaImport_HPH)"
                              AdornmentColor="@ColorTextFields"
                              Immediate="true" AutoGrow
                              Label="Sea Import" />
            </MudStack>
        </MudCardContent>
    </MudCard>
</MudStack>
@code {
    Color ColorTextFields = Color.Primary;
    [Parameter] public M_Customer customer { get; set; } = default!;
}
