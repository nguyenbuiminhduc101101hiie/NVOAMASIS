
<MudStack Row="true" Justify="Justify.FlexStart" Class="py-2" Spacing="2">
    <MudButton HtmlTag="label"
               OnClick="RefreshContract"
               Size="Size.Small" Color="Color.Primary" Variant="   Variant.Filled"
               StartIcon="@Icons.Material.Filled.Refresh">
        @Localizer["Reload"]
    </MudButton>
    <MudButton HtmlTag="label"
               @onclick="@(() => AddItemContract())"
               Size="Size.Small" Color="Color.Secondary" Variant="Variant.Filled"
               StartIcon="@Icons.Material.Filled.Add">
        @Localizer["New"]
    </MudButton>
    <MudFileUpload T="IBrowserFile" Accept=".pdf,.docx" FilesChanged="AttachFileToFTP">
        <ButtonTemplate>
                <MudFab HtmlTag="label"
                            for="@context.Id"
                           Size="Size.Small" Color="Color.Secondary"
                           StartIcon="@Icons.Material.Filled.AttachFile"/>
        </ButtonTemplate>
    </MudFileUpload>
    <a href="HDSDhtml/Huong_dan_Customer_Contract_Info.html" target="_blank">
        <MudButton Color="Color.Info" Size=Size.Small StartIcon="@Icons.Material.Filled.Info">@Localizer["Help"]</MudButton>
    </a>
</MudStack>
<MudDataGrid T="CustomerCommondity" Items="@Contracts.ToList()" Filterable="true" @ref="mudTable"
             RowClick="@RowClicked" RowClassFunc="@SelectedRowClassFunc"
             FilterMode="@DataGridFilterMode.ColumnFilterRow" Dense="true" Virtualize="true"
             EditTrigger="@(DataGridEditTrigger.Manual)" CommittedItemChanges="@CommittedItemContract"
             FixedHeader="true" FixedFooter="true" HeaderClass="no-wrap" FooterClass="no-wrap" 
             ReadOnly="false" Loading="contract_loading" 
             ColumnResizeMode="ResizeMode.Column">
    <Columns>
        <TemplateColumn CellClass="d-flex justify-end">
            <CellTemplate>
                <MudIconButton Size="@Size.Small" Icon="@Icons.Material.Outlined.Edit" OnClick="@context.Actions.StartEditingItemAsync" />
                <MudIconButton Size="@Size.Small" Icon="@Icons.Material.Outlined.Delete" OnClick="@(()=>DeleteItemContract(context.Item))" />
            </CellTemplate>
        </TemplateColumn>
        <PropertyColumn Property="x => x.SoHD" Title="Số Contract">
            <EditTemplate>
                <MudTextField Immediate="true" @bind-Value="context.Item.SoHD" Label="Số Contract" />
            </EditTemplate>
        </PropertyColumn>
        <TemplateColumn Title="Hợp đồng nguyên tắc">
            <CellTemplate>
                <MudCheckBox @bind-Checked=context.Item.HD_NguyenTac ReadOnly="true"></MudCheckBox>
            </CellTemplate>
            <EditTemplate>
                <MudCheckBox @bind-Checked="context.Item.HD_NguyenTac" Label="Hợp đồng nguyên tắc" />
            </EditTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Hợp đồng đại lý hải quan">
            <CellTemplate>
                <MudCheckBox @bind-Checked=context.Item.HD_DaiLyHaiQuan ReadOnly="true"></MudCheckBox>
            </CellTemplate>
            <EditTemplate>
                <MudCheckBox @bind-Checked="context.Item.HD_DaiLyHaiQuan" Label="Hợp đồng đại lý hải quan" />
            </EditTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Hợp đồng ủy thác xuất khẩu">
            <CellTemplate>
                <MudCheckBox @bind-Checked=context.Item.HD_UyThacXuatKhau ReadOnly="true"></MudCheckBox>
            </CellTemplate>
            <EditTemplate>
                <MudCheckBox @bind-Checked="context.Item.HD_UyThacXuatKhau" Label="Hợp đồng ủy thác xuất khẩu" />
            </EditTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Other">
            <CellTemplate>
                <MudCheckBox @bind-Checked=context.Item.Other ReadOnly="true"></MudCheckBox>
            </CellTemplate>
            <EditTemplate>
                <MudCheckBox @bind-Checked="context.Item.Other" Label="Other" />
            </EditTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Kích hoạt">
            <CellTemplate>
                <MudCheckBox @bind-Checked=context.Item.active ReadOnly="true"></MudCheckBox>
            </CellTemplate>
            <EditTemplate>
                <MudCheckBox @bind-Checked="context.Item.active" Label="Kích hoạt" />
            </EditTemplate>
        </TemplateColumn>
        <PropertyColumn Property="x => x.NgayKy" Title="Ngày ký">
            <EditTemplate>
<MudStack Row="true" Justify="Justify.FlexStart" Class="pa-2" Spacing="1">
                                                    <MudDatePicker Label="Ngày ký" TextChanged="@((t)=> context.Item.NgayKy = (t == "" ? null : DateTime.Parse(t).ToString("dd-MMM-yyyy")))" />
                                                    <MudTextField Immediate="true" @bind-Value="context.Item.NgayKy" Disabled />
                                                </MudStack>
            </EditTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x => x.NgayHetHan" Title="Ngày hết hạn">
            <EditTemplate>
<MudStack Row="true" Justify="Justify.FlexStart" Class="pa-2" Spacing="1">
                                                    <MudDatePicker Label="Ngày hết hạn" TextChanged="@((t)=> context.Item.NgayHetHan = (t == "" ? null : DateTime.Parse(t).ToString("dd-MMM-yyyy")))" />
                                                    <MudTextField Immediate="true" @bind-Value="context.Item.NgayHetHan" Disabled />
                                                </MudStack>
            </EditTemplate>
        </PropertyColumn>
    </Columns>
</MudDataGrid>
<MudDataGrid Items="@Links" T="CustomerCommondityFileUpload" Style="height: 200px; overflow: auto;" Class="pa-2">
    <Columns>
        <PropertyColumn Property="x => x.Link" Title="Link">
            <CellTemplate>
                <MudLink Href="@context.Item.Link.Replace("ftp","http")" Target="_blank">
                    @context.Item.FileName
                </MudLink>
                <MudIconButton Icon="@Icons.Material.Filled.Delete" aria-label="delete" OnClick="@(()=>DeleteLink(context.Item))" />
            </CellTemplate>
        </PropertyColumn>
    </Columns>
</MudDataGrid>

@inject CustomerService csv
@inject SharedServices ssv
@inject AccountService asv
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IStringLocalizer<SharedResource> Localizer

@code {

    [Parameter] public M_Customer customer { get; set; } = default!;
    void CallSnackBar(string message, MudBlazor.Severity severity)
    {
        
        Snackbar.Configuration.SnackbarVariant = Variant.Filled;
        Snackbar.Configuration.MaxDisplayedSnackbars = 3;
        Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopRight;
        Snackbar.Add(message, severity);
    }
    string usr;
    protected async override Task OnInitializedAsync()
    {
        Contracts = await csv.GetListCustomerCommondity(customer.Customer_ID);
        usr = asv.GetAuth().Result.User.Identity!.Name!;
    }

    bool contract_loading = false;
    List<CustomerCommondity> Contracts = new List<CustomerCommondity>();
    List<CustomerCommondityFileUpload> Links = new List<CustomerCommondityFileUpload>();
    async Task RefreshContract()
    {
        try
        {
            contract_loading = true;
            // Simulate asynchronous loading to demonstrate a loading indicator
            Contracts.Clear();
            Detail = null!;
            Links.Clear();
            StateHasChanged();
            await Task.Delay(500);
            if (!await ssv.CheckPermission(asv.GetAuth().Result.User.Identity!.Name!, "View", "System-Customer"))
            {
                CallSnackBar("You have not access to view", MudBlazor.Severity.Warning);
                return;
            }
            Contracts = await csv.GetListCustomerCommondity(customer.Customer_ID);
        }
        finally
        {
            contract_loading = false;
        }

    }

    MudDataGrid<CustomerCommondity> mudTable;
    async Task AddItemContract()
    {
        var item = new CustomerCommondity();
        Contracts.Add(item);
        await mudTable.SetEditingItemAsync(Contracts.LastOrDefault()!);
    }

    async Task DeleteItemContract(CustomerCommondity item)
    {
        if (item == null)
        {
            CallSnackBar("you must select 1 row.", MudBlazor.Severity.Warning);
            return;
        }
        var resultMess = await DialogService.ShowMessageBox(
                "Warning",
                "Deleting can not be undone!",
                yesText: "Delete!", cancelText: "Cancel");

        if (resultMess.HasValue)
        {
            var rs = await csv.DeleteCustomerCommondity(item);
            CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
            await RefreshContract();
        }

    }
    async Task CommittedItemContract(CustomerCommondity item)
    {
        item.Customer_ID = customer.Customer_ID;
        item.UserID = asv.GetAuth().Result.User.Identity!.Name!;
        item.UpdateTime = DateTime.Now;
        item.Continued = item.Editable = true;
        item.Commondity_ID = null;// k dung
        var rs = item.CustomerCommondity_ID != null ? await csv.UpdateCustomerCommondity(item) : await csv.CreateCustomerCommondity(item);
        CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
        await RefreshContract();
    }
    CustomerCommondity Detail;
    void RowClicked(DataGridRowClickEventArgs<CustomerCommondity> args)
    {
        Detail = args.Item;
        Links = csv.GetListCustomerCommondityFileUpload(Detail.CustomerCommondity_ID);
    }

    async Task AttachFileToFTP(IBrowserFile file)
    {
        try
        {
            if (Detail == null)
            {
                CallSnackBar("you must select 1 row!", MudBlazor.Severity.Warning);

            }
            var result = await csv.UploadfiletoFTP(file, Detail!.CustomerCommondity_ID, usr);
            CallSnackBar(result.Message, result.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
            Links = csv.GetListCustomerCommondityFileUpload(Detail.CustomerCommondity_ID);
        }
        catch (Exception ex)
        {
            CallSnackBar("Throw exception code: " + ex.Message, MudBlazor.Severity.Error);
        }
    }
    private async Task DeleteLink(CustomerCommondityFileUpload item)
    {
        try
        {

            if (!await ssv.CheckPermission(usr, "Delete", "System-Customer"))
            {
                CallSnackBar("You have not access to Delete", MudBlazor.Severity.Warning);
                return;
            }

            var resultMess = await DialogService.ShowMessageBox(
                "Warning",
                "Deleting can not be undone!",
                yesText: "Delete!", cancelText: "Cancel");

            if (resultMess.HasValue)
            {

                var result = await csv.DeleteLink(item);

                if (result.Flag)
                    CallSnackBar(result.Message, MudBlazor.Severity.Success);
                else
                {
                    CallSnackBar(result.Message, MudBlazor.Severity.Error);
                    return;
                }
                Links = csv.GetListCustomerCommondityFileUpload(Detail.CustomerCommondity_ID);
            }
        }
        catch (Exception ex)
        {
            CallSnackBar("Cannot delete with eror code: " + ex.Message, MudBlazor.Severity.Error);

        }
    }
    private int selectedRowNumber = -1;
    private string SelectedRowClassFunc(CustomerCommondity item, int rowNumber)
    {
        if (selectedRowNumber == rowNumber)
        {
            selectedRowNumber = -1;
            return string.Empty;
        }
        else if (mudTable.SelectedItem != null && mudTable.SelectedItem.Equals(item))
        {
            selectedRowNumber = rowNumber;
            return "selected";
        }
        else
        {
            return string.Empty;
        }
    }
}
