@inject CustomerService csv
@inject ISnackbar Snackbar

@code {
    MudForm form;
    Color ColorTextFields = Color.Primary;
    private void Submit()
    {
        MudDialog!.Close(customer);
    }
    List<string> MainCodes = new List<string> { "Air Lines", "Agent-Network", "Customer", "Vendor", "Shipping", "Trucking", "Romooc", "Personal", "Others", "Moving-Partner", "Master Coloader", "Logistics Partner" };
    List<string> saleNames = new List<string>();
    List<string> countries = new List<string>();
    List<string>? Sales = new List<string>();


    private string selectedItem;
    private string textmanincode = "";
    void Cancel() => MudDialog!.Cancel();
    void CallSnackBar(string message, MudBlazor.Severity severity)
    {
        
        Snackbar.Configuration.SnackbarVariant = Variant.Filled;
        Snackbar.Configuration.MaxDisplayedSnackbars = 3;
        Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopRight;
        Snackbar.Add(message, severity);
    }
    protected async override Task OnInitializedAsync()
    {
        var cuscode = await csv.GetCustomerCode();
        if (!cuscode.Item1.Flag)
            CallSnackBar(cuscode.Item1.Message, MudBlazor.Severity.Error);
        else
            customer.Customer_Code = cuscode.Item2.CustomerCode_Ref;
        // Customers = await csv.GetList();
        // Countrys = Customers.Where(x => x.Country != "").Select(x => x.Country).ToList();
        // if (!EditOrNot) // duplicate lấy customer code mới
        // {
        //     customer.Customer_ID = Guid.NewGuid();
        //     var cuscode = await csv.GetCustomerCode();
        //     if (!cuscode.Item1.Flag)
        //         CallSnackBar(cuscode.Item1.Message, MudBlazor.Severity.Error);
        //     else
        //         customer.Customer_Code = cuscode.Item2.CustomerCode_Ref;
        // }
        countries = await csv.queryCountry();
        saleNames = await csv.querySaleName();
        var rs = await csv.GetListSale();
        Sales = rs.Select(x => x.SaleCode).ToList()!;
    }
    [CascadingParameter] MudDialogInstance? MudDialog { get; set; }
    M_Customer customer = new M_Customer();
    async Task addMainCode()
    {
        try
        {
            textmanincode = customer.MainCode;
            if (selectedItem == null)
            {
                selectedItem = "";
            }
            if (textmanincode == null)
            {
                textmanincode = selectedItem;
                customer.MainCode = textmanincode;
            }
            else
            {
                if (!textmanincode.Contains(selectedItem))
                {
                    textmanincode += "," + selectedItem;
                    customer.MainCode = textmanincode;
                }
            }
        }
        catch (Exception)
        {

            throw;
        }

    }
}
