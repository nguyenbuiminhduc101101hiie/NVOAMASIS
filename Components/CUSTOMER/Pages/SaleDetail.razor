
<MudStack Row="true" Justify="Justify.FlexStart" Class="py-2" Spacing="2">
    <MudButton HtmlTag="label"
               OnClick="Refresh"
               Size="Size.Small" Color="Color.Primary" Variant="   Variant.Filled"
               StartIcon="@Icons.Material.Filled.Refresh">
        Reload
    </MudButton>
    <MudButton HtmlTag="label"
               @onclick="@(() => AddItem())"
               Size="Size.Small" Color="Color.Secondary" Variant="Variant.Filled"
               StartIcon="@Icons.Material.Filled.Add">
        New
    </MudButton>
    <a href="HDSDhtml/Huong_dan_Customer_Sale_Detail.html" target="_blank">
        <MudButton Color="Color.Info" Size=Size.Small StartIcon="@Icons.Material.Filled.Info">Trợ giúp</MudButton>
    </a>
</MudStack>
<MudDataGrid T="M_Booking" Items="@Listdata" Filterable="true" @ref="mudTable"
             FilterMode="@DataGridFilterMode.ColumnFilterRow" Dense="true" Virtualize="true"
             FixedHeader="true" FixedFooter="true" HeaderClass="no-wrap" FooterClass="no-wrap"
             ReadOnly="false" CommittedItemChanges="@CommittedItem"
             ColumnResizeMode="ResizeMode.Column" Loading="_loading">
    <Columns>
        <TemplateColumn CellClass="d-flex justify-end">
            <CellTemplate>
                <MudIconButton Size="@Size.Small" Icon="@Icons.Material.Outlined.Edit" OnClick="@context.Actions.StartEditingItemAsync" />
                <MudIconButton Size="@Size.Small" Icon="@Icons.Material.Outlined.Delete" OnClick="@(()=>DeleteItem(context.Item))" />
            </CellTemplate>
        </TemplateColumn>
        <PropertyColumn Property="x => POLName(x.POL_ID)" Title="POL" Required="false">
            <EditTemplate>
                <MudSelect T="Guid?" @bind-Value="context.Item.POL_ID" Label="POL">
                    @foreach (var item in Ports)
                    {
                        <MudSelectItem T="Guid?" Value="@((Guid?)item.PORT_ID)">@item.PORT</MudSelectItem>
                    }
                </MudSelect>
            </EditTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x => PODName(x.POD_ID)" Title="POD" Required="false">
            <EditTemplate>
                <MudSelect T="Guid?" @bind-Value="context.Item.POD_ID" Label="POD">
                    @foreach (var item in Ports)
                    {
                        <MudSelectItem T="Guid?" Value="@((Guid?)item.PORT_ID)">@item.PORT</MudSelectItem>
                    }
                </MudSelect>
            </EditTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x => AgencyName(x.Agency_ID)" Title="Agency" Required="false">
            <EditTemplate>
                <MudSelect T="Guid?" @bind-Value="context.Item.Agency_ID" Label="Agency">
                    @foreach (var item in Agencys)
                    {
                        <MudSelectItem T="Guid?" Value="@item.Agency_ID">@item.AgencyName</MudSelectItem>
                    }
                </MudSelect>
            </EditTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x => x.SL20GPOwner" Title="20 GP Std" Required="false" />
        <PropertyColumn Property="x => x.SL40GPOwner" Title="40 GP Std" Required="false"/>
        <PropertyColumn Property="x => x.SL45HCOwner" Title="45 HC Std" Required="false"/>
        <PropertyColumn Property="x => x.SL20RFOwner" Title="20 RF Std" Required="false"/>
        <PropertyColumn Property="x => x.SL40RFOwner" Title="40 RF Std" Required="false" />
        <PropertyColumn Property="x => x.SL40RHOwner" Title="40 RH Std" Required="false" />
        <PropertyColumn Property="x => x.SL20OTOwner" Title="20 OT Std" Required="false"/>
        <PropertyColumn Property="x => x.SL40OTOwner" Title="40 OT Std" Required="false"/>
        <PropertyColumn Property="x => x.Sl20FROwner" Title="20 FR Std" Required="false"/>
        <PropertyColumn Property="x => x.SL40FROwner" Title="40 FR Std" Required="false"/>
        <PropertyColumn Property="x => x.SLCBMOwner" Title="CBM Std" Required="false"/>
        <PropertyColumn Property="x => x.SL20GPSale" Title="20 GP Sale" Required="false" />
        <PropertyColumn Property="x => x.SL40GPSale" Title="40 GP Sale" Required="false"/>
        <PropertyColumn Property="x => x.SL40HCSale" Title="40 HC Sale" Required="false" />
        <PropertyColumn Property="x => x.SL45HCSale" Title="45 HC Sale" Required="false"/>
        <PropertyColumn Property="x => x.SL20RFSale" Title="20 RF Sale" Required="false"/>
        <PropertyColumn Property="x => x.SL40RFSale" Title="40 RF Sale" Required="false"/>
        <PropertyColumn Property="x => x.SL20OTSale" Title="20 OT Sale" Required="false"/>
        <PropertyColumn Property="x => x.SL40OTSale" Title="40 OT Sale" Required="false"/>
        <PropertyColumn Property="x => x.SL20FRSale" Title="20 FR Sale" Required="false"/>
        <PropertyColumn Property="x => x.SL40FRSale" Title="40 FR Sale" Required="false"/>
        <PropertyColumn Property="x => x.SLCBMSale" Title="CBM Sale" Required="false"/>
        <PropertyColumn Property="x => x.Validate" Title="Validate">
            <EditTemplate>
                <MudDatePicker @bind-Date="context.Item.Validate" Label="Validate"/>
            </EditTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x => x.SCNO" Title="SCNO" />
        <PropertyColumn Property="x => x.Remarks" Title="Remarks" />
        <PropertyColumn Property="x => x.Commission" Title="Commission">
            <EditTemplate>
                <MudStack Row="true">
                    <MudTextField @bind-Value="context.Item.Commission" Label="Commission" />
                    <MudSelect @bind-Value="context.Item.Currency" Label="Currency">
                        <MudSelectItem Value="@("USD")">USD</MudSelectItem>
                        <MudSelectItem Value="@("VND")">VND</MudSelectItem>
                        <MudSelectItem Value="@("EUR")">EUR</MudSelectItem>
                    </MudSelect>            
                </MudStack>
            </EditTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x => x.sell" Title="Sell" />
        <PropertyColumn Property="x => x.buy" Title="Buy" />
        <PropertyColumn Property="x => x.Status" Title="Booking" />
        <PropertyColumn Property="x => x.approve" Title="Approve" />
    </Columns>
</MudDataGrid>
@inject CustomerService csv
@inject SupportServices supsv
@inject SharedServices ssv
@inject AccountService asv
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@code {

    [Parameter] public M_Customer customer { get; set; } = default!;
    void CallSnackBar(string message, MudBlazor.Severity severity)
    {
        
        Snackbar.Configuration.SnackbarVariant = Variant.Filled;
        Snackbar.Configuration.MaxDisplayedSnackbars = 3;
        Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopRight;
        Snackbar.Add(message, severity);
    }

    List<M_Agency> Agencys = new List<M_Agency>();
    List<PortModel> Ports = new List<PortModel>();
    protected async override Task OnInitializedAsync()
    {
        Listdata = await csv.GetListSaleDetail(customer.Customer_ID);
        Agencys = await supsv.GetListAgency();
        Ports = await supsv.GetListPort();
        // var pod = Ports.Join(Listdata,
        //         po => po.PORT_ID,
        //         data => data.POD_ID,
        //         (po, data) => po)
        //         .ToList();
        // var pol = Ports.Join(Listdata,
        //         po => po.PORT_ID,
        //         data => data.POL_ID,
        //         (po, data) => po)
        //         .ToList();
        // Ports.Clear(); Ports.AddRange(pod); Ports.AddRange(pol);
        await Refresh();
    }

    bool _loading = false;
    List<M_Booking> Listdata = new List<M_Booking>();
    async Task Refresh()
    {
        try
        {
            _loading = true;
            // Simulate asynchronous loading to demonstrate a loading indicator
            Listdata.Clear();
            StateHasChanged();
            await Task.Delay(500);
            if (!await ssv.CheckPermission(asv.GetAuth().Result.User.Identity!.Name!, "View", "System-Customer"))
            {
                CallSnackBar("You have not access to view", MudBlazor.Severity.Warning);
                return;
            }
            Listdata = await csv.GetListSaleDetail(customer.Customer_ID);
        }
        finally
        {
            _loading = false;
        }

    }
    string PODName(Guid? PODID)
    {
        var rs = Ports.FirstOrDefault(x => x.PORT_ID == PODID);
        return rs != null ? rs.PORT! : "";
    }
    string POLName(Guid? POLID)
    {
        var rs = Ports.FirstOrDefault(x => x.PORT_ID == POLID);
        return rs != null ? rs.PORT! : "";
    }
    string AgencyName(Guid? AgencyID)
    {
        var rs = Agencys.FirstOrDefault(x => x.Agency_ID == AgencyID);
        return rs != null ? rs.AgencyName! : "";
    }

    MudDataGrid<M_Booking> mudTable;
    async Task AddItem()
    {
        var item = new M_Booking();
        Listdata.Add(item);
        await mudTable.SetEditingItemAsync(Listdata.LastOrDefault()!);
    }

    async Task DeleteItem(M_Booking item)
    {
        if (item == null)
        {
            CallSnackBar("you must select 1 row.", MudBlazor.Severity.Warning);
            return;
        }
        var resultMess = await DialogService.ShowMessageBox(
                "Warning",
                "Deleting can not be undone!",
                yesText: "Delete!", cancelText: "Cancel");

        if (resultMess.HasValue)
        {
            var rs = await csv.DeleteSaleDetail(item);
            CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
            await Refresh();
        }

    }
    async Task CommittedItem(M_Booking item)
    {
        item.Customer_ID = customer.Customer_ID;
        item.userid = asv.GetAuth().Result.User.Identity!.Name!;
        item.updatetime = DateTime.Now;
        item.continued = item.editable = true;
        var rs = item.Booking_ID != Guid.Empty ? await csv.UpdateSaleDetail(item) : await csv.CreateSaleDetail(item);
        CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
        await Refresh();
    }

}
