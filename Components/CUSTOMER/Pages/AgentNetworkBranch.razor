
<MudStack Row="true" Justify="Justify.FlexStart" Class="py-2" Spacing="2">
    <MudButton HtmlTag="label"
               OnClick="Refresh"
               Size="Size.Small" Color="Color.Primary" Variant="   Variant.Filled"
               StartIcon="@Icons.Material.Filled.Refresh">
        Reload
    </MudButton>
    <MudButton HtmlTag="label"
               @onclick="@(() => AddItem())"
               Size="Size.Small" Color="Color.Secondary" Variant="Variant.Filled"
               StartIcon="@Icons.Material.Filled.Add">
        New
    </MudButton>
    <a href="HDSDhtml/Huong_dan_Customer_Agent_Network_Branch.html" target="_blank">
        <MudButton Color="Color.Info" Size=Size.Small StartIcon="@Icons.Material.Filled.Info">Trợ giúp</MudButton>
    </a>
</MudStack>
<MudDataGrid T="M_CustomerBr" Items="@Listdata" Filterable="true" @ref="mudTable"
             FilterMode="@DataGridFilterMode.ColumnFilterRow" Dense="true" Virtualize="true"
             FixedHeader="true" FixedFooter="true" HeaderClass="no-wrap" FooterClass="no-wrap"
             ReadOnly="false" CommittedItemChanges="@CommittedItem"
             ColumnResizeMode="ResizeMode.Column" Loading="_loading">
    <Columns>
        <TemplateColumn CellClass="d-flex justify-end">
            <CellTemplate>
                <MudIconButton Size="@Size.Small" Icon="@Icons.Material.Outlined.Edit" OnClick="@context.Actions.StartEditingItemAsync" />
                <MudIconButton Size="@Size.Small" Icon="@Icons.Material.Outlined.Delete" OnClick="@(()=>DeleteItem(context.Item))" />
            </CellTemplate>
        </TemplateColumn>
        <PropertyColumn Property="x => x.citybr" Title="City" >
            <EditTemplate>
                <MudComboBox Margin="Margin.None" Dense="Dense.Standard" Color="Color.Primary" @bind-Value="context.Item.citybr" Editable="true" Label="City">
                    @foreach (var item in citys)
                    {
                        <MudComboBoxItem Value="@item.citybr">@item.citybr</MudComboBoxItem>
                    }
                </MudComboBox>
            </EditTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x => x.namecitybr" Title="Name of City" Required="false" />
        <PropertyColumn Property="x => x.typebr" Title="Type">
            <EditTemplate>
                <MudComboBox Margin="Margin.None" Dense="Dense.Standard" Color="Color.Primary" @bind-Value="context.Item.typebr" Editable="true" Label="Type">
                    <MudComboBoxItem Value="@("BR")">BR</MudComboBoxItem>
                    <MudComboBoxItem Value="@("BR1")">BR1</MudComboBoxItem>
                    <MudComboBoxItem Value="@("BR2")">BR2</MudComboBoxItem>
                </MudComboBox>
            </EditTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x => x.telbr" Title="Tel" Required="false" />
        <PropertyColumn Property="x => x.faxbr" Title="Fax" Required="false" />
        <PropertyColumn Property="x => x.addressbr" Title="Address" Required="false">
            <EditTemplate>
                <MudTextField @bind-Value="context.Item.addressbr" Label="Address" AutoGrow Lines="2"/>
            </EditTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x => x.userupdate" Title="User Update" Required="false" IsEditable="false" />
        <PropertyColumn Property="x => x.dateupdate" Title="Date Update" Required="false" IsEditable="false" />
    </Columns>
</MudDataGrid>
@inject CustomerService csv
@inject SharedServices ssv
@inject AccountService asv
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@code {

    [Parameter] public M_Customer customer { get; set; } = default!;
    void CallSnackBar(string message, MudBlazor.Severity severity)
    {
        
        Snackbar.Configuration.SnackbarVariant = Variant.Filled;
        Snackbar.Configuration.MaxDisplayedSnackbars = 3;
        Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopRight;
        Snackbar.Add(message, severity);
    }
    protected async override Task OnInitializedAsync()
    {
        Listdata = await csv.GetListAgentNetworkBranch(customer.Customer_ID);
        citys = await csv.GetListCustomerBr();
    }
    List<M_CustomerBr> citys = new List<M_CustomerBr>();
    bool _loading = false;
    List<M_CustomerBr> Listdata = new List<M_CustomerBr>();
    async Task Refresh()
    {
        try
        {
            _loading = true;
            // Simulate asynchronous loading to demonstrate a loading indicator
            Listdata.Clear();
            StateHasChanged();
            await Task.Delay(500);
            if (!await ssv.CheckPermission(asv.GetAuth().Result.User.Identity!.Name!, "View", "System-Customer"))
            {
                CallSnackBar("You have not access to view", MudBlazor.Severity.Warning);
                return;
            }
            Listdata = await csv.GetListAgentNetworkBranch(customer.Customer_ID);
        }
        finally
        {
            _loading = false;
        }

    }

    MudDataGrid<M_CustomerBr> mudTable;
    async Task AddItem()
    {
        var item = new M_CustomerBr();
        Listdata.Add(item);
        await mudTable.SetEditingItemAsync(Listdata.LastOrDefault()!);
    }

    async Task DeleteItem(M_CustomerBr item)
    {
        if (item == null)
        {
            CallSnackBar("you must select 1 row.", MudBlazor.Severity.Warning);
            return;
        }
        var resultMess = await DialogService.ShowMessageBox(
                "Warning",
                "Deleting can not be undone!",
                yesText: "Delete!", cancelText: "Cancel");

        if (resultMess.HasValue)
        {
            var rs = await csv.DeleteAgentNetworkBranch(item);
            CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
            await Refresh();
        }

    }
    async Task CommittedItem(M_CustomerBr item)
    {
        item.customerid = customer.Customer_ID;
        item.userupdate = asv.GetAuth().Result.User.Identity!.Name!;
        item.dateupdate = DateTime.Now.ToString();
        item.continued = item.editable = true;
        var rs = item.customerBrID != Guid.Empty ? await csv.UpdateAgentNetworkBranch(item) : await csv.CreateAgentNetworkBranch(item);
        CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
        await Refresh();
    }
}
