
<MudStack Row="true" Justify="Justify.FlexStart" Class="py-1" Spacing="1">
    <MudButton HtmlTag="label"
               OnClick="Refresh"
               Size="Size.Small" Color="Color.Primary" Variant="   Variant.Filled"
               StartIcon="@Icons.Material.Filled.Refresh">
        Reload
    </MudButton>
    <MudButton HtmlTag="label"
               @onclick="@(() => AddItem())"
               Size="Size.Small" Color="Color.Secondary" Variant="Variant.Filled"
               StartIcon="@Icons.Material.Filled.Add">
        New
    </MudButton>
    <a href="HDSDhtml/Huong_dan_Consignee_Shipper_Form.html" target="_blank">
        <MudButton Color="Color.Info" Size=Size.Small StartIcon="@Icons.Material.Filled.Info">Trợ giúp</MudButton>
    </a>
</MudStack>
<MudDataGrid T="M_Buyer" Items="@Listdata" Filterable="true" @ref="mudTable" Class="pa-1 consignee-shipper-grid"
             FilterMode="@DataGridFilterMode.ColumnFilterRow" Dense="true" Virtualize="true"
             FixedHeader="true" FixedFooter="true" HeaderClass="no-wrap" FooterClass="no-wrap"
             ReadOnly="false" CommittedItemChanges="@CommittedItem"
             ColumnResizeMode="ResizeMode.Column" Loading="_loading">
    <Columns>
        <TemplateColumn CellClass="d-flex justify-end">
            <CellTemplate>
                <MudIconButton Size="@Size.Small" Icon="@Icons.Material.Outlined.Edit" OnClick="@context.Actions.StartEditingItemAsync" />
                <MudIconButton Size="@Size.Small" Icon="@Icons.Material.Outlined.Delete" OnClick="@(()=>DeleteItem(context.Item))" />
            </CellTemplate>
        </TemplateColumn>
        <PropertyColumn Property="x => x.Buyer" Title="Buyer" />
        <PropertyColumn Property="x => x.consigneeshipper" Title="Consignee/Shipper" >
            <CellTemplate>
                <MudCheckBox @bind-Checked="context.Item.consigneeshipper" ReadOnly Dense="true" />
            </CellTemplate>
            <EditTemplate>
                <MudCheckBox @bind-Checked="context.Item.consigneeshipper" Label="Consignee/Shipper" Dense="true" />
            </EditTemplate>    
        </PropertyColumn>
        <PropertyColumn Property="x => x.Address" Title="Address" Required="false" />
        <PropertyColumn Property="x => x.Tel" Title="Telephone" Required="false"/>
        <PropertyColumn Property="x => x.Fax" Title="Fax" Required="false"/>
        <PropertyColumn Property="x => x.email" Title="Email" Required="false"/>
        <PropertyColumn Property="x => x.website" Title="Website" Required="false"/>
        <PropertyColumn Property="x => x.Country" Title="Country" Required="false">
            <EditTemplate>
                <MudSelect @bind-Value="context.Item.Country" Label="Country" Dense="true" Margin="Margin.Dense">
                    @foreach (var item in Comoditys)
                    {
                        <MudSelectItem Value="@item">@item</MudSelectItem>
                    }
                </MudSelect>
            </EditTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x => x.Commodity" Title="Commodity" Required="false">
            <EditTemplate>
                <MudSelect @bind-Value="context.Item.Commodity" Label="Commodity" Dense="true" Margin="Margin.Dense">
                    @foreach (var item in Comoditys)
                    {
                        <MudSelectItem Value="@item">@item</MudSelectItem>
                    }
                </MudSelect>
            </EditTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x => x.PIC1Name" Title="PIC1Name" Required="false" />
        <PropertyColumn Property="x => x.PIC1Pos" Required="false"/>
        <PropertyColumn Property="x => x.PIC1Tel" Required="false"/>
        <PropertyColumn Property="x => x.PIC1Email" Required="false"/>
        <PropertyColumn Property="x => x.approve" Title="Approve" Required="false" />
        <PropertyColumn Property="x => x.userid" Title="User Update" IsEditable="false" Required="false"/>
        <PropertyColumn Property="x => x.updatetime" Title="Update Time" IsEditable="false" Required="false" />
    </Columns>
</MudDataGrid>

<style>
    .consignee-shipper-grid ::deep .mud-table-cell,
    .consignee-shipper-grid ::deep .mud-table-row .mud-table-cell {
        border: none !important;
    }
    .consignee-shipper-grid ::deep .mud-table {
        border: none !important;
    }
</style>

@inject CustomerService csv
@inject SharedServices ssv
@inject AccountService asv
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@code {

    [Parameter] public M_Customer customer { get; set; } = default!;
    void CallSnackBar(string message, MudBlazor.Severity severity)
    {
        
        Snackbar.Configuration.SnackbarVariant = Variant.Filled;
        Snackbar.Configuration.MaxDisplayedSnackbars = 3;
        Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopRight;
        Snackbar.Add(message, severity);
    }
    protected async override Task OnInitializedAsync()
    {
        Listdata = await csv.GetListBuyer(customer.Customer_ID);
    }

    bool _loading = false;
    List<M_Buyer> Listdata = new List<M_Buyer>();
    async Task Refresh()
    {
        try
        {
            _loading = true;
            // Simulate asynchronous loading to demonstrate a loading indicator
            Listdata.Clear();
            StateHasChanged();
            await Task.Delay(500);
            if (!await ssv.CheckPermission(asv.GetAuth().Result.User.Identity!.Name!, "View", "System-Customer"))
            {
                CallSnackBar("You have not access to view", MudBlazor.Severity.Warning);
                return;
            }
            Listdata = await csv.GetListBuyer(customer.Customer_ID);
        }
        finally
        {
            _loading = false;
        }

    }
