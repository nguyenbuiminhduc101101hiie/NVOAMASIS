<a href="HDSDhtml/Huong_dan_Customer_Potential.html" target="_blank">
    <MudButton Color="Color.Info" Size=Size.Small StartIcon="@Icons.Material.Filled.Info">Trợ giúp</MudButton>
</a>
<MudCard>
    <MudCardContent Class="pa-1">
        <MudStack Row Spacing="1">
            <MudCard>
                <MudCardHeader>
                    Rival
                </MudCardHeader>
                <MudCardContent Class="pa-1">
                    <MudCheckBox Class="labelCustomColor" @bind-Checked="customer.rivaldhl" Dense="true"
                                 For="@(() => customer.rivaldhl)"
                                 Label="DHL" />
                    <MudCheckBox Class="labelCustomColor" @bind-Checked="customer.rivaltNT" Dense="true"
                                 For="@(() => customer.rivaltNT)"
                                 Label="TNT" />
                    <MudCheckBox Class="labelCustomColor" @bind-Checked="customer.rivalfedex" Dense="true"
                                 For="@(() => customer.rivalfedex)"
                                 Label="Fedex" />
                    <MudCheckBox Class="labelCustomColor" @bind-Checked="customer.rivalups" Dense="true"
                                 For="@(() => customer.rivalups)"
                                 Label="UPS" />
                    <MudCheckBox Class="labelCustomColor" @bind-Checked="customer.rivalothers" Dense="true"
                                 For="@(() => customer.rivalothers)"
                                 Label="Others" />
                </MudCardContent>
               
            </MudCard>
            <MudCard>
                <MudCardHeader>
                    Field
                </MudCardHeader>
                <MudCardContent Class="pa-1">
                    <MudCheckBox Class="labelCustomColor" @bind-Checked="customer.fieldgarment" Dense="true"
                                 For="@(() => customer.fieldgarment)"
                                 Label="Garment" />
                    <MudCheckBox Class="labelCustomColor" @bind-Checked="customer.fieldtextile" Dense="true"
                                 For="@(() => customer.fieldtextile)"
                                 Label="Texttile" />
                    <MudCheckBox Class="labelCustomColor" @bind-Checked="customer.fieldshoes" Dense="true"
                                 For="@(() => customer.fieldshoes)"
                                 Label="Shoes" />
                    <MudCheckBox Class="labelCustomColor" @bind-Checked="customer.fieldfurniture" Dense="true"
                                 For="@(() => customer.fieldfurniture)"
                                 Label="Furniture" />
                    <MudCheckBox Class="labelCustomColor" @bind-Checked="customer.fieldforwarder" Dense="true"
                                 For="@(() => customer.fieldforwarder)"
                                 Label="Forwarder" />
                    <MudCheckBox Class="labelCustomColor" @bind-Checked="customer.fieldbanking" Dense="true"
                                 For="@(() => customer.fieldbanking)"
                                 Label="Banking" />
                    <MudCheckBox Class="labelCustomColor" @bind-Checked="customer.fieldothers" Dense="true"
                                 For="@(() => customer.fieldothers)"
                                 Label="Others" />
                </MudCardContent>

            </MudCard>
            <MudCard>
                <MudCardHeader>
                    National
                </MudCardHeader>
                <MudCardContent Class="pa-1">
                    <MudCheckBox Class="labelCustomColor" @bind-Checked="customer.nationalasia" Dense="true"
                                 For="@(() => customer.nationalasia)"
                                 Label="Asia" />
                    <MudCheckBox Class="labelCustomColor" @bind-Checked="customer.nationalEurope" Dense="true"
                                 For="@(() => customer.nationalEurope)"
                                 Label="Europe" />
                    <MudCheckBox Class="labelCustomColor" @bind-Checked="customer.nationalNAmerica" Dense="true"
                                 For="@(() => customer.nationalNAmerica)"
                                 Label="B America" />
                    <MudCheckBox Class="labelCustomColor" @bind-Checked="customer.nationalAustralia" Dense="true"
                                 For="@(() => customer.nationalAustralia)"
                                 Label="Australia" />
                    <MudCheckBox Class="labelCustomColor" @bind-Checked="customer.nationalOthers" Dense="true"
                                 For="@(() => customer.nationalOthers)"
                                 Label="Others" />
                </MudCardContent>

            </MudCard>
            <MudCard>
                <MudCardHeader>
                    Style
                </MudCardHeader>
                <MudCardContent Class="pa-1">
                    <MudCheckBox Class="labelCustomColor" @bind-Checked="customer.styleForeign" Dense="true"
                                 For="@(() => customer.styleForeign)"
                                 Label="100% Foreign" />
                    <MudCheckBox Class="labelCustomColor" @bind-Checked="customer.styleStateowned" Dense="true"
                                 For="@(() => customer.styleStateowned)"
                                 Label="Sate Owned" />
                </MudCardContent>

            </MudCard>
        </MudStack>
    </MudCardContent>
</MudCard>
@code {
    Color ColorTextFields = Color.Primary;
    [Parameter] public M_Customer customer { get; set; } = default!;
}
