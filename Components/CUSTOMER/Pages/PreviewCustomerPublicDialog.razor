@using MudBlazor
@using NVOAMASIS.Services

<style>
    .cus-public-preview-dialog .mud-dialog-content {
        padding: 12px 16px 8px 16px !important;
        overflow: hidden;
    }

    .cus-public-preview-wrap {
        display: flex;
        flex-direction: column;
        gap: 10px;
        max-height: calc(100vh - 160px);
    }

    .cus-public-preview-summary {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        align-items: center;
    }

    .cus-public-preview-table-wrap {
        flex: 1 1 auto;
        min-height: 0;
        max-height: calc(100vh - 230px);
        overflow: auto;
        border: 1px solid var(--mud-palette-lines-default);
        border-radius: 8px;
        background: var(--mud-palette-surface);
    }

    .cus-public-preview-table {
        width: 100%;
        border-collapse: collapse;
        table-layout: fixed;
        font-size: 0.8rem;
    }

    .cus-public-preview-table thead th {
        position: sticky;
        top: 0;
        z-index: 2;
        background: #edf2f7;
        color: #1a202c;
        font-weight: 600;
        text-align: left;
        padding: 8px 10px;
        border-bottom: 1px solid #cbd5e0;
        white-space: nowrap;
    }

    .cus-public-preview-table tbody td {
        padding: 6px 10px;
        border-bottom: 1px solid #e2e8f0;
        vertical-align: top;
        word-break: break-word;
        line-height: 1.35;
    }

    .cus-public-preview-table tbody tr:nth-child(even) {
        background: #f8fafc;
    }

    .cus-public-preview-table tbody tr:hover {
        background: #eef6ff;
    }

    .cus-public-preview-table .col-row { width: 56px; }
    .cus-public-preview-table .col-code { width: 110px; }
    .cus-public-preview-table .col-sale { width: 64px; }
    .cus-public-preview-table .col-main { width: 110px; }
    .cus-public-preview-table .col-group { width: 110px; }
    .cus-public-preview-table .col-tax { width: 110px; }
    .cus-public-preview-table .col-tel { width: 100px; }
    .cus-public-preview-table .col-han { width: 72px; }
    .cus-public-preview-table .col-remark { width: 80px; }

    .cus-public-preview-muted {
        color: #64748b;
        font-size: 0.75rem;
    }

    .cus-public-preview-skip {
        max-height: 88px;
        overflow: auto;
        padding: 8px 10px;
        border-radius: 8px;
        background: #fff7ed;
        border: 1px solid #fed7aa;
        font-size: 0.78rem;
        color: #9a3412;
    }
</style>

<MudDialog Class="cus-public-preview-dialog">
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@Icons.Material.Filled.Preview" Color="Color.Primary" />
            <MudText Typo="Typo.h6">Xem trước Import Partner List</MudText>
        </MudStack>
    </TitleContent>
    <DialogContent>
        <div class="cus-public-preview-wrap">
            <div class="cus-public-preview-summary">
                <MudChip T="string" Color="Color.Success" Variant="Variant.Filled" Size="Size.Small">
                    Import: @PreviewResult.ToInsert.Count
                </MudChip>
                @if (PreviewResult.Skipped.Count > 0)
                {
                    <MudChip T="string" Color="Color.Warning" Variant="Variant.Filled" Size="Size.Small">
                        Bỏ qua: @PreviewResult.Skipped.Count
                    </MudChip>
                }
                <span class="cus-public-preview-muted">SaleName = NOMI · kiểm tra lại trước khi lưu</span>
            </div>

            @if (PreviewResult.Skipped.Count > 0)
            {
                <div class="cus-public-preview-skip">
                    @foreach (var item in PreviewResult.Skipped)
                    {
                        <div>@item</div>
                    }
                </div>
            }

            <div class="cus-public-preview-table-wrap">
                <table class="cus-public-preview-table">
                    <thead>
                        <tr>
                            <th class="col-row">Dòng</th>
                            <th class="col-code">Customer Code</th>
                            <th class="col-sale">Sale</th>
                            <th class="col-main">Main Code</th>
                            <th class="col-group">Group</th>
                            <th>Company</th>
                            <th>English Name</th>
                            <th class="col-tax">Tax Code</th>
                            <th class="col-tel">Tel</th>
                            <th>Email</th>
                            <th>Address</th>
                            <th>Address TV</th>
                            <th class="col-han">Credit (Days)</th>
                            <th class="col-remark">Credit AMT</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var x in ImportRows)
                        {
                            <tr>
                                <td class="col-row">@x.ExcelRow</td>
                                <td class="col-code">@x.Customer_Code</td>
                                <td class="col-sale">@x.SaleName</td>
                                <td class="col-main">@x.MainCode</td>
                                <td class="col-group">@x.DonViDoiTac_gs</td>
                                <td>@x.Company</td>
                                <td>@x.EnglishName</td>
                                <td class="col-tax">@x.TaxCode</td>
                                <td class="col-tel">@x.Tel</td>
                                <td>@x.Email</td>
                                <td>@x.Address</td>
                                <td>@x.AddressTV</td>
                                <td class="col-han">@x.HanCongNo</td>
                                <td class="col-remark">@x.Remarks_sale</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Variant="Variant.Text" Color="Color.Default">Hủy</MudButton>
        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   Disabled="@(PreviewResult.ToInsert.Count == 0)"
                   StartIcon="@Icons.Material.Filled.Save"
                   OnClick="Confirm">
            Xác nhận Import (@PreviewResult.ToInsert.Count)
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] MudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public CustomerPublicImportPreviewResult PreviewResult { get; set; } = new();

    private List<CustomerPublicImportPreviewRow> ImportRows =>
        PreviewResult.Rows.Where(x => !x.IsSkipped).ToList();

    void Confirm() => MudDialog.Close(DialogResult.Ok(true));
    void Cancel() => MudDialog.Cancel();
}
