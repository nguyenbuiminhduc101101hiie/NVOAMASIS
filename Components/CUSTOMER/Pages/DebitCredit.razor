
<MudStack Row="true" Justify="Justify.FlexStart" Class="py-1" Spacing="1">
    <MudButton HtmlTag="label"
               OnClick="Refresh"
               Size="Size.Small" Color="Color.Primary" Variant="   Variant.Filled"
               StartIcon="@Icons.Material.Filled.Refresh">
        Reload
    </MudButton>
    <MudButton HtmlTag="label"
               @onclick="@(() => AddItem())"
               Size="Size.Small" Color="Color.Secondary" Variant="Variant.Filled"
               StartIcon="@Icons.Material.Filled.Add">
        New
    </MudButton>
    <a href="HDSDhtml/Huong_dan_Debit_Credit_HoaDon.html" target="_blank">
        <MudButton Color="Color.Info" Size=Size.Small StartIcon="@Icons.Material.Filled.Info">Trợ giúp</MudButton>
    </a>
</MudStack>
<MudDataGrid T="M_DebitCreditCustomer" Items="@Listdata" Filterable="true" @ref="mudTable" Class="pa-1"
             FilterMode="@DataGridFilterMode.ColumnFilterRow" Dense="true" Virtualize="true"
             FixedHeader="true" FixedFooter="true" HeaderClass="no-wrap" FooterClass="no-wrap"
             ReadOnly="false" CommittedItemChanges="@CommittedItem"
             ColumnResizeMode="ResizeMode.Column" Loading="_loading">
    <Columns>
        <TemplateColumn CellClass="d-flex justify-end">
            <CellTemplate>
                <MudIconButton Size="@Size.Small" Icon="@Icons.Material.Outlined.Edit" OnClick="@context.Actions.StartEditingItemAsync" />
                <MudIconButton Size="@Size.Small" Icon="@Icons.Material.Outlined.Delete" OnClick="@(()=>DeleteItem(context.Item))" />
            </CellTemplate>
        </TemplateColumn>
        <PropertyColumn Property="x => x.debitcredit" Title="Debit/Credit" >
            <EditTemplate>
                <MudSelect @bind-Value="context.Item.debitcredit" Label="Debit/Credit" Dense="true" Margin="Margin.Dense">
                    <MudSelectItem Value="@("Debit")">Debit</MudSelectItem>
                    <MudSelectItem Value="@("Credit")">Credit</MudSelectItem>
                </MudSelect>
            </EditTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x => x.kyhieuhoadon" Title="KH Hóa đơn" Required="false" />
        <PropertyColumn Property="x => x.sohoadon" Title="Số HĐ" Required="false" />
        <PropertyColumn Property="x => x.ngay" Title="Date" Required="false">
            <EditTemplate>
                <MudStack Row Spacing="1">
                    <MudDatePicker TextChanged="@((t) => context.Item.ngay = DateTime.Parse(t).ToString("dd-MMM-yyyy"))" Label="Ngày PS" Dense="true" Margin="Margin.Dense" />
                    <MudTextField @bind-Value="context.Item.ngay" Dense="true" Margin="Margin.Dense" />
                </MudStack>
            </EditTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x => x.ngayphathanhhoadon" Title="Ngày phát hành HĐ" Required="false">
            <EditTemplate>
                <MudStack Row Spacing="1">
                    <MudDatePicker TextChanged="@((t) => context.Item.ngayphathanhhoadon = DateTime.Parse(t).ToString("dd-MMM-yyyy"))" Label="Ngày phát hành HĐ" Dense="true" Margin="Margin.Dense" />
                    <MudTextField @bind-Value="context.Item.ngayphathanhhoadon" Dense="true" Margin="Margin.Dense" />
                </MudStack>
            </EditTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x => x.mathang" Title="Mặt hàng" Required="false">
            <EditTemplate>
                <MudSelect @bind-Value="context.Item.mathang" Label="Items (Mặt hàng)" Dense="true" Margin="Margin.Dense">
                    @foreach(var item in ListMatHang)
                    {
                        <MudSelectItem Value="@item.mathang">@item.mathang</MudSelectItem>
                    }
                </MudSelect>
            </EditTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x => x.giatruocthue" Title="Giá trước thuế" Required="false" >
            <EditTemplate>
                <MudNumericField @bind-Value="context.Item.giatruocthue" Label="Giá trước thuế"
                                 Format="#,##0" T="double?" Class="text-right"
                                TextChanged="@(e => CalculateThanhtiensauthue(context.Item))" Dense="true" Margin="Margin.Dense" />
            </EditTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x => x.thuesuat" Title="Thuế suất" Required="false">
            <EditTemplate>
                <MudNumericField @bind-Value="context.Item.thuesuat" Label="Thuế suất"
                                 Format="#,##0" T="double?"
                                 TextChanged="@(e => CalculateThanhtiensauthue(context.Item))" Dense="true" Margin="Margin.Dense" />
            </EditTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x => x.thuegtgt" Title="Thuế GTGT" Required="false">
            <EditTemplate>
                <MudNumericField @bind-Value="context.Item.thuegtgt" Label="Thuế GTGT"
                                 Format="#,##0" T="double?"
                                 TextChanged="@(e => CalculateThanhtiensauthue(context.Item))" Dense="true" Margin="Margin.Dense" />
            </EditTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x => x.price" Title="Price" Required="false">
            <EditTemplate>
                <MudNumericField @bind-Value="context.Item.price" Label="Price"
                                 Format="#,##0" T="double?" Class="text-right" Dense="true" Margin="Margin.Dense" />
            </EditTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x => x.bank" Title="Bank" Required="false" />
        <PropertyColumn Property="x => x.department" Title="Department" Required="false">
            <EditTemplate>
                <MudSelect @bind-Value="context.Item.department" Label="Department" Dense="true" Margin="Margin.Dense">
                    @foreach (var item in depts)
                    {
                        <MudSelectItem Value="@item.Viewername">@item.Viewername</MudSelectItem>
                    }
                </MudSelect>
            </EditTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x => x.phanbo" Title="Phân bổ" Required="false" >
            <EditTemplate>
                <MudCheckBox @bind-Checked="context.Item.phanbo" Label="Phân bổ" Dense="true" />
            </EditTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x => x.currency" Title="Currenry" Required="false">
            <EditTemplate>
                <MudSelect @bind-Value="context.Item.currency" Label="Currenry" Dense="true" Margin="Margin.Dense">
                    <MudSelectItem Value="@("VND")">VND</MudSelectItem>
                    <MudSelectItem Value="@("USD")">USD</MudSelectItem>
                </MudSelect>
            </EditTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x => x.tigia" Title="Exchange" Required="false" Class="text-right" />
        <PropertyColumn Property="x => x.pttt" Title="Method (PTTT)" Required="false">
            <EditTemplate>
                <MudSelect @bind-Value="context.Item.pttt" Label="Method (PTTT)" Dense="true" Margin="Margin.Dense">
                    <MudSelectItem Value="@("TM")">TM</MudSelectItem>
                    <MudSelectItem Value="@("CK")">CK</MudSelectItem>
                    <MudSelectItem Value="@("TM/CK")">TM/CK</MudSelectItem>
                </MudSelect>
            </EditTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x => x.tennganhang" Title="Bank name" Required="false" />
        <PropertyColumn Property="x => x.mota" Title="Desc" Required="false">
            <EditTemplate>
                <MudTextField @bind-Value="context.Item.mota" AutoGrow Lines="2" Label="Desc" Dense="true" Margin="Margin.Dense"/>
            </EditTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x => x.approve" Title="Arrprove" Required="false">
            <EditTemplate>
                <MudCheckBox @bind-Checked="context.Item.approve" Label="Arrprove" Dense="true" />
            </EditTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x => x.userupdate" Title="User Update" Required="false" IsEditable="false"/>
        <PropertyColumn Property="x => x.dateupdate" Title="Date Update" Required="false" IsEditable="false" />
    </Columns>
</MudDataGrid>
@inject CustomerService csv
@inject SharedServices ssv
@inject AccountService asv
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@code {

    [Parameter] public M_Customer customer { get; set; } = default!;
    void CallSnackBar(string message, MudBlazor.Severity severity)
    {
        
        Snackbar.Configuration.SnackbarVariant = Variant.Filled;
        Snackbar.Configuration.MaxDisplayedSnackbars = 3;
        Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopRight;
        Snackbar.Add(message, severity);
    }
    protected async override Task OnInitializedAsync()
    {
        Listdata = await csv.GetListDebitCreditCustomer(customer.Customer_ID);
        ListMatHang = await csv.GetListMatHang();
        depts = await csv.GetListDept();
    }
    List<M_DebitCreditCustomer> ListMatHang = new List<M_DebitCreditCustomer>();
    List<M_ListDept> depts = new List<M_ListDept>();
    bool _loading = false;
    List<M_DebitCreditCustomer> Listdata = new List<M_DebitCreditCustomer>();
    async Task Refresh()
    {
        try
        {
            _loading = true;
            // Simulate asynchronous loading to demonstrate a loading indicator
            Listdata.Clear();
            StateHasChanged();
            await Task.Delay(500);
            if (!await ssv.CheckPermission(asv.GetAuth().Result.User.Identity!.Name!, "View", "System-Customer"))
            {
                CallSnackBar("You have not access to view", MudBlazor.Severity.Warning);
                return;
            }
            Listdata = await csv.GetListDebitCreditCustomer(customer.Customer_ID);
        }
        finally
        {
            _loading = false;
        }

    }

    MudDataGrid<M_DebitCreditCustomer> mudTable;
    async Task AddItem()
    {
        var item = new M_DebitCreditCustomer();
        Listdata.Add(item);
        await mudTable.SetEditingItemAsync(Listdata.LastOrDefault()!);
    }

    async Task DeleteItem(M_DebitCreditCustomer item)
    {
        if (item == null)
        {
            CallSnackBar("you must select 1 row.", MudBlazor.Severity.Warning);
            return;
        }
        var resultMess = await DialogService.ShowMessageBox(
                "Warning",
                "Deleting can not be undone!",
                yesText: "Delete!", cancelText: "Cancel");

        if (resultMess.HasValue)
        {
            var rs = await csv.DeleteCreditDebitCus(item);
            CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
            await Refresh();
        }

    }
    async Task CommittedItem(M_DebitCreditCustomer item)
    {
        item.customerid = customer.Customer_ID;
        item.userupdate = asv.GetAuth().Result.User.Identity!.Name!;
        item.dateupdate = DateTime.Now.ToString();
        item.continued = item.editable = true;
        var rs = item.debitcreditcustomerid != Guid.Empty ? await csv.UpdateCreditDebitCus(item) : await csv.CreateCreditDebitCus(item);
        CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
        await Refresh();
    }

    private void CalculateThanhtiensauthue(M_DebitCreditCustomer item)
    {
        if (item.giatruocthue.HasValue && (item.thuesuat.HasValue || item.thuegtgt.HasValue))
        {
            double thanhtienValue = item.giatruocthue ?? 0;
            double thueValue = item.thuesuat ?? 0;
            double thuegtgt = item.thuegtgt ?? 0;
            item.price = Math.Round(thanhtienValue * ((thueValue + thuegtgt) / 100 + 1), 2);
        }


    }
}
