            var rs = await csv.UpdateOrCreate(data, CusDetail, "");
            CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
            await HandleRefresh();
            searchString1 = data.Customer_Code;
        }
    }

