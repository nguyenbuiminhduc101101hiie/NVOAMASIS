@page "/sys/Customerpublic"
@inject NavigationManager navSvc
@inject ILogger<Index> Logger
@inject IJSRuntime js
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject SharedServices ssv
@inject AccountService asv
@inject SupportServices supsv
@inject IStringLocalizer<SharedResource> Localizer
@attribute [Authorize]

@inject CustomerService plsv

<PageTitle>@Localizer["Customer"]</PageTitle>

<MudContainer MaxWidth=MaxWidth.False>
    <MudStack Class="pa-2" Style="font-size:xx-large; font-weight: bolder">@Localizer["Customer"]</MudStack>
    <MudStack Row Justify="Justify.FlexStart" Class="pa-4">
        <MudButton HtmlTag="label"
                   OnClick="HandleRefresh"
                   Size="Size.Small"
                   Color="Color.Primary"
                   Variant="Variant.Filled"
                   StartIcon="@Icons.Material.Filled.Refresh">
               
            @Localizer["reload"]
        </MudButton>



        <MudButton HtmlTag="label"
                   @onclick="@(() => MoveCustomer())" Disabled="CusDetail == null ? false : (CusDetail.SaleName == userdetail.Usr ? true : false)"
                   Size="Size.Small" Color="Color.Tertiary" Variant="Variant.Filled"
                   StartIcon="@Icons.Material.Filled.Download">
            @Localizer["Move Customer"]
        </MudButton>

        <MudButton Size="Size.Small" Color="Color.Primary"
                   Variant="Variant.Filled" HtmlTag="label"
                   StartIcon="@Icons.Material.Filled.ImportExport">
            <MudFileUpload T="IBrowserFile" Accept=".xls,.xlsx" Disabled="_processingUpload" FilesChanged="importExcel"
                           MaximumFileCount="100">

                @if (_processingUpload)
                {
                    <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />

                }


            </MudFileUpload>
            @Uploadtext
        </MudButton>
        <!-- File text -->
        <MudTextField @bind-Value="_dksearch" Label="Search Content" Variant="Variant.Outlined" />

        <!-- Radio group với enum -->
        <MudRadioGroup T="SearchOption" @bind-SelectedOption="_selectedOption" Label="Search By">
            <MudRadio Option="SearchOption.Tax">Tax</MudRadio>
            <MudRadio Option="SearchOption.ShortName">Short Name</MudRadio>
            <MudRadio Option="SearchOption.InvoiceName">Invoice Name</MudRadio>
            <MudRadio Option="SearchOption.DebitName">Debit Name</MudRadio>
        </MudRadioGroup>


        <!-- Button -->
        <MudButton OnClick="HandleSubmit" Color="Color.Success" Variant="Variant.Filled">
            Search
        </MudButton>
    </MudStack>


</MudContainer>

<MudContainer MaxWidth=MaxWidth.False>
    <MudDataGrid T="M_Customer" Bordered="true" Items="@Cus.ToList()" Filterable="true" QuickFilter="@FilterFunc1"
                 FilterMode="@DataGridFilterMode.ColumnFilterRow" Dense="true" Virtualize="true"
                 RowClick="@RowClicked" RowContextMenuClick="RowRightClicked"
                 FixedHeader="true" FixedFooter="true" HeaderClass="no-wrap" FooterClass="no-wrap"
                 RowClassFunc="@SelectedRowClassFunc" @ref="mudTable" ReadOnly="false" Loading="f_loading"
                 ColumnResizeMode="@(_resizeColumn ? ResizeMode.Column : ResizeMode.Container)" CommittedItemChanges="@((t)=>CommittedItemChanges(t))">
        <Columns>
            <PropertyColumn Required="false" Property="x => Cus.IndexOf(x) + 1" Title="@Localizer["no"]" Filterable="false" Editable="false" CellStyleFunc="_cellStyleFunc">
                <FooterTemplate>
                    @Localizer["no"]
                </FooterTemplate>
            </PropertyColumn>
            <PropertyColumn Required="false" Property="x => x.SaleName" Title="@Localizer["SaleName"]" Editable="false" CellStyleFunc="_cellStyleFunc">
                <FooterTemplate>
                    @Localizer["SaleName"]
                </FooterTemplate>
            </PropertyColumn>
            <PropertyColumn Required="false" Property="x => x.Customer_Code" Title="@Localizer["Customer_Code"]" Editable="false" CellStyleFunc="_cellStyleFunc">
                <FilterTemplate>
                    <MudTextField @bind-Value="searchString1" />
                </FilterTemplate>
                <FooterTemplate>
                    @Localizer["Customer_Code"]
                </FooterTemplate>
            </PropertyColumn>
            <PropertyColumn Required="false" Property="x => x.MainCode" Title="@Localizer["MainCode"]" Editable="false" CellStyleFunc="_cellStyleFunc">
                <FooterTemplate>
                    @Localizer["MainCode"]
                </FooterTemplate>
            </PropertyColumn>
            <PropertyColumn Required="false" Property="x => x.status" Title="@Localizer["status"]" Editable="false" CellStyleFunc="_cellStyleFunc">
                <FooterTemplate>
                    @Localizer["status"]
                </FooterTemplate>
            </PropertyColumn>
            <PropertyColumn Required="false" Property="x => x.TaxCode" Title="@Localizer["TaxCode"]" Editable="false" CellStyleFunc="_cellStyleFunc">
                <FooterTemplate>
                    @Localizer["TaxCode"]
                </FooterTemplate>
            </PropertyColumn>
            <PropertyColumn Required="false" Property="x => x.shortname" Title="@Localizer["shortname"]" Editable="false" CellStyleFunc="_cellStyleFunc">
                <FooterTemplate>
                    @Localizer["shortname"]
                </FooterTemplate>
            </PropertyColumn>
            <PropertyColumn Required="false" Property="x => x.COMPANY" Title="@Localizer["COMPANY"]" Editable="false" CellStyleFunc="_cellStyleFunc">
                <FooterTemplate>
                    @Localizer["COMPANY"]
                </FooterTemplate>
            </PropertyColumn>
            <PropertyColumn Required="false" Property="x => x.EnglishName" Title="@Localizer["EnglishName"]" Editable="false" CellStyleFunc="_cellStyleFunc">
                <FooterTemplate>
                    @Localizer["EnglishName"]
                </FooterTemplate>
            </PropertyColumn>
            <PropertyColumn Required="false" Property="x => x.Address" Title="@Localizer["Address"]" Editable="false" CellStyleFunc="_cellStyleFunc">
                <FooterTemplate>
                    @Localizer["Address"]
                </FooterTemplate>
            </PropertyColumn>
            <PropertyColumn Required="false" Property="x => x.addresstiengviet" Title="@Localizer["addresstiengviet"]" Editable="false" CellStyleFunc="_cellStyleFunc">
                <FooterTemplate>
                    @Localizer["addresstiengviet"]
                </FooterTemplate>
            </PropertyColumn>
        </Columns>
        <PagerContent>
            <MudDataGridPager T="M_Customer" PageSizeOptions=@(new int[] { 8, 10, 20 }) />
        </PagerContent>
    </MudDataGrid>
    <MudScrollToTop>
        <MudFab Color="Color.Primary" StartIcon="@Icons.Material.Filled.ArrowCircleUp" />
    </MudScrollToTop>

</MudContainer>
<script>
    window.triggerGridClick = () => {
    const gridElement = document.querySelector(".mudTable");
    if (gridElement) {
    gridElement.click();
    }
    }
</script>
@inject CustomerService csv
@code {

    private int selectedRowNumber = -1;
    private MudDataGrid<M_Customer> mudTable;
    private List<M_Customer> Cus = new List<M_Customer>();
    private M_Customer CusDetail;
    private bool _processingUpload = false;
    private bool _resizeColumn;
    private string searchString1 = "";
    private bool FilterFunc1(M_Customer sbd) => FilterFunc(sbd, searchString1);
    private string? _dksearch = "";
    private SearchOption _selectedOption = SearchOption.Tax; // default value
    public enum SearchOption
    {
        Tax,
        ShortName,
        InvoiceName,
        DebitName
    }
    private bool FilterFunc(M_Customer sbd, string searchString)
    {
        if (string.IsNullOrWhiteSpace(searchString))
            return true;
        if (sbd.Customer_Code!.Contains(searchString, StringComparison.OrdinalIgnoreCase))
            return true;
        if ($"{sbd.Customer_Code} ".Contains(searchString))
            return true;
        return false;
    }
    string Uploadtext = "Import Excel";
    bool f_loading = false;
    async Task HandleRefresh()
    {
        try
        {
            f_loading = true;
            // Simulate asynchronous loading to demonstrate a loading indicator
            Cus.Clear();
            CusDetail = null;

            await Task.Delay(500);

            if (!await ssv.CheckPermission(asv.GetAuth().Result.User.Identity!.Name!, "View", "System-Customer"))
            {
                CallSnackBar("You have not access to view", MudBlazor.Severity.Warning);
                return;
            }
            var checkmovecus = await csv.CheckAndRefundMoveCustomer();
            if (checkmovecus.Item2 > 0) ListMoveCus = await csv.GetMoveCustomer();
            if (!checkmovecus.Item1.Flag)
                CallSnackBar(checkmovecus.Item1.Message, MudBlazor.Severity.Error);
            Cus = await csv.GetListNomi();
            StateHasChanged();
        }
        finally
        {
            f_loading = false;
        }

    }
    async Task HandleSubmit()
    {
        try
        {
            f_loading = true;
            // Simulate asynchronous loading to demonstrate a loading indicator
            Cus.Clear();
            CusDetail = null;

            await Task.Delay(500);

            if (!await ssv.CheckPermission(asv.GetAuth().Result.User.Identity!.Name!, "View", "System-Customer"))
            {
                CallSnackBar("You have not access to view", MudBlazor.Severity.Warning);
                return;
            }
            var checkmovecus = await csv.CheckAndRefundMoveCustomer();
            if (checkmovecus.Item2 > 0) ListMoveCus = await csv.GetMoveCustomer();
            if (!checkmovecus.Item1.Flag)
                CallSnackBar(checkmovecus.Item1.Message, MudBlazor.Severity.Error);

            if (string.IsNullOrEmpty(_dksearch))
            {
                CallSnackBar("Enter search conditions", MudBlazor.Severity.Warning);
                return;
            }
            if (_selectedOption == SearchOption.Tax)
            {
                Cus = await csv.GetListNomi_by_tax(_dksearch);
            }
            else if (_selectedOption == SearchOption.ShortName)
            {
                Cus = await csv.GetListNomi_by_shortname(_dksearch);
            }
            else if (_selectedOption == SearchOption.DebitName)
            {
                Cus = await csv.GetListNomi_by_debitname(_dksearch);
            }
            else
            {
                Cus = await csv.GetListNomi_by_invoicename(_dksearch);
            }

            StateHasChanged();
        }
        finally
        {
            f_loading = false;
        }

    }
    private async Task MoveCustomer()
    {
        if (CusDetail == null)
        {
            CallSnackBar("Please select a Customer!", MudBlazor.Severity.Warning);
            return;
        }

        if (!await ssv.CheckPermission(userdetail.Usr, "Edit", "System-Customer"))
        {
            CallSnackBar("You have not access to Move", MudBlazor.Severity.Warning);
            return;
        }
        var check = await csv.CheckMoveCusOver100(userdetail.Usr);
        if (!check.Flag)
        {
            CallSnackBar(check.Message, MudBlazor.Severity.Warning);
            return;
        }

        var movecus = new MoveCustomer();
        movecus.ID = Guid.NewGuid();
        movecus.CustomerCode = CusDetail.Customer_Code;
        movecus.SaleName = userdetail.Usr;
        movecus.MoveDate = DateTime.Now;
        movecus.CustomerID = CusDetail.Customer_ID;
        CusDetail.SaleName = userdetail.Usr;
        CusDetail.thoihanmove = int.TryParse(CusDetail.Remarks_sale, out var val) ? val : 0;

        var rs = await csv.MoveCustomer(movecus, CusDetail);
        CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
        ListMoveCus = await csv.GetMoveCustomer();
        await TriggerGridClick();
        await HandleRefresh();
        StateHasChanged();

    }

    string GetMoveDate(string cuscode)
    {
        if (ListMoveCus == null || ListMoveCus.Count == 0)
            return string.Empty;
        var data = ListMoveCus.Where(x => x.CustomerCode == cuscode).OrderByDescending(x => x.MoveDate).FirstOrDefault();
        if (data == null)
            return string.Empty;
        return data!.MoveDate.HasValue ? data.MoveDate.Value.ToString("dd/MMM/yyyy")! : string.Empty;
    }
    private async Task OpenDialogDuplicate()
    {
        var optionsdialog = new DialogOptions
        {
            ClassBackground = "class-dialog-custom",
            FullWidth = true,
            MaxWidth = MaxWidth.Medium,
            CloseOnEscapeKey = false,
            DisableBackdropClick = true
        };
        if (CusDetail == null)
        {
            CallSnackBar("Please select a Customer!", MudBlazor.Severity.Warning);
            return;
