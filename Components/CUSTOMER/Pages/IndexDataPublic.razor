    private async Task importExcel(IBrowserFile file)
    {
        try
        {
            _processingUpload = true;
            Uploadtext = "Processing";

            // Copy stream nếu InsertCSV cần stream
            using var streamCopy = new MemoryStream();
            await file.OpenReadStream(long.MaxValue).CopyToAsync(streamCopy);
            streamCopy.Position = 0;

            // ✅ Bỏ bước preview, insert luôn
            List<string> message = await csv.InsertCSV(file);

            if (message[1] == "1")
            {
                CallSnackBar(message[0], MudBlazor.Severity.Success);
                await HandleRefresh();
            }
            else
            {
                CallSnackBar(message[0], MudBlazor.Severity.Error);
            }
        }
        catch (Exception ex)
        {
            CallSnackBar("Throw exception: " + ex.Message, MudBlazor.Severity.Error);
        }
        finally
        {
            Uploadtext = "Import Excel";
            _processingUpload = false;
        }
    }

    private Func<M_Customer, string> _cellStyleFunc => x =>
    {
        string style = "";

        if (string.IsNullOrEmpty(x.status))
            return "color: #000000";

        var rs = tts
            .Where(t => (t.Noidung).Contains(x.status, StringComparison.InvariantCultureIgnoreCase)
                && t.Tieude.Equals("CUSTOMER", StringComparison.InvariantCultureIgnoreCase))
            .Select(t => t.Mamau)
            .FirstOrDefault();
        return "color: " + rs;


    };
