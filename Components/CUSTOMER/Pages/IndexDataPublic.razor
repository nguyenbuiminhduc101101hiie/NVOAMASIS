        {
            // Customer_ID = Guid.NewGuid()
        };
        var cuscode = await csv.GetCustomerCode();
        if (!cuscode.Item1.Flag)
            CallSnackBar(cuscode.Item1.Message, MudBlazor.Severity.Error);
        else
            cusnew.Customer_Code = cuscode.Item2.CustomerCode_Ref;

        var parameters = new DialogParameters<Edit> { { x => x.customer, cusnew }, { x => x.EditOrNot, false } };
        var dialog = await DialogService.ShowAsync<Edit>("Customer - Create", parameters, optionsdialog);
        var result = await dialog.Result;

        if (!result.Canceled)
