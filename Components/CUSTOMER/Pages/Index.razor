    private bool FilterFunc(M_Customer sbd, string searchString)
    {
        if (string.IsNullOrWhiteSpace(searchString))
            return true;
        if (sbd.Customer_Code!.Contains(searchString, StringComparison.OrdinalIgnoreCase))
            return true;
        if ($"{sbd.Customer_Code} ".Contains(searchString))
            return true;
        return false;
    }
    string Uploadtext = "Import Excel";
    bool f_loading = false;
    async Task HandleRefresh()
    {
        try
        {
            f_loading = true;
            // Simulate asynchronous loading to demonstrate a loading indicator
            Cus.Clear();
            CusDetail = null;

            await Task.Delay(500);

            if (!await ssv.CheckPermission(asv.GetAuth().Result.User.Identity!.Name!, "View", "System-Customer"))
            {
                CallSnackBar("You have not access to view", MudBlazor.Severity.Warning);
                return;
            }
            ListMoveCus = await csv.GetMoveCustomer();

            var checkmovecus = await csv.CheckAndRefundMoveCustomer();
            if (checkmovecus.Item2 > 0) ListMoveCus = await csv.GetMoveCustomer();
            if (!checkmovecus.Item1.Flag)
                CallSnackBar(checkmovecus.Item1.Message, MudBlazor.Severity.Error);
            Cus = await plsv.GetListBySale(userdetail);
            StateHasChanged();
        }
        finally
        {
            f_loading = false;
        }

    }
    private async Task MoveCustomertopublic()
    {
        if (CusDetail == null)
        {
            CallSnackBar("Please select a Customer!", MudBlazor.Severity.Warning);
            return;
        }

        if (!await ssv.CheckPermission(userdetail.Usr, "Edit", "System-Customer"))
        {
            CallSnackBar("You have not access to Move", MudBlazor.Severity.Warning);
            return;
        }

        CusDetail.SaleName = "NOMI";
        CusDetail.Remarks_sale = "30";
        var rs = await csv.UpdateCustomer(CusDetail);
        await csv.Delete_cus_in_movecus(CusDetail.Customer_ID);
        CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
        ListMoveCus = await csv.GetMoveCustomer();
        await TriggerGridClick();
        await HandleRefresh();
        StateHasChanged();

    }

    string GetMoveDate(string cuscode)
    {
        if (ListMoveCus == null || ListMoveCus.Count == 0)
            return string.Empty;
        var data = ListMoveCus.Where(x => x.CustomerCode == cuscode).OrderByDescending(x => x.MoveDate).FirstOrDefault();
        if (data == null)
            return string.Empty;
        return data!.MoveDate.HasValue ? data.MoveDate.Value.ToString("dd/MMM/yyyy")! : string.Empty;
    }
    private async Task OpenDialogDuplicate()
    {
        var optionsdialog = new DialogOptions
        {
            ClassBackground = "class-dialog-custom class-dialog-customer-wide",
            FullWidth = true,
            MaxWidth = MaxWidth.False,
            CloseOnEscapeKey = false,
            DisableBackdropClick = true
        };
        if (CusDetail == null)
        {
            CallSnackBar("Please select a Customer!", MudBlazor.Severity.Warning);
            return;
        }

        if (!await ssv.CheckPermission(userdetail.Usr, "Add", "System-Customer"))
        {
            CallSnackBar("You have not access to Add", MudBlazor.Severity.Warning);
            return;
        }

        CusCoppy = CusDetail.DeepCopy();
        var cusdata = CusDetail.DeepCopy();
        cusdata.Customer_ID = Guid.Empty;
        var parameters = new DialogParameters<Edit> { { x => x.customer, cusdata }, { x => x.EditOrNot, false } };
        var dialog = await DialogService.ShowAsync<Edit>($"Customer - Duplicate {CusDetail.Customer_Code}", parameters, optionsdialog);
        var result = await dialog.Result;
        if (!result.Canceled)
        {
            var data = (M_Customer)result.Data;
            var rs = await plsv.UpdateOrCreate(data, CusDetail, "Duplicate");
            CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
            await HandleRefresh();
            searchString1 = data.Customer_Code;
        }
        await TriggerGridClick();
        StateHasChanged();

    }
