        {
            CallSnackBar($"You Cannot Edit Sale Name 'NOMI', Move Customer and try again!", MudBlazor.Severity.Warning);
            return;
        }
        CusCoppy = CusDetail.DeepCopy();
        var parameters = new DialogParameters<Edit> { { x => x.customer, CusCoppy }, { x => x.EditOrNot, true } };
        var dialog = await DialogService.ShowAsync<Edit>($"Customer - Edit {CusCoppy.Customer_Code}", parameters, optionsdialog);
        var result = await dialog.Result;
