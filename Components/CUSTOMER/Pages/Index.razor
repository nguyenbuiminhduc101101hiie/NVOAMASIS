    private async Task Delete()
    {
        try
        {

            if (!await ssv.CheckPermission(userdetail.Usr, "Delete", "System-Customer"))
            {
                CallSnackBar("You have not access to Delete", MudBlazor.Severity.Warning);
                return;
            }
            if (CusDetail == null)
            {
                CallSnackBar("Nothing to delete!", MudBlazor.Severity.Warning);
                return;
            }
            var resultMess = await DialogService.ShowMessageBox(
                "Warning",
                "Deleting can not be undone!",
                yesText: "Delete!", cancelText: "Cancel");

            if (resultMess.HasValue)
            {
                var result = await plsv.Delete(CusDetail);
                string usr = asv.GetAuth().Result.User.Identity!.Name!;
                await HistoryLogService.LogAsync(usr, "Delete", "System-Customer", CusDetail.Customer_ID, CusDetail.Customer_Code, new { OldData = CusDetail });
                CallSnackBar(result.Message, result.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
                await HandleRefresh();
            }
        }
        catch (Exception ex)
        {
            CallSnackBar("Cannot delete with eror code: " + ex.Message, MudBlazor.Severity.Error);

        }
    }
