<PageTitle>@Localizer["Customer"]</PageTitle>

<MudContainer MaxWidth=MaxWidth.False>
    <MudStack Class="pa-2" Style="font-size:xx-large; font-weight: bolder">@Localizer["Customer"]</MudStack>

    <MudStack Row Justify="Justify.FlexStart" Class="pa-4">
        <MudButton HtmlTag="label"
                   OnClick="HandleRefresh"
                   Size="Size.Small" Color="Color.Primary" Variant="   Variant.Filled"
                   StartIcon="@Icons.Material.Filled.Refresh">
            @Localizer["reload"]
        </MudButton>
        <MudButton HtmlTag="label"
                   @onclick="@(() => OpenDialog())"
                   Size="Size.Small" Color="Color.Secondary" Variant="Variant.Filled"
                   Disabled="@(userdept !="ADMIN")"
                   StartIcon="@Icons.Material.Filled.Add">
            @Localizer["new"]
        </MudButton>
        <MudButton HtmlTag="label"
                   @onclick="@(() => OpenDialogEdit())"
                   Size="Size.Small" Color="Color.Info" Variant="Variant.Filled"
                   StartIcon="@Icons.Material.Filled.Edit">
            @Localizer["edit"]
        </MudButton>

        <MudButton HtmlTag="label"
                   @onclick="@(() => OpenDialogDuplicate())"
                   Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled"
                   Disabled="@(userdept !="ADMIN")"
                   StartIcon="@Icons.Material.Filled.CopyAll">

            @Localizer["duplicate"]
        </MudButton>

        <MudButton HtmlTag="label"
                   @onclick="@(() => MoveCustomertopublic())" Disabled="CusDetail == null || ListMoveCus == null || !ListMoveCus.Any(x => x.CustomerCode == CusDetail.Customer_Code)"
                   Size="Size.Small" Color="Color.Tertiary" Variant="Variant.Filled"
                   StartIcon="@Icons.Material.Filled.Download">
            @Localizer["Move Customer To Public"]
        </MudButton>

        @* <MudButton HtmlTag="label"
                   @onclick="@(() => MoveCustomer())" Disabled="CusDetail == null ? false : (CusDetail.SaleName == userdetail.Usr ? true : false)"
                   Size="Size.Small" Color="Color.Tertiary" Variant="Variant.Filled"
                   StartIcon="@Icons.Material.Filled.Download">
            @Localizer["Move Customer"]
        </MudButton> *@
        <MudButton HtmlTag="label"
                   OnClick="Delete"
                   Size="Size.Small" Color="Color.Error" Variant="Variant.Filled"
                   Disabled="@(userdept !="ADMIN")"
                   StartIcon="@Icons.Material.Filled.Delete">
            @Localizer["delete"]
        </MudButton>
        <MudButton Size="Size.Small" Color="Color.Primary"
                   Variant="Variant.Filled" HtmlTag="label"
