                                                <MudItem xs="12" sm="6" md="4" Class="py-0">
                                                    <MudTextField Class="px-1 labelCustomColor" @bind-Value="customer.Email"
                                                        For="@(() => customer.Email)" AdornmentColor="@ColorTextFields"
                                                        Immediate="true" AutoGrow Label=@Localizer["INV. Email"] />
                                                </MudItem>
                                                <MudItem xs="12" Class="py-0">
                                                    <MudTextField Class="px-1 labelCustomColor" @bind-Value="customer.addresstiengviet"
                                                        For="@(() => customer.addresstiengviet)" AdornmentColor="@ColorTextFields" Lines="2"
                                                        Immediate="true" AutoGrow Label="@Localizer["Address"]" />
                                                </MudItem>
                                                <MudItem xs="12" sm="6" md="3" Class="py-0">
                                                    <MudAutocomplete T="string" Class="px-1 labelCustomColor" @bind-Value="customer.Country"
                                                        AdornmentColor="@ColorTextFields" Immediate="true" SearchFunc="mst_Country" CoerceValue
                                                        Clearable="true" Label="@Localizer["Country"]" />
                                                </MudItem>
                                                <MudItem xs="12" sm="6" md="3" Class="py-0">
                                                    <MudTextField Class="px-1 labelCustomColor" @bind-Value="customer.Province"
                                                        For="@(() => customer.Province)" AdornmentColor="@ColorTextFields"
                                                        Immediate="true" AutoGrow Label="@Localizer["City"]" />
                                                </MudItem>
                                                <MudItem xs="12" sm="6" md="3" Class="py-0">
                                                    <MudTextField Class="px-1 labelCustomColor" @bind-Value="customer.city"
                                                        For="@(() => customer.city)" AdornmentColor="@ColorTextFields"
                                                        Immediate="true" AutoGrow Label=@Localizer["City"] />
                                                </MudItem>
                                                <MudItem xs="12" sm="6" md="3" Class="py-0">
                                                    <MudSelect Class="px-1 labelCustomColor" @bind-Value="customer.Type"
                                                        For="@(() => customer.Type)" AdornmentColor="@ColorTextFields"
                                                        Immediate="true" Label=@Localizer["Type"]>
                                                        <MudSelectItem Value=@("HQ")>HQ</MudSelectItem>
                                                    </MudSelect>
                                                </MudItem>
                                            </MudGrid>
                                        </MudPaper>
                                    </MudItem>
                                    <MudItem xs="12" Class="py-0">
                                        <MudTextField Class="px-1 labelCustomColor" @bind-Value="customer.Remarks_Customer"
