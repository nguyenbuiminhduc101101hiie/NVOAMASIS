@inject IStringLocalizer<SharedResource> Localizer

<MudDialog>
  <DialogContent>
        <div style="max-height: 75vh; overflow-y: auto; width: 100%;">
        <MudContainer Class="pa-2" MaxWidth="MaxWidth.False">
            <MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-2" MinimumTabWidth="20px">
                <MudTabPanel Text="Base Info">
                    <MudTabs>
                        <MudTabPanel Text="Base Info (1)">
                            <MudTabs Elevation="1" Rounded="true" Color="Color.Tertiary">
                                <MudCardContent Class="pa-2">
                                    <MudGrid Spacing="2">
                                        <MudItem xs=12 Class="pt-2 pb-1">
                                            <a href="HDSDhtml/Huong_dan_Customer_Base_Info_1.html" target="_blank">
                                                <MudButton Color="Color.Info" Size=Size.Small StartIcon="@Icons.Material.Filled.Info">@Localizer["Tutorial"]</MudButton>
                                            </a>
                                        </MudItem>
                                        <MudItem xs="12" Style="background-color: lightcyan; display:flex" Class="py-1">
                                            <MudGrid Spacing="2">
                                                <MudItem xs="3" Class="py-0">
                                                    <MudTextField Class="pa-2 labelCustomColor" @bind-Value="customer.Customer_Code"
                                                    For="@(() => customer.Customer_Code)"
                                                    AdornmentColor="@ColorTextFields"
                                                    Immediate="true" AutoGrow Disabled="EditOrNot"
                                                    Label="@Localizer["Customer_Code"]" />
                                                </MudItem>

                                                <MudItem xs="2" Class="py-0">
                                                    <MudSelect Class="pa-2 labelCustomColor" @bind-Value="customer.SaleName" Required
                                                    For="@(() => customer.SaleName)"
                                                    AdornmentColor="@ColorTextFields"
                                                    Immediate="true"
                                                    Label="@Localizer["SaleName"]">
                                                        @foreach (var item in saleNames)
                                                        {
                                                            <MudSelectItem Value="item">@item</MudSelectItem>
                                                        }
                                                    </MudSelect>
                                                </MudItem>
                                                    <MudItem xs="2" Class="py-0">
                                                <MudNumericField Class="pa-2 labelCustomColor" @bind-Value="customer.thoihanmove"
                                                    For="@(() => customer.thoihanmove)"
                                                    AdornmentColor="@ColorTextFields"
                                                    Immediate="true" HideSpinButtons="true"
                                                    HelperTextOnFocus="true" HelperText="@Localizer["Sales Expiry date"]"
                                                    Label="@Localizer["Ex.Date"]" />
                                                </MudItem>
                                                <MudItem xs="2" Class="py-0">
                                                    <MudTextField Class="pa-2 labelCustomColor"
                                                    Value="@GetMoveDate(customer?.Customer_Code)"
                                                    Label="@Localizer["Move Date"]"
                                                    ReadOnly="true"
                                                     />
                                                </MudItem>
                                                <MudItem xs="3" Class="py-0">
                                                    <MudTextField Class="pa-2 labelCustomColor" @bind-Value="customer.Remarks_sale"
                                                    AdornmentColor="@ColorTextFields"
                                                    Immediate="true" AutoGrow
                                                    InputType="InputType.Text"
                                                    Pattern="[0-9,]*"
                                                    OnBlur="@(() => FormatRemarksSale(customer.Remarks_sale))"
                                                    Label="@Localizer["Limit/VND"]" />
                                                </MudItem>
                                                <MudItem xs="6" Class="py-0">
                                                    <MudCard Style="background-color: lightcyan;" Class="border border-solid mud-border-primary pa-2">
                                                        <MudCardContent Class="pa-2">
                                                            <MudGrid Spacing="1">
                                                                <MudItem xs="8" Class="py-0">
                                                                    <MudSelect Class="pl-2 labelCustomColor" @bind-Value="selectedItem"
                                                                    T="string"
                                                                    AdornmentColor="@ColorTextFields"
                                                                    Immediate="true"
                                                                    Label=@Localizer["Choose"]>
                                                                        <MudSelectItem Value=@("AirLines")>Air Lines</MudSelectItem>
                                                                        <MudSelectItem Value=@("Agent-Network")>Agent-Network</MudSelectItem>
                                                                        <MudSelectItem Value=@("Customer")>Customer</MudSelectItem>
                                                                        <MudSelectItem Value=@("Vendor")>Vendor</MudSelectItem>
                                                                        <MudSelectItem Value=@("Shipping")>Shipping</MudSelectItem>
                                                                        <MudSelectItem Value=@("Trucking")>Trucking</MudSelectItem>
                                                                        <MudSelectItem Value=@("Romooc")>Romooc</MudSelectItem>
                                                                        <MudSelectItem Value=@("Personal")>Personal</MudSelectItem>
                                                                        <MudSelectItem Value=@("Others")>Others</MudSelectItem>
                                                                        <MudSelectItem Value=@("MovingPartner")>Moving-Partner</MudSelectItem>
                                                                        <MudSelectItem Value=@("MasterColoader")>Master Coloader</MudSelectItem>
                                                                        <MudSelectItem Value=@("LogisticsPartner")>Logistics Partner</MudSelectItem>
                                                                    </MudSelect>
                                                                </MudItem>
                                                                <MudItem xs="4" Class="py-0">
                                                                    <MudButton Class="custom-button pa-2 mt-2" Variant="Variant.Filled" Size="Size.Small" Color="Color.Tertiary" OnClick="addMainCode">>>></MudButton>
                                                                </MudItem>
                                                            </MudGrid>
                                                            <MudTextField Class="pa-2 labelCustomColor" @bind-Value="customer.MainCode"
                                                            For="@(() => customer.MainCode)" Lines="2"
                                                            AdornmentColor="@ColorTextFields" Required
                                                            Immediate="true" AutoGrow Label="@Localizer["MainCode"]" />

                                                        </MudCardContent>
                                                    </MudCard>

                                                </MudItem>
                                                <MudItem xs="6" Style="display:flex" Class="py-0">
                                                    <MudGrid Spacing="2">
                                                        <MudItem xs="6" Class="py-0">
                                                            <MudTextField Class="pa-2 labelCustomColor" @bind-Value="customer.giatri"
                                                            AdornmentColor="@ColorTextFields" OnBlur="@(()=> FomatNumbergiatri(customer.giatri))"
                                                            Immediate="true" AutoGrow
                                                            Label=@Localizer["Exchange USD" ]/>
                                                        </MudItem>
                                                        <MudItem xs="6" Class="py-0">
                                                            <MudTextField Class="pa-2 labelCustomColor" @bind-Value="customer.phuphicourier"
                                                            For="@(() => customer.phuphicourier)"
                                                            AdornmentColor="@ColorTextFields"
                                                            Immediate="true" AutoGrow
                                                            Label=@Localizer["% Fuel" ]/>
                                                        </MudItem>
                                                        <MudItem xs="6" Class="py-0">
                                                            <MudTextField Class="pa-2 labelCustomColor" @bind-Value="customer.hancongno"
                                                            For="@(() => customer.hancongno)"
                                                            AdornmentColor="@ColorTextFields"
                                                            Immediate="true" AutoGrow
                                                            Label=@Localizer["Debt"] />
                                                        </MudItem>
                                                        <MudItem xs="6" Class="py-0">
                                                            <MudSelect Class="pa-2 labelCustomColor" @bind-Value="customer.freetime"
                                                            AdornmentColor="@ColorTextFields"
                                                            Immediate="true"
                                                            Label=@Localizer["Free time"]>
                                                                <MudSelectItem Value=@(new bool?(true))>True</MudSelectItem>
                                                                <MudSelectItem Value=@(new bool?(false))>False</MudSelectItem>

                                                            </MudSelect>
                                                        </MudItem>

                                                    </MudGrid>
                                                </MudItem>
                                                <MudItem xs="3" Class="py-0">
                                                    <MudNumericField Class="pa-2 labelCustomColor" @bind-Value="customer.PriceDEM"
                                                    For="@(() => customer.PriceDEM)" Format="#,##0"
                                                    AdornmentColor="@ColorTextFields"
                                                    Immediate="true"
                                                    Label=@Localizer["PriceDEM"] />
                                                </MudItem>
                                                <MudItem xs="3" Class="py-0">
                                                    <MudNumericField Class="pa-2 labelCustomColor" @bind-Value="customer.PriceDET"
                                                    For="@(() => customer.PriceDET)" Format="#,##0"
                                                    AdornmentColor="@ColorTextFields"
                                                    Immediate="true"
                                                    Label=@Localizer["PriceDET"] />
                                                </MudItem>
                                                @* <MudItem xs="6">
                                                    <MudSelect Class="pa-4 labelCustomColor" @bind-Value="customer.kpis"
                                                    For="@(() => customer.kpis)"
                                                    AdornmentColor="@ColorTextFields"
                                                    Immediate="true"
                                                    Label="Status">
                                                        <MudSelectItem Value=@("Regular")>Regular</MudSelectItem>
                                                        <MudSelectItem Value=@("Vip")>Vip</MudSelectItem>
                                                        <MudSelectItem Value=@("Potential")>Potential</MudSelectItem>
                                                        <MudSelectItem Value=@("OneTime")>OneTime</MudSelectItem>
                                                        <MudSelectItem Value=@("Zero")>Zero</MudSelectItem>
                                                        <MudSelectItem Value=@("Lost")>Lost</MudSelectItem>
                                                        <MudSelectItem Value=@("Other")>Other</MudSelectItem>
                                                        <MudSelectItem Value=@("")></MudSelectItem>
                                                    </MudSelect>
                                                </MudItem> *@
                                                <MudItem xs="6" Class="py-0">
                                                    <MudSelect Class="pa-2 labelCustomColor" @bind-Value="customer.status" Label=@Localizer["status"] >
                                                        @foreach (var item in trangthais)
                                                        {
                                                            <MudSelectItem Value="item">@item</MudSelectItem>
                                                        }
                                                    </MudSelect>
                                                </MudItem>
                                            </MudGrid>
                                        </MudItem>
                                    </MudGrid>
                                </MudCardContent>
                            </MudTabs>
                        </MudTabPanel>
                        <MudTabPanel Text="Base Info (2)">
                            <MudTabs Elevation="1" Rounded="true" Color="Color.Tertiary">
                                <MudGrid Spacing="1" Class="pa-1">
