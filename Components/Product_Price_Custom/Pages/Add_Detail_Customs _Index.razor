    async Task DeleteItemDebitInfo(M_Product_Price_detail_ALL item)
    {
        if (item == null)
        {
            CallSnackBar("you must select 1 row.", MudBlazor.Severity.Warning);
            return;
        }
        if (item.Approve == true)
        {
            CallSnackBar("Data đã được Approve!!! , vui lòng bỏ Approve", MudBlazor.Severity.Warning);
            return;
        }
        var resultMess = await DialogService.ShowMessageBox(
                "Warning",
                "Deleting can not be undone!",
                yesText: "Delete!", cancelText: "Cancel");

        if (resultMess.HasValue)
        {
            var rs = await prsv.DeletepRODUCTdETAILS_Truck(item);
            CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
            await RefreshInfo();
        }

    }

    string ItemidtoChargeName(Guid? itemid)
    {
        if (itemid == null || itemid == Guid.Empty)
            return string.Empty;
        var rs = charges.FirstOrDefault(x => x.CHARGE_ID == itemid);
        return rs == null ? string.Empty : rs.CHARGE!;
    }

    private async Task FilterCharge()
    {

        if (string.IsNullOrWhiteSpace(searchText_item))
        {
            filteredCharges = charges;
        }
        else
        {
            filteredCharges = charges.Where(x => x.CHARGE != null)
                .Where(c => c.CHARGE_CODE.Contains(searchText_item, StringComparison.OrdinalIgnoreCase) ||
                            c.CHARGE.Contains(searchText_item, StringComparison.OrdinalIgnoreCase))
                .ToList();
        }

        await InvokeAsync(StateHasChanged); // Cập nhật giao diện
    }

    private string GetChargeLabel(Guid? id)
    {
        var customer = charges.FirstOrDefault(x => x.CHARGE_ID == id);
        return customer != null ? customer.CHARGE : string.Empty;
    }

    private async Task<IEnumerable<Guid?>> Search_Charge(string value)
    {
        if (string.IsNullOrEmpty(value))
            return charges.Select(x => (Guid?)x.CHARGE_ID);

        return charges
            .Where(x => (x.CHARGE).Contains(value, StringComparison.InvariantCultureIgnoreCase))
            .Select(x => (Guid?)x.CHARGE_ID);
    }

    private async Task OnApproveCheckboxWrapper(M_Product_Price_detail_ALL item)
    {
        if (await ssv.CheckPermission(asv.GetAuth().Result.User.Identity.Name, "Approve", "Product_Price_KTCL"))
        {
            var rs = await prsv.UpdateCreateProduct_Detail_truck(item);
            MudBlazor.Severity severity;
            if (rs[1] == "1")
                severity = MudBlazor.Severity.Success;
            else
                severity = MudBlazor.Severity.Error;

            CallSnackBar(rs[0], severity);

        }
        else
        {
            CallSnackBar("You have not access to Approve", MudBlazor.Severity.Warning);
            return;
        }

    }
    void RowClicked(DataGridRowClickEventArgs<M_Product_Price_detail_ALL> args)
    {
        detail = args.Item;
    }
