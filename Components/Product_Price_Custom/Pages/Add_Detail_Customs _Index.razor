@inject IStringLocalizer<SharedResource> Localizer
@inject SupportServices supsv
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject FontService FontSizeService
@inject IStringLocalizer<SharedResource> Localizer

<style>
    .text-right input {
        text-align: right !important;
    }

    .custom-right-align {
        text-align: right !important;
    }
</style>



<MudDataGrid T="M_Product_Price_detail_ALL" Items="@listTruck.ToList()" Filterable="true" @ref="muddetails" Style="background-color: lightblue;"
             FilterMode="@DataGridFilterMode.Simple" Dense="true" Virtualize="true"
             FixedHeader="true" FixedFooter="true" HeaderClass="no-wrap" FooterClass="no-wrap"
             ReadOnly="false" RowClick="@RowClicked" CommittedItemChanges="@CommittedItemDebitInfo"
             ColumnResizeMode="@(_resizeColumn ? ResizeMode.Column : ResizeMode.Container)">
    <Columns>

        <PropertyColumn Property="x => x.Ngaybaogia" Title="@Localizer["NgayBaoGia"]" Format="dd/MM/yyyy">
            <EditTemplate>
                <MudDatePicker Class="custom-label" @bind-Date="context.Item.Ngaybaogia"
                               For="@(() => context.Item.Ngaybaogia)"
                               Label="@Localizer["NgayBaoGia"]"
                               DateFormat="dd/MM/yyyy"
                               Required="true" />

            </EditTemplate>
        </PropertyColumn>

        <PropertyColumn Property="x => ItemidtoChargeName(x.Itemid)" Title="@Localizer["Item"]" Required="false">
            <EditTemplate>
                <MudAutocomplete T="Guid?" Label="@Localizer["Item"]" Class="custom-label"
                                 @bind-Value="context.Item.Itemid"
                                 Required="true"
                                 SearchFunc="Search_Charge"
                                 ToStringFunc="GetChargeLabel" />

            </EditTemplate>
        </PropertyColumn>

        <PropertyColumn Property="x => x.Dongia" Title="@Localizer["unitprice"]" Format="#,##0" CellClass="custom-right-align" Required="false">
            <EditTemplate>
                <MudNumericField @bind-Value="context.Item.Dongia"
                                 Label="@Localizer["unitprice"]" Format="#,##0.##" Culture="@_en" T="double?"
                                 Class="text-right  custom-label" />

            </EditTemplate>
        </PropertyColumn>


        <PropertyColumn Property="x => x.Vat" Title="@Localizer["vat"]" Format="#,##0" CellClass="custom-right-align" Required="false">
            <EditTemplate>
                <MudNumericField @bind-Value="context.Item.Vat"
                                 Label="@Localizer["vat"]" Format="#,##0.##" Culture="@_en" T="double?"
                                 Class="text-right  custom-label" />

            </EditTemplate>
        </PropertyColumn>

        <PropertyColumn Property="x => x.Thanhtien" Title="@Localizer["ThanhTien"]" Format="#,##0" CellClass="custom-right-align" Required="false">
            <EditTemplate>
                <MudNumericField @bind-Value="context.Item.Thanhtien"
                                 Label="@Localizer["ThanhTien"]" Format="#,##0.##" Culture="@_en" T="double?"
                                 Class="text-right  custom-label" />

            </EditTemplate>
        </PropertyColumn>

        <PropertyColumn Property="x => x.Cur" Title="@Localizer["Loaitiente"]" Required="false">
            <EditTemplate>
                <MudSelect @bind-Value="context.Item.Cur" Label="@Localizer["Loaitiente"]" Class="custom-label">
                    <MudSelectItem Value="@("VND")">VND</MudSelectItem>
                    <MudSelectItem Value="@("USD")">USD</MudSelectItem>
                </MudSelect>
            </EditTemplate>
        </PropertyColumn>

        <PropertyColumn Property="x => x.Tigia" Title="@Localizer["tigia"]" Format="#,##0.##" CellClass="custom-right-align" Required="false">
            <EditTemplate>
                <MudNumericField @bind-Value="context.Item.Tigia"
                                 Label="@Localizer["tigia"]" Format="#,##0.##" Culture="@_en" T="double?" Required="true" HideSpinButtons="true"
                                 Class="text-right  custom-label" />

            </EditTemplate>
        </PropertyColumn>

        <PropertyColumn Property="x => x.loaicont" Title="@Localizer["Cont. Size Type"]" Required="false">
        </PropertyColumn>

        <PropertyColumn Property="x => x.Dieukhoanthanhtoan" Title="@Localizer["dieukhoanthanhtoan"]" Required="false">
            <EditTemplate>
                <MudTextField @bind-Value="context.Item.Dieukhoanthanhtoan" Label="@Localizer["dieukhoanthanhtoan"]" Class="custom-label" />

            </EditTemplate>
        </PropertyColumn>

        <TemplateColumn Title="@Localizer["Approve"]">
            <CellTemplate>
                <MudCheckBox @bind-Checked="context.Item.Approve" @bind-Value="context.Item.Approve" @bind-Value:after="@(()=> OnApproveCheckboxWrapper(context.Item))">
                </MudCheckBox>
            </CellTemplate>

            <EditTemplate>
                <MudCheckBox @bind-Value="context.Item.Approve" Label="@Localizer["Approve"]" Class="custom-label" />
            </EditTemplate>
        </TemplateColumn>

        <PropertyColumn Property="x=>x.Createat" Title="@Localizer["CreatedAt"]" Class="custom-label" IsEditable="false">
        </PropertyColumn>

        <PropertyColumn Property="x=>x.Usercreate" Title="@Localizer["Nguoilap"]" Class="custom-label" IsEditable="false">
        </PropertyColumn>


    </Columns>
</MudDataGrid>

@code {
