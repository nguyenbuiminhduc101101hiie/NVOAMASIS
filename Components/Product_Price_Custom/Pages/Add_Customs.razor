@using System.Globalization
@inject ISnackbar Snackbar
@inject AccountService asv
@inject TrainScheduleServices trainsv
@inject IStringLocalizer<SharedResource> Localizer
@inject SharedServices ssv
@inject LocalChargesServices lcsv
@inject SupportServices supsv
@inject LenhDieuXeServices ldxsv
@inject TKHQ_Services tkhqsv
@inject GlobalServices gsv
@inject Bieugianangha_Services BGRRsv
@inject CustomerService CusSV
@inject DNTUServices DNTUSV
@inject BookingService Bksv
@inject ShipmentService shipmentsv
@inject NavigationManager NavigationManager
@inject ProductPriceServices prsv
@inject NotificationService _notificationService
@inject IJSRuntime JSRuntime

<style>
    .customs-dialog-shell {
        background: linear-gradient(180deg, #f8fbff 0%, #f3f7fb 100%);
        padding: 12px;
    }

    .customs-dialog-card {
        border-radius: 18px;
        border: 1px solid rgba(17, 138, 178, .16);
        background: #ffffff;
        box-shadow: 0 12px 32px rgba(15, 23, 42, .09);
        overflow: hidden;
    }

    .customs-dialog-header {
        padding: 14px 16px;
        background: linear-gradient(180deg, #ffffff 0%, #f8fafc 100%);
        border-bottom: 1px solid #e2e8f0;
    }

    .customs-dialog-title {
        color: #0f3557;
        font-weight: 800 !important;
        letter-spacing: .2px;
    }

    .customs-dialog-subtitle {
        color: #64748b;
        font-size: 12px;
        margin-top: 2px;
    }

    .customs-dialog-body {
        padding: 14px;
    }

    .customs-section {
        border-radius: 16px;
        border: 1px solid #e2e8f0;
        background: #ffffff;
        padding: 12px;
        margin-bottom: 12px;
    }

    .customs-section-title {
        color: #0f3557;
        font-weight: 800 !important;
        margin-bottom: 8px;
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .customs-ref-button {
        border-radius: 999px !important;
        min-width: 48px;
        height: 32px;
        font-weight: 800;
        box-shadow: 0 4px 12px rgba(15, 23, 42, .08);
    }

    .customs-user-add-button {
        border-radius: 999px !important;
        min-width: 48px;
        height: 32px;
        font-weight: 800;
        box-shadow: 0 4px 12px rgba(15, 23, 42, .08);
    }

    .customs-action-button {
        border-radius: 999px !important;
        min-height: 32px;
        font-weight: 700;
        text-transform: none;
        box-shadow: 0 4px 12px rgba(15, 23, 42, .08);
    }

    .customs-dialog-actions {
        padding: 10px 16px 14px 16px;
        background: #f8fafc;
        border-top: 1px solid #e2e8f0;
    }

        .customs-dialog-actions .mud-button-root {
            border-radius: 999px !important;
            min-width: 90px;
            font-weight: 800;
            text-transform: none;
        }

    .labelCustomColor label,
    .custom-label .mud-input-label {
        font-weight: 700;
        color: #118AB2 !important;
    }

    .custom-label .mud-input-root,
    .custom-label .mud-input-control,
    .custom-label input,
    .custom-label textarea {
        font-size: 13px !important;
    }

    .class-dialog-custom {
        backdrop-filter: blur(10px);
        transition: none !important;
        animation: none !important;
    }
</style>

<MudDialog>
    <DialogContent>
        <MudContainer MaxWidth="MaxWidth.False" Class="customs-dialog-shell">
            <MudCard Elevation="0" Class="customs-dialog-card">
                <div class="customs-dialog-header">
                    <MudText Typo="Typo.h6" Class="customs-dialog-title">
                        @Localizer["Customs_clearance_price"]
                    </MudText>
                    <MudText Class="customs-dialog-subtitle">
                        Customs procedure cost price / thông tin báo giá thủ tục hải quan
                    </MudText>
                </div>

                <MudForm Model="@_ProductPrice_Customs_Details" @ref="@form">
                    <MudCardContent Class="customs-dialog-body">
                        <div class="customs-section">
                            <MudText Typo="Typo.subtitle2" Class="customs-section-title">
                                <MudIcon Icon="@Icons.Material.Filled.Description" Size="Size.Small" />
                                RFQ Information
                            </MudText>

                            <MudGrid Spacing="2">
                                <MudItem xs="12" sm="1" Class="d-flex align-end">
                                    <MudButton Class="customs-ref-button"
                                               Size="Size.Small"
                                               Color="Color.Primary"
                                               Variant="Variant.Filled"
                                               Disabled="@(Status == "edit")"
                                               OnClick="() => Get_BGNHNo()">
                                        >>>
                                    </MudButton>
                                </MudItem>

                                <MudItem xs="12" sm="5">
                                    <MudTextField @bind-Value="_ProductPrice_Customs_Details.MaRFQ"
                                                  Disabled="true"
                                                  Label="@Localizer["MaRFQ"]"
                                                  Class="custom-label"
                                                  Margin="Margin.Dense"
                                                  Required="true" />
                                </MudItem>

                                <MudItem xs="12" sm="6">
                                    <MudDatePicker Class="custom-label"
                                                   @bind-Date="_ProductPrice_Customs_Details.NgayYeuCau"
                                                   For="@(() => _ProductPrice_Customs_Details.NgayYeuCau)"
                                                   Label="@Localizer["Ngayguiyeucau"]"
                                                   Margin="Margin.Dense"
                                                   DateFormat="dd/MM/yyyy"
                                                   Required="true" />
                                </MudItem>

                                <MudItem xs="12" sm="4">
                                    <MudTextField @bind-Value="_ProductPrice_Customs_Details.Loaihang"
                                                  Label="@Localizer["TenHang_gs"]"
                                                  Class="custom-label"
                                                  Margin="Margin.Dense" />
                                </MudItem>

                                <MudItem xs="12" sm="4">
                                    <MudAutocomplete @bind-Value="_ProductPrice_Customs_Details.Loaihinh"
                                                     Label="@Localizer["Loaihinh"]"
                                                     Class="custom-label"
                                                     Margin="Margin.Dense"
                                                     CoerceValue
                                                     SearchFunc="SearchType" />
                                </MudItem>

                                <MudItem xs="12" sm="4">
                                    <MudTextField @bind-Value="_ProductPrice_Customs_Details.Noidung"
                                                  Label="@Localizer["noidung"]"
                                                  Class="custom-label"
                                                  Margin="Margin.Dense" />
                                </MudItem>

                                <MudItem xs="12" sm="4">
                                    <MudSelect @bind-Value="_ProductPrice_Customs_Details.Trangthai"
                                               Label="@Localizer["status"]"
                                               Class="custom-label"
                                               Margin="Margin.Dense">
                                        @foreach (var item in trangthais)
                                        {
                                            <MudSelectItem Value="@item">@item</MudSelectItem>
                                        }
                                    </MudSelect>
                                </MudItem>
                            </MudGrid>
                        </div>

                        <div class="customs-section">
                            <MudText Typo="Typo.subtitle2" Class="customs-section-title">
                                <MudIcon Icon="@Icons.Material.Filled.PersonAdd" Size="Size.Small" />
                                @Localizer["User"] / User Nhận Email
                            </MudText>

                            <MudGrid Spacing="2">
                                <MudItem xs="12" md="4">
                                    <MudAutocomplete Class="custom-label" T="string"
                                                     @bind-Value="UserHanding"
                                                     Label="@Localizer["User"]"
                                                     Margin="Margin.Dense"
                                                     SearchFunc="Search_User"
                                                     Immediate="true"
                                                     CoerceText="true"
                                                     Clearable="true"
                                                     MaxItems="100" />
                                </MudItem>

                                <MudItem xs="12" md="1" Class="d-flex align-end">
                                    <MudButton Class="customs-user-add-button"
                                               Size="Size.Small"
                                               Color="Color.Primary"
                                               Variant="Variant.Filled"
                                               OnClick="() => Getuser(_ProductPrice_Customs_Details)">
                                        >>>
                                    </MudButton>
                                </MudItem>

                                <MudItem xs="12" md="7">
                                    <MudTextField @bind-Value="_ProductPrice_Customs_Details.Userhandle"
                                                  Class="custom-label"
                                                  Margin="Margin.Dense"
                                                  HelperTextOnFocus
                                                  HelperText="từ 2 mail trở lên vui lòng ngăn cách bằng dấu ','"
                                                  Lines="2"
                                                  AutoGrow
                                                  Label="@Localizer["EmailRecipient"]"
                                                  Required="false" />
                                </MudItem>

                                <MudItem xs="12">
                                    <MudStack Row="true" Spacing="1" Justify="Justify.FlexEnd" Class="flex-wrap">
                                        <MudButton HtmlTag="label"
                                                   Disabled="_processingUpload"
                                                   Class="customs-action-button"
                                                   @onclick="@(() => SendMailnotify(_ProductPrice_Customs_Details))"
                                                   Size="Size.Small"
                                                   Color="Color.Tertiary"
                                                   Variant="Variant.Filled"
                                                   StartIcon="@Icons.Material.Filled.Email">
                                            @if (_processingUpload)
                                            {
                                                <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                                                <MudText Class="ms-2">Processing</MudText>
                                            }
                                            else
                                            {
                                                <MudText>@Localizer["sendemail"]</MudText>
                                            }
                                        </MudButton>

                                        <MudButton HtmlTag="label"
                                                   Disabled="_processingUpload_message"
                                                   Class="customs-action-button"
                                                   @onclick="@(() => SendMessage(_ProductPrice_Customs_Details))"
                                                   Size="Size.Small"
                                                   Color="Color.Tertiary"
                                                   Variant="Variant.Filled"
                                                   StartIcon="@Icons.Material.Filled.NotificationsActive">
                                            @if (_processingUpload_message)
                                            {
                                                <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                                                <MudText Class="ms-2">Processing</MudText>
                                            }
                                            else
                                            {
                                                <MudText>@Localizer["message"]</MudText>
                                            }
                                        </MudButton>
                                    </MudStack>
                                </MudItem>
                            </MudGrid>
                        </div>
                    </MudCardContent>
                </MudForm>
            </MudCard>
        </MudContainer>
    </DialogContent>

    <DialogActions>
        <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="1" Class="customs-dialog-actions w-100">
            <MudButton OnClick="@(async () => await Submit())"
                       Color="Color.Primary"
                       Variant="Variant.Filled"
                       StartIcon="@Icons.Material.Filled.Save">
                Save
            </MudButton>

            <MudButton OnClick="Cancel"
                       Color="Color.Default"
                       Variant="Variant.Outlined"
                       StartIcon="@Icons.Material.Filled.Close">
                Cancel
            </MudButton>
        </MudStack>
    </DialogActions>
</MudDialog>


@code {
    [CascadingParameter] MudDialogInstance? MudDialog { get; set; }
    [Parameter] public Models.M_CustomCostRequest _ProductPrice_Customs_Details { get; set; }
    [Parameter] public string Status { get; set; }
    List<PortModel> Ports = new List<PortModel>();
    List<string> trangthais = new List<string>();
    private List<Models.TrangThai> M_Trangthais = new List<Models.TrangThai>();
    public CultureInfo _en = CultureInfo.GetCultureInfo("en-US");
    List<M_CustomCostRequest> ImportCosts = new List<M_CustomCostRequest>();
    public string? UserHanding;
    MudForm form;
    private List<string> ListUser { get; set; } = new List<string>();

    List<string> List_Incoterm = new List<string>
    {
        "EXW-Giao hàng tại xưởng-người mua chịu toàn bộ chi phí và rủi ro",
        "FOB-Giao lên tàu-người bán chịu chi phí đến cảng xuất khẩu",
        "CIF-Người bán chịu chi phí + bảo hiểm đến cảng nhập khẩu",
        "DDP-Giao đã nộp thuế-người bán lo chi phí đến tận nơi mua",
        "FCA-Giao cho người vận chuyển chị định",
        "CPT-Cước phí trả tới nơi-người bán trả cước vận chuyển"
    };

    List<string> List_Type = new List<string>
    {
        "FCL",
        "LCL",
        "AIR Air Freight",
        "EXPRESS",
        "TRUCK",
        "WAREHOUSE",
        "CUSTOMS",
        "DOOR",
        "PROJECT",
        "OTHERS"
    };

    protected async override Task OnInitializedAsync()
    {
        if (Status == "Duplicate")
        {
            _ProductPrice_Customs_Details.MaRFQ = "";
            _ProductPrice_Customs_Details.Id = Guid.Empty;
            _ProductPrice_Customs_Details.Approve = false;
            _ProductPrice_Customs_Details.Continued = true;
            _ProductPrice_Customs_Details.Editable = true;
        }
        Ports = await Bksv.GetList_PORT();
        M_Trangthais = await supsv.GetListTrangThai();
        var tts = await supsv.GetListTrangThai();
        trangthais = tts.Where(x => x.Tieude == "ProductPrice").OrderBy(x => x.Noidung).Select(x => x.Noidung).ToList();
        // ImportCosts = await prsv.GetProduct_Price_import();
        ListUser = await asv.GetList_User_handle() ?? new List<string>();
    }

    private async Task<IEnumerable<string>> SearchPorts(string text)
    {
        try
        {
            if (string.IsNullOrWhiteSpace(text))
            {
                return Ports
                    .Where(x => !string.IsNullOrEmpty(x.PORT))
                    .Select(x => x.PORT)
                    .Distinct();
            }

            return Ports
                .Where(x => !string.IsNullOrEmpty(x.PORT) &&
                            x.PORT.Contains(text, StringComparison.OrdinalIgnoreCase))
                .Select(x => x.PORT)
                .Distinct();
        }
        catch (Exception)
        {
            throw;
        }
    }

    private async Task Submit()
    {
        await form.Validate();

        if (form.IsValid)
        {
            var UserName = asv.GetAuth().Result.User.Identity!.Name!;
            if (Status == "add")
            {
                _ProductPrice_Customs_Details.CreateAt = DateTime.Now.ToString();
                _ProductPrice_Customs_Details.UserCreate = UserName;
                _ProductPrice_Customs_Details.Approve = false;
                _ProductPrice_Customs_Details.Continued = true;
                _ProductPrice_Customs_Details.Editable = true;
            }

            _ProductPrice_Customs_Details.DateUpdate = DateTime.Now.ToString();
            _ProductPrice_Customs_Details.UserUpdate = UserName;
            MudDialog!.Close(_ProductPrice_Customs_Details);


        }

    }
    void Cancel() => MudDialog.Cancel();

    void CallSnackBar(string message, MudBlazor.Severity severity)
    {

        Snackbar.Configuration.SnackbarVariant = Variant.Filled;
        Snackbar.Configuration.MaxDisplayedSnackbars = 3;
        Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopRight;
        Snackbar.Add(message, severity);
    }
    // private async Task<IEnumerable<string?>> SearchUnit(string? text)
    // {
    //     try
    //     {
    //         var items = ImportCosts.Select(x => x.Donvitinh).Distinct();
    //         if (string.IsNullOrEmpty(text))
    //         {
    //             return items;
    //         }
    //         // MBL.Porname = mst_Consignee;
    //         return items.Where(x => x != null && x.Equals(text));
    //     }
    //     catch (Exception)
    //     {
    //         throw;
    //     }
    // }
    private async Task Get_BGNHNo()
    {

        int formattedYear = DateTime.Now.Year;
        int formattedMonth = DateTime.Now.Month;

        string usr = asv.GetAuth().Result.User.Identity!.Name!;
        var refno = await supsv.GetRefNoByFunc("ProductPrice_Customs", formattedMonth, formattedYear, usr);

        var rs = asv.GetUserDetail();
        var cn = rs.Branch;
        _ProductPrice_Customs_Details.MaRFQ = cn + "PR_Customs_" + formattedYear.ToString() + formattedMonth.ToString() + refno.Value.ToString("D4");
    }
    private async Task<IEnumerable<string?>> SearchIncoterm(string? text)
    {
        try
        {
            var items = List_Incoterm.Distinct();
            if (string.IsNullOrWhiteSpace(text))
            {
                return items;
            }

            return items.Where(x => x != null && x.Contains(text, StringComparison.OrdinalIgnoreCase));
        }
        catch (Exception)
        {
            throw;
        }
    }
    private async Task<IEnumerable<string?>> SearchType(string? text)
    {
        try
        {
            var items = List_Type.Distinct();
            if (string.IsNullOrWhiteSpace(text))
            {
                return items;
            }

            return items.Where(x => x != null && x.Contains(text, StringComparison.OrdinalIgnoreCase));
        }
        catch (Exception)
        {
            throw;
        }
    }

    private async Task<IEnumerable<string>> Search_User(string value)
    {
        if (string.IsNullOrEmpty(value))
            return ListUser;

        return ListUser.Where(x => x.Contains(value, StringComparison.InvariantCultureIgnoreCase));
    }

    private async Task Getuser(M_CustomCostRequest item)
    {
        if (string.IsNullOrEmpty(item.Userhandle))
        {
            item.Userhandle = UserHanding;
        }
        else
        {
            item.Userhandle += "," + UserHanding + ",";
        }
    }

    private bool _processingUpload = false;
    async Task SendMailnotify(M_CustomCostRequest item)
    {
        try
        {
            string[] users = item.Userhandle.Split(',');
            List<string> emails = new List<string>(); // Danh sách động, có thể thêm thoải mái

            int index = 0;
            foreach (var user in users)
            {
                if (string.IsNullOrEmpty(user))
                {

                }
                else
                {
                    string inputemail = "";
                    inputemail = await gsv.GetEmailAsync(user);
                    if (!string.IsNullOrEmpty(inputemail))
                    {
                        emails.Add(inputemail);
                    }

                }
            }
            string[] emailarray = emails.ToArray();
            _processingUpload = true;
            await Task.Delay(1);
            StateHasChanged();

            if (emails != null && emailarray.Length > 0)
            {

                var rs = await gsv.GuiThongBaoProject_product_price_Customs(item, emailarray);

                CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);

            }
            else
            {

                CallSnackBar(Localizer["EmailEmpty"], MudBlazor.Severity.Warning);
                return;
            }


        }
        catch (Exception ex)
        {
            CallSnackBar(string.Format(Localizer["SomethingWentWrong"], ex.Message), MudBlazor.Severity.Error);
        }
        finally
        {
            _processingUpload = false;
        }

    }

    private bool _processingUpload_message = false;
    async Task SendMessage(M_CustomCostRequest item)
    {
        try
        {
            string[] users = item.Userhandle.Split(',');
            List<string> listid = new List<string?>(); // Danh sách động, có thể thêm thoải mái

            int index = 0;
            foreach (var user in users)
            {
                if (string.IsNullOrEmpty(user))
                {

                }
                else
                {

                    Guid? inputid = await gsv.GetIdfromUser(user);
                    if (inputid != null)
                    {
                        listid.Add(inputid.ToString());
                    }

                }
            }
            string[] Idarray = listid.ToArray();
            _processingUpload_message = true;
            await Task.Delay(1);
            StateHasChanged();
            string noidung = "Cost Request Quality Control FRQ No:" + item.MaRFQ;
            if (listid != null && Idarray.Length > 0)
            {
                await _notificationService.SendNotificationAsync(Idarray, noidung);


            }
            else
            {

                CallSnackBar(Localizer["UserEmpty"], MudBlazor.Severity.Warning);
                return;
            }

        }
        catch (Exception ex)
        {
            CallSnackBar(string.Format(Localizer["SomethingWentWrong"], ex.Message), MudBlazor.Severity.Error);
        }
        finally
        {
            _processingUpload_message = false;
        }
    }

}
