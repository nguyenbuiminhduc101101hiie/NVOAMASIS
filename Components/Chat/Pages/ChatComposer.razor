@using NVOAMASIS.Models.Chat
@using NVOAMASIS.Services.Chat
@implements IDisposable
@inject IJSRuntime JS
@inject IStringLocalizer<SharedResource> Localizer
@inject ISnackbar Snackbar

@if (ReplyTo is { } reply)
{
    <div class="chat-replying">
        <MudIcon Icon="@Icons.Material.Filled.Reply" Size="Size.Small" Color="Color.Primary" />
        <div class="chat-replying__body">
            <MudText Typo="Typo.caption">@Localizer["chat_replying_to"] <b>@reply.SenderName</b></MudText>
            <div class="chat-replying__text">@(reply.HasAttachment ? "📎 " + reply.AttachmentName : reply.Text)</div>
        </div>
        <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" Title="@Localizer["chat_cancel"]" OnClick="OnCancelReply" />
    </div>
}
<div class="chat-composer">
    <InputFile id="@_fileInputId" class="chat-composer__file" OnChange="OnFileSelected" disabled="@(Disabled || _uploading)" />
    @if (_uploading)
    {
        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="ma-2" />
    }
    else
    {
        <MudIconButton HtmlTag="label" for="@_fileInputId" Icon="@Icons.Material.Filled.AttachFile"
                       Disabled="Disabled" Title="@Localizer["chat_attach"]" />
    }
    <textarea @ref="_textarea" rows="1" maxlength="@ChatService.MaxTextLength" disabled="@Disabled"
              placeholder="@Localizer["chat_input_placeholder"]"
              value="@_text" @oninput="OnInput"></textarea>
    <MudIconButton Icon="@Icons.Material.Filled.Send" Color="Color.Primary"
                   Disabled="@(Disabled || _sending || string.IsNullOrWhiteSpace(_text))"
                   OnClick="SubmitAsync" Title="@Localizer["chat_send"]" />
</div>

@code {
    private static readonly TimeSpan TypingThrottle = TimeSpan.FromSeconds(2);

    [Parameter] public bool Disabled { get; set; }

    /// <summary>Trả về true nếu gửi thành công (khi đó ô nhập được xoá).</summary>
    [Parameter, EditorRequired] public Func<string, Task<bool>> OnSend { get; set; } = default!;

    [Parameter, EditorRequired] public Func<IBrowserFile, Task> OnFile { get; set; } = default!;
    [Parameter] public Func<Task>? OnTyping { get; set; }

    /// <summary>Tin đang được trả lời (ChatIndex giữ state và xoá sau khi gửi thành công).</summary>
    [Parameter] public ChatMessageDto? ReplyTo { get; set; }
    [Parameter] public EventCallback OnCancelReply { get; set; }

    private readonly string _fileInputId = $"chat-file-{Guid.NewGuid():N}";
    private ElementReference _textarea;
    private DotNetObjectReference<ChatComposer>? _selfRef;
    private string _text = "";
    private bool _sending;
    private bool _uploading;
    private DateTime _lastTypingSent = DateTime.MinValue;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;
        _selfRef = DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("nvoChat.attachComposer", _textarea, _selfRef);
    }

    public ValueTask FocusAsync() => JS.InvokeVoidAsync("nvoChat.focus", _textarea);

    [JSInvokable]
    public Task SubmitFromKeyboard() => InvokeAsync(SubmitAsync);

    private async Task OnInput(ChangeEventArgs e)
    {
        _text = e.Value?.ToString() ?? "";
        if (OnTyping is null || string.IsNullOrWhiteSpace(_text) || DateTime.UtcNow - _lastTypingSent < TypingThrottle)
            return;
        _lastTypingSent = DateTime.UtcNow;
        await OnTyping();
    }

    private async Task SubmitAsync()
    {
        if (Disabled || _sending || string.IsNullOrWhiteSpace(_text))
            return;

        _sending = true;
        try
        {
            // Lỗi → giữ nguyên nội dung để người dùng gửi lại.
            if (await OnSend(_text))
            {
                _text = "";
                _lastTypingSent = DateTime.MinValue;
                await JS.InvokeVoidAsync("nvoChat.resetComposer", _textarea);
            }
        }
        finally
        {
            _sending = false;
            StateHasChanged();
        }
    }

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file.Size > ChatFileStorage.MaxAttachmentBytes)
        {
            Snackbar.Add(Localizer["chat_attachment_too_large"], Severity.Warning);
            return;
        }

        _uploading = true;
        StateHasChanged();
        try
        {
            await OnFile(file);
        }
        finally
        {
            _uploading = false;
            StateHasChanged();
        }
    }

    public void Dispose() => _selfRef?.Dispose();
}
