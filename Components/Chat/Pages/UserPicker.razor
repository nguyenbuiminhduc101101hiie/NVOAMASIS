@using NVOAMASIS.Models.Chat
@inject IStringLocalizer<SharedResource> Localizer

<MudTextField T="string" @bind-Value="_filter" Immediate="true" Placeholder="@Localizer["chat_search_user"]"
              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
              Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" Class="mb-2" />
<div style="max-height:320px; overflow-y:auto;">
    @foreach (var u in Filtered)
    {
        var selected = Selected.Contains(u.UserId);
        <div class="d-flex align-center gap-2 px-1 py-1" style="cursor:pointer;" @onclick="() => Toggle(u.UserId)">
            <MudIcon Color="@(selected ? Color.Primary : Color.Default)"
                     Icon="@(Multiple
                        ? (selected ? Icons.Material.Filled.CheckBox : Icons.Material.Filled.CheckBoxOutlineBlank)
                        : (selected ? Icons.Material.Filled.RadioButtonChecked : Icons.Material.Filled.RadioButtonUnchecked))" />
            <span class="chat-avatar" style="width:30px;height:30px;font-size:0.8rem;">@ConversationList.Initials(u.Name)</span>
            <span>
                <MudText Typo="Typo.body2">@u.Name</MudText>
                @if (!string.IsNullOrWhiteSpace(u.Department))
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@u.Department</MudText>
                }
            </span>
        </div>
    }
    @if (!Filtered.Any())
    {
        <MudText Typo="Typo.body2" Class="pa-2">@Localizer["chat_no_match"]</MudText>
    }
</div>

@code {
    [Parameter] public IReadOnlyList<ChatUserOption> Users { get; set; } = [];
    [Parameter] public bool Multiple { get; set; }
    [Parameter] public HashSet<Guid> Selected { get; set; } = [];
    [Parameter] public EventCallback SelectedChanged { get; set; }

    private string? _filter;

    private IEnumerable<ChatUserOption> Filtered
    {
        get
        {
            var term = _filter?.Trim();
            return string.IsNullOrEmpty(term)
                ? Users
                : Users.Where(u => u.Name.Contains(term, StringComparison.CurrentCultureIgnoreCase) ||
                                   (u.Department?.Contains(term, StringComparison.CurrentCultureIgnoreCase) ?? false));
        }
    }

    private async Task Toggle(Guid userId)
    {
        if (Multiple)
        {
            if (!Selected.Remove(userId))
                Selected.Add(userId);
        }
        else
        {
            Selected.Clear();
            Selected.Add(userId);
        }
        await SelectedChanged.InvokeAsync();
    }
}
