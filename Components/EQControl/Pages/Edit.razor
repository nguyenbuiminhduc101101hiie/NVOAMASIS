@inject IStringLocalizer<SharedResource> Localizer
@inject ShipmentService shipsv
@inject CustomerService csv
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudContainer>
            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudAutocomplete T="string"
                                     @bind-Value="item.ContainerNo"
                                     Label="@Localizer["ContainerNo"]"
                                     Variant="Variant.Outlined"
                                     Dense="true"
                                     Required="true"
                                     SearchFunc="SearchContainerNo"
                                     CoerceText="true"
                                     CoerceValue="true"
                                     Clearable="true"
                                     ResetValueOnEmptyText="true"
                                     MaxLength="20"
                                     HelperText="@Localizer["Eq_ContainerNoHint"]" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudAutocomplete T="string"
                                     @bind-Value="item.ContainerType"
                                     Label="@Localizer["Eq_ContainerType"]"
                                     Variant="Variant.Outlined"
                                     Dense="true"
                                     SearchFunc="SearchContainerType"
                                     CoerceText="true"
                                     CoerceValue="true"
                                     Clearable="true"
                                     ResetValueOnEmptyText="true" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudSelect T="string" @bind-Value="item.OwnershipType"
                               Label="@Localizer["Eq_OwnershipType"]"
                               Variant="Variant.Outlined" Dense="true" Clearable="true">
                        <MudSelectItem T="string" Value="@((string?)null)">-</MudSelectItem>
                        <MudSelectItem T="string" Value="@("SOC")">SOC</MudSelectItem>
                        <MudSelectItem T="string" Value="@("COC")">COC</MudSelectItem>
                        <MudSelectItem T="string" Value="@("Leased")">Leased</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudAutocomplete T="Guid?"
                                     @bind-Value="item.OwnerID"
                                     Label="@Localizer["Eq_Owner"]"
                                     Variant="Variant.Outlined"
                                     Dense="true"
                                     SearchFunc="SearchOwner"
                                     ToStringFunc="OwnerToString"
                                     Clearable="true"
                                     ResetValueOnEmptyText="true" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudSelect T="string" @bind-Value="item.Status"
                               Label="@Localizer["Status"]"
                               Variant="Variant.Outlined" Dense="true" Clearable="true">
                        <MudSelectItem T="string" Value="@((string?)null)">-</MudSelectItem>
                        <MudSelectItem T="string" Value="@("Available")">Available</MudSelectItem>
                        <MudSelectItem T="string" Value="@("Booked")">Booked</MudSelectItem>
                        <MudSelectItem T="string" Value="@("Laden")">Laden</MudSelectItem>
                        <MudSelectItem T="string" Value="@("Empty")">Empty</MudSelectItem>
                        <MudSelectItem T="string" Value="@("Repair")">Repair</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudSelect T="string" @bind-Value="item.Condition"
                               Label="@Localizer["Condition"]"
                               Variant="Variant.Outlined" Dense="true" Clearable="true">
                        <MudSelectItem T="string" Value="@((string?)null)">-</MudSelectItem>
                        <MudSelectItem T="string" Value="@("Good")">Good</MudSelectItem>
                        <MudSelectItem T="string" Value="@("Damaged")">Damaged</MudSelectItem>
                        <MudSelectItem T="string" Value="@("Repair")">Repair</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="item.CurrentLocation"
                                  Label="@Localizer["Eq_CurrentLocation"]"
                                  Variant="Variant.Outlined" Dense="true" MaxLength="200" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="item.CurrentDepot"
                                  Label="@Localizer["Eq_CurrentDepot"]"
                                  Variant="Variant.Outlined" Dense="true" MaxLength="200" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudDatePicker @bind-Date="item.ManufactureDate"
                                   Label="@Localizer["Eq_ManufactureDate"]"
                                   Variant="Variant.Outlined" DateFormat="dd/MM/yyyy" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudDatePicker @bind-Date="item.LastInspectionDate"
                                   Label="@Localizer["Eq_LastInspectionDate"]"
                                   Variant="Variant.Outlined" DateFormat="dd/MM/yyyy" />
                </MudItem>
            </MudGrid>
        </MudContainer>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@Localizer["Cancel"]</MudButton>
        <MudButton Color="Color.Primary" OnClick="Submit" Disabled="_saving">@Localizer["Save"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] MudDialogInstance? MudDialog { get; set; }
    [Parameter] public M_ContainerMaster? item { get; set; }

    private List<M_Customer> Customers = new();
    private List<string> ShipmentContainerNos = new();
    private static readonly string[] ContainerTypes = { "20GP", "40GP", "40HC", "Reefer", "20RF", "40RF", "20OT", "40OT", "20FR", "40FR" };
    private bool _saving;

    protected override async Task OnInitializedAsync()
    {
        item ??= new M_ContainerMaster { ID = Guid.NewGuid() };
        try
        {
            Customers = await csv.GetList();
            ShipmentContainerNos = shipsv.GetDistinctShipmentContainerNos();
        }
        catch (Exception ex)
        {
            CallSnackBar(string.Format(Localizer["Eq_LoadContainersError"], ex.Message), MudBlazor.Severity.Error);
        }
    }

    private async Task Submit()
    {
        if (item == null) return;
        if (string.IsNullOrWhiteSpace(item.ContainerNo))
        {
            CallSnackBar(Localizer["Eq_ContainerNoRequired"], MudBlazor.Severity.Warning);
            return;
        }

        try
        {
            _saving = true;
            var rs = await shipsv.SaveOrUpdateContainerMaster(item);
            CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
            if (rs.Flag)
                MudDialog!.Close(item);
        }
        catch (Exception ex)
        {
            CallSnackBar(Localizer["ErrorSavingContainer"] + " " + ex.Message, MudBlazor.Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    void Cancel() => MudDialog!.Cancel();

    private Task<IEnumerable<string>> SearchContainerNo(string value)
    {
        IEnumerable<string> result = ShipmentContainerNos;
        if (!string.IsNullOrWhiteSpace(value))
        {
            result = ShipmentContainerNos
                .Where(x => x.Contains(value, StringComparison.OrdinalIgnoreCase))
                .Take(50);
        }
        else
        {
            result = ShipmentContainerNos.Take(50);
        }
        return Task.FromResult(result);
    }

    private Task<IEnumerable<string>> SearchContainerType(string value)
    {
        IEnumerable<string> result = ContainerTypes;
        if (!string.IsNullOrWhiteSpace(value))
            result = ContainerTypes.Where(x => x.Contains(value, StringComparison.OrdinalIgnoreCase));
        return Task.FromResult(result);
    }

    private Task<IEnumerable<Guid?>> SearchOwner(string value)
    {
        IEnumerable<M_Customer> q = Customers.Where(c => c.Customer_ID != Guid.Empty);
        if (!string.IsNullOrWhiteSpace(value))
        {
            q = q.Where(c =>
                ContainsIgnoreCase(c.Customer_Code, value)
                || ContainsIgnoreCase(c.COMPANY, value)
                || ContainsIgnoreCase(c.shortname, value)
                || ContainsIgnoreCase(c.EnglishName, value)
                || ContainsIgnoreCase(c.TaxCode, value));
        }
        return Task.FromResult(q.Take(50).Select(c => (Guid?)c.Customer_ID));
    }

    private string OwnerToString(Guid? id)
    {
        if (!id.HasValue || id == Guid.Empty) return string.Empty;
        var c = Customers.FirstOrDefault(x => x.Customer_ID == id);
        if (c == null) return string.Empty;
        return string.IsNullOrWhiteSpace(c.Customer_Code)
            ? (c.COMPANY ?? string.Empty)
            : $"{c.Customer_Code} - {c.COMPANY}";
    }

    private static bool ContainsIgnoreCase(string? value, string search)
        => !string.IsNullOrWhiteSpace(value) && value.Contains(search, StringComparison.OrdinalIgnoreCase);

    void CallSnackBar(string message, MudBlazor.Severity severity)
    {
        Snackbar.Configuration.SnackbarVariant = Variant.Filled;
        Snackbar.Configuration.MaxDisplayedSnackbars = 3;
        Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopRight;
        Snackbar.Add(message, severity);
    }
}
