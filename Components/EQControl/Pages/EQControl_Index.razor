                        FE = gateOutSheet.Cells[row, 9].GetValue<string>(),
                        Move = gateOutSheet.Cells[row, 10].GetValue<string>(),
                        Location = gateOutSheet.Cells[row, 11].GetValue<string>(),
                        Booking = gateOutSheet.Cells[row, 12].GetValue<string>(),
                        Vessel = gateOutSheet.Cells[row, 13].GetValue<string>(),
                        Voyage = gateOutSheet.Cells[row, 14].GetValue<string>(),
