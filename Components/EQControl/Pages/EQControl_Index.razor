                        Grade = gateInSheet.Cells[row, 25].GetValue<string>(),
                        Note = gateInSheet.Cells[row, 26].GetValue<string>()
                    };

                    var rs = await shipsv.SaveOrUpdateGateIn(item);
                    if (!rs.Flag)
                        CallSnackBar(string.Format(Localizer["Eq_SaveGateInError"], item.Seq, rs.Message), MudBlazor.Severity.Error);
                    else
                        importedGateIn++;

                    row++;
                }
            }

            var gateOutSheet = package.Workbook.Worksheets["GateOut"];
            if (gateOutSheet != null)
            {
                var row = 16;
                while (true)
                {
                    var seqValue = gateOutSheet.Cells[row, 1].GetValue<int?>();
                    if (!seqValue.HasValue)
                        break;

                    var rowContainerNo = gateOutSheet.Cells[row, ExcelColumnContainer].GetValue<string>();
                    if (!MatchContainerNo(rowContainerNo, targetContainerNo))
                    {
                        row++;
                        continue;
                    }

                    var item = new M_GateOut
                    {
                        Containerid = ContainerDetail.CTN_ID,
                        Seq = seqValue,
                        EIR = gateOutSheet.Cells[row, 2].GetValue<string>(),
