@page "/EQControl"
@inject NavigationManager navSvc
@inject ILogger<EQControl_Index> Logger
@inject IJSRuntime js
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject SharedServices ssv
@inject AccountService asv
@inject ShipmentService shipsv
@inject CustomerService csv
@inject IStringLocalizer<SharedResource> Localizer
@attribute [Authorize]
@using System.Globalization;
@using Microsoft.AspNetCore.Components.Forms;
@using OfficeOpenXml;

<PageTitle>@Localizer["EQControl"]</PageTitle>

<div class="product-price-page">
    <PpScreenHeader Title="@Localizer["EQControl"]" Subtitle="@Localizer["EqControl_Subtitle"]" />
<MudPaper Class="product-price-card" Elevation="0">
<MudContainer MaxWidth=MaxWidth.False>

    <MudGrid Class="pa-4">
        <MudItem xs="12" md="3">
            <MudTextField @bind-Value="searchContainerNo" Label="@Localizer["ContainerNo"]"
                Variant="Variant.Outlined" Dense="true"
                Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Search"
                Immediate="true" />
        </MudItem>
        <MudItem xs="12" md="3">
            <MudAutocomplete T="Guid?" @bind-Value="selectedOwnerId"
                             Label="@Localizer["Eq_Owner"]"
                             Variant="Variant.Outlined" Dense="true"
                             SearchFunc="SearchOwner"
                             ToStringFunc="OwnerToString"
                             Clearable="true" ResetValueOnEmptyText="true" />
        </MudItem>
        <MudItem xs="12" md="3">
            <MudSelect T="string" @bind-Value="selectedStatus" Label="@Localizer["Status"]"
                       Variant="Variant.Outlined" Dense="true" Clearable="true">
                <MudSelectItem T="string" Value="@((string?)null)">All</MudSelectItem>
                <MudSelectItem T="string" Value="@("Available")">Available</MudSelectItem>
                <MudSelectItem T="string" Value="@("Booked")">Booked</MudSelectItem>
                <MudSelectItem T="string" Value="@("Laden")">Laden</MudSelectItem>
                <MudSelectItem T="string" Value="@("Empty")">Empty</MudSelectItem>
                <MudSelectItem T="string" Value="@("Repair")">Repair</MudSelectItem>
            </MudSelect>
        </MudItem>
        <MudItem xs="12" md="3">
            <MudSelect T="string" @bind-Value="selectedOwnershipType" Label="@Localizer["Eq_OwnershipType"]"
                       Variant="Variant.Outlined" Dense="true" Clearable="true">
                <MudSelectItem T="string" Value="@((string?)null)">All</MudSelectItem>
                <MudSelectItem T="string" Value="@("SOC")">SOC</MudSelectItem>
                <MudSelectItem T="string" Value="@("COC")">COC</MudSelectItem>
                <MudSelectItem T="string" Value="@("Leased")">Leased</MudSelectItem>
            </MudSelect>
        </MudItem>
    </MudGrid>

    <MudStack Row Justify="Justify.FlexStart" Class="pa-4">
        <MudButton OnClick="HandleRefresh" Size="Size.Small" Color="Color.Primary"
            Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Refresh">
            @Localizer["reload"]
        </MudButton>
        <MudButton OnClick="@(() => OpenDialogEdit(true))" Size="Size.Small" Color="Color.Success"
            Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add">
            @Localizer["Eq_Add"]
        </MudButton>
        <MudButton OnClick="@(() => OpenDialogEdit(false))" Size="Size.Small" Color="Color.Info"
            Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Edit" Disabled="@(ContainerDetail == null)">
            @Localizer["edit"]
        </MudButton>
        <MudButton OnClick="HandleDelete" Size="Size.Small" Color="Color.Error"
            Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Delete" Disabled="@(ContainerDetail == null)">
            @Localizer["delete"]
        </MudButton>
        <MudButton OnClick="DownloadImportTemplate" Size="Size.Small" Color="Color.Dark"
            Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.FileDownload">
            @Localizer["Eq_GetTemplate"]
        </MudButton>
        <MudButton HtmlTag="label" Size="Size.Small" Color="Color.Tertiary"
                   Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.FileUpload">
            @Localizer["Eq_Import"]
            <InputFile OnChange="ImportContainerMaster" accept=".xlsx" style="display:none" />
        </MudButton>
    </MudStack>

</MudContainer>
</MudPaper>
<MudPaper Class="product-price-card mt-3" Elevation="0">
<MudContainer MaxWidth=MaxWidth.False>
    <MudDataGrid T="M_ContainerMaster" Bordered="true" Items="@FilteredContainers.ToList()" Filterable="true"
        FilterMode="@DataGridFilterMode.ColumnFilterRow" Dense="true" Virtualize="true"
        RowClick="@RowClicked" FixedHeader="true" FixedFooter="true"
        HeaderClass="no-wrap" FooterClass="no-wrap" RowClassFunc="@SelectedRowClassFunc" @ref="mudTable"
        ReadOnly="true" Loading="f_loading"
        ColumnResizeMode="@(_resizeColumn? ResizeMode.Column: ResizeMode.Container)">
        <Columns>
            <PropertyColumn Required="false" Property="x => Containers.IndexOf(x) + 1" Title="@Localizer["no"]"
                Filterable="false" CellStyleFunc="_cellStyleFunc">
            </PropertyColumn>
            <PropertyColumn Required="false" Property="x => x.ContainerNo" Title="@Localizer["ContainerNo"]"
                CellStyleFunc="_cellStyleFunc">
            </PropertyColumn>
            <PropertyColumn Required="false" Property="x => x.ContainerType" Title="@Localizer["Eq_ContainerType"]"
                CellStyleFunc="_cellStyleFunc">
            </PropertyColumn>
            <PropertyColumn Required="false" Property="x => x.OwnershipType" Title="@Localizer["Eq_OwnershipType"]"
                CellStyleFunc="_cellStyleFunc">
            </PropertyColumn>
            <TemplateColumn Title="@Localizer["Eq_Owner"]" CellStyleFunc="_cellStyleFunc">
                <CellTemplate>
                    @OwnerToString(context.Item.OwnerID)
                </CellTemplate>
            </TemplateColumn>
            <PropertyColumn Required="false" Property="x => x.Status" Title="@Localizer["Status"]"
                CellStyleFunc="_cellStyleFunc">
            </PropertyColumn>
            <PropertyColumn Required="false" Property="x => x.CurrentLocation" Title="@Localizer["Eq_CurrentLocation"]"
                CellStyleFunc="_cellStyleFunc">
            </PropertyColumn>
            <PropertyColumn Required="false" Property="x => x.CurrentDepot" Title="@Localizer["Eq_CurrentDepot"]"
                CellStyleFunc="_cellStyleFunc">
            </PropertyColumn>
            <PropertyColumn Required="false" Property="x => x.ManufactureDate" Title="@Localizer["Eq_ManufactureDate"]"
                CellStyleFunc="_cellStyleFunc" Format="dd/MM/yyyy">
            </PropertyColumn>
            <PropertyColumn Required="false" Property="x => x.LastInspectionDate" Title="@Localizer["Eq_LastInspectionDate"]"
                CellStyleFunc="_cellStyleFunc" Format="dd/MM/yyyy">
            </PropertyColumn>
            <PropertyColumn Required="false" Property="x => x.Condition" Title="@Localizer["Condition"]"
                CellStyleFunc="_cellStyleFunc">
            </PropertyColumn>
        </Columns>
        <PagerContent>
            <MudDataGridPager T="M_ContainerMaster" PageSizeOptions=@(new int[] { 10, 20, 50, 100 }) />
        </PagerContent>
    </MudDataGrid>
    <MudScrollToTop>
        <MudFab Color="Color.Primary" StartIcon="@Icons.Material.Filled.ArrowCircleUp" />
    </MudScrollToTop>
</MudContainer>
</MudPaper>
</div>

@code {
    private MudDataGrid<M_ContainerMaster> mudTable;
    private List<M_ContainerMaster> Containers = new();
    private List<M_Customer> Customers = new();
    private M_ContainerMaster? ContainerDetail;
    private bool _resizeColumn;
    AuthUser userdetail;
    bool f_loading = false;

    private string searchContainerNo = "";
    private Guid? selectedOwnerId;
    private string? selectedStatus;
    private string? selectedOwnershipType;

    private IEnumerable<M_ContainerMaster> FilteredContainers
    {
        get
        {
            var filtered = Containers.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(searchContainerNo))
                filtered = filtered.Where(c => ContainsIgnoreCase(c.ContainerNo, searchContainerNo));

            if (selectedOwnerId.HasValue && selectedOwnerId != Guid.Empty)
                filtered = filtered.Where(c => c.OwnerID == selectedOwnerId);

            if (!string.IsNullOrWhiteSpace(selectedStatus))
                filtered = filtered.Where(c => string.Equals(c.Status, selectedStatus, StringComparison.OrdinalIgnoreCase));

            if (!string.IsNullOrWhiteSpace(selectedOwnershipType))
                filtered = filtered.Where(c => string.Equals(c.OwnershipType, selectedOwnershipType, StringComparison.OrdinalIgnoreCase));

            return filtered;
        }
    }

    private static bool ContainsIgnoreCase(string? value, string search)
    {
        if (string.IsNullOrWhiteSpace(search)) return true;
        if (string.IsNullOrWhiteSpace(value)) return false;
        return value.Contains(search, StringComparison.OrdinalIgnoreCase);
    }

    async Task HandleRefresh()
    {
        try
        {
            f_loading = true;
            Containers.Clear();
            ContainerDetail = null;
            await Task.Delay(200);

            if (!await ssv.CheckPermission(asv.GetAuth().Result.User.Identity!.Name!, "View", "EQ_Control"))
            {
                CallSnackBar(Localizer["NoPermission_View"], MudBlazor.Severity.Warning);
                return;
            }

            Customers = await csv.GetList();
            Containers = shipsv.GetListContainerMaster();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            CallSnackBar(string.Format(Localizer["Eq_LoadContainersError"], ex.Message), MudBlazor.Severity.Error);
        }
        finally
        {
            f_loading = false;
        }
    }

    private async Task OpenDialogEdit(bool isNew)
    {
        if (!isNew && ContainerDetail == null)
        {
            CallSnackBar(Localizer["Eq_SelectContainer"], MudBlazor.Severity.Warning);
            return;
        }

        var permission = isNew ? "Add" : "Edit";
        if (!await ssv.CheckPermission(userdetail.Usr, permission, "EQ_Control")
            && !await ssv.CheckPermission(userdetail.Usr, "Edit", "EQ_Control"))
        {
            CallSnackBar(Localizer["NoPermission_Edit"], MudBlazor.Severity.Warning);
            return;
        }

        var item = isNew
            ? new M_ContainerMaster { ID = Guid.NewGuid() }
            : (ContainerDetail!.DeepCopy() ?? ContainerDetail);

        var optionsdialog = new DialogOptions
        {
            ClassBackground = "class-dialog-custom",
            FullWidth = true,
            MaxWidth = MaxWidth.Medium,
            CloseOnEscapeKey = false,
            DisableBackdropClick = true
        };
        var parameters = new DialogParameters<Edit> { { x => x.item, item } };
        var title = isNew
            ? Localizer["Eq_Add"].Value
            : $"{Localizer["EQControlEdit"]} {item.ContainerNo}";
        var dialog = await DialogService.ShowAsync<Edit>(title, parameters, optionsdialog);
        var result = await dialog.Result;
        if (!result.Canceled)
        {
            await HandleRefresh();
            if (!string.IsNullOrWhiteSpace(item.ContainerNo))
                searchContainerNo = item.ContainerNo;
        }
        StateHasChanged();
    }

    private async Task HandleDelete()
    {
        if (ContainerDetail == null)
        {
            CallSnackBar(Localizer["Eq_SelectContainer"], MudBlazor.Severity.Warning);
            return;
        }

        if (!await ssv.CheckPermission(userdetail.Usr, "Delete", "EQ_Control")
            && !await ssv.CheckPermission(userdetail.Usr, "Edit", "EQ_Control"))
        {
            CallSnackBar(Localizer["NoPermission_Edit"], MudBlazor.Severity.Warning);
            return;
        }

        var resultMess = await DialogService.ShowMessageBox(
            Localizer["Warning"],
            string.Format(Localizer["Eq_ConfirmDelete"], ContainerDetail.ContainerNo),
            yesText: Localizer["delete"], cancelText: Localizer["Cancel"]);

        if (resultMess != true) return;

        var rs = await shipsv.DeleteContainerMaster(ContainerDetail);
        CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
        if (rs.Flag)
            await HandleRefresh();
    }

    void CallSnackBar(string message, MudBlazor.Severity severity)
    {
        Snackbar.Configuration.SnackbarVariant = Variant.Filled;
        Snackbar.Configuration.MaxDisplayedSnackbars = 3;
        Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopRight;
        Snackbar.Add(message, severity);
    }

    void RowClicked(DataGridRowClickEventArgs<M_ContainerMaster> args)
    {
        ContainerDetail = args.Item;
    }

    private string SelectedRowClassFunc(M_ContainerMaster container, int rowNumber)
    {
        if (ContainerDetail != null && ContainerDetail.ID == container.ID)
            return "selected";
        return string.Empty;
    }

    private Func<M_ContainerMaster, string> _cellStyleFunc => x => "pa-2";

    private Task<IEnumerable<Guid?>> SearchOwner(string value)
    {
        IEnumerable<M_Customer> q = Customers.Where(c => c.Customer_ID != Guid.Empty);
        if (!string.IsNullOrWhiteSpace(value))
        {
            q = q.Where(c =>
                ContainsIgnoreCase(c.Customer_Code, value)
                || ContainsIgnoreCase(c.COMPANY, value)
                || ContainsIgnoreCase(c.shortname, value)
                || ContainsIgnoreCase(c.EnglishName, value)
                || ContainsIgnoreCase(c.TaxCode, value));
        }
        return Task.FromResult(q.Take(50).Select(c => (Guid?)c.Customer_ID));
    }

    private string OwnerToString(Guid? id)
    {
        if (!id.HasValue || id == Guid.Empty) return string.Empty;
        var c = Customers.FirstOrDefault(x => x.Customer_ID == id);
        if (c == null) return string.Empty;
        return string.IsNullOrWhiteSpace(c.Customer_Code)
            ? (c.COMPANY ?? string.Empty)
            : $"{c.Customer_Code} - {c.COMPANY}";
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            userdetail = asv.GetUserDetail();
            await HandleRefresh();
        }
        catch (Exception ex)
        {
            CallSnackBar(string.Format(Localizer["Eq_LoadContainersError"], ex.Message), MudBlazor.Severity.Error);
        }
    }

    private static readonly string[] TemplateHeaders =
    {
        "ContainerNo", "ContainerType", "OwnershipType", "OwnerCode",
        "Status", "CurrentLocation", "CurrentDepot", "ManufactureDate",
        "LastInspectionDate", "Condition"
    };

    private async Task DownloadImportTemplate()
    {
        try
        {
            ExcelPackage.LicenseContext = LicenseContext.NonCommercial;
            using var package = new ExcelPackage();
            var sheet = package.Workbook.Worksheets.Add("ContainerMaster");
            for (var i = 0; i < TemplateHeaders.Length; i++)
            {
                sheet.Cells[1, i + 1].Value = TemplateHeaders[i];
                sheet.Cells[1, i + 1].Style.Font.Bold = true;
            }

            sheet.Cells[2, 1].Value = "TGHU1234567";
            sheet.Cells[2, 2].Value = "40HC";
            sheet.Cells[2, 3].Value = "SOC";
            sheet.Cells[2, 4].Value = Customers.FirstOrDefault(c => !string.IsNullOrWhiteSpace(c.Customer_Code))?.Customer_Code ?? "CUS001";
            sheet.Cells[2, 5].Value = "Available";
            sheet.Cells[2, 6].Value = "Cat Lai";
            sheet.Cells[2, 7].Value = "Depot A";
            sheet.Cells[2, 8].Value = DateTime.Today.AddYears(-5).ToString("yyyy-MM-dd");
            sheet.Cells[2, 9].Value = DateTime.Today.ToString("yyyy-MM-dd");
            sheet.Cells[2, 10].Value = "Good";
            sheet.Cells.AutoFitColumns();

            var lists = package.Workbook.Worksheets.Add("Lists");
            lists.Cells[1, 1].Value = "ContainerType";
            lists.Cells[1, 2].Value = "OwnershipType";
            lists.Cells[1, 3].Value = "Status";
            lists.Cells[1, 4].Value = "Condition";
            lists.Cells[1, 1, 1, 4].Style.Font.Bold = true;

            var types = new[] { "20GP", "40GP", "40HC", "Reefer", "20RF", "40RF" };
            var ownerships = new[] { "SOC", "COC", "Leased" };
            var statuses = new[] { "Available", "Booked", "Laden", "Empty", "Repair" };
            var conditions = new[] { "Good", "Damaged", "Repair" };
            for (var i = 0; i < types.Length; i++) lists.Cells[i + 2, 1].Value = types[i];
            for (var i = 0; i < ownerships.Length; i++) lists.Cells[i + 2, 2].Value = ownerships[i];
            for (var i = 0; i < statuses.Length; i++) lists.Cells[i + 2, 3].Value = statuses[i];
            for (var i = 0; i < conditions.Length; i++) lists.Cells[i + 2, 4].Value = conditions[i];
            lists.Cells.AutoFitColumns();

            var notes = package.Workbook.Worksheets.Add("Notes");
            notes.Cells[1, 1].Value = "ContainerNo: required. Select existing container no or type a new one.";
            notes.Cells[2, 1].Value = "OwnerCode: Customer_Code from Customer master. Leave blank if unknown.";
            notes.Cells[3, 1].Value = "Dates: yyyy-MM-dd or dd/MM/yyyy.";
            notes.Cells[4, 1].Value = "Import upserts by ContainerNo.";

            var bytes = package.GetAsByteArray();
            await js.InvokeVoidAsync("saveAsFile", $"ContainerMaster_ImportTemplate_{DateTime.Now:yyyyMMdd}.xlsx", Convert.ToBase64String(bytes));
            CallSnackBar(Localizer["Eq_TemplateDownloaded"], MudBlazor.Severity.Success);
        }
        catch (Exception ex)
        {
            CallSnackBar(string.Format(Localizer["Eq_ImportError"], ex.Message), MudBlazor.Severity.Error);
        }
    }

    private async Task ImportContainerMaster(InputFileChangeEventArgs e)
    {
        try
        {
            if (!await ssv.CheckPermission(userdetail.Usr, "Edit", "EQ_Control")
                && !await ssv.CheckPermission(userdetail.Usr, "Add", "EQ_Control"))
            {
                CallSnackBar(Localizer["NoPermission_Edit"], MudBlazor.Severity.Warning);
                return;
            }

            using var stream = new MemoryStream();
            await e.File.OpenReadStream(20 * 1024 * 1024).CopyToAsync(stream);
            stream.Position = 0;

            ExcelPackage.LicenseContext = LicenseContext.NonCommercial;
            using var package = new ExcelPackage(stream);
            var sheet = package.Workbook.Worksheets["ContainerMaster"]
                        ?? package.Workbook.Worksheets.FirstOrDefault();
            if (sheet == null)
            {
                CallSnackBar(Localizer["Eq_ImportSheetNotFound"], MudBlazor.Severity.Error);
                return;
            }

            var headerMap = new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase);
            var colCount = Math.Max(sheet.Dimension?.End.Column ?? 0, TemplateHeaders.Length);
            for (var col = 1; col <= colCount; col++)
            {
                var header = sheet.Cells[1, col].GetValue<string>()?.Trim();
                if (!string.IsNullOrWhiteSpace(header) && !headerMap.ContainsKey(header))
                    headerMap[header] = col;
            }

            int Col(string name)
                => headerMap.TryGetValue(name, out var c) ? c : -1;

            var imported = 0;
            var skipped = 0;
            var lastRow = sheet.Dimension?.End.Row ?? 1;

            for (var row = 2; row <= lastRow; row++)
            {
                var containerNo = GetCellString(sheet, row, Col("ContainerNo"));
                if (string.IsNullOrWhiteSpace(containerNo))
                {
                    skipped++;
                    continue;
                }

                var ownerCode = GetCellString(sheet, row, Col("OwnerCode"));
                Guid? ownerId = null;
                if (!string.IsNullOrWhiteSpace(ownerCode))
                {
                    var owner = Customers.FirstOrDefault(c =>
                        string.Equals(c.Customer_Code?.Trim(), ownerCode, StringComparison.OrdinalIgnoreCase)
                        || string.Equals(c.COMPANY?.Trim(), ownerCode, StringComparison.OrdinalIgnoreCase)
                        || string.Equals(c.shortname?.Trim(), ownerCode, StringComparison.OrdinalIgnoreCase));
                    ownerId = owner?.Customer_ID;
                }

                var existing = Containers.FirstOrDefault(c =>
                    string.Equals(c.ContainerNo?.Trim(), containerNo.Trim(), StringComparison.OrdinalIgnoreCase));

                var item = existing?.DeepCopy() ?? new M_ContainerMaster { ID = Guid.NewGuid() };
                item.ContainerNo = containerNo.Trim();
                item.ContainerType = GetCellString(sheet, row, Col("ContainerType"));
                item.OwnershipType = GetCellString(sheet, row, Col("OwnershipType"));
                item.OwnerID = ownerId ?? item.OwnerID;
                item.Status = GetCellString(sheet, row, Col("Status"));
                item.CurrentLocation = GetCellString(sheet, row, Col("CurrentLocation"));
                item.CurrentDepot = GetCellString(sheet, row, Col("CurrentDepot"));
                item.ManufactureDate = GetCellDate(sheet, row, Col("ManufactureDate")) ?? item.ManufactureDate;
                item.LastInspectionDate = GetCellDate(sheet, row, Col("LastInspectionDate")) ?? item.LastInspectionDate;
                item.Condition = GetCellString(sheet, row, Col("Condition"));

                var rs = await shipsv.SaveOrUpdateContainerMaster(item);
                if (rs.Flag) imported++;
                else CallSnackBar($"{containerNo}: {rs.Message}", MudBlazor.Severity.Error);
            }

            await HandleRefresh();
            CallSnackBar(string.Format(Localizer["Eq_ImportSuccess"], imported, skipped),
                imported > 0 ? MudBlazor.Severity.Success : MudBlazor.Severity.Info);
        }
        catch (Exception ex)
        {
            CallSnackBar(string.Format(Localizer["Eq_ImportError"], ex.Message), MudBlazor.Severity.Error);
        }
    }

    private static string? GetCellString(ExcelWorksheet sheet, int row, int col)
    {
        if (col < 1) return null;
        var text = sheet.Cells[row, col].Text?.Trim();
        return string.IsNullOrWhiteSpace(text) ? null : text;
    }

    private static DateTime? GetCellDate(ExcelWorksheet sheet, int row, int col)
    {
        if (col < 1) return null;
        var cell = sheet.Cells[row, col];
        var dt = cell.GetValue<DateTime?>();
        if (dt.HasValue && dt.Value.Year > 1900) return dt;

        var text = cell.Text?.Trim();
        if (string.IsNullOrWhiteSpace(text)) return null;

        var formats = new[] { "yyyy-MM-dd", "dd/MM/yyyy", "d/M/yyyy", "MM/dd/yyyy", "yyyy/MM/dd" };
        if (DateTime.TryParseExact(text, formats, CultureInfo.InvariantCulture, DateTimeStyles.None, out var parsed))
            return parsed;
        if (DateTime.TryParse(text, CultureInfo.CurrentCulture, DateTimeStyles.None, out parsed))
            return parsed;
        return null;
    }
}
