@page "/FontSizeSelector"
@using NVOAMASIS.Models
@inject IStringLocalizer<SharedResource> Localizer
@inject FontService FontService
@inject ThemeService ThemeService
@inject AccountService AccountService
@inject ISnackbar Snackbar

<MudContainer>
    <MudStack Spacing="3">
        <MudCard>
            <MudCardContent>
                <MudText Typo="Typo.h6">@Localizer["FontSize_Title"]</MudText>

                <MudTextField Label="@Localizer["FontSize_HeaderH6"]" @bind-Value="headerh6" />
                <MudTextField Label="@Localizer["FontSize_TitleField"]" @bind-Value="tieude" />
                <MudTextField Label="@Localizer["FontSize_Content"]" @bind-Value="noidung" />
                <MudTextField Label="@Localizer["FontSize_GridContent"]" @bind-Value="noidungluoi" />

                <MudButton OnClick="ApplyFontSize" Variant="Variant.Filled" Color="Color.Primary" Disabled="saving">
                    @(saving ? Localizer["Saving..."].Value : Localizer["Apply"].Value)
                </MudButton>
            </MudCardContent>
        </MudCard>

        <MudCard>
            <MudCardContent>
                <MudText Typo="Typo.h6">@Localizer["FontSize_NavMenuTitle"]</MudText>

                <MudTextField Label="@Localizer["FontSize_NavMenu"]" @bind-Value="navmenu" />

                <MudButton OnClick="ApplyNavMenuFontSize" Variant="Variant.Filled" Color="Color.Primary" Disabled="saving">
                    @(saving ? Localizer["Saving..."].Value : Localizer["Apply"].Value)
                </MudButton>
            </MudCardContent>
        </MudCard>
    </MudStack>
</MudContainer>

@code {
    private string headerh6 = ThemeDefaults.FontHeaderH6;
    private string noidung = ThemeDefaults.FontNoiDung;
    private string tieude = ThemeDefaults.FontTieuDe;
    private string noidungluoi = ThemeDefaults.FontNoiDungLuoi;
    private string navmenu = ThemeDefaults.FontNavMenu;
    private bool saving;

    protected override async Task OnInitializedAsync()
    {
        await LoadFontPreference();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        await ApplyCurrentFontsToDom();
    }

    private Guid? GetCurrentUserId()
    {
        var user = AccountService.GetUserDetail();
        if (user == null || user.UsrId == Guid.Empty)
            return null;
        return user.UsrId;
    }

    private async Task LoadFontPreference()
    {
        try
        {
            var userId = GetCurrentUserId();
            if (userId == null)
                return;

            var data = await ThemeService.GetUserThemePreferenceAsync(userId.Value);
            headerh6 = string.IsNullOrWhiteSpace(data.FontHeaderH6) ? ThemeDefaults.FontHeaderH6 : data.FontHeaderH6;
            tieude = string.IsNullOrWhiteSpace(data.FontTieuDe) ? ThemeDefaults.FontTieuDe : data.FontTieuDe;
            noidung = string.IsNullOrWhiteSpace(data.FontNoiDung) ? ThemeDefaults.FontNoiDung : data.FontNoiDung;
            noidungluoi = string.IsNullOrWhiteSpace(data.FontNoiDungLuoi) ? ThemeDefaults.FontNoiDungLuoi : data.FontNoiDungLuoi;
            navmenu = string.IsNullOrWhiteSpace(data.FontNavMenu) ? ThemeDefaults.FontNavMenu : data.FontNavMenu;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading font preference: {ex.Message}");
        }
    }

    private async Task ApplyFontSize()
    {
        saving = true;
        try
        {
            var userId = GetCurrentUserId();
            if (userId == null)
            {
                Snackbar.Add(Localizer["AccountNotIdentified"], MudBlazor.Severity.Error);
                return;
            }

            await FontService.SetFontSize(headerh6, noidung, tieude, noidungluoi);

            var ok = await ThemeService.UpdateUserContentFontPreferenceAsync(
                userId.Value, headerh6, tieude, noidung, noidungluoi);

            if (ok)
                Snackbar.Add(Localizer["FontSize_Saved"], MudBlazor.Severity.Success);
            else
                Snackbar.Add(Localizer["FontSize_SaveFailed"], MudBlazor.Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add(string.Format(Localizer["Error_Message"], ex.Message), MudBlazor.Severity.Error);
        }
        finally
        {
            saving = false;
        }
    }

    private async Task ApplyNavMenuFontSize()
    {
        saving = true;
        try
        {
            var userId = GetCurrentUserId();
            if (userId == null)
            {
                Snackbar.Add(Localizer["AccountNotIdentified"], MudBlazor.Severity.Error);
                return;
            }

            await FontService.SetNavMenuFontSize(navmenu);

            var ok = await ThemeService.UpdateUserNavMenuFontPreferenceAsync(userId.Value, navmenu);
            if (ok)
                Snackbar.Add(Localizer["FontSize_NavMenuSaved"], MudBlazor.Severity.Success);
            else
                Snackbar.Add(Localizer["FontSize_SaveFailed"], MudBlazor.Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add(string.Format(Localizer["Error_Message"], ex.Message), MudBlazor.Severity.Error);
        }
        finally
        {
            saving = false;
        }
    }

    private async Task ApplyCurrentFontsToDom()
    {
        await FontService.SetFontSize(headerh6, noidung, tieude, noidungluoi);
        await FontService.SetNavMenuFontSize(navmenu);
    }
}
