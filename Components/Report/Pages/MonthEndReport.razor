
@inject CustomerService csv
@inject SupportServices supsv
@inject SharedServices ssv
@inject AccountService asv
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject ShipmentService shipsv
@inject ReportServices rsv
@inject IStringLocalizer<SharedResource> Localizer
@inject IJSRuntime JS
@attribute [Authorize]
@using System.Globalization﻿

<PageTitle>@Localizer["MonthEndReport"]</PageTitle>
<MudContainer MaxWidth=MaxWidth.False>
    
    @* <MudStack Row="true" Justify="Justify.FlexStart" Spacing="3">
        <MudDateRangePicker @bind-DateRange="frmtoDate" Label="From - To Date" Color="Color.Primary"/>
        <MudIconButton HtmlTag="label"
                    OnClick="@(()=>Refresh(frmtoDate))" Disabled="_loading"
                    Size="Size.Small" Color="Color.Primary" Variant="Variant.Text"
                    Icon="@Icons.Material.Filled.Search"/>

        <MudRadioGroup @bind-Value="chkUSD">
            <MudRadio Value="@true" Color="Color.Primary" Size="Size.Small">USD</MudRadio>
            <MudRadio Value="@false" Color="Color.Primary" Size="Size.Small">VND</MudRadio>
        </MudRadioGroup>
        
    </MudStack> *@
    <MudDataGrid T="M_Job" Items="@Listdata" Filterable="true" @ref="mudTable" Class="table-shipment-bg"
                         FilterMode="@DataGridFilterMode.Simple" Dense="true" Virtualize="true" Height="calc(100vh - 41vh);" QuickFilter="_quickFilter"
                         FixedHeader="true" FixedFooter="true" HeaderClass="no-wrap" FooterClass="no-wrap" RowClassFunc="@SelectedRowClassFunc"
                         RowClick="@RowClicked" RowContextMenuClick="RowRightClicked" Bordered="true" RowClass="no-wrap-cell"
                         ColumnResizeMode="ResizeMode.Column" Loading="_loading">
        <ToolBarContent>
            <MudStack Row="true" Justify="Justify.FlexStart" Spacing="3">
                <MudDateRangePicker @bind-DateRange="frmtoDate" Label="From - To Date" Color="Color.Primary" />
                <MudIconButton HtmlTag="label"
                               OnClick="@(()=>Refresh(frmtoDate))"
                               Size="Size.Large" Color="Color.Primary" Variant="Variant.Text"
                               Icon="@Icons.Material.Filled.Search" />
                <MudButton Disabled="_processingUpload"
                            OnClick="@ExportReport"
                           Size="Size.Small" Color="Color.Tertiary" Variant="Variant.Filled"
                           StartIcon="@Icons.Material.Filled.Download">
                    @if (_processingUpload)
                    {
                        <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                        <MudText Class="ms-2">Processing</MudText>
                    }
                    else
                    {
                        <MudText>@Localizer["Export"]</MudText>
                    }
                </MudButton>
            </MudStack>
            <MudSpacer />
            <MudAutocomplete @bind-Value="_searchCus" Placeholder="Search Customers" Adornment="Adornment.Start" Immediate="true"
                             AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"
                             Clearable ResetValueOnEmptyText SearchFunc="SearchCustomer" ToStringFunc="CusidtoCusCode" />
        </ToolBarContent>
        <Columns>
            <HierarchyColumn T="M_Job"/>
            <PropertyColumn Property="x => x.JobNo" Title="@Localizer["Job No"]" Required CellStyleFunc="_cellStyleFunc">
                @* <CellTemplate>
                    <MudLink OnClick="@(() => OpenDetailHBL(context.Item))">@context.Item.hbl</MudLink>
                </CellTemplate> *@
                <FooterTemplate>
                    Total
                </FooterTemplate>
            </PropertyColumn>
            <PropertyColumn Property="x => x.statusJob" Title="@Localizer["Status"]" Required CellStyleFunc="_cellStyleFunc" />
            <PropertyColumn Property="@(x => x.MBLs != null ? x.MBLs.FirstOrDefault()!.ETA : null)" Title="@Localizer["Open Date"]" Required CellStyleFunc="_cellStyleFunc" />
            <PropertyColumn Property="@(x => x.MBLs != null ? x.MBLs.FirstOrDefault()!.ETD : null)" Title="@Localizer["Pending Date"]" Required CellStyleFunc="_cellStyleFunc" />
            <PropertyColumn Property="@(x => string.IsNullOrEmpty(x.Loai) ? null : (x.Loai.Contains("I") ? "Inbound" : "Outbound"))" Title="@Localizer["Direction"]" Required CellStyleFunc="_cellStyleFunc" />
            <PropertyColumn Property="@(x => string.IsNullOrEmpty(x.Loai) ? null : (x.Loai.Contains("S") ? "Sea Freight" : "Air Freight"))" Title="@Localizer["Moving Type"]" Required CellStyleFunc="_cellStyleFunc" />
            <PropertyColumn Property="@(x => x.FLC)" Title="@Localizer["Handling Term"]" Required CellStyleFunc="_cellStyleFunc" />
            <PropertyColumn Property="@(x => x.MBLs != null ? AgentidtoName(x.MBLs.FirstOrDefault()!.AgentID) : null)" Title="@Localizer["Handling Agent"]" Required CellStyleFunc="_cellStyleFunc" />
            <PropertyColumn Property="@(x => x.MBLs != null ? x.MBLs.FirstOrDefault()!.Air_IssuingCarrier : null)" Title="@Localizer["Handling Carrier"]" Required CellStyleFunc="_cellStyleFunc" />
        </Columns>
        <ChildRowContent>
            <IndexHBL MBLDetails="context.Item.MBLs" Customers="Customers" />
        </ChildRowContent>
    </MudDataGrid>
</MudContainer>

@code {

    void CallSnackBar(string message, MudBlazor.Severity severity)
    {

        Snackbar.Configuration.SnackbarVariant = Variant.Filled;
        Snackbar.Configuration.MaxDisplayedSnackbars = 3;
        Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopRight;
        Snackbar.Add(message, severity);
    }

    string usr;
    AuthUser userdetail;
    List<string> trangthais = new List<string>();
    List<TrangThai> tts = new List<TrangThai>();
    List<M_Customer> Customers = new List<M_Customer>();
    List<ChargeModel> charges = new List<ChargeModel>();
    CultureInfo _en = CultureInfo.GetCultureInfo("en-US");
    protected async override Task OnInitializedAsync()
    {
        try
        {
            _loading = true;
            userdetail = asv.GetUserDetail();
            usr = asv.GetAuth().Result.User.Identity!.Name!;
        }
        catch(Exception ex)
        {
            CallSnackBar("Please slow down!", MudBlazor.Severity.Error);

        }
        finally
        {
            _loading = false;
        }
    }

    bool rendered = false;
    protected async override Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _loading = true;
            tts = await supsv.GetListTrangThai();
            Customers = await csv.GetList(userdetail);
            trangthais = tts.Where(x => x.Tieude.ToLower() == "job").OrderBy(x => x.Noidung).Select(x => x.Noidung).ToList();
            charges = await supsv.GetListCharge();
            rendered = true;
            _loading = false;
        }
    }

    bool _loading = false;
    List<M_Job> Listdata = new List<M_Job>();
    List<M_Debit> ListDebit = new List<M_Debit>();
    List<M_Credit> ListCredit = new List<M_Credit>();
    List<M_MBL> MBLs = new List<M_MBL>();
    List<M_Job> Jobs = new List<M_Job>();
    M_Job jobdetail;
    async Task Refresh(DateRange frmtoDate)
    {
        try
        {
            _loading = true;
            Listdata.Clear();
            jobdetail = null;
            await Task.Delay(500);
            StateHasChanged();
            if (!await ssv.CheckPermission(usr, "View", "Shipment"))
            {
                CallSnackBar("You have not access to view", MudBlazor.Severity.Warning);
                return;
            }
            Listdata = await shipsv.GetListJob(frmtoDate);
            // if (Listdata.Count > 0)
            // {
            //     MBLs = await shipsv.GetListMBLHBLs(Listdata);
            //     ListDebit = await shipsv.GetListDebitHBLs(Listdata);
            //     ListCredit = await shipsv.GetListCreditHBLs(Listdata);
            // }
            // if (MBLs.Count > 0)
            //     Jobs = await shipsv.GetListJobByMBLs(MBLs);
        }
        catch(Exception ex)
        {
            CallSnackBar(ex.Message, MudBlazor.Severity.Error);
        }
        finally
        {
            _loading = false;
        }

    }
    MudDataGrid<M_Job> mudTable;

    private int selectedRowNumber = -1;
    private string SelectedRowClassFunc(M_Job Sis, int rowNumber)
    {
        if (selectedRowNumber == rowNumber)
        {
            selectedRowNumber = -1;
            return string.Empty;
        }
        else if (mudTable.SelectedItem != null && mudTable.SelectedItem.Equals(Sis))
        {
            selectedRowNumber = rowNumber;
            return "selected";
        }
        else
        {
            return string.Empty;
        }
    }
    void RowClicked(DataGridRowClickEventArgs<M_Job> args)
    {
        jobdetail = args.Item;
    }

    void RowRightClicked(DataGridRowClickEventArgs<M_Job> args)
    {

        //_events.Insert(0, $"Event = RowRightClick, Index = {args.RowIndex}, Data = {System.Text.Json.JsonSerializer.Serialize(args.Item)}");
    }

    private Func<M_Job, string> _cellStyleFunc => x =>
    {
        // var profitFreight = TProfit_Job(x.JobID, "FREIGHT");
        // var profitLocal = TProfit_Job(x.JobID, "LOCAL");
        // var profitAll = TProfit_Job(x.JobID, "");
