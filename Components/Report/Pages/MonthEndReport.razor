        // if (profitFreight < 0 || profitLocal < 0 || profitAll < 0 || profitNotCom < 0)
        //     return "color: #FF5733";

        return "color: #087210"; // XANH

    };
    string formatDate(DateTime? date)
    {
        if(date == null)
            return string.Empty;
        return date.Value.ToString("dd/MMM/yyyy");
    }
    bool chkPending = false, chkDeli = false, chkCancel = false, ChkOnTime = false, ChkLate = false, chkVAT = false, chkUSD = true;

    private Guid _searchCus;
    private Func<M_Job, bool> _quickFilter => x =>
    {
        // 1. Kiểm tra theo loại (checkbox)
        bool matchLoai = !chkDeli && !chkPending && !chkCancel && !ChkLate && !ChkOnTime
                         || (chkDeli && x.statusJob?.Contains("Deli", StringComparison.OrdinalIgnoreCase) == true)
