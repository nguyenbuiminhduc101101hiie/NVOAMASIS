                         // || (ChkOnTime && CheckOnTime(x) == 1 == true)
                         ;

        // 2. Kiểm tra theo search
        bool matchSearch = true;

        // if (_searchCus != Guid.Empty)
        // {
        //     matchSearch = (x.CustomerID == _searchCus);
        // }

        return matchLoai && matchSearch;
    };

    DateRange frmtoDate = new DateRange(new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1),
                                        new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1).AddMonths(1).AddDays(-1));
    string CusidtoCusCode(Guid cusid)
    {
        if (cusid == null || cusid == Guid.Empty)
            return string.Empty;
        var rs = Customers.FirstOrDefault(x => x.Customer_ID == cusid);
        return rs == null ? string.Empty : rs.COMPANY!;
    }
    string Charidtocharge(Guid id)
    {
        if (id == Guid.Empty)
            return string.Empty;
        var rs = charges.FirstOrDefault(x => x.CHARGE_ID == id);
        return rs == null ? string.Empty : $"{rs.CHARGE_CODE} - {rs.CHARGE}"!;
    }
    string CharidtoLoaidv(Guid id)
    {
        if (id == Guid.Empty)
            return string.Empty;
        var rs = charges.FirstOrDefault(x => x.CHARGE_ID == id);
        return rs == null ? string.Empty : $"{rs.loaidichvu_charge}"!;
    }
    double? TDebit_(Guid id)
    {
        var debit = ListDebit.Where(x => x.hblid == id).ToList();
        return debit.Sum(x =>
        {
            var tien = chkVAT ? x.thanhtiensauthue : x.thanhtien;
            if (chkUSD)
            {
                return x.tiente == "USD"
                    ? tien * 1
                    : tien / (x.tigiadebit == 0 ? 1 : x.tigiadebit); // tránh chia 0
            }
            else if (!chkUSD)
            {
                return x.tiente == "VND"
                    ? tien * 1
                    : tien * x.tigiadebit;
            }
            return tien; 
        });
    }
    double? TCredit_(Guid id)
    {
        var credit = ListCredit.Where(x => x.hblid == id).ToList();
        return credit.Sum(x =>
        {
            var tien = chkVAT ? x.thanhtiensauthue : x.thanhtien;
            if (chkUSD)
            {
                return x.tiente == "USD"
                    ? tien * 1
                    : tien / (x.tigiacredit == 0 ? 1 : x.tigiacredit); // tránh chia 0
            }
            else if (!chkUSD)
            {
                return x.tiente == "VND"
                    ? tien * 1
                    : tien * x.tigiacredit;
            }
            return tien;
        });
    }
    double? TProfit_(Guid id, string type)
    {
        var debit = ListDebit.Where(x => x.hblid == id).ToList();
        var credit = ListCredit.Where(x => x.hblid == id).ToList();
        var totaldebit = debit.Sum(x =>
        {
            var tien = chkVAT ? x.thanhtiensauthue : x.thanhtien;
            if (chkUSD)
            {
                return x.tiente == "USD"
                    ? tien * 1
                    : tien / (x.tigiadebit == 0 ? 1 : x.tigiadebit); // tránh chia 0
            }
            else if (!chkUSD)
            {
                return x.tiente == "VND"
                    ? tien * 1
                    : tien * x.tigiadebit;
            }
            return tien;
        });
        var totalcredit = credit.Sum(x =>
        {
            var tien = chkVAT ? x.thanhtiensauthue : x.thanhtien;
            if (chkUSD)
            {
                return x.tiente == "USD"
                    ? tien * 1
                    : tien / (x.tigiacredit == 0 ? 1 : x.tigiacredit); // tránh chia 0
            }
            else if (!chkUSD)
            {
                return x.tiente == "VND"
                    ? tien * 1
                    : tien * x.tigiacredit;
            }
            return tien;
        });
        return totaldebit - totalcredit;
    }
    private bool _processingUpload = false;
    async Task ExportReport()
    {
        try
        {
            _processingUpload = true;
            StateHasChanged();
            await Task.Delay(1);
            var rs = await rsv.ImportToExcel(Listdata, frmtoDate);
            CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
        }
        catch(Exception ex)
        {
            CallSnackBar("Throw exception: " + ex.Message, MudBlazor.Severity.Error);
        }
        finally
        {
            _processingUpload = false;
        }
    }
    private async Task<IEnumerable<Guid>> SearchCustomer(string text)
    {
        try
        {
            if (string.IsNullOrWhiteSpace(text))
            {
                return Customers.Select(x => x.Customer_ID);
            }
            // MBL.Porname = mst_Consignee;
            return Customers.Where(x => (x.shortname + "_" + x.COMPANY).Contains(text, StringComparison.OrdinalIgnoreCase)).Select(x => x.Customer_ID);
        }
        catch (Exception)
        {
            throw;
        }
    }
    string AgentidtoName(Guid id)
    {
        if (id == null || id == Guid.Empty)
            return string.Empty;
        var rs = Customers.FirstOrDefault(x => x.Customer_ID == id);
        return rs == null ? string.Empty : rs.COMPANY!;
    }
}