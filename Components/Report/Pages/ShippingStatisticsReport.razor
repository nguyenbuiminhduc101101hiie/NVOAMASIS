
@inject CustomerService csv
@inject SupportServices supsv
@inject SharedServices ssv
@inject AccountService asv
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject ShipmentService shipsv
@inject ReportServices rsv
@inject IStringLocalizer<SharedResource> Localizer
@inject IJSRuntime JS
@attribute [Authorize]
@using System.Globalization﻿

<PageTitle>@Localizer["Shipping Statistics"]</PageTitle>
<div class="product-price-page">
    <PpScreenHeader Title="@Localizer["Shipping Statistics"]" Subtitle="7.1 · Shipment KPI and export" />
    <MudPaper Class="product-price-card" Elevation="0">
<MudContainer MaxWidth=MaxWidth.False Class="pa-2">

    <MudPaper Class="shipping-statistics-toolbar pa-2 mb-2" Elevation="0">
        <MudStack Spacing="2">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="shipping-statistics-toolbar-row">
                <MudStack Row="true" Justify="Justify.FlexStart" Spacing="3" AlignItems="AlignItems.Center" Class="shipping-statistics-toolbar-actions">
                    <MudDateRangePicker @bind-DateRange="frmtoDate" Label="From - To Date" Color="Color.Primary" />
                    <MudIconButton HtmlTag="label"
                                   OnClick="@(()=>Refresh(frmtoDate))"
                                   Size="Size.Large" Color="Color.Primary" Variant="Variant.Text"
                                   Icon="@Icons.Material.Filled.Search" />
                    <MudButton Disabled="_processingUpload"
                               OnClick="@ExportReport"
                               Size="Size.Small" Color="Color.Tertiary" Variant="Variant.Filled"
                               StartIcon="@Icons.Material.Filled.Download">
                        @if (_processingUpload)
                        {
                            <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                            <MudText Class="ms-2">Processing</MudText>
                        }
                        else
                        {
                            <MudText>@Localizer["Export"]</MudText>
                        }
                    </MudButton>
                    <MudButton Disabled="_processingUpload"
                               OnClick="@ExportCostReport"
                               Size="Size.Small" Color="Color.Tertiary" Variant="Variant.Filled"
                               StartIcon="@Icons.Material.Filled.Download">
                        @if (_processingUpload)
                        {
                            <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                            <MudText Class="ms-2">Processing</MudText>
                        }
                        else
                        {
                            <MudText>@Localizer["ExportCostReport"]</MudText>
                        }
                    </MudButton>
                </MudStack>
                <MudAutocomplete @bind-Value="_searchCus" Placeholder="Search Customers" Adornment="Adornment.Start" Immediate="true"
                                 AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="shipping-statistics-customer-search"
                                 Clearable ResetValueOnEmptyText SearchFunc="SearchCustomer" ToStringFunc="CusidtoCusCode" />
            </MudStack>
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="shipping-statistics-type-filter">
                <MudText Typo="Typo.caption" Class="shipping-statistics-filter-label">Type</MudText>
                <MudSwitch @bind-Value="chkSI" Label="SI" Color="Color.Primary" Size="Size.Small" Class="shipment-type-switch" />
                <MudSwitch @bind-Value="chkSE" Label="SE" Color="Color.Primary" Size="Size.Small" Class="shipment-type-switch" />
                <MudSwitch @bind-Value="chkAI" Label="AI" Color="Color.Primary" Size="Size.Small" Class="shipment-type-switch" />
                <MudSwitch @bind-Value="chkAE" Label="AE" Color="Color.Primary" Size="Size.Small" Class="shipment-type-switch" />
                <MudSwitch @bind-Value="chkTruck" Label="Truck" Color="Color.Primary" Size="Size.Small" Class="shipment-type-switch" />
                <MudSwitch @bind-Value="chkCustoms" Label="Customs" Color="Color.Primary" Size="Size.Small" Class="shipment-type-switch" />
            </MudStack>
        </MudStack>
    </MudPaper>

    <MudDataGrid T="ShippingStatisticGridItem" Items="@ListdataGrid" Filterable="true" @ref="mudTable" Class="table-shipment-bg"
                         FilterMode="@DataGridFilterMode.Simple" Dense="true" Virtualize="true" Height="calc(100vh - 48vh);"
                         FixedHeader="true" FixedFooter="true" HeaderClass="no-wrap" FooterClass="no-wrap" RowClassFunc="@SelectedRowClassFunc"
                         RowClick="@RowClicked" RowContextMenuClick="RowRightClicked" Bordered="true" RowClass="no-wrap-cell"
                         ColumnResizeMode="ResizeMode.Column" Loading="_loading">
        <Columns>
            <PropertyColumn Property="x => x.STT" Title='@Localizer["No."]' Required CellStyleFunc="_cellStyleFunc"/>
            <PropertyColumn Property="x => x.CustomerName" Title="Customer" CellStyleFunc="_cellStyleFunc"/>
            <PropertyColumn Property="x => x.SoHD" Title="Số HĐ" CellStyleFunc="_cellStyleFunc"/>
            <TemplateColumn Title="Ngày lấy hàng" CellStyleFunc="_cellStyleFunc">
                <CellTemplate Context="context">@formatDate(context.Item.NgayDukienLayHang)</CellTemplate>
            </TemplateColumn>
            <PropertyColumn Property="x => x.LoaiCont" Title='@Localizer["loaicont"]' CellStyleFunc="_cellStyleFunc"/>
            <PropertyColumn Property="x => x.XuatNhap" Title="Xuất/Nhập" CellStyleFunc="_cellStyleFunc"/>
            <PropertyColumn Property="x => x.ContainerNos" Title='@Localizer["Cont. No."]' CellStyleFunc="_cellStyleFunc"/>
            <PropertyColumn Property="x => x.HBL" Title='@Localizer["HBL No"]' CellStyleFunc="_cellStyleFunc"/>
            <PropertyColumn Property="x => x.DiaDiemNhanHang" Title="Địa điểm nhận hàng" CellStyleFunc="_cellStyleFunc"/>
            <PropertyColumn Property="x => x.ContainerLocationEmpty" Title="Vị trí cont rỗng" CellStyleFunc="_cellStyleFunc"/>
            <PropertyColumn Property="x => x.DiaDiemTraHang" Title="Địa điểm trả hàng" CellStyleFunc="_cellStyleFunc"/>
            <TemplateColumn Title="Cước vận chuyển" CellStyleFunc="_cellStyleFunc">
                <CellTemplate Context="context">@FormatMoney(context.Item.CuocVanChuyen)</CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Phụ thu" CellStyleFunc="_cellStyleFunc">
                <CellTemplate Context="context">@FormatMoney(context.Item.PhuThu)</CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="VAT" CellStyleFunc="_cellStyleFunc">
                <CellTemplate Context="context">@FormatMoney(context.Item.VAT)</CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Tổng tiền HĐ" CellStyleFunc="_cellStyleFunc">
                <CellTemplate Context="context">@FormatMoney(context.Item.TongTienHoaDon)</CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Phí nâng" CellStyleFunc="_cellStyleFunc">
                <CellTemplate Context="context">@FormatMoney(context.Item.PhiNang)</CellTemplate>
            </TemplateColumn>
            <PropertyColumn Property="x => x.SoHDNang" Title="Số HĐ nâng" CellStyleFunc="_cellStyleFunc"/>
            <TemplateColumn Title="Phí hạ" CellStyleFunc="_cellStyleFunc">
                <CellTemplate Context="context">@FormatMoney(context.Item.PhiHa)</CellTemplate>
            </TemplateColumn>
            <PropertyColumn Property="x => x.SoHDHa" Title="Số HĐ hạ" CellStyleFunc="_cellStyleFunc"/>
            <TemplateColumn Title="Phí cân" CellStyleFunc="_cellStyleFunc">
                <CellTemplate Context="context">@FormatMoney(context.Item.PhiCan)</CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Bốc xếp" CellStyleFunc="_cellStyleFunc">
                <CellTemplate Context="context">@FormatMoney(context.Item.BocXep)</CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Phí khác" CellStyleFunc="_cellStyleFunc">
                <CellTemplate Context="context">@FormatMoney(context.Item.PhiKhac)</CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Tổng phí" CellStyleFunc="_cellStyleFunc">
                <CellTemplate Context="context">@FormatMoney(context.Item.TongPhi)</CellTemplate>
            </TemplateColumn>
        </Columns>
    </MudDataGrid>
</MudContainer>
    </MudPaper>
</div>

<style>
    .shipping-statistics-toolbar {
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        background: #ffffff;
    }

    .shipping-statistics-toolbar-row,
    .shipping-statistics-type-filter,
    .shipping-statistics-toolbar-actions {
        flex-wrap: wrap;
        gap: 8px;
    }

    .shipping-statistics-filter-label {
        color: #475569;
        font-weight: 600;
        margin-right: 4px;
        white-space: nowrap;
    }

    .shipping-statistics-customer-search {
        min-width: 260px;
        max-width: 360px;
        flex: 0 1 360px;
    }

    .shipment-type-switch .mud-typography {
        font-size: 12px;
        white-space: nowrap;
    }
</style>

@code {

    void CallSnackBar(string message, MudBlazor.Severity severity)
    {

        Snackbar.Configuration.SnackbarVariant = Variant.Filled;
        Snackbar.Configuration.MaxDisplayedSnackbars = 3;
        Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopRight;
        Snackbar.Add(message, severity);
    }

    string usr;
    AuthUser userdetail;
    List<string> trangthais = new List<string>();
    List<TrangThai> tts = new List<TrangThai>();
    List<M_Customer> Customers = new List<M_Customer>();
    List<ChargeModel> charges = new List<ChargeModel>();
    CultureInfo _en = CultureInfo.GetCultureInfo("en-US");
    protected async override Task OnInitializedAsync()
    {
        try
        {
            _loading = true;
            userdetail = asv.GetUserDetail();
            usr = asv.GetAuth().Result.User.Identity!.Name!;
        }
        catch(Exception ex)
        {
            CallSnackBar("Please slow down!", MudBlazor.Severity.Error);

        }
        finally
        {
            _loading = false;
        }
    }

    bool rendered = false;
    protected async override Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _loading = true;
            tts = await supsv.GetListTrangThai();
            Customers = await csv.GetList(userdetail);
            trangthais = tts.Where(x => x.Tieude.ToLower() == "job").OrderBy(x => x.Noidung).Select(x => x.Noidung).ToList();
            charges = await supsv.GetListCharge();
            rendered = true;
            _loading = false;
        }
    }

    bool _loading = false;
    List<M_HBL> Listdata = new List<M_HBL>();
    List<ShippingStatisticGridItem> ListdataGrid = new List<ShippingStatisticGridItem>();
    ShippingStatisticGridItem? detail;
    async Task Refresh(DateRange frmtoDate)
    {
        try
        {
            _loading = true;
            Listdata.Clear();
            ListdataGrid.Clear();
            detail = null;
            await Task.Delay(500);
            StateHasChanged();
            if (!await ssv.CheckPermission(usr, "View", "Shipping_Statistics"))
            {
                CallSnackBar("You have not access to view", MudBlazor.Severity.Warning);
                return;
            }
            Listdata = await shipsv.GetListHBLTruckDateRange(frmtoDate, chkSI, chkSE, chkAI, chkAE, chkTruck, chkCustoms);
            if (_searchCus != Guid.Empty)
                Listdata = Listdata.Where(x => x.CustomerID == _searchCus).ToList();
            if (Listdata.Count == 0)
            {
                CallSnackBar("No Data", MudBlazor.Severity.Warning);
                _loading = false;
                return;
            }
            ListdataGrid = await rsv.GetShippingStatisticGridItems(Listdata);
        }
        catch(Exception ex)
        {
            CallSnackBar(ex.Message, MudBlazor.Severity.Error);
        }
        finally
        {
            _loading = false;
        }

    }
    MudDataGrid<ShippingStatisticGridItem> mudTable;

    private int selectedRowNumber = -1;
    private string SelectedRowClassFunc(ShippingStatisticGridItem Sis, int rowNumber)
    {
        if (selectedRowNumber == rowNumber)
        {
            selectedRowNumber = -1;
            return string.Empty;
        }
        else if (mudTable.SelectedItem != null && mudTable.SelectedItem.Equals(Sis))
        {
            selectedRowNumber = rowNumber;
            return "selected";
        }
        else
        {
            return string.Empty;
        }
    }
    void RowClicked(DataGridRowClickEventArgs<ShippingStatisticGridItem> args)
    {
        detail = args.Item;
    }

    void RowRightClicked(DataGridRowClickEventArgs<ShippingStatisticGridItem> args)
    {

        //_events.Insert(0, $"Event = RowRightClick, Index = {args.RowIndex}, Data = {System.Text.Json.JsonSerializer.Serialize(args.Item)}");
    }

    private Func<ShippingStatisticGridItem, string> _cellStyleFunc => x =>
    {
        // var profitFreight = TProfit_Job(x.JobID, "FREIGHT");
        // var profitLocal = TProfit_Job(x.JobID, "LOCAL");
        // var profitAll = TProfit_Job(x.JobID, "");
        // var profitNotCom = TProfit_Job(x.JobID, "notCOM");

        // if (profitFreight < 0 || profitLocal < 0 || profitAll < 0 || profitNotCom < 0)
        //     return "color: #FF5733";

        return "color: #087210"; // XANH

    };
    string formatDate(DateTime? date)
    {
        if(date == null)
            return string.Empty;
        return date.Value.ToString("dd/MMM/yyyy");
    }
    string FormatMoney(double? amount) =>
        amount.HasValue ? amount.Value.ToString("N0", _en) + " ₫" : "0 ₫";
    bool chkPending = false, chkDeli = false, chkCancel = false, ChkOnTime = false, ChkLate = false, chkVAT = false, chkUSD = true;
    bool chkSI = false, chkSE = false, chkAI = false, chkAE = false, chkTruck = true, chkCustoms = false;

    private Guid _searchCus;

    DateRange frmtoDate = new DateRange(new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1),
                                        new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1).AddMonths(1).AddDays(-1));
    string CusidtoCusCode(Guid cusid)
    {
        if (cusid == null || cusid == Guid.Empty)
            return string.Empty;
        var rs = Customers.FirstOrDefault(x => x.Customer_ID == cusid);
        return rs == null ? string.Empty : rs.COMPANY!;
    }
    string Charidtocharge(Guid id)
    {
        if (id == Guid.Empty)
            return string.Empty;
        var rs = charges.FirstOrDefault(x => x.CHARGE_ID == id);
        return rs == null ? string.Empty : $"{rs.CHARGE_CODE} - {rs.CHARGE}"!;
    }
    string CharidtoLoaidv(Guid id)
    {
        if (id == Guid.Empty)
            return string.Empty;
        var rs = charges.FirstOrDefault(x => x.CHARGE_ID == id);
        return rs == null ? string.Empty : $"{rs.loaidichvu_charge}"!;
    }
    private bool _processingUpload = false;
    async Task ExportReport()
    {
        try
        {
            _processingUpload = true;
            StateHasChanged();
            await Task.Delay(1);
            if (Listdata.Count == 0)
            {
                CallSnackBar("No Data", MudBlazor.Severity.Warning);
                return;
            }
            var rs = await rsv.BangKeSanLuongVanChuyenExcel(Listdata, frmtoDate);
            CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
        }
        catch(Exception ex)
        {
            CallSnackBar("Throw exception: " + ex.Message, MudBlazor.Severity.Error);
        }
        finally
        {
            _processingUpload = false;
        }
    }
    private bool _processingUploadCost = false;
    async Task ExportCostReport()
    {
        try
        {
            _processingUploadCost = true;
            StateHasChanged();
            await Task.Delay(1);
            if (Listdata.Count == 0)
            {
                CallSnackBar("No Data", MudBlazor.Severity.Warning);
                return;
            }
            var rs = await rsv.BangKeChiPhiVanChuyenExcel(Listdata, frmtoDate);
            CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
        }
        catch(Exception ex)
        {
            CallSnackBar("Throw exception: " + ex.Message, MudBlazor.Severity.Error);
        }
        finally
        {
            _processingUploadCost = false;
        }
    }
    private async Task<IEnumerable<Guid>> SearchCustomer(string text)
    {
        try
        {
            if (string.IsNullOrWhiteSpace(text))
            {
                return Customers.Select(x => x.Customer_ID);
            }
            // MBL.Porname = mst_Consignee;
            return Customers.Where(x => (x.shortname + "_" + x.COMPANY).Contains(text, StringComparison.OrdinalIgnoreCase)).Select(x => x.Customer_ID);
        }
        catch (Exception)
        {
            throw;
        }
    }
    string AgentidtoName(Guid id)
    {
        if (id == null || id == Guid.Empty)
            return string.Empty;
        var rs = Customers.FirstOrDefault(x => x.Customer_ID == id);
        return rs == null ? string.Empty : rs.COMPANY!;
    }

    public class ShippingStatisticGridItem
    {
        public int STT { get; set; }
        public Guid HblID { get; set; }
        public string CustomerName { get; set; } = "";
        public string SoHD { get; set; } = "";
        public DateTime? NgayDukienLayHang { get; set; }
        public string? LoaiCont { get; set; }
        public string XuatNhap { get; set; } = "";
        public string ContainerNos { get; set; } = "";
        public string HBL { get; set; } = "";
        public string? DiaDiemNhanHang { get; set; }
        public string? ContainerLocationEmpty { get; set; }
        public string? DiaDiemTraHang { get; set; }
        public double? CuocVanChuyen { get; set; }
        public double? PhuThu { get; set; }
        public double? VAT { get; set; }
        public double? TongTienHoaDon { get; set; }
        public double? PhiNang { get; set; }
        public string SoHDNang { get; set; } = "";
        public double? PhiHa { get; set; }
        public string SoHDHa { get; set; } = "";
        public double? PhiCan { get; set; }
        public double? BocXep { get; set; }
        public double? PhiKhac { get; set; }
        public double? TongPhi { get; set; }
    }
}