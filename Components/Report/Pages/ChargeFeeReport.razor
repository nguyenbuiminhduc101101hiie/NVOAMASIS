    private async Task ExportExcel()
    {
        if (!Rows.Any())
            return;

        try
        {
            ExcelPackage.LicenseContext = LicenseContext.NonCommercial;
            using var package = new ExcelPackage();
            var ws = package.Workbook.Worksheets.Add("Chi tiet phi");

            var headers = new[]
            {
                "Loại", "Mã phí", "Tên phí", "HBL", "BK No", "Shipper", "Consignee", "Vessel", "Voy",
                "POL", "POD", "DEL", "DVT", "Đơn giá", "SL", "Tiền tệ", "Thành tiền", "Thuế", "Sau thuế",
                "Tỷ giá", "Tỷ giá HĐ", "Thu/Chi hộ", "Debit/DNTT", "Invoice", "Type", "Nhóm", "Ghi chú",
                "User update", "Date update", "TK bán", "TK mua", "Approve", "Continued", "Editable",
                "Khóa", "Đã in", "Đã xuất HĐ", "DNTT", "DNTU", "SourceId", "HblId", "MblId", "CustomerId"
            };

            for (var col = 0; col < headers.Length; col++)
                ws.Cells[1, col + 1].Value = headers[col];

            for (var i = 0; i < Rows.Count; i++)
            {
                var row = Rows[i];
                var r = i + 2;
                ws.Cells[r, 1].Value = row.RowType;
                ws.Cells[r, 2].Value = row.ChargeCode;
                ws.Cells[r, 3].Value = row.ChargeName;
                ws.Cells[r, 4].Value = row.HblNo;
                ws.Cells[r, 5].Value = row.BkNo;
                ws.Cells[r, 6].Value = row.Shipper;
                ws.Cells[r, 7].Value = row.Consignee;
                ws.Cells[r, 8].Value = row.Vessel;
                ws.Cells[r, 9].Value = row.Voy;
                ws.Cells[r, 10].Value = row.Pol;
                ws.Cells[r, 11].Value = row.Pod;
                ws.Cells[r, 12].Value = row.Del;
                ws.Cells[r, 13].Value = row.Dvt;
                ws.Cells[r, 14].Value = row.UnitPrice;
                ws.Cells[r, 15].Value = row.Quantity;
                ws.Cells[r, 16].Value = row.Currency;
                ws.Cells[r, 17].Value = row.Amount;
                ws.Cells[r, 18].Value = row.Tax;
                ws.Cells[r, 19].Value = row.AmountAfterTax;
                ws.Cells[r, 20].Value = row.ExchangeRate;
                ws.Cells[r, 21].Value = row.InvoiceRate;
                ws.Cells[r, 22].Value = row.ThuChiHo;
                ws.Cells[r, 23].Value = row.DocumentNo;
                ws.Cells[r, 24].Value = row.InvoiceNo;
                ws.Cells[r, 25].Value = row.Type;
                ws.Cells[r, 26].Value = row.Group;
                ws.Cells[r, 27].Value = row.Note;
                ws.Cells[r, 28].Value = row.UserUpdate;
                ws.Cells[r, 29].Value = row.DateUpdate;
                ws.Cells[r, 30].Value = row.AccountSelling;
                ws.Cells[r, 31].Value = row.AccountBuying;
                ws.Cells[r, 32].Value = FormatBool(row.Approve);
                ws.Cells[r, 33].Value = FormatBool(row.Continued);
                ws.Cells[r, 34].Value = FormatBool(row.Editable);
                ws.Cells[r, 35].Value = FormatBool(row.Locked);
                ws.Cells[r, 36].Value = FormatBool(row.Printed);
                ws.Cells[r, 37].Value = FormatBool(row.IssuedInvoice);
                ws.Cells[r, 38].Value = FormatBool(row.DNTT);
                ws.Cells[r, 39].Value = FormatBool(row.DNTU);
                ws.Cells[r, 40].Value = row.SourceId.ToString();
                ws.Cells[r, 41].Value = row.HblId.ToString();
                ws.Cells[r, 42].Value = row.MblId.ToString();
                ws.Cells[r, 43].Value = row.CustomerId.ToString();
            }

            ws.Cells.AutoFitColumns();

            var fileName = $"Bao_cao_chi_tiet_theo_phi_{DateTime.Now:yyyyMMddHHmmss}.xlsx";
            var base64 = Convert.ToBase64String(package.GetAsByteArray());
            await JS.InvokeVoidAsync("saveAsFile", fileName, base64);
        }
        catch (Exception ex)
        {
            MessageSeverity = MudBlazor.Severity.Error;
            Message = $"Lỗi xuất Excel: {ex.Message}";
        }
    }

    private static string FormatNumber(double? value)
    {
        return value.HasValue ? value.Value.ToString("N2") : string.Empty;
    }

    private static string FormatBool(bool? value)
    {
        return value == true ? "Yes" : string.Empty;
    }

    private static Color GetRowColor(string rowType)
    {
        return rowType == "DEBIT" ? Color.Success : Color.Warning;
    }

