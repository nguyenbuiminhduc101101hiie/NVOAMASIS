@inject QuotationService QuoSv
@inject SharedServices ssv
@inject TrainScheduleServices trainsv
@inject BookingService bksv
@inject AccountService asv
@inject CustomerService Cussv
@inject IStringLocalizer<SharedResource> Localizer
@inject SupportServices supsv
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject FontService FontSizeService

<style>
    .detail-price-wrapper {
        background: linear-gradient(180deg, #f8fbff 0%, #eef6ff 100%);
        border: 1px solid #dbeafe;
        border-radius: 16px;
        padding: 12px;
        box-shadow: 0 8px 24px rgba(15, 23, 42, .08);
    }

    .detail-price-toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        padding: 8px 10px 12px 10px;
        flex-wrap: wrap;
    }

    .detail-price-title {
        font-weight: 700;
        color: #0f172a;
        letter-spacing: .2px;
    }

    .detail-price-actions {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
    }

    .detail-price-grid {
        border-radius: 14px;
        overflow: hidden;
        background: #ffffff !important;
        border: 1px solid #e2e8f0;
    }

    .detail-price-grid .mud-table-container {
        border-radius: 14px;
    }

    .detail-price-grid .mud-table thead th,
    .detail-price-grid .mud-data-grid-header th {
        background: #0f6fb3 !important;
        color: #ffffff !important;
        font-weight: 700 !important;
        font-size: 12px !important;
        white-space: nowrap;
        border-bottom: none !important;
        padding: 8px 10px !important;
    }

    .detail-price-grid .mud-table tbody tr {
        transition: background-color .15s ease, box-shadow .15s ease;
    }

    .detail-price-grid .mud-table tbody tr:hover {
        background: #eff6ff !important;
    }

    .detail-price-grid .mud-table tbody td {
        font-size: 12.5px !important;
        padding: 6px 10px !important;
        border-bottom: 1px solid #edf2f7 !important;
        vertical-align: middle;
        white-space: nowrap;
    }

    .detail-price-grid .mud-input-control {
        margin-top: 0 !important;
        margin-bottom: 0 !important;
    }

    .detail-price-grid .mud-input > input,
    .detail-price-grid .mud-input > textarea {
        font-size: 12.5px !important;
    }

    .detail-price-grid .mud-icon-button {
        padding: 4px !important;
    }

    .detail-price-grid .mud-checkbox {
        margin: auto;
        display: flex;
        justify-content: center;
    }

    .text-right input {
        text-align: right !important;
    }

    .custom-right-align {
        text-align: right !important;
    }

    .custom-label label,
    .labelCustomColor label {
        font-weight: 700 !important;
        color: #0f6fb3 !important;
        font-size: 12px !important;
    }

    .no-wrap {
        white-space: nowrap;
    }

    @@media (max-width: 900px) {
        .detail-price-wrapper {
            padding: 8px;
            border-radius: 12px;
        }

        .detail-price-toolbar {
            align-items: flex-start;
        }
    }
</style>



<div class="detail-price-wrapper">
    <div class="detail-price-toolbar">
        <MudText Typo="Typo.subtitle1" Class="detail-price-title">
            @Localizer["ADD_Detail"]
        </MudText>
        <div class="detail-price-actions">
            <MudButton HtmlTag="label"
                       OnClick="RefreshInfo"
                       Size="Size.Small"
                       Color="Color.Primary"
                       Variant="Variant.Filled"
                       StartIcon="@Icons.Material.Filled.Refresh">
                @Localizer["reload"]
            </MudButton>
            <MudButton HtmlTag="label"
                       @onclick="@(() => AddItemMarketInfo())"
                       Size="Size.Small"
                       Color="Color.Secondary"
                       Variant="Variant.Filled"
                       StartIcon="@Icons.Material.Filled.Add">
                @Localizer["new"]
            </MudButton>
        </div>
    </div>

<MudDataGrid T="M_Product_Price_detail_ALL" Items="@listTruck.ToList()" Filterable="true" @ref="muddetails" Class="detail-price-grid"
             FilterMode="@DataGridFilterMode.Simple" Dense="true" Virtualize="true"
             FixedHeader="true" FixedFooter="true" HeaderClass="no-wrap" FooterClass="no-wrap"
             ReadOnly="false" CommittedItemChanges="@CommittedItemDebitInfo"
             ColumnResizeMode="@(_resizeColumn ? ResizeMode.Column : ResizeMode.Container)"
             Loading="cusmarket_loading">
    <Columns>
        <TemplateColumn CellClass="d-flex justify-end" Title="">
            <CellTemplate>
                <MudIconButton Icon="@Icons.Material.Outlined.Edit"
                               Size="Size.Small"
                               Color="Color.Info"
                               OnClick="@(() => context.Actions.StartEditingItemAsync())" />
                <MudIconButton Icon="@Icons.Material.Outlined.Delete"
                               Size="Size.Small"
                               Color="Color.Error"
                               OnClick="@(() => DeleteItemDebitInfo(context.Item))" />
            </CellTemplate>
        </TemplateColumn>

        <PropertyColumn Property="x => x.Ngaybaogia" Title="@Localizer["NgayBaoGia"]" Format="dd/MM/yyyy">
            <EditTemplate>
                <MudDatePicker Class="custom-label" @bind-Date="context.Item.Ngaybaogia"
                               For="@(() => context.Item.Ngaybaogia)"
                               Label="@Localizer["NgayBaoGia"]"
                               DateFormat="dd/MM/yyyy"
                               Required="true" />

            </EditTemplate>
        </PropertyColumn>

        <PropertyColumn Property="x => ItemidtoChargeName(x.Itemid)" Title="@Localizer["Item"]" Required="false">
            <EditTemplate>
                <MudAutocomplete T="Guid?" Label="@Localizer["Item"]" Class="custom-label"
                                 @bind-Value="context.Item.Itemid"
                                 Required="true"
                                 SearchFunc="Search_Charge"
                                 ToStringFunc="GetChargeLabel" />

            </EditTemplate>
        </PropertyColumn>

        <PropertyColumn Property="x => x.Dongia" Title="@Localizer["unitprice"]" Format="#,##0" CellClass="custom-right-align" Required="false">
            <EditTemplate>
                <MudNumericField @bind-Value="context.Item.Dongia"
                                 Label="@Localizer["unitprice"]" Format="#,##0.##" Culture="@_en" T="double?"
                                 Class="text-right custom-label" Margin="Margin.Dense" HideSpinButtons="true" />

            </EditTemplate>
        </PropertyColumn>


        <PropertyColumn Property="x => x.Vat" Title="@Localizer["vat"]" Format="#,##0" CellClass="custom-right-align" Required="false">
            <EditTemplate>
                <MudNumericField @bind-Value="context.Item.Vat"
                                 Label="@Localizer["vat"]" Format="#,##0.##" Culture="@_en" T="double?"
                                 Class="text-right custom-label" Margin="Margin.Dense" HideSpinButtons="true" />

            </EditTemplate>
        </PropertyColumn>

        <PropertyColumn Property="x => x.Thanhtien" Title="@Localizer["ThanhTien"]" Format="#,##0" CellClass="custom-right-align" Required="false">
            <EditTemplate>
                <MudNumericField @bind-Value="context.Item.Thanhtien"
                                 Label="@Localizer["ThanhTien"]" Format="#,##0.##" Culture="@_en" T="double?"
                                 Class="text-right custom-label" Margin="Margin.Dense" HideSpinButtons="true" />

            </EditTemplate>
        </PropertyColumn>

        <PropertyColumn Property="x => x.Cur" Title="@Localizer["Loaitiente"]" Required="false">
            <EditTemplate>
                <MudSelect @bind-Value="context.Item.Cur" Label="@Localizer["Loaitiente"]" Class="custom-label" Margin="Margin.Dense">
                    <MudSelectItem Value="@("VND")">VND</MudSelectItem>
                    <MudSelectItem Value="@("USD")">USD</MudSelectItem>
                </MudSelect>
            </EditTemplate>
        </PropertyColumn>

        <PropertyColumn Property="x => x.Tigia"
                        Title="@Localizer["tigia"]"
                        Format="#,##0.##"
                        CellClass="custom-right-align"
                        Required="false">

            <EditTemplate>
                <MudNumericField @bind-Value="context.Item.Tigia"
                                    Label="@Localizer["tigia"]"
                                    Format="#,##0.##"
                                    Culture="@_en"
                                    T="double?"
                                    Required="true"
                                    HideSpinButtons="true"
                                    Class="text-right custom-label"
                                    Margin="Margin.Dense" />
            </EditTemplate>

        </PropertyColumn>

        <PropertyColumn Property="x => x.loaicont" Title="@Localizer["Cont. Size Type"]" Required="false">
          
        </PropertyColumn>

        <PropertyColumn Property="x => x.Dieukhoanthanhtoan" Title="@Localizer["dieukhoanthanhtoan"]" Required="false">
            <EditTemplate>
                <MudTextField @bind-Value="context.Item.Dieukhoanthanhtoan" Label="@Localizer["dieukhoanthanhtoan"]" Class="custom-label" Margin="Margin.Dense" />

            </EditTemplate>
        </PropertyColumn>

        <TemplateColumn Title="@Localizer["Approve"]">
            <CellTemplate>
                <MudCheckBox @bind-Checked="context.Item.Approve" @bind-Value="context.Item.Approve" @bind-Value:after="@(()=> OnApproveCheckboxWrapper(context.Item))">
                </MudCheckBox>
            </CellTemplate>

            <EditTemplate>
                <MudCheckBox @bind-Value="context.Item.Approve" Label="@Localizer["Approve"]" Class="custom-label" Margin="Margin.Dense" />
            </EditTemplate>
        </TemplateColumn>

        <PropertyColumn Property="x=>x.Createat" Title="@Localizer["CreatedAt"]" Class="custom-label" IsEditable="false">
        </PropertyColumn>

        <PropertyColumn Property="x=>x.Usercreate" Title="@Localizer["Nguoilap"]" Class="custom-label" IsEditable="false">
        </PropertyColumn>


    </Columns>
</MudDataGrid>
</div>

@code {
    [CascadingParameter] MudDialogInstance? MudDialog { get; set; }
    [Parameter] public Models.M_ImportCostRequest _ProductPrice_Import_Details { get; set; }
    [Parameter] public string Status { get; set; }
    private List<Models.ChargeModel> charges = new List<Models.ChargeModel>();
    private List<Models.M_Product_Price_detail_ALL> listTruck = new List<Models.M_Product_Price_detail_ALL>();
    bool cusmarket_loading = false;
    private MudDataGrid<Models.M_Product_Price_detail_ALL> muddetails;
    private string searchText_item = "";
    private List<ChargeModel> filteredCharges = new List<ChargeModel>();
    private bool _resizeColumn;
    public CultureInfo _de = CultureInfo.GetCultureInfo("de-DE");
    public CultureInfo _en = CultureInfo.GetCultureInfo("en-US");

    protected async override Task OnInitializedAsync()
    {
        charges = await QuoSv.Getcharge();

        await RefreshInfo();
    }

    async Task RefreshInfo()
    {
        try
        {
            cusmarket_loading = true;
            listTruck.Clear();
            StateHasChanged();

            await Task.Delay(500);

            if (!await ssv.CheckPermission(asv.GetAuth().Result.User.Identity!.Name!, "View", "Product_Price"))
            {
                CallSnackBar("You have not access to view", MudBlazor.Severity.Warning);
                return;
            }
            listTruck = await prsv.GetListProductPriceDetails_ALL(_ProductPrice_Import_Details.Id);
        }
        finally
        {
            cusmarket_loading = false;
        }

    }

    void CallSnackBar(string message, MudBlazor.Severity severity)
    {

        Snackbar.Configuration.SnackbarVariant = Variant.Filled;
        Snackbar.Configuration.MaxDisplayedSnackbars = 3;
        Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopRight;
        Snackbar.Add(message, severity);
    }
    async Task AddItemMarketInfo()
    {
        if (!await ssv.CheckPermission(asv.GetAuth().Result.User.Identity!.Name!, "View", "Product_Price"))
        {
            CallSnackBar("You have not access to view", MudBlazor.Severity.Warning);
            return;
        }
        var item = new M_Product_Price_detail_ALL();
        item.Createat = DateTime.Now.ToString();
        var UserName = asv.GetAuth().Result.User.Identity!.Name!;
        item.Usercreate = UserName;
        listTruck.Add(item);

        await muddetails.SetEditingItemAsync(listTruck.LastOrDefault()!);
    }

    async Task CommittedItemDebitInfo(M_Product_Price_detail_ALL item)
    {
