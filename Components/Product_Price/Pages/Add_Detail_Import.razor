@using System.Globalization
@inject ProductPriceServices prsv;
@inject GlobalServices gsv;
@inject EmailService emsv
@inject QuotationService QuoSv
@inject SharedServices ssv
@inject TrainScheduleServices trainsv
@inject BookingService bksv
@inject AccountService asv
@inject CustomerService Cussv
@inject IStringLocalizer<SharedResource> Localizer
@inject SupportServices supsv
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject FontService FontSizeService
@inject NotificationService _notificationService
@using System.Text.Json;
@inject HistoryLogService HistoryLogService
@inject ShipmentService shipsv
@inject tigiaVCBservices Vcbsv
<style>
    .pp-detail-shell {
        background: linear-gradient(180deg, #f8fbff 0%, #ffffff 42%);
        border: 1px solid #e5edf7;
        border-radius: 18px;
        padding: 14px;
        box-shadow: 0 10px 30px rgba(15, 23, 42, .07);
    }

    .pp-detail-toolbar {
        background: #ffffff;
        border: 1px solid #e6edf5;
        border-radius: 16px;
        padding: 10px 12px;
        margin-bottom: 12px;
        box-shadow: 0 6px 18px rgba(15, 23, 42, .05);
    }

    .pp-detail-toolbar .mud-button-root {
        border-radius: 999px;
        text-transform: none;
        font-weight: 700;
        letter-spacing: .01em;
        min-height: 34px;
        box-shadow: 0 4px 12px rgba(17, 138, 178, .14);
    }

    .pp-detail-grid-wrap {
        overflow: hidden;
        border: 1px solid #dbe7f3;
        border-radius: 18px;
        background: #ffffff;
        box-shadow: 0 8px 24px rgba(15, 23, 42, .06);
    }

    .pp-detail-grid {
        padding: 0 !important;
        font-size: 12.5px;
    }

    .pp-detail-grid .mud-table-container {
        border-radius: 18px;
    }

    .pp-detail-grid .mud-table {
        border-collapse: separate;
        border-spacing: 0;
    }

    .pp-detail-grid .mud-table-head,
    .pp-detail-grid .mud-table thead {
        background: linear-gradient(90deg, #0f7fa5 0%, #118ab2 55%, #14a3c7 100%) !important;
    }

    .pp-detail-grid .mud-table-head th,
    .pp-detail-grid .mud-table thead th {
        background: transparent !important;
        color: #ffffff !important;
        font-size: 12px;
        font-weight: 800;
        white-space: nowrap;
        padding: 8px 10px !important;
        border-bottom: none !important;
    }

    .pp-detail-grid .mud-table-body td,
    .pp-detail-grid .mud-table tbody td {
        padding: 6px 10px !important;
        vertical-align: middle;
        border-bottom: 1px solid #eef3f8 !important;
        max-width: 220px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .pp-detail-grid .mud-table-body tr:nth-child(even) {
        background-color: #fbfdff;
    }

    .pp-detail-grid .mud-table-body tr:hover {
        background-color: #eef9ff !important;
        cursor: pointer;
    }

    .pp-detail-grid .mud-table-body tr.selected,
    .pp-detail-grid .mud-table-body tr.selected:hover {
        background: linear-gradient(90deg, #0ea5e9 0%, #0284c7 100%) !important;
    }

    .pp-detail-grid .mud-table-body tr.selected td,
    .pp-detail-grid .mud-table-body tr.selected .mud-input,
    .pp-detail-grid .mud-table-body tr.selected .mud-input-control,
    .pp-detail-grid .mud-table-body tr.selected .mud-input-slot {
        color: #ffffff !important;
    }

    .pp-detail-grid .mud-icon-button {
        border-radius: 10px;
        padding: 5px;
    }

    .pp-detail-grid .mud-input-control {
        margin-top: 0 !important;
    }

    .pp-detail-grid .mud-input > input,
    .pp-detail-grid .mud-input textarea {
        font-size: 12.5px;
    }

    .labelCustomColor label,
    .custom-label .mud-input-label,
    .custom-label label {
        font-weight: 700;
        color: #118ab2 !important;
    }

    .text-right input,
    .custom-right-align {
        text-align: right !important;
    }

    .no-wrap {
        white-space: nowrap;
    }

    .pp-edit-user-box {
        background: #f8fbff;
        border: 1px dashed #bfd7ea;
        border-radius: 14px;
        padding: 8px;
    }

    .pp-new-button {
        background: linear-gradient(135deg, #7c3aed 0%, #2563eb 100%) !important;
        color: #ffffff !important;
    }

    .pp-new-row-alert {
        border-radius: 14px;
        margin-bottom: 12px;
        border: 1px solid #bfdbfe;
        background: #eff6ff;
    }

    .pp-detail-grid .mud-table-body tr:has(.mud-input-control),
    .pp-detail-grid .mud-table-body tr:has(.mud-picker) {
        background: linear-gradient(90deg, #eef8ff 0%, #ffffff 100%) !important;
        box-shadow: inset 4px 0 0 #118ab2;
    }

    .pp-detail-grid .mud-table-body tr:has(.mud-input-control) td,
    .pp-detail-grid .mud-table-body tr:has(.mud-picker) td {
        padding: 10px 10px !important;
        vertical-align: top;
        white-space: normal;
        overflow: visible;
        text-overflow: unset;
        max-width: none;
    }

    .pp-detail-grid .mud-table-body tr:has(.mud-input-control) .mud-input-control,
    .pp-detail-grid .mud-table-body tr:has(.mud-picker) .mud-input-control {
        background: #ffffff;
        border: 1px solid #d7e7f5;
        border-radius: 12px;
        padding: 2px 8px 4px 8px;
        box-shadow: 0 4px 12px rgba(15, 23, 42, .05);
    }

    .pp-detail-grid .mud-table-body tr:has(.mud-input-control) .mud-input-root,
    .pp-detail-grid .mud-table-body tr:has(.mud-picker) .mud-input-root {
        min-height: 34px;
    }

    .pp-detail-grid .mud-table-body tr:has(.mud-input-control) .mud-button-root,
    .pp-detail-grid .mud-table-body tr:has(.mud-picker) .mud-button-root {
        border-radius: 999px;
        text-transform: none;
        font-weight: 700;
        min-height: 32px;
    }

    .pp-detail-grid .mud-table-body tr:has(.mud-input-control) .mud-checkbox,
    .pp-detail-grid .mud-table-body tr:has(.mud-picker) .mud-checkbox {
        margin-top: 8px;
    }


    @@media (max-width: 960px) {
        .pp-detail-shell {
            padding: 8px;
            border-radius: 14px;
        }

        .pp-detail-grid .mud-table-body td,
        .pp-detail-grid .mud-table thead th {
            padding: 6px 8px !important;
        }
    }
</style>

<div class="pp-detail-shell">
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="pp-detail-toolbar" Spacing="2">
        <MudStack Spacing="0">
            <MudText Typo="Typo.subtitle2" Class="fw-bold">@Localizer["ADD_Detail"]</MudText>
            <MudText Typo="Typo.caption" Color="Color.Secondary">@_ProductPrice_Import_Details?.MaRFQ</MudText>
        </MudStack>

        <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
            <MudButton HtmlTag="label" OnClick="RefreshInfo"
                Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled"
                StartIcon="@Icons.Material.Filled.Refresh">
                @Localizer["reload"]
            </MudButton>
            <MudButton HtmlTag="label" @onclick="@(() => AddItemMarketInfo())"
                Class="pp-new-button"
                Size="Size.Small" Color="Color.Secondary" Variant="Variant.Filled"
                StartIcon="@Icons.Material.Filled.Add">
                @Localizer["new"]
            </MudButton>
        </MudStack>
    </MudStack>

    @if (listTruck.Any(x => x.Id == Guid.Empty))
    {
        <MudAlert Severity="MudBlazor.Severity.Info" Dense="true" Class="pp-new-row-alert">
            @Localizer["new"]: nhập thông tin trên dòng đang mở, sau đó bấm nút lưu của lưới để lưu chi tiết.
        </MudAlert>
    }

    <div class="pp-detail-grid-wrap">
        <MudDataGrid T="M_Product_Price_detail_ALL" Items="@listTruck.ToList()" Filterable="true" @ref="muddetails"
        Class="pp-detail-grid" Bordered="false" Hover="true" Loading="@cusmarket_loading"
        FilterMode="@DataGridFilterMode.Simple" Dense="true" Virtualize="true"
        FixedHeader="true" FixedFooter="true" HeaderClass="no-wrap" FooterClass="no-wrap"
        ReadOnly="false" RowClick="@RowClicked" RowClassFunc="@SelectedRowClassFunc" CommittedItemChanges="@CommittedItemDebitInfo"
        ColumnResizeMode="ResizeMode.Column">

    <Columns>
        <TemplateColumn CellClass="d-flex justify-end">
            <CellTemplate>

                <MudIconButton Icon="@Icons.Material.Outlined.Edit"
                OnClick="@(() => {
                           if (context.Item.Approve == false)
                           {
                                 detail = JsonSerializer.Deserialize<M_Product_Price_detail_ALL>(JsonSerializer.Serialize(context.Item)); 

                               context.Actions.StartEditingItemAsync();
                           }else{
                                CallSnackBar("Request Pricing đã được Approve!!! , vui lòng bỏ Approve", MudBlazor.Severity.Warning);
                                return;
                          }
                       })" />
                <MudIconButton Size="@Size.Small" Icon="@Icons.Material.Outlined.Delete" OnClick="@(()=>DeleteItemDebitInfo(context.Item))" />
            </CellTemplate>
        </TemplateColumn>

        <PropertyColumn Property="x => x.Ngaybaogia" Title="@Localizer["NgayBaoGia"]" Format="dd/MM/yyyy">
            <EditTemplate>
                <MudDatePicker Class="custom-label" @bind-Date="context.Item.Ngaybaogia"
                    For="@(() => context.Item.Ngaybaogia)"
                    Label="@Localizer["NgayBaoGia"]"
                    Margin="Margin.Dense"
                    DateFormat="dd/MM/yyyy"
                    Required="true" />
            </EditTemplate>
        </PropertyColumn>

        <PropertyColumn Property="x => ItemidtoChargeName(x.Itemid)" Title="@Localizer["Item"]" Required="false">
            <EditTemplate>
                <MudAutocomplete T="Guid?" Label="@Localizer["Item"]" Class="custom-label"
                    @bind-Value="context.Item.Itemid"
                    Margin="Margin.Dense"
                    Required="true"
                    SearchFunc="Search_Charge"
                    ToStringFunc="GetChargeLabel" />
            </EditTemplate>
        </PropertyColumn>

        <PropertyColumn Property="x => x.Dongia" Title="@Localizer["unitprice"]" Format="#,##0.##" CellClass="custom-right-align" Required="false">
            <EditTemplate>
                <MudNumericField @bind-Value="context.Item.Dongia"
                    Label="@Localizer["unitprice"]" Format="#,##0.##" Culture="@_en" T="double?"
                    Margin="Margin.Dense"
                    Class="text-right custom-label" TextChanged="@(e => CalculateTotal(context.Item))" HideSpinButtons="true" />
            </EditTemplate>
        </PropertyColumn>

        <PropertyColumn Property="x => x.Vat" Title="@Localizer["vat"]" Format="#,##0.##" CellClass="custom-right-align" Required="false">
            <EditTemplate>
                <MudNumericField @bind-Value="context.Item.Vat"
                    Label="@Localizer["vat"]" Format="#,##0.##" Culture="@_en" T="double?"
                    TextChanged="@(e => CalculateTotal(context.Item))"
                    Margin="Margin.Dense"
                    Class="text-right custom-label" HideSpinButtons="true" />
            </EditTemplate>
        </PropertyColumn>

        <PropertyColumn Property="x => x.Thanhtien" Title="@Localizer["ThanhTien"]" Format="#,##0.##" CellClass="custom-right-align" Required="false">
            <EditTemplate>
                <MudNumericField @bind-Value="context.Item.Thanhtien"
                    Label="@Localizer["ThanhTien"]" Format="#,##0.##" Culture="@_en" T="double?"
                    HideSpinButtons="true" Margin="Margin.Dense"
                    Class="text-right custom-label" />
            </EditTemplate>
        </PropertyColumn>

        <PropertyColumn Property="x => x.Cur" Title="@Localizer["Loaitiente"]" Required="false">
            <EditTemplate>
                <MudAutocomplete @bind-Value="context.Item.Cur" Label="@Localizer["Loaitiente"]"
                    Required="true" Class="custom-label" Margin="Margin.Dense" CoerceValue SearchFunc="SearchCurr" />
            </EditTemplate>
        </PropertyColumn>

        <PropertyColumn Property="x => x.Tigia" Title="@Localizer["tigia"]" Format="#,##0.##" CellClass="custom-right-align" Required="false">
            <EditTemplate>
                <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                    <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small"
                        Style="min-width: 80px; height: 36px; padding: 5px 10px;"
                        OnClick="@(() => GetTigia(context.Item))">
                        @Localizer["gettigia"]
                    </MudButton>
                    <MudNumericField @bind-Value="context.Item.Tigia"
                        Label="@Localizer["tigia"]"
                        Format="#,##0.##" Culture="@_en"
                        T="double?" Required="false" HideSpinButtons="true"
                        Margin="Margin.Dense"
                        Class="text-right custom-label" />
                </MudStack>
            </EditTemplate>
        </PropertyColumn>

        <PropertyColumn Property="x => x.loaicont" Title="@Localizer["Cont. Size Type"]" Required="false">
            <EditTemplate>
                <MudAutocomplete @bind-Value="context.Item.loaicont" Label="@Localizer["Cont. Size Type"]"
                    Required="true" Class="custom-label" Margin="Margin.Dense" CoerceValue SearchFunc="SearchContSizeType" />
            </EditTemplate>
        </PropertyColumn>

        <PropertyColumn Property="x => x.Dieukhoanthanhtoan" Title="@Localizer["dieukhoanthanhtoan"]" Required="false">
            <EditTemplate>
                <MudTextField @bind-Value="context.Item.Dieukhoanthanhtoan"
                    Label="@Localizer["dieukhoanthanhtoan"]"
                    Class="custom-label" Margin="Margin.Dense" />
            </EditTemplate>
        </PropertyColumn>

        <TemplateColumn Title="@Localizer["Approve"]">
            <CellTemplate>
                <MudCheckBox @bind-Checked="context.Item.Approve" @bind-Value="context.Item.Approve" @bind-Value:after="@(()=> OnApproveCheckboxWrapper(context.Item))">
                </MudCheckBox>
            </CellTemplate>

            <EditTemplate>
                <MudCheckBox @bind-Value="context.Item.Approve" Label="@Localizer["Approve"]" Class="custom-label" />
            </EditTemplate>
        </TemplateColumn>

        <PropertyColumn Property="x=>x.UserRespond" Title="@Localizer["UserRespond"]">
            <EditTemplate>
                <MudGrid Spacing="1" Class="pp-edit-user-box">
                    <MudItem xs="12" sm="3">
                        <MudAutocomplete Class="custom-label" T="string"
                            @bind-Value="UserRespond"
                            Label="@Localizer["User"]"
                            Margin="Margin.Dense"
                            SearchFunc="Search_User"
                            Immediate="true"
                            CoerceText="true"
                            Clearable="true"
                            MaxItems="100" />
                    </MudItem>
                    <MudItem xs="12" sm="1" Class="d-flex align-end">
                        <MudButton Style="background-color: #007BFF; color: white;" Size="Size.Small" Color="Color.Primary"
                            OnClick="() => Getuser(context.Item)">>>></MudButton>
                    </MudItem>
                    <MudItem xs="12" sm="4">
                        <MudTextField @bind-Value="context.Item.UserRespond" Class="custom-label"
                            Margin="Margin.Dense" Lines="2" Required="false" />
                    </MudItem>
                    <MudItem xs="12" sm="2" Class="d-flex align-end">
                        <MudButton HtmlTag="label" Disabled="_processingUpload_message"
                            @onclick="@(() => SendMessage(context.Item))"
                            Size="Size.Small" Color="Color.Tertiary" Variant="Variant.Filled"
                            StartIcon="@Icons.Material.Filled.Email">
                            @if (_processingUpload_message)
                            {
                                <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                                <MudText Class="ms-2">Processing</MudText>
                            }
                            else
                            {
                                <MudText>@Localizer["message"]</MudText>
                            }
                        </MudButton>
                    </MudItem>
                </MudGrid>
            </EditTemplate>
        </PropertyColumn>

        <PropertyColumn Property="x=>x.Createat" Title="@Localizer["CreatedAt"]" Class="custom-label" IsEditable="false">
        </PropertyColumn>

        <PropertyColumn Property="x=>x.Usercreate" Title="@Localizer["Nguoilap"]" Class="custom-label" IsEditable="false">
        </PropertyColumn>


    </Columns>
        </MudDataGrid>
    </div>
</div>

@code {
    [CascadingParameter] MudDialogInstance? MudDialog { get; set; }
    [Parameter] public Models.M_ImportCostRequest _ProductPrice_Import_Details { get; set; }
    [Parameter] public string Status { get; set; }
    private List<Models.ChargeModel> charges = new List<Models.ChargeModel>();
    private List<Models.M_Product_Price_detail_ALL> listTruck = new List<Models.M_Product_Price_detail_ALL>();
    bool cusmarket_loading = false;
    private MudDataGrid<Models.M_Product_Price_detail_ALL> muddetails;
    private int selectedRowNumber = -1;

    private void RowClicked(DataGridRowClickEventArgs<Models.M_Product_Price_detail_ALL> args)
    {
        detail = args.Item;
    }

    private string SelectedRowClassFunc(Models.M_Product_Price_detail_ALL item, int rowNumber)
    {
        if (selectedRowNumber == rowNumber)
        {
            selectedRowNumber = -1;
            return string.Empty;
        }

        if (muddetails?.SelectedItem != null && muddetails.SelectedItem.Equals(item))
        {
            selectedRowNumber = rowNumber;
            return "selected";
        }

        return string.Empty;
    }

    private string searchText_item = "";
    private List<ChargeModel> filteredCharges = new List<ChargeModel>();
    public string? UserRespond;
    public CultureInfo _de = CultureInfo.GetCultureInfo("de-DE");
    public CultureInfo _en = CultureInfo.GetCultureInfo("en-US");
    private List<string> ListUser { get; set; } = new List<string>();
    M_Product_Price_detail_ALL detail;
    string usr;
    List<string> contType = new List<string> { "20DC", "40DC", "40HC", "40RH", "45HC", "20RF", "40RF", "20OT", "40OT", "20FR", "40FR" };
    List<M_Container> Conts = new List<M_Container>();
    List<string> currs = new List<string>();
    protected async override Task OnInitializedAsync()
    {
        Conts = shipsv.GetListContainerAll();
        currs = await Vcbsv.GetCur();
        usr = asv.GetAuth().Result.User.Identity!.Name!;
        charges = await QuoSv.Getcharge();
        ListUser = await asv.GetList_User_handle() ?? new List<string>();
        await RefreshInfo();
    }

    async Task RefreshInfo()
    {
        try
        {
            cusmarket_loading = true;
            listTruck.Clear();
            StateHasChanged();

            await Task.Delay(500);

            if (!await ssv.CheckPermission(asv.GetAuth().Result.User.Identity!.Name!, "View", "Product_Price"))
            {
                CallSnackBar("You have not access to view", MudBlazor.Severity.Warning);
                return;
            }
            listTruck = await prsv.GetListProductPriceDetails_ALL(_ProductPrice_Import_Details.Id);
        }
        finally
        {
            cusmarket_loading = false;
        }

    }
    private async Task<IEnumerable<string?>> SearchContSizeType(string? text)
    {
        try
        {
            var items = Conts.Select(x => x.CTN_SIZE_TYPE).Distinct();

            if (string.IsNullOrEmpty(text))
            {
                return items;
            }
            // MBL.Porname = mst_Consignee;
            return items.Where(x => !string.IsNullOrEmpty(x) && x.Contains(text, StringComparison.OrdinalIgnoreCase));
        }
        catch (Exception)
        {
            throw;
        }
    }

    private async Task<IEnumerable<string>> SearchCurr(string? text)
    {
        if (string.IsNullOrWhiteSpace(text))
            return currs;

        return currs.Where(x => !string.IsNullOrEmpty(x) && x.Contains(text, StringComparison.OrdinalIgnoreCase));
    }

    void CallSnackBar(string message, MudBlazor.Severity severity)
    {

        Snackbar.Configuration.SnackbarVariant = Variant.Filled;
        Snackbar.Configuration.MaxDisplayedSnackbars = 3;
        Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopRight;
        Snackbar.Add(message, severity);
    }
    async Task AddItemMarketInfo()
    {
        if (!await ssv.CheckPermission(asv.GetAuth().Result.User.Identity!.Name!, "View", "Product_Price"))
        {
            CallSnackBar("You have not access to view", MudBlazor.Severity.Warning);
            return;
        }
        var item = new M_Product_Price_detail_ALL();
        item.Createat = DateTime.Now.ToString();
        item.Ngaybaogia = DateTime.Today;
        item.Cur = string.IsNullOrWhiteSpace(item.Cur) ? "VND" : item.Cur;
        item.Vat = item.Vat ?? 0;
        item.Tigia = item.Tigia ?? 1;
        item.Approve = false;
        var UserName = asv.GetAuth().Result.User.Identity!.Name!;
        item.Usercreate = UserName;
        item.Type = "Import";
        item.UserRespond = _ProductPrice_Import_Details.Usercreate;
        listTruck.Add(item);
        detail = item;
        selectedRowNumber = listTruck.Count - 1;

        await muddetails.SetEditingItemAsync(listTruck.LastOrDefault()!);
    }

    async Task CommittedItemDebitInfo(M_Product_Price_detail_ALL item)
    {
        if (!await ssv.CheckPermission(asv.GetAuth().Result.User.Identity!.Name!, "View", "Product_Price"))
        {
            CallSnackBar("You have not access to view", MudBlazor.Severity.Warning);
            return;
        }
        item.RFQ_Id = _ProductPrice_Import_Details.Id;
        item.Userupdate = asv.GetAuth().Result.User.Identity!.Name!;
        item.Dateupdate = DateTime.Now.ToString("dd/MMM/yyyy");
        // item.date = DateTime.Now.ToString();

        // item.userupdate = asv.GetAuth().Result.User.Identity!.Name!;

        var rs = item.Id != Guid.Empty ? await prsv.UpdateProductPrice_details_Truck(item, detail) : await prsv.CreateProductPrice_details_truck(item);
        CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);

        _ProductPrice_Import_Details.Trangthai = "Completed";
        await prsv.UpdateCreateProduct_Import(_ProductPrice_Import_Details);
        await RefreshInfo();
    }

    async Task DeleteItemDebitInfo(M_Product_Price_detail_ALL item)
    {
        if (item == null)
        {
            CallSnackBar("you must select 1 row.", MudBlazor.Severity.Warning);
            return;
        }
        if (item.Approve == true)
        {
            CallSnackBar("Data đã được Approve!!! , vui lòng bỏ Approve", MudBlazor.Severity.Warning);
            return;
        }
        var resultMess = await DialogService.ShowMessageBox(
                "Warning",
                "Deleting can not be undone!",
                yesText: "Delete!", cancelText: "Cancel");

        if (resultMess.HasValue)
        {

            var rs = await prsv.DeletepRODUCTdETAILS_Truck(item);
            string RFQNo = await prsv.GetMaRFQ_ByID(item.RFQ_Id);

            await HistoryLogService.LogAsync(usr, "DeleteDetails", "Product_Price", item.Id, RFQNo, new { OldData = item });
            CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
            await RefreshInfo();
        }

    }

    string ItemidtoChargeName(Guid? itemid)
    {
        if (itemid == null || itemid == Guid.Empty)
            return string.Empty;
        var rs = charges.FirstOrDefault(x => x.CHARGE_ID == itemid);
        return rs == null ? string.Empty : rs.CHARGE!;
    }

    private async Task FilterCharge()
    {

        if (string.IsNullOrWhiteSpace(searchText_item))
        {
            filteredCharges = charges;
        }
        else
        {
            filteredCharges = charges.Where(x => x.CHARGE != null)
                .Where(c => c.CHARGE_CODE.Contains(searchText_item, StringComparison.OrdinalIgnoreCase) ||
                            c.CHARGE.Contains(searchText_item, StringComparison.OrdinalIgnoreCase))
                .ToList();
        }

        await InvokeAsync(StateHasChanged); // Cập nhật giao diện
    }

    private string GetChargeLabel(Guid? id)
    {
        var customer = charges.FirstOrDefault(x => x.CHARGE_ID == id);
        return customer != null ? customer.CHARGE : string.Empty;
    }

    private async Task<IEnumerable<Guid?>> Search_Charge(string value)
    {
        if (string.IsNullOrEmpty(value))
            return charges.Select(x => (Guid?)x.CHARGE_ID);

        return charges
            .Where(x => (x.CHARGE).Contains(value, StringComparison.InvariantCultureIgnoreCase))
            .Select(x => (Guid?)x.CHARGE_ID);
    }

