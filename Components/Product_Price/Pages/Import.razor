        }

        if (await ssv.CheckPermission(asv.GetAuth().Result.User.Identity.Name, "Add", "Product_Price"))
        {

            DialogOptions closeOnEscapeKey = new DialogOptions() { CloseOnEscapeKey = true };
            var parameters = new DialogParameters<Add_Detail_Import> { { x => x._ProductPrice_Import_Details, tr }, { x => x.Status, "edit" } };

            var dialog = await DialogService.ShowAsync<Add_Detail_Import>(tr.Id == Guid.Empty ? "Add Detail Price Import" : "Add Detail Price Import", parameters, optionsdialog);
            var result = await dialog.Result;
            // Giữ nguyên dòng được chọn
            selectedRowNumber = selectedRowNumber;
            StateHasChanged();

            if (!result.Canceled)
            {
                var data = (M_ImportCostRequest)result.Data;
                var rs = await prsv.UpdateCreateProduct_import(data);

                MudBlazor.Severity severity;
                if (rs[1] == "1")
                    severity = MudBlazor.Severity.Success;
                else
                    severity = MudBlazor.Severity.Error;

                CallSnackBar(rs[0], severity);
            }

            return;

        }
        else
        {
            CallSnackBar("You have not access to Create", MudBlazor.Severity.Warning);
            return;
        }

    }

    private async Task OpenDuplicateDialog(Models.M_ImportCostRequest tr)
    {
        Guid id_temp = tr.Id;
        var optionsdialog = new DialogOptions { ClassBackground = "class-dialog-custom", FullWidth = true, MaxWidth = MaxWidth.Medium };
        if (tr == null)
        {
            CallSnackBar("Please select Data", MudBlazor.Severity.Warning);
            return;
        }

        if (await ssv.CheckPermission(asv.GetAuth().Result.User.Identity.Name, "Add", "Product_Price"))
        {
            var OldData = JsonSerializer.Deserialize<M_ImportCostRequest>(JsonSerializer.Serialize(tr));
            DialogOptions closeOnEscapeKey = new DialogOptions() { CloseOnEscapeKey = true };
            var parameters = new DialogParameters<Add_import> { { x => x._ProductPrice_Import_Details, tr }, { x => x.Status, "Duplicate" } };

            var dialog = await DialogService.ShowAsync<Add_import>(tr.Id == Guid.Empty ? "Request Pricing Import Create" : "Request Pricing Import Create", parameters, optionsdialog);
            var result = await dialog.Result;
            // Giữ nguyên dòng được chọn
            selectedRowNumber = selectedRowNumber;
            StateHasChanged();

            if (!result.Canceled)
            {
                var data = (M_ImportCostRequest)result.Data;
                var rs = await prsv.UpdateCreateProduct_import(data);
                await HistoryLogService.LogAsync(usr, "Duplicate", "Product_Price", data.Id, data.MaRFQ, new { OldData = OldData, NewData = data });
                MudBlazor.Severity severity;
                if (rs[1] == "1")
                    severity = MudBlazor.Severity.Success;

                else
                    severity = MudBlazor.Severity.Error;

                CallSnackBar(rs[0], severity);

                if (rs[1] == "1")
                {
                    M_details_Alls = await prsv.GetListProductPriceDetails_ALL(id_temp);
                    foreach (var item in M_details_Alls)
                    {
                        item.Id = Guid.Empty;
                        item.RFQ_Id = tr.Id;
                        item.Ngaybaogia = DateTime.Now;
                        item.Createat = DateTime.Now.ToString();
                        var UserName = asv.GetAuth().Result.User.Identity!.Name!;
                        item.Usercreate = UserName;
                        item.Userupdate = UserName;
                        item.Dateupdate = DateTime.Now.ToString("dd/MMM/yyyy");
                        item.Continued = true;
                        item.Editable = true;
                        item.Approve = false;
                        await prsv.UpdateCreateProduct_Detail_truck(item);

                    }
                }

                await HandleRefresh_create(data.Id);





            }

            return;

        }
        else
        {
            CallSnackBar("You have not access to Create", MudBlazor.Severity.Warning);
            return;
        }

    }

    private async Task OnApproveCheckboxWrapper(M_ImportCostRequest item)
    {
        if (await ssv.CheckPermission(asv.GetAuth().Result.User.Identity.Name, "Approve", "Product_Price"))
        {
            var rs = await prsv.UpdateCreateProduct_import(item);
            MudBlazor.Severity severity;
            if (rs[1] == "1")
                severity = MudBlazor.Severity.Success;
            else
                severity = MudBlazor.Severity.Error;

            CallSnackBar(rs[0], severity);

        }
        else
        {
            CallSnackBar("You have not access to Approve", MudBlazor.Severity.Warning);
            return;
        }

    }

    private ChartOptions options_chart = new ChartOptions
    {
        YAxisFormat = "#,##0"
    };


    public async Task GetChart()
    {
        List_detail = await prsv.GetProduct_Price_Detail_ByType("Import");
        if (List_detail.Count == 0)
        {
            CallSnackBar("No Data Chart", MudBlazor.Severity.Warning);
            return;
        }
        List_Charge = await supsv.GetListCharge();
        var xLabels = new[]
                {
                    "",
                    "",
                    ""
                };
        // Nhóm theo Itemid, lấy tên item từ List_Charge
        var chartData = List_detail
             .GroupBy(x => x.Itemid)
             .Select(g =>
             {
                 var itemName = List_Charge.FirstOrDefault(c => c.CHARGE_ID == g.Key)?.CHARGE ?? $"Unknown ({g.Key})";

                 double totalAmount = g.Sum(x => x.Cur == "USD"
                     ? Convert.ToDouble((x.Thanhtien ?? 0) * (x.Tigia ?? 1))
                     : Convert.ToDouble(x.Thanhtien ?? 0));

                 return new
                 {
                     ItemName = itemName,
                     TotalAmount = totalAmount
                 };
             }).ToList();

        // Trục X là tên từng item
        XAxisLabels = chartData.Select(x => x.ItemName).ToArray();

        // Series có 1 ChartSeries với data là tổng amount theo item, đúng thứ tự với XAxisLabels
        Series = chartData.Select(x => new ChartSeries
        {
            Name = x.ItemName,           // Tên cột là tên item
            Data = new double[] { 0, x.TotalAmount, 0 }  // 1 điểm dữ liệu (1 cột)
        }).ToList();

        // Trục X có thể là tên tháng, hoặc 1 giá trị dummy nếu bạn chỉ có 1 điểm cho mỗi series
        // Nếu biểu đồ dạng cột theo item, bạn có thể để XAxisLabels = new string[] { "" };
        XAxisLabels = new string[] { "" };

    }

}
