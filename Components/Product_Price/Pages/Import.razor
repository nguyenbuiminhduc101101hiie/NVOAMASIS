@using System.Globalization
@attribute [Authorize]
@inject GlobalServices gsv
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject AccountService asv
@inject SharedServices ssv
@inject BookingService bksv
@inject IJSRuntime JSRuntime
@inject SupportServices supsv
@inject IStringLocalizer<SharedResource> Localizer
@inject LocalChargesServices lcsv
@inject Bieugianangha_Services Bgnhsv
@inject CustomerService Cussv
@inject DNTUServices DNTUSV
@inject ProductPriceServices prsv;
@inject HistoryLogService HistoryLogService
@using System.Text.Json;

<style>
    .labelCustomColor label,
    .custom-label .mud-input-label {
        font-weight: 700;
        color: #118AB2 !important;
    }

    .class-dialog-custom {
        backdrop-filter: blur(10px);
        transition: none !important;
        animation: none !important;
    }

    .mud-menu {
        display: none;
    }
</style>
<PageTitle>@Localizer["Product_Price_Import"] </PageTitle>

<div class="product-price-page">
    <MudPaper Class="product-price-header" Elevation="0">
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Spacing="2">
            <MudStack Spacing="0">
                <MudText Typo="Typo.h6" Class="product-price-title">@Localizer["Product_Price_Import"]</MudText>
                <MudText Class="product-price-subtitle">Request pricing import / quản lý báo giá import</MudText>
            </MudStack>

            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.FlexEnd" Class="product-price-toolbar">
                <MudButton HtmlTag="label"
                           OnClick="Refresh"
                           Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled"
                           StartIcon="@Icons.Material.Filled.Refresh">
                    @Localizer["reload"]
                </MudButton>

                <MudButton HtmlTag="label"
                           @onclick="@((e) => OpenCreateDialog(new Models.M_ImportCostRequest()))"
                           Size="Size.Small" Color="Color.Secondary" Variant="Variant.Filled"
                           StartIcon="@Icons.Material.Filled.Add">
                    @Localizer["new"]
                </MudButton>

                <MudButton HtmlTag="label"
                           @onclick="@((e) => OpenEditDialog(detail))"
                           Size="Size.Small" Color="Color.Info" Variant="Variant.Filled"
                           StartIcon="@Icons.Material.Filled.Edit">
                    @Localizer["edit"]
                </MudButton>

                <MudButton HtmlTag="label"
                           @onclick="@(() => OpenAddDetailDialog(detail))"
                           Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled"
                           StartIcon="@Icons.Material.Filled.PlaylistAdd">
                    @Localizer["ADD_Detail"]
                </MudButton>

                <MudButton HtmlTag="label"
                           @onclick="@((e) => OpenDuplicateDialog(detail))"
                           Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled"
                           StartIcon="@Icons.Material.Filled.CopyAll">
                    @Localizer["duplicate"]
                </MudButton>
            </MudStack>
        </MudStack>
    </MudPaper>

    <MudPaper Class="product-price-card" Elevation="0">
        <div class="product-price-grid-wrap">
            <MudDataGrid T="M_ImportCostRequest" Items="@Listdata" Filterable="true" @ref="mudTable" Class="product-price-grid" Bordered="false"
                         FilterMode="@DataGridFilterMode.ColumnFilterRow" Dense="true" Virtualize="true" QuickFilter="@FilterFunc1"
                         FixedHeader="true" FixedFooter="true" HeaderClass="no-wrap" FooterClass="no-wrap"
                         ReadOnly="false" RowClassFunc="@SelectedRowClassFunc"
                         RowClick="@RowClicked" EditDialogOptions="@options"
                         ColumnResizeMode="@(_resizeColumn ? ResizeMode.Column : ResizeMode.Container)" Loading="_loading">
                <Columns>
                    <HierarchyColumn T="M_ImportCostRequest"></HierarchyColumn>

                    <TemplateColumn Title="" CellClass="d-flex justify-end">
                        <CellTemplate>
                            <MudIconButton Icon="@Icons.Material.Outlined.Delete"
                                           Size="Size.Small"
                                           Color="Color.Error"
                                           OnClick="@(()=>DeleteItem(context.Item))" />
                        </CellTemplate>
                    </TemplateColumn>

                    <PropertyColumn Property="x => x.MaRFQ" Title="@Localizer["MaRFQ"]" CellStyleFunc="_cellStyleFunc"></PropertyColumn>
                    <PropertyColumn Property="x => x.Tenhang" Title="@Localizer["TenHang_gs"]" CellStyleFunc="_cellStyleFunc"></PropertyColumn>
                    <PropertyColumn Property="x => x.Soluong" Title="@Localizer["Quantity"]" Format="#,##0.##" Culture="@_en" CellStyleFunc="_cellStyleFunc"></PropertyColumn>
                    <PropertyColumn Property="x => x.Donvitinh" Title="@Localizer["Unit"]" CellStyleFunc="_cellStyleFunc"></PropertyColumn>
                    <PropertyColumn Property="x => x.Quocgiaxuatxu" Title="@Localizer["Quocgiaxuatxu"]" CellStyleFunc="_cellStyleFunc"></PropertyColumn>
                    <PropertyColumn Property="x => x.Cangxuat" Title="@Localizer["Cangxuat"]" CellStyleFunc="_cellStyleFunc"></PropertyColumn>
                    <PropertyColumn Property="x => x.Cangnhap" Title="@Localizer["Cangnhap"]" CellStyleFunc="_cellStyleFunc"></PropertyColumn>
                    <PropertyColumn Property="x => x.Incoterm" Title="@Localizer["Incoterm"]" CellStyleFunc="_cellStyleFunc"></PropertyColumn>
                    <PropertyColumn Property="x => x.Trangthai" Title="@Localizer["status"]" CellStyleFunc="_cellStyleFunc"></PropertyColumn>
                    <PropertyColumn Property="x => x.Ngayguiyeucau" Title="@Localizer["Ngayguiyeucau"]" Format="dd/MM/yyyy" CellStyleFunc="_cellStyleFunc"></PropertyColumn>
                    <PropertyColumn Property="x => x.Loaihinh" Title="@Localizer["Loaihinh"]" CellStyleFunc="_cellStyleFunc"></PropertyColumn>
                    <PropertyColumn Property="x => x.Userhandle" Title="@Localizer["Userhandle"]" CellStyleFunc="_cellStyleFunc"></PropertyColumn>

                    <TemplateColumn Title="@Localizer["Approve"]">
                        <CellTemplate>
                            <MudCheckBox @bind-Checked="context.Item.Approve"
                                         @bind-Value="context.Item.Approve"
                                         @bind-Value:after="@(()=> OnApproveCheckboxWrapper(context.Item))">
                            </MudCheckBox>
                        </CellTemplate>
                    </TemplateColumn>

                    <PropertyColumn Property="x => x.Noidung" Title="@Localizer["noidung"]" CellStyleFunc="_cellStyleFunc" Hidden="true"></PropertyColumn>
                    <PropertyColumn Property="x => x.Continued" Title="@Localizer["Continued"]" CellStyleFunc="_cellStyleFunc" Hidden="true"></PropertyColumn>
                    <PropertyColumn Property="x => x.Editable" Title="@Localizer["Editable"]" CellStyleFunc="_cellStyleFunc" Hidden="true"></PropertyColumn>
                    <PropertyColumn Property="x => x.CreateAt" Title="@Localizer["CreatedAt"]" CellStyleFunc="_cellStyleFunc" Hidden="true"></PropertyColumn>
                    <PropertyColumn Property="x => x.Usercreate" Title="@Localizer["Nguoilap"]" CellStyleFunc="_cellStyleFunc" Hidden="true"></PropertyColumn>
                    <PropertyColumn Property="x => x.Userupdate" Title="@Localizer["Userupdate"]" CellStyleFunc="_cellStyleFunc" Hidden="true"></PropertyColumn>
                    <PropertyColumn Property="x => x.Dateupdate" Title="@Localizer["Dateupdate"]" CellStyleFunc="_cellStyleFunc" Hidden="true"></PropertyColumn>
                </Columns>

                <ChildRowContent>
                    <div class="product-price-child-panel">
                        <Add_Detail_Import__Index _ProductPrice_Import_Details="context.Item" />
                    </div>
                </ChildRowContent>

                <PagerContent>
                    <MudDataGridPager T="M_ImportCostRequest" PageSizeOptions="@(new int[] { 8, 10, 20 })" />
                </PagerContent>
            </MudDataGrid>
        </div>
    </MudPaper>

    <MudPaper Class="chart-card" Elevation="0">
        <div class="chart-card-header">Fee Chart</div>
        <div class="chart-card-body">
            <MudChart ChartType="ChartType.Bar"
                      ChartSeries="@Series"
                      XAxisLabels="@XAxisLabels"
                      Height="350px" Width="100%"
                      ChartOptions="options_chart" />
        </div>
    </MudPaper>
</div>

@code {
    List<M_ImportCostRequest> Listdata = new List<M_ImportCostRequest>();
    MudDataGrid<M_ImportCostRequest> mudTable;
    AuthUser user;
    string mailtp, mailpp;
    string usr;
    private List<string> ListUser { get; set; } = new List<string>();
    string UserHanding;
    List<string> trangthais = new List<string>();
    private List<Models.TrangThai> M_Trangthais = new List<Models.TrangThai>();
    private string searchText_pol = "";
    private string searchText_pod = "";
    private List<PortModel> filteredPorts = new List<PortModel>();
    private List<PortModel> filteredPorts_pod = new List<PortModel>();
    private List<PortModel> Ports = new List<PortModel>();
    private bool _resizeColumn;
    M_ImportCostRequest detail;
    private List<Models.M_Customer> CustomerList = new List<Models.M_Customer>();
    private List<M_DNTT_Logistics> DNTTs = new List<M_DNTT_Logistics>();
    public CultureInfo _en = CultureInfo.GetCultureInfo("en-US");
    private List<M_Product_Price_detail_ALL> M_details_Alls = new List<M_Product_Price_detail_ALL>();
    private List<M_Product_Price_detail_ALL> List_detail = new List<M_Product_Price_detail_ALL>();
    private List<ChargeModel> List_Charge = new List<ChargeModel>();

    public List<ChartSeries> Series = new List<ChartSeries>
    {
        new ChartSeries() { Name = "Fee", Data = new double[] { } }
    };
    public string[] XAxisLabels = { };


    protected async override Task OnInitializedAsync()
    {
        CustomerList = await Cussv.GetList();
        M_Trangthais = await supsv.GetListTrangThai();
        var tts = await supsv.GetListTrangThai();
        trangthais = tts.Where(x => x.Tieude == "ProductPrice").OrderBy(x => x.Noidung).Select(x => x.Noidung).ToList();
        DNTTs = DNTUSV.GetListDNTT_all();
        List_Charge = await supsv.GetListCharge();
        ListUser = await asv.GetList_User_handle() ?? new List<string>();
        usr = asv.GetAuth().Result.User.Identity!.Name!;

        // await Refresh();
    }

    string CustomerName(Guid? iddntt)
    {
        var rs = DNTTs.FirstOrDefault(x => x.Id == iddntt);
        return rs != null ? rs.So! : "";
    }

    bool _loading = false;
    async Task Refresh()
    {
        try
        {

            detail = null!;
            _loading = true;
            Listdata.Clear();

            await Task.Delay(500);
            if (!await ssv.CheckPermission(usr, "View", "Product_Price"))
            {
                CallSnackBar("You have not access to view", MudBlazor.Severity.Warning);
                return;
            }
            Listdata = await prsv.GetProduct_Price_import();

            await GetChart();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            CallSnackBar("Something went wrong!, error code: " + ex.Message, MudBlazor.Severity.Warning);
        }
        finally
        {
            _loading = false;
        }

    }

    void CallSnackBar(string message, MudBlazor.Severity severity)
    {
        Snackbar.Clear();
        Snackbar.Configuration.SnackbarVariant = Variant.Filled;
        Snackbar.Configuration.MaxDisplayedSnackbars = 3;
        Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopRight;
        Snackbar.Add(message, severity);
    }
    void RowClicked(DataGridRowClickEventArgs<M_ImportCostRequest> args)
    {
        detail = args.Item;
    }
    private int selectedRowNumber = -1;
    private string SelectedRowClassFunc(M_ImportCostRequest m, int rowNumber)
    {
        if (selectedRowNumber == rowNumber)
        {
            selectedRowNumber = -1;
            return string.Empty;
        }
        else if (mudTable.SelectedItem != null && mudTable.SelectedItem.Equals(m))
        {
            selectedRowNumber = rowNumber;
            return "selected";
        }
        else
        {
            return string.Empty;
        }
    }


    int? index_no;

    async Task DeleteItem(M_ImportCostRequest item)
    {
        if (item.Approve == true)
        {
            CallSnackBar("Data đã được Approve!!! , vui lòng bỏ Approve", MudBlazor.Severity.Warning);
            return;
        }
        if (!await ssv.CheckPermission(usr, "Delete", "Product_Price"))
        {
            CallSnackBar("You have not access to Delete", MudBlazor.Severity.Warning);
            return;
        }
        var resultMess = await DialogService.ShowMessageBox(
                "Warning",
                "Deleting can not be undone!",
                yesText: "Delete!", cancelText: "Cancel");

        if (resultMess.HasValue)
        {
            var rs = await prsv.DeleteProductPrice_import(item);
            await prsv.DeleteDetail_All(item.Id);

            string usr = asv.GetAuth().Result.User.Identity!.Name!;
            await HistoryLogService.LogAsync(usr, "Delete Import Cost Pricing", "Product_Price", item.Id, "", new { OldData = item });
            CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
            await Refresh();
        }

    }
    DialogOptions options = new DialogOptions
    {
        ClassBackground = "class-dialog-custom",
        FullWidth = true,
        MaxWidth = MaxWidth.Medium,
        CloseOnEscapeKey = false,
        DisableBackdropClick = true
    };
    string search;

    private bool FilterFunc1(M_ImportCostRequest sbd) => FilterFunc(sbd, search);

    private bool FilterFunc(M_ImportCostRequest sbd, string searchString)
    {
        if (string.IsNullOrWhiteSpace(sbd.MaRFQ))
            return true;
        if (string.IsNullOrWhiteSpace(searchString))
            return true;
        if (sbd.MaRFQ!.Contains(searchString, StringComparison.OrdinalIgnoreCase))
            return true;
        if ($"{sbd.MaRFQ} ".Contains(searchString))
            return true;
        return false;
    }

    private Func<M_ImportCostRequest, string> _cellStyleFunc => x =>
       {

           string style = "";

           if (string.IsNullOrEmpty(x.Trangthai))
               return "color: #000000";

           var rs = M_Trangthais
           .Where(t => (t.Noidung).Contains(x.Trangthai, StringComparison.InvariantCultureIgnoreCase)
               && t.Tieude.Equals("ProductPrice", StringComparison.InvariantCultureIgnoreCase))
           .Select(t => t.Mamau)
           .FirstOrDefault();
           return "color: " + rs;


       };

    private async Task OpenCreateDialog(Models.M_ImportCostRequest tr)
    {
        var optionsdialog = new DialogOptions { ClassBackground = "class-dialog-custom", FullWidth = true, MaxWidth = MaxWidth.Medium };

        if (await ssv.CheckPermission(asv.GetAuth().Result.User.Identity.Name, "Add", "Product_Price"))
        {

            DialogOptions closeOnEscapeKey = new DialogOptions() { CloseOnEscapeKey = true };
            var parameters = new DialogParameters<Add_import> { { x => x._ProductPrice_Import_Details, tr }, { x => x.Status, "add" } };

            var dialog = await DialogService.ShowAsync<Add_import>(tr.Id == Guid.Empty ? "Request Pricing Import Create" : "Request Pricing Import Edit", parameters, optionsdialog);
            var result = await dialog.Result;
            if (!result.Canceled)
            {
                var data = (M_ImportCostRequest)result.Data;
                var rs = await prsv.UpdateCreateProduct_import(data);

                await HistoryLogService.LogAsync(usr, "ADD", "Product_Price", data.Id, data.MaRFQ, data);


                MudBlazor.Severity severity;
                if (rs[1] == "1")
                    severity = MudBlazor.Severity.Success;
                else
                    severity = MudBlazor.Severity.Error;

                CallSnackBar(rs[0], severity);

                await HandleRefresh_create(data.Id);

            }

            return;

        }
        else
        {
            CallSnackBar("You have not access to Create", MudBlazor.Severity.Warning);
            return;
        }

    }

    async Task HandleRefresh_create(Guid? id)
    {
        try
        {

            detail = null;


            if (Listdata != null)
            {
                Listdata.Clear();
            }

            await Task.Delay(500);

            if (!await ssv.CheckPermission(asv.GetAuth().Result.User.Identity.Name, "View", "Product_Price"))
            {
                CallSnackBar("You have not access to view", MudBlazor.Severity.Warning);

                return;
            }
            Listdata = await prsv.GetProduct_price_import_create(id);
            StateHasChanged();
        }
        finally
        {


        }
    }

    private async Task OpenEditDialog(Models.M_ImportCostRequest tr)
    {
        var optionsdialog = new DialogOptions { ClassBackground = "class-dialog-custom", FullWidth = true, MaxWidth = MaxWidth.Medium };
        if (tr == null)
        {
            CallSnackBar("Please select Data", MudBlazor.Severity.Warning);
            return;
        }

        if (tr.Approve == true)
        {
            CallSnackBar("Data đã được Approve!!! , vui lòng bỏ Approve", MudBlazor.Severity.Warning);
            return;
        }

        if (await ssv.CheckPermission(asv.GetAuth().Result.User.Identity.Name, "Edit", "Product_Price"))
        {
            var OldData = JsonSerializer.Deserialize<M_ImportCostRequest>(JsonSerializer.Serialize(tr));
            DialogOptions closeOnEscapeKey = new DialogOptions() { CloseOnEscapeKey = true };
            var parameters = new DialogParameters<Add_import> { { x => x._ProductPrice_Import_Details, tr }, { x => x.Status, "edit" } };

            var dialog = await DialogService.ShowAsync<Add_import>(tr.Id == Guid.Empty ? "Request Pricing Import Edit" : "Request Pricing Import Edit", parameters, optionsdialog);
            var result = await dialog.Result;
            // Giữ nguyên dòng được chọn
            selectedRowNumber = selectedRowNumber;
            StateHasChanged();

            if (!result.Canceled)
            {
                var data = (M_ImportCostRequest)result.Data;
                var rs = await prsv.UpdateCreateProduct_import(data);

                await HistoryLogService.LogAsync(usr, "Update", "Product_Price", data.Id, data.MaRFQ, new { OldData = OldData, NewData = data });

                MudBlazor.Severity severity;
                if (rs[1] == "1")
                    severity = MudBlazor.Severity.Success;
                else
                    severity = MudBlazor.Severity.Error;

                CallSnackBar(rs[0], severity);
            }

            return;

        }
        else
        {
            CallSnackBar("You have not access to Edit", MudBlazor.Severity.Warning);
            return;
        }

    }

    private async Task OpenAddDetailDialog(Models.M_ImportCostRequest tr)
    {
        var optionsdialog = new DialogOptions { ClassBackground = "class-dialog-custom", FullWidth = true, MaxWidth = MaxWidth.ExtraExtraLarge };
        if (tr == null)
        {
            CallSnackBar("Please select Data", MudBlazor.Severity.Warning);
            return;
        }
        if (tr.Approve == true)
        {
            CallSnackBar("Data đã được Approve!!! , vui lòng bỏ Approve", MudBlazor.Severity.Warning);
