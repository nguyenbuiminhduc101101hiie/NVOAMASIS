<MudDialog>
    <DialogContent>
        <MudSpacer></MudSpacer>
        <MudContainer>

            <MudCard>
                <MudForm Model="@_PhieuKeToan_Detail" @ref="@form">
                    <MudCardContent>
                        <MudGrid>
                            <MudGrid>

                                <MudItem xs="2">
                                    <MudButton Style="background-color: #007BFF; color: white;" Size="Size.Small" Color="Color.Primary"
                                    Disabled="@(Status == "edit" || Status =="themtiep")"
                                    OnClick="() => Get_BGNHNo()">>>></MudButton>
                                </MudItem>

                                <MudItem xs="5">
                                    <MudTextField @bind-Value="_PhieuKeToan_Detail.Sophieuketoan" Disabled="true" Label="@Localizer["Sophieuketoan"]" Required="true" />
                                </MudItem>

                                <MudItem xs="5">

                                    <MudDatePicker Class="custom-label" @bind-Date="_PhieuKeToan_Detail.Ngay"
                                    For="@(() => _PhieuKeToan_Detail.Ngay)"
                                    Label="@Localizer["NGAY"]"
                                    DateFormat="dd/MM/yyyy"
                                    Required="true" />

                                </MudItem>

                            </MudGrid>

                            <MudGrid >

                                <MudItem xs="6">
                                    <MudAutocomplete Class="custom-label" T="Guid?" Label="@Localizer["Customer"]" Disabled="@(Status =="themtiep")"
                                                     @bind-Value="_PhieuKeToan_Detail.Customer_ID"
                                                     SearchFunc="Search_Customer"
                                                     ToStringFunc="GetCustomerLable" />
                                </MudItem>


                                <MudItem xs="6">
                                    <MudAutocomplete Class=" labelCustomColor custom-label" T="string"
                                                     @bind-Value="_PhieuKeToan_Detail.TKnophieuketoan"
                                                     Label="@Localizer["TKnophieuchi"]"
                                                     SearchFunc="SearchTk"
                                                     Immediate="true"
                                                     CoerceText="true"
                                                     Clearable="true"
                                                     MaxItems="100">
                                    </MudAutocomplete>
                                </MudItem>


                                <MudItem xs="6">
                                    <MudAutocomplete Class=" labelCustomColor custom-label" T="string"
                                                     @bind-Value="_PhieuKeToan_Detail.TKCophieuketoan"
                                                     Label="@Localizer["TKCophieuchi"]"
                                                     SearchFunc="SearchTk"
                                                     Immediate="true"
                                                     CoerceText="true"
                                                     Clearable="true"
                                                     MaxItems="100">
                                    </MudAutocomplete>
                                </MudItem>


                                <MudItem xs="6">
                                    <MudNumericField @bind-Value="_PhieuKeToan_Detail.Sotien" HideSpinButtons="true"
                                    Label="@Localizer["sotien"]" Format="#,##0.##" Culture="@_en" Required="true" T="double?"
                                    Class="text-right custom-label" />
                                </MudItem>

                               @*  <MudItem xs="6">
                                    <MudNumericField @bind-Value="_PhieuKeToan_Detail.Tigia" HideSpinButtons="true"
                                    Label="@Localizer["tigia"]" Format="#,##0.##" Culture="@_en" Required="true" T="double?"
                                    Class="text-right custom-label" />
                                </MudItem>

                                <MudItem xs="6">
                                    <MudSelect @bind-Value="_PhieuKeToan_Detail.Currency" Label="@Localizer["Loaitiente"]" Required="true" class="custom-label">
                                        <MudSelectItem Value="@("USD")">USD</MudSelectItem>
                                        <MudSelectItem Value="@("VND")">VND</MudSelectItem>

                                    </MudSelect>
                                </MudItem> *@

                                <MudItem xs="6">
                                    <MudAutocomplete @bind-Value="_PhieuKeToan_Detail.Currency" Label="@Localizer["Loaitiente"]" Required="true" Class="custom-label" CoerceValue SearchFunc="SearchCurr" />
                                </MudItem>



                                <MudItem xs="6">

                                    <MudStack Row Spacing="1" AlignItems="AlignItems.Center">
                                        <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small"
                                                   Style="min-width: 80px; height: 36px; padding: 5px 10px;"
                                                   OnClick="@(() => GetTigia(_PhieuKeToan_Detail))">
                                            @Localizer["gettigia"]
                                        </MudButton>

                                        <MudNumericField @bind-Value="_PhieuKeToan_Detail.Tigia"
                                                         Label="@Localizer["tigia"]"
                                                         Format="#,##0.##" Culture="@_en"
                                                         T="double?" Required="true" HideSpinButtons="true"
                                                         Dense="true"
                                                         Class="text-right custom-label" />
                                    </MudStack>
                                </MudItem>

                                <MudItem xs="6">
                                    <MudAutocomplete @bind-Value="_PhieuKeToan_Detail.PTTT" Label="@Localizer["PTTT"]"
                                    class="custom-label" CoerceValue SearchFunc="SearchPTTT" />
                                </MudItem>

                                <MudItem xs="12">
                                    <MudTextField @bind-Value="_PhieuKeToan_Detail.Noidung" Label="@Localizer["noidung"]" Class="custom-label" Lines="3" />
                                </MudItem>

                            </MudGrid>


                        </MudGrid>


                    </MudCardContent>
                </MudForm>

            </MudCard>
        </MudContainer>
    </DialogContent>
    <DialogActions>

        <MudButton OnClick="@(async () => await Submit())">Save</MudButton>
        <MudButton OnClick="Cancel">Cancel</MudButton>

    </DialogActions>
</MudDialog>



@code {
    [CascadingParameter] MudDialogInstance? MudDialog { get; set; }
    [Parameter] public Models.M_PhieuKeToan _PhieuKeToan_Detail { get; set; }

    [Parameter] public string Status { get; set; }
    MudForm form;
    List<string> trangthais = new List<string>();
    private List<Models.TrangThai> M_Trangthais = new List<Models.TrangThai>();
    public CultureInfo _en = CultureInfo.GetCultureInfo("en-US");
    private List<Terminal_> Terminals = new List<Terminal_>();
    private List<Terminal_> Terminals_Address = new List<Terminal_>();
    List<M_Bieugianangha> BGNHs = new List<M_Bieugianangha>();
    string UserHanding;
    private List<string> ListUser { get; set; } = new List<string>();

    private List<string> List_Acc { get; set; } = new List<string>();
    List<M_Customer> Customers = new List<M_Customer>();
    private List<M_PhieuKeToan> PKTs = new List<M_PhieuKeToan>();
    List<string> currs = new List<string>();
    protected async override Task OnInitializedAsync()
    {
        if(Status == "themtiep"){
            var tempSoPhieu = _PhieuKeToan_Detail.Sophieuketoan;
            var tempCustomerId = _PhieuKeToan_Detail.Customer_ID;
            _PhieuKeToan_Detail = new Models.M_PhieuKeToan
                {
                    Sophieuketoan = tempSoPhieu,
                    Customer_ID = tempCustomerId
                };
        }


        Customers = await Cussv.GetList();
        PKTs = await thuchisv.GetList_PhieuKeToan();
        List_Acc = await DMTKSv.GetList_Danhmuctaikhoan_search() ?? new List<string>();
        M_Trangthais = await supsv.GetListTrangThai();
        var tts = await supsv.GetListTrangThai();
        trangthais = tts.Where(x => x.Tieude == "PhieuKeToan").OrderBy(x => x.Noidung).Select(x => x.Noidung).ToList();
        BGNHs = await Bgnhsv.GetList_BieuGiaNangHa();
        Terminals_Address = await gsv.GetList_Terminal_add();
        Terminals = await gsv.GetList_Terminal();
        ListUser = await asv.GetList_User_handle() ?? new List<string>();
        currs = await Vcbsv.GetCur();
    }

    private async Task Get_BGNHNo()
    {

        int formattedYear = DateTime.Now.Year;
        int formattedMonth = DateTime.Now.Month;

        string usr = asv.GetAuth().Result.User.Identity!.Name!;
        var refno = await supsv.GetRefNoByFunc("PKT", formattedMonth, formattedYear, usr);

        var rs = asv.GetUserDetail();
        var cn = rs.Branch;
        _PhieuKeToan_Detail.Sophieuketoan = cn + "PKT_" + formattedYear.ToString() + formattedMonth.ToString() + refno.Value.ToString("D4");
    }

    private async Task Submit()
    {
        if ((await ssv.CheckPermission(asv.GetAuth().Result.User.Identity.Name, "Edit", "PhieuKeToan") || await ssv.CheckPermission(asv.GetAuth().Result.User.Identity.Name, "New", "PhieuKeToan")))
        {

            await form.Validate();

            if (form.IsValid)
            {
                if(_PhieuKeToan_Detail.Currency == "USD")
                {
                    var result = (double)(_PhieuKeToan_Detail.Sotien.Value * _PhieuKeToan_Detail.Tigia.Value);
                    _PhieuKeToan_Detail.SotienVnd = Math.Round(result, 3);
                }
                else
                {
                    _PhieuKeToan_Detail.SotienVnd = _PhieuKeToan_Detail.Sotien;
                }
                var UserName = asv.GetAuth().Result.User.Identity!.Name!;
                _PhieuKeToan_Detail.Updatetime = DateTime.Now.ToString("dd/MMM/yyyy");
                _PhieuKeToan_Detail.Userid = UserName;
                _PhieuKeToan_Detail.Loaiphieu = "PKT";
                MudDialog!.Close(_PhieuKeToan_Detail);

            }
        }

    }
    void Cancel() => MudDialog.Cancel();

    void CallSnackBar(string message, MudBlazor.Severity severity)
    {
        
        Snackbar.Configuration.SnackbarVariant = Variant.Filled;
        Snackbar.Configuration.MaxDisplayedSnackbars = 3;
        Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopRight;
        Snackbar.Add(message, severity);
    }
   
       private async Task<IEnumerable<string>> SearchTk(string value)
    {
        if (string.IsNullOrEmpty(value))
            return List_Acc;

        return List_Acc.Where(x => x.Contains(value, StringComparison.InvariantCultureIgnoreCase));
    }

    private async Task<IEnumerable<string?>> SearchPTTT(string? text)
    {
        try
        {
            var items = PKTs.Select(x => x.PTTT).Distinct();
            if (string.IsNullOrEmpty(text))
            {
                return items;
            }
            // MBL.Porname = mst_Consignee;
            return items.Where(x => x != null && x.Equals(text));
        }
        catch (Exception)
        {
            throw;
        }
    }
    private async Task<IEnumerable<Guid?>> Search_Customer(string value)
    {
        if (string.IsNullOrEmpty(value))
            return Customers.Select(x => (Guid?)x.Customer_ID);

        return Customers
        .Where(x => !string.IsNullOrEmpty(x.COMPANY) && x.COMPANY.Contains(value, StringComparison.InvariantCultureIgnoreCase))
        .Select(x => (Guid?)x.Customer_ID)  // Convert Customer_ID to Guid?
        .ToList();


    }

    private string GetCustomerLable(Guid? id)
    {
        var customer = Customers.FirstOrDefault(x => x.Customer_ID == id);
        return customer != null ? customer.COMPANY : string.Empty;
    }

    private async Task GetTigia(M_PhieuKeToan item)
    {
        double? tigia_ = await Vcbsv.Getexchange_cur(item.Currency);
        item.Tigia = tigia_;
    }
    private async Task<IEnumerable<string>> SearchCurr(string? text)
    {
        if (string.IsNullOrWhiteSpace(text))
            return currs;

        return currs.Where(x => !string.IsNullOrEmpty(x) && x.Contains(text, StringComparison.OrdinalIgnoreCase));
    }
}
