@using System.Globalization
@inject ISnackbar Snackbar
@inject AccountService asv
@inject TrainScheduleServices trainsv
@inject IStringLocalizer<SharedResource> Localizer
@inject SharedServices ssv
@inject LocalChargesServices lcsv
@inject SupportServices supsv
@inject LenhDieuXeServices ldxsv
@inject TKHQ_Services tkhqsv
@inject GlobalServices gsv
@inject Bieugianangha_Services Bgnhsv
@inject PhieuThu_Chi_Services thuchisv
@inject IJSRuntime JSRuntime
@inject Danhmuctaikhoan_services DMTKSv
@inject CustomerService Cussv
@inject tigiaVCBservices Vcbsv
<style>
    .class-dialog-custom {
    backdrop-filter: blur(10px);
    transition: none !important;
    animation: none !important;
    }

    .selected {
    background: #855ff3 !important;
    }

    .selected > td {
    color: white !important;
    }

    .selected > td .mud-input {
    color: white !important;
    }

    .labelCustomColor label {
    font-weight: bold;
    color: #118AB2 !important;
    }

    .mud-table thead {
    background-color: #118AB2;
    }

    .mud-table th {
    background-color: #118AB2 !important;
    color: white !important;
    }

    .mud-table-foot tr {
    background-color: #118AB2 !important;
    }

    .footer-cell {
    background-color: #118AB2 !important;
    color: white !important;
    }

    .filter-header-cell {
    background-color: white !important;
    color: black !important;
    }

    .mud-menu {
    display: none;
    }

