<MudDialog>
    <DialogContent>


        <MudSelect @bind-Value="ItemSelected" Label="Select HBL">
            @foreach (var item in ListHBL)
            {
                <MudSelectItem Value="@item">@item.hbl</MudSelectItem>
            }
        </MudSelect>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(()=> Muddialog.Cancel())">Close</MudButton>
        <MudButton OnClick="@(()=> Muddialog.Close(DialogResult.Ok(ItemSelected)))"
                   Color="Color.Primary" Disabled="(ItemSelected == null || ItemSelected.hblID == Guid.Empty)">
            Ok
        </MudButton>

    </DialogActions>
</MudDialog>
@inject ISnackbar Snackbar
@inject ShipmentService ssv
@code {
    [CascadingParameter] public MudDialogInstance Muddialog { get; set; }
    [Parameter] public List<M_HBL> ListHBL { get; set; }
    M_HBL ItemSelected;
}
