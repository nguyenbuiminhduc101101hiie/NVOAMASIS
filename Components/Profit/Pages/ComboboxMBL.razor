<MudDialog>
    <DialogContent>


        <MudSelect @bind-Value="ItemSelected" Label="Select MBL">
            @foreach (var item in ListMBL)
            {
                <MudSelectItem Value="@item">@item.Mbl</MudSelectItem>
            }
        </MudSelect>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(()=> Muddialog.Cancel())">Close</MudButton>
        <MudButton OnClick="@(()=> Muddialog.Close(DialogResult.Ok(ItemSelected)))"
                   Color="Color.Primary" Disabled="(ItemSelected == null || ItemSelected.MblID == Guid.Empty)">
            Ok
        </MudButton>

    </DialogActions>
</MudDialog>
@inject ISnackbar Snackbar
@inject ShipmentService ssv
@code {
    [CascadingParameter] public MudDialogInstance Muddialog { get; set; }
    [Parameter] public List<M_MBL> ListMBL { get; set; }
    M_MBL ItemSelected;
}
