@page "/TrainSchedule"
@using System.Net
@using System.Diagnostics

@inject SharedServices ssv
@inject TrainScheduleServices trainsv
@inject AccountService asv


@inject ISnackbar Snackbar
@inject IDialogService DialogService

@inject IStringLocalizer<SharedResource> Localizer

@attribute [Authorize]
@inject HistoryLogService HistoryLogService
@using System.Text.Json;

<PageTitle>@Localizer["Train_schedule"]</PageTitle>

<MudContainer MaxWidth=MaxWidth.False>
    <MudGrid Class="pa-4">

      <MudItem xs=2>
            <div class="mud-input-control mud-file-upload">
                <MudTextField @bind-Value="search_Schedule" Placeholder="@Localizer["Search"]"
                              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                              IconSize="Size.Medium" AdornmentColor="Color.Primary" Class="mt-0">
                </MudTextField>
            </div>
      </MudItem>

      <MudItem xs=2>
            <div class="mud-input-control mud-file-upload">
                <MudButton HtmlTag="label"
                            OnClick="HandleRefresh"
                            Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled"
                            StartIcon="@Icons.Material.Filled.Refresh">
                    @Localizer["reload"]
                </MudButton>
            </div>
      </MudItem>
        <MudItem xs="2">
            <div class="mud-input-control mud-file-upload">
                <MudButton HtmlTag="label"
                           @onclick="@((e) => OpenCreateDialog(new Models.TrainSchedule()))"
                           Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled"
                           StartIcon="@Icons.Material.Filled.Add">
                    @Localizer["add"]
                </MudButton>
            </div>
        </MudItem>

        <MudItem xs="2">
            <div class="mud-input-control mud-file-upload">
                <MudButton HtmlTag="label"
                           @onclick="@((e) => OpenEditDialog(Trainschedule_Detail))"
                           Size="Size.Small" Color="Color.Secondary" Variant="Variant.Filled"
                           StartIcon="@Icons.Material.Filled.Create">
                    @Localizer["edit"]
                </MudButton>
            </div>
        </MudItem>

        <!-- Nút Delete -->
        <MudItem xs="2">
            <div class="mud-input-control mud-file-upload">
                <MudButton HtmlTag="label"
                           @onclick="@((e) => Delete(Trainschedule_Detail))"
                           Size="Size.Small" Color="Color.Error" Variant="Variant.Filled"
                           StartIcon="@Icons.Material.Filled.Delete">
                    @Localizer["delete"]
                </MudButton>
            </div>
        </MudItem>
          <MudItem xs="2">
            <div class="mud-input-control mud-file-upload">
                <MudButton HtmlTag="label"
                           @onclick="@((e) => OpenDuplicateDialog(Trainschedule_Detail))"
                           Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled"
                           StartIcon="@Icons.Material.Filled.CopyAll">
                    @Localizer["duplicate"]
                </MudButton>
            </div>
        </MudItem>
    </MudGrid>


</MudContainer>

<MudSpacer></MudSpacer>
<MudSpacer></MudSpacer>

<MudContainer MaxWidth=MaxWidth.False>
    <MudDataGrid T="Models.TrainSchedule" Items="@listImport.ToList()"
                 Filterable="true" QuickFilter="@FilterFunc1"
                 FilterMode="@DataGridFilterMode.ColumnFilterRow" Dense="true" Virtualize="true"
                 RowClick="@RowClicked" Bordered="true"
                 FixedHeader="true" FixedFooter="true" HeaderClass="no-wrap" FooterClass="no-wrap"
                 EditTrigger="DataGridEditTrigger.Manual" ReadOnly="false" CommittedItemChanges="@((t)=>CommittedItemChanges(t))"
                 RowClassFunc="@SelectedRowClassFunc"
                 ColumnResizeMode="ResizeMode.Column" @ref="mudTable"
                 Hideable="true">

        <Columns>

            <FilterHeaderCell Class="custom-colorfillter" />

            <PropertyColumn Property="x => x.TerminalDeparture_ID" Title="@(Localizer["ID"])" Hidden="true">
                <FooterTemplate>
                    ID
                </FooterTemplate>
            </PropertyColumn>

            <PropertyColumn Property="x => x.Gui" Title="@(Localizer["Vessel Name"])">
                <FooterTemplate>
                    @Localizer["Vessel Name"]
                </FooterTemplate>
            </PropertyColumn>

            <PropertyColumn Property="x => x.Port" Title="@(Localizer["Voyage"])" >
                <FooterTemplate>
                    @Localizer["Voyage"]
                </FooterTemplate>
            </PropertyColumn>

            <PropertyColumn Property="x => x.After" Title="@(Localizer["Closing Time"])" >
                <FooterTemplate>
                    @Localizer["Closing Time"]
                </FooterTemplate>
            </PropertyColumn>

            <PropertyColumn Property="x => x.Quantity" Title="@(Localizer["POL"])">
                <FooterTemplate>
                    @Localizer["POL"]
                </FooterTemplate>
            </PropertyColumn>

            <PropertyColumn Property="x => x._To" Title="@(Localizer["POD"])">
                <FooterTemplate>
                    @Localizer["POD"]
                </FooterTemplate>
            </PropertyColumn>

            <PropertyColumn Property="x => x.NumCrew" Format="dd/MMM/yyyy" Title="@(Localizer["ETD"])">
                <FooterTemplate>
                    @Localizer["ETD"]
                </FooterTemplate>
            </PropertyColumn>

            <PropertyColumn Property="x => x.NumPassenger" Format="dd/MMM/yyyy" Title="@(Localizer["ETA"])" >
                <FooterTemplate>
                    @Localizer["ETA"]
                </FooterTemplate>
            </PropertyColumn>

            <PropertyColumn Property="x => x.QuantityCargo" Title="@(Localizer["Mode Of Transport"])">
                <FooterTemplate>
                    @Localizer["Mode Of Transport"]
                </FooterTemplate>
            </PropertyColumn>

            <PropertyColumn Property="x => x.Remarks" Title="@(Localizer["ghichu"])" >
                <FooterTemplate>
                    @Localizer["ghichu"]
                </FooterTemplate>
            </PropertyColumn>

            <TemplateColumn Title="@Localizer["Approve"]">
                <CellTemplate>
                    <MudCheckBox @bind-Checked="context.Item.approve" @bind-Value="context.Item.approve" @bind-Value:after="@(()=> OnApproveCheckboxWrapper(context.Item))">
                    </MudCheckBox>
                </CellTemplate>
            </TemplateColumn>

            <PropertyColumn Property="x => x.userid" Title="@(Localizer["User Update"])">
                <FooterTemplate>
                    @Localizer["UserUpdate"]
                </FooterTemplate>
            </PropertyColumn>

            <PropertyColumn Property="x => x.updatetime" Title="@(Localizer["Date Update"])">
                <FooterTemplate>
                    @Localizer["Date Update"]
                </FooterTemplate>
            </PropertyColumn>

        </Columns>

        <PagerContent>
            <MudDataGridPager T="Models.TrainSchedule" PageSizeOptions="@(new int[] { 8, 10, 20 })" />
        </PagerContent>

    </MudDataGrid>

</MudContainer >


@code {
    private string search_Schedule;
  
    Guid? ScheduleId;

    Models.TrainSchedule Trainschedule_Detail;
    private List<Models.TrainSchedule> listImport = new List<Models.TrainSchedule>();
    string usr;
    async Task RowClicked(DataGridRowClickEventArgs<Models.TrainSchedule> args)
    {
        Trainschedule_Detail = args.Item;
        ScheduleId = args.Item.TerminalDeparture_ID;

    }
    protected override async Task OnInitializedAsync()
    {
        usr = asv.GetAuth().Result.User.Identity!.Name!;
        // await HandleRefresh();
    }

    async Task CommittedItemChanges(Models.TrainSchedule item)
    {
        var rs = await trainsv.UpdateAnTrainSchedule(item, Trainschedule_Detail);
        CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
        //_events.Insert(0, $"Event = CommittedItemChanges, Data = {System.Text.Json.JsonSerializer.Serialize(item)}");
    }

    private int selectedRowNumber = -1;
    private MudDataGrid<Models.TrainSchedule> mudTable;
    private string SelectedRowClassFunc(Models.TrainSchedule Sis, int rowNumber)
    {
        if (selectedRowNumber == rowNumber)
        {
            selectedRowNumber = -1;
            return string.Empty;
        }
        else if (mudTable.SelectedItem != null && mudTable.SelectedItem.Equals(Sis))
        {
            selectedRowNumber = rowNumber;
            return "selected";
        }
        else
        {
            return string.Empty;
        }
    }

    async Task HandleRefresh()
    {
        try{

            Trainschedule_Detail = null;
            ScheduleId = null;

            listImport.Clear();
            
            await Task.Delay(500);

            if (!await ssv.CheckPermission(asv.GetAuth().Result.User.Identity.Name, "View", "TrainSchedule"))
            {
                CallSnackBar(Localizer["NoPermission_View"], MudBlazor.Severity.Warning);

                return;
            }
            listImport = await trainsv.GetListStrainSchedule();
            StateHasChanged();
        }
        finally
        {


        }
    }
    // string =""
    async Task HandleRefresh_create(Guid? id)
    {
        try
        {

            Trainschedule_Detail = null;
            ScheduleId = null;

            listImport.Clear();
     
            await Task.Delay(500);

            if (!await ssv.CheckPermission(asv.GetAuth().Result.User.Identity.Name, "View", "TrainSchedule"))
            {
                CallSnackBar(Localizer["NoPermission_View"], MudBlazor.Severity.Warning);

                return;
            }
            listImport = await trainsv.GetListStrainSchedule_create(id);
            StateHasChanged();
        }
        finally
        {


        }
    }
    private async Task OpenCreateDialog(Models.TrainSchedule tr)
    {
        var optionsdialog = new DialogOptions { ClassBackground = "class-dialog-custom", FullWidth = true, MaxWidth = MaxWidth.Medium };
        if (tr == null)
        {
            CallSnackBar(Localizer["PleaseSelectData"], MudBlazor.Severity.Warning);
            return;
        }

        if (await ssv.CheckPermission(asv.GetAuth().Result.User.Identity.Name, "Add", "TrainSchedule"))
        {

            DialogOptions closeOnEscapeKey = new DialogOptions() { CloseOnEscapeKey = true };
            var parameters = new DialogParameters<Add> { { x => x.TrainScheduleDetail, tr }, { x => x.Status, "add" } };

            var dialog = await DialogService.ShowAsync<Add>(tr.TerminalDeparture_ID == Guid.Empty ? Localizer["TrainSchedule_Create"] : Localizer["TrainSchedule_Edit"], parameters, optionsdialog);
            var result = await dialog.Result;
            if (!result.Canceled)
            {
                var data = (TrainSchedule)result.Data;
                var rs = await trainsv.UpdateOrCreateTrainSchedule(data);
                await HistoryLogService.LogAsync(usr, "ADD Train Schedule", "TrainSchedule", data.TerminalDeparture_ID, data.Gui+"-"+data.Port, data);
                MudBlazor.Severity severity;
                if (rs[1] == "1")
                    severity = MudBlazor.Severity.Success;
                else
                    severity = MudBlazor.Severity.Error;

                CallSnackBar(rs[0], severity);
                // Guid id_create = Guid.Parse(data.TerminalDeparture_ID);

                await HandleRefresh_create(data.TerminalDeparture_ID);
                // selectedRowNumber = 0;
                // StateHasChanged();
            }
          
            return;

        }
        else
        {
            CallSnackBar(Localizer["NoPermission_Add"], MudBlazor.Severity.Warning);
            return;
        }

    }

    private async Task OpenEditDialog(Models.TrainSchedule tr)
    {
        var optionsdialog = new DialogOptions { ClassBackground = "class-dialog-custom", FullWidth = true, MaxWidth = MaxWidth.Medium };
        if (tr == null)
        {
            CallSnackBar(Localizer["PleaseSelectData"], MudBlazor.Severity.Warning);
            return;
        }
        if (tr.approve == true)
        {
            CallSnackBar(Localizer["DataAlreadyApproved"], MudBlazor.Severity.Warning);
            return;
        }
        if (await ssv.CheckPermission(asv.GetAuth().Result.User.Identity.Name, "Edit", "TrainSchedule"))
        {
            var OldData = JsonSerializer.Deserialize<TrainSchedule>(JsonSerializer.Serialize(tr));
            DialogOptions closeOnEscapeKey = new DialogOptions() { CloseOnEscapeKey = true };
            var parameters = new DialogParameters<Add> { { x => x.TrainScheduleDetail, tr }, { x => x.Status, "edit" } };

            var dialog = await DialogService.ShowAsync<Add>(Localizer["TrainSchedule_Edit"], parameters, optionsdialog);
            var result = await dialog.Result;
            // Giữ nguyên dòng được chọn
            selectedRowNumber = selectedRowNumber;
            StateHasChanged();

            if (!result.Canceled)
            {
                var data = (TrainSchedule)result.Data;
                var rs = await trainsv.UpdateOrCreateTrainSchedule(data);
                await HistoryLogService.LogAsync(usr, "Update Train Schedule", "TrainSchedule", data.TerminalDeparture_ID, data.Gui + "-" + data.Port, new { OldData = OldData, NewData = data });
                MudBlazor.Severity severity;
                if (rs[1] == "1")
                    severity = MudBlazor.Severity.Success;
                else
                    severity = MudBlazor.Severity.Error;

                CallSnackBar(rs[0], severity);
            }

            return;

        }
        else
        {
            CallSnackBar(Localizer["NoPermission_Edit"], MudBlazor.Severity.Warning);
            return;
        }

    }

    private async Task OpenDuplicateDialog(Models.TrainSchedule tr)
    {
        var optionsdialog = new DialogOptions { ClassBackground = "class-dialog-custom", FullWidth = true, MaxWidth = MaxWidth.Medium };
        if (tr == null)
        {
            CallSnackBar(Localizer["PleaseSelectData"], MudBlazor.Severity.Warning);
            return;
        }
        
        if (await ssv.CheckPermission(asv.GetAuth().Result.User.Identity.Name, "Edit", "TrainSchedule"))
        {

            DialogOptions closeOnEscapeKey = new DialogOptions() { CloseOnEscapeKey = true };
            var parameters = new DialogParameters<Add> { { x => x.TrainScheduleDetail, tr }, { x => x.Status, "Duplicate" } };

            var dialog = await DialogService.ShowAsync<Add>(Localizer["TrainSchedule_Add"], parameters, optionsdialog);
            var result = await dialog.Result;
            // Giữ nguyên dòng được chọn
            selectedRowNumber = selectedRowNumber;
            StateHasChanged();

            if (!result.Canceled)
            {
                var data = (TrainSchedule)result.Data;
                var rs = await trainsv.UpdateOrCreateTrainSchedule(data);
                await HistoryLogService.LogAsync(usr, "Duplicate Train Schedule", "TrainSchedule", data.TerminalDeparture_ID, data.Gui + "-" + data.Port, data);
                MudBlazor.Severity severity;
                if (rs[1] == "1")
                    severity = MudBlazor.Severity.Success;
                else
                    severity = MudBlazor.Severity.Error;

                CallSnackBar(rs[0], severity);
            }

            return;

        }
        else
        {
            CallSnackBar(Localizer["NoPermission_Add"], MudBlazor.Severity.Warning);
            return;
        }

    }

    private async Task Delete(Models.TrainSchedule tr)
    {
        try
        {

            if (!await ssv.CheckPermission(asv.GetAuth().Result.User.Identity.Name, "Delete", "TrainSchedule"))
            {
                CallSnackBar(Localizer["NoPermission_Delete"], MudBlazor.Severity.Warning);
                return;
            }
            if (ScheduleId == null)
            {
                CallSnackBar(Localizer["PleaseSelectData"], MudBlazor.Severity.Warning);
                return;
            }
            if (tr.approve == true)
            {
                CallSnackBar(Localizer["DataAlreadyApproved"], MudBlazor.Severity.Warning);
                return;
            }
            var resultMess = await DialogService.ShowMessageBox(
                Localizer["Warning"],
                Localizer["DeleteConfirmBody"],
                yesText: Localizer["delete"], cancelText: Localizer["cancel"]);

            if (resultMess.HasValue)
            {

                var ivmdetail = await trainsv.GetDetailtrainscheduleFromID(ScheduleId);
                var result = await trainsv.DeleteTrainSchedule(ivmdetail);
                await HistoryLogService.LogAsync(usr, "Delete Train Schedule", "TrainSchedule", tr.TerminalDeparture_ID, tr.Code, new { OldData = tr });
                if (result.Flag)
                    CallSnackBar(result.Message, MudBlazor.Severity.Success);
                else
                {
                    CallSnackBar(result.Message, MudBlazor.Severity.Error);
                    return;
                }

                await HandleRefresh();
            }
        }
        catch (Exception ex)
        {
            CallSnackBar(string.Format(Localizer["DeleteError"], ex.Message), MudBlazor.Severity.Error);

        }

    }

    void CallSnackBar(string message, MudBlazor.Severity severity)
    {
        
        Snackbar.Configuration.SnackbarVariant = Variant.Filled;
        Snackbar.Configuration.MaxDisplayedSnackbars = 3;
        Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopRight;
        Snackbar.Add(message, severity);
    }

    private bool FilterFunc1(Models.TrainSchedule bt) => FilterFunc(bt, search_Schedule);

    private bool FilterFunc(Models.TrainSchedule bt, string search_InvNo)
    {
        if (string.IsNullOrWhiteSpace(search_InvNo))
        return true;
        if (bt.Gui!.Contains(search_InvNo, StringComparison.OrdinalIgnoreCase))
        return true;

            if ($"{bt.Gui} ".Contains(search_InvNo))
        return true;
        return false;
    }

    private async Task OnApproveCheckboxWrapper(TrainSchedule item)
    {
        if (await ssv.CheckPermission(asv.GetAuth().Result.User.Identity.Name, "Approve", "TrainSchedule"))
        {
            var rs = await trainsv.UpdateOrCreateTrainSchedule(item);
            await HandleRefresh();
        }
        else
        {
            CallSnackBar(Localizer["NoPermission_Approve"], MudBlazor.Severity.Warning);
            return;
        }

    }
}
