@inject ISnackbar Snackbar
@inject AccountService asv
@inject TrainScheduleServices trainsv
@inject CustomerService csv
@inject EmailService emsv
@inject IJSRuntime JSRuntime
@inject IStringLocalizer<SharedResource> Localizer
@inject BookingService Bksv
@using Microsoft.AspNetCore.Components.Forms
@using System.Text.Json;

<style>
    .class-dialog-custom {
        backdrop-filter: blur(10px);
        transition: none !important;
        animation: none !important;
    }

    .train-dialog-shell {
        max-height: 78vh;
        overflow-y: auto;
        width: 100%;
        background: linear-gradient(180deg, #f8fbff 0%, #ffffff 100%);
        padding: 12px;
    }

    .train-dialog-card {
        border-radius: 16px !important;
        border: 1px solid #dbeafe !important;
        box-shadow: 0 10px 28px rgba(15, 23, 42, .08) !important;
        overflow: hidden;
    }

    .train-dialog-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 14px 16px;
        background: linear-gradient(135deg, #0f80aa 0%, #118AB2 55%, #1d9fc8 100%);
        color: white;
    }

    .train-dialog-title {
        font-size: 18px;
        font-weight: 800;
        letter-spacing: .2px;
        line-height: 1.2;
    }

    .train-dialog-subtitle {
        font-size: 12px;
        opacity: .9;
        margin-top: 2px;
    }

    .train-section {
        border: 1px solid #e2e8f0 !important;
        border-radius: 14px !important;
        background: #ffffff !important;
        padding: 12px !important;
        margin-bottom: 12px;
    }

    .train-section-blue {
        background: #f0f9ff !important;
        border-color: #bfdbfe !important;
    }

    .train-section-title {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 13px;
        font-weight: 800;
        color: #0f6f91;
        text-transform: uppercase;
        letter-spacing: .5px;
        margin-bottom: 10px;
    }

        .train-section-title::before {
            content: '';
            width: 6px;
            height: 18px;
            border-radius: 999px;
            background: #118AB2;
            display: inline-block;
        }

    .labelCustomColor label,
    .custom-label .mud-input-label {
        font-weight: 700 !important;
        color: #0f7da1 !important;
        font-size: 12px !important;
    }

    .train-dialog-shell .mud-input-control {
        margin-top: 0 !important;
        margin-bottom: 4px !important;
    }

    .train-dialog-shell .mud-input-root,
    .train-dialog-shell .mud-picker-input-button,
    .train-dialog-shell .mud-select {
        font-size: 13px !important;
    }

    .train-dialog-shell .mud-input-outlined,
    .train-dialog-shell .mud-input-filled,
    .train-dialog-shell .mud-input-underline {
        background: #ffffff;
    }

    .train-upload-box {
        border: 1px dashed #7dd3fc;
        background: #f0f9ff;
        border-radius: 14px;
        padding: 12px;
    }

    .train-upload-title {
        font-weight: 800;
        color: #0f6f91;
        margin-bottom: 8px;
        font-size: 13px;
    }

    .train-attachment-list {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        margin-top: 10px;
    }

    .train-attachment-chip {
        border-radius: 999px !important;
        background: #e0f2fe !important;
        color: #075985 !important;
        border: 1px solid #bae6fd !important;
        text-transform: none !important;
        max-width: 260px;
    }

    .train-actions {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        gap: 8px;
        width: 100%;
        padding: 10px 14px;
        border-top: 1px solid #e5e7eb;
        background: #f8fafc;
    }

        .train-actions .mud-button-root {
            border-radius: 999px !important;
            font-weight: 700 !important;
            text-transform: none !important;
            min-width: 92px;
        }

    .text-right input {
        text-align: right !important;
    }

    @@media (max-width: 768px) {
        .train-dialog-shell {
            padding: 8px;
            max-height: 82vh;
        }

        .train-dialog-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .train-actions {
            justify-content: stretch;
            flex-wrap: wrap;
        }

            .train-actions .mud-button-root {
                flex: 1 1 auto;
            }
    }
</style>

<MudDialog>
    <DialogContent>
        <div class="train-dialog-shell">
            <MudForm Model="@TrainScheduleDetail" @ref="@form">
                <MudCard Class="train-dialog-card">
                    <div class="train-dialog-header">
                        <div>
                            <div class="train-dialog-title">Train Schedule</div>
                            <div class="train-dialog-subtitle">Vessel / routing / email attachment information</div>
                        </div>
                        <MudButton OnClick="SendEmailNow"
                                   Color="Color.Info"
                                   Variant="Variant.Filled"
                                   Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.Email">
                            Send Email
                        </MudButton>
                    </div>

                    <MudCardContent Class="pa-3">
                        <MudPaper Class="train-section train-section-blue" Elevation="0">
                            <div class="train-section-title">Schedule information</div>
                            <MudGrid Spacing="2">
                                <MudItem xs="12" sm="6" md="3">
                                    <MudTextField @bind-Value="TrainScheduleDetail.Gui"
                                                  Label="@Localizer["Vessel name"]"
                                                  Margin="Margin.Dense"
                                                  Class="labelCustomColor custom-label" />
                                </MudItem>

                                <MudItem xs="12" sm="6" md="3">
                                    <MudTextField @bind-Value="TrainScheduleDetail.Port"
                                                  Label="@Localizer["Voyage"]"
                                                  Margin="Margin.Dense"
                                                  Class="labelCustomColor custom-label" />
                                </MudItem>

                                <MudItem xs="12" sm="6" md="3">
                                    <MudTextField @bind-Value="TrainScheduleDetail.After"
                                                  Label="@Localizer["Closing Time"]"
                                                  Margin="Margin.Dense"
                                                  Class="labelCustomColor custom-label" />
                                </MudItem>

                                <MudItem xs="12" sm="6" md="3">
                                    <MudTextField @bind-Value="TrainScheduleDetail.QuantityCargo"
                                                  Label="@Localizer["Mode Of Transport"]"
                                                  Margin="Margin.Dense"
                                                  Class="labelCustomColor custom-label" />
                                </MudItem>
                            </MudGrid>
                        </MudPaper>

                        <MudPaper Class="train-section" Elevation="0">
                            <div class="train-section-title">Routing</div>
                            <MudGrid Spacing="2">
                                <MudItem xs="12" sm="6" md="3">
                                    <MudAutocomplete Class="labelCustomColor custom-label"
                                                     T="string"
                                                     @bind-Value="TrainScheduleDetail.Quantity"
                                                     Label="@Localizer["POL"]"
                                                     Margin="Margin.Dense"
                                                     SearchFunc="SearchPorts"
                                                     Immediate="true"
                                                     CoerceText="true"
                                                     Clearable="true"
                                                     MaxItems="100" />
                                </MudItem>

                                <MudItem xs="12" sm="6" md="3">
                                    <MudAutocomplete Class="labelCustomColor custom-label"
                                                     T="string"
                                                     @bind-Value="TrainScheduleDetail._To"
                                                     Label="@Localizer["POD"]"
                                                     Margin="Margin.Dense"
                                                     SearchFunc="SearchPorts"
                                                     Immediate="true"
                                                     CoerceText="true"
                                                     Clearable="true"
                                                     MaxItems="100" />
                                </MudItem>

                                <MudItem xs="12" sm="6" md="3">
                                    <MudDatePicker Class="labelCustomColor custom-label"
                                                   @bind-Date="TrainScheduleDetail.NumCrew"
                                                   For="@(() => TrainScheduleDetail.NumCrew)"
                                                   Label="@Localizer["ETD"]"
                                                   Margin="Margin.Dense"
                                                   DateFormat="dd/MM/yyyy"
                                                   Required="true" />
                                </MudItem>

                                <MudItem xs="12" sm="6" md="3">
                                    <MudDatePicker Class="labelCustomColor custom-label"
                                                   @bind-Date="TrainScheduleDetail.NumPassenger"
                                                   For="@(() => TrainScheduleDetail.NumPassenger)"
                                                   Label="@Localizer["ETA"]"
                                                   Margin="Margin.Dense"
                                                   DateFormat="dd/MM/yyyy"
                                                   Required="true" />
                                </MudItem>

                                <MudItem xs="12">
                                    <MudTextField @bind-Value="TrainScheduleDetail.Remarks"
                                                  Label="@Localizer["ghichu"]"
                                                  Margin="Margin.Dense"
                                                  Lines="2"
                                                  Class="labelCustomColor custom-label" />
                                </MudItem>
                            </MudGrid>
                        </MudPaper>

                        <MudPaper Class="train-section train-section-blue" Elevation="0">
                            <div class="train-section-title">Customer email</div>
                            <MudGrid Spacing="2">
                                <MudItem xs="12" md="6">
                                    <MudAutocomplete Value="_selectedCustomerId"
                                                     ValueChanged="OnCustomerChanged"
                                                     T="Guid?"
                                                     Class="labelCustomColor custom-label"
                                                     Label="Customer"
                                                     Margin="Margin.Dense"
                                                     SearchFunc="SearchCustomers"
                                                     ToStringFunc="CustomerIdToDisplay"
                                                     Clearable="true" />
                                </MudItem>

                                <MudItem xs="12" md="6">
                                    <MudTextField Value="@_selectedCustomerEmail"
                                                  Label="Customer Email"
                                                  ReadOnly="true"
                                                  Margin="Margin.Dense"
                                                  Class="labelCustomColor custom-label" />
                                </MudItem>

                                <MudItem xs="12">
                                    <MudTextField @bind-Value="_additionalEmails"
                                                  Label="Additional Emails"
                                                  Placeholder="a@abc.com,b@abc.com"
                                                  Margin="Margin.Dense"
                                                  Class="labelCustomColor custom-label" />
                                </MudItem>
                            </MudGrid>
                        </MudPaper>

                        <MudPaper Class="train-section" Elevation="0">
                            <div class="train-section-title">Attachments</div>
                            <div class="train-upload-box">
                                <div class="train-upload-title">Choose files to attach</div>
                                <InputFile OnChange="HandleFileSelectedAsync" multiple />

                                @if (_attachmentNames.Count > 0)
                                {
                                    <MudText Typo="Typo.caption" Class="mt-2 custom-label">
                                        Attached: @_attachmentNames.Count file(s)
                                    </MudText>
                                    <div class="train-attachment-list">
                                        @foreach (var fileName in _attachmentNames)
                                        {
                                            var fileNameCopy = fileName;
                                            <MudButton Variant="Variant.Outlined"
                                                       Size="Size.Small"
                                                       Class="train-attachment-chip"
                                                       StartIcon="@Icons.Material.Filled.AttachFile"
                                                       OnClick="() => OpenAttachmentAsync(fileNameCopy)">
                                                @fileNameCopy
                                            </MudButton>
                                        }
                                    </div>
                                }
                            </div>
                        </MudPaper>
                    </MudCardContent>
                </MudCard>
            </MudForm>
        </div>
    </DialogContent>

    <DialogActions>
        <div class="train-actions">
            <MudButton OnClick="SendEmailNow"
                       Color="Color.Info"
                       Variant="Variant.Filled"
                       StartIcon="@Icons.Material.Filled.Email">
                Send Email
            </MudButton>
            <MudButton OnClick="@(async () => await Submit())"
                       Color="Color.Primary"
                       Variant="Variant.Filled"
                       StartIcon="@Icons.Material.Filled.Save">
                Save
            </MudButton>
            <MudButton OnClick="Cancel"
                       Color="Color.Default"
                       Variant="Variant.Outlined">
                Cancel
            </MudButton>
        </div>
    </DialogActions>
</MudDialog>



@code {
    [CascadingParameter] MudDialogInstance? DialogInstance { get; set; }
    [Parameter] public Models.TrainSchedule TrainScheduleDetail { get; set; } = new();

    [Parameter] public string Status { get; set; }
    MudForm form;
    List<PortModel> Ports = new List<PortModel>();
    private List<M_Customer> Customers = new();
    TrainSchedule detail_old;
    private Guid? _selectedCustomerId;
    private string _selectedCustomerEmail = string.Empty;
    private string _additionalEmails = string.Empty;
    private readonly List<(byte[] Content, string FileName)> _attachments = new();
    private readonly List<string> _attachmentNames = new();
    private sealed class AttachmentPayload
    {
        public string FileName { get; set; } = string.Empty;
        public string? ContentType { get; set; }
        public string Base64Content { get; set; } = string.Empty;
    }
    private string NumCrew { get; set; }
    protected async override Task OnInitializedAsync()
    {
        detail_old = JsonSerializer.Deserialize<TrainSchedule>(JsonSerializer.Serialize(TrainScheduleDetail)); ;
        Ports = await Bksv.GetList_PORT();
        Customers = await csv.GetList();

        if (!string.IsNullOrWhiteSpace(TrainScheduleDetail.AttachmentFilesJson))
        {
            try
            {
                var existingFiles = JsonSerializer.Deserialize<List<string>>(TrainScheduleDetail.AttachmentFilesJson) ?? new List<string>();
                _attachmentNames.AddRange(existingFiles.Where(x => !string.IsNullOrWhiteSpace(x)));
            }
            catch
            {
                // ignore invalid old data format
            }
        }
        if (!string.IsNullOrWhiteSpace(TrainScheduleDetail.AttachmentFilesDataJson))
        {
            try
            {
                var payloads = JsonSerializer.Deserialize<List<AttachmentPayload>>(TrainScheduleDetail.AttachmentFilesDataJson) ?? new();
                foreach (var payload in payloads.Where(x => !string.IsNullOrWhiteSpace(x.FileName) && !string.IsNullOrWhiteSpace(x.Base64Content)))
                {
                    var bytes = Convert.FromBase64String(payload.Base64Content);
                    UpsertAttachment(payload.FileName, bytes);
                }
            }
            catch
            {
                // ignore invalid old data format
            }
        }

        _selectedCustomerId = TrainScheduleDetail.customerid;
        if (_selectedCustomerId.HasValue)
        {
            var selectedCustomer = Customers.FirstOrDefault(x => x.Customer_ID == _selectedCustomerId.Value);
            _selectedCustomerEmail = selectedCustomer?.Email?.Trim() ?? TrainScheduleDetail.email ?? string.Empty;
        }
        else
        {
            _selectedCustomerEmail = TrainScheduleDetail.email ?? string.Empty;
        }
    }
    private DateTime? SelectedDate
    {
        get => DateTime.TryParse(NumCrew, out var date) ? date : null;
        set => NumCrew = value?.ToString("yyyy-MM-dd") ?? string.Empty;
    }
    private string NumPassenger { get; set; }
    private DateTime? SelectedDate_eta
    {
        get => DateTime.TryParse(NumPassenger, out var date) ? date : null;
        set => NumPassenger = value?.ToString("yyyy-MM-dd") ?? string.Empty;
    }

    private DateTime? selectedDate_numcrew = DateTime.Today;


    private async Task Submit()
    {
        await form.Validate();

        if (form.IsValid)
        {
            if (Status == "Duplicate")
            {
                TrainScheduleDetail.TerminalDeparture_ID = Guid.Empty;
                TrainScheduleDetail.approve = false;
            }
            var UserName = asv.GetAuth().Result.User.Identity!.Name!;
            TrainScheduleDetail.updatetime = DateTime.Now;
            TrainScheduleDetail.userid = UserName;
            TrainScheduleDetail.customerid = _selectedCustomerId;
            TrainScheduleDetail.email = string.Join(",", BuildRecipients());
            TrainScheduleDetail.AttachmentFilesJson = _attachmentNames.Count > 0
                ? JsonSerializer.Serialize(_attachmentNames.Distinct().ToList())
                : null;
            TrainScheduleDetail.AttachmentFilesDataJson = _attachments.Count > 0
                ? JsonSerializer.Serialize(_attachments.Select(x => new AttachmentPayload
                {
                    FileName = x.FileName,
                    Base64Content = Convert.ToBase64String(x.Content),
                    ContentType = "application/octet-stream"
                }).ToList())
                : null;
            DialogInstance!.Close(TrainScheduleDetail);

        }

    }
    void Cancel() => DialogInstance?.Cancel();

    void CallSnackBar(string message, MudBlazor.Severity severity)
    {

        Snackbar.Configuration.SnackbarVariant = Variant.Filled;
        Snackbar.Configuration.MaxDisplayedSnackbars = 3;
        Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopRight;
        Snackbar.Add(message, severity);
    }

    private async Task<IEnumerable<string>> SearchPorts(string text)
    {
        try
        {
            if (string.IsNullOrWhiteSpace(text))
            {
                return Ports
                    .Where(x => !string.IsNullOrEmpty(x.PORT))
                    .Select(x => x.PORT)
                    .Distinct();
            }

            return Ports
                .Where(x => !string.IsNullOrEmpty(x.PORT) &&
                            x.PORT.Contains(text, StringComparison.OrdinalIgnoreCase))
                .Select(x => x.PORT)
                .Distinct();
        }
        catch (Exception)
        {
            throw;
        }
    }

    private async Task<IEnumerable<Guid?>> SearchCustomers(string text)
    {
        IEnumerable<M_Customer> query = Customers;
        if (!string.IsNullOrWhiteSpace(text))
        {
            query = query.Where(x =>
                (!string.IsNullOrWhiteSpace(x.COMPANY) && x.COMPANY.Contains(text, StringComparison.OrdinalIgnoreCase)) ||
                (!string.IsNullOrWhiteSpace(x.shortname) && x.shortname.Contains(text, StringComparison.OrdinalIgnoreCase)) ||
                (!string.IsNullOrWhiteSpace(x.Email) && x.Email.Contains(text, StringComparison.OrdinalIgnoreCase)));
        }

        return await Task.FromResult(query.Select(x => (Guid?)x.Customer_ID));
    }

    private Task OnCustomerChanged(Guid? value)
    {
        _selectedCustomerId = value;
        var customer = value.HasValue ? Customers.FirstOrDefault(x => x.Customer_ID == value.Value) : null;
        _selectedCustomerEmail = customer?.Email?.Trim() ?? string.Empty;
        return Task.CompletedTask;
    }

    private string CustomerIdToDisplay(Guid? id)
    {
        if (!id.HasValue)
            return string.Empty;

        var customer = Customers.FirstOrDefault(x => x.Customer_ID == id.Value);
        if (customer is null)
            return string.Empty;

        return $"{customer.shortname} - {customer.COMPANY}";
    }

    private async Task HandleFileSelectedAsync(InputFileChangeEventArgs e)
    {
        const long maxFileSize = 10 * 1024 * 1024;

        foreach (var file in e.GetMultipleFiles())
        {
            if (file.Size > maxFileSize)
            {
                CallSnackBar($"File {file.Name} exceeds 10MB and was skipped.", MudBlazor.Severity.Warning);
                continue;
            }

            var ms = new MemoryStream();
            await using var stream = file.OpenReadStream(maxFileSize);
            await stream.CopyToAsync(ms);

            UpsertAttachment(file.Name, ms.ToArray());
        }
    }

    private void UpsertAttachment(string fileName, byte[] content)
    {
        _attachments.RemoveAll(x => x.FileName.Equals(fileName, StringComparison.OrdinalIgnoreCase));
        _attachmentNames.RemoveAll(x => x.Equals(fileName, StringComparison.OrdinalIgnoreCase));
        _attachments.Add((content, fileName));
        _attachmentNames.Add(fileName);
    }

    private async Task OpenAttachmentAsync(string fileName)
    {
        var file = _attachments.FirstOrDefault(x => x.FileName.Equals(fileName, StringComparison.OrdinalIgnoreCase));
        if (file.Content == null || file.Content.Length == 0)
        {
            CallSnackBar("File content not found.", MudBlazor.Severity.Warning);
            return;
        }

        await JSRuntime.InvokeVoidAsync("downloadFileFromStream", file.FileName, Convert.ToBase64String(file.Content));
    }

    private async Task SendEmailToSelectedCustomerAsync()
    {
        if (_attachments.Count == 0)
        {
            CallSnackBar("Please attach at least one file before sending email.", MudBlazor.Severity.Warning);
            return;
        }

        var recipients = BuildRecipients();
        if (recipients.Count == 0)
        {
            CallSnackBar("No valid email found, skipped sending attachment email.", MudBlazor.Severity.Warning);
            return;
        }

        var customer = _selectedCustomerId.HasValue
            ? Customers.FirstOrDefault(x => x.Customer_ID == _selectedCustomerId.Value)
            : null;

        var body = BuildTrainScheduleEmailContent(customer);
        var sent = await emsv.SendEmailAsync_1(body, recipients.ToArray(), _attachments);
        CallSnackBar(sent ? "Email with attachments sent successfully." : "Failed to send email with attachments.", sent ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
    }

    private async Task SendEmailNow()
    {
        await SendEmailToSelectedCustomerAsync();
    }

    private List<string> BuildRecipients()
    {
        var recipients = new List<string>();

        if (!string.IsNullOrWhiteSpace(_selectedCustomerEmail))
            recipients.Add(_selectedCustomerEmail.Trim());

        if (!string.IsNullOrWhiteSpace(_additionalEmails))
        {
            var extra = _additionalEmails
                .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                .Where(x => x.Contains('@', StringComparison.Ordinal))
                .Select(x => x.Trim());
            recipients.AddRange(extra);
        }

        return recipients
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

    private string BuildTrainScheduleEmailContent(M_Customer? customer)
    {
        var etd = TrainScheduleDetail.NumCrew?.ToString("dd/MM/yyyy") ?? string.Empty;
        var eta = TrainScheduleDetail.NumPassenger?.ToString("dd/MM/yyyy") ?? string.Empty;
        var recipientName = customer?.COMPANY ?? customer?.shortname ?? "Customer";
        return
$@"Dear {recipientName},

Please find attached files for train schedule information:
- Vessel name: {TrainScheduleDetail.Gui}
- Voyage: {TrainScheduleDetail.Port}
- POL: {TrainScheduleDetail.Quantity}
- POD: {TrainScheduleDetail._To}
- ETD: {etd}
- ETA: {eta}
- Mode Of Transport: {TrainScheduleDetail.QuantityCargo}
- Remark: {TrainScheduleDetail.Remarks}

Best regards,
VMS";
    }
}
