@using System.Globalization
@inject ISnackbar Snackbar
@inject AccountService asv
@inject TrainScheduleServices trainsv
@inject IStringLocalizer<SharedResource> Localizer
@inject SharedServices ssv
@inject LocalChargesServices lcsv
@inject SupportServices supsv
@inject LenhDieuXeServices ldxsv
@inject TKHQ_Services tkhqsv
@inject GlobalServices gsv
@inject Bieugianangha_Services BGRRsv
@inject CustomerService CusSV
@inject DNTUServices DNTUSV
@inject BookingService Bksv
@inject  ShipmentService shipmentsv
@inject NavigationManager NavigationManager
@inject tigiaVCBservices Vcbsv
@inject IJSRuntime JSRuntime

<MudDialog>
    <DialogContent>
        <MudSpacer></MudSpacer>
        <MudContainer>

            <MudCard>
                <MudForm Model="@_DNTU_Detail" @ref="@form">
                    <MudCardContent>

                        <MudGrid>

                            <MudItem xs="2">
                                <MudButton Style="background-color: #007BFF; color: white;" Size="Size.Small" Color="Color.Primary"
                                Disabled="@(Status == "edit")"
                                OnClick="() => Get_BGNHNo()">>>></MudButton>
                            </MudItem>

                            <MudItem xs="5">
                                <MudTextField @bind-Value="_DNTU_Detail.So" Disabled="true" Label="@Localizer["So"]" Class="custom-label" Required="true" />
                            </MudItem>

                            <MudItem xs="5">
                                <MudDatePicker Class="custom-label" @bind-Date="_DNTU_Detail.NGAY"
                                For="@(() => _DNTU_Detail.NGAY)"
                                Label="@Localizer["NGAY"]"
                                DateFormat="dd/MM/yyyy"
                                Required="true" />
                            </MudItem>

                        </MudGrid>

                        <MudGrid>

                            <MudItem xs="6">
                                <MudAutocomplete @bind-Value="_DNTU_Detail.Kinhgui" Label="@Localizer["Kinhgui"]" class="custom-label" CoerceValue SearchFunc="Searchlinhgui" />
                            </MudItem>



                            <MudItem xs="6">
                                <MudAutocomplete Class=" labelCustomColor custom-label" T="string"
                                @bind-Value="_DNTU_Detail.Tennguoidenghi"
                                Label="@Localizer["Tennguoidenghi"]"
                                SearchFunc="Search_User"
                                Immediate="true"
                                CoerceText="true"
                                Clearable="true"
                                MaxItems="100">
                                </MudAutocomplete>
                            </MudItem>

                            <MudItem xs="12">
                                <MudTextField @bind-Value="_DNTU_Detail.Noidung" Label="@Localizer["noidung"]" Class="custom-label" Lines="3" />
                            </MudItem>

                            <MudItem xs="6">
                                <MudAutocomplete @bind-Value="_DNTU_Detail.Bophan" Label="@Localizer["bophan"]" class="custom-label" CoerceValue SearchFunc="Searchbophan" />
                            </MudItem>



                            <MudItem xs="6">
                                <MudNumericField @bind-Value="_DNTU_Detail.Sotien"
                                Label="@Localizer["sotien"]" Format="#,##0.##" Culture="@_en" T="double?" HideSpinButtons="true"
                                Class="text-right custom-label " />
                            </MudItem>

                            <MudItem xs="6">
                            
                                <MudAutocomplete @bind-Value="_DNTU_Detail.Loaitiente" Label="@Localizer["Loaitiente"]" Required="true" Class="custom-label" CoerceValue SearchFunc="SearchCurr" />
                            </MudItem>

                            <MudItem xs="6">
                 
                                <MudStack Row Spacing="1" AlignItems="AlignItems.Center">
                                    <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small"
                                               Style="min-width: 80px; height: 36px; padding: 5px 10px;"
                                               OnClick="@(() => GetTigia(_DNTU_Detail))">
                                        @Localizer["gettigia"]
                                    </MudButton>

                                    <MudNumericField @bind-Value="_DNTU_Detail.tigia"
                                                     Label="@Localizer["tigia"]"
                                                     Format="#,##0.##" Culture="@_en"
                                                     T="double?" Required="true" HideSpinButtons="true"
                                                     Dense="true"
                                                     Class="text-right custom-label" />
                                </MudStack>

                            </MudItem>

                  

                            <MudItem xs="6">
                                <MudSelect @bind-Value="_DNTU_Detail.Trangthai" Label="@Localizer["status"]" class="custom-label">
                                    @foreach (var item in trangthais)
                                    {
                                        <MudSelectItem Value="item">@item</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>


                            <MudItem xs="6">

                                <MudAutocomplete @bind-Value="_DNTU_Detail.Bkno" Label="@Localizer["BookingNo"]" class="custom-label" SearchFunc="Searchbkno" />
                            </MudItem>

                            <MudItem xs="6">
                                <MudAutocomplete @bind-Value="_DNTU_Detail.Hbl" Label="@Localizer["HBL"]" class="custom-label" SearchFunc="SearchHBL" />
                            </MudItem>

                            <MudItem xs="12">
                                <MudTextField @bind-Value="_DNTU_Detail.Chungtukemtheo" Label="@Localizer["Chungtukemtheo"]" Class="custom-label" Lines="3" />
                            </MudItem>

                            <MudItem xs="12">
                                <MudStack Row>
                                    <MudFileUpload T="IBrowserFile"
                                    Accept=".pdf,.doc,.docx,.xls,.xlsx"
                                    FilesChanged="@((t) => AttachFileToFTP(t, _DNTU_Detail))">
                                        <ButtonTemplate Context="context1">
                                            <MudIconButton HtmlTag="label" for="@context1"
                                            Size="Size.Small"
                                            Color="Color.Secondary"
                                            Icon="@Icons.Material.Filled.AttachFile" />
                                        </ButtonTemplate>
                                    </MudFileUpload>

                                    <MudContainer Class="pa-4; max-height:200px; overflow-y: auto;">
                                        <MudText Typo="Typo.h6">Files</MudText>

                                        @foreach (var item in Linksplit(_DNTU_Detail.Files!))
                                        {
                                            var fileName = Path.GetFileName(item);
                                            var fileUrl = item.Replace("ftp", "http");
                                            var fileExtension = Path.GetExtension(fileName).ToLower();

                                            <MudPaper Elevation="3" Class="d-flex align-items-center justify-between ma-2 pa-2">
                                                <MudIcon Icon="@GetFileIcon(fileExtension)" Size="Size.Medium" />
                                                <MudText Class="mx-2" Style="flex-grow: 1;">@fileName</MudText>

                                                <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                                                OnClick="@(() => SeeDetail(fileUrl))"
                                                Color="Color.Primary" />

                                                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                OnClick="@(() => DeleteFiles(_DNTU_Detail, item))"
                                                Color="Color.Error" />
                                            </MudPaper>
                                        }
                                    </MudContainer>

                                </MudStack>
                            </MudItem>

                        </MudGrid>

                    </MudCardContent>
                </MudForm>

            </MudCard>
        </MudContainer>
    </DialogContent>
    <DialogActions>

        <MudButton OnClick="@(async () => await Submit())">Save</MudButton>
        <MudButton OnClick="Cancel">Cancel</MudButton>

    </DialogActions>
</MudDialog>



@code {
    [CascadingParameter] MudDialogInstance? MudDialog { get; set; }
    [Parameter] public Models.M_DNTU _DNTU_Detail { get; set; }
    List<M_Customer> customers = new List<M_Customer>();
    [Parameter] public string Status { get; set; }
    MudForm form;
    List<string> trangthais = new List<string>();
    private List<Models.TrangThai> M_Trangthais = new List<Models.TrangThai>();
    public CultureInfo _en = CultureInfo.GetCultureInfo("en-US");
    private List<Terminal_> Terminals = new List<Terminal_>();
    private List<Terminal_> Terminals_Address = new List<Terminal_>();
    List<M_DNTU> BGRRs = new List<M_DNTU>();
    string UserHanding;
    private List<string> ListUser { get; set; } = new List<string>();
    List<M_DNTU> DNTUs = new List<M_DNTU>();
    List<string> Bookings = new List<string>();
    List<Booking> M_Bookings = new List<Booking>();

    List<string> HBLs = new List<string>();
    List<M_HBL> M_HBLs = new List<M_HBL>();
    [Parameter] public double? sotien { get; set; }
    [Parameter] public string? CUR { get; set; }
    [Parameter] public string? HBL { get; set; }
    [Parameter] public string? BKNO { get; set; }
    List<string> currs = new List<string>();
    protected async override Task OnInitializedAsync()
    {
        if (Status == "add")
        {
            _DNTU_Detail.Sotien = sotien;
            _DNTU_Detail.Loaitiente = CUR;
            _DNTU_Detail.Hbl = HBL;
            _DNTU_Detail.Bkno = BKNO;
        }
        if (Status == "Duplicate")
        {
            _DNTU_Detail.So = "";
            _DNTU_Detail.Id=Guid.Empty;
            _DNTU_Detail.Approve = false;
        }
        customers = await CusSV.GetList();
        M_Trangthais = await supsv.GetListTrangThai();
        var tts = await supsv.GetListTrangThai();
        trangthais = tts.Where(x => x.Tieude == "DNTU").OrderBy(x => x.Noidung).Select(x => x.Noidung).ToList();
        DNTUs =  DNTUSV.GetListDNTU();
        Terminals_Address = await gsv.GetList_Terminal_add();
        Terminals = await gsv.GetList_Terminal();
        ListUser = await asv.GetList_User_handle() ?? new List<string>();
        M_Bookings = await Bksv.GetListSBooking();
        Bookings = M_Bookings.Select(x => x.BookingNo).ToList();
        currs = await Vcbsv.GetCur();
        M_HBLs = await shipmentsv.GetListHBLALL();
        HBLs = M_HBLs.Select(x => x.hbl).ToList();
    }

    private async Task Get_BGNHNo()
    {

        int formattedYear = DateTime.Now.Year;
        int formattedMonth = DateTime.Now.Month;

        string usr = asv.GetAuth().Result.User.Identity!.Name!;
        var refno = await supsv.GetRefNoByFunc("DNTU", formattedMonth, formattedYear, usr);

        var rs = asv.GetUserDetail();
        var cn = rs.Branch;
        _DNTU_Detail.So = cn + "DNTU_" + formattedYear.ToString() + formattedMonth.ToString() + refno.Value.ToString("D4");
    }

    private async Task Submit()
    {
        if ((await ssv.CheckPermission(asv.GetAuth().Result.User.Identity.Name, "Edit", "DNTU") || await ssv.CheckPermission(asv.GetAuth().Result.User.Identity.Name, "New", "DNTU")))
        {

            await form.Validate();

            if (form.IsValid)
            {

                var UserName = asv.GetAuth().Result.User.Identity!.Name!;

                _DNTU_Detail.Dateupdate = DateTime.Now.ToString("dd/MMM/yyyy");
                _DNTU_Detail.UserUpdate = UserName;
                double sumhoanung = DNTUSV.SumHoanung(_DNTU_Detail.Id);
                _DNTU_Detail.Sotienhoanung = sumhoanung;
                _DNTU_Detail.Sotienconlai = _DNTU_Detail.Sotienhoanung - _DNTU_Detail.Sotien;
                MudDialog!.Close(_DNTU_Detail);

            }
        }

    }
    void Cancel() => MudDialog.Cancel();

    void CallSnackBar(string message, MudBlazor.Severity severity)
    {
        Snackbar.Clear();
        Snackbar.Configuration.SnackbarVariant = Variant.Filled;
        Snackbar.Configuration.MaxDisplayedSnackbars = 3;
        Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopRight;
        Snackbar.Add(message, severity);
    }
  
     private async Task<IEnumerable<Guid?>> Search_customer(string value)
    {
        if (string.IsNullOrEmpty(value))
            return customers.Select(x => (Guid?)x.Customer_ID);

        return customers
            .Where(x => (x.shortname+"___"+x.COMPANY).Contains(value, StringComparison.InvariantCultureIgnoreCase))
            .Select(x => (Guid?)x.Customer_ID);
    }
    private string GetCustomerLabel(Guid? id)
    {
        var customer = customers.FirstOrDefault(x => x.Customer_ID == id);
        return customer != null ? customer.shortname + "___" + customer.COMPANY : string.Empty;
    }

    private async Task<IEnumerable<string>> SearchTerminal(string text)
    {
        try
        {
            if (string.IsNullOrWhiteSpace(text))
            {
                return Terminals.Where(x => !string.IsNullOrEmpty(x.TermiNalName))
               .Select(x => x.TermiNalName);
            }
            // MBL.Porname = mst_Consignee;
            return Terminals.Where(x => !string.IsNullOrEmpty(x.TermiNalName) &&
                            x.TermiNalName.Contains(text, StringComparison.OrdinalIgnoreCase))
               .Select(x => x.TermiNalName);
        }
        catch (Exception)
        {
            throw;
        }
    }
    private async Task<IEnumerable<string>> Search_User(string value)
    {
        if (string.IsNullOrEmpty(value))
            return ListUser;

        return ListUser.Where(x => x.Contains(value, StringComparison.InvariantCultureIgnoreCase));
    }

     private async Task<IEnumerable<string?>> Searchlinhgui(string? text)
    {
        try
        {
            var items = DNTUs.Select(x => x.Kinhgui).Distinct();
            if (string.IsNullOrEmpty(text))
            {
                return items;
            }
            // MBL.Porname = mst_Consignee;
            return items.Where(x => x != null && x.Equals(text));
        }
        catch (Exception)
        {
            throw;
        }
    }

    private async Task<IEnumerable<string?>> Searchbophan(string? text)
    {
        try
        {
            var items = DNTUs.Select(x => x.Bophan).Distinct();
            if (string.IsNullOrEmpty(text))
            {
                return items;
            }
            // MBL.Porname = mst_Consignee;
            return items.Where(x => x != null && x.Equals(text));
        }
        catch (Exception)
        {
            throw;
        }
    }
     private Task<IEnumerable<string>> SearchHBL(string value)
    {
        var items = M_HBLs
            .Select(x => x.hbl)
            .Where(x => !string.IsNullOrEmpty(x))
            .Distinct();

        if (string.IsNullOrWhiteSpace(value))
            return Task.FromResult(items);

        var result = items.Where(x => x.Contains(value, StringComparison.OrdinalIgnoreCase));
        return Task.FromResult(result);
    }

     private Task<IEnumerable<string>> Searchbkno(string value)
    {
        var items = M_Bookings
            .Select(x => x.BookingNo)
            .Where(x => !string.IsNullOrEmpty(x))
            .Distinct();

        if (string.IsNullOrWhiteSpace(value))
            return Task.FromResult(items);

        var result = items.Where(x => x.Contains(value, StringComparison.OrdinalIgnoreCase));
        return Task.FromResult(result);
    }

        List<string>Linksplit(string links)
    {
        if (string.IsNullOrEmpty(links))
            return new List<string>();
        return links.Split(';').ToList(); 
    }

    private string GetFileIcon(string extension)
    {
        return extension switch
        {
            ".pdf" => Icons.Material.Filled.PictureAsPdf,
            ".doc" or ".docx" => Icons.Material.Filled.Description,
            ".xls" or ".xlsx" => Icons.Material.Filled.TableChart,
            _ => Icons.Material.Filled.InsertDriveFile
        };
    }

    async Task SeeDetail(string fileUrl)
    {
        // NavigationManager.NavigateTo(fileUrl, true);
        await JSRuntime.InvokeVoidAsync("open", fileUrl, "_blank");
  
    }

      async Task DeleteFiles(M_DNTU item ,string link)
    {
        try
        {
            if (item.Files!.Contains(";"))
                link = link + ";";
            item.Files = item.Files!.Replace(link, string.Empty);

            StateHasChanged();
        }
        catch(Exception ex)
        {
            CallSnackBar("Throw exception code: " + ex.Message, MudBlazor.Severity.Error);
        }
    }
    async Task AttachFileToFTP(IBrowserFile file, M_DNTU item)
    {
        try
        {
            var rs = await ssv.UploadfiletoFTP_DNTU(file, (object)item);
            CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
        }
        catch (Exception ex)
        {
            CallSnackBar("Throw exception code: " + ex.Message, MudBlazor.Severity.Error);
        }
    }
    private async Task<IEnumerable<string>> SearchCurr(string? text)
    {
        if (string.IsNullOrWhiteSpace(text))
            return currs;

        return currs.Where(x => !string.IsNullOrEmpty(x) && x.Contains(text, StringComparison.OrdinalIgnoreCase));
    }
    private async Task GetTigia(M_DNTU item)
    {
        double? tigia_ = await Vcbsv.Getexchange_cur(item.Loaitiente);
        item.tigia = tigia_;
    }
}
