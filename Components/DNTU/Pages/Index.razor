            return "color: #000000";

        var rs = M_Trangthais
        .Where(t => (t.Noidung).Contains(x.Trangthai, StringComparison.InvariantCultureIgnoreCase)
            && t.Tieude.Equals("DNTU", StringComparison.InvariantCultureIgnoreCase))
        .Select(t => t.Mamau)
        .FirstOrDefault();
        return "color: " + rs;


