@page "/DNTU"
@using System.Globalization
@attribute [Authorize]
@inject GlobalServices gsv
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject AccountService asv
@inject SharedServices ssv
@inject BookingService bksv
@inject IJSRuntime JSRuntime
@inject SupportServices supsv
@inject IStringLocalizer<SharedResource> Localizer
@inject LocalChargesServices lcsv
@inject Bieugianangha_Services Bgnhsv
@inject CustomerService Cussv
@inject DNTUServices DNTUSV


<PageTitle>@Localizer["DNTU"] </PageTitle>
<MudText Class="pa-2" Typo="Typo.h6">@Localizer["DNTU"]</MudText>
<MudStack Row Justify="Justify.FlexStart" Class="pa-4">
    <MudButton HtmlTag="label"
               OnClick="Refresh"
               Size="Size.Small" Color="Color.Primary" Variant="   Variant.Filled"
               StartIcon="@Icons.Material.Filled.Refresh">
        @Localizer["reload"]
    </MudButton>
    <MudButton HtmlTag="label"
               @onclick="@((e) => OpenCreateDialog(new Models.M_DNTU()))"
               Size="Size.Small" Color="Color.Secondary" Variant="Variant.Filled"
               StartIcon="@Icons.Material.Filled.Add">
        @Localizer["new"]
    </MudButton>

    <MudButton HtmlTag="label"
               @onclick="@((e) => OpenEditDialog(detail))"
               Size="Size.Small" Color="Color.Info" Variant="Variant.Filled"
               StartIcon="@Icons.Material.Filled.Edit">
        @Localizer["edit"]
    </MudButton>

   @*  <MudButton HtmlTag="label"
               @onclick="@((e) => OpenDuplicateDialog(detail))"
               Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled"
               StartIcon="@Icons.Material.Filled.CopyAll">
        @Localizer["duplicate"]
    </MudButton> *@

</MudStack>

<MudDataGrid T="M_DNTU" Items="@Listdata" Filterable="true" @ref="mudTable" Class="pa-4" Bordered="true"
             FilterMode="@DataGridFilterMode.ColumnFilterRow" Dense="true" Virtualize="true" QuickFilter="@FilterFunc1"
             FixedHeader="true" FixedFooter="true" HeaderClass="no-wrap" FooterClass="no-wrap"
             ReadOnly="false" CommittedItemChanges="@CommittedItem" RowClassFunc="@SelectedRowClassFunc"
             RowClick="@RowClicked" EditDialogOptions="@options"
             ColumnResizeMode="@(_resizeColumn ? ResizeMode.Column : ResizeMode.Container)" Loading="_loading">
    <Columns>
        <HierarchyColumn T="M_DNTU" />
        <TemplateColumn CellClass="d-flex justify-end">
            <CellTemplate>

                <MudIconButton Icon="@Icons.Material.Outlined.Delete" OnClick="@(()=>DeleteItem(context.Item))" />
            </CellTemplate>
        </TemplateColumn>

        <PropertyColumn Property="x=>x.So" Title="@Localizer["So"]" Required="false" CellStyleFunc="_cellStyleFunc">
        </PropertyColumn>

        <PropertyColumn Property="x=>x.NGAY" Title="@Localizer["NGAY"]" Required="false" CellStyleFunc="_cellStyleFunc" Format="dd/MM/yyyy">
        </PropertyColumn>

        <PropertyColumn Property="x=>x.Kinhgui" Title="@Localizer["Kinhgui"]" Required="false" CellStyleFunc="_cellStyleFunc">
        </PropertyColumn>

        <PropertyColumn Property="x=>x.Tennguoidenghi" Title="@Localizer["Tennguoidenghi"]" Required="false" CellStyleFunc="_cellStyleFunc">
        </PropertyColumn>

        <PropertyColumn Property="x=>x.Bophan" Title="@Localizer["bophan"]" Required="false" CellStyleFunc="_cellStyleFunc">
        </PropertyColumn>

        <PropertyColumn Property="x=>x.Noidung" Title="@Localizer["noidung"]" Required="false" CellStyleFunc="_cellStyleFunc">
        </PropertyColumn>

        <PropertyColumn Property="x=>x.Sotien" Title="@Localizer["sotien"]" Format="#,##0.##" Culture="@_en" Required="false" CellClass="custom-right-align" CellStyleFunc="_cellStyleFunc">
        </PropertyColumn>

        <PropertyColumn Property="x=>x.Sotienhoanung" Title="@Localizer["sotienhoanung"]" Format="#,##0.##" Culture="@_en" Required="false" CellClass="custom-right-align" CellStyleFunc="_cellStyleFunc">
        </PropertyColumn>

        <PropertyColumn Property="x=>x.Loaitiente" Title="@Localizer["Loaitiente"]" Required="false" CellStyleFunc="_cellStyleFunc">
        </PropertyColumn>

        <PropertyColumn Property="x=>x.tigia" Title="@Localizer["tigia"]" Format="#,##0.##" Culture="@_en" Required="false" CellClass="custom-right-align" CellStyleFunc="_cellStyleFunc">
        </PropertyColumn>

        <PropertyColumn Property="x=>x.Sotienconlai" Title="@Localizer["sotienconlai"]" Format="#,##0.##" Culture="@_en" Required="false" CellClass="custom-right-align" CellStyleFunc="_cellStyleFunc">
        </PropertyColumn>

        <PropertyColumn Property="x=>x.Chungtukemtheo" Title="@Localizer["Chungtukemtheo"]" Required="false" CellStyleFunc="_cellStyleFunc">
        </PropertyColumn>

        <PropertyColumn Property="x=>x.Bkno" Title="@Localizer["BookingNo"]" Required="false" CellStyleFunc="_cellStyleFunc">
        </PropertyColumn>

        <PropertyColumn Property="x=>x.Hbl" Title="@Localizer["HBL"]" Required="false" CellStyleFunc="_cellStyleFunc">
        </PropertyColumn>

        <PropertyColumn Property="x=>x.Files" Title="@Localizer["Files"]" Required="false" CellStyleFunc="_cellStyleFunc">
        </PropertyColumn>

        <TemplateColumn Title="@Localizer["Approve"]">
            <CellTemplate>
                <MudCheckBox @bind-Checked="context.Item.Approve" @bind-Value="context.Item.Approve" @bind-Value:after="@(()=> OnApproveCheckboxWrapper(context.Item))">
                </MudCheckBox>
            </CellTemplate>
        </TemplateColumn>

        <PropertyColumn Property="x=>x.Continued" Title="@Localizer["Continued"]" Required="false" CellStyleFunc="_cellStyleFunc">
        </PropertyColumn>
  
    </Columns>

     <ChildRowContent>
       
                <DNHU_Index _DNTU_details="context.Item" />
     
    </ChildRowContent>

    <PagerContent>
        <MudDataGridPager T="Models.M_DNTU" PageSizeOptions="@(new int[] { 8, 10, 20 })" />
    </PagerContent>
</MudDataGrid>

@code {
    List<M_DNTU> Listdata = new List<M_DNTU>();
    MudDataGrid<M_DNTU> mudTable;
    AuthUser user;
    string mailtp, mailpp;
    string usr;
    private List<string> ListUser { get; set; } = new List<string>();
    string UserHanding;
    List<string> trangthais = new List<string>();
    private List<Models.TrangThai> M_Trangthais = new List<Models.TrangThai>();
    private string searchText_pol = "";
    private string searchText_pod = "";
    private List<PortModel> filteredPorts = new List<PortModel>();
    private List<PortModel> filteredPorts_pod = new List<PortModel>();
    private List<PortModel> Ports = new List<PortModel>();
    private bool _resizeColumn;
    M_DNTU detail;
    private List<Models.M_Customer> CustomerList = new List<Models.M_Customer>();
    private List<M_Customer> filteredCarr = new List<M_Customer>();
    private List<M_Customer> Cuss_Carr = new List<M_Customer>();
    private List<Terminal_> Terminals = new List<Terminal_>();

    public CultureInfo _en = CultureInfo.GetCultureInfo("en-US");

    protected async override Task OnInitializedAsync()
    {
        CustomerList = await Cussv.GetList();
        M_Trangthais = await supsv.GetListTrangThai();
        var tts = await supsv.GetListTrangThai();
        trangthais = tts.Where(x => x.Tieude == "DNTU").OrderBy(x => x.Noidung).Select(x => x.Noidung).ToList();

        Terminals = await gsv.GetList_Terminal();
        ListUser = await asv.GetList_User_handle() ?? new List<string>();
        usr = asv.GetAuth().Result.User.Identity!.Name!;
        Cuss_Carr = await lcsv.GetList_Customer_line();
        // await Refresh();
    }

    string CustomerName(Guid? customerID)
    {
        var rs = CustomerList.FirstOrDefault(x => x.Customer_ID == customerID);
        return rs != null ? rs.COMPANY! : "";
    }

    bool _loading = false;
    async Task Refresh()
    {
        try
        {

            detail = null!;
            _loading = true;
            Listdata.Clear();

            await Task.Delay(500);
            if (!await ssv.CheckPermission(usr, "View", "DNTU"))
            {
                CallSnackBar("You have not access to view", MudBlazor.Severity.Warning);
                return;
            }
            Listdata = await DNTUSV.GetList_DNTU();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            CallSnackBar("Something went wrong!, error code: " + ex.Message, MudBlazor.Severity.Warning);
        }
        finally
        {
            _loading = false;
        }

    }

    void CallSnackBar(string message, MudBlazor.Severity severity)
    {
        Snackbar.Clear();
        Snackbar.Configuration.SnackbarVariant = Variant.Filled;
        Snackbar.Configuration.MaxDisplayedSnackbars = 3;
        Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopRight;
        Snackbar.Add(message, severity);
    }
    void RowClicked(DataGridRowClickEventArgs<M_DNTU> args)
    {
        detail = args.Item;
    }
    private int selectedRowNumber = -1;
    private string SelectedRowClassFunc(M_DNTU m, int rowNumber)
    {
        if (selectedRowNumber == rowNumber)
        {
            selectedRowNumber = -1;
            return string.Empty;
        }
        else if (mudTable.SelectedItem != null && mudTable.SelectedItem.Equals(m))
        {
            selectedRowNumber = rowNumber;
            return "selected";
        }
        else
        {
            return string.Empty;
        }
    }

    async Task CommittedItem(M_DNTU item)
    {
        item.UserUpdate = asv.GetAuth().Result.User.Identity!.Name!;
        item.Dateupdate = DateTime.Now.ToString("dd/MMM/yyyy");
        var rs = item.Id != Guid.Empty ? await DNTUSV.UpdateDeNghiTamUng_Detail(item) : await DNTUSV.CreateDeNghiTamUng_Detail(item);
        CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);

        await Refresh();
    }
    int? index_no;

    async Task DeleteItem(M_DNTU item)
    {
        if (item.Approve == true)
        {
            CallSnackBar("Data đã được Approve!!! , vui lòng bỏ Approve", MudBlazor.Severity.Warning);
            return;
        }
        if (!await ssv.CheckPermission(usr, "Delete", "DNTU"))
        {
            CallSnackBar("You have not access to Delete", MudBlazor.Severity.Warning);
            return;
        }
        var resultMess = await DialogService.ShowMessageBox(
                "Warning",
                "Deleting can not be undone!",
                yesText: "Delete!", cancelText: "Cancel");

        if (resultMess.HasValue)
        {
            var rs = await DNTUSV.DeleteDeNghiTamUng_Detail(item);
            CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
            await Refresh();
        }

    }
    DialogOptions options = new DialogOptions
        {
            ClassBackground = "class-dialog-custom",
            FullWidth = true,
            MaxWidth = MaxWidth.Medium,
            CloseOnEscapeKey = false,
            DisableBackdropClick = true
        };
    string search;

    private bool FilterFunc1(M_DNTU sbd) => FilterFunc(sbd, search);

    private bool FilterFunc(M_DNTU sbd, string searchString)
    {
        if (string.IsNullOrWhiteSpace(sbd.So))
            return true;
        if (string.IsNullOrWhiteSpace(searchString))
            return true;
        if (sbd.So!.Contains(searchString, StringComparison.OrdinalIgnoreCase))
            return true;
        if ($"{sbd.So} ".Contains(searchString))
            return true;
        return false;
    }

    private Func<M_DNTU, string> _cellStyleFunc => x =>
       {
           string style = "";

           if (string.IsNullOrEmpty(x.Trangthai))
               return "color: #000000";

           var rs = M_Trangthais
           .Where(t => (t.Noidung).Contains(x.Trangthai, StringComparison.InvariantCultureIgnoreCase)
               && t.Tieude.Equals("DNTU", StringComparison.InvariantCultureIgnoreCase))
           .Select(t => t.Mamau)
           .FirstOrDefault();
           return "color: " + rs;


       };

    private async Task OpenCreateDialog(Models.M_DNTU tr)
    {
        var optionsdialog = new DialogOptions { ClassBackground = "class-dialog-custom", FullWidth = true, MaxWidth = MaxWidth.Medium };

        if (await ssv.CheckPermission(asv.GetAuth().Result.User.Identity.Name, "Add", "DNTU"))
        {

            DialogOptions closeOnEscapeKey = new DialogOptions() { CloseOnEscapeKey = true };
            var parameters = new DialogParameters<ADD> { { x => x._DNTU_Detail, tr }, { x => x.Status, "add" } };

            var dialog = await DialogService.ShowAsync<ADD>(tr.Id == Guid.Empty ? "Advance Request Create" : "Advance Request Edit", parameters, optionsdialog);
            var result = await dialog.Result;
            if (!result.Canceled)
            {
                var data = (M_DNTU)result.Data;
                var rs = await DNTUSV.UpdateCreateDeNghiTamUng(data);
                MudBlazor.Severity severity;
                if (rs[1] == "1")
                    severity = MudBlazor.Severity.Success;
                else
                    severity = MudBlazor.Severity.Error;

                CallSnackBar(rs[0], severity);

                await HandleRefresh_create(data.Id);

            }

            return;

        }
        else
        {
            CallSnackBar("You have not access to Create", MudBlazor.Severity.Warning);
            return;
        }

    }

    async Task HandleRefresh_create(Guid? id)
    {
        try
        {

            detail = null;


            if (Listdata != null)
            {
                Listdata.Clear();
            }

            await Task.Delay(500);

            if (!await ssv.CheckPermission(asv.GetAuth().Result.User.Identity.Name, "View", "DNTU"))
            {
                CallSnackBar("You have not access to view", MudBlazor.Severity.Warning);

                return;
            }
            Listdata = await DNTUSV.GetListDeNghiTamUng_create(id);
            StateHasChanged();
        }
        finally
        {


        }
    }

    private async Task OpenEditDialog(Models.M_DNTU tr)
    {
        var optionsdialog = new DialogOptions { ClassBackground = "class-dialog-custom", FullWidth = true, MaxWidth = MaxWidth.Medium };
        if (tr == null)
        {
            CallSnackBar("Please select Data", MudBlazor.Severity.Warning);
            return;
        }
        if (tr.Approve == true)
        {
            CallSnackBar("Data đã được Approve!!! , vui lòng bỏ Approve", MudBlazor.Severity.Warning);
            return;
        }
        if (await ssv.CheckPermission(asv.GetAuth().Result.User.Identity.Name, "Edit", "DNTU"))
        {

            DialogOptions closeOnEscapeKey = new DialogOptions() { CloseOnEscapeKey = true };
            var parameters = new DialogParameters<ADD> { { x => x._DNTU_Detail, tr }, { x => x.Status, "edit" } };

            var dialog = await DialogService.ShowAsync<ADD>(tr.Id == Guid.Empty ? "Advance Request Edit" : "Advance Request Edit", parameters, optionsdialog);
            var result = await dialog.Result;
            // Giữ nguyên dòng được chọn
            selectedRowNumber = selectedRowNumber;
            StateHasChanged();

            if (!result.Canceled)
            {
                var data = (M_DNTU)result.Data;
                var rs = await DNTUSV.UpdateCreateDeNghiTamUng(data);
                MudBlazor.Severity severity;
                if (rs[1] == "1")
                    severity = MudBlazor.Severity.Success;
                else
                    severity = MudBlazor.Severity.Error;

                CallSnackBar(rs[0], severity);
            }

            return;

        }
        else
        {
            CallSnackBar("You have not access to Edit", MudBlazor.Severity.Warning);
            return;
        }

    }

    private async Task OpenDuplicateDialog(Models.M_DNTU tr)
    {
        var optionsdialog = new DialogOptions { ClassBackground = "class-dialog-custom", FullWidth = true, MaxWidth = MaxWidth.Medium };
        if (tr == null)
        {
            CallSnackBar("Please select Data", MudBlazor.Severity.Warning);
            return;
        }
     
        if (await ssv.CheckPermission(asv.GetAuth().Result.User.Identity.Name, "Add", "DNTU"))
        {

            DialogOptions closeOnEscapeKey = new DialogOptions() { CloseOnEscapeKey = true };
            var parameters = new DialogParameters<ADD> { { x => x._DNTU_Detail, tr }, { x => x.Status, "Duplicate" } };

            var dialog = await DialogService.ShowAsync<ADD>(tr.Id == Guid.Empty ? "Advance Request Create" : "Advance Request Create", parameters, optionsdialog);
            var result = await dialog.Result;
            // Giữ nguyên dòng được chọn
            selectedRowNumber = selectedRowNumber;
            StateHasChanged();

            if (!result.Canceled)
            {
                var data = (M_DNTU)result.Data;
                var rs = await DNTUSV.UpdateCreateDeNghiTamUng(data);
                MudBlazor.Severity severity;
                if (rs[1] == "1")
                    severity = MudBlazor.Severity.Success;
                else
                    severity = MudBlazor.Severity.Error;

                CallSnackBar(rs[0], severity);
                await HandleRefresh_create(data.Id);
            }

            return;

        }
        else
        {
            CallSnackBar("You have not access to Create", MudBlazor.Severity.Warning);
            return;
        }

    }

    private async Task GetT_BieugiananghaNo(M_DNTU item)
    {

        int formattedYear = DateTime.Now.Year;
        int formattedMonth = DateTime.Now.Month;

        string usr = asv.GetAuth().Result.User.Identity!.Name!;
        var refno = await supsv.GetRefNoByFunc("DNTU", formattedMonth, formattedYear, usr);

        var rs = asv.GetUserDetail();
        var cn = rs.Branch;
        item.So = cn + "DNTU_" + formattedYear.ToString() + formattedMonth.ToString() + refno.Value.ToString("D4");

    }
    private async Task OnApproveCheckboxWrapper(M_DNTU item)
    {
        if (await ssv.CheckPermission(asv.GetAuth().Result.User.Identity.Name, "Approve", "DNTU"))
        {
            var rs = await DNTUSV.UpdateCreateDeNghiTamUng(item);
            MudBlazor.Severity severity;
            if (rs[1] == "1")
                severity = MudBlazor.Severity.Success;
            else
                severity = MudBlazor.Severity.Error;

            CallSnackBar(rs[0], severity);
        }
        else
        {
            CallSnackBar("You have not access to Approve", MudBlazor.Severity.Warning);
            return;
        }

    }
   
}
