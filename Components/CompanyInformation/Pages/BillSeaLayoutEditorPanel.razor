    void BeginInteractionUndo()
    {
        if (_interactionUndoPushed)
            return;

        PushUndo();
        _interactionUndoPushed = true;
    }

    void BeginBoxResize(BillSeaDesignElement item, BoxResizeHandle handle, MouseEventArgs e)
    {
        SetSingleSelection(item);
        BeginInteractionUndo();
        _activeItem = item;
        _selectedElement = item;
        _interaction = handle switch
        {
            BoxResizeHandle.NorthWest => ElementInteraction.BoxResizeNorthWest,
            BoxResizeHandle.North => ElementInteraction.BoxResizeNorth,
            BoxResizeHandle.NorthEast => ElementInteraction.BoxResizeNorthEast,
            BoxResizeHandle.West => ElementInteraction.BoxResizeWest,
            BoxResizeHandle.East => ElementInteraction.BoxResizeEast,
            BoxResizeHandle.SouthWest => ElementInteraction.BoxResizeSouthWest,
            BoxResizeHandle.South => ElementInteraction.BoxResizeSouth,
            _ => ElementInteraction.BoxResizeSouthEast
        };
    }

    void BeginLineResize(BillSeaDesignElement item, bool isStart, MouseEventArgs e)
    {
        SetSingleSelection(item);
        BeginInteractionUndo();
        _activeItem = item;
        _selectedElement = item;
        _interaction = isStart ? ElementInteraction.LineResizeStart : ElementInteraction.LineResizeEnd;
    }

    void OnCanvasMouseMove(MouseEventArgs e)
    {
        if (_activeItem is null)
            return;

        var x = e.OffsetX / Scale;
        var y = e.OffsetY / Scale;

        switch (_interaction)
        {
            case ElementInteraction.Move:
            {
                var deltaX = (e.ClientX - _dragPointerStartClientX) / Scale;
                var deltaY = (e.ClientY - _dragPointerStartClientY) / Scale;
                var newLeft = _dragAnchorStartLeft + deltaX;
                var newTop = _dragAnchorStartTop + deltaY;
                var maxLeft = Math.Max(0, PageWidthInches - _activeItem.Width);
                var maxTop = Math.Max(0, PageHeightInches - _activeItem.Height);
                var clampedLeft = Math.Clamp(newLeft, 0, maxLeft);
                var clampedTop = Math.Clamp(newTop, 0, maxTop);
                var appliedDeltaX = clampedLeft - _dragAnchorStartLeft;
                var appliedDeltaY = clampedTop - _dragAnchorStartTop;

                foreach (var selected in GetSelectedElements())
                {
                    if (!_dragGroupStarts.TryGetValue(selected.Name, out var start))
                        continue;

                    var targetLeft = start.Left + appliedDeltaX;
                    var targetTop = start.Top + appliedDeltaY;
                    var itemMaxLeft = Math.Max(0, PageWidthInches - selected.Width);
                    var itemMaxTop = Math.Max(0, PageHeightInches - selected.Height);
                    selected.Left = Math.Clamp(targetLeft, 0, itemMaxLeft);
                    selected.Top = Math.Clamp(targetTop, 0, itemMaxTop);
                }

                break;
            }
            case ElementInteraction.LineResizeEnd when _activeItem.Kind == BillSeaElementKind.HorizontalLine:
                _activeItem.Width = Math.Clamp(x - _activeItem.Left, 0.1, PageWidthInches - _activeItem.Left);
                break;
            case ElementInteraction.LineResizeStart when _activeItem.Kind == BillSeaElementKind.HorizontalLine:
            {
                var right = _activeItem.Left + _activeItem.Width;
                var newLeft = Math.Clamp(x, 0, right - 0.1);
                _activeItem.Left = newLeft;
                _activeItem.Width = right - newLeft;
                break;
            }
            case ElementInteraction.LineResizeEnd when _activeItem.Kind == BillSeaElementKind.VerticalLine:
                _activeItem.Height = Math.Clamp(y - _activeItem.Top, 0.1, PageHeightInches - _activeItem.Top);
                break;
            case ElementInteraction.LineResizeStart when _activeItem.Kind == BillSeaElementKind.VerticalLine:
            {
                var bottom = _activeItem.Top + _activeItem.Height;
                var newTop = Math.Clamp(y, 0, bottom - 0.1);
                _activeItem.Top = newTop;
                _activeItem.Height = bottom - newTop;
                break;
            }
            case ElementInteraction.BoxResizeEast:
                _activeItem.Width = Math.Clamp(x - _activeItem.Left, MinBoxSizeInches, PageWidthInches - _activeItem.Left);
                break;
            case ElementInteraction.BoxResizeWest:
            {
                var right = _activeItem.Left + _activeItem.Width;
                var newLeft = Math.Clamp(x, 0, right - MinBoxSizeInches);
                _activeItem.Left = newLeft;
                _activeItem.Width = right - newLeft;
                break;
            }
            case ElementInteraction.BoxResizeSouth:
                _activeItem.Height = Math.Clamp(y - _activeItem.Top, MinBoxSizeInches, PageHeightInches - _activeItem.Top);
                break;
            case ElementInteraction.BoxResizeNorth:
            {
                var bottom = _activeItem.Top + _activeItem.Height;
                var newTop = Math.Clamp(y, 0, bottom - MinBoxSizeInches);
                _activeItem.Top = newTop;
                _activeItem.Height = bottom - newTop;
                break;
            }
            case ElementInteraction.BoxResizeSouthEast:
                ResizeBoxCorner(x, y, resizeLeft: false, resizeTop: false);
                break;
            case ElementInteraction.BoxResizeSouthWest:
                ResizeBoxCorner(x, y, resizeLeft: true, resizeTop: false);
                break;
            case ElementInteraction.BoxResizeNorthEast:
                ResizeBoxCorner(x, y, resizeLeft: false, resizeTop: true);
                break;
            case ElementInteraction.BoxResizeNorthWest:
                ResizeBoxCorner(x, y, resizeLeft: true, resizeTop: true);
                break;
        }
    }

    void ResizeBoxCorner(double x, double y, bool resizeLeft, bool resizeTop)
    {
        if (_activeItem is null)
            return;

        var right = _activeItem.Left + _activeItem.Width;
        var bottom = _activeItem.Top + _activeItem.Height;

        if (resizeLeft)
        {
            var newLeft = Math.Clamp(x, 0, right - MinBoxSizeInches);
            _activeItem.Left = newLeft;
            _activeItem.Width = right - newLeft;
        }
        else
        {
            _activeItem.Width = Math.Clamp(x - _activeItem.Left, MinBoxSizeInches, PageWidthInches - _activeItem.Left);
        }

        if (resizeTop)
        {
            var newTop = Math.Clamp(y, 0, bottom - MinBoxSizeInches);
            _activeItem.Top = newTop;
            _activeItem.Height = bottom - newTop;
        }
        else
        {
            _activeItem.Height = Math.Clamp(y - _activeItem.Top, MinBoxSizeInches, PageHeightInches - _activeItem.Top);
        }
    }

    void EndInteraction()
    {
        _activeItem = null;
        _interaction = ElementInteraction.None;
        _interactionUndoPushed = false;
        _dragGroupStarts.Clear();
    }

    void ShowMessage(string message, MudBlazor.Severity severity)
    {
        Snackbar.Clear();
        Snackbar.Configuration.SnackbarVariant = Variant.Filled;
        Snackbar.Configuration.MaxDisplayedSnackbars = 3;
        Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopRight;
        Snackbar.Add(message, severity);
    }
}
