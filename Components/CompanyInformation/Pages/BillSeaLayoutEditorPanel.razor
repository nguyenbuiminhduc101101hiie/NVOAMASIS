@using System.Globalization
@using System.Xml.Linq
@using NVOAMASIS.Models
@using NVOAMASIS.Services
@inject BillSeaReportTemplateService TemplateService
@inject SharedServices ssv
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<MudStack Row Spacing="2" Class="pa-4" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
    <MudButton OnClick="LoadLayout"
               Size="Size.Small"
               Color="Color.Primary"
               Variant="Variant.Filled"
               StartIcon="@Icons.Material.Filled.Refresh"
               Disabled="_loading">
        Tải form
    </MudButton>
    <MudButton OnClick="SaveLayout"
               Size="Size.Small"
               Color="Color.Success"
               Variant="Variant.Filled"
               StartIcon="@Icons.Material.Filled.Save"
               Disabled="_loading || !_pages.Any()">
        Lưu layout công ty
    </MudButton>
    <MudButton OnClick="ResetToDefaultTemplate"
               Size="Size.Small"
               Color="Color.Warning"
               Variant="Variant.Outlined"
               StartIcon="@Icons.Material.Filled.Restore"
               Disabled="_loading || !_usesCustomTemplate">
        Khôi phục mặc định
    </MudButton>
    <MudButton OnClick="UndoLastChange"
               Size="Size.Small"
               Color="Color.Default"
               Variant="Variant.Outlined"
               StartIcon="@Icons.Material.Filled.Undo"
               Disabled="_loading || _undoStack.Count == 0">
        Hoàn tác
    </MudButton>
    <MudButton OnClick="() => BeginPlacement(BillSeaElementKind.HorizontalLine)"
               Size="Size.Small"
               Color="@(_pendingPlacementKind == BillSeaElementKind.HorizontalLine ? Color.Primary : Color.Default)"
               Variant="@(_pendingPlacementKind == BillSeaElementKind.HorizontalLine ? Variant.Filled : Variant.Outlined)"
               StartIcon="@Icons.Material.Filled.HorizontalRule"
               Disabled="_loading || CurrentPage is null">
        Line ngang
    </MudButton>
    <MudButton OnClick="() => BeginPlacement(BillSeaElementKind.VerticalLine)"
               Size="Size.Small"
               Color="@(_pendingPlacementKind == BillSeaElementKind.VerticalLine ? Color.Primary : Color.Default)"
               Variant="@(_pendingPlacementKind == BillSeaElementKind.VerticalLine ? Variant.Filled : Variant.Outlined)"
               StartIcon="@Icons.Material.Filled.MoreVert"
               Disabled="_loading || CurrentPage is null">
        Line dọc
    </MudButton>
    <MudButton OnClick="() => BeginPlacement(BillSeaElementKind.StaticText)"
               Size="Size.Small"
               Color="@(_pendingPlacementKind == BillSeaElementKind.StaticText ? Color.Primary : Color.Default)"
               Variant="@(_pendingPlacementKind == BillSeaElementKind.StaticText ? Variant.Filled : Variant.Outlined)"
               StartIcon="@Icons.Material.Filled.TextFields"
               Disabled="_loading || CurrentPage is null">
        Label text
    </MudButton>
    <MudButton OnClick="DeleteSelected"
               Size="Size.Small"
               Color="Color.Error"
               Variant="Variant.Outlined"
               StartIcon="@Icons.Material.Filled.Delete"
               Disabled="_loading || !HasDeletableSelection()">
        Xóa đã chọn
    </MudButton>
    @if (_pages.Count > 1)
    {
        <MudSelect T="string"
                   Label="Chọn page"
                   @bind-Value="_selectedPageName"
                   Variant="Variant.Outlined"
                   Margin="Margin.Dense"
                   Style="min-width:220px;">
            @foreach (var pageLayout in _pages)
            {
                <MudSelectItem Value="@pageLayout.PageName">@pageLayout.PageName (@pageLayout.Elements.Count phần tử)</MudSelectItem>
            }
        </MudSelect>
    }
    <MudTextField @bind-Value="_keyword"
                  Label="Lọc tên"
                  Variant="Variant.Outlined"
                  Margin="Margin.Dense"
                  Immediate="true"
                  Adornment="Adornment.Start"
                  AdornmentIcon="@Icons.Material.Filled.Search"
                  Style="min-width:240px;" />
</MudStack>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Class="mx-4" />
}

<MudPaper Class="pa-4 mx-4 mb-4" Outlined="true">
    <MudText Typo="Typo.body2" Color="Color.Secondary">
        Layout được lưu riêng theo database công ty đang đăng nhập. File @ReportFileName trong project chỉ là template mặc định.
        @if (_usesCustomTemplate)
        {
            <span> Đang dùng <b>bản tùy chỉnh</b> của công ty.</span>
        }
        else
        {
            <span> Đang dùng <b>template mặc định</b>.</span>
        }
        Bấm Line ngang / Line dọc / Label text rồi <b>click lên canvas</b> để đặt đúng vị trí (bấm lại nút đó hoặc Esc để hủy). Giữ Ctrl + click để chọn nhiều phần tử.
    </MudText>
</MudPaper>

@if (_pendingPlacementKind is not null)
{
    <MudAlert Class="mx-4 mb-4" Severity="MudBlazor.Severity.Info" Variant="Variant.Outlined" Dense="true">
        Đang chọn vị trí cho <b>@GetPlacementLabel()</b> — click lên form để đặt. Bấm lại nút trên hoặc phím Esc để hủy.
    </MudAlert>
}

@if (_selectedNames.Count == 1 && _selectedElement is { Kind: BillSeaElementKind.HorizontalLine or BillSeaElementKind.VerticalLine })
{
    <MudPaper Class="pa-4 mx-4 mb-4" Outlined="true">
        <MudStack Row Spacing="3" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
            <MudNumericField T="double"
                             Value="_selectedElement.LineSize"
                             ValueChanged="OnSelectedLineSizeChanged"
                             Label="Độ dày line"
                             Variant="Variant.Outlined"
                             Margin="Margin.Dense"
                             Min="1"
                             Max="20"
                             Step="1"
                             Style="max-width:160px;" />
            <MudSlider T="double"
                       Value="_selectedElement.LineSize"
                       ValueChanged="OnSelectedLineSizeChanged"
                       Min="1"
                       Max="20"
                       Step="1"
                       Style="min-width:220px;max-width:360px;" />
            <MudText Typo="Typo.caption" Color="Color.Secondary">
                @_selectedElement.LineSize.ToString("0.##", CultureInfo.InvariantCulture) pt
            </MudText>
        </MudStack>
    </MudPaper>
}

@if (HasSelectedTextElements())
{
    <MudPaper Class="pa-4 mx-4 mb-4" Outlined="true">
        <MudStack Spacing="3">
            @if (_selectedNames.Count == 1 && _selectedElement?.Kind == BillSeaElementKind.StaticText)
            {
                <MudTextField Value="_selectedElement.Text"
                              ValueChanged="@((string value) => OnSelectedTextChanged(value))"
                              Label="Nội dung label đang chọn"
                              Variant="Variant.Outlined"
                              Immediate="true" />
            }
            else if (GetSelectedTextElements().Count > 1)
            {
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    Cỡ chữ cho @GetSelectedTextElements().Count phần tử text đang chọn
                </MudText>
            }

            <MudStack Row Spacing="3" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                <MudNumericField T="double"
                                 Value="GetFontSizeEditorValue()"
                                 ValueChanged="OnSelectedFontSizeChanged"
                                 Label="Cỡ chữ"
                                 Variant="Variant.Outlined"
                                 Margin="Margin.Dense"
                                 Min="4"
                                 Max="72"
                                 Step="1"
                                 Style="max-width:160px;" />
                <MudSlider T="double"
                           Value="GetFontSizeEditorValue()"
                           ValueChanged="OnSelectedFontSizeChanged"
                           Min="4"
                           Max="72"
                           Step="1"
                           Style="min-width:220px;max-width:360px;" />
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    @GetFontSizeEditorValue().ToString("0.##", CultureInfo.InvariantCulture) pt
                </MudText>
            </MudStack>
        </MudStack>
    </MudPaper>
}

<MudPaper Class="pa-4 mx-4 mb-4" Outlined="true">
    @if (CurrentPage is null)
    {
        <MudAlert Severity="MudBlazor.Severity.Info" Variant="Variant.Outlined">
            Bấm "Tải form" để bắt đầu thiết kế.
        </MudAlert>
    }
    else
    {
        <div style="@GetCanvasStyle()" tabindex="0" @onkeydown="OnCanvasKeyDown">
            @if (_selectedNames.Count > 1)
            {
                <MudText Typo="Typo.caption" Color="Color.Primary" Style="position:absolute;top:4px;right:8px;z-index:120;">
                    Đã chọn @_selectedNames.Count phần tử
                </MudText>
            }

            <div style="@GetElementsLayerStyle()">
            @foreach (var item in SortedElements)
            {
                @if (item.Kind is BillSeaElementKind.HorizontalLine or BillSeaElementKind.VerticalLine)
                {
                    <div style="@GetLineContainerStyle(item)"
                         @onmousedown="(e => OnElementMouseDown(item, e))"
                         @onmousedown:preventDefault="true">
                        <div style="@GetLineVisualStyle(item)"></div>

                        @if (IsSelected(item) && _selectedNames.Count == 1)
                        {
                            <div style="@GetLineHandleStyle(item, isStart: true)"
                                 @onmousedown="(e => BeginLineResize(item, isStart: true, e))"
                                 @onmousedown:preventDefault="true"
                                 @onmousedown:stopPropagation="true"></div>
                            <div style="@GetLineHandleStyle(item, isStart: false)"
                                 @onmousedown="(e => BeginLineResize(item, isStart: false, e))"
                                 @onmousedown:preventDefault="true"
                                 @onmousedown:stopPropagation="true"></div>
                        }
                    </div>
                }
                else if (item.Kind == BillSeaElementKind.Image)
                {
                    <div style="@GetImageBoxStyle(item)"
                         @onmousedown="(e => OnElementMouseDown(item, e))"
                         @onmousedown:preventDefault="true">
                        @if (_logoDataUrl is not null)
                        {
                            <img src="@_logoDataUrl" alt="@item.Name" style="width:100%;height:100%;object-fit:contain;pointer-events:none;" />
                        }
                        else
                        {
                            <span style="@GetImageLabelStyle(item)">@(string.IsNullOrWhiteSpace(item.Text) ? item.Name : item.Text)</span>
                        }

                        @if (IsSelected(item) && _selectedNames.Count == 1)
                        {
                            @foreach (var handle in BoxResizeHandles)
                            {
                                <div style="@GetBoxHandleStyle(handle)"
                                     @onmousedown="(e => BeginBoxResize(item, handle, e))"
                                     @onmousedown:preventDefault="true"
                                     @onmousedown:stopPropagation="true"></div>
                            }
                        }
                    </div>
                }
                else
                {
                    <div style="@GetBoxStyle(item)"
                         @onmousedown="(e => OnElementMouseDown(item, e))"
                         @onmousedown:preventDefault="true">
                        <span style="@GetTextPreviewStyle(item)">
                            @(string.IsNullOrWhiteSpace(item.Text) ? item.Name : item.Text)
                        </span>

                        @if (IsSelected(item) && _selectedNames.Count == 1)
                        {
                            @foreach (var handle in BoxResizeHandles)
                            {
                                <div style="@GetBoxHandleStyle(handle)"
                                     @onmousedown="(e => BeginBoxResize(item, handle, e))"
                                     @onmousedown:preventDefault="true"
                                     @onmousedown:stopPropagation="true"></div>
                            }
                        }
                    </div>
                }
            }
            </div>

            @if (_pendingPlacementKind is not null && _placementPreviewVisible)
            {
                <div style="@GetPlacementPreviewStyle()"></div>
            }

            @if (_pendingPlacementKind is not null)
            {
                <div style="@GetPlacementOverlayStyle()"
                     @onmousemove="OnPlacementMouseMove"
                     @onmouseleave="OnPlacementMouseLeave"
                     @onmousedown="OnPlacementClick"
                     @onmousedown:preventDefault="true"
                     @onmousedown:stopPropagation="true"></div>
            }

            @if (_activeItem is not null)
            {
                <div style="position:absolute;inset:0;z-index:10000;cursor:@GetOverlayCursor();background:transparent;touch-action:none;"
                     @onmousemove="OnCanvasMouseMove"
                     @onmousemove:preventDefault="true"
                     @onmouseup="EndInteraction"
                     @onmouseleave="EndInteraction"></div>
            }
        </div>
    }
</MudPaper>

@code {
    [Parameter] public string ReportFileName { get; set; } = string.Empty;
    [Parameter] public string UserName { get; set; } = string.Empty;
    [Parameter] public byte[]? FormBillSeaLogo { get; set; }

    const double PreviewWidthPx = 900;
    string? _logoDataUrl;
    bool _usesCustomTemplate;
    bool _loading;
    string _keyword = string.Empty;
    string _selectedPageName = string.Empty;
    List<BillSeaPageLayout> _pages = new();
    BillSeaDesignElement? _activeItem;
    BillSeaDesignElement? _selectedElement;
    ElementInteraction _interaction = ElementInteraction.None;
    double _dragPointerStartClientX;
    double _dragPointerStartClientY;
    double _dragAnchorStartLeft;
    double _dragAnchorStartTop;
    int _designCounter;
    BillSeaElementKind? _pendingPlacementKind;
    bool _placementPreviewVisible;
    double _placementPreviewLeft;
    double _placementPreviewTop;
    bool _interactionUndoPushed;
    string? _propertyEditUndoElementName;
    readonly Stack<List<BillSeaPageLayout>> _undoStack = new();
    readonly HashSet<string> _sessionAddedNames = new(StringComparer.OrdinalIgnoreCase);
    readonly HashSet<string> _selectedNames = new(StringComparer.OrdinalIgnoreCase);
    readonly Dictionary<string, (double Left, double Top)> _dragGroupStarts = new(StringComparer.OrdinalIgnoreCase);

    const int MaxUndoSteps = 50;

    static readonly BoxResizeHandle[] BoxResizeHandles =
    {
        BoxResizeHandle.NorthWest,
        BoxResizeHandle.North,
        BoxResizeHandle.NorthEast,
        BoxResizeHandle.West,
        BoxResizeHandle.East,
        BoxResizeHandle.SouthWest,
        BoxResizeHandle.South,
        BoxResizeHandle.SouthEast
    };

    enum ElementInteraction
    {
        None,
        Move,
        LineResizeStart,
        LineResizeEnd,
        BoxResizeNorthWest,
        BoxResizeNorth,
        BoxResizeNorthEast,
        BoxResizeWest,
        BoxResizeEast,
        BoxResizeSouthWest,
        BoxResizeSouth,
        BoxResizeSouthEast
    }

    enum BoxResizeHandle
    {
        NorthWest,
        North,
        NorthEast,
        West,
        East,
        SouthWest,
        South,
        SouthEast
    }

    const double MinBoxSizeInches = 0.15;

    BillSeaPageLayout? CurrentPage =>
        _pages.FirstOrDefault(p => string.Equals(p.PageName, _selectedPageName, StringComparison.OrdinalIgnoreCase))
        ?? _pages.FirstOrDefault();

    double PageWidthInches => CurrentPage?.PageWidthInches ?? 8.27;
    double PageHeightInches => CurrentPage?.PageHeightInches ?? 11.69;
    double Scale => PreviewWidthPx / PageWidthInches;
    double PreviewHeightPx => PageHeightInches * Scale;

    IEnumerable<BillSeaDesignElement> FilteredElements
    {
        get
        {
            var items = CurrentPage?.Elements ?? Enumerable.Empty<BillSeaDesignElement>();
            return string.IsNullOrWhiteSpace(_keyword)
                ? items
                : items.Where(x => x.Name.Contains(_keyword, StringComparison.OrdinalIgnoreCase)
                    || x.Text.Contains(_keyword, StringComparison.OrdinalIgnoreCase));
        }
    }

    IEnumerable<BillSeaDesignElement> SortedElements =>
        FilteredElements.OrderBy(GetElementZIndex);

    protected override void OnParametersSet() => _logoDataUrl = BuildLogoDataUrl(FormBillSeaLogo);

    static string? BuildLogoDataUrl(byte[]? logo)
    {
        if (logo is not { Length: > 0 })
            return null;

        return $"data:image/png;base64,{Convert.ToBase64String(logo)}";
    }

    async Task LoadLayout()
    {
        try
        {
            _loading = true;
            if (!BillSeaReportTemplateNames.IsSupported(ReportFileName))
            {
                ShowMessage($"Report {ReportFileName} chưa được hỗ trợ lưu theo công ty.", MudBlazor.Severity.Error);
                return;
            }

            var doc = await TemplateService.LoadTemplateDocumentAsync(ReportFileName);
            var templateInfo = await TemplateService.GetTemplateInfoAsync(ReportFileName);
            _usesCustomTemplate = templateInfo.UsesCustomTemplate;

            _pages = BillSeaLayoutMrtHelper.LoadPages(doc);
            _selectedPageName = _pages.FirstOrDefault()?.PageName ?? string.Empty;
            _selectedNames.Clear();
            var firstElement = CurrentPage?.Elements.FirstOrDefault();
            if (firstElement is not null)
            {
                _selectedNames.Add(firstElement.Name);
                _selectedElement = firstElement;
            }
            else
            {
                _selectedElement = null;
            }
            _designCounter = _pages.SelectMany(p => p.Elements).Count();
            _undoStack.Clear();
            _sessionAddedNames.Clear();
            CancelPlacement();

            var totalItems = _pages.Sum(p => p.Elements.Count);
            var source = _usesCustomTemplate ? "bản tùy chỉnh công ty" : "template mặc định";
            ShowMessage($"Đã tải {totalItems} phần tử từ {source}.", MudBlazor.Severity.Success);
        }
        catch (Exception ex)
        {
            ShowMessage($"Không tải được layout: {ex.Message}", MudBlazor.Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    async Task SaveLayout()
    {
        try
        {
            if (!await ssv.CheckPermission(UserName, "Edit", "Companyinformation"))
            {
                ShowMessage("You have not access to edit", MudBlazor.Severity.Warning);
                return;
            }

            _loading = true;
            if (!BillSeaReportTemplateNames.IsSupported(ReportFileName))
            {
                ShowMessage($"Report {ReportFileName} chưa được hỗ trợ lưu theo công ty.", MudBlazor.Severity.Error);
                return;
            }

            if (!_pages.Any())
            {
                ShowMessage("Chưa có dữ liệu để lưu.", MudBlazor.Severity.Warning);
                return;
            }

            var doc = await TemplateService.LoadTemplateDocumentAsync(ReportFileName);
            var updated = BillSeaLayoutMrtHelper.SavePages(doc, _pages);
            await TemplateService.SaveTemplateDocumentAsync(ReportFileName, doc);
            _usesCustomTemplate = true;
            ShowMessage($"Đã lưu {updated} thay đổi vào layout riêng của công ty ({ReportFileName}).", MudBlazor.Severity.Success);
        }
        catch (Exception ex)
        {
            ShowMessage($"Không lưu được layout: {ex.Message}", MudBlazor.Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    async Task ResetToDefaultTemplate()
    {
        try
        {
            if (!await ssv.CheckPermission(UserName, "Edit", "Companyinformation"))
            {
                ShowMessage("You have not access to edit", MudBlazor.Severity.Warning);
                return;
            }

            var confirmed = await DialogService.ShowMessageBox(
                "Khôi phục mặc định",
                $"Bạn có chắc muốn khôi phục {ReportFileName} về template gốc trong wwwroot/Reports?\n\nBản layout riêng của công ty trong database sẽ bị xóa.",
                yesText: "Khôi phục",
                cancelText: "Hủy");

            if (confirmed != true)
                return;

            _loading = true;
            await TemplateService.ResetToDefaultAsync(ReportFileName);
            _usesCustomTemplate = false;
            await LoadLayout();
            ShowMessage($"Đã khôi phục {ReportFileName} về template mặc định.", MudBlazor.Severity.Info);
        }
        catch (Exception ex)
        {
            ShowMessage($"Không khôi phục được template: {ex.Message}", MudBlazor.Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    void BeginPlacement(BillSeaElementKind kind)
    {
        if (CurrentPage is null)
            return;

        if (_pendingPlacementKind == kind)
        {
            CancelPlacement();
            return;
        }

        EndInteraction();
        _pendingPlacementKind = kind;
        _placementPreviewVisible = false;
    }

    void CancelPlacement()
    {
        _pendingPlacementKind = null;
        _placementPreviewVisible = false;
    }

    void OnCanvasKeyDown(KeyboardEventArgs e)
    {
        if (e.Key is "Escape" or "Esc")
            CancelPlacement();
    }

    string GetPlacementLabel() => _pendingPlacementKind switch
    {
        BillSeaElementKind.HorizontalLine => "line ngang",
        BillSeaElementKind.VerticalLine => "line dọc",
        BillSeaElementKind.StaticText => "label text",
        _ => "phần tử mới"
    };

    void OnPlacementMouseMove(MouseEventArgs e)
    {
        if (_pendingPlacementKind is null)
            return;

        UpdatePlacementPreview(e.OffsetX, e.OffsetY);
    }

    void OnPlacementMouseLeave()
    {
        _placementPreviewVisible = false;
    }

    void UpdatePlacementPreview(double offsetX, double offsetY)
    {
        if (_pendingPlacementKind is null)
            return;

        var (width, height) = GetDefaultSize(_pendingPlacementKind.Value);
        _placementPreviewLeft = Math.Clamp(offsetX / Scale, 0, Math.Max(0, PageWidthInches - width));
        _placementPreviewTop = Math.Clamp(offsetY / Scale, 0, Math.Max(0, PageHeightInches - height));
        _placementPreviewVisible = true;
    }

    void OnPlacementClick(MouseEventArgs e)
    {
        if (_pendingPlacementKind is null || CurrentPage is null)
            return;

        var kind = _pendingPlacementKind.Value;
        UpdatePlacementPreview(e.OffsetX, e.OffsetY);
        _pendingPlacementKind = null;
        _placementPreviewVisible = false;

        var (width, height) = GetDefaultSize(kind);
        var left = _placementPreviewLeft;
        var top = _placementPreviewTop;

        var element = kind switch
        {
            BillSeaElementKind.HorizontalLine => new BillSeaDesignElement
            {
                Name = NextName("HLine"),
                Kind = BillSeaElementKind.HorizontalLine,
                Left = left,
                Top = top,
                Width = width,
                Height = height,
                LineSize = 1
            },
            BillSeaElementKind.VerticalLine => new BillSeaDesignElement
            {
                Name = NextName("VLine"),
                Kind = BillSeaElementKind.VerticalLine,
                Left = left,
                Top = top,
                Width = width,
                Height = height,
                LineSize = 1
            },
            BillSeaElementKind.StaticText => new BillSeaDesignElement
            {
                Name = NextName("Label"),
                Kind = BillSeaElementKind.StaticText,
                Left = left,
                Top = top,
                Width = width,
                Height = height,
                Text = "Label mới"
            },
            _ => null
        };

        if (element is null)
            return;

        AddElement(element);
    }

    static (double Width, double Height) GetDefaultSize(BillSeaElementKind kind) => kind switch
    {
        BillSeaElementKind.HorizontalLine => (2.5, 0.01),
        BillSeaElementKind.VerticalLine => (0.01, 2),
        BillSeaElementKind.StaticText => (1.5, 0.2),
        _ => (1, 1)
    };

    void AddElement(BillSeaDesignElement element)
    {
        if (CurrentPage is null)
            return;

        PushUndo();
        CurrentPage.Elements.Add(element);
        _sessionAddedNames.Add(element.Name);
        SetSingleSelection(element);
    }

    bool HasDeletableSelection() =>
        GetSelectedElements().Any(x => x.Kind is not (BillSeaElementKind.DataText or BillSeaElementKind.Image));

    List<BillSeaDesignElement> GetSelectedElements()
    {
        if (CurrentPage is null)
            return new List<BillSeaDesignElement>();

        return CurrentPage.Elements
            .Where(x => _selectedNames.Contains(x.Name))
            .ToList();
    }

    bool IsSelected(BillSeaDesignElement item) => _selectedNames.Contains(item.Name);

    void SetSingleSelection(BillSeaDesignElement item)
    {
        _selectedNames.Clear();
        _selectedNames.Add(item.Name);
        _selectedElement = item;
        _propertyEditUndoElementName = null;
    }

    void ToggleSelection(BillSeaDesignElement item)
    {
        if (_selectedNames.Contains(item.Name))
            _selectedNames.Remove(item.Name);
        else
            _selectedNames.Add(item.Name);

        _selectedElement = GetSelectedElements().FirstOrDefault();
        _propertyEditUndoElementName = null;
    }

    void DeleteSelected()
    {
        if (CurrentPage is null || !HasDeletableSelection())
            return;

        PushUndo();
        var namesToDelete = GetSelectedElements()
            .Where(x => x.Kind is not (BillSeaElementKind.DataText or BillSeaElementKind.Image))
            .Select(x => x.Name)
            .ToHashSet(StringComparer.OrdinalIgnoreCase);

        CurrentPage.Elements.RemoveAll(x => namesToDelete.Contains(x.Name));
        foreach (var name in namesToDelete)
            _sessionAddedNames.Remove(name);

        _selectedNames.RemoveWhere(name => namesToDelete.Contains(name));
        _selectedElement = GetSelectedElements().FirstOrDefault()
            ?? CurrentPage.Elements.FirstOrDefault();
        if (_selectedElement is not null && !IsSelected(_selectedElement))
            _selectedNames.Add(_selectedElement.Name);
    }

    void UndoLastChange()
    {
        if (_undoStack.Count == 0)
            return;

        var selectedNames = _selectedNames.ToList();
        var pageName = _selectedPageName;
        _pages = BillSeaLayoutClone.ClonePages(_undoStack.Pop());
        _selectedPageName = _pages.Any(p => string.Equals(p.PageName, pageName, StringComparison.OrdinalIgnoreCase))
            ? pageName
            : _pages.FirstOrDefault()?.PageName ?? string.Empty;

        _selectedNames.Clear();
        foreach (var name in selectedNames)
        {
            if (CurrentPage?.Elements.Any(x => string.Equals(x.Name, name, StringComparison.OrdinalIgnoreCase)) == true)
                _selectedNames.Add(name);
        }

        _selectedElement = GetSelectedElements().FirstOrDefault()
            ?? CurrentPage?.Elements.FirstOrDefault();
        if (_selectedElement is not null && _selectedNames.Count == 0)
            _selectedNames.Add(_selectedElement.Name);
        _activeItem = null;
        _interaction = ElementInteraction.None;
        ShowMessage("Đã hoàn tác thay đổi.", MudBlazor.Severity.Info);
    }

    void PushUndo()
    {
        if (_undoStack.Count >= MaxUndoSteps)
        {
            var items = new List<List<BillSeaPageLayout>>(_undoStack);
            items.RemoveAt(items.Count - 1);
            _undoStack.Clear();
            foreach (var item in items.AsEnumerable().Reverse())
                _undoStack.Push(item);
        }

        _undoStack.Push(BillSeaLayoutClone.ClonePages(_pages));
    }

    string NextName(string prefix)
    {
        _designCounter++;
        return $"{prefix}{_designCounter}";
    }

    void OnElementMouseDown(BillSeaDesignElement item, MouseEventArgs e)
    {
        if (e.CtrlKey)
        {
            ToggleSelection(item);
            return;
        }

        if (!IsSelected(item))
            SetSingleSelection(item);

        BeginMove(item, e);
    }

    void BeginMove(BillSeaDesignElement item, MouseEventArgs e)
    {
        BeginInteractionUndo();
        _activeItem = item;
        _selectedElement = item;
        _interaction = ElementInteraction.Move;
        _dragPointerStartClientX = e.ClientX;
        _dragPointerStartClientY = e.ClientY;
        _dragAnchorStartLeft = item.Left;
        _dragAnchorStartTop = item.Top;

        _dragGroupStarts.Clear();
        foreach (var selected in GetSelectedElements())
            _dragGroupStarts[selected.Name] = (selected.Left, selected.Top);
    }

    void EnsurePropertyEditUndo()
    {
        if (_selectedElement is null)
            return;

        if (string.Equals(_propertyEditUndoElementName, _selectedElement.Name, StringComparison.OrdinalIgnoreCase))
            return;

        PushUndo();
        _propertyEditUndoElementName = _selectedElement.Name;
    }

    void OnSelectedLineSizeChanged(double value)
    {
        if (_selectedElement is null)
            return;

        EnsurePropertyEditUndo();
        _selectedElement.LineSize = Math.Clamp(value, 1, 20);
    }

    bool HasSelectedTextElements() => GetSelectedTextElements().Count > 0;

    List<BillSeaDesignElement> GetSelectedTextElements() =>
        GetSelectedElements()
            .Where(x => x.Kind is BillSeaElementKind.StaticText or BillSeaElementKind.DataText)
            .ToList();

    double GetFontSizeEditorValue() =>
        GetSelectedTextElements().FirstOrDefault()?.FontSize ?? 8;

    void OnSelectedFontSizeChanged(double value)
    {
        var texts = GetSelectedTextElements();
        if (texts.Count == 0)
            return;

        EnsurePropertyEditUndo();
        var fontSize = Math.Clamp(value, 4, 72);
        foreach (var text in texts)
            text.FontSize = fontSize;
    }

    string GetTextPreviewStyle(BillSeaDesignElement item)
    {
        var fontSizePx = (item.FontSize / 72d * Scale).ToString("0.##", CultureInfo.InvariantCulture);
        var fontWeight = item.FontBold ? "bold" : "normal";
        var fontFamily = string.IsNullOrWhiteSpace(item.FontFamily) ? "Times New Roman" : item.FontFamily;
        return $"font-family:{fontFamily};font-size:{fontSizePx}px;font-weight:{fontWeight};line-height:1.1;overflow:hidden;pointer-events:none;";
    }

    void OnSelectedTextChanged(string value)
    {
        if (_selectedElement is null)
            return;

        EnsurePropertyEditUndo();
        _selectedElement.Text = value;
    }

    int GetElementZIndex(BillSeaDesignElement item)
    {
        if (_sessionAddedNames.Contains(item.Name))
            return 200;

        return item.Kind switch
        {
            BillSeaElementKind.Image => 35,
            BillSeaElementKind.DataText => 30,
            BillSeaElementKind.StaticText => 25,
            _ => 20
        };
    }

    string GetCanvasStyle()
    {
        var cursor = _pendingPlacementKind is not null ? "cursor:crosshair;" : string.Empty;
        return "position:relative;" + cursor +
               $"width:{PreviewWidthPx.ToString("0.##", CultureInfo.InvariantCulture)}px;" +
               $"height:{PreviewHeightPx.ToString("0.##", CultureInfo.InvariantCulture)}px;" +
               "max-width:100%;border:1px solid #bdbdbd;overflow:hidden;user-select:none;" +
               "background-color:#fff;" +
               "background-image:linear-gradient(to right,#f3f3f3 1px,transparent 1px),linear-gradient(to bottom,#f3f3f3 1px,transparent 1px);" +
               $"background-size:{(Scale / 4).ToString("0.##", CultureInfo.InvariantCulture)}px {(Scale / 4).ToString("0.##", CultureInfo.InvariantCulture)}px;";
    }

    string GetPlacementOverlayStyle() =>
        "position:absolute;inset:0;z-index:9999;cursor:crosshair !important;background:transparent;";

    string GetPlacementPreviewStyle()
    {
        if (_pendingPlacementKind is null)
            return "display:none;";

        var (width, height) = GetDefaultSize(_pendingPlacementKind.Value);
        var leftPx = (_placementPreviewLeft * Scale).ToString("0.##", CultureInfo.InvariantCulture);
        var topPx = (_placementPreviewTop * Scale).ToString("0.##", CultureInfo.InvariantCulture);

        return _pendingPlacementKind.Value switch
        {
            BillSeaElementKind.HorizontalLine =>
                $"position:absolute;z-index:9998;pointer-events:none;left:{leftPx}px;" +
                $"top:{((_placementPreviewTop * Scale) - 6).ToString("0.##", CultureInfo.InvariantCulture)}px;" +
                $"width:{Math.Max(4, width * Scale).ToString("0.##", CultureInfo.InvariantCulture)}px;height:12px;" +
                "border-top:2px dashed #1976d2;opacity:0.85;",
            BillSeaElementKind.VerticalLine =>
                $"position:absolute;z-index:9998;pointer-events:none;left:{((_placementPreviewLeft * Scale) - 6).ToString("0.##", CultureInfo.InvariantCulture)}px;" +
                $"top:{topPx}px;width:12px;" +
                $"height:{Math.Max(4, height * Scale).ToString("0.##", CultureInfo.InvariantCulture)}px;" +
                "border-left:2px dashed #1976d2;opacity:0.85;",
            _ =>
                $"position:absolute;z-index:9998;pointer-events:none;left:{leftPx}px;top:{topPx}px;" +
                $"width:{Math.Max(16, width * Scale).ToString("0.##", CultureInfo.InvariantCulture)}px;" +
                $"height:{Math.Max(16, height * Scale).ToString("0.##", CultureInfo.InvariantCulture)}px;" +
                "border:2px dashed #1976d2;background:rgba(25,118,210,0.12);opacity:0.9;"
        };
    }

    string GetElementsLayerStyle() =>
        _activeItem is not null || _pendingPlacementKind is not null
            ? "position:absolute;inset:0;pointer-events:none;"
            : "position:absolute;inset:0;";

    string GetLineContainerStyle(BillSeaDesignElement item)
    {
        var hitPadding = 6;
        var thicknessPx = GetLineThicknessPx(item);

        if (item.Kind == BillSeaElementKind.HorizontalLine)
        {
            var containerHeight = Math.Max(12, thicknessPx + hitPadding * 2);
            return "position:absolute;" +
                   $"left:{(item.Left * Scale).ToString("0.##", CultureInfo.InvariantCulture)}px;" +
                   $"top:{((item.Top * Scale) - (containerHeight / 2)).ToString("0.##", CultureInfo.InvariantCulture)}px;" +
                   $"width:{Math.Max(4, item.Width * Scale).ToString("0.##", CultureInfo.InvariantCulture)}px;" +
                   $"height:{containerHeight.ToString("0.##", CultureInfo.InvariantCulture)}px;" +
                   $"z-index:{GetElementZIndex(item)};cursor:grab;";
        }

        var containerWidth = Math.Max(12, thicknessPx + hitPadding * 2);
        return "position:absolute;" +
               $"left:{((item.Left * Scale) - (containerWidth / 2)).ToString("0.##", CultureInfo.InvariantCulture)}px;" +
               $"top:{(item.Top * Scale).ToString("0.##", CultureInfo.InvariantCulture)}px;" +
               $"width:{containerWidth.ToString("0.##", CultureInfo.InvariantCulture)}px;" +
               $"height:{Math.Max(4, item.Height * Scale).ToString("0.##", CultureInfo.InvariantCulture)}px;" +
               $"z-index:{GetElementZIndex(item)};cursor:grab;";
    }

    static double GetLineThicknessPx(BillSeaDesignElement item) =>
        Math.Clamp(item.LineSize, 1, 20);

    string GetLineVisualStyle(BillSeaDesignElement item)
    {
        var selected = IsSelected(item);
        var color = selected ? "#1976d2" : "#111";
        var thicknessPx = GetLineThicknessPx(item).ToString("0.##", CultureInfo.InvariantCulture);

        if (item.Kind == BillSeaElementKind.HorizontalLine)
        {
            return "position:absolute;left:0;right:0;top:50%;height:0;" +
                   $"border-top:{thicknessPx}px solid {color};transform:translateY(-50%);pointer-events:none;";
        }

        return "position:absolute;top:0;bottom:0;left:50%;width:0;" +
               $"border-left:{thicknessPx}px solid {color};transform:translateX(-50%);pointer-events:none;";
    }

    string GetLineHandleStyle(BillSeaDesignElement item, bool isStart)
    {
        const string baseStyle = "position:absolute;width:10px;height:10px;border-radius:50%;background:#1976d2;border:1px solid #fff;z-index:12;";

        if (item.Kind == BillSeaElementKind.HorizontalLine)
        {
            var left = isStart ? "-5px" : "calc(100% - 5px)";
            return baseStyle + $"left:{left};top:1px;cursor:ew-resize;";
        }

        var top = isStart ? "-5px" : "calc(100% - 5px)";
        return baseStyle + $"top:{top};left:1px;cursor:ns-resize;";
    }

    string GetOverlayCursor() => _interaction switch
    {
        ElementInteraction.LineResizeStart or ElementInteraction.LineResizeEnd
            when _activeItem?.Kind == BillSeaElementKind.HorizontalLine => "ew-resize",
        ElementInteraction.LineResizeStart or ElementInteraction.LineResizeEnd
            when _activeItem?.Kind == BillSeaElementKind.VerticalLine => "ns-resize",
        ElementInteraction.BoxResizeNorthWest or ElementInteraction.BoxResizeSouthEast => "nwse-resize",
        ElementInteraction.BoxResizeNorthEast or ElementInteraction.BoxResizeSouthWest => "nesw-resize",
        ElementInteraction.BoxResizeNorth or ElementInteraction.BoxResizeSouth => "ns-resize",
        ElementInteraction.BoxResizeWest or ElementInteraction.BoxResizeEast => "ew-resize",
        _ => "grabbing"
    };

    string GetBoxHandleStyle(BoxResizeHandle handle)
    {
        const string baseStyle = "position:absolute;width:8px;height:8px;border-radius:2px;background:#1976d2;border:1px solid #fff;z-index:15;";

        return handle switch
        {
            BoxResizeHandle.NorthWest => baseStyle + "top:-4px;left:-4px;cursor:nwse-resize;",
            BoxResizeHandle.North => baseStyle + "top:-4px;left:calc(50% - 4px);cursor:ns-resize;",
            BoxResizeHandle.NorthEast => baseStyle + "top:-4px;right:-4px;cursor:nesw-resize;",
            BoxResizeHandle.West => baseStyle + "top:calc(50% - 4px);left:-4px;cursor:ew-resize;",
            BoxResizeHandle.East => baseStyle + "top:calc(50% - 4px);right:-4px;cursor:ew-resize;",
            BoxResizeHandle.SouthWest => baseStyle + "bottom:-4px;left:-4px;cursor:nesw-resize;",
            BoxResizeHandle.South => baseStyle + "bottom:-4px;left:calc(50% - 4px);cursor:ns-resize;",
            _ => baseStyle + "bottom:-4px;right:-4px;cursor:nwse-resize;"
        };
    }

