               $"width:{Math.Max(24, item.Width * Scale).ToString("0.##", CultureInfo.InvariantCulture)}px;" +
               $"height:{Math.Max(24, item.Height * Scale).ToString("0.##", CultureInfo.InvariantCulture)}px;" +
               $"border:1px dashed {borderColor};" +
               $"background:{backgroundColor};" +
               $"z-index:{GetElementZIndex(item)};cursor:grab;display:flex;align-items:center;justify-content:center;padding:1px;overflow:hidden;";
