<PageTitle>@Localizer["CompanyInfomation"] </PageTitle>
<MudText Class="pa-2" Typo="Typo.h6">@Localizer["CompanyInfomation"]</MudText>

<MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-4">
    <MudTabPanel Text="Company Information">
        <MudStack Row Justify="Justify.FlexStart" Class="pa-4">
            <MudButton HtmlTag="label"
                       OnClick="RefreshCompanyInfo"
                       Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled"
                       StartIcon="@Icons.Material.Filled.Refresh">
                @Localizer["reload"]
            </MudButton>
        </MudStack>

        <MudDataGrid T="M_CompanyInfo" Items="@Listdata" Filterable="true" @ref="mudTable" Class="pa-4" Bordered="true" 
             FilterMode="@DataGridFilterMode.ColumnFilterRow" Dense="true" Virtualize="true" QuickFilter="@FilterFunc1"
             FixedHeader="true" FixedFooter="true" HeaderClass="no-wrap" FooterClass="no-wrap"
             ReadOnly="false" RowClassFunc="@SelectedRowClassFunc" CommittedItemChanges="@CommittedItem"
             RowClick="@RowClicked" EditDialogOptions="@options"
             ColumnResizeMode="@(_resizeColumn ? ResizeMode.Column : ResizeMode.Container)" Loading="_loading">
    <Columns>
        <HierarchyColumn T="M_CompanyInfo"></HierarchyColumn>
        <TemplateColumn CellClass="d-flex justify-end" Filterable="false" Sortable="false">
            <CellTemplate>
                <MudIconButton Size="@Size.Small"
                               Icon="@Icons.Material.Outlined.Edit"
                               OnClick="@(async () =>
                                {
                                    if (!await ssv.CheckPermission(usr, "Edit", "Companyinformation"))
                                    {
                                        CallSnackBar("You have not access to view", MudBlazor.Severity.Warning);
                                        return;
                                    }

                                    await context.Actions.StartEditingItemAsync();
                                })" />
            </CellTemplate>
        </TemplateColumn>



        <PropertyColumn Property="x => x.NameTiengViet" Title="@Localizer["NameTiengViet"]" IsEditable="false" Required="false">
            <EditTemplate>
                <MudTextField @bind-Value="context.Item.NameTiengViet" Label="@Localizer["NameTiengViet"]" Required />
            </EditTemplate>
        </PropertyColumn>

        <PropertyColumn Property="x => x.AddressTiengViet" Title="@Localizer["AddressTiengViet"]" IsEditable="false" Required="false">
            <EditTemplate>
                <MudTextField @bind-Value="context.Item.AddressTiengViet" Label="@Localizer["AddressTiengViet"]" Required />
            </EditTemplate>
        </PropertyColumn>

        <PropertyColumn Property="x => x.Name" Title="@Localizer["Name"]" IsEditable="false" Required="false">
            <EditTemplate>
                <MudTextField @bind-Value="context.Item.Name" Label="@Localizer["Name"]" Required />
            </EditTemplate>
        </PropertyColumn>

        <PropertyColumn Property="x => x.Address" Title="@Localizer["Address"]" IsEditable="false" Required="false">
            <EditTemplate>
                <MudTextField @bind-Value="context.Item.Address" Label="@Localizer["Address"]" Required />
            </EditTemplate>
        </PropertyColumn>

        <PropertyColumn Property="x => x.Tel" Title="@Localizer["Tel"]" IsEditable="false" Required="false">
            <EditTemplate>
                <MudTextField @bind-Value="context.Item.Tel" Label="@Localizer["Tel"]" Required />
            </EditTemplate>
        </PropertyColumn>

        <PropertyColumn Property="x => x.Email" Title="@Localizer["Email"]" IsEditable="false" Required="false">
            <EditTemplate>
                <MudTextField @bind-Value="context.Item.Email" Label="@Localizer["Email"]" Required />
            </EditTemplate>
        </PropertyColumn>

        <PropertyColumn Property="x => x.Website" Title="@Localizer["Website"]" IsEditable="false" Required="false">
            <EditTemplate>
                <MudTextField @bind-Value="context.Item.Website" Label="@Localizer["Website"]" Required />
            </EditTemplate>
        </PropertyColumn>

        <PropertyColumn Property="x => x.SwiftCode" Title="@Localizer["SwiftCode"]" IsEditable="false" Required="false">
            <EditTemplate>
                <MudTextField @bind-Value="context.Item.SwiftCode" Label="@Localizer["SwiftCode"]" Required />
            </EditTemplate>
        </PropertyColumn>

        <PropertyColumn Property="x => x.AddDebit" Title="@Localizer["AddDebit"]" IsEditable="false" Required="false">
            <EditTemplate>
                <MudTextField @bind-Value="context.Item.AddDebit" Label="@Localizer["AddDebit"]" Required />
            </EditTemplate>
        </PropertyColumn>

        <PropertyColumn Property="x => x.Accno1Debit" Title="@Localizer["Accno1Debit"]" IsEditable="false" Required="false">
            <EditTemplate>
                <MudTextField @bind-Value="context.Item.Accno1Debit" Label="@Localizer["Accno1Debit"]" Required />
            </EditTemplate>
        </PropertyColumn>

        <PropertyColumn Property="x => x.Accno2Debit" Title="@Localizer["Accno2Debit"]" IsEditable="false" Required="false">
            <EditTemplate>
                <MudTextField @bind-Value="context.Item.Accno2Debit" Label="@Localizer["Accno2Debit"]" Required />
            </EditTemplate>
        </PropertyColumn>

        <PropertyColumn Property="x => x.TaxCode" Title="@Localizer["TaxCode"]" IsEditable="false" Required="false">
