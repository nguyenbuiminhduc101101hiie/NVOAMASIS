
@using System.Globalization
@attribute [Authorize]
@using System.Text.Json
@using Microsoft.AspNetCore.Components.Forms
@inject GlobalServices gsv
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject AccountService asv
@inject SharedServices ssv
@inject BookingService bksv
@inject IJSRuntime JSRuntime
@inject SupportServices supsv
@inject IStringLocalizer<SharedResource> Localizer
@inject LocalChargesServices lcsv
@inject Bieugianangha_Services Bgnhsv
@inject CustomerService Cussv
@inject DNTUServices DNTUSV
@inject ProductPriceServices prsv;
@inject HistoryLogService HistoryLogService

<PageTitle>@Localizer["CompanyInfomation"] </PageTitle>
<MudText Class="pa-2" Typo="Typo.h6">@Localizer["CompanyInfomation"]</MudText>

<MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-4">
    <MudTabPanel Text="@Localizer["CompanyInformation_Tab"]">
        <MudStack Row Justify="Justify.FlexStart" Spacing="2" Class="pa-4">
            <MudButton OnClick="RefreshCompanyInfo"
                       Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled"
                       StartIcon="@Icons.Material.Filled.Refresh" Disabled="_loading">
                @Localizer["reload"]
            </MudButton>
            <MudButton OnClick="SaveCompanyInfo"
                       Size="Size.Small" Color="Color.Success" Variant="Variant.Filled"
                       StartIcon="@Icons.Material.Filled.Save" Disabled="_loading">
                @Localizer["save"]
            </MudButton>
        </MudStack>

        @if (_loading)
        {
            <MudProgressLinear Indeterminate="true" Class="mx-4" />
        }

        <MudPaper Class="pa-4 mx-4 mb-4" Outlined="true">
            <MudText Typo="Typo.subtitle1" Class="mb-3">@Localizer["CompanyLogo"]</MudText>
            <MudStack Row Spacing="3" AlignItems="AlignItems.Center">
                @{
                    var logoSrc = GetLogoDataUrl(company.Logo);
                }
                @if (logoSrc != null)
                {
                    <MudImage Src="@logoSrc" Alt="Logo" Style="max-height:100px; max-width:240px;" ObjectFit="ObjectFit.Contain" />
                }
                else
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary">@Localizer["NoLogoYet"]</MudText>
                }
                <MudStack Spacing="1">
                    <MudFileUpload T="IBrowserFile" Accept=".png,.jpg,.jpeg,.gif,.webp" FilesChanged="OnLogoFileChanged">
                        <ButtonTemplate Context="btnCtx">
                            <MudButton HtmlTag="label" for="@btnCtx" Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.Upload">
                                @Localizer["ChooseLogo"]
                            </MudButton>
                        </ButtonTemplate>
                    </MudFileUpload>
                    @if (company.Logo is { Length: > 0 })
                    {
                        <MudButton Variant="Variant.Text" Color="Color.Error" Size="Size.Small" OnClick="@(() => company.Logo = null)">
                            @Localizer["RemoveLogo"]
                        </MudButton>
                    }
                </MudStack>
            </MudStack>
        </MudPaper>

        <MudForm Model="company" Class="pa-4">
            <MudGrid Spacing="3">
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="company.NameTiengViet" Label="@Localizer["NameTiengViet"]" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="company.AddressTiengViet" Label="@Localizer["AddressTiengViet"]" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="company.Name" Label="@Localizer["Name"]" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="company.Address" Label="@Localizer["Address"]" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="company.Tel" Label="@Localizer["Tel"]" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="company.Email" Label="@Localizer["Email"]" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="company.Website" Label="@Localizer["Website"]" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="company.SwiftCode" Label="@Localizer["SwiftCode"]" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="company.AddDebit" Label="@Localizer["AddDebit"]" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="company.Accno1Debit" Label="@Localizer["Accno1Debit"]" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="company.Accno2Debit" Label="@Localizer["Accno2Debit"]" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="company.TaxCode" Label="@Localizer["TaxCode"]" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="company.IPAddress" Label="@Localizer["IP Address"]" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudNumericField @bind-Value="company.hanmovecus" Label="@Localizer["Hạn Move Cus"]" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="company.Email_GuiTB" Label="@Localizer["NotificationEmail"]" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="company.PasswordEmail_GuiTB" Label="@Localizer["NotificationEmailPassword"]" InputType="InputType.Password" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="company.SmtpServer" Label="@Localizer["SmtpServer"]" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudNumericField @bind-Value="company.SmtpPort" Label="@Localizer["SmtpPort"]" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="company.ListEmail_nhanTB_Approve_Thu_Chi"
                                  Label="@Localizer["ApprovalEmailList"]"
                                  HelperText="@Localizer["EmailListHelper"]"
                                  Lines="2" />
                </MudItem>
            </MudGrid>
        </MudForm>
    </MudTabPanel>

    <MudTabPanel Text="@Localizer["PrefixTab"]">
        <MudStack Row Justify="Justify.FlexStart" Class="pa-4">
            <MudButton OnClick="RefreshTiepDauNgu"
                       Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled"
                       StartIcon="@Icons.Material.Filled.Refresh">
                @Localizer["reload"]
            </MudButton>
            <MudButton OnClick="AddNewTiepDauNgu"
                       Size="Size.Small" Color="Color.Success" Variant="Variant.Filled"
                       StartIcon="@Icons.Material.Filled.Add">
                @Localizer["add"]
            </MudButton>
        </MudStack>

        <MudDataGrid T="M_TiepDauNgu" Items="@ListTiepDauNgu" Filterable="true" @ref="mudTableTDN" Class="pa-4" Bordered="true"
                     FilterMode="@DataGridFilterMode.ColumnFilterRow" Dense="true" Virtualize="true"
                     FixedHeader="true" FixedFooter="true" HeaderClass="no-wrap" FooterClass="no-wrap"
                     ReadOnly="false" CommittedItemChanges="@CommittedTiepDauNgu"
                     EditDialogOptions="@options" Loading="_loadingTDN">
            <Columns>
                <TemplateColumn CellClass="d-flex justify-end" Filterable="false" Sortable="false">
                    <CellTemplate>
                        <MudIconButton Size="@Size.Small"
                                       Icon="@Icons.Material.Outlined.Edit"
                                       OnClick="@(async () => await context.Actions.StartEditingItemAsync())" />
                        <MudIconButton Size="@Size.Small"
                                       Icon="@Icons.Material.Outlined.Delete"
                                       Color="Color.Error"
                                       OnClick="@(async () => await DeleteTiepDauNgu(context.Item))" />
                    </CellTemplate>
                </TemplateColumn>

                <PropertyColumn Property="x => x.Loai" Title="@Localizer["Type"]" IsEditable="false" Required="false">
                    <EditTemplate>
                        <MudTextField @bind-Value="context.Item.Loai" Label="@Localizer["Type"]" Required />
                    </EditTemplate>
                </PropertyColumn>

                <PropertyColumn Property="x => x.Hangso" Title="@Localizer["Prefix"]" IsEditable="false" Required="false">
                    <EditTemplate>
                        <MudTextField @bind-Value="context.Item.Hangso" Label="@Localizer["Prefix"]" Required />
                    </EditTemplate>
                </PropertyColumn>

                <PropertyColumn Property="x => x.POL" Title="POL" IsEditable="false" Required="false">
                    <EditTemplate>
                        <MudTextField @bind-Value="context.Item.POL" Label="POL" />
                    </EditTemplate>
                </PropertyColumn>

                <PropertyColumn Property="x => x.POD" Title="POD" IsEditable="false" Required="false">
                    <EditTemplate>
                        <MudTextField @bind-Value="context.Item.POD" Label="POD" />
                    </EditTemplate>
                </PropertyColumn>
            </Columns>
        </MudDataGrid>
    </MudTabPanel>

    <MudTabPanel Text="@Localizer["CompanyOther_Tab"]">
        <MudStack Row Justify="Justify.FlexStart" Class="pa-4">
            <MudButton OnClick="RefreshCompanyOther"
                       Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled"
                       StartIcon="@Icons.Material.Filled.Refresh">
                @Localizer["reload"]
            </MudButton>
            <MudButton OnClick="AddNewCompanyOther"
                       Size="Size.Small" Color="Color.Success" Variant="Variant.Filled"
                       StartIcon="@Icons.Material.Filled.Add">
                @Localizer["add"]
            </MudButton>
        </MudStack>

        <MudDataGrid T="M_Info_Company_other" Items="@ListCompanyOther" Filterable="true" @ref="mudTableCompanyOther" Class="pa-4" Bordered="true"
                     FilterMode="@DataGridFilterMode.ColumnFilterRow" Dense="true" Virtualize="true"
                     FixedHeader="true" FixedFooter="true" HeaderClass="no-wrap" FooterClass="no-wrap"
                     ReadOnly="false" CommittedItemChanges="@CommittedCompanyOther"
                     EditDialogOptions="@options" Loading="_loadingCompanyOther">
            <Columns>
                <TemplateColumn CellClass="d-flex justify-end" Filterable="false" Sortable="false">
                    <CellTemplate>
                        <MudIconButton Size="@Size.Small"
                                       Icon="@Icons.Material.Outlined.Edit"
                                       OnClick="@(async () => await context.Actions.StartEditingItemAsync())" />
                        <MudIconButton Size="@Size.Small"
                                       Icon="@Icons.Material.Outlined.Delete"
                                       Color="Color.Error"
                                       OnClick="@(async () => await DeleteCompanyOther(context.Item))" />
                    </CellTemplate>
                </TemplateColumn>

                <PropertyColumn Property="x => x.Code" Title="@Localizer["Code"]" IsEditable="false" Required="false">
                    <EditTemplate>
                        <MudTextField @bind-Value="context.Item.Code" Label="@Localizer["Code"]" Required />
                    </EditTemplate>
                </PropertyColumn>

                <PropertyColumn Property="x => x.AccountName" Title="@Localizer["AccountName"]" IsEditable="false" Required="false">
                    <EditTemplate>
                        <MudTextField @bind-Value="context.Item.AccountName" Label="@Localizer["AccountName"]" Required />
                    </EditTemplate>
                </PropertyColumn>

                <PropertyColumn Property="x => x.BankName" Title="@Localizer["BankName"]" IsEditable="false" Required="false">
                    <EditTemplate>
                        <MudTextField @bind-Value="context.Item.BankName" Label="@Localizer["BankName"]" />
                    </EditTemplate>
                </PropertyColumn>

                <PropertyColumn Property="x => x.AccountNo" Title="@Localizer["AccountNo"]" IsEditable="false" Required="false">
                    <EditTemplate>
                        <MudTextField @bind-Value="context.Item.AccountNo" Label="@Localizer["AccountNo"]" />
                    </EditTemplate>
                </PropertyColumn>

                <PropertyColumn Property="x => x.Deposit" Title="@Localizer["Deposit"]" IsEditable="false" Required="false">
                    <EditTemplate>
                        <MudTextField @bind-Value="context.Item.Deposit" Label="@Localizer["Deposit"]" />
                    </EditTemplate>
                </PropertyColumn>

                <PropertyColumn Property="x => x.Transit" Title="@Localizer["Transit"]" IsEditable="false" Required="false">
                    <EditTemplate>
                        <MudTextField @bind-Value="context.Item.Transit" Label="@Localizer["Transit"]" />
                    </EditTemplate>
                </PropertyColumn>

                <PropertyColumn Property="x => x.SDT_HotroKH" Title="@Localizer["CustomerSupportPhone"]" IsEditable="false" Required="false">
                    <EditTemplate>
                        <MudTextField @bind-Value="context.Item.SDT_HotroKH" Label="@Localizer["CustomerSupportPhone"]" />
                    </EditTemplate>
                </PropertyColumn>

                <PropertyColumn Property="x => x.Company" Title="@Localizer["Company"]" IsEditable="false" Required="false">
                    <EditTemplate>
                        <MudTextField @bind-Value="context.Item.Company" Label="@Localizer["Company"]" />
                    </EditTemplate>
                </PropertyColumn>

                <PropertyColumn Property="x => x.Address" Title="@Localizer["Address"]" IsEditable="false" Required="false">
                    <EditTemplate>
                        <MudTextField @bind-Value="context.Item.Address" Label="@Localizer["Address"]" />
                    </EditTemplate>
                </PropertyColumn>

                <PropertyColumn Property="x => x.Tel" Title="@Localizer["Tel"]" IsEditable="false" Required="false">
                    <EditTemplate>
                        <MudTextField @bind-Value="context.Item.Tel" Label="@Localizer["Tel"]" />
                    </EditTemplate>
                </PropertyColumn>

                <PropertyColumn Property="x => x.Fax" Title="@Localizer["Fax"]" IsEditable="false" Required="false">
                    <EditTemplate>
                        <MudTextField @bind-Value="context.Item.Fax" Label="@Localizer["Fax"]" />
                    </EditTemplate>
                </PropertyColumn>

                <PropertyColumn Property="x => x.Email" Title="@Localizer["Email"]" IsEditable="false" Required="false">
                    <EditTemplate>
                        <MudTextField @bind-Value="context.Item.Email" Label="@Localizer["Email"]" />
                    </EditTemplate>
                </PropertyColumn>

                <PropertyColumn Property="x => x.BankAddress" Title="@Localizer["BankAddress"]" IsEditable="false" Required="false">
                    <EditTemplate>
                        <MudTextField @bind-Value="context.Item.BankAddress" Label="@Localizer["BankAddress"]" />
                    </EditTemplate>
                </PropertyColumn>

                <PropertyColumn Property="x => x.SWIFT_CODE" Title="@Localizer["SwiftCode"]" IsEditable="false" Required="false">
                    <EditTemplate>
                        <MudTextField @bind-Value="context.Item.SWIFT_CODE" Label="@Localizer["SwiftCode"]" />
                    </EditTemplate>
                </PropertyColumn>

                <PropertyColumn Property="x => x.IBAN_CODE" Title="@Localizer["IbanCode"]" IsEditable="false" Required="false">
                    <EditTemplate>
                        <MudTextField @bind-Value="context.Item.IBAN_CODE" Label="@Localizer["IbanCode"]" />
                    </EditTemplate>
                </PropertyColumn>

                <PropertyColumn Property="x => x.Branches" Title="@Localizer["Branches"]" IsEditable="false" Required="false">
                    <EditTemplate>
                        <MudTextField @bind-Value="context.Item.Branches" Label="@Localizer["Branches"]" />
                    </EditTemplate>
