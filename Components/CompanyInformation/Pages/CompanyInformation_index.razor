
@using System.Globalization
@attribute [Authorize]
@using System.Text.Json
@using Microsoft.AspNetCore.Components.Forms
@inject GlobalServices gsv
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject AccountService asv
@inject SharedServices ssv
@inject BookingService bksv
@inject IJSRuntime JSRuntime
@inject SupportServices supsv
@inject IStringLocalizer<SharedResource> Localizer
@inject LocalChargesServices lcsv
@inject Bieugianangha_Services Bgnhsv
@inject CustomerService Cussv
@inject DNTUServices DNTUSV
@inject ProductPriceServices prsv;
@inject HistoryLogService HistoryLogService

<PageTitle>@Localizer["CompanyInfomation"] </PageTitle>
<MudText Class="pa-2" Typo="Typo.h6">@Localizer["CompanyInfomation"]</MudText>

<MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-4">
    <MudTabPanel Text="Company Information">
        <MudStack Row Justify="Justify.FlexStart" Spacing="2" Class="pa-4">
            <MudButton OnClick="RefreshCompanyInfo"
                       Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled"
                       StartIcon="@Icons.Material.Filled.Refresh" Disabled="_loading">
                @Localizer["reload"]
            </MudButton>
            <MudButton OnClick="SaveCompanyInfo"
                       Size="Size.Small" Color="Color.Success" Variant="Variant.Filled"
                       StartIcon="@Icons.Material.Filled.Save" Disabled="_loading">
                Lưu
            </MudButton>
        </MudStack>

        @if (_loading)
        {
            <MudProgressLinear Indeterminate="true" Class="mx-4" />
        }

        <MudPaper Class="pa-4 mx-4 mb-4" Outlined="true">
            <MudText Typo="Typo.subtitle1" Class="mb-3">Logo công ty</MudText>
            <MudStack Row Spacing="3" AlignItems="AlignItems.Center">
                @{
                    var logoSrc = GetLogoDataUrl(company.Logo);
                }
                @if (logoSrc != null)
                {
                    <MudImage Src="@logoSrc" Alt="Logo" Style="max-height:100px; max-width:240px;" ObjectFit="ObjectFit.Contain" />
                }
                else
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Chưa có logo</MudText>
                }
                <MudStack Spacing="1">
                    <MudFileUpload T="IBrowserFile" Accept=".png,.jpg,.jpeg,.gif,.webp" FilesChanged="OnLogoFileChanged">
                        <ButtonTemplate Context="btnCtx">
                            <MudButton HtmlTag="label" for="@btnCtx" Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.Upload">
                                Chọn logo
                            </MudButton>
                        </ButtonTemplate>
                    </MudFileUpload>
                    @if (company.Logo is { Length: > 0 })
                    {
                        <MudButton Variant="Variant.Text" Color="Color.Error" Size="Size.Small" OnClick="@(() => company.Logo = null)">
                            Xóa logo
                        </MudButton>
                    }
                </MudStack>
            </MudStack>
        </MudPaper>

        <MudForm Model="company" Class="pa-4">
            <MudGrid Spacing="3">
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="company.NameTiengViet" Label="@Localizer["NameTiengViet"]" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="company.AddressTiengViet" Label="@Localizer["AddressTiengViet"]" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="company.Name" Label="@Localizer["Name"]" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="company.Address" Label="@Localizer["Address"]" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="company.Tel" Label="@Localizer["Tel"]" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="company.Email" Label="@Localizer["Email"]" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="company.Website" Label="@Localizer["Website"]" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="company.SwiftCode" Label="@Localizer["SwiftCode"]" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="company.AddDebit" Label="@Localizer["AddDebit"]" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="company.Accno1Debit" Label="@Localizer["Accno1Debit"]" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="company.Accno2Debit" Label="@Localizer["Accno2Debit"]" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="company.TaxCode" Label="@Localizer["TaxCode"]" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="company.IPAddress" Label="@Localizer["IP Address"]" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudNumericField @bind-Value="company.hanmovecus" Label="@Localizer["Hạn Move Cus"]" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="company.Email_GuiTB" Label="Email gửi thông báo" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="company.PasswordEmail_GuiTB" Label="Mật khẩu email gửi thông báo" InputType="InputType.Password" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="company.SmtpServer" Label="SMTP Server" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudNumericField @bind-Value="company.SmtpPort" Label="SMTP Port" />
                </MudItem>
            </MudGrid>
        </MudForm>
    </MudTabPanel>

    <MudTabPanel Text="Tiếp đầu ngữ">
        <MudStack Row Justify="Justify.FlexStart" Class="pa-4">
            <MudButton OnClick="RefreshTiepDauNgu"
                       Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled"
                       StartIcon="@Icons.Material.Filled.Refresh">
                @Localizer["reload"]
            </MudButton>
            <MudButton OnClick="AddNewTiepDauNgu"
                       Size="Size.Small" Color="Color.Success" Variant="Variant.Filled"
                       StartIcon="@Icons.Material.Filled.Add">
                Thêm mới
            </MudButton>
        </MudStack>

        <MudDataGrid T="M_TiepDauNgu" Items="@ListTiepDauNgu" Filterable="true" @ref="mudTableTDN" Class="pa-4" Bordered="true"
                     FilterMode="@DataGridFilterMode.ColumnFilterRow" Dense="true" Virtualize="true"
                     FixedHeader="true" FixedFooter="true" HeaderClass="no-wrap" FooterClass="no-wrap"
                     ReadOnly="false" CommittedItemChanges="@CommittedTiepDauNgu"
                     EditDialogOptions="@options" Loading="_loadingTDN">
            <Columns>
                <TemplateColumn CellClass="d-flex justify-end" Filterable="false" Sortable="false">
                    <CellTemplate>
                        <MudIconButton Size="@Size.Small"
                                       Icon="@Icons.Material.Outlined.Edit"
                                       OnClick="@(async () => await context.Actions.StartEditingItemAsync())" />
                        <MudIconButton Size="@Size.Small"
                                       Icon="@Icons.Material.Outlined.Delete"
                                       Color="Color.Error"
                                       OnClick="@(async () => await DeleteTiepDauNgu(context.Item))" />
                    </CellTemplate>
                </TemplateColumn>

                <PropertyColumn Property="x => x.Loai" Title="Loại" IsEditable="false" Required="false">
                    <EditTemplate>
                        <MudTextField @bind-Value="context.Item.Loai" Label="Loại" Required />
                    </EditTemplate>
                </PropertyColumn>

                <PropertyColumn Property="x => x.Hangso" Title="Tiền tố" IsEditable="false" Required="false">
                    <EditTemplate>
                        <MudTextField @bind-Value="context.Item.Hangso" Label="Tiền tố" Required />
                    </EditTemplate>
                </PropertyColumn>

                <PropertyColumn Property="x => x.POL" Title="POL" IsEditable="false" Required="false">
                    <EditTemplate>
                        <MudTextField @bind-Value="context.Item.POL" Label="POL" />
                    </EditTemplate>
                </PropertyColumn>

                <PropertyColumn Property="x => x.POD" Title="POD" IsEditable="false" Required="false">
                    <EditTemplate>
                        <MudTextField @bind-Value="context.Item.POD" Label="POD" />
                    </EditTemplate>
                </PropertyColumn>
            </Columns>
        </MudDataGrid>
    </MudTabPanel>

    <MudTabPanel Text="Company Other">
        <MudStack Row Justify="Justify.FlexStart" Class="pa-4">
            <MudButton OnClick="RefreshCompanyOther"
                       Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled"
                       StartIcon="@Icons.Material.Filled.Refresh">
                @Localizer["reload"]
            </MudButton>
            <MudButton OnClick="AddNewCompanyOther"
                       Size="Size.Small" Color="Color.Success" Variant="Variant.Filled"
                       StartIcon="@Icons.Material.Filled.Add">
                Thêm mới
            </MudButton>
        </MudStack>

        <MudDataGrid T="M_Info_Company_other" Items="@ListCompanyOther" Filterable="true" @ref="mudTableCompanyOther" Class="pa-4" Bordered="true"
                     FilterMode="@DataGridFilterMode.ColumnFilterRow" Dense="true" Virtualize="true"
                     FixedHeader="true" FixedFooter="true" HeaderClass="no-wrap" FooterClass="no-wrap"
                     ReadOnly="false" CommittedItemChanges="@CommittedCompanyOther"
                     EditDialogOptions="@options" Loading="_loadingCompanyOther">
            <Columns>
                <TemplateColumn CellClass="d-flex justify-end" Filterable="false" Sortable="false">
                    <CellTemplate>
                        <MudIconButton Size="@Size.Small"
                                       Icon="@Icons.Material.Outlined.Edit"
                                       OnClick="@(async () => await context.Actions.StartEditingItemAsync())" />
                        <MudIconButton Size="@Size.Small"
                                       Icon="@Icons.Material.Outlined.Delete"
                                       Color="Color.Error"
                                       OnClick="@(async () => await DeleteCompanyOther(context.Item))" />
                    </CellTemplate>
                </TemplateColumn>

                <PropertyColumn Property="x => x.Code" Title="Code" IsEditable="false" Required="false">
                    <EditTemplate>
                        <MudTextField @bind-Value="context.Item.Code" Label="Code" Required />
                    </EditTemplate>
                </PropertyColumn>

                <PropertyColumn Property="x => x.AccountName" Title="Account Name" IsEditable="false" Required="false">
                    <EditTemplate>
                        <MudTextField @bind-Value="context.Item.AccountName" Label="Account Name" Required />
                    </EditTemplate>
                </PropertyColumn>

                <PropertyColumn Property="x => x.BankName" Title="Bank Name" IsEditable="false" Required="false">
                    <EditTemplate>
                        <MudTextField @bind-Value="context.Item.BankName" Label="Bank Name" />
                    </EditTemplate>
                </PropertyColumn>

                <PropertyColumn Property="x => x.AccountNo" Title="Account No" IsEditable="false" Required="false">
                    <EditTemplate>
                        <MudTextField @bind-Value="context.Item.AccountNo" Label="Account No" />
                    </EditTemplate>
                </PropertyColumn>

                <PropertyColumn Property="x => x.Deposit" Title="Deposit" IsEditable="false" Required="false">
                    <EditTemplate>
                        <MudTextField @bind-Value="context.Item.Deposit" Label="Deposit" />
                    </EditTemplate>
                </PropertyColumn>

                <PropertyColumn Property="x => x.Transit" Title="Transit" IsEditable="false" Required="false">
                    <EditTemplate>
                        <MudTextField @bind-Value="context.Item.Transit" Label="Transit" />
                    </EditTemplate>
                </PropertyColumn>

                <PropertyColumn Property="x => x.SDT_HotroKH" Title="SDT Hỗ trợ KH" IsEditable="false" Required="false">
                    <EditTemplate>
                        <MudTextField @bind-Value="context.Item.SDT_HotroKH" Label="SDT Hỗ trợ KH" />
                    </EditTemplate>
                </PropertyColumn>

                <PropertyColumn Property="x => x.Company" Title="Company" IsEditable="false" Required="false">
                    <EditTemplate>
                        <MudTextField @bind-Value="context.Item.Company" Label="Company" />
                    </EditTemplate>
                </PropertyColumn>

                <PropertyColumn Property="x => x.Address" Title="Address" IsEditable="false" Required="false">
                    <EditTemplate>
                        <MudTextField @bind-Value="context.Item.Address" Label="Address" />
                    </EditTemplate>
                </PropertyColumn>

                <PropertyColumn Property="x => x.Tel" Title="Tel" IsEditable="false" Required="false">
                    <EditTemplate>
                        <MudTextField @bind-Value="context.Item.Tel" Label="Tel" />
                    </EditTemplate>
                </PropertyColumn>

                <PropertyColumn Property="x => x.Fax" Title="Fax" IsEditable="false" Required="false">
                    <EditTemplate>
                        <MudTextField @bind-Value="context.Item.Fax" Label="Fax" />
                    </EditTemplate>
                </PropertyColumn>

                <PropertyColumn Property="x => x.Email" Title="Email" IsEditable="false" Required="false">
                    <EditTemplate>
                        <MudTextField @bind-Value="context.Item.Email" Label="Email" />
                    </EditTemplate>
                </PropertyColumn>

                <PropertyColumn Property="x => x.BankAddress" Title="Bank Address" IsEditable="false" Required="false">
                    <EditTemplate>
                        <MudTextField @bind-Value="context.Item.BankAddress" Label="Bank Address" />
                    </EditTemplate>
                </PropertyColumn>

                <PropertyColumn Property="x => x.SWIFT_CODE" Title="SWIFT CODE" IsEditable="false" Required="false">
                    <EditTemplate>
                        <MudTextField @bind-Value="context.Item.SWIFT_CODE" Label="SWIFT CODE" />
                    </EditTemplate>
                </PropertyColumn>

                <PropertyColumn Property="x => x.IBAN_CODE" Title="IBAN CODE" IsEditable="false" Required="false">
                    <EditTemplate>
                        <MudTextField @bind-Value="context.Item.IBAN_CODE" Label="IBAN CODE" />
                    </EditTemplate>
                </PropertyColumn>

                <PropertyColumn Property="x => x.Branches" Title="Branches" IsEditable="false" Required="false">
                    <EditTemplate>
                        <MudTextField @bind-Value="context.Item.Branches" Label="Branches" />
                    </EditTemplate>
                </PropertyColumn>
            </Columns>
        </MudDataGrid>
    </MudTabPanel>
</MudTabs>

@code {
    M_CompanyInfo company = new();
    List<M_TiepDauNgu> ListTiepDauNgu = new List<M_TiepDauNgu>();
    List<M_Info_Company_other> ListCompanyOther = new List<M_Info_Company_other>();
    MudDataGrid<M_TiepDauNgu>? mudTableTDN;
    MudDataGrid<M_Info_Company_other>? mudTableCompanyOther;

    string usr = string.Empty;
    bool _loading = false;
    bool _loadingTDN = false;
    bool _loadingCompanyOther = false;

    protected async override Task OnInitializedAsync()
    {
        usr = asv.GetAuth().Result.User.Identity!.Name!;
        await RefreshCompanyInfo();
    }

    async Task RefreshCompanyInfo()
    {
        try
        {
            _loading = true;

            if (!await ssv.CheckPermission(usr, "View", "Companyinformation"))
            {
                CallSnackBar("You have not access to view", MudBlazor.Severity.Warning);
                return;
            }
            company = await gsv.GetSingleCompany_info();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            CallSnackBar("Something went wrong!, error code: " + ex.Message, MudBlazor.Severity.Warning);
        }
        finally
        {
            _loading = false;
        }
    }

    async Task SaveCompanyInfo()
    {
        try
        {
            if (!await ssv.CheckPermission(usr, "Edit", "Companyinformation"))
            {
                CallSnackBar("You have not access to edit", MudBlazor.Severity.Warning);
                return;
            }

            _loading = true;
            var rs = await gsv.SaveCompany_info(company);
            CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
            if (rs.Flag)
                await RefreshCompanyInfo();
        }
        catch (Exception ex)
        {
            CallSnackBar("Lỗi khi lưu: " + ex.Message, MudBlazor.Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    async Task RefreshTiepDauNgu()
    {
        try
        {
            _loadingTDN = true;
            ListTiepDauNgu.Clear();
            await Task.Delay(300);
            ListTiepDauNgu = await gsv.GetTiepDauNguList();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            CallSnackBar("Lỗi: " + ex.Message, MudBlazor.Severity.Warning);
        }
        finally
        {
            _loadingTDN = false;
        }
    }

    async Task AddNewTiepDauNgu()
    {
        var newItem = new M_TiepDauNgu();
        ListTiepDauNgu.Insert(0, newItem);
        await mudTableTDN!.SetEditingItemAsync(newItem);
    }

    async Task CommittedTiepDauNgu(M_TiepDauNgu item)
    {
        try
        {
            _loadingTDN = true;
            await mudTableTDN!.CancelEditingItemAsync();

            BoolandMessReponse rs;
            if (item.id == Guid.Empty)
            {
                // New item flow
                rs = await gsv.AddTiepDauNgu(item);
            }
            else
            {
                rs = await gsv.UpdateTiepDauNgu(item);
            }

            CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
            await RefreshTiepDauNgu();
        }
        catch (Exception ex)
        {
            CallSnackBar("Lỗi: " + ex.Message, MudBlazor.Severity.Error);
        }
        finally
        {
            _loadingTDN = false;
        }
    }

    async Task DeleteTiepDauNgu(M_TiepDauNgu item)
    {
        bool? confirm = await DialogService.ShowMessageBox(
            "Xác nhận",
            $"Xóa '{item.Loai} - {item.Hangso}'?",
            yesText: "Xóa", cancelText: "Hủy");

        if (confirm != true) return;

        try
        {
            _loadingTDN = true;
            var rs = await gsv.DeleteTiepDauNgu(item);
            CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
            await RefreshTiepDauNgu();
        }
        catch (Exception ex)
        {
            CallSnackBar("Lỗi: " + ex.Message, MudBlazor.Severity.Error);
        }
        finally
        {
            _loadingTDN = false;
        }
    }

    async Task RefreshCompanyOther()
    {
        try
        {
            _loadingCompanyOther = true;
            ListCompanyOther.Clear();
            await Task.Delay(300);
            ListCompanyOther = await gsv.GetCompanyOtherList();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            CallSnackBar("Lỗi: " + ex.Message, MudBlazor.Severity.Warning);
        }
        finally
        {
            _loadingCompanyOther = false;
        }
    }

    async Task AddNewCompanyOther()
    {
        var newItem = new M_Info_Company_other();
        ListCompanyOther.Insert(0, newItem);
        await mudTableCompanyOther!.SetEditingItemAsync(newItem);
    }

    async Task CommittedCompanyOther(M_Info_Company_other item)
    {
        try
        {
            _loadingCompanyOther = true;
            await mudTableCompanyOther!.CancelEditingItemAsync();

            BoolandMessReponse rs;
            if (item.id == Guid.Empty)
            {
                rs = await gsv.AddCompanyOther(item);
            }
            else
            {
                rs = await gsv.UpdateCompanyOther(item);
            }

            CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
            await RefreshCompanyOther();
        }
        catch (Exception ex)
        {
            CallSnackBar("Lỗi: " + ex.Message, MudBlazor.Severity.Error);
        }
        finally
        {
            _loadingCompanyOther = false;
        }
    }

    async Task DeleteCompanyOther(M_Info_Company_other item)
    {
        bool? confirm = await DialogService.ShowMessageBox(
            "Xác nhận",
            $"Xóa '{item.Code} - {item.AccountName}'?",
            yesText: "Xóa", cancelText: "Hủy");

        if (confirm != true) return;

        try
        {
            _loadingCompanyOther = true;
            var rs = await gsv.DeleteCompanyOther(item);
            CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
            await RefreshCompanyOther();
        }
        catch (Exception ex)
        {
            CallSnackBar("Lỗi: " + ex.Message, MudBlazor.Severity.Error);
        }
        finally
        {
            _loadingCompanyOther = false;
        }
    }

    void CallSnackBar(string message, MudBlazor.Severity severity)
    {
        Snackbar.Clear();
        Snackbar.Configuration.SnackbarVariant = Variant.Filled;
        Snackbar.Configuration.MaxDisplayedSnackbars = 3;
        Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopRight;
        Snackbar.Add(message, severity);
    }
    DialogOptions options = new DialogOptions
        {
            ClassBackground = "class-dialog-custom",
            FullWidth = true,
            MaxWidth = MaxWidth.Medium,
            CloseOnEscapeKey = false,
            DisableBackdropClick = true
        };
    const long MaxLogoBytes = 2 * 1024 * 1024;

    static string? GetLogoDataUrl(byte[]? logo)
    {
        if (logo is not { Length: > 0 })
            return null;
        return $"data:{DetectImageMime(logo)};base64,{Convert.ToBase64String(logo)}";
    }

    static string DetectImageMime(byte[] data)
    {
        if (data.Length >= 3 && data[0] == 0xFF && data[1] == 0xD8 && data[2] == 0xFF)
            return "image/jpeg";
        if (data.Length >= 8 && data[0] == 0x89 && data[1] == 0x50 && data[2] == 0x4E && data[3] == 0x47)
            return "image/png";
        if (data.Length >= 6 && data[0] == 0x47 && data[1] == 0x49 && data[2] == 0x46)
            return "image/gif";
        if (data.Length >= 12 && data[8] == 0x57 && data[9] == 0x45 && data[10] == 0x42 && data[11] == 0x50)
            return "image/webp";
        return "image/png";
    }

    async Task OnLogoFileChanged(IBrowserFile? file)
    {
        if (file == null)
            return;

        try
        {
            if (file.Size > MaxLogoBytes)
            {
                CallSnackBar("Logo tối đa 2MB.", MudBlazor.Severity.Warning);
                return;
            }

            await using var stream = file.OpenReadStream(MaxLogoBytes);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            company.Logo = ms.ToArray();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            CallSnackBar("Không đọc được file logo: " + ex.Message, MudBlazor.Severity.Error);
        }
    }

}
