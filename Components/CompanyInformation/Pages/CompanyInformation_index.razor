    </MudTabPanel>

    <MudTabPanel Text="Tiếp đầu ngữ">
        <MudStack Row Justify="Justify.FlexStart" Class="pa-4">
            <MudButton OnClick="RefreshTiepDauNgu"
                       Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled"
                       StartIcon="@Icons.Material.Filled.Refresh">
                @Localizer["reload"]
            </MudButton>
            <MudButton OnClick="AddNewTiepDauNgu"
                       Size="Size.Small" Color="Color.Success" Variant="Variant.Filled"
                       StartIcon="@Icons.Material.Filled.Add">
                Thêm mới
            </MudButton>
        </MudStack>

        <MudDataGrid T="M_TiepDauNgu" Items="@ListTiepDauNgu" Filterable="true" @ref="mudTableTDN" Class="pa-4" Bordered="true"
                     FilterMode="@DataGridFilterMode.ColumnFilterRow" Dense="true" Virtualize="true"
                     FixedHeader="true" FixedFooter="true" HeaderClass="no-wrap" FooterClass="no-wrap"
                     ReadOnly="false" CommittedItemChanges="@CommittedTiepDauNgu"
                     EditDialogOptions="@options" Loading="_loadingTDN">
            <Columns>
                <TemplateColumn CellClass="d-flex justify-end" Filterable="false" Sortable="false">
                    <CellTemplate>
                        <MudIconButton Size="@Size.Small"
                                       Icon="@Icons.Material.Outlined.Edit"
                                       OnClick="@(async () => await context.Actions.StartEditingItemAsync())" />
                        <MudIconButton Size="@Size.Small"
                                       Icon="@Icons.Material.Outlined.Delete"
                                       Color="Color.Error"
                                       OnClick="@(async () => await DeleteTiepDauNgu(context.Item))" />
                    </CellTemplate>
                </TemplateColumn>

                <PropertyColumn Property="x => x.Loai" Title="Loại" IsEditable="false" Required="false">
                    <EditTemplate>
                        <MudTextField @bind-Value="context.Item.Loai" Label="Loại" Required />
                    </EditTemplate>
                </PropertyColumn>

                <PropertyColumn Property="x => x.Hangso" Title="Tiền tố" IsEditable="false" Required="false">
                    <EditTemplate>
                        <MudTextField @bind-Value="context.Item.Hangso" Label="Tiền tố" Required />
                    </EditTemplate>
                </PropertyColumn>

                <PropertyColumn Property="x => x.POL" Title="POL" IsEditable="false" Required="false">
                    <EditTemplate>
                        <MudTextField @bind-Value="context.Item.POL" Label="POL" />
                    </EditTemplate>
                </PropertyColumn>

                <PropertyColumn Property="x => x.POD" Title="POD" IsEditable="false" Required="false">
                    <EditTemplate>
                        <MudTextField @bind-Value="context.Item.POD" Label="POD" />
                    </EditTemplate>
                </PropertyColumn>
            </Columns>
        </MudDataGrid>
    </MudTabPanel>
</MudTabs>

@code {
    List<M_CompanyInfo> Listdata = new List<M_CompanyInfo>();
    List<M_TiepDauNgu> ListTiepDauNgu = new List<M_TiepDauNgu>();
    MudDataGrid<M_CompanyInfo>? mudTable;
    MudDataGrid<M_TiepDauNgu>? mudTableTDN;

    private bool _resizeColumn;
    M_CompanyInfo? detail;
    string usr = string.Empty;
    bool _loading = false;
    bool _loadingTDN = false;

    protected async override Task OnInitializedAsync()
    {
        usr = asv.GetAuth().Result.User.Identity!.Name!;
        // await RefreshCompanyInfo();
    }

    async Task RefreshCompanyInfo()
    {
        try
        {
            detail = null;
            _loading = true;
            Listdata.Clear();

            await Task.Delay(500);
            if (!await ssv.CheckPermission(usr, "View", "Companyinformation"))
            {
                CallSnackBar("You have not access to view", MudBlazor.Severity.Warning);
                return;
            }
            Listdata = await gsv.Get_Company_info();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            CallSnackBar("Something went wrong!, error code: " + ex.Message, MudBlazor.Severity.Warning);
        }
        finally
        {
            _loading = false;
        }
    }

    async Task RefreshTiepDauNgu()
    {
        try
        {
            _loadingTDN = true;
            ListTiepDauNgu.Clear();
            await Task.Delay(300);
            ListTiepDauNgu = await gsv.GetTiepDauNguList();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            CallSnackBar("Lỗi: " + ex.Message, MudBlazor.Severity.Warning);
        }
        finally
        {
            _loadingTDN = false;
        }
    }

    async Task AddNewTiepDauNgu()
    {
        var newItem = new M_TiepDauNgu();
        ListTiepDauNgu.Insert(0, newItem);
        await mudTableTDN!.SetEditingItemAsync(newItem);
    }

    async Task CommittedTiepDauNgu(M_TiepDauNgu item)
    {
        try
        {
            _loadingTDN = true;
            await mudTableTDN!.CancelEditingItemAsync();

            BoolandMessReponse rs;
            if (item.id == Guid.Empty)
            {
                // New item flow
                rs = await gsv.AddTiepDauNgu(item);
            }
            else
            {
                rs = await gsv.UpdateTiepDauNgu(item);
            }

            CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
            await RefreshTiepDauNgu();
        }
        catch (Exception ex)
        {
            CallSnackBar("Lỗi: " + ex.Message, MudBlazor.Severity.Error);
        }
        finally
        {
            _loadingTDN = false;
        }
    }

    async Task DeleteTiepDauNgu(M_TiepDauNgu item)
    {
        bool? confirm = await DialogService.ShowMessageBox(
            "Xác nhận",
            $"Xóa '{item.Loai} - {item.Hangso}'?",
            yesText: "Xóa", cancelText: "Hủy");

        if (confirm != true) return;

        try
        {
            _loadingTDN = true;
            var rs = await gsv.DeleteTiepDauNgu(item);
            CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
            await RefreshTiepDauNgu();
        }
        catch (Exception ex)
        {
            CallSnackBar("Lỗi: " + ex.Message, MudBlazor.Severity.Error);
        }
        finally
        {
            _loadingTDN = false;
        }
    }

    void CallSnackBar(string message, MudBlazor.Severity severity)
    {
        Snackbar.Clear();
        Snackbar.Configuration.SnackbarVariant = Variant.Filled;
        Snackbar.Configuration.MaxDisplayedSnackbars = 3;
        Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopRight;
        Snackbar.Add(message, severity);
    }
    void RowClicked(DataGridRowClickEventArgs<M_CompanyInfo> args)
    {
        detail = args.Item;
    }
    private int selectedRowNumber = -1;
    private string SelectedRowClassFunc(M_CompanyInfo m, int rowNumber)
    {
        if (selectedRowNumber == rowNumber)
        {
            selectedRowNumber = -1;
            return string.Empty;
        }
        else if (mudTable?.SelectedItem != null && mudTable.SelectedItem.Equals(m))
        {
            selectedRowNumber = rowNumber;
            return "selected";
        }
        else
        {
            return string.Empty;
        }
    }


    int? index_no;

  
    DialogOptions options = new DialogOptions
        {
            ClassBackground = "class-dialog-custom",
            FullWidth = true,
            MaxWidth = MaxWidth.Medium,
            CloseOnEscapeKey = false,
            DisableBackdropClick = true
        };
    string search = string.Empty;

    private bool FilterFunc1(M_CompanyInfo sbd) => FilterFunc(sbd, search);

    private bool FilterFunc(M_CompanyInfo sbd, string searchString)
    {
        if (string.IsNullOrWhiteSpace(sbd.NameTiengViet))
            return true;
        if (string.IsNullOrWhiteSpace(searchString))
            return true;
        if (sbd.NameTiengViet!.Contains(searchString, StringComparison.OrdinalIgnoreCase))
            return true;
        if ($"{sbd.NameTiengViet} ".Contains(searchString))
            return true;
        return false;
    }

    async Task CommittedItem(M_CompanyInfo item)
    {
        try
        {
            _loading = true;
            var newjobid = Guid.NewGuid();
            await mudTable!.CancelEditingItemAsync();
            
            var rs = await gsv.UpdateCompany_info(item);
            CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
            
            await RefreshCompanyInfo();
        }
        catch (Exception ex)
        {
            CallSnackBar("somethings went wrong while commit Item, code: " + ex.Message, MudBlazor.Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

}
