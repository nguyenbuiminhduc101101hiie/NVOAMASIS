@page "/BillSeaLayoutEditor"
@attribute [Authorize]
@inject GlobalServices gsv
@inject AccountService asv
@inject SharedServices ssv
@inject ISnackbar Snackbar

<PageTitle>Chỉnh layout Bill Sea</PageTitle>
<MudText Class="pa-2" Typo="Typo.h6">Chỉnh layout Bill Sea</MudText>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Class="mx-4" />
}

<MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-4">
    <MudTabPanel Text="BillSea Layout">
        <BillSeaLayoutEditorPanel ReportFileName="BillSea_NVOCC.mrt"
                                  UserName="@_userName"
                                  FormBillSeaLogo="@_company.FormBillSea" />
    </MudTabPanel>

    <MudTabPanel Text="BillSea Att 1 Layout">
        <BillSeaLayoutEditorPanel ReportFileName="BillSea_NVOCC_Att_1.mrt"
                                  UserName="@_userName"
                                  FormBillSeaLogo="@_company.FormBillSea" />
    </MudTabPanel>
</MudTabs>

@code {
    M_CompanyInfo _company = new();
    string _userName = string.Empty;
    bool _loading;

    protected override async Task OnInitializedAsync()
    {
        _userName = asv.GetAuth().Result.User.Identity!.Name!;
        await LoadCompanyInfoAsync();
    }

    async Task LoadCompanyInfoAsync()
    {
        try
        {
            _loading = true;

            if (!await ssv.CheckPermission(_userName, "View", "Companyinformation"))
            {
                ShowMessage("You have not access to view", MudBlazor.Severity.Warning);
                return;
            }

            _company = await gsv.GetSingleCompany_info();
        }
        catch (Exception ex)
        {
            ShowMessage("Không tải được thông tin công ty: " + ex.Message, MudBlazor.Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    void ShowMessage(string message, MudBlazor.Severity severity)
    {
        Snackbar.Clear();
        Snackbar.Configuration.SnackbarVariant = Variant.Filled;
        Snackbar.Configuration.MaxDisplayedSnackbars = 3;
        Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopRight;
        Snackbar.Add(message, severity);
    }
}
