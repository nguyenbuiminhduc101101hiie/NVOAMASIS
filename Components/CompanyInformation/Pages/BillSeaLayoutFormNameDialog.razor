@using NVOAMASIS.Models

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@Title</MudText>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.subtitle2" Class="mb-2"><b>Loại Bill</b></MudText>
        <MudRadioGroup @bind-Value="_formKind" T="BillLayoutFormKind">
            <MudRadio Value="BillLayoutFormKind.Sea" Color="Color.Primary">Sea (SE / SI)</MudRadio>
            <MudRadio Value="BillLayoutFormKind.Air" Color="Color.Secondary">Air (AE / AI)</MudRadio>
        </MudRadioGroup>

        <MudTextField @bind-Value="_formName"
                      Label="Tên form"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      Class="mt-3"
                      Immediate="true"
                      Placeholder="VD: Bill NVOCC chuẩn, Bill Air khách A..." />
        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-2">
            Form mới sẽ copy từ template gốc <b>@GetTemplateName()</b>.
        </MudText>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Submit" Color="Color.Primary" Variant="Variant.Filled" Disabled="string.IsNullOrWhiteSpace(_formName)">
            Tạo
        </MudButton>
        <MudButton OnClick="Cancel">Hủy</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    public MudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public string Title { get; set; } = "Tên form";

    [Parameter]
    public BillLayoutFormKind DefaultFormKind { get; set; } = BillLayoutFormKind.Sea;

    string _formName = string.Empty;
    BillLayoutFormKind _formKind = BillLayoutFormKind.Sea;

    protected override void OnParametersSet() => _formKind = DefaultFormKind;

    string GetTemplateName() =>
        _formKind == BillLayoutFormKind.Air ? "BillAir.mrt" : "BillSea_NVOCC.mrt";

    void Submit()
    {
        var name = _formName.Trim();
        if (string.IsNullOrWhiteSpace(name))
            return;

        MudDialog.Close(DialogResult.Ok(new BillLayoutFormCreateRequest
        {
            FormName = name,
            FormKind = _formKind
        }));
    }

    void Cancel() => MudDialog.Cancel();
}
