<MudDialog>
    <DialogContent>
        <MudForm @ref="form" @bind-IsValid="@success">
            <MudStack Row Justify="Justify.SpaceEvenly">
                <MudSelect @bind-Value="Data.tuthang" Label="From Month" Required
                    Validation="@(new Func<string, string>(Validatefield))">
                    @foreach (var i in thangs)
                    {
                        <MudSelectItem Value="i">@i</MudSelectItem>
                    }
                </MudSelect>
                <MudSelect @bind-Value="Data.denthang" Label="To Month" Required
                    Validation="@(new Func<string, string>(Validatefield))">
                    @foreach (var i in thangs)
                    {
                        <MudSelectItem Value="i">@i</MudSelectItem>
                    }
                </MudSelect>
                <MudSelect @bind-Value="Data.nam" Label="Year" Required
                    Validation="@(new Func<string, string>(Validatefield))">
                    @foreach (var i in nams)
                    {
                        <MudSelectItem Value="i">@i</MudSelectItem>
                    }
                </MudSelect>
            </MudStack>
            <MudStack>
                <MudTextField @bind-Value="Data.soluongsoref" Label="Ref Quantity" Required
                    Validation="@(new Func<string, string>(Validatefield))" />
            </MudStack>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@Localizer["Cancel"]</MudButton>
        <MudButton HtmlTag="label" Disabled="!success" @onclick="@(() => CommittedItem(Data))" Size="Size.Small"
            Color="Color.Secondary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add">
            @Localizer["Insert"]
        </MudButton>
    </DialogActions>
</MudDialog>
@inject CustomerService csv
@inject SupportServices supsv
@inject SharedServices ssv
@inject AccountService asv
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IStringLocalizer<SharedResource> Localizer

@code {
    [CascadingParameter] MudDialogInstance? MudDialog { get; set; }
    [Parameter] public M_Customer customer { get; set; } = default!;
    void Cancel() => MudDialog.Cancel();
    void CallSnackBar(string message, MudBlazor.Severity severity)
    {

        Snackbar.Configuration.SnackbarVariant = Variant.Filled;
        Snackbar.Configuration.MaxDisplayedSnackbars = 3;
        Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopRight;
        Snackbar.Add(message, severity);
    }
    MudForm form;
    bool success = false;
    class Databind
    {
        public int tuthang { get; set; }
        public int denthang { get; set; }
        public int nam { get; set; }
        public int soluongsoref { get; set; }
    }
    Databind Data = new Databind
    {
        tuthang = DateTime.Now.Month,
        denthang = DateTime.Now.Month,
        nam = DateTime.Now.Year

    };
    List<int> thangs = new List<int>();
    List<int> nams = new List<int>();

    protected async override Task OnInitializedAsync()
    {
        for (int i = 1; i <= 12; i++)
            thangs.Add(i);
        for (int i = DateTime.Now.Year; i < DateTime.Now.Year + 2; i++)
            nams.Add(i);

    }

    async Task CommittedItem(Databind item)
    {
        var rs = await supsv.InsertRefNo(item.tuthang, item.denthang, item.nam, item.soluongsoref);
        CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
    }
    private string Validatefield(string arg)
    {
        if (Data.tuthang > Data.denthang)
            return "Value from-to month not valid!";
        if (Data.tuthang == 0 || Data.denthang == 0 || Data.nam == 0 || Data.soluongsoref == 0)
            return "Value 0 is not valid!";
        return null;
    }
}
