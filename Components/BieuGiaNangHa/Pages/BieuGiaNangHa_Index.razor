@page "/Bieugianangha"
@using System.Globalization
@attribute [Authorize]
@inject GlobalServices gsv
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject AccountService asv
@inject SharedServices ssv
@inject BookingService bksv 
@inject IJSRuntime JSRuntime
@inject SupportServices supsv
@inject IStringLocalizer<SharedResource> Localizer
@inject LocalChargesServices lcsv
@inject Bieugianangha_Services Bgnhsv
@inject HistoryLogService HistoryLogService
@using System.Text.Json;

<style>
    .price-ui-title { font-weight: 800; color: #0f3557; }
    .price-ui-toolbar { background: #fff; border: 1px solid #e2e8f0; border-radius: 14px; padding: 10px 12px; margin: 8px 12px; }
    .price-ui-toolbar .mud-button-root { border-radius: 999px; text-transform: none; font-weight: 700; }
    .price-ui-grid { border-radius: 14px; border: 1px solid #e2e8f0 !important; overflow: hidden; }
    .price-ui-grid .mud-table-head th, .price-ui-grid .mud-table thead th { background: linear-gradient(180deg,#118ab2 0%,#0d6f91 100%) !important; color: #fff !important; font-weight: 800 !important; }
</style>

<PageTitle>@Localizer["Bieugianangha"] </PageTitle>
<MudText Class="pa-2 price-ui-title" Typo="Typo.h6">@Localizer["Bieugianangha"]</MudText>
<MudStack Row Justify="Justify.FlexStart" Class="pa-4 price-ui-toolbar">
    <MudButton  HtmlTag="label"
                OnClick="Refresh"
                Size="Size.Small" Color="Color.Primary" Variant="   Variant.Filled"
                StartIcon="@Icons.Material.Filled.Refresh">
        @Localizer["reload"]
    </MudButton>
    <MudButton  HtmlTag="label"
                 @onclick="@((e) => OpenCreateDialog(new Models.M_Bieugianangha()))"
                Size="Size.Small" Color="Color.Secondary" Variant="Variant.Filled"
                StartIcon="@Icons.Material.Filled.Add">
        @Localizer["new"]
    </MudButton>

    <MudButton HtmlTag="label"
               @onclick="@((e) => OpenEditDialog(detail))"
               Size="Size.Small" Color="Color.Info" Variant="Variant.Filled"
               StartIcon="@Icons.Material.Filled.Edit">
        @Localizer["edit"]
    </MudButton>

    <MudButton HtmlTag="label"
               @onclick="@((e) => OpenDuplicateDialog(detail))"
               Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled"
               StartIcon="@Icons.Material.Filled.CopyAll">
        @Localizer["duplicate"]
    </MudButton>
</MudStack>

<MudDataGrid    T="M_Bieugianangha" Items="@Listdata" Filterable="true" @ref="mudTable" Class="pa-4 price-ui-grid"  Bordered ="true"
                FilterMode="@DataGridFilterMode.ColumnFilterRow" Dense="true" Virtualize="true" QuickFilter="@FilterFunc1"
                FixedHeader="true" FixedFooter="true" HeaderClass="no-wrap" FooterClass="no-wrap"
                ReadOnly="false" CommittedItemChanges="@CommittedItem" RowClassFunc="@SelectedRowClassFunc"
                RowClick="@RowClicked" EditDialogOptions="@options"
             ColumnResizeMode="@(ResizeMode.Column)" Loading="_loading">
    <Columns>
        <HierarchyColumn T="M_Bieugianangha" />
        <TemplateColumn CellClass="d-flex justify-end">
            <CellTemplate>

                <MudIconButton Icon="@Icons.Material.Outlined.Delete" OnClick="@(()=>DeleteItem(context.Item))" />
            </CellTemplate>
        </TemplateColumn>


        <PropertyColumn Property="x=>x.CangICDDepot" Title="@Localizer["CangICDDepot"]" Required="false" CellStyleFunc="_cellStyleFunc" CellClass="custom-right-align">
        </PropertyColumn>

        <PropertyColumn Property="x=>x.DiaChi" Title="@Localizer["Address"]" Required="false" CellStyleFunc="_cellStyleFunc" >
        </PropertyColumn> 

        <PropertyColumn Property="x=>x.TrangThai" Title="@Localizer["status"]" Required="false" CellStyleFunc="_cellStyleFunc">
        </PropertyColumn>

        <PropertyColumn Property="x=>x.LoaiContainer" Title="@Localizer["loaicont"]" Required="false" CellStyleFunc="_cellStyleFunc" >
        </PropertyColumn>

        <PropertyColumn Property="x=>x.LoaiHinhNangHa" Title="@Localizer["loaiHinhNangHa"]" Required="false" CellStyleFunc="_cellStyleFunc" >
        </PropertyColumn>

        <PropertyColumn Property="x => x.ThoiGianApDung" Title="@Localizer["thoigianapdung"]" Required="false" CellStyleFunc="_cellStyleFunc" Format="dd/MM/yyyy">
        </PropertyColumn>

        <PropertyColumn Property="x=>x.NangLenPhuongTien" Title="@Localizer["NangLenPhuongTien"]" Required="false" Format="#,##0.##" Culture="@_en" CellStyleFunc="_cellStyleFunc" CellClass="custom-right-align">
        </PropertyColumn>

        <PropertyColumn Property="x=>x.HaXuongBai" Title="@Localizer["haXuongBai"]" Required="false" Format="#,##0.##" Culture="@_en" CellStyleFunc="_cellStyleFunc" CellClass="custom-right-align">
        </PropertyColumn>

        <PropertyColumn Property="x=>x.NangHaNoiBo" Title="@Localizer["NangHaNoiBo"]" Required="false" Format="#,##0.##" Culture="@_en" CellStyleFunc="_cellStyleFunc" CellClass="custom-right-align">
        </PropertyColumn>

        <PropertyColumn Property="x=>x.NangHaRong" Title="@Localizer["Nangharong"]" Required="false" Format="#,##0.##" Culture="@_en" CellStyleFunc="_cellStyleFunc" CellClass="custom-right-align">
        </PropertyColumn>

        <PropertyColumn Property="x=>x.NangHaHang" Title="@Localizer["NangHaHang"]" Required="false" Format="#,##0.##" Culture="@_en" CellStyleFunc="_cellStyleFunc" CellClass="custom-right-align">
        </PropertyColumn>

        <PropertyColumn Property="x=>x.NangHaKiemHoaSuaChuaVeSinh" Title="@Localizer["NangHaKiemHoaSuaChuaVeSinh"]" Required="false" Format="#,##0.##" Culture="@_en" CellStyleFunc="_cellStyleFunc" CellClass="custom-right-align">
        </PropertyColumn>

        <PropertyColumn Property="x=>x.NangHaKiemHoa" Title="@Localizer["NangHaKiemHoa"]" Required="false" Format="#,##0.##" Culture="@_en" CellStyleFunc="_cellStyleFunc"  CellClass="custom-right-align">
        </PropertyColumn>

        <PropertyColumn Property="x=>x.NangHaSieuTruongSieuTrong" Title="@Localizer["NangHaSieuTruongSieuTrong"]" Required="false" Format="#,##0.##" Culture="@_en" CellStyleFunc="_cellStyleFunc" CellClass="custom-right-align">
        </PropertyColumn>

        <PropertyColumn Property="x=>x.NangHaNgoaiGioHanhChinh" Title="@Localizer["NangHaNgoaiGioHanhChinh"]" Required="false" Format="#,##0.##" Culture="@_en" CellStyleFunc="_cellStyleFunc" CellClass="custom-right-align">
        </PropertyColumn>

        <PropertyColumn Property="x=>x.NangHaKhuCachLy" Title="@Localizer["NangHaKhuCachLy"]" Required="false" Format="#,##0.##" Culture="@_en" CellStyleFunc="_cellStyleFunc" CellClass="custom-right-align">
        </PropertyColumn>


        <PropertyColumn Property="x => x.PhuPhiHangNguyHiem" Title="@Localizer["PhuPhiHangNguyHiem"]" Format="#,##0.##" Culture="@_en" CellStyleFunc="_cellStyleFunc" Required="false" CellClass="custom-right-align">

        </PropertyColumn>


        <PropertyColumn Property="x => x.PhuPhiNgoaiGio" Title="@Localizer["PhuPhiNgoaiGio"]" Format="#,##0.##" Culture="@_en" CellStyleFunc="_cellStyleFunc" Required="false" CellClass="custom-right-align">

        </PropertyColumn>

        <PropertyColumn Property="x => x.PhuPhiDungThietBiDacBiet" Title="@Localizer["PhuPhiDungThietBiDacBiet"]" Format="#,##0.##" CellStyleFunc="_cellStyleFunc" Culture="@_en" Required="false">

        </PropertyColumn>

        <PropertyColumn Property="x => x.PhuPhiDungThietBiDacBiet" Title="@Localizer["PhuPhiDungThietBiDacBiet"]" Format="#,##0.##" CellStyleFunc="_cellStyleFunc" Culture="@_en" Required="false">

        </PropertyColumn>

        <TemplateColumn Title="@Localizer["Approve"]">
            <CellTemplate>
                <MudCheckBox @bind-Checked="context.Item.Approve" @bind-Value="context.Item.Approve" @bind-Value:after="@(()=> OnApproveCheckboxWrapper(context.Item))">
                </MudCheckBox>
            </CellTemplate>
        </TemplateColumn>

    </Columns>

        <PagerContent>
        <MudDataGridPager T="Models.M_Bieugianangha" PageSizeOptions="@(new int[] { 8, 10, 20 })" />
    </PagerContent>
</MudDataGrid>

@code {
    List<M_Bieugianangha> Listdata = new List<M_Bieugianangha>();
    MudDataGrid<M_Bieugianangha> mudTable;
    AuthUser user;
    string mailtp, mailpp;
    string usr;
    private List<string> ListUser { get; set; } = new List<string>();
    string UserHanding;
    List<string> trangthais = new List<string>();
    private List<Models.TrangThai> M_Trangthais = new List<Models.TrangThai>();
    private string searchText_pol = "";
    private string searchText_pod = "";
    private List<PortModel> filteredPorts = new List<PortModel>();
    private List<PortModel> filteredPorts_pod = new List<PortModel>();
    private List<PortModel> Ports = new List<PortModel>();
    private bool _resizeColumn;
    M_Bieugianangha detail;

    private List<M_Customer> filteredCarr = new List<M_Customer>();
    private List<M_Customer> Cuss_Carr = new List<M_Customer>();
    private List<Terminal_> Terminals = new List<Terminal_>();

    public CultureInfo _en = CultureInfo.GetCultureInfo("en-US");
    private bool _canApprove = false;
    private async Task OnApproveChanged(bool isChecked, M_Bieugianangha item)
    {
        bool canApprove = await ssv.CheckPermission(usr, "Approve", "BieuGiaNangHa");

        if (!canApprove)
        {
            CallSnackBar("Bạn không có quyền để duyệt!", MudBlazor.Severity.Error);
        }
        else
        {
            // Nếu có quyền, thực hiện cập nhật
            item.Approve = isChecked;
            var rs = await Bgnhsv.UpdateCreateBieuGiaNangHa(item);

        }
    }

    protected async override Task OnInitializedAsync()
    {

        M_Trangthais = await supsv.GetListTrangThai();
        var tts = await supsv.GetListTrangThai();
        trangthais = tts.Where(x => x.Tieude == "BieuGiaNangHa").OrderBy(x => x.Noidung).Select(x => x.Noidung).ToList();
        Terminals = await gsv.GetList_Terminal();
        ListUser = await asv.GetList_User_handle() ?? new List<string>();
        usr = asv.GetAuth().Result.User.Identity!.Name!;
        Cuss_Carr = await lcsv.GetList_Customer_line();
        // await Refresh();
    }



    bool _loading = false;
    async Task Refresh()
    {
        try
        {
            await Bgnhsv.UpdateTrangThai_HetHieuLuc_Nangha();
            detail = null!;
            _loading = true;
            Listdata.Clear();

            await Task.Delay(500);
            if (!await ssv.CheckPermission(usr, "View", "BieuGiaNangHa"))
            {
                CallSnackBar("You have not access to view", MudBlazor.Severity.Warning);
                return;
            }
            Listdata = await Bgnhsv.GetList_BieuGiaNangHa();
            StateHasChanged();
            if (Listdata.Count == 0)
            {
                CallSnackBar("No Data", MudBlazor.Severity.Warning);
                _loading = false;
                return;
            }
        }
        catch(Exception ex)
        {
            CallSnackBar("Something went wrong!, error code: " + ex.Message, MudBlazor.Severity.Warning);
        }
        finally
        {
            _loading = false;
        }

    }

    void CallSnackBar(string message, MudBlazor.Severity severity)
    {

        Snackbar.Configuration.SnackbarVariant = Variant.Filled;
        Snackbar.Configuration.MaxDisplayedSnackbars = 3;
        Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopRight;
        Snackbar.Add(message, severity);
    }
    void RowClicked(DataGridRowClickEventArgs<M_Bieugianangha> args)
    {
        detail = args.Item;
    }
    private int selectedRowNumber = -1;
    private string SelectedRowClassFunc(M_Bieugianangha m, int rowNumber)
    {
        if (selectedRowNumber == rowNumber)
        {
            selectedRowNumber = -1;
            return string.Empty;
        }
        else if (mudTable.SelectedItem != null && mudTable.SelectedItem.Equals(m))
        {
            selectedRowNumber = rowNumber;
            return "selected";
        }
        else
        {
            return string.Empty;
        }
    }

    async Task CommittedItem(M_Bieugianangha item)
    {
        item.Userupdate = asv.GetAuth().Result.User.Identity!.Name!;
        item.Dateupdate = DateTime.Now.ToString("dd/MMM/yyyy");
        var rs = item.BieuGiaNangHaID != Guid.Empty ? await Bgnhsv.UpdateBieuGiaNangHa_Detail(item) : await Bgnhsv.CreateBieuGiaNangHa_Detail(item);
        CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);

        await Refresh();
    }
    int? index_no;

    async Task DeleteItem(M_Bieugianangha item)
    {
        if (item.Approve == true)
        {
            CallSnackBar("Biểu giá đã được Approve!!! , vui lòng bỏ Approve", MudBlazor.Severity.Warning);
            return;
        }
        if (!await ssv.CheckPermission(usr, "Delete", "BieuGiaNangHa"))
        {
            CallSnackBar("You have not access to Delete", MudBlazor.Severity.Warning);
            return;
        }
        var resultMess = await DialogService.ShowMessageBox(
                "Warning",
                "Deleting can not be undone!",
                yesText: "Delete!", cancelText: "Cancel");

        if (resultMess.HasValue)
        {
            var rs = await Bgnhsv.DeleteBieuGiaNangHa_Detail(item);
            CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
            await Refresh();
        }

    }
    DialogOptions options = new DialogOptions 
    {
        ClassBackground = "class-dialog-custom",
        FullWidth = true,
        MaxWidth = MaxWidth.Medium,
        CloseOnEscapeKey = false,
        DisableBackdropClick = true
    };
    string search;

    private bool FilterFunc1(M_Bieugianangha sbd) => FilterFunc(sbd, search);

    private bool FilterFunc(M_Bieugianangha sbd, string searchString)
    {
        if (string.IsNullOrWhiteSpace(sbd.BieugiananghaNo))
            return true;
        if (string.IsNullOrWhiteSpace(searchString))
            return true;
        if (sbd.BieugiananghaNo!.Contains(searchString, StringComparison.OrdinalIgnoreCase))
            return true;
        if ($"{sbd.BieugiananghaNo} ".Contains(searchString))
            return true;
        return false;
    }

    private Func<M_Bieugianangha, string> _cellStyleFunc => x =>
       {
           string style = "";

           if (string.IsNullOrEmpty(x.TrangThai))
               return "color: #000000";

           var rs = M_Trangthais
           .Where(t => (t.Noidung).Contains(x.TrangThai, StringComparison.InvariantCultureIgnoreCase)
               && t.Tieude.Equals("BieuGiaNangHa", StringComparison.InvariantCultureIgnoreCase))
           .Select(t => t.Mamau)
           .FirstOrDefault();
           return "color: " + rs;


       };

    private async Task OpenCreateDialog(Models.M_Bieugianangha tr)
    {
        var optionsdialog = new DialogOptions { ClassBackground = "class-dialog-custom", FullWidth = true, MaxWidth = MaxWidth.Medium };

        if (await ssv.CheckPermission(asv.GetAuth().Result.User.Identity.Name, "Add", "BieuGiaNangHa"))
        {

            DialogOptions closeOnEscapeKey = new DialogOptions() { CloseOnEscapeKey = true };
            var parameters = new DialogParameters<ADD> { { x => x._BieuGiaNangHa_Detail, tr }, { x => x.Status, "add" } };

            var dialog = await DialogService.ShowAsync<ADD>(tr.BieuGiaNangHaID == Guid.Empty ? "Lifting and Lowering Price List Create" : "Lifting and Lowering Price List Edit", parameters, optionsdialog);
            var result = await dialog.Result;
            if (!result.Canceled)
            {
                var data = (M_Bieugianangha)result.Data;
                var rs = await Bgnhsv.UpdateCreateBieuGiaNangHa(data);
                await HistoryLogService.LogAsync(usr, "ADD Bieu Gia Nang Ha", "BieuGiaNangHa", data.BieuGiaNangHaID, data.BieugiananghaNo, data);
                MudBlazor.Severity severity;
                if (rs[1] == "1")
                    severity = MudBlazor.Severity.Success;
                else
                    severity = MudBlazor.Severity.Error;

                CallSnackBar(rs[0], severity);

                await HandleRefresh_create(data.BieuGiaNangHaID);

            }

            return;

        }
        else
        {
            CallSnackBar("You have not access to Create", MudBlazor.Severity.Warning);
            return;
        }

    }

    async Task HandleRefresh_create(Guid? id)
    {
        try
        {

            detail = null;

            Listdata.Clear();

            await Task.Delay(500);

            if (!await ssv.CheckPermission(asv.GetAuth().Result.User.Identity.Name, "View", "BieuGiaNangHa"))
            {
                CallSnackBar("You have not access to view", MudBlazor.Severity.Warning);

                return;
            }
            Listdata = await Bgnhsv.GetListBieuGiaNangHa_create(id);
            StateHasChanged();
        }
        finally
        {


        }
    }

    private async Task OpenEditDialog(Models.M_Bieugianangha tr)
    {
        var optionsdialog = new DialogOptions { ClassBackground = "class-dialog-custom", FullWidth = true, MaxWidth = MaxWidth.Medium };
        if (tr == null)
        {
            CallSnackBar("Please select Data", MudBlazor.Severity.Warning);
            return;
        }
   
        if (await ssv.CheckPermission(asv.GetAuth().Result.User.Identity.Name, "Edit", "BieuGiaNangHa"))
        {
            if (tr.Approve == true)
            {
                CallSnackBar("Biểu giá đã được Approve!!! , vui lòng bỏ Approve", MudBlazor.Severity.Warning);
                return;
            }
            else
            {
                var OldData = JsonSerializer.Deserialize<M_Bieugianangha>(JsonSerializer.Serialize(tr));
                DialogOptions closeOnEscapeKey = new DialogOptions() { CloseOnEscapeKey = true };
                var parameters = new DialogParameters<ADD> { { x => x._BieuGiaNangHa_Detail, tr }, { x => x.Status, "edit" } };

                var dialog = await DialogService.ShowAsync<ADD>(tr.BieuGiaNangHaID == Guid.Empty ? "Lifting and Lowering Price List Edit" : "Lifting and Lowering Price List Edit", parameters, optionsdialog);
                var result = await dialog.Result;
                // Giữ nguyên dòng được chọn
                selectedRowNumber = selectedRowNumber;
                StateHasChanged();

                if (!result.Canceled)
                {
                    var data = (M_Bieugianangha)result.Data;
                    var rs = await Bgnhsv.UpdateCreateBieuGiaNangHa(data);

                    await HistoryLogService.LogAsync(usr, "Update Bieu Gia Nang Ha", "BieuGiaNangHa", data.BieuGiaNangHaID, data.BieugiananghaNo, new { OldData = OldData, NewData = data });


                    MudBlazor.Severity severity;
                    if (rs[1] == "1")
                        severity = MudBlazor.Severity.Success;
                    else
                        severity = MudBlazor.Severity.Error;

                    CallSnackBar(rs[0], severity);
                }

                return;
            }


        }
        else
        {
            CallSnackBar("You have not access to Edit", MudBlazor.Severity.Warning);
            return;
        }

    }

    private async Task OpenDuplicateDialog(Models.M_Bieugianangha tr)
    {
        var optionsdialog = new DialogOptions { ClassBackground = "class-dialog-custom", FullWidth = true, MaxWidth = MaxWidth.Medium };
        if (tr == null)
        {
            CallSnackBar("Please select Data", MudBlazor.Severity.Warning);
            return;
        }

        if (await ssv.CheckPermission(asv.GetAuth().Result.User.Identity.Name, "Add", "BieuGiaNangHa"))
        {
          
            var OldData = JsonSerializer.Deserialize<M_Bieugianangha>(JsonSerializer.Serialize(tr));
                DialogOptions closeOnEscapeKey = new DialogOptions() { CloseOnEscapeKey = true };
                var parameters = new DialogParameters<ADD> { { x => x._BieuGiaNangHa_Detail, tr }, { x => x.Status, "Duplicate" } };

                var dialog = await DialogService.ShowAsync<ADD>(tr.BieuGiaNangHaID == Guid.Empty ? "Lifting and Lowering Price List Create" : "Lifting and Lowering Price List Create", parameters, optionsdialog);
                var result = await dialog.Result;
                // Giữ nguyên dòng được chọn
                selectedRowNumber = selectedRowNumber;
                StateHasChanged();

                if (!result.Canceled)
                {
                    var data = (M_Bieugianangha)result.Data;
                    var rs = await Bgnhsv.UpdateCreateBieuGiaNangHa(data);
                await HistoryLogService.LogAsync(usr, "Duplicate Bieu Gia Nang Ha", "BieuGiaNangHa", data.BieuGiaNangHaID, data.BieugiananghaNo, new { OldData = OldData, NewData = data });
             

                    MudBlazor.Severity severity;
                    if (rs[1] == "1")
                        severity = MudBlazor.Severity.Success;
                    else
                        severity = MudBlazor.Severity.Error;

                    CallSnackBar(rs[0], severity);
                }

                return;
          

        }
        else
        {
            CallSnackBar("You have not access to Create", MudBlazor.Severity.Warning);
            return;
        }

    }

    private async Task<IEnumerable<string>> searchTerminal(string text)
    {
        try
        {
            if (string.IsNullOrWhiteSpace(text))
            {
                return Terminals.Where(x => !string.IsNullOrEmpty(x.TermiNalName))
               .Select(x => x.TermiNalName);
            }
            // MBL.Porname = mst_Consignee;
            return Terminals.Where(x => !string.IsNullOrEmpty(x.TermiNalName) &&
                            x.TermiNalName.Contains(text, StringComparison.OrdinalIgnoreCase))
               .Select(x => x.TermiNalName);
        }
        catch (Exception)
        {
            throw;
        }
    }

    private async Task GetT_BieugiananghaNo(M_Bieugianangha item)
    {

        int formattedYear = DateTime.Now.Year;
        int formattedMonth = DateTime.Now.Month;

        string usr = asv.GetAuth().Result.User.Identity!.Name!;
        var refno = await supsv.GetRefNoByFunc("BGNH", formattedMonth, formattedYear, usr);

        var rs = asv.GetUserDetail();
        var cn = rs.Branch;
        item.BieugiananghaNo = cn + "BGNH_" + formattedYear.ToString() + formattedMonth.ToString() + refno.Value.ToString("D4");

    }

    private async Task OnApproveCheckboxWrapper(M_Bieugianangha item)
    {
        if (await ssv.CheckPermission(asv.GetAuth().Result.User.Identity.Name, "Approve", "BieuGiaNangHa"))
        {
            var rs = await Bgnhsv.UpdateCreateBieuGiaNangHa(item);
        }
        else
        {
            CallSnackBar("You have not access to Approve", MudBlazor.Severity.Warning);
            return;
        }
    }

}
