@using System.Globalization
@inject ISnackbar Snackbar
@inject AccountService asv
@inject TrainScheduleServices trainsv
@inject IStringLocalizer<SharedResource> Localizer
@inject SharedServices ssv
@inject LocalChargesServices lcsv
@inject SupportServices supsv
@inject LenhDieuXeServices ldxsv
@inject TKHQ_Services tkhqsv
@inject GlobalServices gsv
@inject Bieugianangha_Services Bgnhsv
@inject IJSRuntime JSRuntime



<MudDialog>
    <DialogContent>
        <MudContainer Class="pa-3">
            <MudCard Elevation="0" Class="pa-2">
                <MudForm Model="@_BieuGiaNangHa_Detail" @ref="@form">
                    <MudCardContent Class="pa-3">
                        <MudGrid Spacing="1">
                            <MudItem xs="12">
                                <MudGrid Spacing="1">
                                    <MudItem xs="12" sm="1">
                                        <MudButton Style="background-color: #007BFF; color: white;" Size="Size.Small" Color="Color.Primary"
                                            Disabled="@(Status == "edit")"
                                            OnClick="() => Get_BGNHNo()">>>></MudButton>
                                    </MudItem>
                                    <MudItem xs="12" sm="5">
                                        <MudTextField @bind-Value="_BieuGiaNangHa_Detail.BieugiananghaNo" Disabled="true" Label="@Localizer["sotokhai"]"
                                            Class="custom-label" Margin="Margin.Dense" Required="true" />
                                    </MudItem>
                                </MudGrid>
                            </MudItem>
                            <MudItem xs="12">
                                <MudGrid Spacing="1">
                                    <MudItem xs="12" sm="6">
                                        <MudAutocomplete @bind-Value="_BieuGiaNangHa_Detail.CangICDDepot" Label="@Localizer["CangICDDepot"]"
                                            Class="custom-label" Margin="Margin.Dense" Required MaxItems="30"
                                            SearchFunc="SearchTerminal" OnBlur="OnTerminalBlur" />
                                    </MudItem>
                                    <MudItem xs="12" sm="6">
                                        <MudTextField @bind-Value="_BieuGiaNangHa_Detail.DiaChi" Label="@Localizer["Address"]"
                                            Class="custom-label" Margin="Margin.Dense" InputType="InputType.Text" />
                                    </MudItem>
                                    <MudItem xs="12" sm="6">
                                        <MudAutocomplete @bind-Value="_BieuGiaNangHa_Detail.LoaiContainer" Label="@Localizer["LoaiContainer"]"
                                            Class="custom-label" Margin="Margin.Dense" CoerceValue SearchFunc="SearcLoaiCont" />
                                    </MudItem>
                                    <MudItem xs="12" sm="6">
                                        <MudAutocomplete @bind-Value="_BieuGiaNangHa_Detail.LoaiHinhNangHa" Label="@Localizer["LoaiHinhNangHa"]"
                                            Class="custom-label" Margin="Margin.Dense" CoerceValue SearchFunc="SearcLoaiHinhnangha" />
                                    </MudItem>
                                    <MudItem xs="12" sm="6">
                                        <MudDatePicker Class="custom-label" @bind-Date="_BieuGiaNangHa_Detail.ThoiGianApDung"
                                            For="@(() => _BieuGiaNangHa_Detail.ThoiGianApDung)"
                                            Label="@Localizer["ThoiGianApDung"]"
                                            Margin="Margin.Dense"
                                            DateFormat="dd/MM/yyyy"
                                            Required="true" />
                                    </MudItem>
                                    <MudItem xs="12" sm="6">
                                        <MudSelect @bind-Value="_BieuGiaNangHa_Detail.Loaitiente" Label="@Localizer["Loaitiente"]"
                                            Class="custom-label" Margin="Margin.Dense">
                                            <MudSelectItem Value="@("VND")">VND</MudSelectItem>
                                            <MudSelectItem Value="@("USD")">USD</MudSelectItem>
                                        </MudSelect>
                                    </MudItem>
                                </MudGrid>
                            </MudItem>
                            <MudItem xs="12">
                                <MudGrid Spacing="1">
                                    <MudItem xs="12" sm="6">
                                        <MudCard Elevation="0" Class="pa-2">
                                            <MudCardContent Class="pa-2">
                                                <MudGrid Spacing="1">
                                                    <MudItem xs="12">
                                                        <MudSelect @bind-Value="_BieuGiaNangHa_Detail.TrangThai" Label="@Localizer["status"]" Class="custom-label" Margin="Margin.Dense">
                                                            @foreach (var item in trangthais)
                                                            {
                                                                <MudSelectItem Value="@item">@item</MudSelectItem>
                                                            }
                                                        </MudSelect>
                                                    </MudItem>
                                                    <MudItem xs="12"><MudNumericField @bind-Value="_BieuGiaNangHa_Detail.NangLenPhuongTien" Label="@Localizer["NangLenPhuongTien"]" Format="#,##0.##" Culture="@_en" T="double?" HideSpinButtons="true" Margin="Margin.Dense" Class="text-right custom-label" /></MudItem>
                                                    <MudItem xs="12"><MudNumericField @bind-Value="_BieuGiaNangHa_Detail.HaXuongBai" Label="@Localizer["HaXuongBai"]" Format="#,##0.##" Culture="@_en" T="double?" HideSpinButtons="true" Margin="Margin.Dense" Class="text-right custom-label" /></MudItem>
                                                    <MudItem xs="12"><MudNumericField @bind-Value="_BieuGiaNangHa_Detail.NangHaNoiBo" Label="@Localizer["NangHaNoiBo"]" Format="#,##0.##" Culture="@_en" T="double?" HideSpinButtons="true" Margin="Margin.Dense" Class="text-right custom-label" /></MudItem>
                                                    <MudItem xs="12"><MudNumericField @bind-Value="_BieuGiaNangHa_Detail.NangHaRong" Label="@Localizer["Nangharong"]" Format="#,##0.##" Culture="@_en" T="double?" HideSpinButtons="true" Margin="Margin.Dense" Class="text-right custom-label" /></MudItem>
                                                    <MudItem xs="12"><MudNumericField @bind-Value="_BieuGiaNangHa_Detail.NangHaHang" Label="@Localizer["NangHaHang"]" Format="#,##0.##" Culture="@_en" T="double?" HideSpinButtons="true" Margin="Margin.Dense" Class="text-right custom-label" /></MudItem>
                                                    <MudItem xs="12"><MudNumericField @bind-Value="_BieuGiaNangHa_Detail.NangHaKiemHoaSuaChuaVeSinh" Label="@Localizer["NangHaKiemHoaSuaChuaVeSinh"]" Format="#,##0.##" Culture="@_en" T="double?" HideSpinButtons="true" Margin="Margin.Dense" Class="text-right custom-label" /></MudItem>
                                                </MudGrid>
                                            </MudCardContent>
                                        </MudCard>
                                    </MudItem>
                                    <MudItem xs="12" sm="6">
                                        <MudCard Elevation="0" Class="pa-2">
                                            <MudCardContent Class="pa-2">
                                                <MudGrid Spacing="1">
                                                    <MudItem xs="12"><MudNumericField @bind-Value="_BieuGiaNangHa_Detail.NangHaKiemHoa" Label="@Localizer["NangHaKiemHoa"]" Format="#,##0.##" Culture="@_en" T="double?" HideSpinButtons="true" Margin="Margin.Dense" Class="text-right custom-label" /></MudItem>
                                                    <MudItem xs="12"><MudNumericField @bind-Value="_BieuGiaNangHa_Detail.NangHaSieuTruongSieuTrong" Label="@Localizer["NangHaSieuTruongSieuTrong"]" Format="#,##0.##" Culture="@_en" T="double?" HideSpinButtons="true" Margin="Margin.Dense" Class="text-right custom-label" /></MudItem>
                                                    <MudItem xs="12"><MudNumericField @bind-Value="_BieuGiaNangHa_Detail.NangHaNgoaiGioHanhChinh" Label="@Localizer["NangHaNgoaiGioHanhChinh"]" Format="#,##0.##" Culture="@_en" T="double?" HideSpinButtons="true" Margin="Margin.Dense" Class="text-right custom-label" /></MudItem>
                                                    <MudItem xs="12"><MudNumericField @bind-Value="_BieuGiaNangHa_Detail.NangHaKhuCachLy" Label="@Localizer["NangHaKhuCachLy"]" Format="#,##0.##" Culture="@_en" T="double?" HideSpinButtons="true" Margin="Margin.Dense" Class="text-right custom-label" /></MudItem>
                                                    <MudItem xs="12"><MudNumericField @bind-Value="_BieuGiaNangHa_Detail.PhuPhiHangNguyHiem" Label="@Localizer["PhuPhiHangNguyHiem"]" Format="#,##0.##" Culture="@_en" T="double?" HideSpinButtons="true" Margin="Margin.Dense" Class="text-right custom-label" /></MudItem>
                                                    <MudItem xs="12"><MudNumericField @bind-Value="_BieuGiaNangHa_Detail.PhuPhiNgoaiGio" Label="@Localizer["PhuPhiNgoaiGio"]" Format="#,##0.##" Culture="@_en" T="double?" HideSpinButtons="true" Margin="Margin.Dense" Class="text-right custom-label" /></MudItem>
                                                    <MudItem xs="12"><MudNumericField @bind-Value="_BieuGiaNangHa_Detail.PhuPhiDungThietBiDacBiet" Label="@Localizer["PhuPhiDungThietBiDacBiet"]" Format="#,##0.##" Culture="@_en" T="double?" HideSpinButtons="true" Margin="Margin.Dense" Class="text-right custom-label" /></MudItem>
                                                </MudGrid>
                                            </MudCardContent>
                                        </MudCard>
                                    </MudItem>
                                </MudGrid>
                            </MudItem>
                        </MudGrid>
                    </MudCardContent>
                </MudForm>
            </MudCard>
        </MudContainer>
    </DialogContent>
    <DialogActions>

        <MudButton OnClick="@(async () => await Submit())">Save</MudButton>
        <MudButton OnClick="Cancel">Cancel</MudButton>

    </DialogActions>
</MudDialog>



@code {
    [CascadingParameter] MudDialogInstance? MudDialog { get; set; }
    [Parameter] public Models.M_Bieugianangha _BieuGiaNangHa_Detail { get; set; }

    [Parameter] public string Status { get; set; }
    MudForm form;
    List<string> trangthais = new List<string>();
    private List<Models.TrangThai> M_Trangthais = new List<Models.TrangThai>();
    public CultureInfo _en = CultureInfo.GetCultureInfo("en-US");
    private List<Terminal_> Terminals = new List<Terminal_>();
    private List<Terminal_> Terminals_Address = new List<Terminal_>();
    List<M_Bieugianangha> BGNHs = new List<M_Bieugianangha>();
    string UserHanding;
    private List<string> ListUser { get; set; } = new List<string>();
    protected async override Task OnInitializedAsync()
    {

        if (Status == "Duplicate")
        {
            _BieuGiaNangHa_Detail.BieuGiaNangHaID = Guid.Empty;
            _BieuGiaNangHa_Detail.BieugiananghaNo = "";
            _BieuGiaNangHa_Detail.Approve = false;
        }
        M_Trangthais = await supsv.GetListTrangThai();
        var tts = await supsv.GetListTrangThai();
        trangthais = tts.Where(x => x.Tieude == "BieuGiaNangHa").OrderBy(x => x.Noidung).Select(x => x.Noidung).ToList();
        BGNHs = await Bgnhsv.GetList_BieuGiaNangHa();
        Terminals_Address = await gsv.GetList_Terminal_add();
        Terminals = await gsv.GetList_Terminal();
        ListUser = await asv.GetList_User_handle() ?? new List<string>();
      
    }
   
    private async Task Get_BGNHNo()
    {

        int formattedYear = DateTime.Now.Year;
        int formattedMonth = DateTime.Now.Month;

        string usr = asv.GetAuth().Result.User.Identity!.Name!;
        var refno = await supsv.GetRefNoByFunc("BGNH", formattedMonth, formattedYear, usr);

        var rs = asv.GetUserDetail();
        var cn = rs.Branch;
        _BieuGiaNangHa_Detail.BieugiananghaNo = cn + "BGNH_" + formattedYear.ToString() + formattedMonth.ToString() + refno.Value.ToString("D4");
    }

    private async Task Submit()
    {
        if ((await ssv.CheckPermission(asv.GetAuth().Result.User.Identity.Name, "Edit", "BieuGiaNangHa") || await ssv.CheckPermission(asv.GetAuth().Result.User.Identity.Name, "New", "BieuGiaNangHa")))
        {

            await form.Validate();

            if (form.IsValid)
            {

                var UserName = asv.GetAuth().Result.User.Identity!.Name!;
                _BieuGiaNangHa_Detail.Dateupdate = DateTime.Now.ToString("dd/MMM/yyyy");
                _BieuGiaNangHa_Detail.Userupdate = UserName;
                MudDialog!.Close(_BieuGiaNangHa_Detail);

            }
        }

    }
    void Cancel() => MudDialog.Cancel();

    void CallSnackBar(string message, MudBlazor.Severity severity)
    {
        
        Snackbar.Configuration.SnackbarVariant = Variant.Filled;
        Snackbar.Configuration.MaxDisplayedSnackbars = 3;
        Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopRight;
        Snackbar.Add(message, severity);
    }
  
    private void OnTerminalBlur(FocusEventArgs e)
    {
        var company = Terminals_Address.FirstOrDefault(x => x.TermiNalName == _BieuGiaNangHa_Detail.CangICDDepot);
        if (company != null)
        {
            _BieuGiaNangHa_Detail.DiaChi = company.Address;
        }
    }

    private async Task<IEnumerable<string>> SearchTerminal(string text)
    {
        try
        {
            if (string.IsNullOrWhiteSpace(text))
            {
                return Terminals.Where(x => !string.IsNullOrEmpty(x.TermiNalName))
               .Select(x => x.TermiNalName);
            }
            // MBL.Porname = mst_Consignee;
            return Terminals.Where(x => !string.IsNullOrEmpty(x.TermiNalName) &&
                            x.TermiNalName.Contains(text, StringComparison.OrdinalIgnoreCase))
               .Select(x => x.TermiNalName);
        }
        catch (Exception)
        {
            throw;
        }
    }


    private async Task<IEnumerable<string?>> SearcLoaiCont(string? text)
    {
        try
        {
            var items = BGNHs.Select(x => x.LoaiContainer).Distinct();
            if (string.IsNullOrEmpty(text))
            {
                return items;
            }
            // MBL.Porname = mst_Consignee;
            return items.Where(x => x != null && x.Equals(text));
        }
        catch (Exception)
        {
            throw;
        }
    }

    private async Task<IEnumerable<string?>> SearcLoaiHinhnangha(string? text)
    {
        try
        {
            var items = BGNHs.Select(x => x.LoaiHinhNangHa).Distinct();
            if (string.IsNullOrEmpty(text))
            {
                return items;
            }
            // MBL.Porname = mst_Consignee;
            return items.Where(x => x != null && x.Equals(text));
        }
        catch (Exception)
        {
            throw;
        }
    }
    }