@using System.Globalization
@inject ISnackbar Snackbar
@inject AccountService asv
@inject TrainScheduleServices trainsv
@inject IStringLocalizer<SharedResource> Localizer
@inject SharedServices ssv
@inject LocalChargesServices lcsv
@inject SupportServices supsv
@inject LenhDieuXeServices ldxsv
@inject TKHQ_Services tkhqsv
@inject GlobalServices gsv
@inject Bieugianangha_Services Bgnhsv
@inject BookingService bksv
@inject IJSRuntime JSRuntime
@inject QuotationService Quosv
@inject CustomerService Cussv
<style>
    .class-dialog-custom {
    backdrop-filter: blur(10px);
    transition: none !important;
    animation: none !important;
    }

    .selected {
    background: #855ff3 !important;
    }

    .selected > td {
    color: white !important;
    }

    .selected > td .mud-input {
    color: white !important;
    }

    .labelCustomColor label {
    font-weight: bold;
    color: #118AB2 !important;
    }

    .mud-table thead {
    background-color: #118AB2;
    }

    .mud-table th {
    background-color: #118AB2 !important;
    color: white !important;
    }

    .mud-table-foot tr {
    background-color: #118AB2 !important;
    }

    .footer-cell {
    background-color: #118AB2 !important;
    color: white !important;
    }

    .filter-header-cell {
    background-color: white !important;
    color: black !important;
    }

    .mud-menu {
    display: none;
    }

    .no-wrap {
    white-space: nowrap;
    }

    .custom-label .mud-input-label {
    color: blue !important;
    }

    .text-right input {
    text-align: right !important;
    }
</style>

<MudDialog>
    <DialogContent>
        <MudSpacer></MudSpacer>
        <MudContainer>

            <MudCard>
                <MudForm Model="@_RFQ_Detail" @ref="@form">
                    <MudCardContent>
                        <MudGrid>
                            <MudGrid>

                                <MudItem xs="2">
                                    <MudButton Style="background-color: #007BFF; color: white;" Size="Size.Small" Color="Color.Primary"
                                    Disabled="@(Status == "edit")"
                                    OnClick="() => Get_BGNHNo()">>>></MudButton>
                                </MudItem>

                                <MudItem xs="5">
                                    <MudTextField @bind-Value="_RFQ_Detail.RFQNo" Disabled="true" Label="@Localizer["RFQNo"]" Required="true" />
                                </MudItem>

                            </MudGrid>

                            <MudGrid>

                                <MudItem xs="6">
                                    <MudAutocomplete Class="custom-label" T="Guid?" Label="@Localizer["Customer"]" Required="true"
                                    @bind-Value="_RFQ_Detail.CustomerID"
                                    SearchFunc="Search_Customer"
                                    ToStringFunc="GetCustomerLable" />
                                </MudItem>

                               

                                <MudItem xs="6">

                                    <MudAutocomplete @bind-Value="_RFQ_Detail.ServiceType" Label="@Localizer["ServiceType"]" class="custom-label" CoerceValue SearchFunc="SearchType" />
                                
                                </MudItem>

                                <MudItem xs="6">
                                    <MudAutocomplete Class="labelCustomColor custom-label" T="string"
                                    @bind-Value="_RFQ_Detail.POL"
                                    Label="@Localizer["POL"]"
                                    SearchFunc="Search_Port"

                                    Immediate="true"
                                    CoerceText="true"
                                    Clearable="true"
                                    MaxItems="100">
                                    </MudAutocomplete>
                                </MudItem>


                                <MudItem xs="6">
                                    <MudAutocomplete Class="labelCustomColor custom-label" T="string"
                                    @bind-Value="_RFQ_Detail.POD"
                                    Label="@Localizer["POD"]"
                                    SearchFunc="Search_Port"
                                    Immediate="true"
                                    CoerceText="true"
                                    Clearable="true"
                                    MaxItems="100">
                                    </MudAutocomplete>
                                </MudItem>

                                <MudItem xs="6">
                                    <MudTextField @bind-Value="_RFQ_Detail.PickupAddress" Label="@Localizer["PickupAddress"]" Class="custom-label"  />
                                </MudItem>

                                <MudItem xs="6">
                                    <MudTextField @bind-Value="_RFQ_Detail.DeliveryAddress" Label="@Localizer["DeliveryAddress"]" Class="custom-label" />
                                </MudItem>

                                <MudItem xs="6">

                                    <MudAutocomplete @bind-Value="_RFQ_Detail.Incoterm" Label="@Localizer["Incoterm"]" class="custom-label" CoerceValue SearchFunc="SearchIncoterm" />
                                </MudItem>

                                <MudItem xs="6">
                                    <MudTextField @bind-Value="_RFQ_Detail.CargoDescription" Label="@Localizer["CargoDescription"]" Class="custom-label" />
                                </MudItem>


                                <MudItem xs="6">
                                    <MudCheckBox @bind-Value="_RFQ_Detail.IsDangerous" Label="@Localizer["IsDangerous"]" Class="custom-label" />
                                </MudItem>

                                <MudItem xs="6">
                                    <MudCheckBox @bind-Value="_RFQ_Detail.IsFragile" Label="@Localizer["IsFragile"]" Class="custom-label" />
                                </MudItem>

                                <MudItem xs="6">
                                    <MudCheckBox @bind-Value="_RFQ_Detail.IsTemperatureControlled" Label="@Localizer["IsTemperatureControlled"]" Class="custom-label" />
                                </MudItem>

                                <MudItem xs="6">
                                    <MudCheckBox @bind-Value="_RFQ_Detail.IsHighValue" Label="@Localizer["IsHighValue"]" Class="custom-label" />
                                </MudItem>

                                <MudItem xs="6">
                                    <MudTextField @bind-Value="_RFQ_Detail.HSCode" Label="@Localizer["HSCode"]" Class="custom-label" />
                                </MudItem>

                                <MudItem xs="6">
                                    <MudNumericField @bind-Value="_RFQ_Detail.PackageQuantity" Label="@Localizer["PackageQuantity"]" Format="#,##0.##" Culture="_en" Class="custom-label text-right" />
                                </MudItem>

                                <MudItem xs="6">
                                    <MudNumericField @bind-Value="_RFQ_Detail.TotalWeightKg" Label="@Localizer["TotalWeightKg"]" Format="#,##0.##" Culture="_en" Class="custom-label text-right" />
                                </MudItem>

                                <MudItem xs="6">
                                    <MudNumericField @bind-Value="_RFQ_Detail.TotalVolumeCBM" Label="@Localizer["TotalVolumeCBM"]" Format="#,##0.##" Culture="_en" Class="custom-label text-right" />
                                </MudItem>

                                <MudItem xs="6">
                                    <MudTextField @bind-Value="_RFQ_Detail.PackageDimensions" Label="@Localizer["PackageDimensions"]" Class="custom-label" />
                                </MudItem>


                                <MudItem xs="6">

                                    <MudAutocomplete @bind-Value="_RFQ_Detail.ContainerType" Label="@Localizer["loaicont"]" class="custom-label" CoerceValue SearchFunc="Searchcont" />
                                </MudItem>

                                <MudItem xs="6">

                                    <MudDatePicker Class="custom-label" @bind-Date="_RFQ_Detail.ReadyDate"
                                    For="@(() => _RFQ_Detail.ReadyDate)"
                                    Label="@Localizer["ReadyDate"]"
                                    DateFormat="dd/MM/yyyy"
                                    Required="true" />
                                </MudItem>

                                <MudItem xs="6">

                                    <MudDatePicker Class="custom-label" @bind-Date="_RFQ_Detail.RequestedShipDate"
                                    For="@(() => _RFQ_Detail.RequestedShipDate)"
                                    Label="@Localizer["RequestedShipDate"]"
                                    DateFormat="dd/MM/yyyy"
                                    Required="true" />
                                </MudItem>
                                <MudItem xs="6">
                                    <MudCheckBox @bind-Value="_RFQ_Detail.NeedInlandTransport" Label="@Localizer["NeedInlandTransport"]" Class="custom-label" />
                                </MudItem>


                                <MudItem xs="6">
                                    <MudCheckBox @bind-Value="_RFQ_Detail.NeedCustomsClearance" Label="@Localizer["NeedCustomsClearance"]" Class="custom-label" />
                                </MudItem>

                                <MudItem xs="6">
                                    <MudCheckBox @bind-Value="_RFQ_Detail.NeedPacking" Label="@Localizer["NeedPacking"]" Class="custom-label" />
                                </MudItem>

                                <MudItem xs="6">
                                    <MudCheckBox @bind-Value="_RFQ_Detail.NeedWarehousing" Label="@Localizer["NeedWarehousing"]" Class="custom-label" />
                                </MudItem>

                                <MudItem xs="6">
                                    <MudCheckBox @bind-Value="_RFQ_Detail.NeedLabeling" Label="@Localizer["NeedLabeling"]" Class="custom-label" />
                                </MudItem>

                                <MudItem xs="6">
                                    <MudCheckBox @bind-Value="_RFQ_Detail.NeedAMSOrISF" Label="@Localizer["NeedAMSOrISF"]" Class="custom-label" />
                                </MudItem>

                                <MudItem xs="6">
                                    <MudTextField @bind-Value="_RFQ_Detail.SpecialNote" Label="@Localizer["SpecialNote"]" Class="custom-label" />
                                </MudItem>

                                <MudItem xs="6">
                                    <MudTextField @bind-Value="_RFQ_Detail_link.AttachmentLink"
                                                  Label="@Localizer["AttachmentLink"]"
                                                  Placeholder="Nhập link và nhấn Enter"
                                                  Class="custom-label"
                                                  Immediate="true"
                                                  OnKeyDown="@HandleKeyDown" />

                                    @if (!string.IsNullOrWhiteSpace(_RFQ_Detail_link.AllLinks))
                                    {
                                        var links = _RFQ_Detail_link.AllLinks.Split(';', StringSplitOptions.RemoveEmptyEntries);

                                        foreach (var link in links)
                                        {
                                            <div style="display: flex; align-items: center; margin-top: 4px;">
                                                <MudLink Href="@link.Trim()" Target="_blank"
                                                         Style="text-decoration: underline; cursor: pointer; flex: 1;">
                                                    @link
                                                </MudLink>
                                                <MudIconButton Icon="@Icons.Material.Filled.Close"
                                                               Size="Size.Small"
                                                               Color="Color.Error"
                                                               OnClick="@(() => RemoveLink(link.Trim()))" />
                                            </div>
                                        }
                                    }
                                </MudItem>





                                <MudItem xs="6">
                                    <MudSelect @bind-Value="_RFQ_Detail.RFQStatus" Label="@Localizer["status"]" class="custom-label">
                                        @foreach (var item in trangthais)
                                        {
                                            <MudSelectItem Value="item">@item</MudSelectItem>
                                        }
                                    </MudSelect>
                                </MudItem>

                                <MudItem xs="6">
                                    <MudAutocomplete Class=" labelCustomColor custom-label" T="string"
                                    @bind-Value="_RFQ_Detail.SalesPerson"
                                    Label="@Localizer["SaleName"]"
                                    SearchFunc="Search_User"
                                    Immediate="true"
                                    CoerceText="true"
                                    Clearable="true"
                                    MaxItems="100">
                                    </MudAutocomplete>
                                </MudItem>
                                <MudItem xs="6">

                                    <MudDatePicker Class="custom-label" @bind-Date="_RFQ_Detail.QuoteDeadline"
                                    For="@(() => _RFQ_Detail.QuoteDeadline)"
                                    Label="@Localizer["QuoteDeadline"]"
                                    DateFormat="dd/MM/yyyy"
                                    Required="true" />
                                </MudItem>

                                <MudItem xs="6">


                                    <MudDatePicker Class="custom-label" @bind-Date="_RFQ_Detail.FollowUpDate"
                                    For="@(() => _RFQ_Detail.FollowUpDate)"
                                    Label="@Localizer["FollowUpDate"]"
                                    DateFormat="dd/MM/yyyy"
                                    Required="true" />
                                </MudItem>
                                <MudItem xs="6">
                                    <MudTextField @bind-Value="_RFQ_Detail.filesPath" Label="@Localizer["filesPath"]" Class="custom-label" />
                                </MudItem>


                                <MudItem xs="6">


                                    <MudDatePicker Class="custom-label" @bind-Date="_RFQ_Detail.CreatedAt"
                                    For="@(() => _RFQ_Detail.CreatedAt)"
                                    Label="@Localizer["CreatedAt"]"
                                    DateFormat="dd/MM/yyyy"
                                    Required="true" />
                                </MudItem>
                                <MudItem xs="6">


                                    <MudDatePicker Class="custom-label" @bind-Date="_RFQ_Detail.UpdatedAt"
                                    For="@(() => _RFQ_Detail.UpdatedAt)"
                                    Label="@Localizer["UpdatedAt"]"
                                    DateFormat="dd/MM/yyyy"
                                    Required="true" />
                                </MudItem>

                                <MudItem xs="12">
                                    <MudStack Row>
                                        <MudFileUpload T="IBrowserFile"
                                        Accept=".pdf,.doc,.docx,.xls,.xlsx"
                                        FilesChanged="@((t) => AttachFileToFTP(t, _RFQ_Detail))">
                                            <ButtonTemplate Context="context1">
                                                <MudIconButton HtmlTag="label" for="@context1"
                                                Size="Size.Small"
                                                Color="Color.Secondary"
                                                Icon="@Icons.Material.Filled.AttachFile" />
                                            </ButtonTemplate>
                                        </MudFileUpload>

                                        <MudContainer Class="pa-4; max-height:200px; overflow-y: auto;">
                                            <MudText Typo="Typo.h6">Files</MudText>

                                            @foreach (var item in Linksplit(_RFQ_Detail.filesPath!))
                                            {
                                                var fileName = Path.GetFileName(item);
                                                var fileUrl = item.Replace("ftp", "http");
                                                var fileExtension = Path.GetExtension(fileName).ToLower();

                                                <MudPaper Elevation="3" Class="d-flex align-items-center justify-between ma-2 pa-2">
                                                    <MudIcon Icon="@GetFileIcon(fileExtension)" Size="Size.Medium" />
                                                    <MudText Class="mx-2" Style="flex-grow: 1;">@fileName</MudText>

                                                    <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                                                    OnClick="@(() => SeeDetail(fileUrl))"
                                                    Color="Color.Primary" />

                                                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                    OnClick="@(() => DeleteFiles(_RFQ_Detail, item))"
                                                    Color="Color.Error" />
                                                </MudPaper>
                                            }
                                        </MudContainer>

                                    </MudStack>
                                </MudItem>
                            </MudGrid>


                        </MudGrid>

                    </MudCardContent>
                </MudForm>

            </MudCard>
        </MudContainer>
    </DialogContent>
    <DialogActions>

        <MudButton OnClick="@(async () => await Submit())">Save</MudButton>
        <MudButton OnClick="Cancel">Cancel</MudButton>

    </DialogActions>
</MudDialog>



@code {
    [CascadingParameter] MudDialogInstance? MudDialog { get; set; }
    [Parameter] public Models.M_RFQ _RFQ_Detail { get; set; }

    [Parameter] public string Status { get; set; }
    MudForm form;
    List<string> trangthais = new List<string>();
    private List<Models.TrangThai> M_Trangthais = new List<Models.TrangThai>();
    public CultureInfo _en = CultureInfo.GetCultureInfo("en-US");
    private List<Terminal_> Terminals = new List<Terminal_>();
    private List<Terminal_> Terminals_Address = new List<Terminal_>();
    private List<M_Customer> Customers = new List<M_Customer>();
    List<M_RFQ> RFQs = new List<M_RFQ>();
    string UserHanding;
    private List<string> ListUser { get; set; } = new List<string>();
    private List<PortModel> List_port = new List<PortModel>();

    List<string> List_Incoterm = new List<string>
    {
        "EXW-Giao hàng tại xưởng-người mua chịu toàn bộ chi phí và rủi ro",
        "FOB-Giao lên tàu-người bán chịu chi phí đến cảng xuất khẩu",
        "CIF-Người bán chịu chi phí + bảo hiểm đến cảng nhập khẩu",
        "DDP-Giao đã nộp thuế-người bán lo chi phí đến tận nơi mua",
        "FCA-Giao cho người vận chuyển chị định",
        "CPT-Cước phí trả tới nơi-người bán trả cước vận chuyển"
    };

    List<string> List_Type = new List<string>
    {
        "FCL",
        "LCL",
        "AIR Air Freight",
        "EXPRESS",
        "TRUCK",
        "WAREHOUSE",
        "CUSTOMS",
        "DOOR",
        "PROJECT",
        "OTHERS"
    };

    protected async override Task OnInitializedAsync()
    {
        if (Status == "Duplicate")
        {
            _RFQ_Detail.RFQNo = "";
            _RFQ_Detail.Approve = false;
        }
        _RFQ_Detail_link.AllLinks = _RFQ_Detail.AttachmentLink;
        List_port = await bksv.GetList_PORT();
        M_Trangthais = await supsv.GetListTrangThai();
        var tts = await supsv.GetListTrangThai();
        trangthais = tts.Where(x => x.Tieude == "RFQ").OrderBy(x => x.Noidung).Select(x => x.Noidung).ToList();
        Customers = await Cussv.GetList();
        Terminals_Address = await gsv.GetList_Terminal_add();
        Terminals = await gsv.GetList_Terminal();
        ListUser = await asv.GetList_User_handle() ?? new List<string>();
        RFQs = await Quosv.GetList_RFQ();
    }

    private List<string> IncotermOptions = new() { "EXW-Giao hàng tại xưởng-người mua chịu toàn bộ chi phí và rủi ro", "FOB-Giao lên tàu-người bán chịu chi phí đến cảng xuất khẩu", "CIF-Người bán chịu chi phí + bảo hiểm đến cảng nhập khẩu", "DDP-Giao đã nộp thuế-người bán lo chi phí đến tận nơi mua", "FCA-Giao cho người vận chuyển chị định", "CPT-Cước phí trả tới nơi-người bán trả cước vận chuyển" };

    private Task<IEnumerable<string>> SearchIncoterms(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return Task.FromResult(IncotermOptions.AsEnumerable());

        return Task.FromResult(
            IncotermOptions
                .Where(x => x.Contains(value, StringComparison.OrdinalIgnoreCase))
                .AsEnumerable()
        );
    }

    void RemoveLink(string linkToRemove)
    {
        var links = _RFQ_Detail_link.AllLinks.Split(';', StringSplitOptions.RemoveEmptyEntries)
                     .Where(link => !string.Equals(link.Trim(), linkToRemove, StringComparison.OrdinalIgnoreCase))
                     .ToList();

        _RFQ_Detail_link.AllLinks = string.Join(';', links);
    }

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(_RFQ_Detail_link.AttachmentLink))
        {
            var linkToAdd = _RFQ_Detail_link.AttachmentLink.Trim();

            if (!string.IsNullOrEmpty(_RFQ_Detail_link.AllLinks))
            {
                _RFQ_Detail_link.AllLinks += ";" + linkToAdd;
            }
            else
            {
                _RFQ_Detail_link.AllLinks = linkToAdd;
            }

            _RFQ_Detail_link.AttachmentLink = ""; 
        }
    }

    private class RFQ_DetailModel
    {
        public string AttachmentLink { get; set; } 
        public string AllLinks { get; set; }
    }

    private RFQ_DetailModel _RFQ_Detail_link = new(); // nếu chưa có

    private async Task Get_BGNHNo()
    {

        int formattedYear = DateTime.Now.Year;
        int formattedMonth = DateTime.Now.Month;

        string usr = asv.GetAuth().Result.User.Identity!.Name!;
        var refno = await supsv.GetRefNoByFunc("RFQ", formattedMonth, formattedYear, usr);

        var rs = asv.GetUserDetail();
        var cn = rs.Branch;
        _RFQ_Detail.RFQNo = cn + "RFQ_" + formattedYear.ToString() + formattedMonth.ToString() + refno.Value.ToString("D4");
    }

    private async Task Submit()
    {
        if ((await ssv.CheckPermission(asv.GetAuth().Result.User.Identity.Name, "Edit", "RFQ") || await ssv.CheckPermission(asv.GetAuth().Result.User.Identity.Name, "New", "RFQ")))
        {

            await form.Validate();

            if (form.IsValid)
            {
                if (Status == "Duplicate")
                {
                    _RFQ_Detail.RFQ_ID = Guid.Empty;
                   
                }
                _RFQ_Detail.AttachmentLink = _RFQ_Detail_link.AllLinks;
                var UserName = asv.GetAuth().Result.User.Identity!.Name!;
                _RFQ_Detail.dateupdate = DateTime.Now.ToString("dd/MMM/yyyy");
                _RFQ_Detail.UserUpdate = UserName;
                MudDialog!.Close(_RFQ_Detail);

            }
        }

    }
    void Cancel() => MudDialog.Cancel();

    void CallSnackBar(string message, MudBlazor.Severity severity)
    {
        
        Snackbar.Configuration.SnackbarVariant = Variant.Filled;
        Snackbar.Configuration.MaxDisplayedSnackbars = 3;
        Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopRight;
        Snackbar.Add(message, severity);
    }
  
    private async Task<IEnumerable<Guid?>> Search_Customer(string value)
    {
        if (string.IsNullOrEmpty(value))
            return Customers.Select(x => (Guid?)x.Customer_ID);

        return Customers
        .Where(x => !string.IsNullOrEmpty(x.COMPANY) && x.COMPANY.Contains(value, StringComparison.InvariantCultureIgnoreCase))
        .Select(x => (Guid?)x.Customer_ID)  // Convert Customer_ID to Guid?
        .ToList();


    }

    private string GetCustomerLable(Guid? id)
    {
        var customer = Customers.FirstOrDefault(x => x.Customer_ID == id);
        return customer != null ? customer.COMPANY : string.Empty;
    }

   

    private async Task<IEnumerable<string>> Search_Port(string value)
    {
        if (string.IsNullOrEmpty(value))
            return List_port
                .Select(x => x.PORT + "_" + x.PORT_CODE)
                .Distinct()
                .OrderBy(x => x);

        return List_port
            .Where(x => (x.PORT + "_" + x.PORT_CODE).Contains(value, StringComparison.InvariantCultureIgnoreCase))
            .Select(x => x.PORT + "_" + x.PORT_CODE)
            .Distinct()
            .OrderBy(x => x);
    }

    List<string> Linksplit(string links)
    {
        if (string.IsNullOrEmpty(links))
            return new List<string>();
        return links.Split(';').ToList();
    }

    private string GetFileIcon(string extension)
    {
        return extension switch
        {
            ".pdf" => Icons.Material.Filled.PictureAsPdf,
            ".doc" or ".docx" => Icons.Material.Filled.Description,
            ".xls" or ".xlsx" => Icons.Material.Filled.TableChart,
            _ => Icons.Material.Filled.InsertDriveFile
        };
    }

    async Task SeeDetail(string fileUrl)
    {
        
        await JSRuntime.InvokeVoidAsync("open", fileUrl, "_blank");

    }
    async Task DeleteFiles(M_RFQ item, string link)
    {
        try
        {
            if (item.filesPath!.Contains(";"))
                link = link + ";";
            item.filesPath = item.filesPath!.Replace(link, string.Empty);

            StateHasChanged();
        }
        catch (Exception ex)
        {
            CallSnackBar("Throw exception code: " + ex.Message, MudBlazor.Severity.Error);
        }
    }
    async Task AttachFileToFTP(IBrowserFile file, M_RFQ item)
    {
        try
        {
            var rs = await ssv.UploadfiletoFTP_RFQ(file, (object)item);
            CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
        }
        catch (Exception ex)
        {
            CallSnackBar("Throw exception code: " + ex.Message, MudBlazor.Severity.Error);
        }
    }

    private async Task<IEnumerable<string>> Search_User(string value)
    {
        if (string.IsNullOrEmpty(value))
            return ListUser;

        return ListUser.Where(x => x.Contains(value, StringComparison.InvariantCultureIgnoreCase));
    }

    private async Task<IEnumerable<string?>> Searchcont(string? text)
    {
        try
        {
            var items = RFQs.Select(x => x.ContainerType).Distinct();
            if (string.IsNullOrEmpty(text))
            {
                return items;
            }
            // MBL.Porname = mst_Consignee;
            return items.Where(x => x != null && x.Equals(text));
        }
        catch (Exception)
        {
            throw;
        }
    }

    private async Task<IEnumerable<string?>> SearchIncoterm(string? text)
    {
        try
        {
            var items = List_Incoterm.Distinct();
            if (string.IsNullOrWhiteSpace(text))
            {
                return items;
            }

            return items.Where(x => x != null && x.Contains(text, StringComparison.OrdinalIgnoreCase));
        }
        catch (Exception)
        {
            throw;
        }
    }

    private async Task<IEnumerable<string?>> SearchType(string? text)
    {
        try
        {
            var items = List_Type.Distinct();
            if (string.IsNullOrWhiteSpace(text))
            {
                return items;
            }

            return items.Where(x => x != null && x.Contains(text, StringComparison.OrdinalIgnoreCase));
        }
        catch (Exception)
        {
            throw;
        }
    }

    
}
