<PageTitle>@Localizer["RFQ"] </PageTitle>
<MudText Class="pa-2" Typo="Typo.h6">@Localizer["RFQ"]</MudText>
<MudStack Row Justify="Justify.FlexStart" Class="pa-4">
    <MudButton HtmlTag="label"
               OnClick="Refresh"
               Size="Size.Small" Color="Color.Primary" Variant="   Variant.Filled"
               StartIcon="@Icons.Material.Filled.Refresh">
        @Localizer["reload"]
    </MudButton>
    <MudButton HtmlTag="label"
               @onclick="@((e) => OpenCreateDialog(new Models.M_RFQ()))"
               Size="Size.Small" Color="Color.Secondary" Variant="Variant.Filled"
               StartIcon="@Icons.Material.Filled.Add">
        @Localizer["new"]
    </MudButton>

    <MudButton HtmlTag="label"
               @onclick="@((e) => OpenCreateDialog_Adddetail(detail))"
               Size="Size.Small" Color="Color.Secondary" Variant="Variant.Filled"
               StartIcon="@Icons.Material.Filled.Add">
        @Localizer["ADD_Detail"]
    </MudButton>

    <MudButton HtmlTag="label"
               @onclick="@((e) => OpenEditDialog(detail))"
               Size="Size.Small" Color="Color.Info" Variant="Variant.Filled"
               StartIcon="@Icons.Material.Filled.Edit">
        @Localizer["edit"]
    </MudButton>

    <MudButton HtmlTag="label"
               @onclick="@((e) => OpenDuplicateDialog(detail))"
               Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled"
               StartIcon="@Icons.Material.Filled.CopyAll">
        @Localizer["duplicate"]
    </MudButton>

</MudStack>

<MudDataGrid T="M_RFQ" Items="@Listdata" Filterable="true" @ref="mudTable" Class="pa-4" Bordered="true"
             FilterMode="@DataGridFilterMode.ColumnFilterRow" Dense="true" Virtualize="true" QuickFilter="@FilterFunc1"
             FixedHeader="true" FixedFooter="true" HeaderClass="no-wrap" FooterClass="no-wrap"
             ReadOnly="false" CommittedItemChanges="@CommittedItem" RowClassFunc="@SelectedRowClassFunc"
             RowClick="@RowClicked" EditDialogOptions="@options"
             ColumnResizeMode="@(_resizeColumn ? ResizeMode.Column : ResizeMode.Container)" Loading="_loading">
    <Columns>
        <HierarchyColumn T="M_RFQ" />
        <TemplateColumn CellClass="d-flex justify-end">
            <CellTemplate>

                <MudIconButton Icon="@Icons.Material.Outlined.Delete" OnClick="@(()=>DeleteItem(context.Item))" />
            </CellTemplate>
        </TemplateColumn>

        <PropertyColumn Property="x=>x.RFQNo" Title="@Localizer["RFQNo"]" Required="false" CellStyleFunc="_cellStyleFunc">
        </PropertyColumn>

        <PropertyColumn Property="x => CustomerName(x.CustomerID)" Title="@Localizer["Customer"]" CellStyleFunc="_cellStyleFunc">
            <EditTemplate>
                <MudSelect @bind-Value="context.Item.CustomerID" Label="@Localizer["Customer"]">
                    @foreach (var item in List_Cus)
                    {
                        <MudSelectItem Value="@item.Customer_ID">@item.COMPANY</MudSelectItem>
                    }
                </MudSelect>
            </EditTemplate>
        </PropertyColumn>

        <PropertyColumn Property="x=>x.ServiceType" Title="@Localizer["ServiceType"]" Required="false" CellStyleFunc="_cellStyleFunc">
        </PropertyColumn>

        <PropertyColumn Property="x=>x.POL" Title="@Localizer["POL"]" Required="false" CellStyleFunc="_cellStyleFunc">
        </PropertyColumn>

        <PropertyColumn Property="x=>x.POD" Title="@Localizer["POD"]" Required="false" CellStyleFunc="_cellStyleFunc">
        </PropertyColumn>

        <PropertyColumn Property="x=>x.PickupAddress" Title="@Localizer["PickupAddress"]" Required="false" CellStyleFunc="_cellStyleFunc">
        </PropertyColumn>

        <PropertyColumn Property="x=>x.DeliveryAddress" Title="@Localizer["DeliveryAddress"]" Required="false" CellStyleFunc="_cellStyleFunc">
        </PropertyColumn>

        <PropertyColumn Property="x=>x.Incoterm" Title="@Localizer["Incoterm"]" Required="false" CellStyleFunc="_cellStyleFunc">
        </PropertyColumn>


        <PropertyColumn Property="x=>x.CargoDescription" Title="@Localizer["CargoDescription"]" Required="false" CellStyleFunc="_cellStyleFunc">
        </PropertyColumn>


        <PropertyColumn Property="x=>x.HSCode" Title="@Localizer["HSCode"]" Required="false" CellStyleFunc="_cellStyleFunc">
        </PropertyColumn>



        <PropertyColumn Property="x=>x.PackageQuantity" Title="@Localizer["PackageQuantity"]" Format="#,##0.##" CellClass="custom-right-align" Culture="_en" Required="false" CellStyleFunc="_cellStyleFunc">
        </PropertyColumn>

        <PropertyColumn Property="x=>x.TotalWeightKg" Title="@Localizer["TotalWeightKg"]" Format="#,##0.##" CellClass="custom-right-align" Culture="_en" Required="false" CellStyleFunc="_cellStyleFunc">
        </PropertyColumn>

        <PropertyColumn Property="x=>x.TotalVolumeCBM" Title="@Localizer["TotalVolumeCBM"]" Format="#,##0.##" CellClass="custom-right-align" Culture="_en" Required="false" CellStyleFunc="_cellStyleFunc">
        </PropertyColumn>

        <PropertyColumn Property="x=>x.PackageDimensions" Title="@Localizer["PackageDimensions"]" CellClass="custom-right-align" Required="false" CellStyleFunc="_cellStyleFunc">
        </PropertyColumn>

        <PropertyColumn Property="x=>x.ContainerType" Title="@Localizer["loaicont"]" Required="false" CellStyleFunc="_cellStyleFunc">
        </PropertyColumn>


        <PropertyColumn Property="x=>x.ReadyDate" Title="@Localizer["ReadyDate"]" Required="false" Format="dd/MMM/yyyy" CellStyleFunc="_cellStyleFunc">
        </PropertyColumn>

        <PropertyColumn Property="x=>x.RequestedShipDate" Title="@Localizer["RequestedShipDate"]" Required="false"  Format="dd/MMM/yyyy"  CellStyleFunc="_cellStyleFunc">
        </PropertyColumn>

        <PropertyColumn Property="x=>x.SpecialNote" Title="@Localizer["SpecialNote"]" Required="false" CellStyleFunc="_cellStyleFunc">
        </PropertyColumn>

        <PropertyColumn Property="x=>x.AttachmentLink" Title="@Localizer["AttachmentLink"]" Required="false" CellStyleFunc="_cellStyleFunc">
        </PropertyColumn>

        <PropertyColumn Property="x=>x.RFQStatus" Title="@Localizer["status"]" Required="false" CellStyleFunc="_cellStyleFunc">
        </PropertyColumn>

        <PropertyColumn Property="x=>x.SalesPerson" Title="@Localizer["SaleName"]" Required="false" CellStyleFunc="_cellStyleFunc">
        </PropertyColumn>

        <PropertyColumn Property="x=>x.QuoteDeadline" Title="@Localizer["QuoteDeadline"]"  Format="dd/MMM/yyyy" Required="false" CellStyleFunc="_cellStyleFunc">
        </PropertyColumn>

        <PropertyColumn Property="x=>x.FollowUpDate" Title="@Localizer["FollowUpDate"]" Format="dd/MMM/yyyy" Required="false" CellStyleFunc="_cellStyleFunc">
        </PropertyColumn>

        <PropertyColumn Property="x=>x.filesPath" Title="@Localizer["filesPath"]" Required="false" CellStyleFunc="_cellStyleFunc">
        </PropertyColumn>

        <PropertyColumn Property="x=>x.CreatedAt" Title="@Localizer["CreatedAt"]" Format="dd/MMM/yyyy" Required="false" CellStyleFunc="_cellStyleFunc">
        </PropertyColumn>

        <PropertyColumn Property="x=>x.UpdatedAt" Title="@Localizer["UpdatedAt"]" Format="dd/MMM/yyyy" Required="false" CellStyleFunc="_cellStyleFunc">
        </PropertyColumn>

        <TemplateColumn Title="@Localizer["Approve"]">
            <CellTemplate>
                <MudCheckBox @bind-Checked="context.Item.Approve" @bind-Value="context.Item.Approve" @bind-Value:after="@(()=> OnApproveCheckboxWrapper(context.Item))">
                </MudCheckBox>
            </CellTemplate>
        </TemplateColumn>

        <PropertyColumn Property="x=>x.Continued" Title="@Localizer["Continued"]" CellStyleFunc="_cellStyleFunc">
        </PropertyColumn>

        <PropertyColumn Property="x=>x.UserUpdate" Title="@Localizer["UserUpdate"]"  Required="false" CellStyleFunc="_cellStyleFunc">
        </PropertyColumn>


    </Columns>

    <ChildRowContent>
        <MudTabs>
            <MudTabPanel Text="@Localizer["RFQ_log"]">
                <ADD_Detail__showindex _RFQ_LogDetail="context.Item" />
            </MudTabPanel>
        </MudTabs>
    </ChildRowContent>

    <PagerContent>
        <MudDataGridPager T="Models.M_RFQ" PageSizeOptions="@(new int[] { 8, 10, 20 })" />
    </PagerContent>
</MudDataGrid>

@code {
    List<M_RFQ> Listdata = new List<M_RFQ>();
    MudDataGrid<M_RFQ> mudTable;
    AuthUser user;
    string mailtp, mailpp;
    string usr;
    private List<string> ListUser { get; set; } = new List<string>();
    string UserHanding;
    List<string> trangthais = new List<string>();
    private List<Models.TrangThai> M_Trangthais = new List<Models.TrangThai>();
    private string searchText_pol = "";
    private string searchText_pod = "";
    private List<PortModel> filteredPorts = new List<PortModel>();
    private List<PortModel> filteredPorts_pod = new List<PortModel>();
    private List<PortModel> Ports = new List<PortModel>();
    private bool _resizeColumn;
    M_RFQ detail;
    private List<M_Customer> List_Cus = new List<M_Customer>();
    private List<M_Customer> filteredCarr = new List<M_Customer>();
    private List<M_Customer> Cuss_Carr = new List<M_Customer>();
    private List<Terminal_> Terminals = new List<Terminal_>();

    public CultureInfo _en = CultureInfo.GetCultureInfo("en-US");
    private bool _canApprove = false;

    private async Task OnApproveChanged(bool isChecked, M_RFQ item)
    {
        bool canApprove = await ssv.CheckPermission(usr, "Approve", "RFQ");

        if (!canApprove)
        {
            CallSnackBar("Bạn không có quyền để duyệt!", MudBlazor.Severity.Error);
        }
        else
        {
            // Nếu có quyền, thực hiện cập nhật
            item.Approve = isChecked;
            var rs = await QuoSv.UpdateCreateRFQ(item);

        }
    }

    protected async override Task OnInitializedAsync()
    {
        await QuoSv.UpdateTrangThai_HetHieuLuc_RFQ();
        List_Cus = await Cussv.GetList();
        M_Trangthais = await supsv.GetListTrangThai();
        var tts = await supsv.GetListTrangThai();
        trangthais = tts.Where(x => x.Tieude == "RFQ").OrderBy(x => x.Noidung).Select(x => x.Noidung).ToList();
        Terminals = await gsv.GetList_Terminal();
        ListUser = await asv.GetList_User_handle() ?? new List<string>();
        usr = asv.GetAuth().Result.User.Identity!.Name!;
        Cuss_Carr = await lcsv.GetList_Customer_line();
        // await Refresh();
    }



    bool _loading = false;
    async Task Refresh()
    {
        try
        {
            await QuoSv.UpdateTrangThai_HetHieuLuc_RFQ();
            detail = null!;
            _loading = true;
            Listdata.Clear();

            await Task.Delay(500);
            if (!await ssv.CheckPermission(usr, "View", "RFQ"))
            {
                CallSnackBar("You have not access to view", MudBlazor.Severity.Warning);
                return;
            }
            Listdata = await QuoSv.GetList_RFQ();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            CallSnackBar("Something went wrong!, error code: " + ex.Message, MudBlazor.Severity.Warning);
        }
        finally
        {
            _loading = false;
        }

    }

    void CallSnackBar(string message, MudBlazor.Severity severity)
    {

        Snackbar.Configuration.SnackbarVariant = Variant.Filled;
        Snackbar.Configuration.MaxDisplayedSnackbars = 3;
        Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopRight;
        Snackbar.Add(message, severity);
    }
    void RowClicked(DataGridRowClickEventArgs<M_RFQ> args)
    {
        detail = args.Item;
    }
    private int selectedRowNumber = -1;
    private string SelectedRowClassFunc(M_RFQ m, int rowNumber)
    {
        if (selectedRowNumber == rowNumber)
        {
            selectedRowNumber = -1;
            return string.Empty;
        }
        else if (mudTable.SelectedItem != null && mudTable.SelectedItem.Equals(m))
        {
            selectedRowNumber = rowNumber;
            return "selected";
        }
        else
        {
            return string.Empty;
        }
    }

    async Task CommittedItem(M_RFQ item)
    {
        item.UserUpdate = asv.GetAuth().Result.User.Identity!.Name!;
        item.dateupdate = DateTime.Now.ToString("dd/MMM/yyyy");
        var rs = item.RFQ_ID != Guid.Empty ? await QuoSv.UpdateRFQ_Detail(item) : await QuoSv.CreateRFQ_Detail(item);
        CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);

        await Refresh();
    }
    int? index_no;

    async Task DeleteItem(M_RFQ item)
    {
        if (item.Approve == true)
        {
            CallSnackBar("Data đã được Approve!!! , vui lòng bỏ Approve", MudBlazor.Severity.Warning);
            return;
        }
        if (!await ssv.CheckPermission(usr, "Delete", "RFQ"))
        {
            CallSnackBar("You have not access to Delete", MudBlazor.Severity.Warning);
            return;
        }
        var resultMess = await DialogService.ShowMessageBox(
                "Warning",
                "Deleting can not be undone!",
                yesText: "Delete!", cancelText: "Cancel");

        if (resultMess.HasValue)
        {
            var rs = await QuoSv.DeleteRFQ_Detail(item);
            await QuoSv.DeleteRFQ_Log_By_RFQid(item.RFQ_ID);
            await HistoryLogService.LogAsync(usr, "Delete", "RFQ", item.RFQ_ID, item.RFQNo, new { OldData = item });
            CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
            await Refresh();
        }

    }
    DialogOptions options = new DialogOptions
        {
            ClassBackground = "class-dialog-custom",
            FullWidth = true,
            MaxWidth = MaxWidth.Medium,
            CloseOnEscapeKey = false,
            DisableBackdropClick = true
        };
    string search;

    private bool FilterFunc1(M_RFQ sbd) => FilterFunc(sbd, search);

    private bool FilterFunc(M_RFQ sbd, string searchString)
    {
        if (string.IsNullOrWhiteSpace(sbd.RFQNo))
            return true;
        if (string.IsNullOrWhiteSpace(searchString))
            return true;
        if (sbd.RFQNo!.Contains(searchString, StringComparison.OrdinalIgnoreCase))
            return true;
        if ($"{sbd.RFQNo} ".Contains(searchString))
            return true;
        return false;
    }
    private Func<M_RFQ, string> _cellStyleFunc => x =>
    {
        string style = "";

        if (string.IsNullOrEmpty(x.RFQStatus))
            return "color: #000000";

        var rs = M_Trangthais
        .Where(t => (t.Noidung).Contains(x.RFQStatus, StringComparison.InvariantCultureIgnoreCase)
            && t.Tieude.Equals("RFQ", StringComparison.InvariantCultureIgnoreCase))
        .Select(t => t.Mamau)
        .FirstOrDefault();
        return "color: " + rs;

    };

    private async Task OpenCreateDialog(Models.M_RFQ tr)
    {
        var optionsdialog = new DialogOptions { ClassBackground = "class-dialog-custom", FullWidth = true, MaxWidth = MaxWidth.Medium };

        if (await ssv.CheckPermission(asv.GetAuth().Result.User.Identity.Name, "Add", "RFQ"))
        {

            DialogOptions closeOnEscapeKey = new DialogOptions() { CloseOnEscapeKey = true };
            var parameters = new DialogParameters<ADD> { { x => x._RFQ_Detail, tr }, { x => x.Status, "add" } };

            var dialog = await DialogService.ShowAsync<ADD>(tr.RFQ_ID == Guid.Empty ? "Request For Quotation Create" : "Request For Quotation Edit", parameters, optionsdialog);
            var result = await dialog.Result;
            if (!result.Canceled)
            {
                var data = (M_RFQ)result.Data;
                data.Approve = false;
                data.Continued = true;
                var rs = await QuoSv.UpdateCreateRFQ(data);

                await HistoryLogService.LogAsync(usr, "ADD", "RFQ", data.RFQ_ID, data.RFQNo, data);

                MudBlazor.Severity severity;
                if (rs[1] == "1")
                    severity = MudBlazor.Severity.Success;
                else
                    severity = MudBlazor.Severity.Error;

                CallSnackBar(rs[0], severity);

                await HandleRefresh_create(data.RFQ_ID);

            }

            return;

        }
        else
        {
            CallSnackBar("You have not access to Create", MudBlazor.Severity.Warning);
            return;
        }

    }


