@using NVOAMASIS.Models

<MudPaper Class="pa-3 mb-3" Elevation="0" Outlined="true">
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="flex-wrap mb-2" Spacing="2">
        <div>
            <MudText Typo="Typo.subtitle1" Class="fw-bold">File đã import</MudText>
            <MudText Typo="Typo.caption" Color="Color.Secondary">
                Mỗi lần import lưu tên file + ngày. Chọn file cần xóa — chỉ xóa đúng lô đó.
            </MudText>
        </div>
        <MudStack Row="true" Spacing="1" Class="flex-wrap">
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Refresh"
                       OnClick="RefreshAsync"
                       Disabled="Busy">
                Tải lại
            </MudButton>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Error"
                       StartIcon="@Icons.Material.Filled.Delete"
                       OnClick="DeleteSelectedAsync"
                       Disabled="@(Busy || _selected.Count == 0)">
                Xóa file đã chọn (@_selected.Count)
            </MudButton>
        </MudStack>
    </MudStack>

    @if (Batches.Count == 0)
    {
        <MudAlert Severity="MudBlazor.Severity.Info" Variant="Variant.Outlined" Dense="true">
            Chưa có file nào được lưu (cần tên file trên từng dòng import).
        </MudAlert>
    }
    else
    {
        <MudDataGrid T="ImportedFileBatch"
                     Items="Batches"
                     Dense="true"
                     Hover="true"
                     Striped="true"
                     MultiSelection="true"
                     SelectedItems="_selected"
                     SelectedItemsChanged="OnSelectedChanged"
                     RowsPerPage="10"
                     Class="mt-1">
            <Columns>
                <SelectColumn T="ImportedFileBatch" />
                <PropertyColumn Property="x => x.FileName" Title="Tên file" />
                <PropertyColumn Property="x => x.ImportDate" Title="Ngày import" Format="dd/MM/yyyy" />
                <PropertyColumn Property="x => x.RowCount" Title="Số dòng" />
                <PropertyColumn Property="x => x.UserImport" Title="Người import" />
            </Columns>
            <PagerContent>
                <MudDataGridPager T="ImportedFileBatch" PageSizeOptions="new[] { 10, 25, 50 }" />
            </PagerContent>
        </MudDataGrid>
    }
</MudPaper>

@code {
    [Parameter] public IReadOnlyList<ImportedFileBatch> Batches { get; set; } = Array.Empty<ImportedFileBatch>();
    [Parameter] public bool Busy { get; set; }
    [Parameter] public EventCallback OnRefresh { get; set; }
    [Parameter] public EventCallback<IReadOnlyList<ImportedFileBatch>> OnDeleteSelected { get; set; }

    private HashSet<ImportedFileBatch> _selected = new();

    protected override void OnParametersSet()
    {
        if (_selected.Count == 0)
            return;

        _selected = Batches.Where(x => _selected.Contains(x)).ToHashSet();
    }

    private Task OnSelectedChanged(HashSet<ImportedFileBatch> selected)
    {
        _selected = selected ?? new HashSet<ImportedFileBatch>();
        return Task.CompletedTask;
    }

    private Task RefreshAsync() => OnRefresh.InvokeAsync();

    private async Task DeleteSelectedAsync()
    {
        if (_selected.Count == 0)
            return;

        await OnDeleteSelected.InvokeAsync(_selected.ToList());
        _selected.Clear();
    }
}
