@* Ô "Thanh toán / Hạch toán" trên lưới HBL / MBL / Job: chuỗi ngắn + tooltip ghi chú chi tiết. *@
@if (Loading)
{
    <span style="color:#94a3b8">…</span>
}
else if (string.IsNullOrEmpty(Text) || Text == "-")
{
    <span style="color:#94a3b8">-</span>
}
else
{
    <MudTooltip Placement="Placement.Left" Arrow="true">
        <ChildContent>
            <span style="display:inline-block; white-space:nowrap; font-size:12px; padding:1px 8px; border-radius:10px; cursor:help; @(Text!.StartsWith("✔") ? "background:#dcfce7; color:#166534;" : "background:#fef3c7; color:#92400e;")">@Text</span>
        </ChildContent>
        <TooltipContent>
            <div style="white-space:pre-wrap; text-align:left; max-width:560px; font-size:12px">@Note</div>
        </TooltipContent>
    </MudTooltip>
}

@code {
    [Parameter] public string? Text { get; set; }
    [Parameter] public string? Note { get; set; }
    [Parameter] public bool Loading { get; set; }
}
