    private async Task<IEnumerable<string>> SearchTk(string value)
    {
        if (string.IsNullOrEmpty(value))
            return List_Acc;

        return List_Acc.Where(x => x.Contains(value, StringComparison.InvariantCultureIgnoreCase));
    }

    private Task<IEnumerable<string>> SearchMBL(string value)
    {
        var items = MBLs
            .Select(x => x.Mbl)
            .Where(x => !string.IsNullOrEmpty(x))
            .Distinct();

        if (string.IsNullOrWhiteSpace(value))
            return Task.FromResult(items);

        var result = items.Where(x => x.Contains(value, StringComparison.OrdinalIgnoreCase));
        return Task.FromResult(result);
    }

    private async Task GetTigia(M_PhieuThu item)
    {
        double? tigia_ = await Vcbsv.Getexchange_cur(item.Currency);
        item.Tigia = tigia_;
    }

    private async Task get_info_Dntt(M_PhieuThu item)
    {
        var dntt_info = await shipmentsv.GetHBL_byHBLid(selectedjob.Id);
        if (dntt_info != null)
        {
            item.Customer_Id = selectedjob.cus_id;
            var debit_info = await shipmentsv.GetListDebitHBL_cus(dntt_info.hblID, selectedjob.cus_id);
            double? total_amount = 0;
            foreach (var item_debit in debit_info)
            {
                total_amount += item_debit.thanhtien;
            }
            var debit_frist = debit_info.FirstOrDefault(); // lấy 1 bản ghi đầu tiên
            if (debit_info != null)
            {

                item.Sotien = total_amount;
                item.Currency = debit_frist.tiente;
                item.Tigia = debit_frist.tigiadebit;

            }

        }
    }

    private async Task<IEnumerable<string>> SearchCurr(string? text)
    {
        if (string.IsNullOrWhiteSpace(text))
            return currs;

        return currs.Where(x => !string.IsNullOrEmpty(x) && x.Contains(text, StringComparison.OrdinalIgnoreCase));
    }

