    private async Task<IEnumerable<JobDisplay>> SearchDNTT(string text)
    {
        var results = Jobs
            .Where(x => x.Continued != false)
            .Select(x => new JobDisplay { Id = x.JobID, DisplayText = x.JobNo })
            .ToList();

        // ✅ Lọc theo DisplayText sau khi đã build xong
        if (!string.IsNullOrWhiteSpace(text))
        {
            results = results
                .Where(x => x.DisplayText != null &&
                            x.DisplayText.Contains(text, StringComparison.OrdinalIgnoreCase))
                .ToList();
        }

        return results;
    }

    private async Task OnJobChanged() => await LoadDebitsForSelectedJobAsync();

    private async Task LoadDebitsForSelectedJobAsync()
    {
        receiptDebits = new();
        selectedDebits = new();
        if (selectedjob is null || selectedjob.Id == Guid.Empty)
            return;

        receiptDebits = await Thuchisv.GetReceiptDebitsByJobAsync(
            selectedjob.Id,
            _Phieuthu_Detail.PhieuthuID == Guid.Empty ? null : _Phieuthu_Detail.PhieuthuID);

        if (_Phieuthu_Detail.PhieuthuID != Guid.Empty)
        {
            var existingIds = (await Thuchisv.GetReceiptDebitsAsync(_Phieuthu_Detail.PhieuthuID))
                .Select(x => x.debitId).ToHashSet();
            selectedDebits = receiptDebits.Where(x => existingIds.Contains(x.debitId)).ToHashSet();
        }
        ApplySelectedDebitTotals();
    }

    private async Task LoadExistingDebitSelectionAsync()
    {
        var existing = await Thuchisv.GetReceiptDebitsAsync(_Phieuthu_Detail.PhieuthuID);
        var first = existing.FirstOrDefault();
        if (first is null)
            return;

        var hbl = HBLs.FirstOrDefault(x => x.hblID == first.hblid);
        var jobId = hbl?.Jobid;
        if ((!jobId.HasValue || jobId == Guid.Empty) && hbl is not null)
            jobId = (await shipmentsv.GetMBL_byHBLid(hbl.mblid))?.Jobid;
        if (!jobId.HasValue || jobId == Guid.Empty)
            return;

        var job = Jobs.FirstOrDefault(x => x.JobID == jobId.Value);
        selectedjob = new JobDisplay { Id = jobId.Value, DisplayText = job?.JobNo ?? jobId.ToString() };
        await LoadDebitsForSelectedJobAsync();
    }

    private void OnSelectedDebitsChanged(HashSet<M_Debit> items)
    {
        selectedDebits = items;
        ApplySelectedDebitTotals();
        if (!ValidateSelectedDebitRates())
            CallSnackBar("Các phí đang chọn không cùng tiền tệ hoặc tỷ giá. Vui lòng chọn lại.", MudBlazor.Severity.Warning);
    }

    // Giá trị tự sinh lần trước — chỉ ghi đè khi ô đang trống hoặc vẫn là giá trị tự sinh (không đè nội dung người dùng tự gõ)
    string? _autoNoidung, _autoBillNo, _autoSohoadon;

    private void ApplySelectedDebitTotals()
    {
        _Phieuthu_Detail.Sotien = selectedDebits.Sum(x => x.thanhtien ?? 0);
        ApplyBillAndInvoiceInfo();
        var first = selectedDebits.FirstOrDefault();
        if (first is null)
            return;

        _Phieuthu_Detail.Currency = first.tiente;
        _Phieuthu_Detail.Tigia = first.tigiadebit;
        var customerIds = selectedDebits.Select(x => x.customerid).Distinct().ToList();
        if (customerIds.Count == 1)
            _Phieuthu_Detail.Customer_Id = customerIds[0];
    }

    private void ApplyBillAndInvoiceInfo()
    {
        var billNos = string.Join(", ", selectedDebits
            .Select(x => GetHblNo(x.hblid))
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Distinct());
        var invoiceNos = string.Join(", ", selectedDebits
            .Select(x => x.sohoadondaura?.Trim())
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Distinct());

        var noidung = "THU TIEN";
        if (billNos.Length > 0) noidung += " BILL " + billNos;
        if (invoiceNos.Length > 0) noidung += " HD " + invoiceNos;

        if (CanOverwrite(_Phieuthu_Detail.Noidung, _autoNoidung, "THU TIEN"))
            _Phieuthu_Detail.Noidung = _autoNoidung = noidung;
        if (CanOverwrite(_Phieuthu_Detail.BillNo, _autoBillNo))
            _Phieuthu_Detail.BillNo = _autoBillNo = billNos;
        if (CanOverwrite(_Phieuthu_Detail.Sohoadon, _autoSohoadon))
            _Phieuthu_Detail.Sohoadon = _autoSohoadon = invoiceNos;
    }

    private static bool CanOverwrite(string? current, string? lastAuto, string? placeholder = null) =>
        string.IsNullOrWhiteSpace(current)
        || current == lastAuto
        || (placeholder != null && current.Trim().TrimEnd('.').Equals(placeholder, StringComparison.OrdinalIgnoreCase));

    private bool ValidateSelectedDebitRates()
    {
        return selectedDebits.Count == 0
            || (selectedDebits.Select(x => x.tiente ?? string.Empty).Distinct(StringComparer.OrdinalIgnoreCase).Count() == 1
                && selectedDebits.Select(x => x.tigiadebit ?? 0).Distinct().Count() == 1);
    }

    private List<ChargeModel> charges = new();

    private string GetDebitFeeName(M_Debit d)
    {
        var chargeName = charges.FirstOrDefault(x => x.CHARGE_ID == d.itemid)?.CHARGE;
        var note = FirstNonEmptyText(d.ghichu_debit, d.ghichu);
        if (string.IsNullOrWhiteSpace(chargeName)) return note;
        if (string.IsNullOrWhiteSpace(note) || note == chargeName) return chargeName;
        return $"{chargeName} - {note}";
    }

    private static string FirstNonEmptyText(params string?[] v) => v.FirstOrDefault(x => !string.IsNullOrWhiteSpace(x)) ?? string.Empty;

    private string GetHblNo(Guid hblId) => HBLs.FirstOrDefault(x => x.hblID == hblId)?.hbl ?? string.Empty;

    async Task<string> DnttidtosoDntt(Guid PTid)
    {
        if (PTid == null || PTid == Guid.Empty)
            return string.Empty;
        var rs = HBLs.FirstOrDefault(x => x.hblID == PTid);
        if (rs == null)
        {
            return null;
        }
        var rs_mbl = await shipmentsv.GetMBL_byHBLid(rs.mblid);
        if (rs_mbl == null)
        {
            return null;
        }

        var rs_job = await shipmentsv.GetJob_byid(rs_mbl.Jobid);
        string jobno = rs_job.JobNo;
        return jobno;
    }

