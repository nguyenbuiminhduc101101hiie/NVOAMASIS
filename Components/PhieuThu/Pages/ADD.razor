<MudDialog>
    <DialogContent>
        <MudSpacer></MudSpacer>
        <MudContainer>

            <MudCard>
                <MudForm Model="@_Phieuthu_Detail" @ref="@form">
                    <MudCardContent>

                        <MudTabs>
                            <MudTabPanel Text="Receipt Info">
                                <MudGrid Spacing="1" Class="receipt-compact">

                                    <!-- Voucher Information -->
                                    <MudItem xs="12">
                                        <MudText Typo="Typo.subtitle2" Class="section-title">Voucher Information</MudText>
                                    </MudItem>

                                    <MudItem xs="2">
                                        <MudButton Style="background-color: #007BFF; color: white;" Size="Size.Small" Color="Color.Primary"
                                                   Disabled="@(Status == "edit")"
                                                   Class="receipt-action-button"
                                                   OnClick="() => Get_PhieuthuNo()">Auto No.</MudButton>
                                    </MudItem>

                                    <MudItem xs="4">
                                        <MudTextField @bind-Value="_Phieuthu_Detail.SoPhieuthu"
                                                      Disabled="true"
                                                      Label="@Localizer["SoPhieuthu"]"
                                                      Required="true"
                                                      Class="custom-label" />
                                    </MudItem>

                                    <MudItem xs="4">
                                        <MudAutocomplete T="JobDisplay"
                                                         @bind-Value="selectedjob"
                                                         @bind-Value:after="OnJobChanged"
                                                         Label="@Localizer["search_job"]"
                                                         SearchFunc="SearchDNTT"
                                                         ToStringFunc="@(x => x?.DisplayText ?? string.Empty)"
                                                         MaxItems="10"
                                                         Clearable
                                                         Class="custom-label" />
                                    </MudItem>

                                    <MudItem xs="12">
                                        <MudText Typo="Typo.subtitle2" Class="section-title">Các phí Debit của HBL trong Job</MudText>
                                        @if (selectedjob is null)
                                        {
                                            <MudAlert Severity="MudBlazor.Severity.Info" Dense="true">Chọn Job để tải danh sách phí Debit.</MudAlert>
                                        }
                                        else
                                        {
                                            <MudDataGrid T="M_Debit" Items="receiptDebits" Dense="true" Hover="true" MultiSelection="true"
                                                         ReadOnly="true" SelectedItems="selectedDebits" SelectedItemsChanged="OnSelectedDebitsChanged">
                                                <Columns>
                                                    <TemplateColumn Title="@Localizer["Thu hộ"]">
                                                        <CellTemplate><MudCheckBox T="bool" Value="@(context.Item.thuho == true)" ReadOnly="true" Disabled="true" Size="Size.Small" /></CellTemplate>
                                                    </TemplateColumn>
                                                    <SelectColumn T="M_Debit" />
                                                    <PropertyColumn Property="x => x.debitno" Title="Debit No." />
                                                    <TemplateColumn Title="HBL"><CellTemplate>@GetHblNo(context.Item.hblid)</CellTemplate></TemplateColumn>
                                                    <TemplateColumn Title="Tên/Ghi chú phí"><CellTemplate>@GetDebitFeeName(context.Item)</CellTemplate></TemplateColumn>
                                                    <PropertyColumn Property="x => x.thanhtien" Title="Thành tiền" Format="N2" CellStyle="text-align:right"/>
                                                    <PropertyColumn Property="x => x.tiente" Title="Tiền tệ" />
                                                    <PropertyColumn Property="x => x.tigiadebit" Title="Tỷ giá" Format="N2" CellStyle="text-align:right"/>
                                                </Columns>
                                            </MudDataGrid>
                                            <MudText Typo="Typo.caption">Đã chọn @selectedDebits.Count / @receiptDebits.Count phí.</MudText>
                                        }
                                    </MudItem>

                                    <MudItem xs="2">
                                        <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small"
                                                   Class="receipt-action-button"
                                                   OnClick="@(() => get_info_Dntt(_Phieuthu_Detail))">
                                            Get Job Info
                                        </MudButton>
                                    </MudItem>

                                    <MudItem xs="6">
                                        <MudDatePicker Class="custom-label" @bind-Date="_Phieuthu_Detail.Ngay"
                                                       For="@(() => _Phieuthu_Detail.Ngay)"
                                                       Label="@Localizer["NGAY"]"
                                                       DateFormat="dd/MM/yyyy"
                                                       Required="true" />
                                    </MudItem>

                                    <MudItem xs="6">
                                        <MudDatePicker Class="custom-label" @bind-Date="_Phieuthu_Detail.Ngayhachtoan"
                                                       For="@(() => _Phieuthu_Detail.Ngayhachtoan)"
                                                       Label="@Localizer["Ngayhachtoan"]"
                                                       DateFormat="dd/MM/yyyy"
                                                       Required="true" />
                                    </MudItem>

                                    <MudItem xs="6">
                                        <MudAutocomplete Class="custom-label" T="Guid ?" Label="@Localizer["Customer"]"
                                                         @bind-Value="_Phieuthu_Detail.Customer_Id"
                                                         SearchFunc="Search_Customer"
                                                         ToStringFunc="GetCustomerLable" />
                                    </MudItem>

                                    <MudItem xs="6">
                                        <MudTextField @bind-Value="_Phieuthu_Detail.Nguoinoptien"
                                                      Label="@Localizer["Nguoinoptien"]"
                                                      Class="custom-label" />
                                    </MudItem>

                                    <MudItem xs="12">
                                        <MudTextField @bind-Value="_Phieuthu_Detail.Noidung"
                                                      Label="@Localizer["noidung"]"
                                                      Class="custom-label" />
                                    </MudItem>

                                    <!-- Payment Information -->
                                    <MudItem xs="12">
                                        <MudText Typo="Typo.subtitle2" Class="section-title">Payment Information</MudText>
                                    </MudItem>

                                    <MudItem xs="6">
                                        <MudAutocomplete @bind-Value="_Phieuthu_Detail.PTTT"
                                                         @bind-Value:after="OnPTTTChanged"
                                                         Label="@Localizer["PTTT"]"
                                                         Class="custom-label"
                                                         CoerceValue
                                                         SearchFunc="SearchPTTT" />
                                    </MudItem>

                                    <MudItem xs="6">
                                        <MudTextField @bind-Value="_Phieuthu_Detail.Bank"
                                                      Label="@Localizer["Bank"]"
                                                      Class="custom-label" />
                                    </MudItem>

                                    <MudItem xs="6">
                                        <MudAutocomplete @bind-Value="_Phieuthu_Detail.Currency"
                                                         Label="@Localizer["Loaitiente"]"
                                                         Required="true"
                                                         Class="custom-label"
                                                         CoerceValue
                                                         SearchFunc="SearchCurr" />
                                    </MudItem>

                                    <MudItem xs="6">
                                        <MudStack Row Spacing="1" AlignItems="AlignItems.Center">
                                            <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small"
                                                       Class="receipt-action-button"
                                                       OnClick="@(() => GetTigia(_Phieuthu_Detail))">
                                                Get Rate
                                            </MudButton>

                                            <MudNumericField @bind-Value="_Phieuthu_Detail.Tigia"
                                                             Label="@Localizer["tigia"]"
                                                             Format="#,##0.##" Culture="@_en"
                                                             T="double?" Required="true" HideSpinButtons="true"
                                                             Dense="true"
                                                             Class="text-right custom-label" />
                                        </MudStack>
                                    </MudItem>

                                    <MudItem xs="6">
                                        <MudNumericField @bind-Value="_Phieuthu_Detail.Sotien" HideSpinButtons="true"
                                                         Label="@Localizer["sotien"]" Format="#,##0.##" Culture="@_en" Required="true" T="double?"
                                                         Class="text-right custom-label" />
                                    </MudItem>

                                    <!-- Accounting Entry -->
                                    <MudItem xs="12">
                                        <MudText Typo="Typo.subtitle2" Class="section-title">Accounting Entry</MudText>
                                    </MudItem>

                                    <MudItem xs="6">
                                        <MudAutocomplete Class="labelCustomColor custom-label" T="string"
                                                         @bind-Value="_Phieuthu_Detail.TKNo"
                                                         Label="Debit Account / TK Nợ"
                                                         SearchFunc="SearchTk"
                                                         Immediate="true"
                                                         CoerceText="true"
                                                         Clearable="true"
                                                         MaxItems="100">
                                        </MudAutocomplete>
                                    </MudItem>

                                    <MudItem xs="6">
                                        <MudAutocomplete Class="labelCustomColor custom-label" T="string"
                                                         @bind-Value="_Phieuthu_Detail.TKCo"
                                                         Label="Credit Account / TK Có"
                                                         SearchFunc="SearchTk"
                                                         Immediate="true"
                                                         CoerceText="true"
                                                         Clearable="true"
                                                         MaxItems="100">
                                        </MudAutocomplete>
                                    </MudItem>

                                    <MudItem xs="12">
                                        <MudAlert Severity="@MudBlazor.Severity.Info" Dense="true" Class="receipt-alert">
                                            Phiếu thu sẽ hạch toán: Nợ TK tiền mặt/ngân hàng, Có tài khoản đối ứng.
                                            Ví dụ: Nợ 111/112 - Có 131/511/3331.
                                        </MudAlert>
                                    </MudItem>

                                    <!-- Reference Documents -->
                                    <MudItem xs="12">
                                        <MudText Typo="Typo.subtitle2" Class="section-title">Reference Documents</MudText>
                                    </MudItem>

                                    <MudItem xs="6">
                                        <MudTextField @bind-Value="_Phieuthu_Detail.Chungtu"
                                                      Label="@Localizer["Chungtukemtheo"]"
                                                      Class="custom-label" />
                                    </MudItem>

                                    <MudItem xs="6">
                                        <MudTextField @bind-Value="_Phieuthu_Detail.BillNo"
                                                      Label="@Localizer["BillNo"]"
                                                      Class="custom-label" />
                                    </MudItem>

                                    <MudItem xs="6">
                                        <MudTextField @bind-Value="_Phieuthu_Detail.Quyenso"
                                                      Label="@Localizer["Quyenso"]"
                                                      Class="custom-label" />
                                    </MudItem>

                                    <MudItem xs="6">
                                        <MudTextField @bind-Value="_Phieuthu_Detail.Sohoadon"
                                                      Label="@Localizer["sohoadon"]"
                                                      Class="custom-label" />
                                    </MudItem>

                                    <MudItem xs="6">
                                        <MudTextField @bind-Value="_Phieuthu_Detail.Soseri"
                                                      Label="@Localizer["Soseri"]"
                                                      Class="custom-label" />
                                    </MudItem>

                                </MudGrid>
                            </MudTabPanel>

                            <MudTabPanel Text="Extra Info">
                                <MudGrid Spacing="1" Class="receipt-compact">

                                    <MudItem xs="6">
                                        <MudTextField @bind-Value="_Phieuthu_Detail.Socont" Label="@Localizer["socont"]" Class="custom-label" />
                                    </MudItem>

                                    <MudItem xs="6">
                                        <MudTextField @bind-Value="_Phieuthu_Detail.Travotai" Label="@Localizer["Travotai"]" Class="custom-label" />
                                    </MudItem>

                                    <MudItem xs="6">
                                        <MudTextField @bind-Value="_Phieuthu_Detail.Code" Label="@Localizer["Code"]" Class="custom-label" />
                                    </MudItem>

                                    <MudItem xs="6">
                                        <MudCheckBox @bind-Value="_Phieuthu_Detail.Ruthangtaibai" Label="@Localizer["Ruthangtaibai"]" Class="custom-label" />
                                    </MudItem>

                                    <MudItem xs="6">
                                        <MudTextField @bind-Value="_Phieuthu_Detail.Soluongcont" Label="@Localizer["Soluongcont"]" Class="custom-label" />
                                    </MudItem>

                                    <MudItem xs="6">
                                        <MudTextField @bind-Value="_Phieuthu_Detail.Hanlenhharong" Label="@Localizer["hanlenhharong"]" Class="custom-label" />
                                    </MudItem>


                                    <MudItem xs="6">
                                        <MudAutocomplete @bind-Value="_Phieuthu_Detail.Mbl" Label="@Localizer["MBL"]"
                                                         class="custom-label" CoerceValue SearchFunc="SearchMBL" />
                                    </MudItem>

                                    <MudItem xs="6">
                                        <MudCheckBox @bind-Value="_Phieuthu_Detail.Sodudauky" Label="@Localizer["Sodudauky"]" class="custom-label">
                                        </MudCheckBox>
                                    </MudItem>

                                    <MudItem xs="6">
                                        <MudTextField @bind-Value="_Phieuthu_Detail.Lastcargo" Label="@Localizer["Lastcargo"]" Class="custom-label" />
                                    </MudItem>

                                    <MudItem xs="6">
                                        <MudTextField @bind-Value="_Phieuthu_Detail.Depoaddress" Label="@Localizer["depoaddress"]" Class="custom-label" />
                                    </MudItem>

                                    <MudItem xs="6">
                                        <MudTextField @bind-Value="_Phieuthu_Detail.Luuycuoc" Label="@Localizer["Luuycuoc"]" Class="custom-label" />
                                    </MudItem>

                                    <MudItem xs="6">
                                        <MudSelect @bind-Value="_Phieuthu_Detail.Trangthai" Label="@Localizer["status"]" class="custom-label">
                                            @foreach (var item in trangthais)
                                            {
                                                <MudSelectItem Value="item">@item</MudSelectItem>
                                            }
                                        </MudSelect>
                                    </MudItem>

                                </MudGrid>
                            </MudTabPanel>
                        </MudTabs>

                    </MudCardContent>
                </MudForm>

            </MudCard>
        </MudContainer>
    </DialogContent>
    <DialogActions>

        <MudButton OnClick="@(async () => await Submit())">Save</MudButton>
        <MudButton OnClick="Cancel">Cancel</MudButton>

    </DialogActions>
</MudDialog>



@code {
    [CascadingParameter] MudDialogInstance? MudDialog { get; set; }
    [Parameter] public Models.M_PhieuThu _Phieuthu_Detail { get; set; }

    [Parameter] public string Status { get; set; }
    MudForm form;
    List<string> trangthais = new List<string>();
    private List<Models.TrangThai> M_Trangthais = new List<Models.TrangThai>();
    public CultureInfo _en = CultureInfo.GetCultureInfo("en-US");
    private List<Terminal_> Terminals = new List<Terminal_>();
    private List<Terminal_> Terminals_Address = new List<Terminal_>();
    List<M_PhieuThu> Phieuthus = new List<M_PhieuThu>();
    string UserHanding;
    private List<string> ListUser { get; set; } = new List<string>();
    List<M_Customer> Customers = new List<M_Customer>();
    List<M_MBL> MBLs = new List<M_MBL>();
    private List<string> List_Acc { get; set; } = new List<string>();
    List<string> currs = new List<string>();

    List<M_HBL> HBLs = new List<M_HBL>();
    List<M_Job> Jobs = new();
    List<M_Debit> receiptDebits = new();
    HashSet<M_Debit> selectedDebits = new();
    protected async override Task OnInitializedAsync()
    {
        if (Status == "add")
        {
            _Phieuthu_Detail.Ruthangtaibai = true;
            _Phieuthu_Detail.Sodudauky = true;

            // Mặc định thu chuyển khoản: Nợ 1121 / Có 1311
            if (string.IsNullOrWhiteSpace(_Phieuthu_Detail.PTTT))
                _Phieuthu_Detail.PTTT = PTTT_CK;
            if (string.IsNullOrWhiteSpace(_Phieuthu_Detail.TKNo))
                _Phieuthu_Detail.TKNo = _Phieuthu_Detail.PTTT == PTTT_TM ? TK_TIEN_MAT : TK_NGAN_HANG;
            if (string.IsNullOrWhiteSpace(_Phieuthu_Detail.TKCo))
                _Phieuthu_Detail.TKCo = TK_PHAI_THU_KH;
        }

        if (Status == "Duplicate")
        {
            _Phieuthu_Detail.SoPhieuthu = "";
            _Phieuthu_Detail.PhieuthuID = Guid.Empty;
            _Phieuthu_Detail.Approve = false;
            _Phieuthu_Detail.Continued = true;
            _Phieuthu_Detail.Editable = true;
        }

        List_Acc = await DMTKSv.GetList_Danhmuctaikhoan_search() ?? new List<string>();
        MBLs = await shipmentsv.GetListMBLALL();
        Customers = await Cussv.GetList();
        M_Trangthais = await supsv.GetListTrangThai();
        var tts = await supsv.GetListTrangThai();
        trangthais = tts.Where(x => x.Tieude == "Phieuthu").OrderBy(x => x.Noidung).Select(x => x.Noidung).ToList();
        Phieuthus = await Thuchisv.GetList_PhieuThu();
        Terminals_Address = await gsv.GetList_Terminal_add();
        currs = await Vcbsv.GetCur();

        ListUser = await asv.GetList_User_handle() ?? new List<string>();
        HBLs = await shipmentsv.GetListHBLALL();
        charges = await QuoSV.Getcharge() ?? new List<ChargeModel>();
        Jobs = await shipmentsv.GetListJob();

        if (Status == "edit" && _Phieuthu_Detail.PhieuthuID != Guid.Empty)
            await LoadExistingDebitSelectionAsync();

    }

    private async Task Get_PhieuthuNo()
    {

        int formattedYear = DateTime.Now.Year;
        int formattedMonth = DateTime.Now.Month;

        string usr = asv.GetAuth().Result.User.Identity!.Name!;
        var refno = await supsv.GetRefNoByFunc("Phieuthu", formattedMonth, formattedYear, usr);

        var rs = asv.GetUserDetail();
        var cn = rs.Branch;
        _Phieuthu_Detail.SoPhieuthu = cn + "PT_" + formattedYear.ToString() + formattedMonth.ToString() + refno.Value.ToString("D4");
    }

    private async Task Submit()
    {
        if ((await ssv.CheckPermission(asv.GetAuth().Result.User.Identity.Name, "Edit", "Phieuthu") || await ssv.CheckPermission(asv.GetAuth().Result.User.Identity.Name, "New", "Phieuthu")))
        {

            await form.Validate();

            if (form.IsValid)
            {
                if (!ValidateSelectedDebitRates())
                {
                    CallSnackBar("Các phí đang chọn không cùng tiền tệ hoặc tỷ giá. Vui lòng chọn lại.", MudBlazor.Severity.Warning);
                    return;
                }

                var UserName = asv.GetAuth().Result.User.Identity!.Name!;
                _Phieuthu_Detail.DateUpdate = DateTime.Now.ToString("dd/MMM/yyyy");
                _Phieuthu_Detail.UserUpdate = UserName;

                _Phieuthu_Detail.Loaiphieu = "PT";
                _Phieuthu_Detail.SelectedDebitIds = selectedDebits.Select(x => x.debitId).ToList();
                _Phieuthu_Detail.DebitSelectionSpecified = true;

                MudDialog!.Close(_Phieuthu_Detail);

            }
        }

    }
    void Cancel() => MudDialog.Cancel();

    void CallSnackBar(string message, MudBlazor.Severity severity)
    {

        Snackbar.Configuration.SnackbarVariant = Variant.Filled;
        Snackbar.Configuration.MaxDisplayedSnackbars = 3;
        Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopRight;
        Snackbar.Add(message, severity);
    }

    private Task<IEnumerable<Guid?>> Search_Customer(string value)
    {
        IEnumerable<M_Customer> query = Customers ?? new List<M_Customer>();

        if (!string.IsNullOrWhiteSpace(value))
        {
            query = query.Where(x =>
                !string.IsNullOrWhiteSpace(x.COMPANY) &&
                x.COMPANY.Contains(value, StringComparison.InvariantCultureIgnoreCase));
        }

        return Task.FromResult(query.Select(x => (Guid?)x.Customer_ID));
    }

    private string GetCustomerLable(Guid? id)
    {
        if (id == null || id == Guid.Empty)
            return string.Empty;

        var customer = Customers?.FirstOrDefault(x => x.Customer_ID == id);

        return customer?.COMPANY ?? string.Empty;
    }


    private async Task<IEnumerable<string?>> SearchTkNo(string? text)
    {
        try
        {
            var items = Phieuthus.Select(x => x.TKNo).Distinct();
            if (string.IsNullOrEmpty(text))
            {
                return items;
            }
            // MBL.Porname = mst_Consignee;
            return items.Where(x => x != null && x.Equals(text));
        }
        catch (Exception)
        {
            throw;
        }
    }

    private async Task<IEnumerable<string?>> SearchTkCo(string? text)
    {
        try
        {
            var items = Phieuthus.Select(x => x.TKCo).Distinct();
            if (string.IsNullOrEmpty(text))
            {
                return items;
            }
            // MBL.Porname = mst_Consignee;
            return items.Where(x => x != null && x.Equals(text));
        }
        catch (Exception)
        {
            throw;
        }
    }

    const string PTTT_CK = "CK";
    const string PTTT_TM = "TM";
    const string TK_TIEN_MAT = "1111";
    const string TK_NGAN_HANG = "1121";
    const string TK_PHAI_THU_KH = "1311";

    // Đổi PTTT thì tự đổi TK Nợ: TM -> 1111, CK -> 1121 (chỉ khi TK Nợ đang trống hoặc là TK mặc định)
    private void OnPTTTChanged()
    {
        var tkNo = _Phieuthu_Detail.TKNo;
        if (!string.IsNullOrWhiteSpace(tkNo) && tkNo != TK_TIEN_MAT && tkNo != TK_NGAN_HANG)
            return;

        if (string.Equals(_Phieuthu_Detail.PTTT, PTTT_TM, StringComparison.OrdinalIgnoreCase))
            _Phieuthu_Detail.TKNo = TK_TIEN_MAT;
        else if (string.Equals(_Phieuthu_Detail.PTTT, PTTT_CK, StringComparison.OrdinalIgnoreCase))
            _Phieuthu_Detail.TKNo = TK_NGAN_HANG;
    }

    private async Task<IEnumerable<string?>> SearchPTTT(string? text)
    {
        try
        {
            var items = new string?[] { PTTT_CK, PTTT_TM }
                .Concat(Phieuthus.Select(x => x.PTTT))
                .Where(x => !string.IsNullOrWhiteSpace(x))
                .Distinct();
            if (string.IsNullOrEmpty(text))
            {
                return items;
            }
            // MBL.Porname = mst_Consignee;
            return items.Where(x => x != null && x.Equals(text));
        }
        catch (Exception)
        {
            throw;
        }
    }
    private async Task<IEnumerable<string?>> SearchTKdoiung(string? text)
    {
        try
        {
            var items = Phieuthus.Select(x => x.Taikhoan_Doiung).Distinct();
            if (string.IsNullOrEmpty(text))
            {
                return items;
            }
            // MBL.Porname = mst_Consignee;
            return items.Where(x => x != null && x.Equals(text));
        }
        catch (Exception)
        {
            throw;
        }
    }
