    private async Task<IEnumerable<JobDisplay>> SearchDNTT(string text)
    {
        var results = new List<JobDisplay>();

        foreach (var hbl in HBLs)
        {
            var mbl = await shipmentsv.GetMBL_byHBLid(hbl.mblid);
            if (mbl == null) continue;

            var job = await shipmentsv.GetJob_byid(mbl.Jobid);
            if (job == null) continue;

            var debit_info = await shipmentsv.GetListDebitHBL(hbl.hblID);
            if (debit_info == null) continue;

            var distinctCustomerIds = debit_info
                .Where(x => x.customerid != null)
                .Select(x => x.customerid)
                .Distinct()
                .ToList();

            foreach (var cusid in distinctCustomerIds)
            {
                var customerName = GetCusName(cusid);
                var display = $"{job.JobNo} - {customerName} - {hbl.hbl}";

                results.Add(new JobDisplay
                {
                    Id = hbl.hblID,
                    customer = customerName,
                    DisplayText = display,
                    cus_id = cusid
                });
            }
        }

        // ✅ Lọc theo DisplayText sau khi đã build xong
        if (!string.IsNullOrWhiteSpace(text))
        {
            results = results
                .Where(x => x.DisplayText != null &&
                            x.DisplayText.Contains(text, StringComparison.OrdinalIgnoreCase))
                .ToList();
        }

        return results;
    }

    async Task<string> DnttidtosoDntt(Guid PTid)
    {
        if (PTid == null || PTid == Guid.Empty)
            return string.Empty;
        var rs = HBLs.FirstOrDefault(x => x.hblID == PTid);
        if (rs == null)
        {
            return null;
        }
        var rs_mbl = await shipmentsv.GetMBL_byHBLid(rs.mblid);
        if (rs_mbl == null)
        {
            return null;
        }

        var rs_job = await shipmentsv.GetJob_byid(rs_mbl.Jobid);
        string jobno = rs_job.JobNo;
        return jobno;
    }

    public class JobDisplay
    {
        public Guid Id { get; set; }
        public string? DisplayText { get; set; }
        public string? customer { get; set; }
        public Guid cus_id { get; set; }
        public override string ToString() => DisplayText ?? string.Empty;
    }


    string GetCusName(Guid id)
    {
        return Customers?
            .Where(x => x.Customer_ID == id)
            .Select(x => x.COMPANY)
            .FirstOrDefault() ?? string.Empty;
    }
