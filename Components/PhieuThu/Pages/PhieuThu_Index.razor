@page "/Phieuthu"
@using System.Globalization
@attribute [Authorize]
@inject GlobalServices gsv
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject AccountService asv
@inject SharedServices ssv
@inject BookingService bksv
@inject IJSRuntime JSRuntime
@inject SupportServices supsv
@inject IStringLocalizer<SharedResource> Localizer
@inject LocalChargesServices lcsv
@inject PhieuThu_Chi_Services thuchiSv
@inject CustomerService Cussv
@inject HistoryLogService HistoryLogService
@using System.Text.Json;


<style>
    .class-dialog-custom {
        backdrop-filter: blur(10px);
        transition: none !important;
        animation: none !important;
    }

    .selected {
        background: #855ff3 !important;
    }

        .selected > td {
            color: white !important;
        }

            .selected > td .mud-input {
                color: white !important;
            }

    .labelCustomColor label {
        font-weight: 600;
        color: #118AB2 !important;
    }

    .mud-table thead {
        background-color: #118AB2;
    }

    .mud-table th {
        background-color: #118AB2 !important;
        color: white !important;
    }

    .mud-table-foot tr {
        background-color: #118AB2 !important;
    }

    .footer-cell {
        background-color: #118AB2 !important;
        color: white !important;
    }

    .filter-header-cell {
        background-color: white !important;
        color: black !important;
    }

    .mud-menu {
        display: none;
    }

    .no-wrap {
        white-space: nowrap;
    }

    .custom-right-align,
    .amount-cell {
        text-align: right !important;
    }

    .amount-cell {
        font-weight: 700;
    }

    .custom-label .mud-input-label {
        color: #424242 !important;
    }

    .receipt-toolbar {
        padding: 8px 12px !important;
        gap: 8px;
        align-items: center;
        flex-wrap: wrap;
    }

        .receipt-toolbar .mud-button-root {
            min-height: 30px !important;
            height: 30px !important;
            padding: 4px 10px !important;
        }

    .receipt-search {
        width: 300px;
        margin-left: auto !important;
    }

    .receipt-grid {
        padding: 8px !important;
        border-radius: 10px;
    }

        .receipt-grid .mud-table-cell {
            padding: 4px 8px !important;
            font-size: 13px !important;
            height: 32px !important;
            white-space: nowrap;
        }

        .receipt-grid .mud-table-head .mud-table-cell {
            padding: 6px 8px !important;
            font-size: 13px !important;
            font-weight: 700 !important;
        }

        .receipt-grid .mud-input-control {
            margin-top: 0 !important;
        }

        .receipt-grid .mud-input > input {
            padding: 4px 6px !important;
            font-size: 13px !important;
        }

    .receipt-detail-card {
        background: #f8fafc;
        border: 1px solid #e5e7eb;
        border-radius: 10px;
    }

    .receipt-detail-label {
        font-size: 12px;
        color: #607d8b;
        font-weight: 700;
        margin-bottom: 2px;
    }

    .receipt-detail-value {
        font-size: 13px;
        color: #222;
        min-height: 18px;
    }

    .receipt-total-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        width: 100%;
        padding: 4px 8px;
        font-size: 13px;
        flex-wrap: wrap;
    }

    .total-box {
        font-weight: 700;
        background: #f5f7fa;
        border: 1px solid #e0e0e0;
        border-radius: 8px;
        padding: 4px 10px;
    }
</style>

<PageTitle>@Localizer["Phieuthu"] </PageTitle>
<MudText Class="pa-2" Typo="Typo.h6">@Localizer["Phieuthu"]</MudText>
<MudStack Row Justify="Justify.FlexStart" Class="receipt-toolbar">

    <MudButton HtmlTag="label"
               OnClick="Refresh"
               Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled"
               StartIcon="@Icons.Material.Filled.Refresh">
        @Localizer["reload"]
    </MudButton>

    <MudButton HtmlTag="label"
               @onclick="@((e) => OpenCreateDialog(new Models.M_PhieuThu()))"
               Size="Size.Small" Color="Color.Secondary" Variant="Variant.Filled"
               StartIcon="@Icons.Material.Filled.Add">
        @Localizer["new"]
    </MudButton>

    <MudButton HtmlTag="label"
               @onclick="@((e) => OpenEditDialog(detail))"
               Size="Size.Small" Color="Color.Info" Variant="Variant.Filled"
               StartIcon="@Icons.Material.Filled.Edit">
        @Localizer["edit"]
    </MudButton>

    <MudButton HtmlTag="label"
               @onclick="@((e) => OpenDuplicateDialog(detail))"
               Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled"
               StartIcon="@Icons.Material.Filled.CopyAll">
        @Localizer["duplicate"]
    </MudButton>

    <MudButton Disabled="_processingUpload"
               OnClick="ExportBill"
               Size="Size.Small" Color="Color.Secondary" Variant="Variant.Filled"
               StartIcon="@Icons.Material.Filled.Download">
        @if (_processingUpload)
        {
            <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
            <MudText Class="ms-2">Processing</MudText>
        }
        else
        {
            <MudText>@Localizer["Export_Bill"]</MudText>
        }
    </MudButton>
    <MudTextField @bind-Value="_searchString"
                  Placeholder="@Localizer["Search"]"
                  Adornment="Adornment.Start"
                  Immediate="true"
                  AdornmentIcon="@Icons.Material.Filled.Search"
                  IconSize="Size.Small"
                  Class="receipt-search"
                  Margin="Margin.Dense"
                  TextChanged="OnSearchTextChanged" />

</MudStack>

<MudDataGrid T="M_PhieuThu"
             Items="@filteredItems"
             Filterable="true"
             @ref="mudTable"
             Class="receipt-grid"
             Bordered="false"
             Striped="true"
             Hover="true"
             Dense="true"
             Virtualize="true"
             QuickFilter="@FilterFunc1"
             FilterMode="@DataGridFilterMode.ColumnFilterRow"
             FixedHeader="true"
             FixedFooter="true"
             Height="calc(100vh - 190px)"
             HeaderClass="no-wrap"
             FooterClass="no-wrap"
             ReadOnly="false"
             CommittedItemChanges="@CommittedItem"
             RowClassFunc="@SelectedRowClassFunc"
             RowClick="@RowClicked"
             EditDialogOptions="@options"
             ColumnResizeMode="ResizeMode.Container"
             Loading="_loading">

    <Columns>
        <HierarchyColumn T="M_PhieuThu" />

        <TemplateColumn Title="" CellClass="d-flex justify-center">
            <CellTemplate>
                <MudIconButton Icon="@Icons.Material.Outlined.Delete"
                               Size="Size.Small"
                               Color="Color.Error"
                               OnClick="@(() => DeleteItem(context.Item))" />
            </CellTemplate>
        </TemplateColumn>

        <TemplateColumn Title="@Localizer["Approve"]">
            <CellTemplate>
                <MudCheckBox Size="Size.Small"
                             @bind-Checked="context.Item.Approve"
                             @bind-Value="context.Item.Approve"
                             @bind-Value:after="@(() => OnApproveCheckboxWrapper(context.Item))" />
            </CellTemplate>
        </TemplateColumn>

        <PropertyColumn Property="x => x.SoPhieuthu"
                        Title="@Localizer["SoPhieuthu"]"
                        CellStyleFunc="_cellStyleFunc" />

        <PropertyColumn Property="x => x.Ngay"
                        Title="@Localizer["NGAY"]"
                        Format="dd/MM/yyyy"
                        CellStyleFunc="_cellStyleFunc" />

        <PropertyColumn Property="x => x.Ngayhachtoan"
                        Title="@Localizer["Ngayhachtoan"]"
                        Format="dd/MM/yyyy"
                        CellStyleFunc="_cellStyleFunc" />

        <PropertyColumn Property="x => CustomerName(x.Customer_Id)"
                        Title="@Localizer["Customer"]"
                        CellStyleFunc="_cellStyleFunc">
            <EditTemplate>
                <MudSelect @bind-Value="context.Item.Customer_Id" Label="@Localizer["Customer"]">
                    @foreach (var item in List_Cus)
                    {
                        <MudSelectItem Value="@item.Customer_ID">@item.COMPANY</MudSelectItem>
                    }
                </MudSelect>
            </EditTemplate>
        </PropertyColumn>

        <PropertyColumn Property="x => x.Sotien"
                        Title="@Localizer["sotien"]"
                        Format="#,##0.##"
                        Culture="_en"
                        CellStyleFunc="_cellStyleFunc"
                        CellClass="amount-cell" />

        <PropertyColumn Property="x => x.Currency"
                        Title="@Localizer["Loaitiente"]"
                        CellStyleFunc="_cellStyleFunc" />

        <PropertyColumn Property="x => x.PTTT"
                        Title="@Localizer["PTTT"]"
                        CellStyleFunc="_cellStyleFunc" />

        <PropertyColumn Property="x => x.TKNo"
                        Title="@Localizer["TKNo"]"
                        CellStyleFunc="_cellStyleFunc" />

        <PropertyColumn Property="x => x.TKCo"
                        Title="@Localizer["TKCO"]"
                        CellStyleFunc="_cellStyleFunc" />

        <PropertyColumn Property="x => x.Noidung"
                        Title="@Localizer["noidung"]"
                        CellStyleFunc="_cellStyleFunc" />

        <PropertyColumn Property="x => x.Bank"
                        Title="@Localizer["Bank"]"
                        CellStyleFunc="_cellStyleFunc" />

        <PropertyColumn Property="x => x.UserUpdate"
                        Title="@Localizer["UserUpdate"]"
                        CellStyleFunc="_cellStyleFunc" />

        <PropertyColumn Property="x => x.DateUpdate"
                        Title="@Localizer["Dateupdate"]"
                        CellStyleFunc="_cellStyleFunc" />

    </Columns>

    <ChildRowContent>
        <MudCard Class="receipt-detail-card ma-2 pa-3" Elevation="0">
            <MudGrid Spacing="1">
                <MudItem xs="12" sm="3">
                    <div class="receipt-detail-label">@Localizer["Chungtukemtheo"]</div>
                    <div class="receipt-detail-value">@context.Item.Chungtu</div>
                </MudItem>
                <MudItem xs="12" sm="3">
                    <div class="receipt-detail-label">@Localizer["Nguoinoptien"]</div>
                    <div class="receipt-detail-value">@context.Item.Nguoinoptien</div>
                </MudItem>
                <MudItem xs="12" sm="3">
                    <div class="receipt-detail-label">@Localizer["BillNo"]</div>
                    <div class="receipt-detail-value">@context.Item.BillNo</div>
                </MudItem>
                <MudItem xs="12" sm="3">
                    <div class="receipt-detail-label">@Localizer["Branch"]</div>
                    <div class="receipt-detail-value">@context.Item.Branch</div>
                </MudItem>

                <MudItem xs="12" sm="3">
                    <div class="receipt-detail-label">@Localizer["sohoadon"]</div>
                    <div class="receipt-detail-value">@context.Item.Sohoadon</div>
                </MudItem>
                <MudItem xs="12" sm="3">
                    <div class="receipt-detail-label">@Localizer["Soseri"]</div>
                    <div class="receipt-detail-value">@context.Item.Soseri</div>
                </MudItem>
                <MudItem xs="12" sm="3">
                    <div class="receipt-detail-label">@Localizer["Quyenso"]</div>
                    <div class="receipt-detail-value">@context.Item.Quyenso</div>
                </MudItem>
                <MudItem xs="12" sm="3">
                    <div class="receipt-detail-label">@Localizer["status"]</div>
                    <div class="receipt-detail-value">@context.Item.Trangthai</div>
                </MudItem>

                <MudItem xs="12" sm="3">
                    <div class="receipt-detail-label">@Localizer["MBL"]</div>
                    <div class="receipt-detail-value">@context.Item.Mbl</div>
                </MudItem>
                <MudItem xs="12" sm="3">
                    <div class="receipt-detail-label">@Localizer["socont"]</div>
                    <div class="receipt-detail-value">@context.Item.Socont</div>
                </MudItem>
                <MudItem xs="12" sm="3">
                    <div class="receipt-detail-label">@Localizer["depoaddress"]</div>
                    <div class="receipt-detail-value">@context.Item.Depoaddress</div>
                </MudItem>
                <MudItem xs="12" sm="3">
                    <div class="receipt-detail-label">@Localizer["Luuycuoc"]</div>
                    <div class="receipt-detail-value">@context.Item.Luuycuoc</div>
                </MudItem>
            </MudGrid>
        </MudCard>
    </ChildRowContent>

    <PagerContent>
        <div class="receipt-total-bar">
            <div class="total-box">
                Total VND:
                <span style="color: darkgreen">
                    @(FilteredTotalAmount_VND?.ToString("#,##0.##") ?? "0")
                </span>
            </div>

            <div class="total-box">
                Total USD:
                <span style="color: darkgreen">
                    @(FilteredTotalAmount_USD?.ToString("#,##0.##") ?? "0")
                </span>
            </div>

            <MudDataGridPager T="M_PhieuThu" PageSizeOptions="@(new int[] { 10, 20, 50, 100 })" />
        </div>
    </PagerContent>
</MudDataGrid>

@code {
    List<M_PhieuThu> Listdata = new List<M_PhieuThu>();
    MudDataGrid<M_PhieuThu> mudTable;
    AuthUser user;
    string mailtp, mailpp;
    string usr;
    private List<string> ListUser { get; set; } = new List<string>();
    string UserHanding;
    List<string> trangthais = new List<string>();
    private List<Models.TrangThai> M_Trangthais = new List<Models.TrangThai>();
    private string searchText_pol = "";
    private string searchText_pod = "";
    private List<PortModel> filteredPorts = new List<PortModel>();
    private List<PortModel> filteredPorts_pod = new List<PortModel>();
    private List<PortModel> Ports = new List<PortModel>();

    private bool _resizeColumn;
    M_PhieuThu detail;
    private string _searchString;
    private List<M_Customer> filteredCarr = new List<M_Customer>();
    private List<M_Customer> Cuss_Carr = new List<M_Customer>();
    private List<M_Customer> List_Cus = new List<M_Customer>();
    public CultureInfo _en = CultureInfo.GetCultureInfo("en-US");
    public decimal? FilteredTotalAmount_VND;
    public decimal? FilteredTotalAmount_USD;
    private List<M_PhieuThu> filteredItems = new List<M_PhieuThu>();


    protected async override Task OnInitializedAsync()
    {
        M_Trangthais = await supsv.GetListTrangThai();
        var tts = await supsv.GetListTrangThai();
        trangthais = tts.Where(x => x.Tieude == "Phieuthu").OrderBy(x => x.Noidung).Select(x => x.Noidung).ToList();
        List_Cus = await Cussv.GetList();
        ListUser = await asv.GetList_User_handle() ?? new List<string>();
        usr = asv.GetAuth().Result.User.Identity!.Name!;
        Cuss_Carr = await lcsv.GetList_Customer_line();
        // await Refresh();
    }



    bool _loading = false;
    async Task Refresh()
    {
        try
        {

            detail = null!;
            _loading = true;
            Listdata.Clear();

            await Task.Delay(500);
            if (!await ssv.CheckPermission(usr, "View", "Phieuthu"))
            {
                CallSnackBar("You have not access to view", MudBlazor.Severity.Warning);
                return;
            }
            Listdata = await thuchiSv.GetList_PhieuThu();
            filteredItems = Listdata;

            FilteredTotalAmount_VND = Convert.ToDecimal(filteredItems
            .Where(item => item.Currency == "VND")
            .Sum(item => item.Sotien ?? 0));

            FilteredTotalAmount_USD = Convert.ToDecimal(filteredItems
         .Where(item => item.Currency == "USD")
         .Sum(item => item.Sotien ?? 0));

            StateHasChanged();
        }
        catch (Exception ex)
        {
            CallSnackBar("Something went wrong!, error code: " + ex.Message, MudBlazor.Severity.Warning);
        }
        finally
        {
            _loading = false;
        }

    }

    void CallSnackBar(string message, MudBlazor.Severity severity)
    {

        Snackbar.Configuration.SnackbarVariant = Variant.Filled;
        Snackbar.Configuration.MaxDisplayedSnackbars = 3;
        Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopRight;
        Snackbar.Add(message, severity);
    }

    private void RecalculateTotals()
    {
        filteredItems ??= new List<M_PhieuThu>();

        FilteredTotalAmount_VND = Convert.ToDecimal(filteredItems
            .Where(item => string.Equals(item.Currency, "VND", StringComparison.OrdinalIgnoreCase))
            .Sum(item => item.Sotien ?? 0));

        FilteredTotalAmount_USD = Convert.ToDecimal(filteredItems
            .Where(item => string.Equals(item.Currency, "USD", StringComparison.OrdinalIgnoreCase))
            .Sum(item => item.Sotien ?? 0));
    }
    void RowClicked(DataGridRowClickEventArgs<M_PhieuThu> args)
    {
        detail = args.Item;
    }
    private int selectedRowNumber = -1;
    private string SelectedRowClassFunc(M_PhieuThu m, int rowNumber)
    {
        if (selectedRowNumber == rowNumber)
        {
            selectedRowNumber = -1;
            return string.Empty;
        }
        else if (mudTable.SelectedItem != null && mudTable.SelectedItem.Equals(m))
        {
            selectedRowNumber = rowNumber;
            return "selected";
        }
        else
        {
            return string.Empty;
        }
    }

    async Task CommittedItem(M_PhieuThu item)
    {
        item.UserUpdate = asv.GetAuth().Result.User.Identity!.Name!;
        item.DateUpdate = DateTime.Now.ToString("dd/MMM/yyyy");
        var rs = item.PhieuthuID != Guid.Empty ? await thuchiSv.UpdatePhieuthu_Detail(item) : await thuchiSv.CreatePhieuThu_Detail(item);
        CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);

        await Refresh();
    }
    int? index_no;

    async Task DeleteItem(M_PhieuThu item)
    {
        if (item.Approve == true)
        {
            CallSnackBar("Data đã được Approve!!! , vui lòng bỏ Approve", MudBlazor.Severity.Warning);
            return;
        }
        if (!await ssv.CheckPermission(usr, "Delete", "Phieuthu"))
        {
            CallSnackBar("You have not access to Delete", MudBlazor.Severity.Warning);
            return;
        }
        var resultMess = await DialogService.ShowMessageBox(
                "Warning",
                "Deleting can not be undone!",
                yesText: "Delete!", cancelText: "Cancel");

        if (resultMess.HasValue)
        {
            var rs = await thuchiSv.DeletePhieuThu_Detail(item);
            await HistoryLogService.LogAsync(usr, "Delete", "Phieuthu", item.PhieuthuID, item.SoPhieuthu, item);
            CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
            await Refresh();
        }
    }

    DialogOptions options = new DialogOptions
    {
        ClassBackground = "class-dialog-custom",
        FullWidth = true,
        MaxWidth = MaxWidth.Medium,
        CloseOnEscapeKey = false,
        DisableBackdropClick = true
    };
    string search;

    private bool FilterFunc1(M_PhieuThu item) => FilterFunc(item, _searchString);

    private bool FilterFunc(M_PhieuThu item, string searchString)
    {
        if (string.IsNullOrWhiteSpace(searchString))
            return true;

        var keyword = searchString.Trim();

        return (!string.IsNullOrEmpty(item.SoPhieuthu) && item.SoPhieuthu.Contains(keyword, StringComparison.OrdinalIgnoreCase))
            || (!string.IsNullOrEmpty(item.TKNo) && item.TKNo.Contains(keyword, StringComparison.OrdinalIgnoreCase))
            || (!string.IsNullOrEmpty(item.TKCo) && item.TKCo.Contains(keyword, StringComparison.OrdinalIgnoreCase))
            || (!string.IsNullOrEmpty(item.Noidung) && item.Noidung.Contains(keyword, StringComparison.OrdinalIgnoreCase))
            || (!string.IsNullOrEmpty(item.BillNo) && item.BillNo.Contains(keyword, StringComparison.OrdinalIgnoreCase))
            || CustomerName(item.Customer_Id).Contains(keyword, StringComparison.OrdinalIgnoreCase);
    }

    private Func<M_PhieuThu, string> _cellStyleFunc => x =>
       {
           return "color: #000000";

       };

    private async Task OpenCreateDialog(Models.M_PhieuThu tr)
    {
        var optionsdialog = new DialogOptions { ClassBackground = "class-dialog-custom", FullWidth = true, MaxWidth = MaxWidth.Medium };

        if (await ssv.CheckPermission(asv.GetAuth().Result.User.Identity.Name, "Add", "Phieuthu"))
        {

            DialogOptions closeOnEscapeKey = new DialogOptions() { CloseOnEscapeKey = true };
            var parameters = new DialogParameters<ADD> { { x => x._Phieuthu_Detail, tr }, { x => x.Status, "add" } };

            var dialog = await DialogService.ShowAsync<ADD>(tr.PhieuthuID == Guid.Empty ? "Receipts List Create" : "Receipts List Edit", parameters, optionsdialog);
            var result = await dialog.Result;
            if (!result.Canceled)
            {
                var data = (M_PhieuThu)result.Data;
                var rs = await thuchiSv.UpdateCreatePhieuThu(data);
                await HistoryLogService.LogAsync(usr, "ADD Phieu Thu", "Phieuthu", data.PhieuthuID, data.SoPhieuthu, data);
                MudBlazor.Severity severity;
                if (rs[1] == "1")
                    severity = MudBlazor.Severity.Success;
                else
                    severity = MudBlazor.Severity.Error;

                CallSnackBar(rs[0], severity);

                await HandleRefresh_create(data.PhieuthuID);

            }

            return;

        }
        else
        {
            CallSnackBar("You have not access to Create", MudBlazor.Severity.Warning);
            return;
        }

    }

    async Task HandleRefresh_create(Guid? id)
    {
        try
        {

            detail = null;

            Listdata.Clear();

            await Task.Delay(500);

            if (!await ssv.CheckPermission(asv.GetAuth().Result.User.Identity.Name, "View", "Phieuthu"))
            {
                CallSnackBar("You have not access to view", MudBlazor.Severity.Warning);

                return;
            }
            Listdata = await thuchiSv.GetListPhieuthu_create(id);
            filteredItems = Listdata;

            FilteredTotalAmount_VND = Convert.ToDecimal(filteredItems
            .Where(item => item.Currency == "VND")
            .Sum(item => item.Sotien ?? 0));

            FilteredTotalAmount_USD = Convert.ToDecimal(filteredItems
         .Where(item => item.Currency == "USD")
         .Sum(item => item.Sotien ?? 0));

            StateHasChanged();
        }
        finally
        {


        }
    }

    private async Task OpenEditDialog(Models.M_PhieuThu tr)
    {

        var optionsdialog = new DialogOptions { ClassBackground = "class-dialog-custom", FullWidth = true, MaxWidth = MaxWidth.Medium };
        if (tr == null)
        {
            CallSnackBar("Please select Data", MudBlazor.Severity.Warning);
            return;
        }
        if (tr.Approve == true)
        {
            CallSnackBar("Data đã được Approve!!! , vui lòng bỏ Approve", MudBlazor.Severity.Warning);
            return;
        }
        if (await ssv.CheckPermission(asv.GetAuth().Result.User.Identity.Name, "Edit", "Phieuthu"))
        {
            var OldData = JsonSerializer.Deserialize<M_PhieuThu>(JsonSerializer.Serialize(tr));
            DialogOptions closeOnEscapeKey = new DialogOptions() { CloseOnEscapeKey = true };
            var parameters = new DialogParameters<ADD> { { x => x._Phieuthu_Detail, tr }, { x => x.Status, "edit" } };

            var dialog = await DialogService.ShowAsync<ADD>(tr.PhieuthuID == Guid.Empty ? "Receipts List Edit" : "Receipts List Edit", parameters, optionsdialog);
            var result = await dialog.Result;
            // Giữ nguyên dòng được chọn
            selectedRowNumber = selectedRowNumber;
            StateHasChanged();

            if (!result.Canceled)
            {
                var data = (M_PhieuThu)result.Data;
                var rs = await thuchiSv.UpdateCreatePhieuThu(data);
                await HistoryLogService.LogAsync(usr, "Update Phieu Thu", "Phieuthu", data.PhieuthuID, data.SoPhieuthu, new { OldData = OldData, NewData = data });
                MudBlazor.Severity severity;
                if (rs[1] == "1")
                    severity = MudBlazor.Severity.Success;
                else
                    severity = MudBlazor.Severity.Error;

                CallSnackBar(rs[0], severity);
                Refresh();
            }

            return;

        }
        else
        {
            CallSnackBar("You have not access to Edit", MudBlazor.Severity.Warning);
            return;
        }

    }
    private async Task OpenDuplicateDialog(Models.M_PhieuThu tr)
    {

        var optionsdialog = new DialogOptions { ClassBackground = "class-dialog-custom", FullWidth = true, MaxWidth = MaxWidth.Medium };
        if (tr == null)
        {
            CallSnackBar("Please select Data", MudBlazor.Severity.Warning);
            return;
        }

        if (await ssv.CheckPermission(asv.GetAuth().Result.User.Identity.Name, "Add", "Phieuthu"))
        {
            var OldData = JsonSerializer.Deserialize<M_PhieuThu>(JsonSerializer.Serialize(tr));
            DialogOptions closeOnEscapeKey = new DialogOptions() { CloseOnEscapeKey = true };
            var parameters = new DialogParameters<ADD> { { x => x._Phieuthu_Detail, tr }, { x => x.Status, "Duplicate" } };

            var dialog = await DialogService.ShowAsync<ADD>(tr.PhieuthuID == Guid.Empty ? "Receipts List Create" : "Receipts List Create", parameters, optionsdialog);
            var result = await dialog.Result;
            // Giữ nguyên dòng được chọn
            selectedRowNumber = selectedRowNumber;
            StateHasChanged();

            if (!result.Canceled)
            {
                var data = (M_PhieuThu)result.Data;
                var rs = await thuchiSv.UpdateCreatePhieuThu(data);
                await HistoryLogService.LogAsync(usr, "Duplicate", "Phieuthu", data.PhieuthuID, data.SoPhieuthu, new { OldData = OldData, NewData = data });
                MudBlazor.Severity severity;
                if (rs[1] == "1")
                    severity = MudBlazor.Severity.Success;
                else
                    severity = MudBlazor.Severity.Error;

                CallSnackBar(rs[0], severity);
                await HandleRefresh_create(data.PhieuthuID);
            }

            return;

        }
        else
        {
            CallSnackBar("You have not access to Create", MudBlazor.Severity.Warning);
            return;
        }

    }

    private async Task Get_PhieuThuNo(M_PhieuThu item)
    {

        int formattedYear = DateTime.Now.Year;
        int formattedMonth = DateTime.Now.Month;

        string usr = asv.GetAuth().Result.User.Identity!.Name!;
        var refno = await supsv.GetRefNoByFunc("Phieuthu", formattedMonth, formattedYear, usr);

        var rs = asv.GetUserDetail();
        var cn = rs.Branch;
        item.SoPhieuthu = cn + "PT_" + formattedYear.ToString() + formattedMonth.ToString() + refno.Value.ToString("D4");

    }


    string CustomerName(Guid? customerID)
    {
        if (customerID == null || customerID == Guid.Empty)
            return string.Empty;

        var rs = List_Cus?.FirstOrDefault(x => x.Customer_ID == customerID);
        return rs?.COMPANY ?? string.Empty;
    }

    private void OnSearchTextChanged(string newValue)
    {
        _searchString = newValue;

        if (string.IsNullOrWhiteSpace(newValue))
        {
            filteredItems = Listdata;
        }
        else
        {
            var keyword = newValue.Trim();

            var matchingCustomerIds = List_Cus
                .Where(cus => !string.IsNullOrEmpty(cus.COMPANY)
                           && cus.COMPANY.Contains(keyword, StringComparison.OrdinalIgnoreCase))
                .Select(cus => cus.Customer_ID)
                .ToList();

            filteredItems = Listdata.Where(item =>
                matchingCustomerIds.Contains(item.Customer_Id.GetValueOrDefault()) ||
                (!string.IsNullOrEmpty(item.SoPhieuthu) && item.SoPhieuthu.Contains(keyword, StringComparison.OrdinalIgnoreCase)) ||
                (!string.IsNullOrEmpty(item.TKNo) && item.TKNo.Contains(keyword, StringComparison.OrdinalIgnoreCase)) ||
                (!string.IsNullOrEmpty(item.TKCo) && item.TKCo.Contains(keyword, StringComparison.OrdinalIgnoreCase)) ||
                (!string.IsNullOrEmpty(item.Noidung) && item.Noidung.Contains(keyword, StringComparison.OrdinalIgnoreCase)) ||
                (!string.IsNullOrEmpty(item.BillNo) && item.BillNo.Contains(keyword, StringComparison.OrdinalIgnoreCase)) ||
                (!string.IsNullOrEmpty(item.Bank) && item.Bank.Contains(keyword, StringComparison.OrdinalIgnoreCase))
            ).ToList();
        }

        RecalculateTotals();
    }

    private bool _processingUpload = false;

    private async Task ExportBill()
    {
        try
        {
            _processingUpload = true;
            StateHasChanged();
            await Task.Delay(1);
            if (detail == null)
            {
                CallSnackBar("you must select 1 Data.", MudBlazor.Severity.Warning);
                return;
            }
            var rs = await thuchiSv.ExportBill_PT(detail.PhieuthuID!);
            CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);

        }
        catch (Exception ex)
        {
            CallSnackBar("Throw exception: " + ex.Message, MudBlazor.Severity.Error);
        }
        finally
        {
            _processingUpload = false;
        }
    }
