@page "/Phieuthu"
@using System.Globalization
@attribute [Authorize]
@inject GlobalServices gsv
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject AccountService asv
@inject SharedServices ssv
@inject BookingService bksv 
@inject IJSRuntime JSRuntime
@inject SupportServices supsv
@inject IStringLocalizer<SharedResource> Localizer
@inject LocalChargesServices lcsv
@inject PhieuThu_Chi_Services thuchiSv
@inject CustomerService Cussv
@inject HistoryLogService HistoryLogService
@using System.Text.Json;


<style>
    .class-dialog-custom {
        backdrop-filter: blur(10px);
        transition: none !important;
        animation: none !important;
    }

    .selected {
        background: #855ff3 !important;
    }

    .selected > td {
        color: white !important;
    }

    .selected > td .mud-input {
        color: white !important;
    }

    .labelCustomColor label {
        font-weight: bold;
        color: #118AB2 !important;
    }

    .mud-table thead {
        background-color: #118AB2;
    }

    .mud-table th {
        background-color: #118AB2 !important;
        color: white !important;
    }
    .mud-table-foot tr{
        background-color: #118AB2 !important;
    }
    .footer-cell{
        background-color: #118AB2 !important;
        color: white !important;
    }
    .filter-header-cell {
        background-color: white !important;
        color: black !important;
    }

    .mud-menu{
        display:none;
    }
    .no-wrap{
        white-space:nowrap;
    }

    .custom-right-align{
        text-align: right !important; 
    }

    .custom-label .mud-input-label {
        color: blue !important;
    }
</style>

<PageTitle>@Localizer["Phieuthu"] </PageTitle>
<MudText Class="pa-2" Typo="Typo.h6">@Localizer["Phieuthu"]</MudText>
<MudStack Row Justify="Justify.FlexStart" Class="pa-4">

    <MudButton  HtmlTag="label"
                OnClick="Refresh"
                Size="Size.Small" Color="Color.Primary" Variant="   Variant.Filled"
                StartIcon="@Icons.Material.Filled.Refresh">
        @Localizer["reload"]
    </MudButton>

    <MudButton  HtmlTag="label"
                 @onclick="@((e) => OpenCreateDialog(new Models.M_PhieuThu()))"
                Size="Size.Small" Color="Color.Secondary" Variant="Variant.Filled"
                StartIcon="@Icons.Material.Filled.Add">
        @Localizer["new"]
    </MudButton>

    <MudButton HtmlTag="label"
               @onclick="@((e) => OpenEditDialog(detail))"
               Size="Size.Small" Color="Color.Info" Variant="Variant.Filled"
               StartIcon="@Icons.Material.Filled.Edit">
        @Localizer["edit"]
    </MudButton>

    <MudButton HtmlTag="label"
                   @onclick="@((e) => OpenDuplicateDialog(detail))"
                   Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled"
                   StartIcon="@Icons.Material.Filled.CopyAll">
            @Localizer["duplicate"]
        </MudButton>

    <MudButton Disabled="_processingUpload"
               OnClick="ExportBill"
               Size="Size.Small" Color="Color.Secondary" Variant="Variant.Filled"
               StartIcon="@Icons.Material.Filled.Download">
        @if (_processingUpload)
        {
            <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
            <MudText Class="ms-2">Processing</MudText>
        }
        else
        {
            <MudText>@Localizer["Export_Bill"]</MudText>
        }
    </MudButton>
     <MudTextField @bind-Value="_searchString" Placeholder="@Localizer["Search"]" Adornment="Adornment.Start" Immediate="true"
                  AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0" TextChanged="OnSearchTextChanged"></MudTextField>

</MudStack>

<MudDataGrid T="M_PhieuThu" Items="@filteredItems" Filterable="true" @ref="mudTable" Class="pa-4" Bordered="true"
                FilterMode="@DataGridFilterMode.ColumnFilterRow" Dense="true" Virtualize="true" QuickFilter="@FilterFunc1"
                FixedHeader="true" FixedFooter="true" HeaderClass="no-wrap" FooterClass="no-wrap"
                ReadOnly="false" CommittedItemChanges="@CommittedItem" RowClassFunc="@SelectedRowClassFunc"
                RowClick="@RowClicked" EditDialogOptions="@options"
             ColumnResizeMode="@(_resizeColumn ? ResizeMode.Column : ResizeMode.Container)" Loading="_loading">

    <Columns>
        <HierarchyColumn T="M_PhieuThu" />

        <TemplateColumn CellClass="d-flex justify-end">
            <CellTemplate>
                <MudIconButton Icon="@Icons.Material.Outlined.Delete" OnClick="@(()=>DeleteItem(context.Item))" />
            </CellTemplate>
        </TemplateColumn>


        <PropertyColumn Property="x => CustomerName(x.Customer_Id)" Title="@Localizer["Customer"]" CellStyleFunc="_cellStyleFunc">
            <EditTemplate>
                <MudSelect @bind-Value="context.Item.Customer_Id" Label="@Localizer["Customer"]">
                    @foreach (var item in List_Cus)
                    {
                        <MudSelectItem Value="@item.Customer_ID">@item.COMPANY</MudSelectItem>
                    }
                </MudSelect>
            </EditTemplate>
        </PropertyColumn>

        <PropertyColumn Property="x => x.SoPhieuthu" Title="@Localizer["SoPhieuthu"]" CellStyleFunc="_cellStyleFunc"></PropertyColumn>
        <PropertyColumn Property="x => x.TKNo" Title="@Localizer["TKNo"]" CellStyleFunc="_cellStyleFunc"></PropertyColumn>
        <PropertyColumn Property="x => x.TKCo" Title="@Localizer["TKCO"]" CellStyleFunc="_cellStyleFunc"></PropertyColumn>
        <PropertyColumn Property="x => x.Taikhoan_Doiung" Title="@Localizer["TaikhoanDoiung"]" CellStyleFunc="_cellStyleFunc"></PropertyColumn>
        <PropertyColumn Property="x => x.Ngay" Title="@Localizer["NGAY"]" CellStyleFunc="_cellStyleFunc" Format="dd/MMM/yyyy"></PropertyColumn>
        <PropertyColumn Property="x => x.Ngayhachtoan" Title="@Localizer["Ngayhachtoan"]" CellStyleFunc="_cellStyleFunc" Format="dd/MMM/yyyy"></PropertyColumn>
        <PropertyColumn Property="x => x.PTTT" Title="@Localizer["PTTT"]" CellStyleFunc="_cellStyleFunc"></PropertyColumn>
        <PropertyColumn Property="x => x.Noidung" Title="@Localizer["noidung"]" CellStyleFunc="_cellStyleFunc"></PropertyColumn>
        <PropertyColumn Property="x => x.Sotien" Title="@Localizer["sotien"]" Format="#,##0.##" Culture="_en" CellStyleFunc="_cellStyleFunc" CellClass="custom-right-align"></PropertyColumn>
        <PropertyColumn Property="x => x.Tigia" Title="@Localizer["tigia"]" Format="#,##0.##" Culture="_en" CellStyleFunc="_cellStyleFunc" CellClass="custom-right-align"></PropertyColumn>
        <PropertyColumn Property="x => x.Currency" Title="@Localizer["Loaitiente"]" CellStyleFunc="_cellStyleFunc"></PropertyColumn>
        <PropertyColumn Property="x => x.Chungtu" Title="@Localizer["Chungtukemtheo"]" CellStyleFunc="_cellStyleFunc"></PropertyColumn>
        <PropertyColumn Property="x => x.Nguoinoptien" Title="@Localizer["Nguoinoptien"]" CellStyleFunc="_cellStyleFunc"></PropertyColumn>
        <PropertyColumn Property="x => x.BillNo" Title="@Localizer["BillNo"]" CellStyleFunc="_cellStyleFunc"></PropertyColumn>
        <PropertyColumn Property="x => x.Bank" Title="@Localizer["Bank"]" CellStyleFunc="_cellStyleFunc"></PropertyColumn>
        <PropertyColumn Property="x => x.Branch" Title="@Localizer["Branch"]" CellStyleFunc="_cellStyleFunc"></PropertyColumn>
        <PropertyColumn Property="x => x.Loaiphieu" Title="@Localizer["Loaiphieu"]" CellStyleFunc="_cellStyleFunc"></PropertyColumn>
        <PropertyColumn Property="x => x.Socont" Title="@Localizer["socont"]" CellStyleFunc="_cellStyleFunc"></PropertyColumn>
        <PropertyColumn Property="x => x.Travotai" Title="@Localizer["Travotai"]" CellStyleFunc="_cellStyleFunc"></PropertyColumn>
        <PropertyColumn Property="x => x.Code" Title="@Localizer["Code"]" CellStyleFunc="_cellStyleFunc"></PropertyColumn>
        <PropertyColumn Property="x => x.Ruthangtaibai" Title="@Localizer["Ruthangtaibai"]" CellStyleFunc="_cellStyleFunc"></PropertyColumn>
        <PropertyColumn Property="x => x.Soluongcont" Title="@Localizer["Soluongcont"]" CellStyleFunc="_cellStyleFunc"></PropertyColumn>
        <PropertyColumn Property="x => x.Hanlenhharong" Title="@Localizer["hanlenhharong"]" CellStyleFunc="_cellStyleFunc"></PropertyColumn>
        <PropertyColumn Property="x => x.Quyenso" Title="@Localizer["Quyenso"]" CellStyleFunc="_cellStyleFunc"></PropertyColumn>

        <PropertyColumn Property="x => x.Sohoadon" Title="@Localizer["sohoadon"]" CellStyleFunc="_cellStyleFunc"></PropertyColumn>
        <PropertyColumn Property="x => x.Soseri" Title="@Localizer["Soseri"]" CellStyleFunc="_cellStyleFunc"></PropertyColumn>
        <PropertyColumn Property="x => x.Trangthai" Title="@Localizer["status"]" CellStyleFunc="_cellStyleFunc"></PropertyColumn>
        <PropertyColumn Property="x => x.Mbl" Title="@Localizer["MBL"]" CellStyleFunc="_cellStyleFunc"></PropertyColumn>
        <PropertyColumn Property="x => x.Sodudauky" Title="@Localizer["Sodudauky"]" CellStyleFunc="_cellStyleFunc"></PropertyColumn>
        <PropertyColumn Property="x => x.Lastcargo" Title="@Localizer["Lastcargo"]" CellStyleFunc="_cellStyleFunc"></PropertyColumn>
        <PropertyColumn Property="x => x.Depoaddress" Title="@Localizer["depoaddress"]" CellStyleFunc="_cellStyleFunc"></PropertyColumn>
        <PropertyColumn Property="x => x.Luuycuoc" Title="@Localizer["Luuycuoc"]" CellStyleFunc="_cellStyleFunc"></PropertyColumn>

        <PropertyColumn Property="x => x.Continued" Title="@Localizer["Continued"]" CellStyleFunc="_cellStyleFunc"></PropertyColumn>

        <TemplateColumn Title="@Localizer["Approve"]">
            <CellTemplate>
                <MudCheckBox @bind-Checked="context.Item.Approve" @bind-Value="context.Item.Approve" @bind-Value:after="@(()=> OnApproveCheckboxWrapper(context.Item))">
                </MudCheckBox>
            </CellTemplate>
        </TemplateColumn>

        <PropertyColumn Property="x => x.Editable" Title="@Localizer["Editable"]" CellStyleFunc="_cellStyleFunc"></PropertyColumn>
        <PropertyColumn Property="x => x.UserUpdate" Title="@Localizer["UserUpdate"]" CellStyleFunc="_cellStyleFunc"></PropertyColumn>
        <PropertyColumn Property="x => x.DateUpdate" Title="@Localizer["Dateupdate"]" CellStyleFunc="_cellStyleFunc"></PropertyColumn>

    </Columns>

    <PagerContent>
        <div style="display: flex; justify-content: space-between; align-items: center; width: 100%;">
            <div style="font-weight: bold;">
                Total Amount(VND):
                <span style="color: darkgreen">
                    @(FilteredTotalAmount_VND?.ToString("#,##0.##") ?? "0")
                </span>
            </div>

            <div style="font-weight: bold;">
                Total Amount(USD):
                <span style="color: darkgreen">
                    @(FilteredTotalAmount_USD?.ToString("#,##0.##") ?? "0")
                </span>
            </div>
            <MudDataGridPager T="M_PhieuThu" PageSizeOptions="@(new int[] { 8, 10, 20 })" />
        </div>
    </PagerContent>
</MudDataGrid>

@code {
    List<M_PhieuThu> Listdata = new List<M_PhieuThu>();
    MudDataGrid<M_PhieuThu> mudTable;
    AuthUser user;
    string mailtp, mailpp;
    string usr;
    private List<string> ListUser { get; set; } = new List<string>();
    string UserHanding;
    List<string> trangthais = new List<string>();
    private List<Models.TrangThai> M_Trangthais = new List<Models.TrangThai>();
    private string searchText_pol = "";
    private string searchText_pod = "";
    private List<PortModel> filteredPorts = new List<PortModel>();
    private List<PortModel> filteredPorts_pod = new List<PortModel>();
    private List<PortModel> Ports = new List<PortModel>();

    private bool _resizeColumn;
    M_PhieuThu detail;
    private string _searchString;
    private List<M_Customer> filteredCarr = new List<M_Customer>();
    private List<M_Customer> Cuss_Carr = new List<M_Customer>();
    private List<M_Customer> List_Cus = new List<M_Customer>();
    public CultureInfo _en = CultureInfo.GetCultureInfo("en-US");
    public decimal? FilteredTotalAmount_VND;
        public decimal? FilteredTotalAmount_USD;
        private List<M_PhieuThu> filteredItems;

 
    protected async override Task OnInitializedAsync()
    {
        M_Trangthais = await supsv.GetListTrangThai();
        var tts = await supsv.GetListTrangThai();
        trangthais = tts.Where(x => x.Tieude == "Phieuthu").OrderBy(x => x.Noidung).Select(x => x.Noidung).ToList();
        List_Cus = await Cussv.GetList();
        ListUser = await asv.GetList_User_handle() ?? new List<string>();
        usr = asv.GetAuth().Result.User.Identity!.Name!;
        Cuss_Carr = await lcsv.GetList_Customer_line();
        // await Refresh();
    }



    bool _loading = false;
    async Task Refresh()
    {
        try
        {
     
            detail = null!;
            _loading = true;
            Listdata.Clear();
            
            await Task.Delay(500);
            if (!await ssv.CheckPermission(usr, "View", "Phieuthu"))
            {
                CallSnackBar("You have not access to view", MudBlazor.Severity.Warning);
                return;
            }
            Listdata = await thuchiSv.GetList_PhieuThu();
            filteredItems = Listdata;

            FilteredTotalAmount_VND = Convert.ToDecimal(filteredItems
            .Where(item => item.Currency == "VND") 
            .Sum(item => item.Sotien ?? 0));

               FilteredTotalAmount_USD = Convert.ToDecimal(filteredItems
            .Where(item => item.Currency == "USD")  
            .Sum(item => item.Sotien ?? 0));

            StateHasChanged();
        }
        catch(Exception ex)
        {
            CallSnackBar("Something went wrong!, error code: " + ex.Message, MudBlazor.Severity.Warning);
        }
        finally
        {
            _loading = false;
        }

    }

    void CallSnackBar(string message, MudBlazor.Severity severity)
    {
        
        Snackbar.Configuration.SnackbarVariant = Variant.Filled;
        Snackbar.Configuration.MaxDisplayedSnackbars = 3;
        Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopRight;
        Snackbar.Add(message, severity);
    }
    void RowClicked(DataGridRowClickEventArgs<M_PhieuThu> args)
    {
        detail = args.Item;
    }
    private int selectedRowNumber = -1;
    private string SelectedRowClassFunc(M_PhieuThu m, int rowNumber)
    {
        if (selectedRowNumber == rowNumber)
        {
            selectedRowNumber = -1;
            return string.Empty;
        }
        else if (mudTable.SelectedItem != null && mudTable.SelectedItem.Equals(m))
        {
            selectedRowNumber = rowNumber;
            return "selected";
        }
        else
        {
            return string.Empty;
        }
    }

    async Task CommittedItem(M_PhieuThu item)
    {
        item.UserUpdate = asv.GetAuth().Result.User.Identity!.Name!;
        item.DateUpdate = DateTime.Now.ToString("dd/MMM/yyyy");
        var rs = item.PhieuthuID != Guid.Empty ? await thuchiSv.UpdatePhieuthu_Detail(item) : await thuchiSv.CreatePhieuThu_Detail(item);
        CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);

        await Refresh();
    }
    int? index_no;
  
    async Task DeleteItem(M_PhieuThu item)
    {
        if (item.Approve == true)
        {
            CallSnackBar("Data đã được Approve!!! , vui lòng bỏ Approve", MudBlazor.Severity.Warning);
            return;
        }
        if (!await ssv.CheckPermission(usr, "Delete", "Phieuthu"))
        {
            CallSnackBar("You have not access to Delete", MudBlazor.Severity.Warning);
            return;
        }
        var resultMess = await DialogService.ShowMessageBox(
                "Warning",
                "Deleting can not be undone!",
                yesText: "Delete!", cancelText: "Cancel");

        if (resultMess.HasValue)
        {
            var rs = await thuchiSv.DeletePhieuThu_Detail(item);
            await HistoryLogService.LogAsync(usr, "Delete", "Phieuthu", item.PhieuthuID, item.SoPhieuthu,item);
            CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
            await Refresh();
        }
    }

    DialogOptions options = new DialogOptions 
    {
        ClassBackground = "class-dialog-custom",
        FullWidth = true,
        MaxWidth = MaxWidth.Medium,
        CloseOnEscapeKey = false,
        DisableBackdropClick = true
    };
    string search;

    private bool FilterFunc1(M_PhieuThu sbd) => FilterFunc(sbd, search);

    private bool FilterFunc(M_PhieuThu sbd, string searchString)
    {
        if (string.IsNullOrWhiteSpace(sbd.SoPhieuthu))
            return true;
        if (string.IsNullOrWhiteSpace(searchString))
            return true;
        if (sbd.SoPhieuthu!.Contains(searchString, StringComparison.OrdinalIgnoreCase))
            return true;
        if ($"{sbd.SoPhieuthu} ".Contains(searchString))
            return true;
        return false;
    }

    private Func<M_PhieuThu, string> _cellStyleFunc => x =>
       {
           return "color: #000000";

       };

      private async Task OpenCreateDialog(Models.M_PhieuThu tr)
    {
        var optionsdialog = new DialogOptions { ClassBackground = "class-dialog-custom", FullWidth = true, MaxWidth = MaxWidth.Medium };

        if (await ssv.CheckPermission(asv.GetAuth().Result.User.Identity.Name, "Add", "Phieuthu"))
        {

            DialogOptions closeOnEscapeKey = new DialogOptions() { CloseOnEscapeKey = true };
            var parameters = new DialogParameters<ADD> { { x => x._Phieuthu_Detail, tr }, { x => x.Status, "add" } };

            var dialog = await DialogService.ShowAsync<ADD>(tr.PhieuthuID == Guid.Empty ? "Receipts List Create" : "Receipts List Edit", parameters, optionsdialog);
            var result = await dialog.Result;
            if (!result.Canceled)
            {
                var data = (M_PhieuThu)result.Data;
                var rs = await thuchiSv.UpdateCreatePhieuThu(data);
                await HistoryLogService.LogAsync(usr, "ADD Phieu Thu", "Phieuthu", data.PhieuthuID, data.SoPhieuthu, data);
                MudBlazor.Severity severity;
                if (rs[1] == "1")
                    severity = MudBlazor.Severity.Success;
                else
                    severity = MudBlazor.Severity.Error;

                CallSnackBar(rs[0], severity);
        
                await HandleRefresh_create(data.PhieuthuID);

            }

            return;

        }
        else
        {
            CallSnackBar("You have not access to Create", MudBlazor.Severity.Warning);
            return;
        }

    }

    async Task HandleRefresh_create(Guid? id)
    {
        try
        {

            detail = null;

            Listdata.Clear();
    
            await Task.Delay(500);

            if (!await ssv.CheckPermission(asv.GetAuth().Result.User.Identity.Name, "View", "Phieuthu"))
            {
                CallSnackBar("You have not access to view", MudBlazor.Severity.Warning);

                return;
            }
            Listdata = await thuchiSv.GetListPhieuthu_create(id);
            filteredItems = Listdata;

            FilteredTotalAmount_VND = Convert.ToDecimal(filteredItems
            .Where(item => item.Currency == "VND") 
            .Sum(item => item.Sotien ?? 0));

               FilteredTotalAmount_USD = Convert.ToDecimal(filteredItems
            .Where(item => item.Currency == "USD")  
            .Sum(item => item.Sotien ?? 0));

            StateHasChanged();
        }
        finally
        {


        }
    }

    private async Task OpenEditDialog(Models.M_PhieuThu tr)
    {
      
        var optionsdialog = new DialogOptions { ClassBackground = "class-dialog-custom", FullWidth = true, MaxWidth = MaxWidth.Medium };
        if (tr == null)
        {
            CallSnackBar("Please select Data", MudBlazor.Severity.Warning);
            return;
        }
        if (tr.Approve == true)
        {
            CallSnackBar("Data đã được Approve!!! , vui lòng bỏ Approve", MudBlazor.Severity.Warning);
            return;
        }
        if (await ssv.CheckPermission(asv.GetAuth().Result.User.Identity.Name, "Edit", "Phieuthu"))
        {
            var OldData = JsonSerializer.Deserialize<M_PhieuThu>(JsonSerializer.Serialize(tr));
            DialogOptions closeOnEscapeKey = new DialogOptions() { CloseOnEscapeKey = true };
            var parameters = new DialogParameters<ADD> { { x => x._Phieuthu_Detail, tr }, { x => x.Status, "edit" } };

            var dialog = await DialogService.ShowAsync<ADD>(tr.PhieuthuID == Guid.Empty ? "Receipts List Edit" : "Receipts List Edit", parameters, optionsdialog);
            var result = await dialog.Result;
            // Giữ nguyên dòng được chọn
            selectedRowNumber = selectedRowNumber;
            StateHasChanged();

            if (!result.Canceled)
            {
                var data = (M_PhieuThu)result.Data;
                var rs = await  thuchiSv.UpdateCreatePhieuThu(data);
                await HistoryLogService.LogAsync(usr, "Update Phieu Thu", "Phieuthu", data.PhieuthuID, data.SoPhieuthu, new { OldData = OldData, NewData = data });
                MudBlazor.Severity severity;
                if (rs[1] == "1")
                    severity = MudBlazor.Severity.Success;
                else
                    severity = MudBlazor.Severity.Error;

                CallSnackBar(rs[0], severity);
                Refresh();
            }

            return;

        }
        else
        {
            CallSnackBar("You have not access to Edit", MudBlazor.Severity.Warning);
            return;
        }

    }
    private async Task OpenDuplicateDialog(Models.M_PhieuThu tr)
    {
       
        var optionsdialog = new DialogOptions { ClassBackground = "class-dialog-custom", FullWidth = true, MaxWidth = MaxWidth.Medium };
        if (tr == null)
        {
            CallSnackBar("Please select Data", MudBlazor.Severity.Warning);
            return;
        }

        if (await ssv.CheckPermission(asv.GetAuth().Result.User.Identity.Name, "Add", "Phieuthu"))
        {
            var OldData = JsonSerializer.Deserialize<M_PhieuThu>(JsonSerializer.Serialize(tr));
            DialogOptions closeOnEscapeKey = new DialogOptions() { CloseOnEscapeKey = true };
            var parameters = new DialogParameters<ADD> { { x => x._Phieuthu_Detail, tr }, { x => x.Status, "Duplicate" } };

            var dialog = await DialogService.ShowAsync<ADD>(tr.PhieuthuID == Guid.Empty ? "Receipts List Create" : "Receipts List Create", parameters, optionsdialog);
            var result = await dialog.Result;
            // Giữ nguyên dòng được chọn
            selectedRowNumber = selectedRowNumber;
            StateHasChanged();

            if (!result.Canceled)
            {
                var data = (M_PhieuThu)result.Data;
                var rs = await thuchiSv.UpdateCreatePhieuThu(data);
                await HistoryLogService.LogAsync(usr, "Duplicate", "Phieuthu", data.PhieuthuID, data.SoPhieuthu, new { OldData = OldData, NewData = data });
                MudBlazor.Severity severity;
                if (rs[1] == "1")
                    severity = MudBlazor.Severity.Success;
                else
                    severity = MudBlazor.Severity.Error;

                CallSnackBar(rs[0], severity);
                await HandleRefresh_create(data.PhieuthuID);
            }

            return;

        }
        else
        {
            CallSnackBar("You have not access to Create", MudBlazor.Severity.Warning);
            return;
        }

    }

    private async Task Get_PhieuThuNo(M_PhieuThu item)
    {

        int formattedYear = DateTime.Now.Year;
        int formattedMonth = DateTime.Now.Month;

        string usr = asv.GetAuth().Result.User.Identity!.Name!;
        var refno = await supsv.GetRefNoByFunc("Phieuthu", formattedMonth, formattedYear, usr);
      
        var rs = asv.GetUserDetail();
        var cn = rs.Branch;
        item.SoPhieuthu = cn + "PT_" + formattedYear.ToString() + formattedMonth.ToString() + refno.Value.ToString("D4");

    }


    string CustomerName(Guid? customerID)
    {
        var rs = List_Cus.FirstOrDefault(x => x.Customer_ID == customerID);
        return rs != null ? rs.COMPANY! : "";
    }

     private void OnSearchTextChanged(string newValue)
    {
        // Lọc các Customer_ID có tên khách hàng khớp với _searchString
        var matchingCustomerIds = List_Cus
       .Where(cus => !string.IsNullOrEmpty(cus.COMPANY) && cus.COMPANY.Contains(_searchString, StringComparison.OrdinalIgnoreCase))
       .Select(cus => cus.Customer_ID)
       .ToList();


        filteredItems = Listdata.Where(item =>
            matchingCustomerIds.Contains(item.Customer_Id.GetValueOrDefault()) ||
            item.SoPhieuthu.Contains(newValue, StringComparison.OrdinalIgnoreCase) ||  
            item.TKNo.ToString().Contains(newValue, StringComparison.OrdinalIgnoreCase) ||
            item.TKCo.ToString().Contains(newValue, StringComparison.OrdinalIgnoreCase)   

        ).ToList();      

        FilteredTotalAmount_VND = Convert.ToDecimal(filteredItems
          .Where(item => item.Currency == "VND")
          .Sum(item => item.Sotien ?? 0));

        FilteredTotalAmount_USD = Convert.ToDecimal(filteredItems
     .Where(item => item.Currency == "USD")
     .Sum(item => item.Sotien ?? 0));
    }

    private bool _processingUpload = false;

    private async Task ExportBill()
    {
        try
        {
            _processingUpload = true;
            StateHasChanged();
            await Task.Delay(1);
            if (detail == null)
            {
                CallSnackBar("you must select 1 Data.", MudBlazor.Severity.Warning);
                return;
            }
            var rs = await thuchiSv.ExportBill_PT(detail.PhieuthuID!);
            CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);

        }
        catch (Exception ex)
        {
            CallSnackBar("Throw exception: " + ex.Message, MudBlazor.Severity.Error);
        }
        finally
        {
            _processingUpload = false;
        }
    }
    private async Task OnApproveCheckboxWrapper(M_PhieuThu item)
    {
        if (await ssv.CheckPermission(asv.GetAuth().Result.User.Identity.Name, "Approve", "Phieuthu"))
        {
            var rs = await thuchiSv.UpdateCreatePhieuThu(item);
            MudBlazor.Severity severity;
            if (rs[1] == "1")
                severity = MudBlazor.Severity.Success;

            else
                severity = MudBlazor.Severity.Error;

            CallSnackBar(rs[0], severity);
        }
        else
        {
            CallSnackBar("You have not access to Approve", MudBlazor.Severity.Warning);
            return;
        }

    }
}
