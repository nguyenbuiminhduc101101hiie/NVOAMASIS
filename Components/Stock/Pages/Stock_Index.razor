@page "/Stock"
@attribute [Authorize]
@inject StockService StockSvc
@inject ExcelImportCrudService ExcelImportSvc
@inject ISnackbar Snackbar
@inject AccountService asv
@inject IDialogService DialogService
@inject SharedServices ssv
@inject IStringLocalizer<SharedResource> Localizer
@using Microsoft.AspNetCore.Components.Forms

<PageTitle>Stock</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="pa-2">
    <MudTabs @bind-ActivePanelIndex="_ymActiveTab">
        <MudTabPanel Text="Stock">
            <MudPaper Class="pa-3 mb-3" Elevation="1">
                <MudGrid Spacing="2">
                    <MudItem xs="12" sm="6" md="4" lg="3">
                        <MudSelect T="string?" @bind-Value="_filterLocation" Label="Location" Variant="Variant.Outlined" Dense="true" Clearable="true" Margin="Margin.Dense">
                            <MudSelectItem T="string?" Value="@((string?)null)">— Tất cả —</MudSelectItem>
                            @foreach (var loc in _locations)
                            {
                                <MudSelectItem T="string?" Value="@loc">@loc</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="4" lg="3">
                        <MudTextField @bind-Value="_filterContainer" Label="Container No." Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" />
                    </MudItem>
                    <MudItem xs="12" sm="6" md="4" lg="3">
                        <MudTextField @bind-Value="_filterConsignee" Label="Consignee" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" />
                    </MudItem>
                    <MudItem xs="12" sm="6" md="4" lg="3">
                        <MudTextField @bind-Value="_filterYom" Label="YOM" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" />
                    </MudItem>
                    <MudItem xs="12" sm="6" md="4" lg="3">
                        <MudDatePicker @bind-Date="_filterDateInFrom" Label="Date in (từ)" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" DateFormat="dd/MM/yyyy" Clearable="true" />
                    </MudItem>
                    <MudItem xs="12" sm="6" md="4" lg="3">
                        <MudDatePicker @bind-Date="_filterDateInTo" Label="Date in (đến)" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" DateFormat="dd/MM/yyyy" Clearable="true" />
                    </MudItem>
                    <MudItem xs="12" Class="d-flex flex-wrap gap-2 align-center">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Search" OnClick="SearchAsync" Disabled="_loading">Tìm kiếm</MudButton>
                        <MudButton Variant="Variant.Filled" Color="Color.Secondary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Refresh" OnClick="RefreshAsync" Disabled="_loading">Làm mới</MudButton>
                        <MudButton Variant="Variant.Filled" Color="Color.Error" Size="Size.Small" StartIcon="@Icons.Material.Filled.Delete" OnClick="DeleteSelectedAsync" Disabled="_loading || _selected is null">Xóa</MudButton>
                        <MudButton HtmlTag="label" Variant="Variant.Filled" Color="Color.Tertiary" Size="Size.Small" StartIcon="@Icons.Material.Filled.UploadFile" Disabled="_loading">
                            Import Excel
                            <InputFile OnChange="OnImportExcel" accept=".xlsx,.xlsm" style="display:none" />
                        </MudButton>
                    </MudItem>
                </MudGrid>
            </MudPaper>

            <MudText Typo="Typo.body2" Class="mb-2">@_items.Count bản ghi</MudText>

            @if (_containerTracking != null)
            {
                <MudPaper Class="pa-3 mb-3" Elevation="1">
                    <MudText Typo="Typo.subtitle1" Class="mb-2">Container Tracking</MudText>
                    <MudGrid Spacing="2">
                        <MudItem xs="12" sm="6" md="4" lg="2"><MudText Typo="Typo.caption">Container</MudText><MudText Typo="Typo.body2">@_containerTracking.Container</MudText></MudItem>
                        <MudItem xs="12" sm="6" md="4" lg="2"><MudText Typo="Typo.caption">Type</MudText><MudText Typo="Typo.body2">@(_containerTracking.Type ?? string.Empty)</MudText></MudItem>
                        <MudItem xs="12" sm="6" md="4" lg="2"><MudText Typo="Typo.caption">Booking</MudText><MudText Typo="Typo.body2">@(_containerTracking.Booking ?? string.Empty)</MudText></MudItem>
                        <MudItem xs="12" sm="6" md="4" lg="2"><MudText Typo="Typo.caption">DateIn</MudText><MudText Typo="Typo.body2">@FormatDateTime(_containerTracking.DateIn)</MudText></MudItem>
                        <MudItem xs="12" sm="6" md="4" lg="2"><MudText Typo="Typo.caption">DateOut</MudText><MudText Typo="Typo.body2">@FormatDateTime(_containerTracking.DateOut)</MudText></MudItem>
                        <MudItem xs="12" sm="6" md="4" lg="2"><MudText Typo="Typo.caption">Days</MudText><MudText Typo="Typo.body2">@(_containerTracking.Days?.ToString() ?? string.Empty)</MudText></MudItem>
                    </MudGrid>
                </MudPaper>
            }

            <div style="overflow-x: auto;">
                <MudDataGrid T="M_Stock" Items="@_items" Dense="true" Bordered="true" Striped="true" Hover="true" Loading="_loading" Class="stock-grid-autofit" HeaderClass="no-wrap"
                             RowClick="OnRowClick" RowClassFunc="@StockRowClassFunc">
                    <Columns>
                        <PropertyColumn Property="x => x.Container" Title="Container" />
                        <PropertyColumn Property="x => x.Type" Title="Type" />
                        <PropertyColumn Property="x => x.IsoType" Title="ISO Type" />
                        <PropertyColumn Property="x => x.Opr" Title="Opr" />
                        <PropertyColumn Property="x => x.FE" Title="F/E" />
                        <PropertyColumn Property="x => x.Move" Title="Move" />
                        <TemplateColumn Title="Date in"><CellTemplate>@context.Item.DateIn?.ToString("dd/MM/yyyy")</CellTemplate></TemplateColumn>
                        <TemplateColumn Title="Time"><CellTemplate>@FormatTime(context.Item.TimeIn)</CellTemplate></TemplateColumn>
                        <PropertyColumn Property="x => x.Consignee" Title="Consignee" />
                        <PropertyColumn Property="x => x.Position" Title="Position" />
                        <PropertyColumn Property="x => x.Days" Title="Days" />
                        <PropertyColumn Property="x => x.Location" Title="Location" />
                        <PropertyColumn Property="x => x.YOM" Title="YOM" />
                        <PropertyColumn Property="x => x.TareWeight" Title="Tare weight" />
                        <PropertyColumn Property="x => x.SealNo" Title="Seal No" />
                        <PropertyColumn Property="x => x.Note2" Title="Note2" />
                        <PropertyColumn Property="x => x.Note3" Title="Note3" />
                        <PropertyColumn Property="x => x.VGM" Title="VGM" />
                        <PropertyColumn Property="x => x.MaxGross" Title="Max gross" />
                        <PropertyColumn Property="x => x.Remark" Title="Remark" />
                        <PropertyColumn Property="x => x.Status" Title="Status" />
                        <PropertyColumn Property="x => x.Grade" Title="Grade" />
                        <PropertyColumn Property="x => x.CleanMethod" Title="Clean Method" />
                        <PropertyColumn Property="x => x.CleanStatus" Title="Clean Status" />
                        <TemplateColumn Title="PTI date"><CellTemplate>@context.Item.PtiDate?.ToString("dd/MM/yyyy")</CellTemplate></TemplateColumn>
                        <PropertyColumn Property="x => x.PtiSetting" Title="PTI setting" />
                        <PropertyColumn Property="x => x.PtiStatus" Title="PTI status" />
                        <TemplateColumn Title="Estimated date"><CellTemplate>@context.Item.EstimatedDate?.ToString("dd/MM/yyyy")</CellTemplate></TemplateColumn>
                        <TemplateColumn Title="Approval date"><CellTemplate>@context.Item.ApprovalDate?.ToString("dd/MM/yyyy")</CellTemplate></TemplateColumn>
                        <TemplateColumn Title="Reject date"><CellTemplate>@context.Item.RejectDate?.ToString("dd/MM/yyyy")</CellTemplate></TemplateColumn>
                        <TemplateColumn Title="Repaired date"><CellTemplate>@context.Item.RepairedDate?.ToString("dd/MM/yyyy")</CellTemplate></TemplateColumn>
                        <TemplateColumn Title="Registered date"><CellTemplate>@context.Item.RegisteredDate?.ToString("dd/MM/yyyy")</CellTemplate></TemplateColumn>
                        <PropertyColumn Property="x => x.Shipper" Title="Shipper" />
                        <PropertyColumn Property="x => x.Booking" Title="Booking" />
                        <TemplateColumn Title="Date import"><CellTemplate>@context.Item.DateImport?.ToString("dd/MM/yyyy HH:mm")</CellTemplate></TemplateColumn>
                        <PropertyColumn Property="x => x.UserImport" Title="User import" />
                    </Columns>
                    <PagerContent><MudDataGridPager T="M_Stock" PageSizeOptions="new int[] { 10, 25, 50, 100 }" /></PagerContent>
                </MudDataGrid>
            </div>
        </MudTabPanel>
        <MudTabPanel Text="@Localizer["Ym_Tab_HDS"]">
            @RenderYmToolbar()
            <MudDataGrid T="M_StockGateOut_HDS_08042026" Items="@_ymHdsItems" Dense="true" Striped="true" Hover="true" Bordered="true" RowClick="OnYmHdsRowClick">
                <Columns>
                    <PropertyColumn Property="x => x.SoCont" Title="@Localizer["Ym_Col_SoCont"]" />
                    <PropertyColumn Property="x => x.TenTau" Title="@Localizer["Ym_Col_TenTau"]" />
                    <TemplateColumn Title="@Localizer["Ym_Col_NgayCapBen"]"><CellTemplate>@context.Item.NgayCapBen?.ToString("dd/MM/yyyy HH:mm")</CellTemplate></TemplateColumn>
                    <PropertyColumn Property="x => x.SoBooking" Title="@Localizer["Ym_Col_SoBooking"]" />
                    <PropertyColumn Property="x => x.SoBL" Title="@Localizer["Ym_Col_SoBL"]" />
                    <PropertyColumn Property="x => x.PhuongAn" Title="@Localizer["Ym_Col_PhuongAn"]" />
                    <PropertyColumn Property="x => x.TTHaiQuan" Title="@Localizer["Ym_Col_TTHaiQuan"]" />
                </Columns>
                <PagerContent><MudDataGridPager T="M_StockGateOut_HDS_08042026" /></PagerContent>
            </MudDataGrid>
        </MudTabPanel>

        <MudTabPanel Text="@Localizer["Ym_Tab_AG"]">
            @RenderYmToolbar()
            <MudDataGrid T="M_YardReport_AG_2026040307" Items="@_ymAgItems" Dense="true" Striped="true" Hover="true" Bordered="true" RowClick="OnYmAgRowClick">
                <Columns>
                    <PropertyColumn Property="x => x.SourceSheet" Title="@Localizer["Ym_Col_SourceSheet"]" />
                    <PropertyColumn Property="x => x.CNTRNO" Title="@Localizer["Ym_Col_CNTRNO"]" />
                    <PropertyColumn Property="x => x.SZ" Title="@Localizer["Ym_Col_SZ"]" />
                    <PropertyColumn Property="x => x.TP" Title="@Localizer["Ym_Col_TP"]" />
                    <PropertyColumn Property="x => x.ST" Title="@Localizer["Ym_Col_ST"]" />
                    <PropertyColumn Property="x => x.Location" Title="@Localizer["Ym_Col_Location"]" />
                    <PropertyColumn Property="x => x.Customer" Title="@Localizer["Ym_Col_Customer"]" />
                </Columns>
                <PagerContent><MudDataGridPager T="M_YardReport_AG_2026040307" /></PagerContent>
            </MudDataGrid>
        </MudTabPanel>

        <MudTabPanel Text="@Localizer["Ym_Tab_VSS"]">
            @RenderYmToolbar()
            <MudDataGrid T="M_YardMovement_VSS_26040808" Items="@_ymVssItems" Dense="true" Striped="true" Hover="true" Bordered="true" RowClick="OnYmVssRowClick">
                <Columns>
                    <PropertyColumn Property="x => x.SourceSheet" Title="@Localizer["Ym_Col_SourceSheet"]" />
                    <PropertyColumn Property="x => x.SOCONT" Title="@Localizer["Ym_Col_SOCONT"]" />
                    <PropertyColumn Property="x => x.KICHCO" Title="@Localizer["Ym_Col_KICHCO"]" />
                    <PropertyColumn Property="x => x.TRANGTHAI" Title="@Localizer["Ym_Col_TRANGTHAI"]" />
                    <TemplateColumn Title="@Localizer["Ym_Col_EXEC_TS"]"><CellTemplate>@context.Item.EXEC_TS?.ToString("dd/MM/yyyy HH:mm")</CellTemplate></TemplateColumn>
                    <PropertyColumn Property="x => x.BOOK_NO" Title="@Localizer["Ym_Col_BOOK_NO"]" />
                    <PropertyColumn Property="x => x.GIAO" Title="@Localizer["Ym_Col_GIAO"]" />
                </Columns>
                <PagerContent><MudDataGridPager T="M_YardMovement_VSS_26040808" /></PagerContent>
            </MudDataGrid>
        </MudTabPanel>

        <MudTabPanel Text="@Localizer["Ym_Tab_AMS"]">
            @RenderYmToolbar()
            <MudDataGrid T="M_YardMovement_AMS_26040816" Items="@_ymAmsItems" Dense="true" Striped="true" Hover="true" Bordered="true" RowClick="OnYmAmsRowClick">
                <Columns>
                    <PropertyColumn Property="x => x.SOCONT" Title="@Localizer["Ym_Col_SOCONT"]" />
                    <PropertyColumn Property="x => x.KICHCO" Title="@Localizer["Ym_Col_KICHCO"]" />
                    <PropertyColumn Property="x => x.TRANGTHAI" Title="@Localizer["Ym_Col_TRANGTHAI"]" />
                    <TemplateColumn Title="@Localizer["Ym_Col_EXEC_TS"]"><CellTemplate>@context.Item.EXEC_TS?.ToString("dd/MM/yyyy HH:mm")</CellTemplate></TemplateColumn>
                    <PropertyColumn Property="x => x.BOOK_NO" Title="@Localizer["Ym_Col_BOOK_NO"]" />
                    <PropertyColumn Property="x => x.GIAO" Title="@Localizer["Ym_Col_GIAO"]" />
                </Columns>
                <PagerContent><MudDataGridPager T="M_YardMovement_AMS_26040816" /></PagerContent>
            </MudDataGrid>
        </MudTabPanel>
    </MudTabs>
</MudContainer>

@code {
    private List<M_Stock> _items = new();
    private List<string> _locations = new();
    private bool _loading;
    private M_Stock? _selected;
    private StockContainerTrackingDto? _containerTracking;

    private string? _filterLocation;
    private string _filterContainer = string.Empty;
    private string _filterConsignee = string.Empty;
    private string _filterYom = string.Empty;
    private DateTime? _filterDateInFrom;
    private DateTime? _filterDateInTo;
    private int _ymActiveTab;
    private bool _ymLoading;
    private bool _ymCanView;
    private bool _ymCanAdd;
    private bool _ymCanEdit;
    private bool _ymCanDelete;
    private List<M_StockGateOut_HDS_08042026> _ymHdsItems = new();
    private List<M_YardReport_AG_2026040307> _ymAgItems = new();
    private List<M_YardMovement_VSS_26040808> _ymVssItems = new();
    private List<M_YardMovement_AMS_26040816> _ymAmsItems = new();
    private M_StockGateOut_HDS_08042026? _ymSelectedHds;
    private M_YardReport_AG_2026040307? _ymSelectedAg;
    private M_YardMovement_VSS_26040808? _ymSelectedVss;
    private M_YardMovement_AMS_26040816? _ymSelectedAms;

    protected override async Task OnInitializedAsync()
    {
        await RefreshAsync();
        await LoadYmPermissionAsync();
        if (_ymCanView)
            await RefreshYmCurrentTabAsync();
    }

    private void CallSnackBar(string message, MudBlazor.Severity severity)
    {
        Snackbar.Configuration.SnackbarVariant = Variant.Filled;
        Snackbar.Configuration.MaxDisplayedSnackbars = 3;
        Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopRight;
        Snackbar.Add(message, severity);
    }

    private async Task<bool> EnsureStockViewPermissionAsync()
    {
        if (!await ssv.CheckPermission(asv.GetAuth().Result.User.Identity!.Name!, "View", "Stock"))
        {
            CallSnackBar(Localizer["You have not access to view"], MudBlazor.Severity.Warning);
            return false;
        }

        return true;
    }

    private StockListFilter BuildFilter() => new(
        Location: string.IsNullOrWhiteSpace(_filterLocation) ? null : _filterLocation.Trim(),
        ContainerNo: string.IsNullOrWhiteSpace(_filterContainer) ? null : _filterContainer.Trim(),
        Consignee: string.IsNullOrWhiteSpace(_filterConsignee) ? null : _filterConsignee.Trim(),
        Yom: string.IsNullOrWhiteSpace(_filterYom) ? null : _filterYom.Trim(),
        DateInFrom: _filterDateInFrom,
        DateInTo: _filterDateInTo);

    private async Task SearchAsync()
    {
        _loading = true;
        try
        {
            if (!await EnsureStockViewPermissionAsync())
            {
                _items.Clear();
                _locations.Clear();
                _selected = null;
                _containerTracking = null;
                return;
            }

            _items = await StockSvc.GetFilteredAsync(BuildFilter());
            await LoadContainerTrackingAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add("Lỗi tìm kiếm: " + ex.Message, MudBlazor.Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task RefreshAsync()
    {
        _loading = true;
        try
        {
            if (!await EnsureStockViewPermissionAsync())
            {
                _items.Clear();
                _locations.Clear();
                _selected = null;
                _containerTracking = null;
                return;
            }

            _locations = await StockSvc.GetDistinctLocationsAsync();
            _items = await StockSvc.GetFilteredAsync(BuildFilter());
            await LoadContainerTrackingAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add("Lỗi tải dữ liệu: " + ex.Message, MudBlazor.Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private void OnRowClick(DataGridRowClickEventArgs<M_Stock> args)
    {
        _selected = args.Item;
    }

    private string StockRowClassFunc(M_Stock row, int _)
    {
        return _selected != null && _selected.StockID == row.StockID ? "selected" : string.Empty;
    }

    private async Task DeleteSelectedAsync()
    {
        if (!await ssv.CheckPermission(asv.GetAuth().Result.User.Identity!.Name!, "Delete", "Stock"))
        {
            CallSnackBar(Localizer["You have not access to Delete"], MudBlazor.Severity.Warning);
            return;
        }

        if (_selected is null)
        {
            Snackbar.Add("Chọn một dòng để xóa.", MudBlazor.Severity.Warning);
            return;
        }

        var label = string.IsNullOrWhiteSpace(_selected.Container) ? _selected.StockID.ToString() : _selected.Container;
        var confirm = await DialogService.ShowMessageBox(
            "Xác nhận xóa",
            $"Xóa bản ghi container \"{label}\"? Thao tác không hoàn tác.",
            yesText: "Xóa",
            cancelText: "Hủy");

        if (confirm != true)
            return;

        _loading = true;
        try
        {
            var (ok, err) = await StockSvc.DeleteAsync(_selected.StockID);
            if (!ok)
            {
                Snackbar.Add(string.IsNullOrWhiteSpace(err) ? "Xóa thất bại" : err, MudBlazor.Severity.Error);
                return;
            }

            Snackbar.Add("Đã xóa.", MudBlazor.Severity.Success);
            _selected = null;
            await RefreshAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add("Xóa lỗi: " + ex.Message, MudBlazor.Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OnImportExcel(InputFileChangeEventArgs e)
    {
        if (e.FileCount == 0)
            return;

        var authState = await asv.GetAuth();
        var importUser = authState.User?.Identity?.Name;
        if (string.IsNullOrEmpty(importUser) || !await ssv.CheckPermission(importUser, "Add", "Stock"))
        {
            CallSnackBar(Localizer["You have not access to Add"], MudBlazor.Severity.Warning);
            return;
        }

        _loading = true;
        try
        {
            await using var stream = e.File.OpenReadStream(maxAllowedSize: 20 * 1024 * 1024);
            await using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            ms.Position = 0;

            var userLogin = importUser;

            var result = await StockSvc.ImportFromExcelAsync(ms, userLogin);
            if (result.ErrorMessage != null)
            {
                Snackbar.Add("Import lỗi: " + result.ErrorMessage, MudBlazor.Severity.Error);
                return;
            }

            Snackbar.Add(
                $"Import xong: thêm {result.Inserted} dòng; bỏ qua trùng {result.SkippedDuplicate}; dòng trống (không số container) {result.SkippedEmpty}; đã gateout nên bỏ qua {result.SkippedGateOut}.",
                result.Inserted > 0 ? MudBlazor.Severity.Success : MudBlazor.Severity.Info);

            await RefreshAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add("Import lỗi: " + ex.Message, MudBlazor.Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private static string FormatTime(TimeSpan? t) =>
        t.HasValue ? string.Format("{0:hh\\:mm}", t.Value) : string.Empty;

    private static string FormatDateTime(DateTime? dt) =>
        dt.HasValue ? dt.Value.ToString("dd/MM/yyyy HH:mm") : string.Empty;

    private async Task LoadContainerTrackingAsync()
    {
        _containerTracking = null;
        if (string.IsNullOrWhiteSpace(_filterContainer))
            return;

        _containerTracking = await StockSvc.GetContainerTrackingAsync(_filterContainer);
    }

    private RenderFragment RenderYmToolbar() => @<MudPaper Class="pa-2 mb-2 d-flex flex-wrap gap-2">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Refresh" OnClick="RefreshYmCurrentTabAsync" Disabled="_ymLoading || !_ymCanView">@Localizer["reload"]</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.Add" OnClick="YmAddCurrentAsync" Disabled="_ymLoading || !_ymCanAdd">@Localizer["new"]</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Info" StartIcon="@Icons.Material.Filled.Edit" OnClick="YmEditCurrentAsync" Disabled="_ymLoading || !_ymCanEdit">@Localizer["edit"]</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete" OnClick="YmDeleteCurrentAsync" Disabled="_ymLoading || !_ymCanDelete">@Localizer["delete"]</MudButton>
        <MudButton HtmlTag="label" Variant="Variant.Filled" Color="Color.Tertiary" StartIcon="@Icons.Material.Filled.UploadFile" Disabled="_ymLoading || !_ymCanAdd">
            @Localizer["Ym_ImportExcel"]
            <InputFile OnChange="YmImportCurrentAsync" accept=".xlsx,.xls" style="display:none" />
        </MudButton>
    </MudPaper>;

    private async Task LoadYmPermissionAsync()
    {
        var authState = await asv.GetAuth();
        var username = authState.User?.Identity?.Name;
        if (string.IsNullOrWhiteSpace(username))
            return;

        _ymCanView = await ssv.CheckPermission(username, "View", "Stock");
        _ymCanAdd = await ssv.CheckPermission(username, "Add", "Stock");
        _ymCanEdit = await ssv.CheckPermission(username, "Edit", "Stock");
        _ymCanDelete = await ssv.CheckPermission(username, "Delete", "Stock");
    }

    private async Task RefreshYmCurrentTabAsync()
    {
        if (!_ymCanView || !IsYmTabActive())
            return;
        _ymLoading = true;
        try
        {
            switch (GetCurrentYmTab())
            {
                case ExcelCrudTab.HDS: _ymHdsItems = await ExcelImportSvc.GetHdsAsync(); break;
                case ExcelCrudTab.AG: _ymAgItems = await ExcelImportSvc.GetAgAsync(); break;
                case ExcelCrudTab.VSS: _ymVssItems = await ExcelImportSvc.GetVssAsync(); break;
                case ExcelCrudTab.AMS: _ymAmsItems = await ExcelImportSvc.GetAmsAsync(); break;
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(Localizer["Ym_LoadError", ex.Message], MudBlazor.Severity.Error);
        }
        finally
        {
            _ymLoading = false;
        }
    }

    private async Task YmImportCurrentAsync(InputFileChangeEventArgs e)
    {
        if (!_ymCanAdd || e.FileCount == 0 || !IsYmTabActive())
            return;
        _ymLoading = true;
        try
        {
            await using var stream = e.File.OpenReadStream(50 * 1024 * 1024);
            await using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            ms.Position = 0;
            var result = await ExcelImportSvc.ImportAsync(GetCurrentYmTab(), ms);
            if (!string.IsNullOrWhiteSpace(result.ErrorMessage))
            {
                Snackbar.Add(Localizer["Ym_ImportError", result.ErrorMessage], MudBlazor.Severity.Error);
                return;
            }
            Snackbar.Add(Localizer["Ym_ImportSuccess", result.Inserted], MudBlazor.Severity.Success);
            await RefreshYmCurrentTabAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(Localizer["Ym_ImportError", ex.Message], MudBlazor.Severity.Error);
        }
        finally
        {
            _ymLoading = false;
        }
    }

    private async Task YmAddCurrentAsync()
    {
        if (!_ymCanAdd || !IsYmTabActive())
            return;
        switch (GetCurrentYmTab())
        {
            case ExcelCrudTab.HDS: await YmOpenDialogAndSaveAsync(new M_StockGateOut_HDS_08042026 { Id = Guid.NewGuid(), CreatedAt = DateTime.UtcNow }); break;
            case ExcelCrudTab.AG: await YmOpenDialogAndSaveAsync(new M_YardReport_AG_2026040307 { Id = Guid.NewGuid(), SourceSheet = "Manual", CreatedAt = DateTime.UtcNow }); break;
            case ExcelCrudTab.VSS: await YmOpenDialogAndSaveAsync(new M_YardMovement_VSS_26040808 { Id = Guid.NewGuid(), SourceSheet = "Manual", CreatedAt = DateTime.UtcNow }); break;
            case ExcelCrudTab.AMS: await YmOpenDialogAndSaveAsync(new M_YardMovement_AMS_26040816 { Id = Guid.NewGuid(), CreatedAt = DateTime.UtcNow }); break;
        }
    }

    private async Task YmEditCurrentAsync()
    {
        if (!_ymCanEdit || !IsYmTabActive())
            return;
        switch (GetCurrentYmTab())
        {
            case ExcelCrudTab.HDS when _ymSelectedHds != null: await YmOpenDialogAndSaveAsync(_ymSelectedHds); break;
            case ExcelCrudTab.AG when _ymSelectedAg != null: await YmOpenDialogAndSaveAsync(_ymSelectedAg); break;
            case ExcelCrudTab.VSS when _ymSelectedVss != null: await YmOpenDialogAndSaveAsync(_ymSelectedVss); break;
            case ExcelCrudTab.AMS when _ymSelectedAms != null: await YmOpenDialogAndSaveAsync(_ymSelectedAms); break;
            default: Snackbar.Add(Localizer["Ym_SelectOneRowToEdit"], MudBlazor.Severity.Warning); break;
        }
    }

    private async Task YmDeleteCurrentAsync()
    {
        if (!_ymCanDelete || !IsYmTabActive())
            return;
        var confirm = await DialogService.ShowMessageBox(Localizer["Ym_Warning"], Localizer["Ym_DeleteConfirm"], yesText: Localizer["delete"].Value, cancelText: Localizer["cancel"].Value);
        if (confirm != true)
            return;
        (bool Ok, string? Error) result = (false, Localizer["Ym_NoRowSelected"].Value);
        switch (GetCurrentYmTab())
        {
            case ExcelCrudTab.HDS when _ymSelectedHds != null: result = await ExcelImportSvc.DeleteAsync<M_StockGateOut_HDS_08042026>(_ymSelectedHds.Id); break;
            case ExcelCrudTab.AG when _ymSelectedAg != null: result = await ExcelImportSvc.DeleteAsync<M_YardReport_AG_2026040307>(_ymSelectedAg.Id); break;
            case ExcelCrudTab.VSS when _ymSelectedVss != null: result = await ExcelImportSvc.DeleteAsync<M_YardMovement_VSS_26040808>(_ymSelectedVss.Id); break;
            case ExcelCrudTab.AMS when _ymSelectedAms != null: result = await ExcelImportSvc.DeleteAsync<M_YardMovement_AMS_26040816>(_ymSelectedAms.Id); break;
        }
        if (!result.Ok)
        {
            Snackbar.Add(result.Error ?? Localizer["Ym_DeleteFailed"].Value, MudBlazor.Severity.Error);
            return;
        }
        Snackbar.Add(Localizer["Ym_Deleted"], MudBlazor.Severity.Success);
        await RefreshYmCurrentTabAsync();
    }

    private async Task YmOpenDialogAndSaveAsync<T>(T model) where T : class, IExcelImportEntity
    {
        var dialog = DialogService.Show<Components.ExcelImport.Pages.ExcelImport_RowDialog>(Localizer["Ym_EditDialogTitle"], new DialogParameters { ["Model"] = model }, new DialogOptions { MaxWidth = MaxWidth.ExtraLarge, FullWidth = true, CloseOnEscapeKey = true });
        var result = await dialog.Result;
        if (result.Canceled || result.Data is not T data)
            return;
        var saveResult = await ExcelImportSvc.UpsertAsync(data);
        if (!saveResult.Ok)
        {
            Snackbar.Add(saveResult.Error ?? Localizer["Ym_SaveFailed"].Value, MudBlazor.Severity.Error);
            return;
        }
        Snackbar.Add(Localizer["Ym_Saved"], MudBlazor.Severity.Success);
        await RefreshYmCurrentTabAsync();
    }

    private void OnYmHdsRowClick(DataGridRowClickEventArgs<M_StockGateOut_HDS_08042026> args) => _ymSelectedHds = args.Item;
    private void OnYmAgRowClick(DataGridRowClickEventArgs<M_YardReport_AG_2026040307> args) => _ymSelectedAg = args.Item;
    private void OnYmVssRowClick(DataGridRowClickEventArgs<M_YardMovement_VSS_26040808> args) => _ymSelectedVss = args.Item;
    private void OnYmAmsRowClick(DataGridRowClickEventArgs<M_YardMovement_AMS_26040816> args) => _ymSelectedAms = args.Item;
    private bool IsYmTabActive() => _ymActiveTab > 0;
    private ExcelCrudTab GetCurrentYmTab() => (ExcelCrudTab)(_ymActiveTab - 1);
}
