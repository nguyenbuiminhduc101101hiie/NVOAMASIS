@using System.Globalization﻿﻿
@inject CustomerService csv
@inject SupportServices supsv
@inject SharedServices ssv
@inject AccountService asv
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject TaxServices tsv
@inject ShipmentService shipsv
@inject IStringLocalizer<SharedResource> Localizer
@inject HistoryLogService HistoryLogService
@using System.Text.Json;
<MudDataGrid T="M_TaxDetail" Items="@Listdata" Filterable="true" @ref="mudTable" Bordered="true"
FilterMode="@DataGridFilterMode.Simple" Dense="true" Virtualize="true"
FixedHeader="true" FixedFooter="true" HeaderClass="no-wrap" FooterClass="no-wrap"
ReadOnly="false" CommittedItemChanges="@CommittedItem" RowClassFunc="@SelectedRowClassFunc"
RowClick="@RowClicked" RowContextMenuClick="RowRightClicked"
ColumnResizeMode="ResizeMode.Column" Loading="_loading" ShowColumnOptions="false">
    <Columns>
        <TemplateColumn CellClass="d-flex justify-end" Filterable="false" ShowColumnOptions="false" Sortable="false">
            <HeaderTemplate>
                <MudStack Row="true" Justify="Justify.FlexStart" Spacing="2">

                    <!-- Nút Reload -->
                    <MudTooltip Text="@Localizer["Reload"]">
                        <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                        Color="Color.Success"
                        Size="Size.Small"
                        OnClick="Refresh"
                        Variant="Variant.Filled"
                        Class="btn-compact" />
                    </MudTooltip>

                    <!-- Nút Add -->
                    <MudTooltip Text="@Localizer["New"]">
                        <MudIconButton Icon="@Icons.Material.Filled.Add"
                        Color="Color.Success"
                        Size="Size.Small"
                        OnClick="AddItem"
                        Variant="Variant.Filled"
                        Class="btn-compact" />
                    </MudTooltip>

                    <MudTooltip Text="Thêm từ hóa đơn đầu ra">
                        <MudIconButton Icon="@Icons.Material.Filled.CreateNewFolder"
                        Color="Color.Success"
                        Size="Size.Small"
                        OnClick="CreateInvoice"
                        Variant="Variant.Filled"
                        Class="btn-compact" />
                    </MudTooltip>
                </MudStack>
            </HeaderTemplate>
            <CellTemplate>
                <MudIconButton Size="@Size.Small" Icon="@Icons.Material.Outlined.Edit" OnClick="@(()=>TryStartEditing(context.Item))" />
                <MudIconButton Size="@Size.Small" Icon="@Icons.Material.Outlined.Delete" OnClick="@(()=>DeleteItem(context.Item))" />
            </CellTemplate>
        </TemplateColumn>
        <PropertyColumn Property="x => Charidtocharge(x.itemid)" Title="@Localizer["Item"]" Required="false" CellClass="no-wrap-cell">
            <EditTemplate>
                <MudAutocomplete @bind-Value="context.Item.itemid" Label="@Localizer["Item"]" Required
                SearchFunc="SearchCharge" ToStringFunc="Charidtocharge" />
            </EditTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x=>x.Approve" Title="@Localizer["Approve"]" IsEditable="false" Required="false">
            <CellTemplate>
                <MudCheckBox @bind-Checked="context.Item.Approve" @bind-Value="context.Item.Approve" @bind-Value:after="@(()=>UpdatebyCheckboxClick(context.Item))" />
            </CellTemplate>
            <EditTemplate>
            </EditTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x => x.dongiatruocthueVND" Title="@Localizer["Unit Price"]" Format="#,##0.##" Required="false">
            <EditTemplate>
                <MudNumericField @bind-Value="context.Item.dongiatruocthueVND" Class="text-right"
                Label="@Localizer["Unit Price"]" Format="#,##0.##" Culture="@_en" T="double?"
                TextChanged="@(e => CalculateTotal(context.Item))" HideSpinButtons="true" />
            </EditTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x=>x.Container_Type" Title="@Localizer["Type"]" Required="false">
            <EditTemplate>
                <MudAutocomplete @bind-Value="context.Item.Container_Type" Label="@Localizer["Type"]" Required
                SearchFunc="SearchType" CoerceValue Clearable ResetValueOnEmptyText/>
            </EditTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x => x.soLuong" Title="@Localizer["Quantity"]" Format="#,##0.##" Required="false">
            <EditTemplate>
                <MudNumericField @bind-Value="context.Item.soLuong"
                Label="@Localizer["Quantity"]" Format="#,##0.##" Culture="@_en" T="double?"
                TextChanged="@(e => CalculateTotal(context.Item))" HideSpinButtons="true" />
            </EditTemplate>
        </PropertyColumn>

        <PropertyColumn Property="x => x.thanhtientruocthueVND" Title="@Localizer["Total Price"]" Format="#,##0.##" Required="false">
            <EditTemplate>
                <MudNumericField @bind-Value="context.Item.thanhtientruocthueVND" Label="@Localizer["Total Price"]"
                Format="#,##0.##" Culture="@_en" T="double?" Class="text-right" HideSpinButtons="true" />
            </EditTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x => x.ExchangeRate" Title="@Localizer["Exchange Rate"]"Required="false">
        </PropertyColumn>
        <PropertyColumn Property="x => x.UpdateTime" Title="@Localizer["Dateupdate"]" IsEditable="false" Required="false">
            <EditTemplate></EditTemplate>
        </PropertyColumn>

        <PropertyColumn Property="x => x.UserID" Title="@Localizer["UserUpdate"]" IsEditable="false" Required="false">
            <EditTemplate></EditTemplate>
        </PropertyColumn>

        <PropertyColumn Property="x => x.Continued" Title="@Localizer["Continued"]" IsEditable="false" Required="false">
            <EditTemplate></EditTemplate>
        </PropertyColumn>
    </Columns>
</MudDataGrid>
@if(Listdata.Count > 0)
{
    <MudStack Row Justify="Justify.FlexStart" Class="pa-4">
        <MudText Typo="Typo.subtitle2" Align="Align.Center" GutterBottom="true" Style="margin-right:20px;">Total: @(Listdata.Sum(x => x.thanhtientruocthueVND / (double.TryParse(x.ExchangeRate, out double exchange) ? exchange : 1) )!.Value.ToString("#,##0.##", _en)) USD</MudText>
        <MudText Typo="Typo.subtitle2" Align="Align.Center" GutterBottom="true">Total: @(Listdata.Sum(x => x.thanhtientruocthueVND)!.Value.ToString("#,##0.##", _en)) VND</MudText>
    </MudStack>
}
@code {
    [Parameter] public M_TaxInvoice? DetailTaxInvoice { get; set; } = default!;
    [CascadingParameter] MudDialogInstance? MudDialog { get; set; }
    [Parameter] public List<M_Customer> Customers { get; set; } = default!;
    [Parameter] public List<ChargeModel> charges { get; set; } = default!;

    [Parameter] public string usr { get; set; } = default!;
    [Parameter] public List<string> Types { get; set; } = default!;
    M_TaxDetail detail_history;
    void CallSnackBar(string message, MudBlazor.Severity severity)
    {
        Snackbar.Configuration.SnackbarVariant = Variant.Filled;
        Snackbar.Configuration.MaxDisplayedSnackbars = 3;
        Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopRight;
        Snackbar.Add(message, severity);
    }

    private void Submit()
    {
        MudDialog!.Close();
    }
    void Cancel() => MudDialog!.Cancel();
    protected async override Task OnInitializedAsync()
    {
        try
        {
            await Refresh();
        }
        catch (Exception ex)
        {
            CallSnackBar(Localizer["PleaseSlowDown"], MudBlazor.Severity.Error);

        }
    }

    bool _loading = false;
    List<M_TaxDetail> Listdata = new List<M_TaxDetail>();
    List<M_HoaDonDauRa> ListdataHoaDon = new List<M_HoaDonDauRa>();
    M_TaxDetail detail;
    async Task Refresh()
    {
        try
        {
            _loading = true;
            // Simulate asynchronous loading to demonstrate a loading indicator
            Listdata.Clear();
            StateHasChanged();
            await Task.Delay(500);
            if (!await ssv.CheckPermission(usr, "View", "IssueInvoice"))
            {
                CallSnackBar(Localizer["NoPermission_View"], MudBlazor.Severity.Warning);
                return;
            }
            Listdata = await tsv.GetListTaxDetail(DetailTaxInvoice.TaxInvoiceID);

        }
        catch (Exception ex)
        {
            CallSnackBar(ex.Message, MudBlazor.Severity.Error);

        }
        finally
        {
            _loading = false;
        }

    }
    MudDataGrid<M_TaxDetail> mudTable;
    async Task AddItem()
    {
        // var item = new M_TaxDetail();
        // Listdata.Add(item);
        // await mudTable.SetEditingItemAsync(Listdata.LastOrDefault()!);
        if (!await ssv.CheckPermission(usr, "Add", "IssueInvoice"))
        {
            CallSnackBar(Localizer["NoPermission_Add"], MudBlazor.Severity.Warning);
            return;
        }
        var item = new M_TaxDetail();
        item.taxInvoiceID = DetailTaxInvoice.TaxInvoiceID;
        item.Approve = false;
        item.Continued = item.Editable = true;
        item.UpdateTime = DateTime.Now;
        item.UserID = usr;
        var parameters = new DialogParameters<Detail_DetailDialog> { { x => x.detail, item }, { x => x.Customers, Customers }, { x => x.Listdata, Listdata }, { x => x.charges, charges } };
        var dialog = await DialogService.ShowAsync<Detail_DetailDialog>($"New", parameters, optionsdialog);
        var rsdlog = await dialog.Result;
        if (rsdlog.Canceled) return;
        var data = (M_TaxDetail)rsdlog.Data;
        var rs = await tsv.CreateTaxDetail(data);
        if (rs.Flag) await tsv.UpdateTotalInvoiceByTaxInvoiceID(data.taxInvoiceID ?? Guid.Empty);
        CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
        await Refresh();
    }
    string CusidtoCusCode(Guid cusid)
    {
        if (cusid == null || cusid == Guid.Empty)
            return string.Empty;
        var rs = Customers.FirstOrDefault(x => x.Customer_ID == cusid);
        return rs == null ? string.Empty : $"{rs.shortname} - {rs.COMPANY}"!;
    }
    async Task DeleteItem(M_TaxDetail item)
    {
        if (item == null)
        {
            CallSnackBar(Localizer["SelectOneRow"], MudBlazor.Severity.Warning);
            return;
        }
        if (item.Approve.HasValue && item.Approve.Value)
        {
            CallSnackBar(Localizer["CreditApproved"], MudBlazor.Severity.Info);
            return;
        }
        var resultMess = await DialogService.ShowMessageBox(
                Localizer["Warning"],
                Localizer["DeleteConfirmBody"],
                yesText: Localizer["delete"], cancelText: Localizer["cancel"]);

        if (resultMess.HasValue)
        {
            var rs = await tsv.DeleteTaxDetail(item);
            if (rs.Flag) await tsv.UpdateTotalInvoiceByTaxInvoiceID(item.taxInvoiceID ?? Guid.Empty);
            detail_history = JsonSerializer.Deserialize<M_TaxDetail>(JsonSerializer.Serialize(item));
            CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
            await Refresh();
        }

    }
    async Task CommittedItem(M_TaxDetail item)
    {

        item.taxInvoiceID = DetailTaxInvoice!.TaxInvoiceID;
        item.UserID = usr;
        item.UpdateTime = DateTime.Now;
        item.Continued = item.Editable = true;
        item.Approve = false;
        var rs = item.taxDetailID != Guid.Empty ? await tsv.UpdateTaxDetail(item) : await tsv.CreateTaxDetail(item);
        if (rs.Flag) await tsv.UpdateTotalInvoiceByTaxInvoiceID(item.taxInvoiceID ?? Guid.Empty);
        CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
        await Refresh();
    }
    public CultureInfo _de = CultureInfo.GetCultureInfo("de-DE");
    public CultureInfo _en = CultureInfo.GetCultureInfo("en-US");
    private int selectedRowNumber = -1;
    private string SelectedRowClassFunc(M_TaxDetail Sis, int rowNumber)
    {
        if (Sis.Approve.HasValue && Sis.Approve.Value)
        {
            return "custom-disable"; // Gán class "disable" nếu Approve = true
        }
        else if (mudTable.SelectedItem != null && mudTable.SelectedItem.Equals(Sis))
        {
            return "selected"; // Giữ lớp "selected" cho dòng đã chọn
        }
        else
        {
            return string.Empty;
        }
    }
    void RowClicked(DataGridRowClickEventArgs<M_TaxDetail> args)
    {
        if (args.Item.Approve.HasValue && args.Item.Approve.Value)
            CallSnackBar(Localizer["CreditApproved"], MudBlazor.Severity.Info);
        else detail = args.Item;
    }

    void RowRightClicked(DataGridRowClickEventArgs<M_TaxDetail> args)
    {

        //_events.Insert(0, $"Event = RowRightClick, Index = {args.RowIndex}, Data = {System.Text.Json.JsonSerializer.Serialize(args.Item)}");
    }
    private void CalculateThanhTien(M_TaxDetail item)
    {
        if (item.dongiatruocthueVND.HasValue && item.soLuong.HasValue)
        {
            item.thanhtientruocthueVND = item.dongiatruocthueVND * item.soLuong;
        }
        else
        {
            item.thanhtientruocthueVND = 0; // Hoặc null, tùy theo yêu cầu của bạn
        }
    }

    string Charidtocharge(Guid? id)
    {
        if (id == null || id == Guid.Empty)
            return string.Empty;
        var rs = charges.FirstOrDefault(x => x.CHARGE_ID == id);
        return rs == null ? string.Empty : $"{rs.CHARGE_CODE} - {rs.CHARGE}"!;
    }

    private async Task<IEnumerable<Guid>> SearchCustomer(string text)
    {
        try
        {
            if (string.IsNullOrWhiteSpace(text))
            {
                return Customers.Select(x => x.Customer_ID);
            }
            // MBL.Porname = mst_Consignee;
            return Customers.Where(x => (x.shortname + "_" + x.COMPANY).Contains(text, StringComparison.OrdinalIgnoreCase)).Select(x => x.Customer_ID);
        }
        catch (Exception)
        {
            throw;
        }
    }
    private async Task<IEnumerable<Guid?>> SearchCharge(string text)
    {
        try
        {
            if (string.IsNullOrWhiteSpace(text))
            {
                return charges.Select(x => (Guid?)x.CHARGE_ID);
            }
            // MBL.Porname = mst_Consignee;
            return charges.Where(x => (x.CHARGE_CODE + "_" + x.CHARGE).Contains(text, StringComparison.OrdinalIgnoreCase)).Select(x => (Guid?)x.CHARGE_ID);
        }
        catch (Exception)
        {
            throw;
        }
    }
    private void CalculateTotal(M_TaxDetail item)
    {
        if (item.soLuong.HasValue && item.dongiatruocthueVND.HasValue)
        {

            double soluong = item.soLuong ?? 0;
            double dongia = item.dongiatruocthueVND ?? 0;
            item.thanhtientruocthueVND = Math.Round(soluong * dongia, 2);
        }


    }

    double getVATfromCusID(Guid? cusid)
    {
        var rs = Customers.First(x => x.Customer_ID == cusid);
        var vat = double.TryParse(rs.phuphicourier, out double VAT) ? VAT : 0;
        return vat;
    }
    private async Task<IEnumerable<string>> SearchType(string text)
    {
        try
        {
            if (string.IsNullOrWhiteSpace(text))
            {
                return Types;
            }
            // MBL.Porname = mst_Consignee;
            return Types.Where(x => x.Contains(text, StringComparison.OrdinalIgnoreCase));
        }
        catch (Exception)
        {
            throw;
        }
    }

    async Task UpdatebyCheckboxClick(M_TaxDetail item)
    {
        if (!await ssv.CheckPermission(usr, "Approve", "HBL"))
        {
            CallSnackBar(Localizer["NoPermission_Approve"], MudBlazor.Severity.Warning);
            return;
        }
        item.UpdateTime = DateTime.Now;
        item.UserID = usr;
        var rs = await tsv.UpdateTaxDetail(item);
        if (rs.Flag) await tsv.UpdateTotalInvoiceByTaxInvoiceID(item.taxInvoiceID ?? Guid.Empty);
        if (!rs.Flag) CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
    }
    DialogOptions optionsdialog = new DialogOptions
        {
            ClassBackground = "class-dialog-custom",
            FullWidth = true,
            MaxWidth = MaxWidth.Medium,
            CloseOnEscapeKey = false,
            DisableBackdropClick = true
        };
    async Task TryStartEditing(M_TaxDetail item)
    {
        if (item == null)
        {
            CallSnackBar(Localizer["SelectOneRow"], MudBlazor.Severity.Warning);
            return;
        }
        detail_history = JsonSerializer.Deserialize<M_TaxDetail>(JsonSerializer.Serialize(item));
        var parameters = new DialogParameters<Detail_DetailDialog> { { x => x.detail, item }, { x => x.Customers, Customers }, { x => x.Listdata, Listdata }, { x=>x.charges,charges} };
        var dialog = await DialogService.ShowAsync<Detail_DetailDialog>($"Edit [{item.STT}]", parameters, optionsdialog);
        var rsdlog = await dialog.Result;
        if (rsdlog.Canceled) return;
        var data = (M_TaxDetail)rsdlog.Data;
        var rs = await tsv.UpdateTaxDetail(data);
        if (rs.Flag) await tsv.UpdateTotalInvoiceByTaxInvoiceID(data.taxInvoiceID ?? Guid.Empty);
        CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
        await Refresh();
    }

    private async Task CreateInvoice()
    {
        var optionsdialog = new DialogOptions
            {
                ClassBackground = "class-dialog-custom",
                FullWidth = true,
                MaxWidth = MaxWidth.Medium,
                CloseOnEscapeKey = true,
                DisableBackdropClick = true,
                CloseButton = true
            };
        var listhddra = await shipsv.GetListHoaDonDauRaALL();
        var parameters = new DialogParameters<CreateInvoice> { { x => x.Listdata, listhddra }, { x => x.ListdataINV, new() }, { x => x.isNew, false }, { x => x._Invoice, DetailTaxInvoice }, { x => x.Customers, Customers } };
        var dialog = await DialogService.ShowAsync<CreateInvoice>($"Add Detail to Invoice [{DetailTaxInvoice.InvoiceNo}]", parameters, optionsdialog);
        var rs = await dialog.Result;
        if (rs.Canceled)
            return;
        await Refresh();
    }
}