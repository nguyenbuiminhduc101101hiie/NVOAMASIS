<MudDialog>
    <DialogContent>
        <Index_TaxDetail DetailTaxInvoice="detail" Customers="Customers" charges=charges Types=Types usr=@usr />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(()=> MudDialog!.Cancel())">Close</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter] public M_TaxInvoice? detail { get; set; } = default!;
    [CascadingParameter] MudDialogInstance? MudDialog { get; set; }
    [Parameter] public List<M_Customer>? Customers { get; set; } = default!;

    [Parameter] public List<ChargeModel> charges { get; set; } = default!;

    [Parameter] public string usr { get; set; } = default!;
    [Parameter] public List<string> Types { get; set; } = default!;
}
