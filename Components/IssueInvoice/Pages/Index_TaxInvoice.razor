

@inject CustomerService csv
@inject SupportServices supsv
@inject SharedServices ssv
@inject AccountService asv
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject TaxServices tsv
@inject ShipmentService shipsv
@inject IStringLocalizer<SharedResource> Localizer
@attribute [Authorize]
@using System.Globalization﻿

<PageTitle>@Localizer["Issue_invoices"]</PageTitle>
<div class="product-price-page">
    <PpScreenHeader Title="@Localizer["Issue_invoices"]" Subtitle="Tax invoices · list, lines, and e-invoice actions" />
    <MudPaper Class="product-price-card" Elevation="0">
<MudContainer MaxWidth=MaxWidth.False Class="pa-2">
    <MudDataGrid T="M_TaxInvoice" Items="@Listdata" Filterable="true" @ref="mudTable" Class="table-shipment-bg"
                 FilterMode="@DataGridFilterMode.Simple" Dense="true" Virtualize="true" Height="calc(100vh - 30vh);" QuickFilter="_quickFilter"
                 FixedHeader="true" FixedFooter="true" HeaderClass="no-wrap" FooterClass="no-wrap" RowClassFunc="@SelectedRowClassFunc"
                 RowClick="@RowClicked" RowContextMenuClick="RowRightClicked" Bordered="true" RowClass="no-wrap-cell"
                 ColumnResizeMode="ResizeMode.Column" Loading="_loading" ShowColumnOptions=false>
        <ToolBarContent>
            <MudStack Row="true" Justify="Justify.FlexStart" Spacing="3">

                <MudTooltip Text="@Localizer["Reload"]">
                    <MudIconButton OnClick="@Refresh"
                                   Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled"
                                   Icon="@Icons.Material.Filled.Refresh" Class="btn-compact" />
                </MudTooltip>
                <MudTooltip Text="@Localizer["New"]">
                    <MudIconButton OnClick="@AddItem"
                                   Size="Size.Small" Color="Color.Secondary" Variant="Variant.Filled"
                                   Icon="@Icons.Material.Filled.Add" Class="btn-compact" />
                </MudTooltip>
                <MudTooltip Text="Thêm từ hóa đơn đầu ra">
                    <MudIconButton Icon="@Icons.Material.Filled.CreateNewFolder"
                                   Color="Color.Success"
                                   Size="Size.Small"
                                   OnClick="CreateInvoice"
                                   Variant="Variant.Filled"
                                   Class="btn-compact" />
                </MudTooltip>
                <MudTooltip Text="@Localizer["Detail"]">
                    <MudIconButton OnClick="@OpenDialog"
                                   Size="Size.Small" Color="Color.Success" Variant="Variant.Filled"
                                   Icon="@Icons.Material.Filled.NavigateNext" Class="btn-compact" />
                </MudTooltip>
            </MudStack>
            <MudSpacer />
            <MudTextField @bind-Value="_searchString" Placeholder="Search" Adornment="Adornment.Start" Immediate="true"
                          AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
        </ToolBarContent>
        <Columns>
            <TemplateColumn CellClass="d-flex justify-end" Filterable="false" Sortable="false">
                <CellTemplate>
                    <MudIconButton Size="@Size.Small" Icon="@Icons.Material.Outlined.Edit" OnClick="@(()=>EditItem(context.Item))" />
                    <MudIconButton Size="@Size.Small" Icon="@Icons.Material.Outlined.Delete" OnClick="@(()=>DeleteItem(context.Item))" />
                </CellTemplate>
            </TemplateColumn>
            <HierarchyColumn T="M_TaxInvoice" />
            <PropertyColumn Property="x => x.InvoiceNo" Title="@Localizer["Invoice No"]" Required />
            <PropertyColumn Property="x => CusidtoCusCode(x.Customer_ID)" Title="@Localizer["Customer"]" Required />
            <PropertyColumn Property="x => x.BillNumber" Title="@Localizer["Bill Number"]" Required />
            <PropertyColumn Property="x => x.SerialNo" Title="@Localizer["Serial No"]" Required />
            <PropertyColumn Property="x => x.DateInvoice" Title="@Localizer["Date Invoice"]" Format="dd-MMM-yyyy" Required />
            <PropertyColumn Property="x => x.MethodPayment" Title="@Localizer["Method Payment"]" Required />
            <PropertyColumn Property="x => x.VAT" Title="@Localizer["VAT"]" Required  />
            <PropertyColumn Property="x => x.VATShow" Title="@Localizer["VAT Show"]" Required />
            <PropertyColumn Property="x => x.Chungtu" Title="@Localizer["Documents"]" Required />
            <PropertyColumn Property="x => x.Exchange" Title="@Localizer["Exchange Rate"]" Required Format="##,##0.##" Culture="@(_en)" CellClass="custom-right-align" />
            <PropertyColumn Property="x => x.huy" Title="@Localizer["Destroy"]" Required />
            <PropertyColumn Property="x => x.lyDoHuy" Title="@Localizer["Reason Destroy"]" Required />
            <PropertyColumn Property="x => x.REF" Title="@Localizer["REF"]" Required />
            <PropertyColumn Property="x => x.mbl" Title="@Localizer["MBL"]" Required />
            <PropertyColumn Property="x => x.hbl" Title="@Localizer["HBL"]" Required />
            <PropertyColumn Property="x => x.Approve" Title="@Localizer["Approve"]" Required >
                <CellTemplate>
                    <MudCheckBox @bind-Checked="context.Item.Approve" @bind-Value="context.Item.Approve" @bind-Value:after="@(()=>UpdatebyCheckboxClick(context.Item))" />
                </CellTemplate>
                <EditTemplate>
                </EditTemplate>
            </PropertyColumn>
            <PropertyColumn Property="x => x.Editable" Title="@Localizer["Editable"]" Required />
            <PropertyColumn Property="x => x.Continued" Title="@Localizer["Continued"]" Required />
            <PropertyColumn Property="x => x.UserID" Title="@Localizer["User"]" Required />
            <PropertyColumn Property="x => x.Updatetime" Title="@Localizer["Dateupdate"]" Required />
            <PropertyColumn Property="x => x.VesselVoy" Title="@Localizer["Vessel/Voy"]" Required />
            <PropertyColumn Property="x => x.branch" Title="@Localizer["Branch"]" Required />
            <PropertyColumn Property="x => x.daXuatHDDT" Title="@Localizer["daXuatHDDT"]" Required />
            <PropertyColumn Property="x => x.mauSo" Title="@Localizer["Sample No"]" Required />
            <PropertyColumn Property="x => x.daKy" Title="@Localizer["Signed"]" Required />
            <PropertyColumn Property="x => x.tongTruocThue" Title="@Localizer["Total Not Include VAT"]" Required Format="##,##0.##" Culture="@(_en)" CellClass="custom-right-align" />
            <PropertyColumn Property="x => x.tongThue" Title="@Localizer["Total VAT "]" Required Format="##,##0.##" Culture="@(_en)" CellClass="custom-right-align" />
            <PropertyColumn Property="x => x.tongSauThue" Title="@Localizer["Total Include VAT"]" Required Format="##,##0.##" Culture="@(_en)" CellClass="custom-right-align" />
            <PropertyColumn Property="x => x.ghichuNoibo" Title="@Localizer["Notes"]" Required />
        </Columns>
        <ChildRowContent>
            <Index_TaxDetail DetailTaxInvoice="context.Item" Customers="Customers" charges="charges" usr=@usr Types="Types"/>
        </ChildRowContent>
    </MudDataGrid>
</MudContainer>
    </MudPaper>
</div>

@code {

    void CallSnackBar(string message, MudBlazor.Severity severity)
    {

        Snackbar.Configuration.SnackbarVariant = Variant.Filled;
        Snackbar.Configuration.MaxDisplayedSnackbars = 3;
        Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopRight;
        Snackbar.Add(message, severity);
    }

    string usr;
    AuthUser userdetail;
    List<string> trangthais = new List<string>();
    List<string> Types = new List<string>();
    List<TrangThai> tts = new List<TrangThai>();
    List<M_Customer> Customers = new List<M_Customer>();
    List<ChargeModel> charges = new List<ChargeModel>();
    CultureInfo _en = CultureInfo.GetCultureInfo("en-US");
    protected async override Task OnInitializedAsync()
    {
        try
        {
            _loading = true;
            userdetail = asv.GetUserDetail();
            Customers = await csv.GetList();
            tts = await supsv.GetListTrangThai();
            trangthais = tts.Where(x => x.Tieude.ToLower() == "job").OrderBy(x=>x.Noidung).Select(x=>x.Noidung).ToList();
            usr = asv.GetAuth().Result.User.Identity!.Name!;
            charges = await supsv.GetListCharge();
            Types = await tsv.GetListType();

            //await Refresh();
        }
        catch (Exception ex)
        {
            CallSnackBar(ex.Message, MudBlazor.Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    bool _loading = false;
    List<M_TaxInvoice> Listdata = new List<M_TaxInvoice>();
    List<M_MBL> ListMBLs = new List<M_MBL>();
    M_TaxInvoice detail;
    async Task Refresh()
    {
        try
        {
            _loading = true;
            Listdata.Clear();
            detail = null;
            await Task.Delay(500);
            StateHasChanged();
            if (!await ssv.CheckPermission(usr, "View", "IssueInvoice"))
            {
                CallSnackBar("You have not access to view", MudBlazor.Severity.Warning);
                return;
            }
            Listdata = await tsv.GetListTaxInvoice();
        }
        catch(Exception ex)
        {
            CallSnackBar(ex.Message, MudBlazor.Severity.Error);
        }
        finally
        {
            _loading = false;
        }

    }
    MudDataGrid<M_TaxInvoice> mudTable;

    private int selectedRowNumber = -1;
    private string SelectedRowClassFunc(M_TaxInvoice Sis, int rowNumber)
    {
        if (selectedRowNumber == rowNumber)
        {
            selectedRowNumber = -1;
            return string.Empty;
        }
        else if (mudTable.SelectedItem != null && mudTable.SelectedItem.Equals(Sis))
        {
            selectedRowNumber = rowNumber;
            return "selected";
        }
        else
        {
            return string.Empty;
        }
    }
    void RowClicked(DataGridRowClickEventArgs<M_TaxInvoice> args)
    {
        detail = args.Item;
    }

    void RowRightClicked(DataGridRowClickEventArgs<M_TaxInvoice> args)
    {

        //_events.Insert(0, $"Event = RowRightClick, Index = {args.RowIndex}, Data = {System.Text.Json.JsonSerializer.Serialize(args.Item)}");
    }

    string formatDate(DateTime? date)
    {
        if(date == null)
            return string.Empty;
        return date.Value.ToString("dd/MMM/yyyy");
    }
    bool chkVAT = false, chkUSD = false, chkVND = false;

    private string _searchString;
    private Func<M_TaxInvoice, bool> _quickFilter => x =>
    {
        //Kiểm tra theo search
        bool matchSearch = true;

        if (!string.IsNullOrWhiteSpace(_searchString))
        {
            matchSearch =
                (x.InvoiceNo?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) == true);
        }

        return matchSearch;
    };

    DateRange frmtoDate = new DateRange(new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1).AddMonths(-1),
                                        new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1).AddMonths(1).AddDays(-1));

    string Charidtocharge(Guid id)
    {
        if (id == Guid.Empty)
            return string.Empty;
        var rs = charges.FirstOrDefault(x => x.CHARGE_ID == id);
        return rs == null ? string.Empty : $"{rs.CHARGE_CODE} - {rs.CHARGE}"!;
    }
    string CharidtoLoaidv(Guid id)
    {
        if (id == Guid.Empty)
            return string.Empty;
        var rs = charges.FirstOrDefault(x => x.CHARGE_ID == id);
        return rs == null ? string.Empty : $"{rs.loaidichvu_charge}"!;
    }
    string CusidtoCusCode(Guid? cusid)
    {
        if (cusid == null || cusid == Guid.Empty)
            return string.Empty;
        var rs = Customers.FirstOrDefault(x => x.Customer_ID == cusid);
        return rs == null ? string.Empty : $"{rs.Customer_Code} - {rs.COMPANY!}";
    }
    async Task DeleteItem(M_TaxInvoice item)
    {
        if (!await ssv.CheckPermission(usr, "Delete", "IssueInvoice"))
        {
            CallSnackBar("You have not access to Delete", MudBlazor.Severity.Warning);
            return;
        }
        var resultMess = await DialogService.ShowMessageBox(
                "Warning",
                "Deleting can not be undone!",
                yesText: "Delete!", cancelText: "Cancel");

        if (resultMess.HasValue)
        {
            var rs = await tsv.DeleteTaxInvoice(item);
            CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
            await Refresh();
        }

    }

    DialogOptions optionsdialog = new DialogOptions
    {
        ClassBackground = "class-dialog-custom",
        FullWidth = true,
        MaxWidth = MaxWidth.Medium,
        CloseOnEscapeKey = false,
        DisableBackdropClick = true
    };
    async Task AddItem()
    {
        if (!await ssv.CheckPermission(usr, "Add", "IssueInvoice"))
        {
            CallSnackBar("You have not access to Add", MudBlazor.Severity.Warning);
            return;
        }
        var item = new M_TaxInvoice();
        item.InvoiceNo = await getinvoiceno();
        var parameters = new DialogParameters<Invoice_DetailDialog> { { x => x.detail, item }, { x => x.Customers, Customers }, { x => x.Listdata, Listdata } };
        var dialog = await DialogService.ShowAsync<Invoice_DetailDialog>($"Add [{item.InvoiceNo}]", parameters, optionsdialog);
        var rsdlog = await dialog.Result;
        if (rsdlog.Canceled) return;
        var data = (M_TaxInvoice)rsdlog.Data;
        data.TaxInvoiceID = Guid.NewGuid();
        var rs = await tsv.CreateTaxInvoice(data);
        CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
        await Refresh();
        if (rs.Flag) _searchString = data.InvoiceNo ?? string.Empty;
    }
    async Task EditItem(M_TaxInvoice item)
    {
        if (!await ssv.CheckPermission(usr, "Edit", "IssueInvoice"))
        {
            CallSnackBar("You have not access to Edit", MudBlazor.Severity.Warning);
            return;
        }
        if (item == null)
        {
            CallSnackBar("you must select 1 row.", MudBlazor.Severity.Warning);
            return;
        }
        var parameters = new DialogParameters<Invoice_DetailDialog> { { x => x.detail, item }, { x => x.Customers, Customers }, { x => x.Listdata, Listdata } };
        var dialog = await DialogService.ShowAsync<Invoice_DetailDialog>($"Edit [{item.InvoiceNo}]", parameters, optionsdialog);
        var rsdlog = await dialog.Result;
        if (rsdlog.Canceled) return;
        var data = (M_TaxInvoice)rsdlog.Data;
        var rs = await tsv.UpdateTaxInvoice(data);
        CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
        await Refresh();
        if (rs.Flag) _searchString = data.InvoiceNo ?? string.Empty;
    }
    private async Task OpenDialog()
    {
        if (!await ssv.CheckPermission(usr, "Add", "IssueInvoice"))
        {
            CallSnackBar("You have not access to Create", MudBlazor.Severity.Warning);
            return;
        }
        if (detail == null)
        {
            CallSnackBar("you must select 1 row.", MudBlazor.Severity.Warning);
            return;
        }
        if (detail.Approve.HasValue && detail.Approve.Value)
        {
            CallSnackBar("this Invoice is approved", MudBlazor.Severity.Warning);
            return;
        }
        var optionsdialog = new DialogOptions
            {
                ClassBackground = "class-dialog-custom",
                FullWidth = true,
                MaxWidth = MaxWidth.Medium,
                CloseOnEscapeKey = false,
                DisableBackdropClick = true
            };

        var parameters = new DialogParameters<DetailDialog> { { x => x.detail, detail }, { x => x.Customers, Customers }, { x => x.charges, charges }, { x => x.Types, Types }, { x => x.usr, usr } };
        var dialog = await DialogService.ShowAsync<DetailDialog>($"Detail Invoice No [{detail.InvoiceNo}]", parameters, optionsdialog);
    }
    private async Task CreateInvoice()
    {
        var optionsdialog = new DialogOptions
            {
                ClassBackground = "class-dialog-custom",
                FullWidth = true,
                MaxWidth = MaxWidth.Medium,
                CloseOnEscapeKey = true,
                DisableBackdropClick = true,
                CloseButton = true
            };
        var listhddra = await shipsv.GetListHoaDonDauRaALL();
        var parameters = new DialogParameters<CreateInvoice> { { x => x.Listdata, listhddra }, { x => x.ListdataINV, Listdata }, { x => x.isNew, true }, { x => x._Invoice, new() }, { x => x.Customers, Customers } };
        var dialog = await DialogService.ShowAsync<CreateInvoice>($"Create Invoice", parameters, optionsdialog);
        var rs = await dialog.Result;
        if (rs.Canceled)
            return;
        await Refresh();
        //search
        var data = (M_TaxInvoice)rs.Data;
        _searchString = data.InvoiceNo ?? string.Empty;
    }
    async Task UpdatebyCheckboxClick(M_TaxInvoice item)
    {
        if (!await ssv.CheckPermission(usr, "Approve", "IssueInvoice"))
        {
            CallSnackBar("You have not access to Approve", MudBlazor.Severity.Warning);
            return;
        }
        var rs = await tsv.UpdateTaxInvoice(item);
        if (!rs.Flag) CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
    }
    async Task<string> getinvoiceno()
    {
        var rs = await shipsv.GetInvoiceNo();
        return rs;
    }
}