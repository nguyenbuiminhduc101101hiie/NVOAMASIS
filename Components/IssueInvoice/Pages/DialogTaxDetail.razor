
<MudGrid Style="background-color:azure;">
            <MudItem xs="5">
                <MudGrid>
                    <MudItem xs="8">
                        <MudTextField @bind-Value="Detail.STT" Label="@Localizer["No."]" />
                    </MudItem>
                    <MudItem xs="4">
                <MudTextField @bind-Value="Detail.Clucidat" Label="@Localizer["Clucidat"]" />
                    </MudItem>
                    <MudItem xs="12">
                        <MudAutocomplete @bind-Value="Detail.itemid" Label="@Localizer["itemid"]" SearchFunc="SearchItem" ToStringFunc="Charidtocharge" Clearable ResetValueOnEmptyText />
                    </MudItem>
                    <MudStack Row>
                        <MudCheckBox @bind-Checked="Detail.Approve" Label="@Localizer["Approve"]" Disabled/>
                <MudCheckBox @bind-Checked="Detail.Editable" Label="@Localizer["Editable"]" Disabled />
                <MudCheckBox @bind-Checked="Detail.Continued" Label="@Localizer["Continued"]" Disabled />
                    </MudStack>
                    <MudTextField @bind-Value="Detail.Note" Label="@Localizer["Notes"]" Placeholder="...." Lines="3" AutoGrow Variant="Variant.Filled"/>

                </MudGrid>
            </MudItem>
            <MudItem xs="7">
                <MudStack Row>
                    <MudAutocomplete @bind-Value="Detail.ExchangeRate" Label="@Localizer["Ex Change"]" Format="##,##0.##" Culture="@(_en)" SearchFunc="SearchExchange" CoerceValue Clearable ResetValueOnEmptyText />
                    <MudAutocomplete @bind-Value="Detail.Currency" Label="@Localizer["Currency"]" Variant="Variant.Outlined" SearchFunc="SearchCurrency" CoerceText="false" CoerceValue Clearable ResetValueOnEmptyText />
                    <MudAutocomplete @bind-Value="Detail.Container_Type" Label="@Localizer["Container Type"]" Variant="Variant.Outlined" SearchFunc="SearchContType" CoerceText="false" CoerceValue Clearable ResetValueOnEmptyText />
                </MudStack>
                <MudStack Row>
                    <MudNumericField T="double?" @bind-Value="Detail.dongiatruocthueVND" @bind-Value:after="@(()=>CalculateThanhTien(Detail))" Label="@Localizer["Unit Price"]" Format="#,##0.##" Culture="@(_en)" Immediate HideSpinButtons Class="text-right" />
                    <MudNumericField T="double?" @bind-Value="Detail.soLuong" @bind-Value:after="@(()=>CalculateThanhTien(Detail))" Label="@Localizer["Quantity"]" Format="#,##0.##" Culture="@(_en)" Immediate HideSpinButtons Class="text-right" />
                    <MudNumericField T="double?" Value="Detail.thanhtientruocthueVND" Label="@Localizer["Total Not Inc VAT"]" Variant="Variant.Outlined" Format="#,##0.##" Culture="@(_en)" Class="text-right" HideSpinButtons ReadOnly />
                </MudStack>
                <MudStack Row>
                    <MudTextField @bind-Value="Detail.UserID" ReadOnly Label="@Localizer["User ID"]" Variant="Variant.Outlined"/>
                    <MudTextField @bind-Value="Detail.UpdateTime" ReadOnly Label="@Localizer["Dateupdate"]" Variant="Variant.Outlined" />
                </MudStack>
            </MudItem>
        </MudGrid>
@inject IStringLocalizer<SharedResource> Localizer
@inject ShipmentService shipsv
@inject ISnackbar Snackbar
@code {
    [Parameter] public M_TaxDetail Detail { get; set; } = default!;
    [Parameter] public List<M_Customer> Customers { get; set; } = default!;
    [Parameter] public List<M_TaxDetail> Listdata { get; set; } = default!;
    [Parameter] public List<ChargeModel> charges { get; set; } = default!;
    System.Globalization.CultureInfo _en = new System.Globalization.CultureInfo("en-US");
    List<M_MBL> ListMBLs = new List<M_MBL>();
    List<M_HBL> ListHBLs = new List<M_HBL>();
    protected async override Task OnInitializedAsync()
    {
        try
        {
            ListMBLs = await shipsv.GetListMBLALL();
            ListHBLs = await shipsv.GetListHBLALL();
        }
        catch(Exception ex)
        {
            CallSnackBar(ex.Message, MudBlazor.Severity.Error);
        }
        
    }
    private async Task<IEnumerable<Guid?>> SearchCustomer(string text)
    {
        try
        {
            var rs = Customers.Select(x => (Guid?)x.Customer_ID).Distinct();
            if (string.IsNullOrWhiteSpace(text))
            {
                return rs;
            }

            return rs.Where(x => x.ToString().Contains(text, StringComparison.OrdinalIgnoreCase));
        }
        catch (Exception)
        {
            throw;
        }
    }
    private async Task<IEnumerable<string>> SearchHBL(string text)
    {
        try
        {
            var rs = ListHBLs.Select(x => x.hbl).Distinct();
            if (string.IsNullOrWhiteSpace(text))
            {
                return rs;
            }

            return rs.Where(x => x.ToString().Contains(text, StringComparison.OrdinalIgnoreCase));
        }
        catch (Exception)
        {
            throw;
        }
    }
    private async Task<IEnumerable<string>> SearchMBL(string text)
    {
        try
        {
            var rs = ListMBLs.Select(x => x.Mbl).Distinct();
            if (string.IsNullOrWhiteSpace(text))
            {
                return rs;
            }

            return rs.Where(x => x.ToString().Contains(text, StringComparison.OrdinalIgnoreCase));
        }
        catch (Exception)
        {
            throw;
        }
    }
    private async Task<IEnumerable<double?>> SearchQuantity(string text)
    {
        try
        {
            var rs = Listdata.Select(x => x.soLuong).Distinct();
            if (string.IsNullOrWhiteSpace(text))
            {
                return rs;
            }

            return rs.Where(x => x.HasValue && x.Value.ToString().Contains(text, StringComparison.OrdinalIgnoreCase));
        }
        catch (Exception)
        {
            throw;
        }
    }

    private async Task<IEnumerable<double?>> SearchUnitPrice(string text)
    {
        try
        {
            var rs = Listdata.Select(x => x.dongiatruocthueVND).Distinct();
            if (string.IsNullOrWhiteSpace(text))
            {
                return rs;
            }

            return rs.Where(x => x.HasValue && x.Value.ToString().Contains(text, StringComparison.OrdinalIgnoreCase));
        }
        catch (Exception)
        {
            throw;
        }
    }
    private async Task<IEnumerable<string?>> SearchExchange(string text)
    {
        try
        {
            var rs = Listdata.Select(x => x.ExchangeRate).Distinct();
            if (string.IsNullOrWhiteSpace(text))
            {
                return rs;
            }

            return rs.Where(x => !string.IsNullOrEmpty(x) && x.Contains(text, StringComparison.OrdinalIgnoreCase));
        }
        catch (Exception)
        {
            throw;
        }
    }
    private async Task<IEnumerable<string?>> SearchCurrency(string text)
    {
        try
        {
            var rs = Listdata.Select(x => x.Currency).Distinct();
            if (string.IsNullOrWhiteSpace(text))
            {
                return rs;
            }

            return rs.Where(x => !string.IsNullOrEmpty(x) && x.Contains(text, StringComparison.OrdinalIgnoreCase));
        }
        catch (Exception)
        {
            throw;
        }
    }

    private async Task<IEnumerable<string?>> SearchContType(string text)
    {
        try
        {
            var rs = Listdata.Select(x => x.Container_Type).Distinct();
            if (string.IsNullOrWhiteSpace(text))
            {
                return rs;
            }

            return rs.Where(x => !string.IsNullOrEmpty(x) && x.Contains(text, StringComparison.OrdinalIgnoreCase));
        }
        catch (Exception)
        {
            throw;
        }
    }
    private async Task<IEnumerable<Guid?>> SearchItem(string text)
    {
        try
        {
            var rs = charges.Select(x => (Guid?)x.CHARGE_ID).Distinct();
            if (string.IsNullOrWhiteSpace(text))
            {
                return rs;
            }

            return charges.Where(x => (x.CHARGE_CODE + " - " + x.CHARGE).Contains(text, StringComparison.OrdinalIgnoreCase)).Select(x=>(Guid?)x.CHARGE_ID);
        }
        catch (Exception)
        {
            throw;
        }
    }
    string CusidtoCusCode(Guid? cusid)
    {
        if (cusid == null || cusid == Guid.Empty)
            return string.Empty;
        var rs = Customers.FirstOrDefault(x => x.Customer_ID == cusid);
        return rs == null ? string.Empty : $"{rs.Customer_Code} - {rs.COMPANY!}";
    }

    string Charidtocharge(Guid? id)
    {
        if (id == null || id == Guid.Empty)
            return string.Empty;
        var rs = charges.FirstOrDefault(x => x.CHARGE_ID == id);
        return rs == null ? string.Empty : $"{rs.CHARGE_CODE} - {rs.CHARGE}"!;
    }
    void CallSnackBar(string message, MudBlazor.Severity severity)
    {

        Snackbar.Configuration.SnackbarVariant = Variant.Filled;
        Snackbar.Configuration.MaxDisplayedSnackbars = 3;
        Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopRight;
        Snackbar.Add(message, severity);
    }
    private void CalculateThanhTien(M_TaxDetail item)
    {
        if (item.dongiatruocthueVND.HasValue && item.soLuong.HasValue)
        {
            item.thanhtientruocthueVND = Math.Round(item.dongiatruocthueVND.Value * item.soLuong.Value, 2);
        }
        else
        {
            item.thanhtientruocthueVND = 0; // Hoặc null, tùy theo yêu cầu của bạn
        }
    }
}
