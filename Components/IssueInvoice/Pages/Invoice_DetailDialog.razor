<MudDialog>
    <DialogContent>
        <DialogTaxInvoice Detail="detail" Customers="Customers" Listdata="Listdata" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@Cancel" Color="Color.Secondary">@Localizer["Cancel"]</MudButton>
        <MudButton OnClick="@Submit" Color="Color.Primary">@Localizer["Submit"]</MudButton>
    </DialogActions>
</MudDialog>
@inject IStringLocalizer<SharedResource> Localizer
@code {
    [Parameter] public M_TaxInvoice? detail { get; set; } = default!;
    [CascadingParameter] MudDialogInstance? MudDialog { get; set; }
    [Parameter] public List<M_Customer>? Customers { get; set; } = default!;
    [Parameter] public List<M_TaxInvoice> Listdata { get; set; } = default!;
    void Submit() => MudDialog.Close(detail);
    void Cancel() => MudDialog.Cancel();
}
