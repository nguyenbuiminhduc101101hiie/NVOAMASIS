<MudDialog>
    <DialogContent>

        <MudSelect @bind-Value="currency" Label="CURRENCY" >
            <MudSelectItem Value="@("VND")">VND</MudSelectItem>
            <MudSelectItem Value="@("USD")">USD</MudSelectItem>
        </MudSelect>


    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => Muddialog.Cancel())">Close</MudButton>
        @*   <MudButton OnClick="@(()=> Muddialog.Close(DebitSelected))" Color="Color.Primary" Disabled="DebitSelected == null">Ok</MudButton> *@
        <MudButton OnClick="@(() => Muddialog.Close(DialogResult.Ok(( currency))))"
                   Color="Color.Primary">
            Ok
        </MudButton>

    </DialogActions>
</MudDialog>
@inject ShipmentService ssv
@code {
    [CascadingParameter] public MudDialogInstance Muddialog { get; set; }
    [Parameter] public M_Quotation quotation_details { get; set; }

    string currency ="VND";
    
}
