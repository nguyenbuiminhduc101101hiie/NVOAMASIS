@code {
    Models.M_Quotation Quotation_detail;
    Guid? QuotationId;
    private List<Models.M_Quotation> listImport = new List<Models.M_Quotation>();
    private int selectedRowNumber = -1;
    private MudDataGrid<Models.M_Quotation> mudTable;
    private string Search_QuoNo;
    private List<Models.M_Customer> CustomerList = new List<Models.M_Customer>();
    private List<Models.TrangThai> Trangthais = new List<Models.TrangThai>();
    private string FontSizeStyle = "";
    private bool _processingUpload = false;
    private bool _processingExportFormQou = false;
    private bool _resizeColumn;
    string usr;
    protected override async Task OnInitializedAsync()
    {

        usr = asv.GetAuth().Result.User.Identity!.Name!;
        Trangthais = await supsv.GetListTrangThai();
        // await HandleRefresh();
        CustomerList = await Cussv.GetList();

    }

    async Task CommittedItemChanges(Models.M_Quotation item)
    {
        var rs = await QuoSv.UpdateQuotationRequest(item);
        CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);

    }
    async Task RowClicked(DataGridRowClickEventArgs<Models.M_Quotation> args)
    {
        Quotation_detail = args.Item;
        QuotationId = args.Item.quotationID;

    }

    string CustomerName(Guid? customerID)
    {
        var rs = CustomerList.FirstOrDefault(x => x.Customer_ID == customerID);
        return rs != null ? rs.COMPANY! : "";
    }

    private string SelectedRowClassFunc(Models.M_Quotation Sis, int rowNumber)
    {
        if (selectedRowNumber == rowNumber)
        {
            selectedRowNumber = -1;
            return string.Empty;
        }
        else if (mudTable.SelectedItem != null && mudTable.SelectedItem.Equals(Sis))
        {
            selectedRowNumber = rowNumber;
            return "selected";
        }
        else
        {
            return string.Empty;
        }
    }
    async Task HandleRefresh(){

        try
        {
            Quotation_detail = null;
            QuotationId = null;

            listImport.Clear();

            await Task.Delay(500);

            if (!await ssv.CheckPermission(asv.GetAuth().Result.User.Identity.Name, "View", "Booking-Request"))
            {
                CallSnackBar(Localizer["NoPermission_View"], MudBlazor.Severity.Warning);

                return;
            }
            listImport = await QuoSv.GetListQuotation();
            StateHasChanged();
        }
        finally
        {


        }
    }

    async Task HandleRefresh_create(Guid? id)
    {
        try
        {

            Quotation_detail = null;
            QuotationId = null;

            listImport.Clear();
            StateHasChanged();
            await Task.Delay(500);

            if (!await ssv.CheckPermission(asv.GetAuth().Result.User.Identity.Name, "View", "Quotation"))
            {
                CallSnackBar(Localizer["NoPermission_View"], MudBlazor.Severity.Warning);

                return;
            }
            listImport = await QuoSv.GetListQuotation_create(id);
        }
        finally
        {


        }
    }

    async Task OpenCreateDialog(Models.M_Quotation tr)
    {
        var optionsdialog = new DialogOptions { ClassBackground = "class-dialog-custom", FullWidth = true, MaxWidth = MaxWidth.Medium };
        if (tr == null)
        {
            CallSnackBar(Localizer["PleaseSelectData"], MudBlazor.Severity.Warning);
            return;
        }

        if (await ssv.CheckPermission(asv.GetAuth().Result.User.Identity.Name, "Add", "Quotation"))
        {

            DialogOptions closeOnEscapeKey = new DialogOptions() { CloseOnEscapeKey = true };
            var parameters = new DialogParameters<AddQuotation> { { x => x._QuotationDetail, tr }, { x => x.Status, "add" } };

            var dialog = await DialogService.ShowAsync<AddQuotation>(tr.quotationID == Guid.Empty ? "Quotation Create" : "Quotation Edit", parameters, optionsdialog);
            var result = await dialog.Result;
            if (!result.Canceled)
            {
                var data = (M_Quotation)result.Data;
                var rs = await QuoSv.UpdateOrCreateQuotation(data);
                await HistoryLogService.LogAsync(usr, "ADD", "Quotation", data.quotationID, data.quotationNo, data);
                MudBlazor.Severity severity;
                if (rs[1] == "1")
                    severity = MudBlazor.Severity.Success;
                else
                    severity = MudBlazor.Severity.Error;

                CallSnackBar(rs[0], severity);


                await HandleRefresh_create(data.quotationID);

            }

            return;

        }
        else
        {
            CallSnackBar(Localizer["NoPermission_Add"], MudBlazor.Severity.Warning);
            return;
        }

    }

    private async Task OpenEditDialog(Models.M_Quotation tr)
    {
        var optionsdialog = new DialogOptions { ClassBackground = "class-dialog-custom", FullWidth = true, MaxWidth = MaxWidth.Medium };
        if (tr == null)
        {
            CallSnackBar(Localizer["PleaseSelectData"], MudBlazor.Severity.Warning);
            return;
        }
        if (tr.Approve == true)
        {
            CallSnackBar(Localizer["DataAlreadyApproved"], MudBlazor.Severity.Warning);
            return;
        }
        if (await ssv.CheckPermission(asv.GetAuth().Result.User.Identity.Name, "Edit", "Quotation"))
        {
            var OldData = JsonSerializer.Deserialize<M_Quotation>(JsonSerializer.Serialize(tr));
            DialogOptions closeOnEscapeKey = new DialogOptions() { CloseOnEscapeKey = true };
            var parameters = new DialogParameters<AddQuotation> { { x => x._QuotationDetail, tr }, { x => x.Status, "edit" } };

            var dialog = await DialogService.ShowAsync<AddQuotation>(tr.quotationID == Guid.Empty ? "Quotation Edit" : "Quotation Edit", parameters, optionsdialog);
            var result = await dialog.Result;
            // Giữ nguyên dòng được chọn
            selectedRowNumber = selectedRowNumber;
            StateHasChanged();

            if (!result.Canceled)
            {
                var data = (M_Quotation)result.Data;
                var rs = await QuoSv.UpdateOrCreateQuotation(data);
                await HistoryLogService.LogAsync(usr, "Update", "Quotation", data.quotationID, data.quotationNo, new { OldData = OldData, NewData = data });

                MudBlazor.Severity severity;
                if (rs[1] == "1")
                    severity = MudBlazor.Severity.Success;
                else
                    severity = MudBlazor.Severity.Error;

                CallSnackBar(rs[0], severity);
            }

            return;

        }
        else
        {
            CallSnackBar(Localizer["NoPermission_Edit"], MudBlazor.Severity.Warning);
            return;
        }

    }

    private async Task OpenDuplicateDialog(Models.M_Quotation tr)
    {
        var optionsdialog = new DialogOptions { ClassBackground = "class-dialog-custom", FullWidth = true, MaxWidth = MaxWidth.Medium };
        if (tr == null)
        {
            CallSnackBar(Localizer["PleaseSelectData"], MudBlazor.Severity.Warning);
            return;
        }

        if (await ssv.CheckPermission(asv.GetAuth().Result.User.Identity.Name, "Add", "Quotation"))
        {
            var OldData = JsonSerializer.Deserialize<M_Quotation>(JsonSerializer.Serialize(tr));
            tr.quotationID = Guid.Empty;
            DialogOptions closeOnEscapeKey = new DialogOptions() { CloseOnEscapeKey = true };
            var parameters = new DialogParameters<AddQuotation> { { x => x._QuotationDetail, tr }, { x => x.Status, "Duplicate" } };

            var dialog = await DialogService.ShowAsync<AddQuotation>(tr.quotationID == Guid.Empty ? "Quotation Add" : "Quotation Add", parameters, optionsdialog);
            var result = await dialog.Result;
            // Giữ nguyên dòng được chọn
            selectedRowNumber = selectedRowNumber;
            StateHasChanged();

            if (!result.Canceled)
            {
                var data = (M_Quotation)result.Data;
                var rs = await QuoSv.UpdateOrCreateQuotation(data);
                await HistoryLogService.LogAsync(usr, "Duplicate", "Quotation", data.quotationID, data.quotationNo, new { OldData = OldData, NewData = data });
                MudBlazor.Severity severity;
                if (rs[1] == "1")
                    severity = MudBlazor.Severity.Success;

                 
                else
                    severity = MudBlazor.Severity.Error;

                CallSnackBar(rs[0], severity);
                await HandleRefresh_create(data.quotationID);
            }

            return;

        }
        else
        {
            CallSnackBar(Localizer["NoPermission_Add"], MudBlazor.Severity.Warning);
            return;
        }

    }

    private async Task Delete()
    {
        try
        {
            if (Quotation_detail.Approve == true)
            {
                CallSnackBar(Localizer["DataAlreadyApproved"], MudBlazor.Severity.Warning);
                return;
            }
            if (!await ssv.CheckPermission(asv.GetAuth().Result.User.Identity.Name, "Delete", "Quotation"))
            {
                CallSnackBar(Localizer["NoPermission_Delete"], MudBlazor.Severity.Warning);
                return;
            }
            if (QuotationId== null)
            {
                CallSnackBar(Localizer["PleaseSelectData"], MudBlazor.Severity.Warning);
                return;
            }
            var resultMess = await DialogService.ShowMessageBox(
                Localizer["Warning"],
                Localizer["DeleteConfirmBody"],
                yesText: Localizer["delete"], cancelText: Localizer["cancel"]);

            if (resultMess.HasValue)
            {

                var bkdetail = await QuoSv.GetDetailQuotationFromID(QuotationId);
                var result = await QuoSv.DeleteQuotation(Quotation_detail);
                var result_Debit = await QuoSv.DeleteQuotation_Debit(Quotation_detail);
                var result_Credit = await QuoSv.DeleteQuotation_CreDit(Quotation_detail);
                await HistoryLogService.LogAsync(usr, "Delete", "Quotation", Quotation_detail.quotationID, Quotation_detail.quotationNo, new { OldData = Quotation_detail });

                if (result.Flag)
                    CallSnackBar(result.Message, MudBlazor.Severity.Success);
                else
                {
                    CallSnackBar(result.Message, MudBlazor.Severity.Error);
                    return;
                }

                await HandleRefresh();
            }
        }
        catch (Exception ex)
        {
            CallSnackBar(string.Format(Localizer["DeleteError"], ex.Message), MudBlazor.Severity.Error);

        }

    }

    void CallSnackBar(string message, MudBlazor.Severity severity)
    {

        Snackbar.Configuration.SnackbarVariant = Variant.Filled;
        Snackbar.Configuration.MaxDisplayedSnackbars = 3;
        Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopRight;
        Snackbar.Add(message, severity);
    }
    async Task ExportBill()
    {
        if (Quotation_detail == null)
        {
            CallSnackBar(Localizer["SelectOneQuotation"], MudBlazor.Severity.Warning);
            return;
        }
        var formDialogOptions = new DialogOptions
        {
            CloseOnEscapeKey = true,
            MaxWidth = MaxWidth.Small,
            FullWidth = true,
        };
        var formDialogParams = new DialogParameters { ["FormKind"] = NVOAMASIS.Models.BillLayoutFormKind.Quotation };
        var formDialogRef = await DialogService.ShowAsync<NVOAMASIS.Components.Shipment.Pages.DialogLayoutFormExportOption>(
            "Export Quotation - Chọn mẫu form", formDialogParams, formDialogOptions);
        var formResult = await formDialogRef.Result;
        if (formResult.Canceled) return;
        var formOpts = (NVOAMASIS.Components.Shipment.Pages.DialogLayoutFormExportOption.LayoutFormExportOptions)formResult.Data!;

        var optionsdialog = new DialogOptions
        {
            ClassBackground = "class-dialog-custom",
            FullWidth = true,
            MaxWidth = MaxWidth.Small,
            CloseOnEscapeKey = false,
            DisableBackdropClick = true,
        };
        var parameters = new DialogParameters<Export_bill> { { x => x.quotation_details, Quotation_detail } };
        var dialog = await DialogService.ShowAsync<Export_bill>("Selected Debit No.", parameters, optionsdialog);
        var result = await dialog.Result;
        if (result.Canceled) return;
        var cur_type = (string)result.Data;

        _processingUpload = true;
        StateHasChanged();
        await Task.Delay(1);
        var rs = await QuoSv.ExportQuotation(Quotation_detail.quotationID!, cur_type, formOpts.LayoutFormId);
        CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
        _processingUpload = false;
    }
 

    private async Task ExportFormExcelQuo()
    {
        _processingExportFormQou = true;

        try
        {
            var fileUrl = $"{Nav.BaseUri}Reports/FormExportQuo.xlsx";
            await JSRuntime.InvokeVoidAsync("downloadFileFromUrl", fileUrl);
        }
        finally
        {
            _processingExportFormQou = false;
        }
    }


    async Task SendEmail()
    {

        // if (Quotation_detail.customer_id)
        string email_Cus = Cussv.GetIdcusfromID(Quotation_detail.customer_id);

        if (!string.IsNullOrEmpty(email_Cus))
        {
            var (success, message, pdfFile) = await QuoSv.ExportQuotation_file(QuotationId);
            bool result = await emsv.SendEmailAttachment_Quotation(email_Cus, "Your Quotation", "Please find attached your bill.", pdfFile, "Quotation.pdf");
            if (result = true)
            {
                await HistoryLogService.LogAsync(usr, "SendEmail", "Quotation", Quotation_detail.quotationID, Quotation_detail.quotationNo, new { DataSend = Quotation_detail });

                CallSnackBar(Localizer["EmailSentSuccess"], MudBlazor.Severity.Success);
            }
            else
            {
                CallSnackBar(Localizer["EmailSentFailed"], MudBlazor.Severity.Error);
            }
        }
        else
        {
            CallSnackBar(Localizer["EmailCustomerEmpty"], MudBlazor.Severity.Error);
        }

    }

    private bool FilterFunc1(Models.M_Quotation bt) => FilterFunc(bt, Search_QuoNo);

    private bool FilterFunc(Models.M_Quotation bt, string search_InvNo)
    {
        if (string.IsNullOrWhiteSpace(search_InvNo))
            return true;
        if (bt.quotationNo!.Contains(search_InvNo, StringComparison.OrdinalIgnoreCase))
            return true;

        if ($"{bt.quotationNo} ".Contains(search_InvNo))
            return true;
        return false;
    }

