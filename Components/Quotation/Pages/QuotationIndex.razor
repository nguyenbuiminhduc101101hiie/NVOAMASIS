
@page "/QuotationIndex"
@using System.Net
@using System.Diagnostics
@inject EmailService emsv
@inject QuotationService QuoSv
@inject SharedServices ssv
@inject TrainScheduleServices trainsv
@inject BookingService bksv
@inject AccountService asv
@inject CustomerService Cussv
@inject SupportServices supsv
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject FontService FontSizeService
@inject IStringLocalizer<SharedResource> Localizer
@inject HistoryLogService HistoryLogService
@inject NavigationManager Nav
@inject IJSRuntime JSRuntime

@using System.Text.Json;
@attribute [Authorize]

<MudContainer MaxWidth=MaxWidth.False>
    <CascadingValue Value="FontSizeService">
  

            <MudText Class="pa-2" Typo="Typo.h6">@Localizer["Quotation"]</MudText>
            <MudStack Row Justify="Justify.FlexStart" Class="pa-4">

                <MudButton HtmlTag="label"
                           OnClick="HandleRefresh"
                           Size="Size.Small" Color="Color.Primary" Variant="   Variant.Filled"
                           StartIcon="@Icons.Material.Filled.Refresh">

                    @Localizer["reload"]
                </MudButton>
                <MudButton HtmlTag="label"
                           @onclick="@((e) => OpenCreateDialog(new Models.M_Quotation()))"
                           Size="Size.Small" Color="Color.Secondary" Variant="Variant.Filled"
                           StartIcon="@Icons.Material.Filled.Add">
                    @Localizer["new"]
                </MudButton>
                <MudButton HtmlTag="label"
                           @onclick="@((e) => OpenEditDialog(Quotation_detail))"
                           Size="Size.Small" Color="Color.Info" Variant="Variant.Filled"
                           StartIcon="@Icons.Material.Filled.Edit">
                    @Localizer["edit"]
                </MudButton>

                <MudButton HtmlTag="label"
                           OnClick="Delete"
                           Size="Size.Small" Color="Color.Error" Variant="Variant.Filled"
                           StartIcon="@Icons.Material.Filled.Delete">
                    @Localizer["delete"]
                </MudButton>
            <MudButton HtmlTag="label"
                       @onclick="@((e) => OpenDuplicateDialog(Quotation_detail))"
                       Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled"
                       StartIcon="@Icons.Material.Filled.CopyAll">
                @Localizer["duplicate"]
            </MudButton>
             @*    <MudButton HtmlTag="label"
                           @onclick="@(() => ExportBill())"
                           Size="Size.Small" Color="Color.Error" Variant="Variant.Filled"
                           StartIcon="@Icons.Material.Filled.Download">
                    @Localizer["Export_Bill"]
                </MudButton> *@

            <MudButton Disabled="_processingUpload"
                       OnClick="ExportBill"
                       Size="Size.Small" Color="Color.Error" Variant="Variant.Filled"
                       StartIcon="@Icons.Material.Filled.Download">
                @if (_processingUpload)
                {
                    <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                    <MudText Class="ms-2">Processing</MudText>
                }
                else
                {
                    <MudText>@Localizer["Export_Bill"]</MudText>
                }
            </MudButton>
            <MudButton HtmlTag="label"
            @onclick="@(() => SendEmail())"
            Size="Size.Small" Color="Color.Error" Variant="Variant.Filled"
            StartIcon="@Icons.Material.Filled.Email">
                @Localizer["Send Email"]
            </MudButton>
            <MudButton Disabed="_processingExportFormQou"
                       OnClick="ExportFormExcelQuo"
                       Size="Size.Small" Color="Color.Error" Variant="Variant.Filled"
                       StartIcon="@Icons.Material.Filled.Download">
                @if (_processingExportFormQou)
                {
                    <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                    <MudText Class="ms-2">Processing</MudText>
                }
                else
                {
                    <MudText>@Localizer["Export Form Quotation"]</MudText>
                }
            </MudButton>
        </MudStack>

    </CascadingValue>
</MudContainer>

<MudSpacer></MudSpacer>
<MudSpacer></MudSpacer>


<MudContainer MaxWidth=MaxWidth.False>
    <MudDataGrid T="Models.M_Quotation" Items="@listImport.ToList()" 
