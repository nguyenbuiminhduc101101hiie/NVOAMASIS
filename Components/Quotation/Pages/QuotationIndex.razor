            </PropertyColumn>

            <PropertyColumn Property="x => x.o1" Title="@(Localizer["Group1"])" CellStyleFunc="_cellStyleFunc">
                <FooterTemplate>
                    @Localizer["Group1"]
                </FooterTemplate>
            </PropertyColumn>

            <PropertyColumn Property="x => x.o2" Title="@(Localizer["Group2"])" CellStyleFunc="_cellStyleFunc">
                <FooterTemplate>
                    @Localizer["Group2"]
                </FooterTemplate>
            </PropertyColumn>

            <PropertyColumn Property="x => x.o3" Title="@(Localizer["Group3"])" CellStyleFunc="_cellStyleFunc">
                <FooterTemplate>
                    @Localizer["Group3"]
                </FooterTemplate>
            </PropertyColumn>

            <PropertyColumn Property="x => x.o4" Title="@(Localizer["Group4"])" CellStyleFunc="_cellStyleFunc">
                <FooterTemplate>
                    @Localizer["Group4"]
