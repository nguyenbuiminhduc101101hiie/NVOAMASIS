@using System.Globalization

@inject ISnackbar Snackbar
@inject AccountService asv
@inject BookingService bksv
@inject QuotationService QuoSV
@inject CustomerService CusSV
@inject EmailService emsv
@inject IJSRuntime JSRuntime
@inject IStringLocalizer<SharedResource> Localizer
@inject SharedServices ssv
@inject SupportServices supsv
@inject QuotationService Quosv
@inject IJSRuntime JS



<MudDialog>
    <DialogContent>
        <MudForm Model="@_QuotationDetail" @ref="@form">
            <MudContainer>
                <MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-3" MinimumTabWidth="20px">
                    <MudTabPanel Text="Information">
                        <MudGrid Spacing="1">
                            <MudItem xs="12">
                                <MudAutocomplete Class="labelCustomColor" T="Guid?" Label="@Localizer["Customer"]"
                                    @bind-Value="_QuotationDetail.customer_id"
                                    Required="true"
                                    Margin="Margin.Dense"
                                    AdornmentColor="@ColorTextFields"
                                    SearchFunc="Search_customer"
                                    ToStringFunc="GetCustomerLabel" />
                            </MudItem>
                            <MudItem xs="12">
                                <MudGrid Spacing="1">
                                    <MudItem xs="12" sm="1">
                                        <MudButton Class="labelCustomColor" Style="background-color: #007BFF; color: white;" Size="Size.Small" Color="Color.Primary" Disabled="@(Status == "edit")" OnClick="@GetQuotation_No">>>></MudButton>
                                    </MudItem>
                                    <MudItem xs="12" sm="3">
                                        <MudTextField Class="labelCustomColor" @bind-Value="_QuotationDetail.quotationNo"
                                            For="@(() => _QuotationDetail.quotationNo)" Required="true"
                                            Margin="Margin.Dense"
                                            AdornmentColor="@ColorTextFields"
                                            Immediate="true"
                                            ReadOnly="true"
                                            Label="@Localizer["QuotationNo"]" />
                                    </MudItem>
                                    <MudItem xs="12" sm="4">
                                        <MudAutocomplete Class="labelCustomColor" T="string" Label="@Localizer["BookingNo"]"
                                            @bind-Value="_QuotationDetail.BookingNo"
                                            Margin="Margin.Dense"
                                            CoerceText="true"
                                            Clearable="true"
                                            AdornmentColor="@ColorTextFields"
                                            SearchFunc="Search_Booking" />
                                    </MudItem>
                                    <MudItem xs="12" sm="4">
                                        <MudTextField Class="labelCustomColor" T="string" Label="@Localizer["Subject"]"
                                            Margin="Margin.Dense"
                                            @bind-Value="_QuotationDetail.Subject" />
                                    </MudItem>
                                </MudGrid>
                            </MudItem>
                            <MudItem xs="12">
                                <MudGrid Spacing="1">
                                    <MudItem xs="6" sm="3">
                                        <MudTextField Class="labelCustomColor" T="string" Label="@Localizer["group1"]"
                                            Margin="Margin.Dense"
                                            @bind-Value="_QuotationDetail.o1" />
                                    </MudItem>
                                    <MudItem xs="6" sm="3">
                                        <MudTextField Class="labelCustomColor" T="string" Label="@Localizer["group2"]"
                                            Margin="Margin.Dense"
                                            @bind-Value="_QuotationDetail.o2" />
                                    </MudItem>
                                    <MudItem xs="6" sm="3">
                                        <MudTextField Class="labelCustomColor" T="string" Label="@Localizer["group3"]"
                                            Margin="Margin.Dense"
                                            @bind-Value="_QuotationDetail.o3" />
                                    </MudItem>
                                    <MudItem xs="6" sm="3">
                                        <MudTextField Class="labelCustomColor" T="string" Label="@Localizer["group4"]"
                                            Margin="Margin.Dense"
                                            @bind-Value="_QuotationDetail.o4" />
                                    </MudItem>
                                </MudGrid>
                            </MudItem>
                            <MudItem xs="12">
                                <MudGrid Spacing="1">
                                    <MudItem xs="6" sm="3">
                                        <MudTextField Class="labelCustomColor" T="string" Label="@Localizer["terms"]"
                                            Margin="Margin.Dense"
                                            @bind-Value="_QuotationDetail.terms" />
                                    </MudItem>
                                    <MudItem xs="6" sm="3">
                                        <MudSelect Class="labelCustomColor" @bind-Value="_QuotationDetail.type"
                                            T="string"
                                            Margin="Margin.Dense"
                                            AdornmentColor="@ColorTextFields"
                                            Immediate="true"
                                            Label="@Localizer["Type"]">
                                            <MudSelectItem Value="@("DIRECT")">DIRECT</MudSelectItem>
                                            <MudSelectItem Value="@("IN-DIRECT")">IN-DIRECT</MudSelectItem>
                                            <MudSelectItem Value="@("NULL")">NULL</MudSelectItem>
                                        </MudSelect>
                                    </MudItem>
                                    <MudItem xs="6" sm="3">
                                        <MudTextField Class="labelCustomColor" T="string" Label="@Localizer["Transit_Time"]"
                                            Margin="Margin.Dense"
                                            @bind-Value="_QuotationDetail.TransitTime" />
                                    </MudItem>
                                    <MudItem xs="6" sm="3">
                                        <MudAutocomplete Class="labelCustomColor" T="string"
                                            @bind-Value="_QuotationDetail.Transitport"
                                            Label="@Localizer["Transit_Port"]"
                                            Margin="Margin.Dense"
                                            SearchFunc="Search_TransitPort"
                                            AdornmentColor="@ColorTextFields"
                                            Immediate="true"
                                            CoerceText="true"
                                            Clearable="true"
                                            MaxItems="100" />
                                    </MudItem>
                                </MudGrid>
                            </MudItem>
                            <MudItem xs="12">
                                <MudGrid Spacing="1">
                                    <MudItem xs="12" sm="6">
                                        <MudAutocomplete Class="labelCustomColor" T="string"
                                            @bind-Value="_QuotationDetail.pol"
                                            Label="@Localizer["POL"]"
                                            Margin="Margin.Dense"
                                            SearchFunc="Search_Port"
                                            AdornmentColor="@ColorTextFields"
                                            Immediate="true"
                                            CoerceText="true"
                                            Clearable="true"
                                            MaxItems="100" />
                                    </MudItem>
                                    <MudItem xs="12" sm="6">
                                        <MudAutocomplete Class="labelCustomColor" T="string"
                                            @bind-Value="_QuotationDetail.pod"
                                            Label="@Localizer["POD"]"
                                            Margin="Margin.Dense"
                                            SearchFunc="Search_Port"
                                            AdornmentColor="@ColorTextFields"
                                            Immediate="true"
                                            CoerceText="true"
                                            Clearable="true"
                                            MaxItems="100" />
                                    </MudItem>
                                </MudGrid>
                            </MudItem>
                            <MudItem xs="12">
                                <MudGrid Spacing="1">
                                    <MudItem xs="12" sm="6">
                                        <MudAutocomplete Class="labelCustomColor" T="string"
                                            @bind-Value="_QuotationDetail.shippingline"
                                            Label="@Localizer["Shipping_Line"]"
                                            Margin="Margin.Dense"
                                            SearchFunc="Search_Carrier"
                                            AdornmentColor="@ColorTextFields"
                                            Immediate="true"
                                            CoerceText="true"
                                            Clearable="true"
                                            MaxItems="100" />
                                    </MudItem>
                                    <MudItem xs="12" sm="6">
                                        <MudAutocomplete Class="labelCustomColor" T="string"
                                            @bind-Value="_QuotationDetail.MasterColoader"
                                            Label="@Localizer["Master_Coloader"]"
                                            Margin="Margin.Dense"
                                            AdornmentColor="@ColorTextFields"
                                            SearchFunc="Search_Coloader"
                                            Immediate="true"
                                            CoerceText="true"
                                            Clearable="true"
                                            MaxItems="100" />
                                    </MudItem>
                                </MudGrid>
                            </MudItem>
                            <MudItem xs="12">
                                <MudGrid Spacing="1">
                                    <MudItem xs="6" sm="2">
                                        <MudAutocomplete Class="labelCustomColor" T="string"
                                            @bind-Value="cbofrom"
                                            Label="@Localizer["from"]"
                                            Margin="Margin.Dense"
                                            SearchFunc="Search_port_from"
                                            AdornmentColor="@ColorTextFields"
                                            Immediate="true"
                                            OnBlur="LinkRouting"
                                            CoerceText="true"
                                            Clearable="true"
                                            MaxItems="200" />
                                    </MudItem>
                                    <MudItem xs="6" sm="2">
                                        <MudAutocomplete Class="labelCustomColor" T="string"
                                            @bind-Value="cboto"
                                            Label="@Localizer["to"]"
                                            Margin="Margin.Dense"
                                            SearchFunc="Search_port_to"
                                            AdornmentColor="@ColorTextFields"
                                            Immediate="true"
                                            OnBlur="LinkRouting"
                                            CoerceText="true"
                                            Clearable="true"
                                            MaxItems="200" />
                                    </MudItem>
                                    <MudItem xs="12" sm="4">
                                        <MudTextField Class="labelCustomColor" T="string" Label="@Localizer["Routing"]"
                                            Margin="Margin.Dense"
                                            @bind-Value="_QuotationDetail.Routing" />
                                    </MudItem>
                                    <MudItem xs="6" sm="2">
                                        <MudAutocomplete Class="labelCustomColor" T="string"
                                            @bind-Value="_QuotationDetail.SaleName"
                                            Label="@Localizer["SaleName"]"
                                            Margin="Margin.Dense"
                                            SearchFunc="Search_User"
                                            Immediate="true"
                                            CoerceText="true"
                                            Clearable="true"
                                            MaxItems="100" />
                                    </MudItem>
                                    <MudItem xs="6" sm="2">
                                        <MudSelect Class="labelCustomColor" @bind-Value="_QuotationDetail.status"
                                            Margin="Margin.Dense"
                                            Label="@Localizer["status"]">
                                            @foreach (var item in trangthais)
                                            {
                                                <MudSelectItem Value="@item">@item</MudSelectItem>
                                            }
                                        </MudSelect>
                                    </MudItem>
                                </MudGrid>
                            </MudItem>
                            <MudItem xs="12">
                                <MudGrid Spacing="1">
                                    <MudItem xs="6" sm="3">
                                        <MudDatePicker Class="labelCustomColor" @bind-Date="_QuotationDetail.dated"
                                            For="@(() => _QuotationDetail.dated)"
                                            Margin="Margin.Dense"
                                            AdornmentColor="@ColorTextFields"
                                            Label="@Localizer["NGAY"]"
                                            Required="true" />
                                    </MudItem>
                                    <MudItem xs="6" sm="3">
                                        <MudDatePicker Class="labelCustomColor" @bind-Date="_QuotationDetail.validDate"
                                            For="@(() => _QuotationDetail.validDate)"
                                            Margin="Margin.Dense"
                                            AdornmentColor="@ColorTextFields"
                                            Label="@Localizer["NgayHieuLuc"]"
                                            Required="true" />
                                    </MudItem>
                                    <MudItem xs="6" sm="3">
                                        <MudDatePicker Class="labelCustomColor" @bind-Date="_QuotationDetail.ETA"
                                            For="@(() => _QuotationDetail.ETA)"
                                            Margin="Margin.Dense"
                                            AdornmentColor="@ColorTextFields"
                                            Label="ETA"
                                            Required="true" />
                                    </MudItem>
                                    <MudItem xs="6" sm="3">
                                        <MudDatePicker Class="labelCustomColor" @bind-Date="_QuotationDetail.ETD"
                                            For="@(() => _QuotationDetail.ETD)"
                                            Margin="Margin.Dense"
                                            AdornmentColor="@ColorTextFields"
                                            Label="ETD"
                                            Required="true" />
                                    </MudItem>
                                </MudGrid>
                            </MudItem>
                            <MudItem xs="12">
                                <MudGrid Spacing="1">
                                    <MudItem xs="6" sm="3">
                                        <MudNumericField @bind-Value="_QuotationDetail.SL"
                                            Label="@Localizer["Quantity_volume"]"
                                            Format="#,##0.##"
                                            Culture="@_en"
                                            T="double?"
                                            HideSpinButtons="true"
                                            Margin="Margin.Dense"
                                            Class="text-right labelCustomColor" />
                                    </MudItem>
                                    <MudItem xs="6" sm="3">
                                        <MudTextField Class="labelCustomColor" T="string"
                                            Label="@Localizer["loaivolume"]"
                                            Margin="Margin.Dense"
                                            @bind-Value="_QuotationDetail.loaivolume" />
                                    </MudItem>
                                    <MudItem xs="6" sm="3">
                                        <MudTextField Class="labelCustomColor" T="string"
                                            Label="@Localizer["ghichu"]"
                                            Margin="Margin.Dense"
                                            Lines="3"
                                            @bind-Value="_QuotationDetail.remarks" />
                                    </MudItem>
                                    <MudItem xs="6" sm="3">
                                        <MudTextField Class="labelCustomColor" T="string"
                                            Label="@Localizer["TenHang_gs"]"
                                            Margin="Margin.Dense"
                                            Lines="3"
                                            @bind-Value="_QuotationDetail.description" />
                                    </MudItem>
                                </MudGrid>
                            </MudItem>
                        </MudGrid>
                    </MudTabPanel>

                    @*  ----------------------------------Debit----------------------------------------- *@
                    <MudTabPanel Text="Debit"  Disabled="_QuotationDetail.quotationID == Guid.Empty">
                        <Debit _QuotationDetail="_QuotationDetail" />
                    </MudTabPanel>
                    @*  ----------------------------------Credit----------------------------------------- *@
                    <MudTabPanel Text="Credit" Disabled="_QuotationDetail.quotationID == Guid.Empty">
                        <Credit _QuotationDetail="_QuotationDetail"/>
                    </MudTabPanel>
                </MudTabs>
            </MudContainer>
        </MudForm>
    </DialogContent>

    <DialogActions>

        <MudButton OnClick="@(async () => await Submit())">Save</MudButton>
        <MudButton OnClick="Cancel">Cancel</MudButton>

    </DialogActions>

</MudDialog>

@code {

    [CascadingParameter] MudDialogInstance? MudDialog { get; set; }
    Color ColorTextFields = Color.Primary;
    [Parameter] public Models.M_Quotation _QuotationDetail { get; set; }
    [Parameter] public string Status { get; set; }
    List<M_Customer> customers = new List<M_Customer>();
    List<M_Customer> customers_shipping = new List<M_Customer>();
    List<M_Customer> customers_coloader = new List<M_Customer>();
    List<Booking> bookings = new List<Booking>();
    List<M_RFQ> RFQs = new List<M_RFQ>();
    List<PortModel> Ports = new List<PortModel>();
    private List<string> ListPOrt_Code_from { get; set; } = new List<string>();
    private List<string> ListPOrt_Code_to { get; set; } = new List<string>();
    private List<string> ListUser { get; set; } = new List<string>();
    string cbofrom = "";
    string cboto = "";
    List<string> trangthais = new List<string>();
    private bool IsLoading = true;
    public CultureInfo _en = CultureInfo.GetCultureInfo("en-US");
    protected override async Task OnInitializedAsync()
    {
        if (Status == "Duplicate")
        {
            _QuotationDetail.quotationNo = "";
            _QuotationDetail.BookingNo = "";
            _QuotationDetail.RFQ_No = "";
            // _QuotationDetail.quotationID = Guid.Empty;
            // _QuotationDetail.quotationNo = BookingNumber;
        }
        // DisableScrolling(true);
        customers = CusSV.GetList_cus_debit();
        customers_shipping = CusSV.GetList_cus_Shipping();
        customers_coloader = CusSV.GetList_cus_Coloader();
        bookings = await bksv.GetListSBooking();
        RFQs = await Quosv.GetList_RFQ_combo();
        Ports = await bksv.GetList_PORT();
        ListPOrt_Code_from = await bksv.GetList_PortCode(cbofrom) ?? new List<string>();
        ListPOrt_Code_to = await bksv.GetList_PortCode(cboto) ?? new List<string>();
        ListUser = await bksv.GetList_User(_QuotationDetail.SaleName) ?? new List<string>();
        var tts = await supsv.GetListTrangThai();
        trangthais = tts.Where(x => x.Tieude == "QUOTATION").OrderBy(x => x.Noidung).Select(x => x.Noidung).ToList();
        // await Task.Delay(3000); 
        // IsLoading = false; // Tắt overlay
        // DisableScrolling(false);
        StateHasChanged();
    }

    // private void DisableScrolling(bool disable)
    // {
    //     if (disable)
    //         _ = JS.InvokeVoidAsync("disableScroll");
    //     else
    //         _ = JS.InvokeVoidAsync("enableScroll");
    // }

    private async Task<IEnumerable<Guid?>> Search_customer(string value)
    {
        if (string.IsNullOrEmpty(value))
            return customers.Select(x => (Guid?)x.Customer_ID);

        return customers
            .Where(x => !string.IsNullOrEmpty(x.COMPANY) && 
                    x.COMPANY.Contains(value, StringComparison.InvariantCultureIgnoreCase))
        .Select(x => (Guid?)x.Customer_ID);
    }

    private string GetCustomerLabel(Guid? id)
    {
        var customer = customers.FirstOrDefault(x => x.Customer_ID == id);
        return customer != null ? customer.shortname + "___" + customer.COMPANY : string.Empty;
    }

    public async Task GetQuotation_No()
    {
        int formattedYear = DateTime.Now.Year;
        int formattedMonth = DateTime.Now.Month;

        string usr = asv.GetAuth().Result.User.Identity!.Name!;
        var refno = await supsv.GetRefNoByFunc("QUO", formattedMonth, formattedYear, usr);

        var rs = asv.GetUserDetail();
        var cn = rs.Branch;
        _QuotationDetail.quotationNo = cn + "QUO_" + formattedYear.ToString() + formattedMonth.ToString() + refno.Value.ToString("D4");
    }

    void CallSnackBar(string message, MudBlazor.Severity severity)
    {
        
        Snackbar.Configuration.SnackbarVariant = Variant.Filled;
        Snackbar.Configuration.MaxDisplayedSnackbars = 3;
        Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopRight;
        Snackbar.Add(message, severity);
    }
    private async Task<IEnumerable<string>> Search_Booking(string value)
    {
        if (string.IsNullOrEmpty(value))
            return bookings.Select(x => x.BookingNo).Distinct();

        return bookings
            .Where(x => x.BookingNo.Contains(value, StringComparison.InvariantCultureIgnoreCase))
            .Select(x => x.BookingNo).Distinct();
    }

    private async Task<IEnumerable<string>> Search_RFQNo(string value)
    {
        if (string.IsNullOrEmpty(value))
            return RFQs
                .Select(x => x.RFQNo)
                .Distinct(); // Loại bỏ trùng

        return RFQs
            .Where(x => x.RFQNo.Contains(value, StringComparison.InvariantCultureIgnoreCase))
            .Select(x => x.RFQNo)
            .Distinct(); // Loại bỏ trùng
    }
    MudForm form;
    private async Task Submit()
    {
        if ((await ssv.CheckPermission(asv.GetAuth().Result.User.Identity.Name, "Edit", "Quotation") || await ssv.CheckPermission(asv.GetAuth().Result.User.Identity.Name, "New", "Quotation")))
        {

            await form.Validate();

            if (form.IsValid)
            {
                if (Status == "Duplicate")
                {
                    
                    _QuotationDetail.Approve = false;
                    // _QuotationDetail.quotationNo = BookingNumber;
                }
                var UserName = asv.GetAuth().Result.User.Identity!.Name!;
                _QuotationDetail.dateupdate = DateTime.Now.ToString();
                _QuotationDetail.userupdate = UserName;
                MudDialog!.Close(_QuotationDetail);

            }
        }


    }
    void Cancel() => MudDialog.Cancel();
    private async Task<IEnumerable<string>> Search_Port(string value)
    {
        if (string.IsNullOrEmpty(value))
            return Ports.Select(x => (x.PORT + "_" + x.PORT_CODE)).OrderBy(x => x);

        return Ports
            .Where(x => (x.PORT + "_" + x.PORT_CODE).Contains(value, StringComparison.InvariantCultureIgnoreCase))
            .Select(x => (x.PORT + "_" + x.PORT_CODE))
            .OrderBy(x => x);
    }

    private async Task<IEnumerable<string>> Search_TransitPort(string value)
    {
        if (string.IsNullOrEmpty(value))
            return Ports.Select(x => x.PORT).Distinct().OrderBy(x => x);

        return Ports
            .Where(x => x.PORT.Contains(value, StringComparison.InvariantCultureIgnoreCase))
            .Select(x => x.PORT).Distinct().OrderBy(x => x);
    }

    private async Task<IEnumerable<string?>> Search_Carrier(string value)
    {
        if (string.IsNullOrEmpty(value))
            return customers_shipping.Select(x => x.COMPANY);

        return customers_shipping
            .Where(x => (x.COMPANY).Contains(value, StringComparison.InvariantCultureIgnoreCase))

            .Select(x => (x.COMPANY)).OrderBy(x => x);

    }


    private async Task<IEnumerable<string?>> Search_Coloader(string value)
    {
        if (string.IsNullOrEmpty(value))
                   return customers_coloader.Select(x => x.COMPANY);

        return customers_coloader
            .Where(x => (x.COMPANY).Contains(value, StringComparison.InvariantCultureIgnoreCase))
             
            .Select(x => ( x.COMPANY)).OrderBy(x=>x);
    }

    private async Task<IEnumerable<string>> Search_port_from(string value)
    {
        if (string.IsNullOrEmpty(value))
            return Ports.Select(x => x.PORT_CODE).Distinct().OrderBy(x => x);

        return Ports
            .Where(x => x.PORT.Contains(value, StringComparison.InvariantCultureIgnoreCase))
            .Select(x => x.PORT_CODE).Distinct().OrderBy(x => x);
        // if (string.IsNullOrEmpty(value))
        //     return ListPOrt_Code_from;

        // return ListPOrt_Code_from.Where(x => x.Contains(value, StringComparison.InvariantCultureIgnoreCase));
    }

    private async Task<IEnumerable<string>> Search_port_to(string value)
    {
           if (string.IsNullOrEmpty(value))
            return Ports.Select(x => x.PORT_CODE).Distinct();

            return Ports
                .Where(x => x.PORT.Contains(value, StringComparison.InvariantCultureIgnoreCase))
                .Select(x => x.PORT_CODE).Distinct();
        // if (string.IsNullOrEmpty(value))
        //     return ListPOrt_Code_to;

        // return ListPOrt_Code_to.Where(x => x.Contains(value, StringComparison.InvariantCultureIgnoreCase));
    }

    private async Task LinkRouting(){
        _QuotationDetail.Routing = cbofrom + "-" + cboto;
    }

     private async Task<IEnumerable<string>> Search_User(string value)
    {
        if (string.IsNullOrEmpty(value))
            return ListUser;

        return ListUser.Where(x => x.Contains(value, StringComparison.InvariantCultureIgnoreCase));
    }

}
