@using System.Globalization

@inject ISnackbar Snackbar
@inject AccountService asv
@inject BookingService bksv
@inject QuotationService QuoSV
@inject CustomerService CusSV
@inject EmailService emsv
@inject IJSRuntime JSRuntime
@inject IStringLocalizer<SharedResource> Localizer
@inject SharedServices ssv
@inject SupportServices supsv
@inject QuotationService Quosv
@inject IJSRuntime JS



<MudDialog>
    <DialogContent>
        <div class="quotation-dialog-shell">
            <MudForm Model="@_QuotationDetail" @ref="@form">
                <MudContainer MaxWidth="MaxWidth.False" Class="quotation-dialog-container">
                    <MudTabs Class="quotation-tabs" Elevation="0" Rounded="true" Border="true" ApplyEffectsToContainer="true" PanelClass="quotation-tab-panel" MinimumTabWidth="110px">
                        <MudTabPanel Text="Information">
                            <MudGrid Spacing="2" Class="quotation-form-grid">
                                <MudItem xs="12" Class="q-sec q-blue q-first">
                                    <div class="q-title"><MudIcon Icon="@Icons.Material.Filled.Business" Size="Size.Small" /> Khách hàng & số báo giá</div>
                                    <MudAutocomplete Class="labelCustomColor" T="Guid?" Label="@Localizer["Customer"]"
                                                     @bind-Value="_QuotationDetail.customer_id"
                                                     Required="true"
                                                     Margin="Margin.Dense"
                                                     AdornmentColor="@ColorTextFields"
                                                     SearchFunc="Search_customer"
                                                     ToStringFunc="GetCustomerLabel" />
                                </MudItem>
                                <MudItem xs="12" Class="q-sec q-blue q-last">
                                    <MudGrid Spacing="1">
                                        <MudItem xs="12" sm="1">
                                            <MudButton Class="quotation-generate-btn" Variant="Variant.Filled" Size="Size.Small" Color="Color.Primary" Disabled="@(Status == "edit")" OnClick="@GetQuotation_No">>>></MudButton>
                                        </MudItem>
                                        <MudItem xs="12" sm="3">
                                            <MudTextField Class="labelCustomColor" @bind-Value="_QuotationDetail.quotationNo"
                                                          For="@(() => _QuotationDetail.quotationNo)" Required="true"
                                                          Margin="Margin.Dense"
                                                          AdornmentColor="@ColorTextFields"
                                                          Immediate="true"
                                                          ReadOnly="true"
                                                          Label="@Localizer["QuotationNo"]" />
                                        </MudItem>
                                        <MudItem xs="12" sm="4">
                                            <MudAutocomplete Class="labelCustomColor" T="string" Label="@Localizer["BookingNo"]"
                                                             @bind-Value="_QuotationDetail.BookingNo"
                                                             Margin="Margin.Dense"
                                                             CoerceText="true"
                                                             Clearable="true"
                                                             AdornmentColor="@ColorTextFields"
                                                             SearchFunc="Search_Booking" />
                                        </MudItem>
                                        <MudItem xs="12" sm="4">
                                            <MudTextField Class="labelCustomColor" T="string" Label="@Localizer["Subject"]"
                                                          Margin="Margin.Dense"
                                                          @bind-Value="_QuotationDetail.Subject" />
                                        </MudItem>
                                    </MudGrid>
                                </MudItem>
                                <MudItem xs="12" Class="q-sec q-purple q-first">
                                    <div class="q-title"><MudIcon Icon="@Icons.Material.Filled.Description" Size="Size.Small" /> Nội dung & điều kiện báo giá</div>
                                    <MudGrid Spacing="1">
                                        <MudItem xs="6" sm="3">
                                            <MudTextField Class="labelCustomColor" T="string" Label="@Localizer["group1"]"
                                                          Margin="Margin.Dense"
                                                          @bind-Value="_QuotationDetail.o1" />
                                        </MudItem>
                                        <MudItem xs="6" sm="3">
                                            <MudTextField Class="labelCustomColor" T="string" Label="@Localizer["group2"]"
                                                          Margin="Margin.Dense"
                                                          @bind-Value="_QuotationDetail.o2" />
                                        </MudItem>
                                        <MudItem xs="6" sm="3">
                                            <MudTextField Class="labelCustomColor" T="string" Label="@Localizer["group3"]"
                                                          Margin="Margin.Dense"
                                                          @bind-Value="_QuotationDetail.o3" />
                                        </MudItem>
                                        <MudItem xs="6" sm="3">
                                            <MudTextField Class="labelCustomColor" T="string" Label="@Localizer["group4"]"
                                                          Margin="Margin.Dense"
                                                          @bind-Value="_QuotationDetail.o4" />
                                        </MudItem>
                                    </MudGrid>
                                </MudItem>
                                <MudItem xs="12" Class="q-sec q-purple q-last">
                                    <MudGrid Spacing="1">
                                        <MudItem xs="6" sm="3">
                                            <MudTextField Class="labelCustomColor" T="string" Label="@Localizer["terms"]"
                                                          Margin="Margin.Dense"
                                                          @bind-Value="_QuotationDetail.terms" />
                                        </MudItem>
                                        <MudItem xs="6" sm="3">
                                            <MudSelect Class="labelCustomColor" @bind-Value="_QuotationDetail.type"
                                                       T="string"
                                                       Margin="Margin.Dense"
                                                       AdornmentColor="@ColorTextFields"
                                                       Immediate="true"
                                                       Label="@Localizer["Type"]">
                                                <MudSelectItem Value="@("DIRECT")">DIRECT</MudSelectItem>
                                                <MudSelectItem Value="@("IN-DIRECT")">IN-DIRECT</MudSelectItem>
                                                <MudSelectItem Value="@("NULL")">NULL</MudSelectItem>
                                            </MudSelect>
                                        </MudItem>
                                        <MudItem xs="6" sm="3">
                                            <MudTextField Class="labelCustomColor" T="string" Label="@Localizer["Transit_Time"]"
                                                          Margin="Margin.Dense"
                                                          @bind-Value="_QuotationDetail.TransitTime" />
                                        </MudItem>
                                        <MudItem xs="6" sm="3">
                                            <MudAutocomplete Class="labelCustomColor" T="string"
                                                             @bind-Value="_QuotationDetail.Transitport"
                                                             Label="@Localizer["Transit_Port"]"
                                                             Margin="Margin.Dense"
                                                             SearchFunc="Search_TransitPort"
                                                             AdornmentColor="@ColorTextFields"
                                                             Immediate="true"
                                                             CoerceText="true"
                                                             Clearable="true"
                                                             MaxItems="100" />
                                        </MudItem>
                                    </MudGrid>
                                </MudItem>
                                <MudItem xs="12" Class="q-sec q-green q-first">
                                    <div class="q-title"><MudIcon Icon="@Icons.Material.Filled.DirectionsBoat" Size="Size.Small" /> Tuyến vận chuyển & hãng tàu</div>
                                    <MudGrid Spacing="1">
                                        <MudItem xs="12" sm="6">
                                            <MudAutocomplete Class="labelCustomColor" T="string"
                                                             @bind-Value="_QuotationDetail.pol"
                                                             Label="@Localizer["POL"]"
                                                             Margin="Margin.Dense"
                                                             SearchFunc="Search_Port"
                                                             AdornmentColor="@ColorTextFields"
                                                             Immediate="true"
                                                             CoerceText="true"
                                                             Clearable="true"
                                                             MaxItems="100" />
                                        </MudItem>
                                        <MudItem xs="12" sm="6">
                                            <MudAutocomplete Class="labelCustomColor" T="string"
                                                             @bind-Value="_QuotationDetail.pod"
                                                             Label="@Localizer["POD"]"
                                                             Margin="Margin.Dense"
                                                             SearchFunc="Search_Port"
                                                             AdornmentColor="@ColorTextFields"
                                                             Immediate="true"
                                                             CoerceText="true"
                                                             Clearable="true"
                                                             MaxItems="100" />
                                        </MudItem>
                                    </MudGrid>
                                </MudItem>
                                <MudItem xs="12" Class="q-sec q-green q-mid">
                                    <MudGrid Spacing="1">
                                        <MudItem xs="12" sm="6">
                                            <MudAutocomplete Class="labelCustomColor" T="string"
                                                             @bind-Value="_QuotationDetail.shippingline"
                                                             Label="@Localizer["Shipping_Line"]"
                                                             Margin="Margin.Dense"
                                                             SearchFunc="Search_Carrier"
                                                             AdornmentColor="@ColorTextFields"
                                                             Immediate="true"
                                                             CoerceText="true"
                                                             Clearable="true"
                                                             MaxItems="100" />
                                        </MudItem>
                                        <MudItem xs="12" sm="6">
                                            <MudAutocomplete Class="labelCustomColor" T="string"
                                                             @bind-Value="_QuotationDetail.MasterColoader"
                                                             Label="@Localizer["Master_Coloader"]"
                                                             Margin="Margin.Dense"
                                                             AdornmentColor="@ColorTextFields"
                                                             SearchFunc="Search_Coloader"
                                                             Immediate="true"
                                                             CoerceText="true"
                                                             Clearable="true"
                                                             MaxItems="100" />
                                        </MudItem>
                                    </MudGrid>
                                </MudItem>
                                <MudItem xs="12" Class="q-sec q-green q-last">
                                    <MudGrid Spacing="1">
                                        <MudItem xs="6" sm="2">
                                            <MudAutocomplete Class="labelCustomColor" T="string"
                                                             @bind-Value="cbofrom"
                                                             Label="@Localizer["from"]"
                                                             Margin="Margin.Dense"
                                                             SearchFunc="Search_port_from"
                                                             AdornmentColor="@ColorTextFields"
                                                             Immediate="true"
                                                             OnBlur="LinkRouting"
                                                             CoerceText="true"
                                                             Clearable="true"
                                                             MaxItems="200" />
                                        </MudItem>
                                        <MudItem xs="6" sm="2">
                                            <MudAutocomplete Class="labelCustomColor" T="string"
                                                             @bind-Value="cboto"
                                                             Label="@Localizer["to"]"
                                                             Margin="Margin.Dense"
                                                             SearchFunc="Search_port_to"
                                                             AdornmentColor="@ColorTextFields"
                                                             Immediate="true"
                                                             OnBlur="LinkRouting"
                                                             CoerceText="true"
                                                             Clearable="true"
                                                             MaxItems="200" />
                                        </MudItem>
                                        <MudItem xs="12" sm="4">
                                            <MudTextField Class="labelCustomColor" T="string" Label="@Localizer["Routing"]"
                                                          Margin="Margin.Dense"
                                                          @bind-Value="_QuotationDetail.Routing" />
                                        </MudItem>
                                        <MudItem xs="6" sm="2">
                                            <MudAutocomplete Class="labelCustomColor" T="string"
                                                             @bind-Value="_QuotationDetail.SaleName"
                                                             Label="@Localizer["SaleName"]"
                                                             Margin="Margin.Dense"
                                                             SearchFunc="Search_User"
                                                             Immediate="true"
                                                             CoerceText="true"
                                                             Clearable="true"
                                                             MaxItems="100" />
                                        </MudItem>
                                        <MudItem xs="6" sm="2">
                                            <MudSelect Class="labelCustomColor" @bind-Value="_QuotationDetail.status"
                                                       Margin="Margin.Dense"
                                                       Label="@Localizer["status"]">
                                                @foreach (var item in trangthais)
                                                {
                                                    <MudSelectItem Value="@item">@item</MudSelectItem>
                                                }
                                            </MudSelect>
                                        </MudItem>
                                    </MudGrid>
                                </MudItem>
                                <MudItem xs="12" Class="q-sec q-orange q-only">
                                    <div class="q-title"><MudIcon Icon="@Icons.Material.Filled.Event" Size="Size.Small" /> Thời gian</div>
                                    <MudGrid Spacing="1">
                                        <MudItem xs="6" sm="3">
                                            <MudDatePicker Class="labelCustomColor" @bind-Date="_QuotationDetail.dated"
                                                           For="@(() => _QuotationDetail.dated)"
                                                           Margin="Margin.Dense"
                                                           AdornmentColor="@ColorTextFields"
                                                           Label="@Localizer["NGAY"]"
                                                           Required="true" />
                                        </MudItem>
                                        <MudItem xs="6" sm="3">
                                            <MudDatePicker Class="labelCustomColor" @bind-Date="_QuotationDetail.validDate"
                                                           For="@(() => _QuotationDetail.validDate)"
                                                           Margin="Margin.Dense"
                                                           AdornmentColor="@ColorTextFields"
                                                           Label="@Localizer["NgayHieuLuc"]"
                                                           Required="true" />
                                        </MudItem>
                                        <MudItem xs="6" sm="3">
                                            <MudDatePicker Class="labelCustomColor" @bind-Date="_QuotationDetail.ETA"
                                                           For="@(() => _QuotationDetail.ETA)"
                                                           Margin="Margin.Dense"
                                                           AdornmentColor="@ColorTextFields"
                                                           Label="ETA"
                                                           Required="true" />
                                        </MudItem>
                                        <MudItem xs="6" sm="3">
                                            <MudDatePicker Class="labelCustomColor" @bind-Date="_QuotationDetail.ETD"
                                                           For="@(() => _QuotationDetail.ETD)"
                                                           Margin="Margin.Dense"
                                                           AdornmentColor="@ColorTextFields"
                                                           Label="ETD"
                                                           Required="true" />
                                        </MudItem>
                                    </MudGrid>
                                </MudItem>
                                <MudItem xs="12" Class="q-sec q-teal q-only">
                                    <div class="q-title"><MudIcon Icon="@Icons.Material.Filled.Inventory2" Size="Size.Small" /> Hàng hoá & ghi chú</div>
                                    <MudGrid Spacing="1">
                                        <MudItem xs="6" sm="3">
                                            <MudNumericField @bind-Value="_QuotationDetail.SL"
                                                             Label="@Localizer["Quantity_volume"]"
                                                             Format="#,##0.##"
                                                             Culture="@_en"
                                                             T="double?"
                                                             HideSpinButtons="true"
                                                             Margin="Margin.Dense"
                                                             Class="text-right labelCustomColor" />
                                        </MudItem>
                                        <MudItem xs="6" sm="3">
                                            <MudTextField Class="labelCustomColor" T="string"
                                                          Label="@Localizer["loaivolume"]"
                                                          Margin="Margin.Dense"
                                                          @bind-Value="_QuotationDetail.loaivolume" />
                                        </MudItem>
                                        <MudItem xs="6" sm="3">
                                            <MudTextField Class="labelCustomColor" T="string"
                                                          Label="@Localizer["ghichu"]"
                                                          Margin="Margin.Dense"
                                                          Lines="3"
                                                          @bind-Value="_QuotationDetail.remarks" />
                                        </MudItem>
                                        <MudItem xs="6" sm="3">
                                            <MudTextField Class="labelCustomColor" T="string"
                                                          Label="@Localizer["TenHang_gs"]"
                                                          Margin="Margin.Dense"
                                                          Lines="3"
                                                          @bind-Value="_QuotationDetail.description" />
                                        </MudItem>
                                    </MudGrid>
                                </MudItem>
                            </MudGrid>
                        </MudTabPanel>

                        @*  ----------------------------------Debit----------------------------------------- *@
                        <MudTabPanel Text="Debit" Disabled="_QuotationDetail.quotationID == Guid.Empty">
                            <Debit _QuotationDetail="_QuotationDetail" />
                        </MudTabPanel>
                        @*  ----------------------------------Credit----------------------------------------- *@
                        <MudTabPanel Text="Credit" Disabled="_QuotationDetail.quotationID == Guid.Empty">
                            <Credit _QuotationDetail="_QuotationDetail" />
                        </MudTabPanel>
                    </MudTabs>
                </MudContainer>
            </MudForm>
        </div>
    </DialogContent>

    <DialogActions>
        <div class="quotation-dialog-actions">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save" OnClick="@(async () => await Submit())">Save</MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Default" StartIcon="@Icons.Material.Filled.Close" OnClick="Cancel">Cancel</MudButton>
        </div>
    </DialogActions>

</MudDialog>


<style>
    .quotation-dialog-shell {
        width: 100%;
        max-height: 78vh;
        overflow-y: auto;
        overflow-x: hidden;
        background: linear-gradient(180deg, #f8fbff 0%, #ffffff 48%, #f8fafc 100%);
        border-radius: 14px;
        padding: 10px;
    }

    .quotation-dialog-container {
        padding: 0 !important;
    }

    .quotation-tabs {
        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 16px;
        box-shadow: 0 10px 28px rgba(15, 23, 42, .08);
        overflow: hidden;
    }

        .quotation-tabs .mud-tabs-toolbar {
            background: linear-gradient(90deg, #eff6ff, #f8fafc);
            border-bottom: 1px solid #e5e7eb;
            min-height: 44px;
            padding: 6px 8px 0 8px;
        }

        .quotation-tabs .mud-tab {
            min-height: 38px;
            padding: 8px 14px;
            margin-right: 4px;
            border-radius: 10px 10px 0 0;
            font-size: 13px;
            font-weight: 700;
            text-transform: none;
            color: #475569;
        }

            .quotation-tabs .mud-tab.mud-tab-active {
                color: #0f4c81;
                background: #ffffff;
                box-shadow: inset 0 3px 0 #1976d2;
            }

    .quotation-tab-panel {
        padding: 12px !important;
        background: #ffffff;
    }

    .quotation-form-grid {
        padding: 4px;
    }

        .quotation-form-grid > .mud-grid-item,
        .quotation-form-grid .mud-grid > .mud-grid-item {
            padding-top: 4px !important;
            padding-bottom: 4px !important;
        }

        .quotation-form-grid .mud-input-control {
            margin-top: 0 !important;
            margin-bottom: 0 !important;
        }

        .quotation-form-grid .mud-input-root,
        .quotation-form-grid .mud-select-input,
        .quotation-form-grid .mud-picker-input {
            background: #ffffff;
            border-radius: 10px;
        }

        .quotation-form-grid .mud-input-control .mud-input-slot {
            font-size: 13px;
        }

        .quotation-form-grid .mud-input-label {
            font-size: 12px;
            font-weight: 700;
            color: #334155 !important;
        }


    /* ===== Nhóm theo màu (form Thêm / Sửa báo giá) ===== */
    .quotation-form-grid { padding: 4px 6px !important; }
    .quotation-form-grid > .q-sec { padding-left: 14px !important; padding-right: 14px !important; background: var(--q-bg); border-left: 1px solid var(--q-bd); border-right: 1px solid var(--q-bd); }
    .quotation-form-grid > .q-sec.q-first, .quotation-form-grid > .q-sec.q-only { border-top: 1px solid var(--q-bd); border-radius: 14px 14px 0 0; margin-top: 10px; padding-top: 10px !important; }
    .quotation-form-grid > .q-sec.q-last, .quotation-form-grid > .q-sec.q-only { border-bottom: 1px solid var(--q-bd); border-radius: 0 0 14px 14px; padding-bottom: 12px !important; }
    .quotation-form-grid > .q-sec.q-only { border-radius: 14px; }
    .quotation-form-grid > .q-sec:first-child { margin-top: 0; }
    .q-title { display: flex; align-items: center; gap: 8px; font-size: 13px; font-weight: 700; color: var(--q-ac); margin: 0 0 6px; letter-spacing: .01em; }
    .q-title::before { content: ""; width: 4px; height: 16px; border-radius: 999px; background: var(--q-ac); }
    .q-blue   { --q-bg: #f2f7ff; --q-bd: #cfe0fb; --q-ac: #1d4ed8; }
    .q-purple { --q-bg: #f8f4ff; --q-bd: #e2d5f8; --q-ac: #6d28d9; }
    .q-green  { --q-bg: #f1fbf5; --q-bd: #c8ebd6; --q-ac: #047857; }
    .q-orange { --q-bg: #fff8ef; --q-bd: #f6dfb5; --q-ac: #c2410c; }
    .q-teal   { --q-bg: #effafa; --q-bd: #c4e8e6; --q-ac: #0f766e; }
    .quotation-form-grid .q-sec .mud-input-control .mud-input-outlined-border { border-color: var(--q-bd); }
    .quotation-tabs .mud-tab:nth-child(2), .quotation-tabs .mud-tooltip-root:nth-child(2) .mud-tab { color: #047857; }
    .quotation-tabs .mud-tooltip-root:nth-child(3) .mud-tab { color: #c2410c; }

    .quotation-generate-btn {
        width: 100%;
        min-width: 0 !important;
        height: 38px;
        margin-top: 4px;
        border-radius: 10px;
        font-weight: 800;
        box-shadow: 0 4px 12px rgba(25, 118, 210, .22);
    }

    .quotation-dialog-actions {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        width: 100%;
        padding: 10px 14px;
        border-top: 1px solid #e5e7eb;
        background: #ffffff;
        position: sticky;
        bottom: 0;
        z-index: 2;
    }

        .quotation-dialog-actions .mud-button-root {
            border-radius: 10px;
            min-width: 100px;
            font-weight: 700;
            text-transform: none;
        }

    .quotation-dialog-shell::-webkit-scrollbar {
        width: 8px;
        height: 8px;
    }

    .quotation-dialog-shell::-webkit-scrollbar-thumb {
        background: #cbd5e1;
        border-radius: 999px;
    }

    .quotation-dialog-shell::-webkit-scrollbar-track {
        background: #f1f5f9;
    }

    @@media (max-width: 768px) {
        .quotation-dialog-shell {
            max-height: 82vh;
            padding: 6px;
        }

        .quotation-tab-panel {
            padding: 8px !important;
        }

        .quotation-tabs .mud-tab {
            min-width: 90px;
            padding: 8px 10px;
            font-size: 12px;
        }

        .quotation-dialog-actions {
            justify-content: stretch;
        }

            .quotation-dialog-actions .mud-button-root {
                flex: 1;
            }
    }
</style>

@code {

    [CascadingParameter] MudDialogInstance? MudDialog { get; set; }
    Color ColorTextFields = Color.Primary;
    [Parameter] public Models.M_Quotation _QuotationDetail { get; set; }
    [Parameter] public string Status { get; set; }
    List<M_Customer> customers = new List<M_Customer>();
    List<M_Customer> customers_shipping = new List<M_Customer>();
    List<M_Customer> customers_coloader = new List<M_Customer>();
    List<Booking> bookings = new List<Booking>();
    List<M_RFQ> RFQs = new List<M_RFQ>();
    List<PortModel> Ports = new List<PortModel>();
    private List<string> ListPOrt_Code_from { get; set; } = new List<string>();
    private List<string> ListPOrt_Code_to { get; set; } = new List<string>();
    private List<string> ListUser { get; set; } = new List<string>();
    string cbofrom = "";
    string cboto = "";
    List<string> trangthais = new List<string>();
    private bool IsLoading = true;
    public CultureInfo _en = CultureInfo.GetCultureInfo("en-US");
    protected override async Task OnInitializedAsync()
    {
        if (Status == "Duplicate")
        {
            _QuotationDetail.quotationNo = "";
            _QuotationDetail.BookingNo = "";
            _QuotationDetail.RFQ_No = "";
            // _QuotationDetail.quotationID = Guid.Empty;
            // _QuotationDetail.quotationNo = BookingNumber;
        }
        // DisableScrolling(true);
        customers = (await CusSV.GetListAll()).Where(x => x.Customer_ID != Guid.Empty).OrderBy(x => x.Customer_Code).ToList();
        // Bỏ phần tử null / không có tên (GroupBy...First() có thể trả null) để ô Shipping line / Coloader không lỗi
        customers_shipping = (CusSV.GetList_cus_Shipping() ?? new List<M_Customer>()).Where(x => x != null && !string.IsNullOrWhiteSpace(x.COMPANY)).ToList();
        customers_coloader = (CusSV.GetList_cus_Coloader() ?? new List<M_Customer>()).Where(x => x != null && !string.IsNullOrWhiteSpace(x.COMPANY)).ToList();
        bookings = await bksv.GetListSBooking() ?? new List<Models.Booking>();
        RFQs = await Quosv.GetList_RFQ_combo() ?? new List<M_RFQ>();
        Ports = (await bksv.GetList_PORT() ?? new List<PortModel>()).Where(x => x != null).ToList();
        ListPOrt_Code_from = await bksv.GetList_PortCode(cbofrom) ?? new List<string>();
        ListPOrt_Code_to = await bksv.GetList_PortCode(cboto) ?? new List<string>();
        ListUser = await bksv.GetList_User(_QuotationDetail.SaleName) ?? new List<string>();
        var tts = await supsv.GetListTrangThai();
        trangthais = tts.Where(x => x.Tieude == "QUOTATION").OrderBy(x => x.Noidung).Select(x => x.Noidung).ToList();
        // await Task.Delay(3000);
        // IsLoading = false; // Tắt overlay
        // DisableScrolling(false);
        StateHasChanged();
    }

    // private void DisableScrolling(bool disable)
    // {
    //     if (disable)
    //         _ = JS.InvokeVoidAsync("disableScroll");
    //     else
    //         _ = JS.InvokeVoidAsync("enableScroll");
    // }

    private async Task<IEnumerable<Guid?>> Search_customer(string value)
    {
        if (string.IsNullOrEmpty(value))
            return customers.Select(x => (Guid?)x.Customer_ID);

        return customers
            .Where(x => x.SearchKey().Contains(value, StringComparison.InvariantCultureIgnoreCase))
            .Select(x => (Guid?)x.Customer_ID);
    }

    private string GetCustomerLabel(Guid? id)
    {
        var customer = customers.FirstOrDefault(x => x.Customer_ID == id);
        return customer != null ? customer.CodeName() : string.Empty;
    }

    public async Task GetQuotation_No()
    {
        int formattedYear = DateTime.Now.Year;
        int formattedMonth = DateTime.Now.Month;

        string usr = asv.GetAuth().Result.User.Identity!.Name!;
        var refno = await supsv.GetRefNoByFunc("QUO", formattedMonth, formattedYear, usr);

        var rs = asv.GetUserDetail();
        var cn = rs.Branch;
        _QuotationDetail.quotationNo = cn + "QUO_" + formattedYear.ToString() + formattedMonth.ToString() + refno.Value.ToString("D4");
    }

    void CallSnackBar(string message, MudBlazor.Severity severity)
    {

        Snackbar.Configuration.SnackbarVariant = Variant.Filled;
        Snackbar.Configuration.MaxDisplayedSnackbars = 3;
        Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopRight;
        Snackbar.Add(message, severity);
    }
    private async Task<IEnumerable<string>> Search_Booking(string value)
    {
        if (string.IsNullOrEmpty(value))
            return (bookings ?? new()).Where(x => x != null && !string.IsNullOrWhiteSpace(x.BookingNo)).Select(x => x.BookingNo!).Distinct();

        return (bookings ?? new())
            .Where(x => x != null && !string.IsNullOrWhiteSpace(x.BookingNo) && x.BookingNo.Contains(value, StringComparison.InvariantCultureIgnoreCase))
            .Select(x => x.BookingNo).Distinct();
    }

    private async Task<IEnumerable<string>> Search_RFQNo(string value)
    {
        if (string.IsNullOrEmpty(value))
            return (RFQs ?? new())
                .Where(x => x != null && !string.IsNullOrWhiteSpace(x.RFQNo))
                .Select(x => x.RFQNo!)
                .Distinct(); // Loại bỏ trùng

        return (RFQs ?? new())
            .Where(x => x != null && !string.IsNullOrWhiteSpace(x.RFQNo) && x.RFQNo.Contains(value, StringComparison.InvariantCultureIgnoreCase))
            .Select(x => x.RFQNo)
            .Distinct(); // Loại bỏ trùng
    }
    MudForm form;
    private async Task Submit()
    {
        var permUser = asv.GetAuth().Result.User.Identity!.Name!;
        var isNew = Status != "edit";
        if (!await ssv.CheckPermission(permUser, isNew ? "Add" : "Edit", "Quotation"))
        {
            Snackbar.Add(Localizer[isNew ? "NoPermission_Add" : "NoPermission_Edit"], MudBlazor.Severity.Warning);
            return;
        }
        {

            await form.Validate();

            if (form.IsValid)
            {
                if (Status == "Duplicate")
                {

                    _QuotationDetail.Approve = false;
                    // _QuotationDetail.quotationNo = BookingNumber;
                }
                var UserName = asv.GetAuth().Result.User.Identity!.Name!;
                _QuotationDetail.dateupdate = DateTime.Now.ToString();
                _QuotationDetail.userupdate = UserName;
                MudDialog!.Close(_QuotationDetail);

            }
        }


    }
    void Cancel() => MudDialog.Cancel();
    private Task<IEnumerable<string>> Search_Port(string value)
    {
        var list = SafePorts().Where(x => !string.IsNullOrWhiteSpace(x.PORT) || !string.IsNullOrWhiteSpace(x.PORT_CODE))
            .Select(x => $"{x.PORT}_{x.PORT_CODE}");
        if (!string.IsNullOrEmpty(value))
            list = list.Where(x => x.Contains(value, StringComparison.InvariantCultureIgnoreCase));
        return Task.FromResult<IEnumerable<string>>(list.Distinct().OrderBy(x => x).ToList());
    }

