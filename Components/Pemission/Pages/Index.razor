@page "/pms/index"


@inject IDialogService Dialog
@inject IStringLocalizer<SharedResource> Localizer
@inject ISnackbar Snackbar
@inject AccountService acsv
@inject SharedServices sv
@attribute [Authorize]
@inject HistoryLogService HistoryLogService
@using System.Text.Json;


<PageTitle>@Localizer["permission"]</PageTitle>

<MudStack Row Class="d-flex flex-wrap mt-4">
    <MudButton Color="Color.Primary" Size=Size.Small OnClick=LoadAsync StartIcon="@Icons.Material.Filled.Refresh">@Localizer["reload"]</MudButton>
    <div class="d-flex justify-start align-center">
        <MudButton Color="Color.Primary" Size=Size.Small OnClick="OpenAddBulkPermissionDialog" StartIcon="@Icons.Material.Filled.Add">@Localizer["add"]</MudButton>
    </div>
    <MudButton Color="Color.Primary" Size=Size.Small OnClick=OpenTemplateDeleteUser StartIcon="@Icons.Material.Filled.Delete">@Localizer["DeleteByUser"]</MudButton>
    <div class="d-flex justify-start align-center">
        <MudButton Color="Color.Primary" Size=Size.Small OnClick=OpenTemplate StartIcon="@Icons.Material.Filled.MenuOpen">@Localizer["Template"]</MudButton>
    </div>
    <MudButton Color="Color.Primary" Size=Size.Small OnClick=OpenTemplateDuplicate StartIcon="@Icons.Material.Filled.CopyAll">Duplicate</MudButton>
    <MudButton Color="Color.Secondary" Size=Size.Small OnClick=OpenSyncTemplate StartIcon="@Icons.Material.Filled.Sync">Sync Template</MudButton>
    <a href="HDSDhtml/HDSD_Phan_Quyen_Nguoi_Dung_LMS.html" target="_blank">
        <MudButton Color="Color.Info" Size=Size.Small StartIcon="@Icons.Material.Filled.Info">@Localizer["Help"]</MudButton>
    </a>
</MudStack>
<MudDataGrid T="Permission_M" Items="@Permissions" ReadOnly=false EditMode="@(DataGridEditMode.Form)"
             Dense="true" EditTrigger="@(DataGridEditTrigger.Manual)" @ref="Muddata" Bordered="true"
             CanceledEditingItem="@CanceledEditingItem" CommittedItemChanges="@CommittedItemChanges"
             Groupable="true" GroupExpanded="false" Loading=_load Virtualize="true" Height="850px;">
    <Columns>
        <TemplateColumn CellClass="d-flex justify-end">
            <CellTemplate>
                <MudIconButton Size="@Size.Small" Icon="@Icons.Material.Outlined.Edit" OnClick="@(() => {

                                                                                       detail = JsonSerializer.Deserialize<Permission_M>(JsonSerializer.Serialize(context.Item));

                                                                                       context.Actions.StartEditingItemAsync();

                                                                                                              })" />
                <MudIconButton Size="@Size.Small" Icon="@Icons.Material.Outlined.Delete" OnClick="@(() => DeleteItem(context.Item))" />
            </CellTemplate>
        </TemplateColumn>
        <PropertyColumn Property="x => GetTitlefrommenuid(x.MenuId)" Title="@Localizer["view_name"]">
            <EditTemplate>
                <MudSelect T="string" @bind-Value="context.Item.MenuName" Required Margin="@Margin.Dense" SelectedValuesChanged="() => context.Item.MenuId = GetMenufrommName(context.Item.MenuName)">
                    @foreach (var item in Menus)
                    {
                        <MudSelectItem Value="item.MenuName">@Localizer[item.Title]</MudSelectItem>
                    }
                </MudSelect>
            </EditTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x => x.UserName" Title="@Localizer["user"]" Grouping GroupBy="@_groupBy">
            <EditTemplate>
                <MudSelect T="string" @bind-Value="context.Item.UserName" Required Margin="@Margin.Dense">
                    @foreach (var item in Users)
                    {
                        <MudSelectItem Value="item.Name">@item.Name</MudSelectItem>
                    }
                </MudSelect>
            </EditTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x => x.See" Title="@Localizer["can_view"]">
            <CellTemplate>
                <MudCheckBox @bind-Value="context.Item.See" ReadOnly />
            </CellTemplate>
            <EditTemplate>
                <MudCheckBox Label="@Localizer["can_view"]" @bind-Value="context.Item.See" />
            </EditTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x => x.Edit" Title="@Localizer["can_edit"]">
            <CellTemplate>
                <MudCheckBox @bind-Value="context.Item.Edit" ReadOnly />
            </CellTemplate>
            <EditTemplate>
                <MudCheckBox Label="@Localizer["can_edit"]" @bind-Value="context.Item.Edit" />
            </EditTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x => x.Del" Title="@Localizer["can_delete"]">
            <CellTemplate>
                <MudCheckBox @bind-Value="context.Item.Del" ReadOnly />
            </CellTemplate>
            <EditTemplate>
                <MudCheckBox Label="@Localizer["can_delete"]" @bind-Value="context.Item.Del" />
            </EditTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x => x.Approve" Title="@Localizer["can_approve"]">
            <CellTemplate>
                <MudCheckBox @bind-Value="context.Item.Approve" ReadOnly />
            </CellTemplate>
            <EditTemplate>
                <MudCheckBox Label="@Localizer["can_approve"]" @bind-Value="context.Item.Approve" />
            </EditTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x => x.Add" Title="@Localizer["can_add"]">
            <CellTemplate>
                <MudCheckBox @bind-Value="context.Item.Add" ReadOnly />
            </CellTemplate>
            <EditTemplate>
                <MudCheckBox Label="@Localizer["can_add"]" @bind-Value="context.Item.Add" />
            </EditTemplate>
        </PropertyColumn>
    </Columns>
</MudDataGrid>


@code {
    MudDataGrid<Permission_M> Muddata;
    List<Permission_M> Permissions = new List<Permission_M>();
    List<FormMenu> Menus = new List<FormMenu>();
    List<AuthUser> Users = new List<AuthUser>();
    bool _load;
    Permission_M detail;
    async Task Loadcmb()
    {
        Users = await acsv.GetListUser();
        Menus = await sv.GetListFormMenu();
    }

    protected override async Task OnInitializedAsync()
    {
        await Loadcmb();
        //await LoadAsync();
    }
    async Task LoadAsync()
    {
        try
        {
            Permissions.Clear();
            _load = true;
            await Task.Delay(500);
            Permissions = await sv.GetListPerMission();

        }
        catch (Exception ex)
        {

        }
        finally
        {
            _load = false;

        }
    }

    void CanceledEditingItem(Permission_M item)
    {

    }

    async Task CommittedItemChanges(Permission_M item)
    {
        var rs = await sv.UpdateOrCreatePermission(item, detail);

        CallSnackBar(rs.Message, rs.Flag ? "S" : "E");
        await LoadAsync();
    }

    async Task DeleteItem(Permission_M item)
    {
        var resultMess = await Dialog.ShowMessageBox(
                Localizer["Warning"],
                Localizer["DeleteConfirmBody"],
                yesText: Localizer["delete"], cancelText: Localizer["cancel"]);

        if (resultMess.HasValue)
        {
            var rs = await sv.DeletePermission(item);
            CallSnackBar(rs.Message, rs.Flag ? "S" : "E");

            await LoadAsync();
        }

    }

    async Task OpenAddBulkPermissionDialog()
    {
        try
        {
            var optionsdialog = new DialogOptions
            {
                ClassBackground = "class-dialog-custom",
                FullWidth = true,
                MaxWidth = MaxWidth.Large,
                CloseOnEscapeKey = false,
                DisableBackdropClick = true
            };

            var dialog = await Dialog.ShowAsync<AddBulkPermissionDialog>($"{Localizer["permission"]} — Add", optionsdialog);
            var result = await dialog.Result;
            if (result.Canceled || result.Data is not BoolandMessReponse rs)
                return;
            CallSnackBar(rs.Message, rs.Flag ? "S" : "E");
            if (rs.Flag)
                await LoadAsync();
        }
        catch (Exception ex)
        {
            CallSnackBar(string.Format(Localizer["SomethingWentWrong"], ex.Message), "E");
        }
    }
    Guid GetMenufrommName(string? name)
    {
        var result = sv.GetMenufrommName(name);
        return result.MenuID;
    }

    void CallSnackBar(string message, string type)
    {
        MudBlazor.Severity severity = MudBlazor.Severity.Normal;
        if (type == "E")
            severity = MudBlazor.Severity.Error;
        else if (type == "S")
            severity = MudBlazor.Severity.Success;
        else if (type == "W")
            severity = MudBlazor.Severity.Warning;
        else if (type == "I")
            severity = MudBlazor.Severity.Info;

        Snackbar.Configuration.SnackbarVariant = Variant.Filled;
        Snackbar.Configuration.MaxDisplayedSnackbars = 3;
        Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopRight;
        Snackbar.Add(message, severity);
    }
    Func<Permission_M, object> _groupBy = x =>
    {
        return x.UserName;
    };
    async Task OpenTemplate()
    {
        try
        {
            var optionsdialog = new DialogOptions
            {
                ClassBackground = "class-dialog-custom",
                FullWidth = true,
                MaxWidth = MaxWidth.Medium,
                CloseOnEscapeKey = false,
                DisableBackdropClick = true
            };

            var dialog = await Dialog.ShowAsync<PerTemplate>(Localizer["TemplatesPermission"], optionsdialog);
            var result = await dialog.Result;
        }
        catch (Exception ex)
        {
            CallSnackBar(string.Format(Localizer["SomethingWentWrong"], ex.Message), "E");
        }
    }


    async Task OpenTemplateDuplicate()
    {
        try
        {
            var optionsdialog = new DialogOptions
            {
                ClassBackground = "class-dialog-custom",
                FullWidth = true,
                MaxWidth = MaxWidth.Medium,
                CloseOnEscapeKey = false,
                DisableBackdropClick = true
            };

            var dialog = await Dialog.ShowAsync<DuplicateDialog>(Localizer["duplicate"], optionsdialog);
            var result = await dialog.Result;
            if (result.Canceled)
                return;
            var data = ((string, string))result.Data;
            var rs = await sv.DuplicatePermission(data.Item1, data.Item2);
            string usr = acsv.GetAuth().Result.User.Identity!.Name!;
            await HistoryLogService.LogAsync(usr, "Duplicate Permission", "Permission", Guid.Empty, data.Item2, new { OldData = data.Item1, NewData = data.Item2 });
            CallSnackBar(rs.Message, rs.Flag ? "S" : "E");
            await LoadAsync();

        }
        catch (Exception ex)
        {
            CallSnackBar(string.Format(Localizer["SomethingWentWrong"], ex.Message), "E");
        }
    }
    async Task OpenTemplateDeleteUser()
    {
        try
        {
            var optionsdialog = new DialogOptions
            {
                ClassBackground = "class-dialog-custom",
                FullWidth = true,
                MaxWidth = MaxWidth.Medium,
                CloseOnEscapeKey = false,
                DisableBackdropClick = true
            };

            var dialog = await Dialog.ShowAsync<DeleteDialog>(Localizer["DeleteAllPermissionByUser"], optionsdialog);
            var result = await dialog.Result;
            if (result.Canceled)
                return;
            var data = (string)result.Data;
            var rs = await sv.DeletePermissionbyUser(data);
            CallSnackBar(rs.Message, rs.Flag ? "S" : "E");
            await LoadAsync();

        }
        catch (Exception ex)
        {
            CallSnackBar("Somethings went wrong!, error code: " + ex.Message, "E");
        }
    }

    async Task OpenSyncTemplate()
    {
        try
        {
            var optionsdialog = new DialogOptions
            {
                ClassBackground = "class-dialog-custom",
                FullWidth = true,
                MaxWidth = MaxWidth.Medium,
                CloseOnEscapeKey = false,
                DisableBackdropClick = true
            };

            var dialog = await Dialog.ShowAsync<SyncTemplateDialog>("Sync Template → Users", optionsdialog);
            var result = await dialog.Result;
            if (result.Canceled || result.Data is not BoolandMessReponse rs)
                return;
            CallSnackBar(rs.Message, rs.Flag ? "S" : "E");
            if (rs.Flag)
                await LoadAsync();
        }
        catch (Exception ex)
        {
            CallSnackBar(string.Format(Localizer["SomethingWentWrong"], ex.Message), "E");
        }
    }

    string GetTitlefrommenuid(Guid? id)
    {
        var rs = Menus.FirstOrDefault(x => x.MenuID == id);
        return rs != null ? rs.Title! : "";
    }

}
