@inject GlobalServices gsv
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject AccountService asv
@inject SharedServices ssv
@inject SupportServices supsv
@inject IStringLocalizer<SharedResource> Localizer
@inject HistoryLogService HistoryLogService
@using System.Text.Json;

<MudDialog>
    <DialogContent>
        <MudStack Row Justify="Justify.FlexStart" Class="pa-4">
            <MudButton HtmlTag="label"
            OnClick="Refresh"
            Size="Size.Small" Color="Color.Primary" Variant="   Variant.Filled"
            StartIcon="@Icons.Material.Filled.Refresh">
                Reload
            </MudButton>
            <MudButton HtmlTag="label"
            @onclick="@(() => AddItem())"
            Size="Size.Small" Color="Color.Secondary" Variant="Variant.Filled"
            StartIcon="@Icons.Material.Filled.Add">
                New
            </MudButton>
            <MudButton HtmlTag="label"
            OnClick="CopySalesToSalesManager"
            Size="Size.Small" Color="Color.Tertiary" Variant="Variant.Filled"
            StartIcon="@Icons.Material.Filled.ContentCopy"
            Disabled="_copying">
                @(_copying ? "Copying..." : "Copy SALES → SALES MANAGER")
            </MudButton>
        </MudStack>
        <MudDataGrid T="PermissionTemplate" Items="@Listdata" Filterable="true" @ref="mudTable" Class="pa-4" QuickFilter="@FilterFunc1"
        FilterMode="@DataGridFilterMode.Simple" Dense="true" Virtualize="true" Height="85vh"
        FixedHeader="true" FixedFooter="true" HeaderClass="no-wrap" FooterClass="no-wrap"
        ReadOnly="false" CommittedItemChanges="@CommittedItem" RowClassFunc="@SelectedRowClassFunc"
        RowClick="@RowClicked" EditDialogOptions="dialogOptions"
        ColumnResizeMode="ResizeMode.Column" Loading="_loading">
            <Columns>
                <TemplateColumn CellClass="d-flex justify-end" Filterable="false">
                    <CellTemplate>
                        <MudIconButton Size="@Size.Small" Icon="@Icons.Material.Outlined.Edit" OnClick="@(() => {

                                 detail_PermissionTemplate = JsonSerializer.Deserialize<PermissionTemplate>(JsonSerializer.Serialize(context.Item));

                               context.Actions.StartEditingItemAsync();

                       })" />
                        <MudIconButton Size="@Size.Small" Icon="@Icons.Material.Outlined.Delete" OnClick="@(()=>DeleteItem(context.Item))" />
                    </CellTemplate>
                </TemplateColumn>
                <PropertyColumn Property="x=> Listdata.IndexOf(x)+1" Title="No." IsEditable="false" Required="false" Filterable="false"/>
                <PropertyColumn Property="x=>x.Dept" Title="Department" Required>
                    <FilterTemplate>
                        <MudTextField @bind-Value="search" />
                    </FilterTemplate>
                    <EditTemplate>
                        <MudAutocomplete T="string"
                                         @bind-Value="context.Item.Dept"
                                         Label="Department"
                                         SearchFunc="SearchDept"
                                         MaxItems="@(Math.Max(Depts.Count, 1))"
                                         ResetValueOnEmptyText="false"
                                         Clearable="true"
                                         Immediate="true"
                                         ToStringFunc="@(x => x ?? string.Empty)"
                                         Required
                                         @bind-Value:after='@(() => context.Item.MenuName = "ALL")' />
                    </EditTemplate>
                </PropertyColumn>

               @*  <PropertyColumn Property="x => GetTitlefrommenuid(x.MenuId)" Title="@Localizer["view_name"]" >
                    <EditTemplate>
                        <MudSelect T="string" @bind-Value="context.Item.MenuName" Required Margin="@Margin.Dense" Label="Menu Name" SelectedValuesChanged="() => context.Item.MenuId=GetMenufrommName(context.Item.MenuName)">
                            @foreach (var item in Menus)
                            {
                                <MudSelectItem Value="item.MenuName">@item.Title</MudSelectItem>
                            }
                        </MudSelect>
                    </EditTemplate>
                </PropertyColumn> *@
                <MudSpacer></MudSpacer>
                <PropertyColumn Property="x => GetTitlefrommenuid(x.MenuId)" Title="@Localizer["view_name"]">
                    <EditTemplate>
                        <MudDataGrid T="FormMenu" Items="@Menus" Filterable="true" MultiSelection="true" SelectedItemsChanged="@SelectedItemsChanged"
                         FilterMode="@DataGridFilterMode.Simple" Dense="true" Virtualize="true" Height="550px;" Class="custom-credit"
                         FixedHeader="true" HeaderClass="no-wrap" SelectOnRowClick="false" FooterClass="nondisplay"
                         ReadOnly="true" Bordered="true" ColumnResizeMode="ResizeMode.Column" >

                            <Columns>
                                    <SelectColumn T="FormMenu" />
                                            <PropertyColumn Property="x => x.Title" Title="@Localizer["Title"]" />
              
                            </Columns>

                        </MudDataGrid>
                    </EditTemplate>
                </PropertyColumn>

               
                <PropertyColumn Property="x=>x.canView" Title="View" Required >
                    <CellTemplate>
                        <MudCheckBox @bind-Value="context.Item.canView" ReadOnly />
                    </CellTemplate>
                    <EditTemplate>
                        <MudCheckBox @bind-Checked="context.Item.canView" Label="View"/>
                    </EditTemplate>
                </PropertyColumn>
                <PropertyColumn Property="x=>x.canAdd" Title="Add" Required >
                    <CellTemplate>
                        <MudCheckBox @bind-Value="context.Item.canAdd"  ReadOnly />
                    </CellTemplate>
                    <EditTemplate>
                        <MudCheckBox @bind-Checked="context.Item.canAdd" Label="Add" />
                    </EditTemplate>
                </PropertyColumn>
                <PropertyColumn Property="x=>x.canEdit" Title="Edit" Required>
                    <CellTemplate>
                        <MudCheckBox @bind-Value="context.Item.canEdit" ReadOnly/>
                    </CellTemplate>
                    <EditTemplate>
                        <MudCheckBox @bind-Checked="context.Item.canEdit" Label="Edit" />
                    </EditTemplate>
                </PropertyColumn>
                <PropertyColumn Property="x=>x.canDelete" Title="Delete" Required>
                    <CellTemplate>
                        <MudCheckBox @bind-Value="context.Item.canDelete" ReadOnly/>
                    </CellTemplate>
                    <EditTemplate>
                        <MudCheckBox @bind-Checked="context.Item.canDelete" Label="Delete" />
                    </EditTemplate>
                </PropertyColumn>
                <PropertyColumn Property="x=>x.canApprove" Title="Approve" Required>
                    <CellTemplate>
                        <MudCheckBox @bind-Value="context.Item.canApprove" ReadOnly />
                    </CellTemplate>
                    <EditTemplate>
                        <MudCheckBox @bind-Checked="context.Item.canApprove" Label="Approve" />
                    </EditTemplate>
                </PropertyColumn>
            </Columns>
        </MudDataGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => Muddialog.Cancel())">Close</MudButton>
    </DialogActions>
</MudDialog>
@code {
    [CascadingParameter] public MudDialogInstance Muddialog { get; set; }
    DialogOptions dialogOptions = new DialogOptions
    {
        ClassBackground="class-dialog-custom",
        FullWidth = true,
        MaxWidth = MaxWidth.Medium,
        DisableBackdropClick  = true,
        CloseOnEscapeKey = false,
        NoHeader = true
    };
    List<PermissionTemplate> Listdata = new List<PermissionTemplate>();
    MudDataGrid<PermissionTemplate> mudTable;
    string usr;
    AuthUser user;
    List<FormMenu> Menus = new List<FormMenu>();
    List<string> Depts = new List<string>();
    List<FormMenu> FormMenuSelecteds = new List<FormMenu>();
    PermissionTemplate detail;
    protected async override Task OnInitializedAsync()
    {
        user = asv.GetUserDetail();
        usr = asv.GetAuth().Result.User.Identity!.Name!;
        Menus = await ssv.GetListFormMenu();
        await Refresh();
        var departments = await supsv.GetListDepartments();
        Depts.Add("ALL");
        Depts.AddRange(departments.Select(x => x.Code).ToList());
    }

    PermissionTemplate detail_PermissionTemplate;
    bool _loading = false;
    async Task Refresh()
    {
        try
        {
            detail = null!;
            _loading = true;
            Listdata.Clear();
            await Task.Delay(500);
            StateHasChanged();
            Listdata = await gsv.GetListPermissionTemplate();
        }
        catch(Exception ex)
        {
            CallSnackBar("Something went wrong!, error code: " + ex.Message, MudBlazor.Severity.Warning);
        }
        finally
        {
            _loading = false;
        }
    }

    async Task SelectedItemsChanged(HashSet<FormMenu> items)
    {
        FormMenuSelecteds = items.ToList();

    }

    void CallSnackBar(string message, MudBlazor.Severity severity)
    {
        Snackbar.Clear();
        Snackbar.Configuration.SnackbarVariant = Variant.Filled;
        Snackbar.Configuration.MaxDisplayedSnackbars = 3;
        Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopRight;
        Snackbar.Add(message, severity);
    }
    void RowClicked(DataGridRowClickEventArgs<PermissionTemplate> args)
    {
        detail = args.Item;
    }
    private int selectedRowNumber = -1;
    private string SelectedRowClassFunc(PermissionTemplate m, int rowNumber)
    {
        if (selectedRowNumber == rowNumber)
        {
            selectedRowNumber = -1;
            return string.Empty;
        }
        else if (mudTable.SelectedItem != null && mudTable.SelectedItem.Equals(m))
        {
            selectedRowNumber = rowNumber;
            return "selected";
        }
        else
        {
            return string.Empty;
        }
    }

    async Task CommittedItem(PermissionTemplate item)
    {
        if (FormMenuSelecteds.Count == 0)
        {
            CallSnackBar("Select Menu Name", MudBlazor.Severity.Warning);
            return;
        }
        foreach (var menu in FormMenuSelecteds)
        {
            var menus = ssv.GetMenufromid(menu.MenuID);

            var newItem = new PermissionTemplate
            {
                Id = Guid.NewGuid(), // Tạo ID mới mỗi lần
                Dept = item.Dept,
                canView = item.canView,
                canAdd = item.canAdd,
                canEdit = item.canEdit,
                canDelete = item.canDelete,
                canApprove = item.canApprove,
                MenuId = menus.MenuID,
                MenuName = menus.MenuName,
                // copy thêm field khác nếu có
            };

            var rs = await gsv.CreatePerTemplate(newItem);
            CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
        }
        FormMenuSelecteds.Clear();
        search = item.Dept!;
        await Refresh();
    }

    async Task AddItem()
    {
        var item = new PermissionTemplate();
        Listdata.Add(item);
        await mudTable.SetEditingItemAsync(Listdata.LastOrDefault()!);
    }

    async Task DeleteItem(PermissionTemplate item)
    {
        var resultMess = await DialogService.ShowMessageBox(
                "Warning",
                "Deleting can not be undone!",
                yesText: "Delete!", cancelText: "Cancel");

        if (resultMess.HasValue)
        {
            var rs = await gsv.DeletePerTemplate(item);
            CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
            await Refresh();
        }

    }
    string search;

    private bool FilterFunc1(PermissionTemplate sbd) => FilterFunc(sbd, search);

    private bool FilterFunc(PermissionTemplate sbd, string searchString)
    {
        if (string.IsNullOrWhiteSpace(searchString))
            return true;
        if (string.IsNullOrEmpty(sbd.Dept))
            return true;
        if (sbd.Dept!.Contains(searchString, StringComparison.OrdinalIgnoreCase))
            return true;
        if ($"{sbd.Dept} ".Contains(searchString))
            return true;
        return false;
    }
    private async Task<IEnumerable<string?>> SearchDept(string? text)
    {
        try
        {
            var rs = Depts.Where(s => !string.IsNullOrEmpty(s))
                   .Distinct();
            if (string.IsNullOrWhiteSpace(text))
            {
                return rs;
            }

            return rs.Where(x => x.Contains(text, StringComparison.OrdinalIgnoreCase))!;
        }
        catch (Exception)
        {
            throw;
        }
    }
    string GetTitlefrommenuid(Guid? id)
    {
        var rs = Menus.FirstOrDefault(x => x.MenuID == id);
        return rs != null ? rs.Title! : "";
    }

    Guid GetMenufrommName(string? name)
    {
        var result = ssv.GetMenufrommName(name);
        return result.MenuID;
    }

}
