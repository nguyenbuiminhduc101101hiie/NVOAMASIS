@inject GlobalServices gsv
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject AccountService asv
@inject SharedServices ssv
@inject SupportServices supsv
@inject IStringLocalizer<SharedResource> Localizer
<MudDialog>
    <DialogContent>
        <MudStack Row Justify="Justify.FlexStart" Class="pa-4">
            <MudAutocomplete @bind-Value="UserReference" Label="User Tham Chiếu" SearchFunc="SearchFuncUser" Required/>
            <MudAutocomplete @bind-Value="UserChild" Label="User" SearchFunc="SearchFuncUser" Required/>
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => Muddialog.Close((UserReference,UserChild)))">Submit</MudButton>
        <MudButton OnClick="@(() => Muddialog.Cancel())">Close</MudButton>
    </DialogActions>
</MudDialog>
@code {
    [CascadingParameter] public MudDialogInstance Muddialog { get; set; }
    DialogOptions dialogOptions = new DialogOptions
    {
        ClassBackground="class-dialog-custom",
        FullWidth = true,
        MaxWidth = MaxWidth.Medium,
        DisableBackdropClick  = true,
        CloseOnEscapeKey = false,
        NoHeader = true
    };
    string? UserReference, UserChild;
    List<FormMenu> Menus = new List<FormMenu>();
    List<string> ListUser = new List<string>();
    protected async override Task OnInitializedAsync()
    {
        Menus = await ssv.GetListFormMenu();
        var usrs = await asv.GetListUser();
        ListUser = usrs.Select(x => x.Usr).ToList()!;
    }


    void CallSnackBar(string message, MudBlazor.Severity severity)
    {
        Snackbar.Clear();
        Snackbar.Configuration.SnackbarVariant = Variant.Filled;
        Snackbar.Configuration.MaxDisplayedSnackbars = 3;
        Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopRight;
        Snackbar.Add(message, severity);
    }
    private async Task<IEnumerable<string?>> SearchFuncUser(string? text)
    {
        try
        {
            var rs = ListUser.Where(s => !string.IsNullOrEmpty(s))
                   .Distinct();
            if (string.IsNullOrWhiteSpace(text))
            {
                return rs;
            }

            return rs.Where(x => x.Contains(text, StringComparison.OrdinalIgnoreCase))!;
        }
        catch (Exception)
        {
            throw;
        }
    }
}
