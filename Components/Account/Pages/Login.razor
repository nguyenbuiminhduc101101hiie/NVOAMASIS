</style>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "tenant-login")]
    private TenantLoginModel? LoginInput { get; set; }

    [SupplyParameterFromForm(FormName = "tenant-register")]
    private TenantEmailRegisterModel? RegisterInput { get; set; }

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery(Name = "tab")]
    private string? TabQuery { get; set; }

    [SupplyParameterFromQuery(Name = "db")]
    private string? PrefillDatabaseName { get; set; }

    [SupplyParameterFromQuery(Name = "sqlUser")]
    private string? PrefillSqlUser { get; set; }

    [SupplyParameterFromQuery(Name = "sqlPass")]
    private string? PrefillSqlPassword { get; set; }

    [SupplyParameterFromQuery(Name = "appUser")]
    private string? PrefillAppUser { get; set; }

    [SupplyParameterFromQuery(Name = "appPass")]
    private string? PrefillAppPassword { get; set; }

    [SupplyParameterFromQuery(Name = "registered")]
    private string? RegisteredFlag { get; set; }

    private enum Tab { Login, Register }
    private Tab activeTab = Tab.Login;

    private string LoginTabUrl => BuildTabUrl("login");
    private string RegisterTabUrl => BuildTabUrl("register");

    private string? errorMessage;
    private string? successMessage;
    private string? mailFailureCredentials;
    private bool isBusy;

    private void ApplyLoginPrefillFromQuery(TenantLoginModel input)
    {
        if (!string.IsNullOrWhiteSpace(PrefillDatabaseName))
            input.DatabaseName = PrefillDatabaseName.Trim();
        if (!string.IsNullOrWhiteSpace(PrefillSqlUser))
            input.SqlUserId = PrefillSqlUser.Trim();
        if (!string.IsNullOrWhiteSpace(PrefillSqlPassword))
            input.SqlPassword = PrefillSqlPassword.Trim();
        if (!string.IsNullOrWhiteSpace(PrefillAppUser))
            input.AppUserName = PrefillAppUser.Trim();
        if (!string.IsNullOrWhiteSpace(PrefillAppPassword))
            input.AppPassword = PrefillAppPassword.Trim();
    }

    private string BuildTenantLoginUrl(TenantGeneratedCredentials c, bool includeRegistered = false)
    {
        var q = new List<string> { "tab=login" };
        q.Add($"db={Uri.EscapeDataString(c.DatabaseName.Trim())}");
        q.Add($"sqlUser={Uri.EscapeDataString(c.SqlUser.Trim())}");
        q.Add($"sqlPass={Uri.EscapeDataString(c.SqlPassword.Trim())}");
        q.Add($"appUser={Uri.EscapeDataString(c.AppUser.Trim())}");
        q.Add($"appPass={Uri.EscapeDataString(c.AppPassword.Trim())}");
        if (includeRegistered)
            q.Add("registered=1");

        return navSvc.ToAbsoluteUri($"/Account/Login?{string.Join("&", q)}").ToString();
    }

    private string BuildTabUrl(string tab)
    {
        var q = new List<string> { $"tab={tab}" };
        if (!string.IsNullOrEmpty(ReturnUrl))
            q.Add($"returnUrl={Uri.EscapeDataString(ReturnUrl)}");
        return $"/Account/Login?{string.Join("&", q)}";
    }

    protected override async Task OnInitializedAsync()
    {
        activeTab = TabQuery?.Equals("register", StringComparison.OrdinalIgnoreCase) == true
            ? Tab.Register
            : Tab.Login;

        LoginInput ??= new TenantLoginModel();
        ApplyLoginPrefillFromQuery(LoginInput);
        TrimLoginInput(LoginInput);

        RegisterInput ??= new TenantEmailRegisterModel();

        if (RegisteredFlag == "1")
            successMessage = "Đăng ký database thành công. Vui lòng kiểm tra email để lấy thông tin đăng nhập.";

        if (HttpMethods.IsGet(HttpContext.Request.Method))
            await HttpContext.SignOutAsync(CookieAuthenticationDefaults.AuthenticationScheme);
    }

    [ValidateAntiForgeryToken]
    public async Task LoginUser()
    {
        if (LoginInput == null) return;
        TrimLoginInput(LoginInput);
        isBusy = true;
        errorMessage = null;
        successMessage = null;
        mailFailureCredentials = null;

        try
        {
            var result = await tenantAuth.LoginAsync(
                LoginInput.DatabaseName,
                LoginInput.SqlUserId,
                LoginInput.SqlPassword,
                LoginInput.AppUserName,
                LoginInput.AppPassword);

            errorMessage = result.Flag ? null : result.Message;
            if (!result.Flag || result.AuthUser == null || result.TenantId == null)
                return;

            await SignInWithClaimsAsync(result.AuthUser, result.TenantId.Value, result.TenantDatabaseName ?? LoginInput.DatabaseName);
            Logger.LogInformation("User {User} logged in to tenant {Db}.", result.AuthUser.Usr, result.TenantDatabaseName);
            navSvc.NavigateTo(ReturnUrl ?? "/", true);
        }
        finally
        {
            isBusy = false;
        }
    }

    [ValidateAntiForgeryToken]
    public async Task RegisterTenant()
    {
        if (RegisterInput == null) return;

        var email = NormalizeEmail(RegisterInput.Email);
        if (string.IsNullOrWhiteSpace(email) || !new EmailAddressAttribute().IsValid(email))
        {
            errorMessage = "Email không hợp lệ.";
            return;
        }

        isBusy = true;
        errorMessage = null;
        successMessage = null;
        mailFailureCredentials = null;

        var generated = BuildTenantCredentials(email);

        try
        {
            var admin = new AuthUser
            {
                Name = email,
                Usr = email,
                Email = email,
                Pass_viettel = generated.AppPassword,
                Department = "ADMIN",
                Branch = "SGN",
                CompanyCode = "AMSS"
            };

            var result = await tenantAuth.RegisterTenantAsync(
                generated.DatabaseName,
                generated.SqlUser,
                generated.SqlPassword,
                admin);

            if (!result.Flag)
            {
                errorMessage = IsDuplicateMessage(result.Message)
                    ? "Email này đã được đăng ký hoặc database tương ứng đã tồn tại. Vui lòng dùng email khác hoặc liên hệ LMS để cấp lại thông tin đăng nhập."
                    : result.Message;
                return;
            }

            try
            {
                await SendTenantCreatedEmailAsync(generated);
            }
            catch (Exception mailEx)
            {
                Logger.LogError(mailEx, "Tenant created but email sending failed for {Email}.", email);
                successMessage = "Database đã tạo thành công nhưng SMTP chưa xác thực được. Anh kiểm tra Host/Port/UserName/Password/EnableSsl rồi gửi lại email.";
                errorMessage = "Gửi email thất bại: " + BuildMailErrorMessage(mailEx);
                mailFailureCredentials = BuildCredentialBackupText(generated);
                return;
            }

            navSvc.NavigateTo(
                BuildTabUrl("login") +
                $"&db={Uri.EscapeDataString(generated.DatabaseName)}&registered=1",
                forceLoad: true);
        }
        finally
        {
            isBusy = false;
        }
    }

    private TenantGeneratedCredentials BuildTenantCredentials(string email)
    {
        var safe = ToSqlSafeName(email);
        var hash = ShortHash(email, 8);

        // Dùng tên deterministic theo email để kiểm tra trùng: cùng email sẽ ra cùng DatabaseName.
        var databaseSafe = TrimToMax(safe, 72);
        var userSafe = TrimToMax(safe, 48);

        return new TenantGeneratedCredentials
        {
            Email = email,
            DatabaseName = $"LMS_{databaseSafe}_{hash}",
            SqlUser = $"sql_{userSafe}_{hash}",
            SqlPassword = GenerateStrongPassword(20),
            AppUser = email,
            AppPassword = GenerateStrongPassword(16)
        };
    }

    private async Task SendTenantCreatedEmailAsync(TenantGeneratedCredentials c)
    {
        var settings = ReadTenantSmtpSettings();
        var loginUrl = BuildTenantLoginUrl(c);
        var message = BuildTenantCreatedMessage(c, loginUrl, settings);
        var attempts = await BuildSmtpConnectionAttemptsAsync(settings);
        var failures = new List<string>();

        foreach (var attempt in attempts)
        {
            using var client = new MailKit.Net.Smtp.SmtpClient();
            try
            {
                await client.ConnectAsync(attempt.Host, settings.Port, attempt.SocketOptions);
                await client.AuthenticateAsync(settings.Username, settings.Password);
                await client.SendAsync(message);
                await client.DisconnectAsync(true);

                if (!string.Equals(attempt.Host, settings.Host, StringComparison.OrdinalIgnoreCase))
                {
                    Logger.LogWarning(
                        "Tenant registration email used SMTP fallback host {FallbackHost} instead of configured host {ConfiguredHost}.",
                        attempt.Host,
                        settings.Host);
                }

                return;
            }
            catch (Exception ex)
            {
                failures.Add($"{attempt.Host}:{settings.Port} [{attempt.SocketOptions}] - {FlattenExceptionMessage(ex)}");
                Logger.LogWarning(
                    ex,
                    "SMTP send failed for tenant registration via {Host}:{Port} using {SocketOptions}.",
                    attempt.Host,
                    settings.Port,
                    attempt.SocketOptions);

                try
                {
                    if (client.IsConnected)
                        await client.DisconnectAsync(true);
                }
                catch
                {
                }
            }
        }

        var attemptedHosts = string.Join(", ", attempts.Select(static a => a.Host).Distinct(StringComparer.OrdinalIgnoreCase));
        var detail = string.Join(" || ", failures);
        throw new InvalidOperationException(
            $"Không thể gửi email đăng ký. Ứng dụng đã thử các host SMTP: {attemptedHosts}. Host cấu hình có thể không khớp certificate của mail server. Chi tiết: {detail}");
    }

    private TenantSmtpSettings ReadTenantSmtpSettings()
    {
        var host = TrimConfig(ReadConfig("Smtp:Host", "mail.logisticssoftware.vn"));
        var portText = TrimConfig(ReadConfig("Smtp:Port", "587"));
        var enableSslText = TrimConfig(ReadConfig("Smtp:EnableSsl", "true"));
        var username = TrimConfig(ReadConfig("Smtp:UserName")
                    ?? ReadConfig("Smtp:Username")
                    ?? ReadConfig("Smtp:User")
                    ?? "vms.noreply@logisticssoftware.vn");
        var password = TrimConfig(ReadConfig("Smtp:Password", "Noreply@1"));
        var fromEmail = TrimConfig(ReadConfig("Smtp:FromEmail")
                     ?? ReadConfig("Smtp:SenderEmail")
                     ?? username);
        var fromName = TrimConfig(ReadConfig("Smtp:FromName", "LMS"));

        if (string.IsNullOrWhiteSpace(host)
            || string.IsNullOrWhiteSpace(fromEmail)
            || string.IsNullOrWhiteSpace(username)
            || string.IsNullOrWhiteSpace(password))
        {
            throw new InvalidOperationException("Thiếu cấu hình SMTP: Smtp:Host, Smtp:UserName, Smtp:Password, Smtp:FromEmail.");
        }

        var port = int.TryParse(portText, out var parsedPort) ? parsedPort : 587;
        var enableSsl = !bool.TryParse(enableSslText, out var parsedSsl) || parsedSsl;
        return new TenantSmtpSettings(host, port, enableSsl, username, password, fromEmail, fromName);
    }

    private static MimeMessage BuildTenantCreatedMessage(TenantGeneratedCredentials c, string loginUrl, TenantSmtpSettings settings)
    {
        var sender = new MailboxAddress(settings.FromName, settings.FromEmail);
        var message = new MimeMessage();
        message.From.Add(sender);
        message.Sender = sender;
        message.To.Add(MailboxAddress.Parse(c.Email));
        message.ReplyTo.Add(sender);
        message.Subject = "Thông tin đăng nhập LMS";
        message.Body = new BodyBuilder
        {
            HtmlBody = BuildTenantEmailHtml(c, loginUrl)
        }.ToMessageBody();
        return message;
    }

    private async Task<IReadOnlyList<SmtpConnectionAttempt>> BuildSmtpConnectionAttemptsAsync(TenantSmtpSettings settings)
    {
        var hosts = new List<string>();
        AddHostCandidate(hosts, settings.Host);

        foreach (var resolvedHost in await ResolveReverseDnsHostsAsync(settings.Host))
            AddHostCandidate(hosts, resolvedHost);

        var senderDomain = ExtractEmailDomain(settings.FromEmail) ?? ExtractEmailDomain(settings.Username);
        if (!string.IsNullOrWhiteSpace(senderDomain))
        {
            AddHostCandidate(hosts, $"smtp.{senderDomain}");
            AddHostCandidate(hosts, $"mail.{senderDomain}");
            AddHostCandidate(hosts, senderDomain);
        }

        if (settings.Host.StartsWith("mail.", StringComparison.OrdinalIgnoreCase)
            || settings.Host.StartsWith("smtp.", StringComparison.OrdinalIgnoreCase))
        {
            AddHostCandidate(hosts, settings.Host[(settings.Host.IndexOf('.') + 1)..]);
        }

        var socketOptions = BuildSocketOptions(settings.Port, settings.EnableSsl);
        return hosts
            .SelectMany(host => socketOptions.Select(option => new SmtpConnectionAttempt(host, option)))
            .ToList();
    }

    private static IReadOnlyList<SecureSocketOptions> BuildSocketOptions(int port, bool enableSsl)
    {
        var options = new List<SecureSocketOptions>();

        if (enableSsl)
        {
            options.Add(port == 465 ? SecureSocketOptions.SslOnConnect : SecureSocketOptions.StartTls);
            options.Add(SecureSocketOptions.Auto);
        }
        else
        {
            options.Add(SecureSocketOptions.None);
            options.Add(SecureSocketOptions.Auto);
        }

        return options.Distinct().ToList();
    }

    private static async Task<IReadOnlyList<string>> ResolveReverseDnsHostsAsync(string host)
    {
        var results = new List<string>();

        try
        {
            var addresses = await Dns.GetHostAddressesAsync(host);
            foreach (var address in addresses)
            {
                try
                {
                    var entry = await Dns.GetHostEntryAsync(address);
                    AddHostCandidate(results, entry.HostName);
                }
                catch
                {
                }
            }
        }
        catch
        {
        }

        return results;
    }

    private static void AddHostCandidate(ICollection<string> hosts, string? host)
    {
        var normalized = host?.Trim().TrimEnd('.');
        if (string.IsNullOrWhiteSpace(normalized))
            return;

        if (!hosts.Contains(normalized, StringComparer.OrdinalIgnoreCase))
            hosts.Add(normalized);
    }

    private static string? ExtractEmailDomain(string? email)
    {
        if (string.IsNullOrWhiteSpace(email))
            return null;

        var atIndex = email.LastIndexOf('@');
        if (atIndex < 0 || atIndex == email.Length - 1)
            return null;

        return email[(atIndex + 1)..].Trim();
    }

    private string? ReadConfig(string key, string? fallback = null)
    {
        var value = Configuration[key];
        return string.IsNullOrWhiteSpace(value) ? TrimConfig(fallback) : value.Trim();
    }

    private static string? TrimConfig(string? value)
        => string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    private static string BuildMailErrorMessage(Exception ex)
    {
        var message = FlattenExceptionMessage(ex);

        if (message.Contains("RemoteCertificateNameMismatch", StringComparison.OrdinalIgnoreCase)
            || (message.Contains("certificate", StringComparison.OrdinalIgnoreCase)
                && message.Contains("name", StringComparison.OrdinalIgnoreCase)))
        {
            message += " | Host SMTP hiện tại không khớp certificate của mail server. Cần dùng hostname canonical đúng của nhà cung cấp mail.";
        }

        if (message.Contains("5.7.0", StringComparison.OrdinalIgnoreCase)
            || message.Contains("Authentication Required", StringComparison.OrdinalIgnoreCase)
            || message.Contains("client was not authenticated", StringComparison.OrdinalIgnoreCase))
        {
            message += " | Nguyên nhân thường gặp: sai SMTP password, mailbox chưa bật SMTP AUTH, host/port/SSL chưa đúng, hoặc mail server chưa cho phép SMTP relay.";
        }

        return message;
    }

    private static string FlattenExceptionMessage(Exception ex)
    {
        var messages = new List<string>();
        CollectExceptionMessages(ex, messages);
        return string.Join(" | Inner: ", messages.Distinct(StringComparer.Ordinal));
    }

    private static void CollectExceptionMessages(Exception? ex, ICollection<string> messages)
    {
        if (ex == null)
            return;

        if (ex is AggregateException aggregateException)
        {
            foreach (var inner in aggregateException.Flatten().InnerExceptions)
                CollectExceptionMessages(inner, messages);
            return;
        }

        if (!string.IsNullOrWhiteSpace(ex.Message))
            messages.Add(ex.Message.Trim());

        if (ex.InnerException != null)
            CollectExceptionMessages(ex.InnerException, messages);
    }

