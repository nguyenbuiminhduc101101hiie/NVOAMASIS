    }

    .tenant-tabs .nav-link {
        font-weight: 700;
        color: #475569;
        border-radius: 14px 14px 0 0;
    }

    .tenant-tabs .nav-link.active {
        color: #0f766e;
    }

    .login-card {
        border: 1px solid rgba(15, 23, 42, .08);
        box-shadow: 0 18px 45px rgba(15, 23, 42, .10);
    }

    .register-card {
        border-top: 4px solid #10b981 !important;
