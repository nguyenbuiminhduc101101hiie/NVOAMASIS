    private static string NormalizeEmail(string? email)
        => (email ?? string.Empty).Trim().ToLowerInvariant();

    private static bool IsDuplicateMessage(string? message)
    {
        if (string.IsNullOrWhiteSpace(message)) return false;
        return message.Contains("already", StringComparison.OrdinalIgnoreCase)
            || message.Contains("exist", StringComparison.OrdinalIgnoreCase)
            || message.Contains("duplicate", StringComparison.OrdinalIgnoreCase)
            || message.Contains("tồn tại", StringComparison.OrdinalIgnoreCase)
            || message.Contains("trùng", StringComparison.OrdinalIgnoreCase);
    }

    private static string ToSqlSafeName(string value)
    {
        var cleaned = Regex.Replace(value.Trim().ToLowerInvariant(), @"[^a-z0-9]+", "_").Trim('_');
        return string.IsNullOrWhiteSpace(cleaned) ? "tenant" : cleaned;
    }

    private static string TrimToMax(string value, int max)
        => value.Length <= max ? value : value[..max].TrimEnd('_');

    private static string ShortHash(string value, int length)
    {
        var bytes = SHA256.HashData(Encoding.UTF8.GetBytes(value.Trim().ToLowerInvariant()));
        var hex = Convert.ToHexString(bytes).ToLowerInvariant();
        return hex[..Math.Min(length, hex.Length)];
    }

    private static string GenerateStrongPassword(int length)
    {
        const string upper = "ABCDEFGHJKLMNPQRSTUVWXYZ";
        const string lower = "abcdefghijkmnopqrstuvwxyz";
        const string digits = "23456789";
        const string symbols = "!@#$%*?";
        var all = upper + lower + digits + symbols;

        var chars = new List<char>
        {
            upper[RandomNumberGenerator.GetInt32(upper.Length)],
            lower[RandomNumberGenerator.GetInt32(lower.Length)],
            digits[RandomNumberGenerator.GetInt32(digits.Length)],
            symbols[RandomNumberGenerator.GetInt32(symbols.Length)]
        };

        while (chars.Count < length)
            chars.Add(all[RandomNumberGenerator.GetInt32(all.Length)]);

        return new string(chars.OrderBy(_ => RandomNumberGenerator.GetInt32(int.MaxValue)).ToArray());
    }

    private async Task SignInWithClaimsAsync(AuthUser authUser, Guid tenantId, string databaseName)
    {
        var userClaims = new List<Claim>
        {
            new(ClaimTypes.Name, authUser.Usr ?? ""),
            new(ClaimTypes.Sid, authUser.UsrId.ToString()),
            new(ClaimTypes.GivenName, authUser.Name ?? ""),
            new(ClaimTypes.Email, authUser.Email ?? ""),
            new(ClaimTypes.Role, authUser.Department ?? ""),
            new(ClaimTypes.NameIdentifier, authUser.UsrId.ToString()),
            new(TenantClaimTypes.TenantId, tenantId.ToString()),
            new(TenantClaimTypes.DatabaseName, databaseName)
        };

        var userIdentity = new ClaimsIdentity(userClaims, CookieAuthenticationDefaults.AuthenticationScheme);
        var authProperties = new AuthenticationProperties
        {
            IssuedUtc = DateTimeOffset.UtcNow.AddDays(-1),
            ExpiresUtc = DateTimeOffset.UtcNow.AddMonths(1),
            RedirectUri = ReturnUrl,
            IsPersistent = LoginInput?.RememberMe ?? false
        };

        await HttpContext.SignInAsync(
            CookieAuthenticationDefaults.AuthenticationScheme,
            new ClaimsPrincipal(userIdentity),
            authProperties);
    }

