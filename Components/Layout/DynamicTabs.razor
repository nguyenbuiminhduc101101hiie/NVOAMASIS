
<MudDynamicTabs @ref="_mudTabs" Class="custom-tab"
                @bind-ActivePanelIndex="_activeIndex"
                KeepPanelsAlive="true" 
                Rounded="true"
                Centered="false" CloseIconClass="close-tab-icon" CloseIconToolTip="Close tab. All data will be lost"
                Border="true" CloseTab="@CloseTabCallback"
                @bind-ActivePanelIndex:after="OnTabChanged">

    @foreach (var tab in Tabs)
    {
        <MudTabPanel ShowCloseIcon Text="@tab.Title" ID="tab.Key" Style=@($"background-color:{tab.HexColor}; color:black; padding:6px 12px; border-radius:6px;")>
            @tab.Content
        </MudTabPanel>
    }
</MudDynamicTabs>
@inject IJSRuntime JSRuntime
@inject IStringLocalizer<SharedResource> Localizer
@code {
    RenderFragment RenderComponent(Type componentType) => builder =>
       {
           builder.OpenComponent(0, componentType);
           builder.CloseComponent();
       };
    protected override Task OnInitializedAsync()
    {
        OpenTab("Dashboard", $"1. {Localizer["Dashboard"]}", RenderComponent(typeof(Components.Pages.Home)));
        return base.OnInitializedAsync();
    }
    private MudDynamicTabs _mudTabs;
    private int _activeIndex;

    public class TabItem
    {
        public string Key { get; set; } = string.Empty;
        public string Title { get; set; } = string.Empty;
        public RenderFragment Content { get; set; } = default!;
        public string HexColor { get; set; } = default!;
    }

    private List<TabItem> Tabs { get; set; } = new();

    public void OpenTab(string key, string title, RenderFragment content)
    {
        var existingIndex = Tabs.FindIndex(t => t.Key == key);
        if (existingIndex >= 0)
        {
            _activeIndex = existingIndex;
        }
        else
        {
            Tabs.Add(new TabItem
                {
                    Key = key,
                    Title = title,
                    Content = content,
                    HexColor = GetRandomPastelColorHex()
                });

            _activeIndex = Tabs.Count - 1;
        }

        StateHasChanged(); // rất quan trọng
    }

    private void CloseTab(string key)
    {
        var index = Tabs.FindIndex(t => t.Key == key);
        if (index < 0) return;

        bool isActiveTab = index == _activeIndex;

        Tabs.RemoveAt(index);

        if (Tabs.Count == 0)
        {
            _activeIndex = -1; // Không còn tab
        }
        else if (isActiveTab)
        {
            // Nếu tab bị đóng là tab đang xem
            _activeIndex = index == 0 ? 0 : index - 1;
        }
        else if (index < _activeIndex)
        {
            // Nếu tab bị đóng nằm trước tab đang xem, giảm _activeIndex
            _activeIndex--;
        }

        StateHasChanged();
    }

    void CloseTabCallback(MudTabPanel panel) => CloseTab(panel.ID.ToString()!);


    private readonly Random _random = new();
    private string GetRandomPastelColorHex()
    {
        int hue = _random.Next(0, 360); // Vòng tròn màu
        double saturation = 0.6;        // Độ rực (~60%)
        double lightness = 0.85;        // Độ sáng (~85%)

        var (r, g, b) = HslToRgb(hue, saturation, lightness);
        return $"#{r:X2}{g:X2}{b:X2}";
    }
    private (int r, int g, int b) HslToRgb(double h, double s, double l)
    {
        double c = (1 - Math.Abs(2 * l - 1)) * s;
        double x = c * (1 - Math.Abs((h / 60) % 2 - 1));
        double m = l - c / 2;

        double r1 = 0, g1 = 0, b1 = 0;

        if (h < 60) { r1 = c; g1 = x; b1 = 0; }
        else if (h < 120) { r1 = x; g1 = c; b1 = 0; }
        else if (h < 180) { r1 = 0; g1 = c; b1 = x; }
        else if (h < 240) { r1 = 0; g1 = x; b1 = c; }
        else if (h < 300) { r1 = x; g1 = 0; b1 = c; }
        else { r1 = c; g1 = 0; b1 = x; }

        int r = (int)Math.Round((r1 + m) * 255);
        int g = (int)Math.Round((g1 + m) * 255);
        int b = (int)Math.Round((b1 + m) * 255);

        return (r, g, b);
    }
    private async Task OnTabChanged()
    {
        if (_activeIndex >= 0 && _activeIndex < Tabs.Count)
        {
            var title = Tabs[_activeIndex].Title;
            await JSRuntime.InvokeVoidAsync("setPageTitle", title);
        }
    }
}
