@inject AccountService asv
@inject SharedServices ssv
@inject SingletonSerivce singsv

@code {
    [Parameter] public EventCallback<(string Key, string Title, RenderFragment Content)> OnTabRequest { get; set; }

    private async Task OpenTab(string key, string title, RenderFragment content)
    {
        if (OnTabRequest.HasDelegate)
            await OnTabRequest.InvokeAsync((key, title, content));
    }

    RenderFragment RenderComponent(Type componentType) => builder =>
    {
        builder.OpenComponent(0, componentType);
        builder.CloseComponent();
    };
    private RenderFragment RenderStockIndex(string? stockUiScope, int initialMainTabIndex = 0) => builder =>
    {
        builder.OpenComponent<Components.Stock.Pages.Stock_Index>(0);
        builder.AddAttribute(1, nameof(Components.Stock.Pages.Stock_Index.StockUiScope), stockUiScope);
        builder.AddAttribute(2, nameof(Components.Stock.Pages.Stock_Index.InitialMainTabIndex), initialMainTabIndex);
        builder.CloseComponent();
    };
    private bool _expandedSystem = false;
    private bool _expandedBusiness = false;
    private bool _expandedTask = false;
    private bool _expandedPayment = false;
    private bool _expandedPriceSd = false;
    private bool _expandedPricing = false;
    private bool _expandedStatistical = false;
    private bool _expandedEQ = false;
    private bool _canSeeSiMenu;
    private bool _expanded83Stock = false;

    bool canViewShipment2 = true;
    bool canViewShipment5 = true;
    bool canViewShipment6 = true;
    private string navMenuBackgroundColor = ThemeDefaults.NavMenuBackgroundColor;
    private string navMenuTextColor = ThemeDefaults.NavMenuTextColor;

    protected override async Task OnInitializedAsync()
    {
        var authState = await singsv.GetAuth();
        var user = authState.User.Identity!.Name;

        // Debug role hiện tại của user (để kiểm tra AuthorizeView Roles="...").
        // Xem output server/console để thấy danh sách role claims.
        try
        {
            var roleClaims = authState.User.Claims
                .Where(c => c.Type == System.Security.Claims.ClaimTypes.Role)
                .Select(c => c.Value)
                .ToList();
            Console.WriteLine($"[NavMenu] user={user}; roles=[{string.Join(",", roleClaims)}]");

            // So sánh thủ công để tránh sai do case/whitespace khi set ClaimTypes.Role.
            _canSeeSiMenu = roleClaims.Any(r =>
                !string.IsNullOrWhiteSpace(r) &&
                string.Equals(r.Trim(), "SI GET", StringComparison.OrdinalIgnoreCase));
        }
        catch
        {
            // ignore debug failure
        }

        // // Kiểm tra quyền cụ thể
        // canViewShipment2 = await ssv.CheckPermission(user ?? string.Empty, "View", "Shipment");
        // canViewShipment5 = await ssv.CheckPermission(user ?? string.Empty, "View", "Shipment5");
        // canViewShipment6 = await ssv.CheckPermission(user ?? string.Empty, "View", "Shipment6");

        await LoadThemePreference();
    }

    public async Task ReloadThemeAsync()
    {
        await LoadThemePreference();
    }

    private async Task LoadThemePreference()
    {
        try
        {
            var url = Navigation.ToAbsoluteUri("api/theme/get");
            var request = new HttpRequestMessage(HttpMethod.Get, url);
            
            // Add cookies from HttpContext to request
            if (HttpContextAccessor.HttpContext != null)
            {
                var cookies = HttpContextAccessor.HttpContext.Request.Cookies;
                var cookieHeader = string.Join("; ", cookies.Select(c => $"{c.Key}={c.Value}"));
                if (!string.IsNullOrEmpty(cookieHeader))
                {
                    request.Headers.Add("Cookie", cookieHeader);
                }
            }
            
            var httpResponse = await Http.SendAsync(request);
            
            if (!httpResponse.IsSuccessStatusCode)
            {
                var errorContent = await httpResponse.Content.ReadAsStringAsync();
                Console.WriteLine($"NavMenu API Error: {httpResponse.StatusCode} - {errorContent.Substring(0, Math.Min(200, errorContent.Length))}");
                return;
            }

            var response = await httpResponse.Content.ReadFromJsonAsync<ThemeResponse>();
            if (response != null)
            {
                if (!string.IsNullOrEmpty(response.NavMenuBackgroundColor))
                    navMenuBackgroundColor = response.NavMenuBackgroundColor;
                if (!string.IsNullOrEmpty(response.NavMenuTextColor))
                    navMenuTextColor = response.NavMenuTextColor;
                Console.WriteLine($"Loaded NavMenu colors: bg={navMenuBackgroundColor}, text={navMenuTextColor}");
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading NavMenu theme: {ex.Message}");
            Console.WriteLine($"StackTrace: {ex.StackTrace}");
        }
    }

    private class ThemeResponse
    {
        public string? NavMenuBackgroundColor { get; set; }
        public string? NavMenuTextColor { get; set; }
        public string? MainLayoutBackgroundColor { get; set; }
    }
}