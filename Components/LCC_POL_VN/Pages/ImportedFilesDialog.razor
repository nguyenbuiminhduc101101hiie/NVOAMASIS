@using Microsoft.Extensions.Localization
@using NVOAMASIS.Resources
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject LccPolVietnamServices lcpv
@inject SharedServices ssv
@inject AccountService asv
@inject IStringLocalizer<SharedResource> Localizer

<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mb-3">
            @Localizer["LccPol_ImportedFilesHint"]
        </MudText>

        @if (_loading)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-3" />
        }
        else if (_files.Count == 0)
        {
            <MudAlert Severity="MudBlazor.Severity.Info">@Localizer["LccPol_NoImportedFiles"]</MudAlert>
        }
        else
        {
            <MudTable Items="@_files" Dense="true" Hover="true" Bordered="true">
                <HeaderContent>
                    <MudTh>@Localizer["LccPol_Col_FileName"]</MudTh>
                    <MudTh>@Localizer["LccPol_Col_RowCount"]</MudTh>
                    <MudTh>@Localizer["LccPol_Col_LastImport"]</MudTh>
                    <MudTh></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="@Localizer["LccPol_Col_FileName"]">@context.FileName</MudTd>
                    <MudTd DataLabel="@Localizer["LccPol_Col_RowCount"]">@context.RowCount</MudTd>
                    <MudTd DataLabel="@Localizer["LccPol_Col_LastImport"]">@(context.LastImportDate?.ToString("dd/MM/yyyy HH:mm"))</MudTd>
                    <MudTd>
                        <MudIconButton Icon="@Icons.Material.Outlined.Delete" Color="Color.Error" Size="Size.Small"
                                       OnClick="@(() => DeleteFile(context))" />
                    </MudTd>
                </RowTemplate>
            </MudTable>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Close">@Localizer["LccPol_Close"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] MudDialogInstance MudDialog { get; set; }

    List<LccPolVietnamImportedFile> _files = new();
    bool _loading;
    string usr = "";

    protected override async Task OnInitializedAsync()
    {
        usr = asv.GetAuth().Result.User.Identity!.Name!;
        await LoadFiles();
    }

    async Task LoadFiles()
    {
        _loading = true;
        StateHasChanged();
        _files = await lcpv.GetImportedFiles();
        _loading = false;
    }

    async Task DeleteFile(LccPolVietnamImportedFile file)
    {
        if (!await ssv.CheckPermission(usr, "Delete", "LCC_POL_Vietnam"))
        {
            Snackbar.Add(Localizer["LccPol_NoAccessDelete"], MudBlazor.Severity.Warning);
            return;
        }

        var confirmed = await DialogService.ShowMessageBox(
            Localizer["LccPol_Confirm"],
            Localizer["LccPol_DeleteFileConfirm", file.FileName],
            yesText: Localizer["delete"].Value, cancelText: Localizer["cancel"].Value);

        if (confirmed != true)
            return;

        var rs = await lcpv.DeleteByFileName(file.FileName, usr);
        Snackbar.Add(rs.Flag ? Localizer["LccPol_DeletedFileRows", file.RowCount, file.FileName] : rs.Message,
            rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
        if (rs.Flag)
            await LoadFiles();
    }

    void Close() => MudDialog.Close(DialogResult.Ok(true));
}
