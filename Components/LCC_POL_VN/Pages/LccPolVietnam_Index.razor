@page "/LccPolVietnam"
@using System.Text.Json
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.Extensions.Localization
@using NVOAMASIS.Resources
@attribute [Authorize]
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject AccountService asv
@inject SharedServices ssv
@inject LccPolVietnamServices lcpv
@inject HistoryLogService HistoryLogService
@inject IStringLocalizer<SharedResource> Localizer

<style>
    .lcc-pol-title {
        font-weight: 800;
        color: #0f3557;
    }

    .lcc-pol-toolbar {
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 14px;
        padding: 10px 12px;
        margin: 8px 12px;
    }

    .lcc-pol-toolbar .mud-button-root {
        border-radius: 999px;
        text-transform: none;
        font-weight: 700;
    }

    .lcc-pol-grid {
        border-radius: 14px;
        border: 1px solid #e2e8f0 !important;
        overflow: hidden;
    }

    .lcc-pol-grid .mud-table-head th,
    .lcc-pol-grid .mud-table thead th {
        background: linear-gradient(180deg, #118ab2 0%, #0d6f91 100%) !important;
        color: #fff !important;
        font-weight: 800 !important;
    }

    .lcc-pol-grid .mud-table-row {
        cursor: pointer;
    }

    .lcc-pol-grid .mud-table-row:hover td {
        background-color: #eef8ff !important;
    }

    .lcc-pol-grid .mud-table-row.selected td {
        background-color: #2373F4 !important;
    }
</style>

<PageTitle>@Localizer["LccPol_Title"]</PageTitle>
<MudText Class="pa-2 lcc-pol-title" Typo="Typo.h6">4.1.1 @Localizer["LccPol_Title"]</MudText>

<MudStack Row Justify="Justify.FlexStart" AlignItems="AlignItems.Center" Class="pa-4 lcc-pol-toolbar"
          Style="flex-wrap:wrap;">
    <MudButton OnClick="Refresh" Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled"
               StartIcon="@Icons.Material.Filled.Refresh" Disabled="_loading">
        @Localizer["reload"]
    </MudButton>
    <MudButton OnClick="AddItem" Size="Size.Small" Color="Color.Success" Variant="Variant.Filled"
               StartIcon="@Icons.Material.Filled.Add" Disabled="_loading || !_canAdd">
        @Localizer["new"]
    </MudButton>
    <MudButton OnClick="EditSelected" Size="Size.Small" Color="Color.Info" Variant="Variant.Filled"
               StartIcon="@Icons.Material.Filled.Edit" Disabled="_loading || !_canEdit">
        @Localizer["edit"]
    </MudButton>
    <MudButton OnClick="DeleteSelected" Size="Size.Small" Color="Color.Error" Variant="Variant.Filled"
               StartIcon="@Icons.Material.Filled.Delete" Disabled="_loading || !_canDelete">
        @Localizer["delete"]
    </MudButton>
    <MudButton OnClick="OpenImportDialog" Size="Size.Small" Color="Color.Tertiary" Variant="Variant.Filled"
               StartIcon="@Icons.Material.Filled.UploadFile" Disabled="_loading || !_canEdit">
        @Localizer["LccPol_ImportExcel"]
    </MudButton>
    <MudButton OnClick="OpenImportedFilesDialog" Size="Size.Small" Color="Color.Warning" Variant="Variant.Filled"
               StartIcon="@Icons.Material.Filled.FolderDelete">
        @Localizer["LccPol_ManageImportedFiles"]
    </MudButton>
    <MudTextField T="string" @bind-Value="search" Placeholder="@Localizer["LccPol_SearchPlaceholder"]"
                  Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Immediate="true" Clearable="true"
                  Class="mt-0 ml-md-auto" Style="max-width:320px;" />
</MudStack>

<MudDataGrid T="M_LccPolVietnam" Items="@Listdata" Filterable="true" Class="pa-4 lcc-pol-grid" Bordered="true"
             FilterMode="@DataGridFilterMode.ColumnFilterRow" Dense="true" Virtualize="true" QuickFilter="@FilterFunc1"
             FixedHeader="true" FixedFooter="true" HeaderClass="no-wrap" FooterClass="no-wrap" RowClick="OnRowClick"
             RowClassFunc="@SelectedRowClassFunc" ColumnResizeMode="@(ResizeMode.Column)" Loading="_loading">
    <Columns>
        <PropertyColumn Property="x => Listdata.IndexOf(x) + 1" Title="@Localizer["LccPol_Col_No"]"
                        Filterable="false" />
        <PropertyColumn Property="x => x.Carrier" Title="@Localizer["LccPol_Col_Carrier"]" />
        <PropertyColumn Property="x => x.ChargeType" Title="@Localizer["LccPol_Col_ChargeType"]" />
        <PropertyColumn Property="x => x.Container20DC" Title="20DC" CellClass="custom-right-align" />
        <PropertyColumn Property="x => x.Container40HC" Title="40HC" CellClass="custom-right-align" />
        <PropertyColumn Property="x => x.Remarks" Title="@Localizer["LccPol_Col_Remarks"]" />
        <PropertyColumn Property="x => x.Userupdate" Title="@Localizer["LccPol_Col_UpdatedBy"]" />
        <PropertyColumn Property="x => x.Dateupdate" Title="@Localizer["LccPol_Col_UpdatedDate"]" />
        <PropertyColumn Property="x => x.SourceFileName" Title="@Localizer["LccPol_Col_FileName"]" />
    </Columns>

    <PagerContent>
        <MudDataGridPager T="M_LccPolVietnam" PageSizeOptions="@(new int[] { 20, 50, 100 })" />
    </PagerContent>
</MudDataGrid>

@code {
    private const string PermissionMenuName = "LCC_POL_Vietnam";

    List<M_LccPolVietnam> Listdata = new();
    M_LccPolVietnam? _selected;
    string usr = string.Empty;
    bool _loading = false;
    bool _canView;
    bool _canAdd;
    bool _canEdit;
    bool _canDelete;
    string search = string.Empty;

    private readonly JsonSerializerOptions _jsonOptions = new() { PropertyNameCaseInsensitive = true };

    DialogOptions editOptions = new DialogOptions
    {
        ClassBackground = "class-dialog-custom",
        FullWidth = true,
        MaxWidth = MaxWidth.Medium,
        CloseOnEscapeKey = true,
        DisableBackdropClick = true
    };

    DialogOptions options = new DialogOptions
    {
        ClassBackground = "class-dialog-custom",
        FullWidth = true,
        MaxWidth = MaxWidth.Medium,
        CloseOnEscapeKey = false,
        DisableBackdropClick = true
    };

    DialogOptions importOptions = new DialogOptions
    {
        ClassBackground = "class-dialog-custom",
        FullWidth = true,
        MaxWidth = MaxWidth.ExtraLarge,
        CloseOnEscapeKey = false,
        DisableBackdropClick = true
    };

    protected override async Task OnInitializedAsync()
    {
        var authState = await asv.GetAuth();
        usr = authState.User.Identity!.Name!;
        _canView = await ssv.CheckPermission(usr, "View", PermissionMenuName);
        _canAdd = await ssv.CheckPermission(usr, "Add", PermissionMenuName);
        _canEdit = await ssv.CheckPermission(usr, "Edit", PermissionMenuName);
        _canDelete = await ssv.CheckPermission(usr, "Delete", PermissionMenuName);
        await Refresh();
    }

    async Task Refresh()
    {
        try
        {
            _loading = true;
            _selected = null;
            if (!_canView)
            {
                CallSnackBar(Localizer["LccPol_NoAccessView"], MudBlazor.Severity.Warning);
                Listdata = new();
                return;
            }
            Listdata = await lcpv.GetList();
            StateHasChanged();
        }
        finally
        {
            _loading = false;
        }
    }

    void CallSnackBar(string message, MudBlazor.Severity severity)
    {
        Snackbar.Configuration.SnackbarVariant = Variant.Filled;
        Snackbar.Configuration.MaxDisplayedSnackbars = 3;
        Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopRight;
        Snackbar.Add(message, severity);
    }

    private bool FilterFunc1(M_LccPolVietnam x) => FilterFunc(x, search);

    private bool FilterFunc(M_LccPolVietnam x, string searchString)
    {
        if (string.IsNullOrWhiteSpace(searchString))
            return true;
        if (!string.IsNullOrWhiteSpace(x.Carrier) && x.Carrier.Contains(searchString, StringComparison.OrdinalIgnoreCase))
            return true;
        if (!string.IsNullOrWhiteSpace(x.ChargeType) && x.ChargeType.Contains(searchString, StringComparison.OrdinalIgnoreCase))
            return true;
        return false;
    }

    private string SelectedRowClassFunc(M_LccPolVietnam row, int rowNumber) =>
        _selected != null && row.Id == _selected.Id ? "selected" : string.Empty;

    private async Task OnRowClick(DataGridRowClickEventArgs<M_LccPolVietnam> e)
    {
        _selected = e.Item;
        if (e.MouseEventArgs.Detail == 2)
            await EditSelected();
    }

    async Task AddItem()
    {
        if (!await ssv.CheckPermission(usr, "Add", PermissionMenuName))
        {
            CallSnackBar(Localizer["LccPol_NoAccessAdd"], MudBlazor.Severity.Warning);
            return;
        }

        await OpenEditDialogAsync(new M_LccPolVietnam(), original: null);
    }

    async Task EditSelected()
    {
        if (!await ssv.CheckPermission(usr, "Edit", PermissionMenuName))
        {
            CallSnackBar(Localizer["LccPol_NoAccessEdit"], MudBlazor.Severity.Warning);
            return;
        }

        if (_selected == null)
        {
            CallSnackBar(Localizer["LccPol_SelectRowToEdit"], MudBlazor.Severity.Warning);
            return;
        }

        await OpenEditDialogAsync(Clone(_selected), original: _selected);
    }

    /// <param name="original">The unmodified row when editing (kept for the history log); null when adding.</param>
    async Task OpenEditDialogAsync(M_LccPolVietnam model, M_LccPolVietnam? original)
    {
        var isNew = original == null;
        var others = Listdata.Where(x => original == null || x.Id != original.Id);
        var parameters = new DialogParameters
        {
            ["Model"] = model,
            ["IsNew"] = isNew,
            ["CarrierOptions"] = DistinctSorted(Listdata.Select(x => x.Carrier)),
            ["ChargeTypeOptions"] = DistinctSorted(Listdata.Select(x => x.ChargeType)),
            ["ExistingKeys"] = others.Select(x => LccPolVietnamEdit_Dialog.DuplicateKey(x.Carrier, x.ChargeType)).ToHashSet()
        };

        var dialog = await DialogService.ShowAsync<LccPolVietnamEdit_Dialog>(
            Localizer[isNew ? "LccPol_AddDialogTitle" : "LccPol_EditDialogTitle"], parameters, editOptions);
        var result = await dialog.Result;
        if (result.Canceled || result.Data is not M_LccPolVietnam data)
            return;

        var rs = isNew ? await lcpv.Create(data, usr) : await lcpv.Update(data, original!, usr);
        if (rs.Flag)
            CallSnackBar(Localizer[isNew ? "LccPol_Created" : "LccPol_Updated"], MudBlazor.Severity.Success);
        else
            CallSnackBar(rs.Message, MudBlazor.Severity.Error);
        await Refresh();
    }

    async Task DeleteSelected()
    {
        if (!await ssv.CheckPermission(usr, "Delete", PermissionMenuName))
        {
            CallSnackBar(Localizer["LccPol_NoAccessDelete"], MudBlazor.Severity.Warning);
            return;
        }

        if (_selected == null)
        {
            CallSnackBar(Localizer["LccPol_SelectRowToDelete"], MudBlazor.Severity.Warning);
            return;
        }

        var confirmed = await DialogService.ShowMessageBox(
            Localizer["LccPol_Confirm"],
            Localizer["LccPol_DeleteConfirm", _selected.Carrier ?? string.Empty, _selected.ChargeType ?? string.Empty],
            yesText: Localizer["delete"].Value, cancelText: Localizer["cancel"].Value);
        if (confirmed != true)
            return;

        var rs = await lcpv.Delete(_selected, usr);
        CallSnackBar(rs.Flag ? Localizer["LccPol_Deleted"] : rs.Message, rs.Flag ? MudBlazor.Severity.Success :
MudBlazor.Severity.Error);
        await Refresh();
    }

    async Task OpenImportDialog()
    {
        if (!await ssv.CheckPermission(usr, "Edit", PermissionMenuName))
        {
            CallSnackBar(Localizer["LccPol_NoAccessImport"], MudBlazor.Severity.Warning);
            return;
        }

        var dialog = await DialogService.ShowAsync<ImportDialog>(Localizer["LccPol_ImportDialogTitle"], importOptions);
        var result = await dialog.Result;
        if (!result.Canceled)
            await Refresh();
    }

    async Task OpenImportedFilesDialog()
    {
        var dialog = await DialogService.ShowAsync<ImportedFilesDialog>(Localizer["LccPol_ImportedFilesDialogTitle"], options);
        await dialog.Result;
        await Refresh();
    }

    private static List<string> DistinctSorted(IEnumerable<string?> values) =>
        values.Where(v => !string.IsNullOrWhiteSpace(v))
              .Select(v => v!.Trim())
              .Distinct(StringComparer.OrdinalIgnoreCase)
              .OrderBy(v => v, StringComparer.OrdinalIgnoreCase)
              .ToList();

    private T Clone<T>(T source)
    {
        var json = JsonSerializer.Serialize(source, _jsonOptions);
        return JsonSerializer.Deserialize<T>(json, _jsonOptions)!;
    }
}
