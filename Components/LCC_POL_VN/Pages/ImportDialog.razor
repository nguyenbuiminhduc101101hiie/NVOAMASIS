@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.Extensions.Localization
@using NVOAMASIS.Resources
@inject ISnackbar Snackbar
@inject LccPolVietnamServices lcpv
@inject AccountService asv
@inject IStringLocalizer<SharedResource> Localizer

<MudDialog>
    <DialogContent>
        @if (_step == Step.SelectFile)
        {
            <MudText Typo="Typo.body2" Class="mb-3">
                @Localizer["LccPol_ImportHint"]
            </MudText>

            <InputFile OnChange="OnFileSelected" accept=".xlsx" />

            @if (_reading)
            {
                <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mt-3" />
            }
            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <MudAlert Severity="MudBlazor.Severity.Error" Class="mt-3" Dense="true">@_errorMessage</MudAlert>
            }
        }
        else if (_step == Step.Preview && _preview != null)
        {
            <MudText Typo="Typo.body2" Class="mb-2">@Localizer["LccPol_File"]: <b>@_fileName</b></MudText>
            <MudAlert Severity="MudBlazor.Severity.Info" Dense="true" Class="mb-3">@Localizer["LccPol_PreviewSummary", _preview.InsertCount, _preview.UpdateCount, _preview.UnchangedCount]</MudAlert>

            <MudTable Items="@_preview.Rows" Dense="true" Hover="true" Bordered="true" FixedHeader="true" Height="420px" Striped="true">
                <HeaderContent>
                    <MudTh></MudTh>
                    <MudTh>@Localizer["LccPol_Col_Carrier"]</MudTh>
                    <MudTh>@Localizer["LccPol_Col_ChargeType"]</MudTh>
                    <MudTh>20DC (@Localizer["LccPol_PreviewNewValue"])</MudTh>
                    <MudTh>40HC (@Localizer["LccPol_PreviewNewValue"])</MudTh>
                    <MudTh>20DC (@Localizer["LccPol_PreviewCurrentValue"])</MudTh>
                    <MudTh>40HC (@Localizer["LccPol_PreviewCurrentValue"])</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>
                        @if (context.IsNew)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Filled">@Localizer["LccPol_Status_New"]</MudChip>
                        }
                        else if (context.HasChange)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Filled">@Localizer["LccPol_Status_Changed"]</MudChip>
                        }
                        else
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Text">@Localizer["LccPol_Status_Unchanged"]</MudChip>
                        }
                    </MudTd>
                    <MudTd>@context.Carrier</MudTd>
                    <MudTd>@context.ChargeType</MudTd>
                    <MudTd>@context.NewContainer20DC</MudTd>
                    <MudTd>@context.NewContainer40HC</MudTd>
                    <MudTd>@context.OldContainer20DC</MudTd>
                    <MudTd>@context.OldContainer40HC</MudTd>
                </RowTemplate>
                <PagerContent>
                    <MudTablePager PageSizeOptions="@(new int[] { 25, 50, 100 })" />
                </PagerContent>
            </MudTable>

            @if (_committing)
            {
                <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mt-3" />
            }
            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <MudAlert Severity="MudBlazor.Severity.Error" Class="mt-3" Dense="true">@_errorMessage</MudAlert>
            }
        }
    </DialogContent>
    <DialogActions>
        @if (_step == Step.SelectFile)
        {
            <MudButton OnClick="Cancel">@Localizer["cancel"]</MudButton>
        }
        else
        {
            <MudButton OnClick="BackToSelect" Disabled="@_committing">@Localizer["LccPol_ChooseAnotherFile"]</MudButton>
            <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="@_committing" OnClick="ConfirmImport">
                @Localizer["LccPol_ConfirmImport", _preview?.InsertCount ?? 0, _preview?.UpdateCount ?? 0]
            </MudButton>
        }
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] MudDialogInstance MudDialog { get; set; }

    enum Step { SelectFile, Preview }
    Step _step = Step.SelectFile;

    string? _fileName;
    bool _reading;
    bool _committing;
    string? _errorMessage;

    List<LccPolVietnamParsedRow>? _parsedRows;
    LccPolVietnamPreview? _preview;
    string usr = "";

    protected override void OnInitialized()
    {
        usr = asv.GetAuth().Result.User.Identity!.Name!;
    }

    async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;

        _errorMessage = null;

        if (file.Size > 20 * 1024 * 1024)
        {
            _errorMessage = Localizer["LccPol_FileTooLarge", 20];
            return;
        }

        try
        {
            _reading = true;
            StateHasChanged();

            using var ms = new MemoryStream();
            await using var stream = file.OpenReadStream(20 * 1024 * 1024);
            await stream.CopyToAsync(ms);
            ms.Position = 0;

            var parseResult = lcpv.ParseExcelSheet1(ms);
            if (!parseResult.Flag)
            {
                _errorMessage = parseResult.Message;
                return;
            }

            var preview = await lcpv.BuildPreview(parseResult.Rows);
            if (!preview.Flag)
            {
                _errorMessage = preview.Message;
                return;
            }

            _fileName = file.Name;
            _parsedRows = parseResult.Rows;
            _preview = preview;
            _step = Step.Preview;
        }
        finally
        {
            _reading = false;
        }
    }

    void BackToSelect()
    {
        _step = Step.SelectFile;
        _parsedRows = null;
        _preview = null;
        _fileName = null;
        _errorMessage = null;
    }

    async Task ConfirmImport()
    {
        if (_parsedRows == null || _fileName == null) return;

        try
        {
            _committing = true;
            _errorMessage = null;
            StateHasChanged();

            var rs = await lcpv.CommitImport(_parsedRows, usr, _fileName);
            if (rs.Flag)
            {
                Snackbar.Add(Localizer["LccPol_ImportSuccess", rs.InsertedCount, rs.UpdatedCount], MudBlazor.Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
            {
                _errorMessage = rs.Message;
            }
        }
        finally
        {
            _committing = false;
        }
    }

    void Cancel() => MudDialog.Cancel();
}
