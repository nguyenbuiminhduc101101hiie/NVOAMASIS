<MudDialog>
    <DialogContent>
        <MudSpacer></MudSpacer>
        <MudContainer>

            <MudCard>
                <MudForm Model="@_Request_pricing_details" @ref="@form">
                    <MudCardContent>
                        <MudGrid>

                            <MudItem xs="2">
                                <MudButton Style="background-color: #007BFF; color: white;" Size="Size.Small" Color="Color.Primary"
                                Disabled="@(Status == "edit")"
                                OnClick="() => Get_BGNHNo()">>>></MudButton>
                            </MudItem>

                            <MudItem xs="5">
                                <MudTextField @bind-Value="_Request_pricing_details.Pricingno" Disabled="true" Label="@Localizer["Request_Pricing_No"]" Class="custom-label" Required="true" />
                            </MudItem>

                        </MudGrid>

                        <MudGrid>

                            <MudItem xs="12">
                                <MudTextField @bind-Value="_Request_pricing_details.TenDuan" Label="@Localizer["tieudeemail"]" class="custom-label"  />
                            </MudItem>

                            <MudItem xs="6">
                                <MudTextField @bind-Value="_Request_pricing_details.MaDuan" Lines="3" Label="@Localizer["noidung"]" class="custom-label"  />
                            </MudItem>

                            <MudItem xs="6">
                                <MudTextField @bind-Value="_Request_pricing_details.NoiDung" Lines="3" Label="@Localizer["chitietnoidung"]" class="custom-label" />
                            </MudItem>

                            <MudItem xs="6">
                                <MudDatePicker Class="custom-label" @bind-Date="_Request_pricing_details.NgayKetThuc"
                                For="@(() => _Request_pricing_details.NgayKetThuc)"
                                Label="@Localizer["ngayketthuc"]"
                                DateFormat="dd/MM/yyyy"
                                Required="true" />
                            </MudItem>

                            <MudItem xs="6">
                                <MudAutocomplete Class="custom-label" T="string"
                                @bind-Value="_Request_pricing_details.POL"
                                Label="@Localizer["POL"]"
                                SearchFunc="SearchPorts"
                                Immediate="true"
                                CoerceText="true"
                                Clearable="true"
                                MaxItems="100">
                                </MudAutocomplete>
                            </MudItem>

                            <MudItem xs="6">
                                <MudAutocomplete Class="custom-label" T="string"
                                @bind-Value="_Request_pricing_details.POD"
                                Label="@Localizer["POD"]"
                                SearchFunc="SearchPorts"
                                Immediate="true"
                                CoerceText="true"
                                Clearable="true"
                                MaxItems="100">
                                </MudAutocomplete>
                            </MudItem>

                            <MudItem xs="6">
                                <MudSelect @bind-Value="_Request_pricing_details.loai" Label="@Localizer["Type"]" class="custom-label">
                                    <MudSelectItem Value="@("AI")">AI</MudSelectItem>
                                    <MudSelectItem Value="@("AE")">AE</MudSelectItem>
                                    <MudSelectItem Value="@("SI")">SI</MudSelectItem>
                                    <MudSelectItem Value="@("SE")">SE</MudSelectItem>
                                    <MudSelectItem Value="@("KTCL")">KTCL</MudSelectItem>
                                    <MudSelectItem Value="@("Truck")">Truck</MudSelectItem>
                                    <MudSelectItem Value="@("Customs")">Customs</MudSelectItem>
                                </MudSelect>
                            </MudItem>

                            <MudItem xs="6">
                                <MudSelect @bind-Value="_Request_pricing_details.TrangThai" Label="@Localizer["status"]" class="custom-label">
                                    @foreach (var item in trangthais)
                                    {
                                        <MudSelectItem Value="item">@item</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>

                            <MudItem xs="6">
                                <MudAutocomplete @bind-Value="_Request_pricing_details.LoaiHangHoa" Label="@Localizer["LoaiHangHoa"]" class="custom-label"
                                CoerceValue SearchFunc="SearchLoaiHangHoa" />
                            </MudItem>


                            <MudItem xs="2">
                                <MudAutocomplete Class="pl-4 labelCustomColor custom-label" T="string"
                                @bind-Value="UserHanding"
                                Label="@Localizer["User"]"
                                SearchFunc="Search_User"
                                Immediate="true"
                                CoerceText="true"
                                Clearable="true"
                                MaxItems="100">
                                </MudAutocomplete>
                            </MudItem>

                            <MudItem xs="1">
                                <MudButton Class="pl-4 labelCustomColor" Style="background-color: #007BFF; color: white;" Size="Size.Small" Color="Color.Primary" OnClick="() => Getuser(_Request_pricing_details)">>>></MudButton>
                            </MudItem>

                            <MudItem xs="5">
                                <MudTextField @bind-Value="_Request_pricing_details.EmailNguoiPhuTrach" class="custom-label" HelperTextOnFocus HelperText="từ 2 mail trở lên vui lòng ngăn cách bằng dấu ','"
                                Lines="3" AutoGrow Label="User Nhận Email" Required="false" />
                            </MudItem>

                            <MudItem xs="2">
                                <MudButton HtmlTag="label" Disabled="_processingUpload"
                                @onclick="@(() => SendMailnotify(_Request_pricing_details))"
                                Size="Size.Small" Color="Color.Tertiary" Variant="Variant.Filled"
                                StartIcon="@Icons.Material.Filled.Email">
                                    @if (_processingUpload)
                                    {
                                        <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                                        <MudText Class="ms-2">Processing</MudText>
                                    }
                                    else
                                    {
                                        <MudText>@Localizer["sendemail"]</MudText>
                                    }
                                </MudButton>
                            </MudItem>

                            <MudItem xs="2">
                                <MudButton HtmlTag="label" Disabled="_processingUploadzalo"
                                @onclick="@(() => SendZalonotify(_Request_pricing_details))"
                                Size="Size.Small" Color="Color.Tertiary" Variant="Variant.Filled"
                                StartIcon="@Icons.Material.Filled.Send">
                                    @if (_processingUploadzalo)
                                    {
                                        <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                                        <MudText Class="ms-2">Processing</MudText>
                                    }
                                    else
                                    {
                                        <MudText>@Localizer["sendzalo"]</MudText>
                                    }
                                </MudButton>
                            </MudItem>


                            <MudItem xs="6">
                                <MudNumericField @bind-Value="_Request_pricing_details.TrongLuong"
                                Label="@Localizer["TrongLuong"]" Format="#,##0.##" Culture="@_en" T="double?" HideSpinButtons="true"
                                Class="text-right custom-label " />
                            </MudItem>

                            <MudItem xs="6">
                                <MudTextField @bind-Value="_Request_pricing_details.Size" Label="@Localizer["Size"]" class="custom-label" />
                            </MudItem>

                            <MudItem xs="6">
                                <MudTextField @bind-Value="_Request_pricing_details.ThoiGianGiaoHang" Label="@Localizer["thoigiangiaohang"]" class="custom-label" />
                            </MudItem>

                            <MudItem xs="6">
                                <MudAutocomplete @bind-Value="_Request_pricing_details.PhuongThucVanChuyen" Label="@Localizer["Phuongthucvanchuyen"]" class="custom-label" CoerceValue SearchFunc="SearchPhuongthucvanchuyen" />
                            </MudItem>

                            <MudItem xs="6">
                                <MudAutocomplete @bind-Value="_Request_pricing_details.DichVuBoSung" Label="@Localizer["Dichvubosung"]" class="custom-label" CoerceValue SearchFunc="SearchDichvubosung" />
                            </MudItem>

                            <MudItem xs="12">
                                <MudContainer Class="pa-4; max-height:200px; overflow-y: auto; custom-label;">
                                    <MudText Typo="Typo.h6">@Localizer["hinhanhmota"]</MudText>
                                    @foreach (var item in Linksplit(_Request_pricing_details.Links!))
                                    {
                                        <MudPaper Elevation="3" Style="position: relative; display: inline-block;">
                                            <MudImage Src="@item.Replace("ftp","http")" Alt="@item.Replace("ftp","http")"
                                            Height="150" Elevation="25" Class="rounded-lg ma-4" />

                                            <MudIconButton Icon="@Icons.Material.Filled.Visibility" OnClick="@(() => SeeDetail(item))"
                                            Style="position: absolute; top: 5px; left: 5px; padding: 0; min-width: 0;" />

                                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error"
                                            OnClick="@(() => Deleteimg(_Request_pricing_details,item))"
                                            Style="position: absolute; top: 5px; right: 5px; padding: 0; min-width: 0;" />
                                        </MudPaper>
                                    }
                                </MudContainer>

                                <MudFileUpload T="IBrowserFile" Accept=".png,.jpg,.jpeg" FilesChanged="@((t) => AttachFileToFTP(t,_Request_pricing_details))">
                                    <ButtonTemplate Context="context1">
                                        <MudIconButton HtmlTag="label" for="@context1" Size="Size.Small" Color="Color.Secondary"
                                        Icon="@Icons.Material.Filled.AttachFile" />
                                    </ButtonTemplate>
                                </MudFileUpload>
                            </MudItem>

                        </MudGrid>




                    </MudCardContent>
                </MudForm>

            </MudCard>
        </MudContainer>
    </DialogContent>
    <DialogActions>

        <MudButton OnClick="@(async () => await Submit())">Save</MudButton>
        <MudButton OnClick="Cancel">Cancel</MudButton>

    </DialogActions>
</MudDialog>



@code {
    [CascadingParameter] MudDialogInstance? MudDialog { get; set; }
    [Parameter] public M_Duan _Request_pricing_details { get; set; }
    string UserHanding;
    [Parameter] public string Status { get; set; }
    MudForm form;
    List<PortModel> Ports = new List<PortModel>();
    List<string> trangthais = new List<string>();
    private List<Models.TrangThai> M_Trangthais = new List<Models.TrangThai>();
    private List<string> ListUser { get; set; } = new List<string>();
    public CultureInfo _en = CultureInfo.GetCultureInfo("en-US");
    List<M_Duan> Duans = new List<M_Duan>();

    protected async override Task OnInitializedAsync()
    {
        if (Status == "Duplicate")
        {
            _Request_pricing_details.Id = Guid.Empty;
            _Request_pricing_details.Pricingno = "";
            _Request_pricing_details.Approve = false;
            _Request_pricing_details.Continued = true;
        }
        ListUser = await asv.GetList_User_handle() ?? new List<string>();
        Duans = gsv.GetListDuanAll();
        M_Trangthais = await supsv.GetListTrangThai();
        var tts = await supsv.GetListTrangThai();
        trangthais = tts.Where(x => x.Tieude == "REQUESTPRICING").OrderBy(x => x.Noidung).Select(x => x.Noidung).ToList();
        Ports = await Bksv.GetList_PORT();
    }
    


    private async Task Submit()
    {
        await form.Validate();

        if (form.IsValid)
        {
           
            if (Status == "add")
            {

                _Request_pricing_details.Approve = false;
                _Request_pricing_details.Continued = true;
            }
            var UserName = asv.GetAuth().Result.User.Identity!.Name!;
            _Request_pricing_details.DateUpdate = DateTime.Now.ToString();
            _Request_pricing_details.UserUPdate = UserName;
            MudDialog!.Close(_Request_pricing_details);

            // var rs = await gsv.UpdateDuAnDetail(_Request_pricing_details);
            // if (!rs.Flag)
            // {
            //     CallSnackBar(rs.Message, MudBlazor.Severity.Error);
            //     return;
            // }
            // MudDialog.Close(DialogResult.Ok(_Request_pricing_details));
        }

    }
    void Cancel() => MudDialog.Cancel();

    void CallSnackBar(string message, MudBlazor.Severity severity)
    {

        Snackbar.Configuration.SnackbarVariant = Variant.Filled;
        Snackbar.Configuration.MaxDisplayedSnackbars = 3;
        Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopRight;
        Snackbar.Add(message, severity);
    }

    private async Task<IEnumerable<string>> SearchPorts(string text)
    {
        try
        {
            if (string.IsNullOrWhiteSpace(text))
            {
                return Ports
                    .Where(x => !string.IsNullOrEmpty(x.PORT))
                    .Select(x => x.PORT)
                    .Distinct();
            }

            return Ports
                .Where(x => !string.IsNullOrEmpty(x.PORT) &&
                            x.PORT.Contains(text, StringComparison.OrdinalIgnoreCase))
                .Select(x => x.PORT)
                .Distinct();
        }
        catch (Exception)
        {
            throw;
        }
    }

    private async Task Get_BGNHNo()
    {

        int formattedYear = DateTime.Now.Year;
        int formattedMonth = DateTime.Now.Month;

        string usr = asv.GetAuth().Result.User.Identity!.Name!;
        var refno = await supsv.GetRefNoByFunc("Pricing", formattedMonth, formattedYear, usr);

        var rs = asv.GetUserDetail();
        var cn = rs.Branch;
        var tiepdaungu = await supsv.GetTiepDauNguByFunc("Pricing");
        _Request_pricing_details.Pricingno = cn + tiepdaungu + formattedYear.ToString() + formattedMonth.ToString() + refno.Value.ToString("D4");
    }

    private async Task<IEnumerable<string>> Search_User(string value)
    {
        if (string.IsNullOrEmpty(value))
            return ListUser;

        return ListUser.Where(x => x.Contains(value, StringComparison.InvariantCultureIgnoreCase));
    }
    private async Task Getuser(M_Duan item)
    {
        if (string.IsNullOrEmpty(item.EmailNguoiPhuTrach))
        {
            item.EmailNguoiPhuTrach = UserHanding;
        }
        else
        {
            item.EmailNguoiPhuTrach += "," + UserHanding + ",";
        }
    }
    private bool _processingUpload = false;
    async Task SendMailnotify(M_Duan item)
    {
        try
        {
            string[] users = item.EmailNguoiPhuTrach.Split(',');
            List<string> emails = new List<string>(); // Danh sách động, có thể thêm thoải mái

            int index = 0;
            foreach (var user in users)
            {
                if (string.IsNullOrEmpty(user))
                {

                }
                else
                {
                    string inputemail = "";
                    inputemail = await gsv.GetEmailAsync(user);
                    if (!string.IsNullOrEmpty(inputemail))
                    {
                        emails.Add(inputemail);
                    }

                }
            }
            string[] emailarray = emails.ToArray();
            _processingUpload = true;
            await Task.Delay(1);
            StateHasChanged();
            if (emails != null && emailarray.Length > 0)
            {
                var rs = await gsv.GuiThongBaoProject(item, emailarray);
                if (rs.Flag == true)
                {
                    if (item.Id == Guid.Empty)
                    {
                        item.TrangThai = "Emailed";
                    }
                    else
                    {
                        item.TrangThai = "Emailed";
                        await gsv.UpdateDuAnDetail(item);
                        
                    }
                }
                CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);

            }
            else
            {

                CallSnackBar("Email is empty!", MudBlazor.Severity.Warning);
                return;
            }




        }
        catch (Exception ex)
        {
            CallSnackBar("Somethings went wrong!, error code: " + ex.Message, MudBlazor.Severity.Error);
        }
        finally
        {
            _processingUpload = false;
        }

    }
    private bool _processingUploadzalo = false;
    async Task SendZalonotify(M_Duan item)
    {
        try
        {
            _processingUploadzalo = true;
            await Task.Delay(1);
            StateHasChanged();

            if (string.IsNullOrEmpty(item.EmailNguoiPhuTrach))
            {
                CallSnackBar("User is empty!", MudBlazor.Severity.Warning);
                return;
            }

            string[] users = item.EmailNguoiPhuTrach.Split(',');
            List<string> zaloid = new List<string>(); // Danh sách động, có thể thêm thoải mái

            int index = 0;
            foreach (var user in users)
            {
                if (string.IsNullOrEmpty(user))
                {

                }
                else
                {


                    var userinfo = await asv.GetUserDetail_byname(user);
                    if (!string.IsNullOrEmpty(userinfo.Zaloid))
                    {
                        zaloid.Add(userinfo.Zaloid);
                    }

                }
            }

            foreach (var u in zaloid)
            {

                var rs = await gsv.SendMessageAsync(u, item.TenDuan, item.MaDuan, item.NoiDung);
                if (!rs.Flag)
                {
                    CallSnackBar(rs.Message, MudBlazor.Severity.Error);
                    return;
                }
            }
            CallSnackBar("✅ Send Success!", MudBlazor.Severity.Success);
        }
        catch (Exception ex)
        {
            CallSnackBar("Somethings went wrong!, error code: " + ex.Message, MudBlazor.Severity.Error);
        }
        finally
        {
            _processingUploadzalo = false;
        }

    }
    private async Task<IEnumerable<string?>> SearchLoaiHangHoa(string? text)
    {
        try
        {
            var items = Duans.Select(x => x.LoaiHangHoa).Distinct();
            if (string.IsNullOrEmpty(text))
            {
                return items;
            }
            // MBL.Porname = mst_Consignee;
            return items.Where(x => x != null && x.Equals(text));
        }
        catch (Exception)
        {
            throw;
        }
    }


    private async Task<IEnumerable<string?>> SearchPhuongthucvanchuyen(string? text)
    {
        try
        {
            var items = Duans.Select(x => x.PhuongThucVanChuyen).Distinct();
            if (string.IsNullOrEmpty(text))
            {
                return items;
            }
            // MBL.Porname = mst_Consignee;
            return items.Where(x => x != null && x.Equals(text));
        }
        catch (Exception)
        {
            throw;
        }
    }

    private async Task<IEnumerable<string?>> SearchDichvubosung(string? text)
    {
        try
        {
            var items = Duans.Select(x => x.DichVuBoSung).Distinct();
            if (string.IsNullOrEmpty(text))
            {
                return items;
            }
            // MBL.Porname = mst_Consignee;
            return items.Where(x => x != null && x.Equals(text));
        }
        catch (Exception)
        {
            throw;
        }
    }
    async Task AttachFileToFTP(IBrowserFile file, M_Duan item)
    {
        try
        {
            var rs = await ssv.UploadfiletoFTP(file, (object)item);
            CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
        }
        catch (Exception ex)
        {
            CallSnackBar("Throw exception code: " + ex.Message, MudBlazor.Severity.Error);
        }
    }
    async Task Deleteimg(M_Duan item, string link)
    {
        try
        {
            if (item.Links!.Contains(";"))
                link = link + ";";
            item.Links = item.Links!.Replace(link, string.Empty);
            //var rs = ssv.DeleteFileFromFTP(link);
            //CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
            StateHasChanged();
        }
        catch (Exception ex)
        {
            CallSnackBar("Throw exception code: " + ex.Message, MudBlazor.Severity.Error);
        }
    }
    async Task SeeDetail(string link)
    {

        await JSRuntime.InvokeVoidAsync("open", link.Replace("ftp", "http"), "_blank");
    }
    List<string> Linksplit(string links)
    {
        if (string.IsNullOrEmpty(links))
            return new List<string>();
        return links.Split(';').ToList();
    }
}
