    private async Task OpenEditDialog(M_Duan tr)
    {
        var optionsdialog = new DialogOptions { ClassBackground = "class-dialog-custom", FullWidth = true, MaxWidth = MaxWidth.Medium };
        if (tr == null)
        {
            CallSnackBar("Please select Data", MudBlazor.Severity.Warning);
            return;
        }
        if (tr.Approve == true)
        {
            CallSnackBar("Data đã được Approve!!! , vui lòng bỏ Approve", MudBlazor.Severity.Warning);
            return;
        }
        if (await ssv.CheckPermission(asv.GetAuth().Result.User.Identity.Name, "Edit", "Request_Pricing"))
        {

            DialogOptions closeOnEscapeKey = new DialogOptions() { CloseOnEscapeKey = true };
            var parameters = new DialogParameters<Add> { { x => x._Request_pricing_details, tr }, { x => x.Status, "edit" } };

            var dialog = await DialogService.ShowAsync<Add>(tr.Id == Guid.Empty ? "Request Pricing Edit" : "Request Pricing Edit", parameters, optionsdialog);
            var result = await dialog.Result;
            // Giữ nguyên dòng được chọn
            selectedRowNumber = selectedRowNumber;
            StateHasChanged();

            if (!result.Canceled)
            {
                var data = (M_Duan)result.Data;
                // var rs = await gsv.UpdateDuAnDetail(data);
                var rs = await gsv.UpdateCreateDuan(data);
                MudBlazor.Severity severity;
                if (rs[1] == "1")
                    severity = MudBlazor.Severity.Success;
                else
                    severity = MudBlazor.Severity.Error;

                CallSnackBar(rs[0], severity);
            }

            return;

        }
        else
        {
            CallSnackBar("You have not access to Edit", MudBlazor.Severity.Warning);
            return;
        }

    }

