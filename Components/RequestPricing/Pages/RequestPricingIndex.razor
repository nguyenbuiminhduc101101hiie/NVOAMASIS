@page "/RequestPricing"
@using System.Globalization
@attribute [Authorize]
@inject GlobalServices gsv
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject AccountService asv
@inject SharedServices ssv
@inject BookingService bksv 
@inject IJSRuntime JSRuntime
@inject SupportServices supsv
@inject IStringLocalizer<SharedResource> Localizer
<PageTitle>Project</PageTitle>
<MudText Class="pa-2" Typo="Typo.h6">@Localizer["Request_Pricing"]</MudText>
<MudStack Row Justify="Justify.FlexStart" Class="pa-4">
    <MudButton  HtmlTag="label"
                OnClick="Refresh"
                Size="Size.Small" Color="Color.Primary" Variant="   Variant.Filled"
                StartIcon="@Icons.Material.Filled.Refresh">
        @Localizer["reload"]
    </MudButton>
    <MudButton  HtmlTag="label"
               @onclick="@((e) => OpenCreateDialog(new Models.M_Duan()))"
                Size="Size.Small" Color="Color.Secondary" Variant="Variant.Filled"
                StartIcon="@Icons.Material.Filled.Add">
        @Localizer["new"]
    </MudButton>

    <MudButton HtmlTag="label"
               @onclick="@((e) => OpenEditDialog(detail))"
               Size="Size.Small" Color="Color.Secondary" Variant="Variant.Filled"
               StartIcon="@Icons.Material.Filled.Create">
        @Localizer["edit"]
    </MudButton>
    <MudButton HtmlTag="label"
               @onclick="@((e) => OpenDuplicateDialog(detail))"
               Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled"
               StartIcon="@Icons.Material.Filled.CopyAll">
        @Localizer["duplicate"]
    </MudButton>

</MudStack>

<MudDataGrid    T="M_Duan" Items="@Listdata" Filterable="true" @ref="mudTable" Class="pa-4" 
                FilterMode="@DataGridFilterMode.ColumnFilterRow" Dense="true" Virtualize="true" QuickFilter="@FilterFunc1"
             FixedHeader="true" FixedFooter="true" HeaderClass="no-wrap" FooterClass="no-wrap" Bordered="true"
                ReadOnly="false" CommittedItemChanges="@CommittedItem" RowClassFunc="@SelectedRowClassFunc"
             RowClick="@RowClicked" EditDialogOptions="@options" Striped="true" Hover="true"
             ColumnResizeMode="@(_resizeColumn ? ResizeMode.Column : ResizeMode.Container)" Loading="_loading">
    <Columns>
        <HierarchyColumn T="M_Duan" />
        <TemplateColumn CellClass="d-flex justify-end">
            <CellTemplate>
               

                <MudIconButton Icon="@Icons.Material.Outlined.Delete" OnClick="@(()=>DeleteItem(context.Item))" />
            </CellTemplate>
        </TemplateColumn>



      @*   <PropertyColumn Property="x=> Listdata.IndexOf(x)+1" Title="No." IsEditable="false" Required="false" Filterable="false" CellStyleFunc="_cellStyleFunc" /> *@
        <PropertyColumn Property="x=>x.Pricingno" Title="@Localizer["Request_Pricing_No"]" Required="false" CellStyleFunc="_cellStyleFunc">
            <EditTemplate>
                <MudStack Row>
                    <MudItem>
                        <MudButton Class="pl-4 pa-10" Style="background-color: #007BFF; color: white;" Size="Size.Small" Color="Color.Primary" OnClick="() => GetT_PricingNo(context.Item)">>>></MudButton>
                    </MudItem>

                    <MudTextField @bind-Value="context.Item.Pricingno" Label="@Localizer["Request_Pricing_No"]" class="custom-label" Required="true" />

                </MudStack>
            </EditTemplate>
        </PropertyColumn>
            <PropertyColumn Property="x=>x.TenDuan" Title="@Localizer["tieudeemail"]" Required="false" CellStyleFunc="_cellStyleFunc">
            <FilterTemplate>
                <MudTextField @bind-Value="search" HelperText="@Localizer["tieudeemail"]" class="custom-label" />
            </FilterTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x=>x.MaDuan" Title="@Localizer["noidung"]" Required="false" CellStyleFunc="_cellStyleFunc">
            <EditTemplate>
                <MudTextField @bind-Value="context.Item.MaDuan" Lines="3" AutoGrow Label="@Localizer["noidung"]" class="custom-label" Required="false" />
            </EditTemplate>
        </PropertyColumn>

        <PropertyColumn Property="x=>x.NoiDung" Title="@Localizer["chitietnoidung"]" Required="false" CellClass="no-wrap-cell" CellStyleFunc="_cellStyleFunc">
            <EditTemplate>
                <MudTextField @bind-Value="context.Item.NoiDung" Lines="3" AutoGrow Label="@Localizer["chitietnoidung"]" class="custom-label" Required="false" />
            </EditTemplate>
        </PropertyColumn>

        <PropertyColumn Property="x=>x.NgayKetThuc" Title="@Localizer["ngayketthuc"]" Required="false" Format="dd/MM/yyyy" CellStyleFunc="_cellStyleFunc">
            <EditTemplate>
                <MudDatePicker @bind-Date="context.Item.NgayKetThuc" Label="@Localizer["ngayketthuc"]" class="custom-label" Required="false" />
            </EditTemplate>
        </PropertyColumn>

        <PropertyColumn Property="x => x.POL" Title="@Localizer["POL"]" Required="false" CellStyleFunc="_cellStyleFunc">
            <EditTemplate>
                <!-- Ô tìm kiếm khách hàng -->
                <MudTextField @bind-Value="searchText_pol" Label="@Localizer["Search_POL"]"
                              Placeholder="search POL"
                              Adornment="Adornment.Start" AdornmentIcon="Icons.Material.Filled.Search" class="custom-label"
                              TextChanged="FilterPorts_pol" Immediate="true" />

                <!-- Danh sách khách hàng -->
                <MudSelect @bind-Value="context.Item.POL" Label="@Localizer["POL"]" class="custom-label">
                    @foreach (var item in filteredPorts.Take(50))
                    {
                        <MudSelectItem Value="item.PORT">@item.PORT </MudSelectItem>
                    }
                </MudSelect>
            </EditTemplate>
        </PropertyColumn>

        <PropertyColumn Property="x => x.POD" Title="@Localizer["POD"]" Required="false" CellStyleFunc="_cellStyleFunc">
            <EditTemplate>
                <!-- Ô tìm kiếm khách hàng -->
                <MudTextField @bind-Value="searchText_pod" Label="@Localizer["Search_POD"]" class="custom-label"
                Placeholder="search POD"
                Adornment="Adornment.Start" AdornmentIcon="Icons.Material.Filled.Search"
                TextChanged="FilterPorts_pod" Immediate="true" />

                <!-- Danh sách khách hàng -->
                <MudSelect @bind-Value="context.Item.POD" Label="@Localizer["POD"]" class="custom-label">
                    @foreach (var item in filteredPorts_pod.Take(50))
                    {
                        <MudSelectItem Value="item.PORT">@item.PORT </MudSelectItem>
                    }
                </MudSelect>
            </EditTemplate>
        </PropertyColumn>

        <PropertyColumn Property="x => x.loai" Title="@Localizer["Type"]" Required="true" CellStyleFunc="_cellStyleFunc">
            <EditTemplate>
                <MudSelect @bind-Value="context.Item.loai" Label="@Localizer["Type"]" class="custom-label">
                    <MudSelectItem Value="@("AI")">AI</MudSelectItem>
                    <MudSelectItem Value="@("AE")">AE</MudSelectItem>
                    <MudSelectItem Value="@("SI")">SI</MudSelectItem>
                    <MudSelectItem Value="@("SE")">SE</MudSelectItem>
                    <MudSelectItem Value="@("KTCL")">KTCL</MudSelectItem>
                    <MudSelectItem Value="@("Truck")">Truck</MudSelectItem>
                    <MudSelectItem Value="@("Customs")">Customs</MudSelectItem>
                </MudSelect>
            </EditTemplate>
        </PropertyColumn>

        <PropertyColumn Property="x=>x.TrangThai" Title="@Localizer["status"]" Required="false" CellStyleFunc="_cellStyleFunc">
            <EditTemplate>
                <MudSelect @bind-Value="context.Item.TrangThai" Label="@Localizer["status"]" class="custom-label">
                    @foreach (var item in trangthais)
                    {
                        <MudSelectItem Value="item">@item</MudSelectItem>
                    }
                </MudSelect>
            </EditTemplate>
        </PropertyColumn>

        <PropertyColumn Property="x=>x.EmailNguoiPhuTrach" Title="@Localizer["emailnguoiphutrach"]" Required="false" CellStyleFunc="_cellStyleFunc">
            <EditTemplate>
                <MudStack Row>
                    <MudItem>
                        <MudAutocomplete Class="pl-4 labelCustomColor custom-label" T="string"
                        @bind-Value="UserHanding"
                                         Label="@Localizer["User"]"
                        SearchFunc="Search_User"
                        Immediate="true"
                        CoerceText="true"
                        Clearable="true"
                        MaxItems="100">
                        </MudAutocomplete>
                    </MudItem>

                    <MudItem>
                        <MudButton Class="pl-4 labelCustomColor" Style="background-color: #007BFF; color: white;" Size="Size.Small" Color="Color.Primary" OnClick="() => Getuser(context.Item)">>>></MudButton>
                    </MudItem>

                    <MudTextField @bind-Value="context.Item.EmailNguoiPhuTrach" class="custom-label" HelperTextOnFocus HelperText="từ 2 mail trở lên vui lòng ngăn cách bằng dấu ','"
                    Lines="3" AutoGrow Label="User Nhận Email" Required="false" />

                    <MudButton HtmlTag="label" Disabled="_processingUpload"
                    @onclick="@(() => SendMailnotify(context.Item))" 
                    Size="Size.Small" Color="Color.Tertiary" Variant="Variant.Filled"
                    StartIcon="@Icons.Material.Filled.Email">
                        @if (_processingUpload)
                        {
                            <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                            <MudText Class="ms-2">Processing</MudText>
                        }
                        else
                        {
                            <MudText>@Localizer["sendemail"]</MudText>
                        }
                    </MudButton>

                    <MudButton HtmlTag="label" Disabled="_processingUploadzalo"
                    @onclick="@(() => SendZalonotify(context.Item))"
                    Size="Size.Small" Color="Color.Tertiary" Variant="Variant.Filled"
                    StartIcon="@Icons.Material.Filled.Send">
                        @if (_processingUploadzalo)
                        {
                            <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                            <MudText Class="ms-2">Processing</MudText>
                        }
                        else
                        {
                            <MudText>@Localizer["sendzalo"]</MudText>
                        }
                    </MudButton>
                </MudStack>
            </EditTemplate>
        </PropertyColumn>

        <PropertyColumn Property="x => x.LoaiHangHoa" Title="@Localizer["LoaiHangHoa"]" Required="false" CellStyleFunc="_cellStyleFunc">
            <EditTemplate>
                <MudAutocomplete @bind-Value="context.Item.LoaiHangHoa" Label="@Localizer["LoaiHangHoa"]" class="custom-label" CoerceValue SearchFunc="SearchLoaiHangHoa" />
            </EditTemplate>
        </PropertyColumn>

        <PropertyColumn Property="x => x.TrongLuong" Title="@Localizer["trongluong"]" Format="#,##0" Required="false" CellStyleFunc="_cellStyleFunc">
            <EditTemplate>
                <MudNumericField @bind-Value="context.Item.TrongLuong" 
                                 Label="@Localizer["trongluong"]" Format="#,##0.##" Culture="@_en" T="double?" HideSpinButtons ="true"
                                 Class="text-right-input custom-label" />
                                
            </EditTemplate>
        </PropertyColumn>

     
                <PropertyColumn Property="x => x.Size" Title="@Localizer["Size"]" Required="false" CellStyleFunc="_cellStyleFunc">
            <EditTemplate>
                <MudAutocomplete @bind-Value="context.Item.Size" Label="@Localizer["Size"]" class="custom-label"   />
            </EditTemplate>
        </PropertyColumn>

        <PropertyColumn Property="x=>x.ThoiGianGiaoHang" Title="@Localizer["thoigiangiaohang"]"  Required="false" CellStyleFunc="_cellStyleFunc">
            <EditTemplate>
                <MudTextField @bind-Value="context.Item.ThoiGianGiaoHang" Label="@Localizer["thoigiangiaohang"]"  class="custom-label" />
            </EditTemplate>
        </PropertyColumn>

        <PropertyColumn Property="x => x.PhuongThucVanChuyen" Title="@Localizer["Phuongthucvanchuyen"]" Required="false" CellStyleFunc="_cellStyleFunc">
            <EditTemplate>
                <MudAutocomplete @bind-Value="context.Item.PhuongThucVanChuyen" Label="@Localizer["Phuongthucvanchuyen"]" class="custom-label"  CoerceValue SearchFunc="SearchPhuongthucvanchuyen" />
            </EditTemplate>
        </PropertyColumn>

        <PropertyColumn Property="x => x.DichVuBoSung" Title="@Localizer["Dichvubosung"]" Required="false"  CellStyleFunc="_cellStyleFunc">
            <EditTemplate>
                <MudAutocomplete @bind-Value="context.Item.DichVuBoSung" Label="@Localizer["Dichvubosung"]" class="custom-label" CoerceValue SearchFunc="SearchDichvubosung" />
            </EditTemplate>
        </PropertyColumn>
        <TemplateColumn Title="@Localizer["Approve"]">
            <CellTemplate>
                <MudCheckBox @bind-Checked="context.Item.Approve" @bind-Value="context.Item.Approve" @bind-Value:after="@(()=> OnApproveCheckboxWrapper(context.Item))">
                </MudCheckBox>
            </CellTemplate>
        </TemplateColumn>
        <PropertyColumn Property="x=>x.UserUPdate" Title="@Localizer["UserUpdate"]" Required="false" IsEditable="false" CellStyleFunc="_cellStyleFunc" />
        <PropertyColumn Property="x=>x.DateUpdate" Title="@Localizer["Dateupdate"]" Required="false" IsEditable="false" CellStyleFunc="_cellStyleFunc" />

        <PropertyColumn Property="x=>x.Links" Title="@Localizer["Linkhinhanh"]" Required="false" CellStyleFunc="_cellStyleFunc" CellClass="no-wrap-cell">
            <EditTemplate>
                <MudStack Row>
                    <MudContainer Class="pa-4; max-height:200px; overflow-y: auto; custom-label;">
                        <MudText Typo="Typo.h6">@Localizer["hinhanhmota"]</MudText>
                        @foreach (var item in Linksplit(context.Item.Links!))
                        {
                            <MudPaper Elevation="3" Style="position: relative; display: inline-block;">
                                <MudImage Src="@item.Replace("ftp","http")" Alt="@item.Replace("ftp","http")"
                                Height="150" Elevation="25" Class="rounded-lg ma-4" />

                                <MudIconButton Icon="@Icons.Material.Filled.Visibility" OnClick="@(() => SeeDetail(item))"
                                Style="position: absolute; top: 5px; left: 5px; padding: 0; min-width: 0;" />

                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error"
                                OnClick="@(() => Deleteimg(context.Item,item))"
                                Style="position: absolute; top: 5px; right: 5px; padding: 0; min-width: 0;" />
                            </MudPaper>
                        }
                    </MudContainer>

                    <MudFileUpload T="IBrowserFile" Accept=".png,.jpg,.jpeg" FilesChanged="@((t) => AttachFileToFTP(t,context.Item))">
                        <ButtonTemplate Context="context1">
                            <MudIconButton HtmlTag="label" for="@context1" Size="Size.Small" Color="Color.Secondary"
                            Icon="@Icons.Material.Filled.AttachFile" />
                        </ButtonTemplate>
                    </MudFileUpload>

                </MudStack>
            </EditTemplate>
        </PropertyColumn>

    </Columns>

    <ChildRowContent>
        <MudTabs>
            <MudTabPanel Text="Product Price Detail">
                <PricingDetails _Product_price_details="context.Item" />
         
            </MudTabPanel>
        </MudTabs>
    </ChildRowContent>

    <PagerContent>
        <MudDataGridPager T="Models.M_Duan" PageSizeOptions="@(new int[] { 8, 10, 20 })" />
    </PagerContent>

</MudDataGrid>

@code {
    List<M_Duan> Listdata = new List<M_Duan>();
    MudDataGrid<M_Duan> mudTable;
    AuthUser user;
    string mailtp, mailpp;
    string usr;
    private List<string> ListUser { get; set; } = new List<string>();
    string UserHanding;
    List<string> trangthais = new List<string>();
    private List<Models.TrangThai> M_Trangthais = new List<Models.TrangThai>();
    private string searchText_pol = "";
    private string searchText_pod = "";
    private List<PortModel> filteredPorts = new List<PortModel>();
    private List<PortModel> filteredPorts_pod = new List<PortModel>();
    private List<PortModel> Ports = new List<PortModel>();
    private bool _resizeColumn;
    List<M_Duan> Duans = new List<M_Duan>();
    public CultureInfo _en = CultureInfo.GetCultureInfo("en-US");
      bool _loading = false;

    protected async override Task OnInitializedAsync()
    {
        Duans = gsv.GetListDuanAll();
        Ports = await bksv.GetList_PORT();
        M_Trangthais = await supsv.GetListTrangThai();
        var tts = await supsv.GetListTrangThai();
        trangthais = tts.Where(x => x.Tieude == "REQUESTPRICING").OrderBy(x => x.Noidung).Select(x => x.Noidung).ToList();
        // user = await asv.GetUserAsync();
        ListUser = await asv.GetList_User_handle() ?? new List<string>();
        usr = asv.GetAuth().Result.User.Identity!.Name!;
        // await Refresh();
    }
    M_Duan detail;
 
    async Task Refresh()
    {
        Duans = gsv.GetListDuanAll();
        try
        {
            detail = null!;
            _loading = true;
            Listdata.Clear();
     
            await Task.Delay(500);
            if (!await ssv.CheckPermission(usr, "View", "Request_Pricing"))
            {
                CallSnackBar("You have not access to view", MudBlazor.Severity.Warning);
                return;
            }
            Listdata = await gsv.GetListDuAn_request();
               StateHasChanged();
        }
        catch(Exception ex)
        {
            CallSnackBar("Something went wrong!, error code: " + ex.Message, MudBlazor.Severity.Warning);
        }
        finally
        {
            _loading = false;
        }

    }

    void CallSnackBar(string message, MudBlazor.Severity severity)
    {
        
        Snackbar.Configuration.SnackbarVariant = Variant.Filled;
        Snackbar.Configuration.MaxDisplayedSnackbars = 3;
        Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopRight;
        Snackbar.Add(message, severity);
    }
    void RowClicked(DataGridRowClickEventArgs<M_Duan> args)
    {
        detail = args.Item;
    }
    private int selectedRowNumber = -1;
    private string SelectedRowClassFunc(M_Duan m, int rowNumber)
    {
        if (selectedRowNumber == rowNumber)
        {
            selectedRowNumber = -1;
            return string.Empty;
        }
        else if (mudTable.SelectedItem != null && mudTable.SelectedItem.Equals(m))
        {
            selectedRowNumber = rowNumber;
            return "selected";
        }
        else
        {
            return string.Empty;
        }
    }

    async Task CommittedItem(M_Duan item)
    {
        item.UserUPdate = asv.GetAuth().Result.User.Identity!.Name!;
        item.DateUpdate = DateTime.Now.ToString("dd/MMM/yyyy");
        var rs = item.Id != Guid.Empty ? await gsv.UpdateDuAnDetail(item) : await gsv.CreateDuAnDetail(item);
        CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);

        await Refresh();
    }
    async Task AddItem()
    {
        if (!await ssv.CheckPermission(usr, "Add", "Request_Pricing"))
        {
            CallSnackBar("You have not access to Add", MudBlazor.Severity.Warning);
            return;
        }
        var item = new M_Duan
        {
            Approve = false,
            Editable= false,
            Continued = true
        };
        item.UserUPdate = asv.GetAuth().Result.User.Identity!.Name!;
        item.DateUpdate = DateTime.Now.ToString("dd/MMM/yyyy");
        Listdata.Add(item);
        await mudTable.SetEditingItemAsync(Listdata.LastOrDefault()!);
    }
    async Task DeleteItem(M_Duan item)
    {
        if (item.Approve == true)
        {
            CallSnackBar("Request Pricing đã được Approve!!! , vui lòng bỏ Approve", MudBlazor.Severity.Warning);
            return;
        }
        if (!await ssv.CheckPermission(usr, "Delete", "Request_Pricing"))
        {
            CallSnackBar("You have not access to Delete", MudBlazor.Severity.Warning);
            return;
        }
        var resultMess = await DialogService.ShowMessageBox(
                "Warning",
                "Deleting can not be undone!",
                yesText: "Delete!", cancelText: "Cancel");

        if (resultMess.HasValue)
        {
            var rs = await gsv.DeleteDuAnDetail(item);
            CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
            await Refresh();
        }

    }
    DialogOptions options = new DialogOptions 
    {
        ClassBackground = "class-dialog-custom",
        FullWidth = true,
        MaxWidth = MaxWidth.Medium,
        CloseOnEscapeKey = false,
        DisableBackdropClick = true
    };
    string search;

    private bool FilterFunc1(M_Duan sbd) => FilterFunc(sbd, search);

    private bool FilterFunc(M_Duan sbd, string searchString)
    {
        if (string.IsNullOrWhiteSpace(sbd.TenDuan))
            return true;
        if (string.IsNullOrWhiteSpace(searchString))
            return true;
        if (sbd.TenDuan!.Contains(searchString, StringComparison.OrdinalIgnoreCase))
            return true;
        if ($"{sbd.TenDuan} ".Contains(searchString))
            return true;
        return false;
    }

    private Func<M_Duan, string> _cellStyleFunc => x =>
      {
          string style = "";

          if (string.IsNullOrEmpty(x.TrangThai))
              return "color: #000000";

          var rs = M_Trangthais
          .Where(t => (t.Noidung).Contains(x.TrangThai, StringComparison.InvariantCultureIgnoreCase)
              && t.Tieude.Equals("REQUESTPRICING", StringComparison.InvariantCultureIgnoreCase))
          .Select(t => t.Mamau)
          .FirstOrDefault();
          return "color: " + rs;


      };

    async Task AttachFileToFTP(IBrowserFile file, M_Duan item)
    {
        try
        {
            var rs = await ssv.UploadfiletoFTP(file, (object)item);
            CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
        }
        catch(Exception ex)
        {
            CallSnackBar("Throw exception code: " + ex.Message, MudBlazor.Severity.Error);
        }
    }

    async Task Deleteimg(M_Duan item ,string link)
    {
        try
        {
            if (item.Links!.Contains(";"))
                link = link + ";";
            item.Links = item.Links!.Replace(link, string.Empty);
            //var rs = ssv.DeleteFileFromFTP(link);
            //CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
            StateHasChanged();
        }
        catch(Exception ex)
        {
            CallSnackBar("Throw exception code: " + ex.Message, MudBlazor.Severity.Error);
        }
    }
    async Task SeeDetail(string link)
    {

        await JSRuntime.InvokeVoidAsync("open", link.Replace("ftp", "http"), "_blank");
    }
    List<string>Linksplit(string links)
    {
        if (string.IsNullOrEmpty(links))
            return new List<string>();
        return links.Split(';').ToList(); 
    }
    private bool _processingUpload = false;
    async Task SendMailnotify(M_Duan item)
    {
        try
        {
            string[] users = item.EmailNguoiPhuTrach.Split(',');
            List<string> emails = new List<string>(); // Danh sách động, có thể thêm thoải mái

            int index = 0;
            foreach (var user in users)
            {
                if(string.IsNullOrEmpty(user)){

                }else{
                    string inputemail ="";
                    inputemail = await gsv.GetEmailAsync(user);
                    if (!string.IsNullOrEmpty(inputemail))
                    {
                        emails.Add(inputemail);
                    }

                }
            }
            string[] emailarray = emails.ToArray();
            _processingUpload = true;
            await Task.Delay(1);
            StateHasChanged();
            if (emails != null && emailarray.Length > 0)
            {
                var rs = await gsv.GuiThongBaoProject(item, emailarray);
                if(rs.Flag == true){
                    if (item.Id == Guid.Empty)
                    {
                        item.TrangThai = "Emailed";
                    }else{
                        item.TrangThai = "Emailed";
                        await gsv.UpdateDuAnDetail(item);
                        await Refresh();
                    }
                }
                CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);

            }else{

                CallSnackBar("Email is empty!", MudBlazor.Severity.Warning);
                return;
            }

 


        }
        catch (Exception ex)
        {
            CallSnackBar("Somethings went wrong!, error code: " + ex.Message, MudBlazor.Severity.Error);
        }
        finally
        {
            _processingUpload = false;
        }

    }

    private async Task<IEnumerable<string>> Search_User(string value)
    {
        if (string.IsNullOrEmpty(value))
            return ListUser;

        return ListUser.Where(x => x.Contains(value, StringComparison.InvariantCultureIgnoreCase));
    }

    private async Task Getuser(M_Duan item)
    {
        if (string.IsNullOrEmpty(item.EmailNguoiPhuTrach))
        {
            item.EmailNguoiPhuTrach = UserHanding;
        }
        else
        {
            item.EmailNguoiPhuTrach += "," + UserHanding + ",";
        }
    }

    private async Task GetT_PricingNo(M_Duan item)
    {

        int formattedYear = DateTime.Now.Year;
        int formattedMonth = DateTime.Now.Month;

        string usr = asv.GetAuth().Result.User.Identity!.Name!;
        var refno = await supsv.GetRefNoByFunc("Pricing", formattedMonth, formattedYear, usr);
        var tiepdaungu = await supsv.GetTiepDauNguByFunc("Pricing");
        var rs = asv.GetUserDetail();
        var cn = rs.Branch;
        item.Pricingno = cn + tiepdaungu + formattedYear.ToString() + formattedMonth.ToString() + refno.Value.ToString("D4");

    }

  
    private async Task FilterPorts_pol()
    {

        // searchText = text;
        if (string.IsNullOrWhiteSpace(searchText_pol))
        {
            filteredPorts = Ports;
        }
        else
        {
            filteredPorts = Ports
            .Where(x => x.PORT != null &&
                        x.PORT.StartsWith(searchText_pol, StringComparison.OrdinalIgnoreCase) &&
                        x.PORT.Contains(searchText_pol, StringComparison.OrdinalIgnoreCase))
            .OrderBy(x => x.PORT)
            .ToList();
        }

        await InvokeAsync(StateHasChanged); // Cập nhật giao diện
    }

