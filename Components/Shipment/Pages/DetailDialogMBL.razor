<MudDialog>
    <DialogContent>
        <IndexMBL JobDetail="Jobdetail" Customers="Customers" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(()=> MudDialog!.Cancel())">Close</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter] public M_Job? Jobdetail { get; set; } = default!;
    [CascadingParameter] MudDialogInstance? MudDialog { get; set; }
    [Parameter] public List<M_Customer>? Customers { get; set; } = default!;
}
