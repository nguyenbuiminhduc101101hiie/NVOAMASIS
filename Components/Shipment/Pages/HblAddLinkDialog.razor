@inject IStringLocalizer<SharedResource> Localizer

<MudDialog>
    <DialogContent>
        <MudStack Spacing="2">
            <MudTextField @bind-Value="_link"
                          Label="URL / đường dẫn"
                          Variant="Variant.Outlined"
                          Required="true"
                          Immediate="true"
                          HelperText="VD: https://... hoặc đường dẫn nội bộ" />
            <MudTextField @bind-Value="_title"
                          Label="Title (hiển thị)"
                          Variant="Variant.Outlined"
                          Immediate="true"
                          HelperText="Để trống = dùng URL" />
            <MudTextField @bind-Value="_note"
                          Label="Note"
                          Variant="Variant.Outlined"
                          Immediate="true" />
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@Localizer["cancel"]</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit" Disabled="@string.IsNullOrWhiteSpace(_link)">
            OK
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private MudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public string DefaultTitle { get; set; } = "";

    private string _link = "";
    private string _title = "";
    private string _note = "";

    protected override void OnInitialized()
    {
        _title = DefaultTitle ?? "";
    }

    public sealed class Result
    {
        public string Link { get; set; } = "";
        public string Title { get; set; } = "";
        public string Note { get; set; } = "";
    }

    private void Cancel() => MudDialog.Cancel();

    private void Submit()
    {
        if (string.IsNullOrWhiteSpace(_link))
            return;
        MudDialog.Close(DialogResult.Ok(new Result
        {
            Link = _link.Trim(),
            Title = _title?.Trim() ?? "",
            Note = _note?.Trim() ?? ""
        }));
    }
}
