<MudDialog>
    <DialogContent>
        <MudTextField Value="Content" Lines="4" AutoGrow Variant="Variant.Text" ReadOnly/>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(()=> Dialog.Close())">OK</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter] public string Content { get; set; }
    [CascadingParameter] public MudDialogInstance Dialog { get; set; }
}
