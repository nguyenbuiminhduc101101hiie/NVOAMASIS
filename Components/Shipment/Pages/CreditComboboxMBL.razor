<MudDialog>
    <DialogContent>
        <MudSelect @bind-Value="CreditSelected" Label="Select Credit">
            @foreach (var item in Listcmb)
            {
                <MudSelectItem Value="@item">@GetCreditLabel(item)</MudSelectItem>
            }
        </MudSelect>
        <MudSelect @bind-Value="currency" Label="CURRENCY">
            <MudSelectItem Value="@("VND")">VND</MudSelectItem>
            <MudSelectItem Value="@("USD")">USD</MudSelectItem>
        </MudSelect>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(()=> Muddialog.Cancel())">Close</MudButton>
        <MudButton OnClick="@(()=> Muddialog.Close(DialogResult.Ok((CreditSelected, currency))))"
                   Color="Color.Primary" Disabled="CreditSelected == null">
            Ok
        </MudButton>
    </DialogActions>
</MudDialog>
@inject ShipmentService ssv
@code {
    [CascadingParameter] public MudDialogInstance Muddialog { get; set; } = default!;
    [Parameter] public M_MBL mbldetail { get; set; } = default!;
    List<M_Credit> Listcmb = new();
    M_Credit CreditSelected = new();
    string currency = "VND";
    protected async override Task OnInitializedAsync()
    {
        var list = await ssv.GetListCreditMBL(mbldetail.MblID);
        if (list.Count > 0)
        {
            Listcmb = list.Where(x => !x.approve.HasValue || !x.approve.Value).DistinctBy(x => x.sodntt ?? x.creditid.ToString()).ToList();
            CreditSelected = Listcmb.FirstOrDefault() ?? new M_Credit();
            if (!string.IsNullOrWhiteSpace(CreditSelected.tiente))
                currency = CreditSelected.tiente!;
        }
    }

    private static string GetCreditLabel(M_Credit credit)
    {
        return string.IsNullOrWhiteSpace(credit.sodntt)
            ? credit.creditid.ToString()
            : credit.sodntt!;
    }
}
