    private async Task OnContainerNoBlurAsync(M_Container item)
    {
        if (string.IsNullOrWhiteSpace(item?.CONTAINER_NO))
            return;

        var containerNo = item.CONTAINER_NO.Trim();
        item.CONTAINER_NO = containerNo;

        var result = shipsv.CheckContainerNumber(containerNo);
        if (result == "Container Number is OK!")
            CallSnackBar(result, MudBlazor.Severity.Success);
        else
            CallSnackBar(result, MudBlazor.Severity.Warning);

        var lookup = await depotLookup.FindLatestDepotAsync(containerNo);
        if (lookup is null || !lookup.Found)
            return;

        var inDepot = ContainerDepotLookupService.ResolveTerminalName(lookup.Depot, Terminals) ?? lookup.Depot;
        item.In_Depot = inDepot;
        CallSnackBar($"Đã gán In Depot: {inDepot} (từ {lookup.SourceTable}).", MudBlazor.Severity.Info);
        await InvokeAsync(StateHasChanged);
    }
