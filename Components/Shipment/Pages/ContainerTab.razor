    private async Task<IEnumerable<string?>> SearchTerminal(string? text)
    {
        await Task.CompletedTask;
        if (string.IsNullOrWhiteSpace(text))
            return Array.Empty<string>();
        var filtered = Terminals
            .Where(t => !string.IsNullOrEmpty(t.TermiNalName))
            .Where(t =>
                (t.TermiNalName?.Contains(text, StringComparison.OrdinalIgnoreCase) == true) ||
                (t.Code?.Contains(text, StringComparison.OrdinalIgnoreCase) == true));
        return filtered.Select(t => t.TermiNalName).Distinct();
    }

    private async Task<IEnumerable<string?>> SearchPorts(string? text)
    {
        await Task.CompletedTask;
        if (Ports == null || Ports.Count == 0)
            return Array.Empty<string?>();

        if (string.IsNullOrWhiteSpace(text))
            return Array.Empty<string?>();

        var filtered = Ports
            .Where(p => !string.IsNullOrWhiteSpace(p.PORT))
            .Where(p =>
                (p.PORT?.Contains(text, StringComparison.OrdinalIgnoreCase) == true) ||
                (p.PORT_CODE?.Contains(text, StringComparison.OrdinalIgnoreCase) == true));

        return filtered.Select(p => p.PORT).Distinct();
    }
    async Task UpdatebyCheckboxClick(M_Container item)
    {
        if (!await ssv.CheckPermission(usr, "Approve", "MBL"))
        {
            CallSnackBar("You have not access to Approve", MudBlazor.Severity.Warning);
            return;
        }
        item.UPDATETIME = DateTime.Now;
        item.USERID = usr;
        var rs = await shipsv.UpdateContainerMBL_Approve(item);
        if (!rs.Flag) CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
    }
    async Task TryStartEditing(M_Container item)
    {
        if (item.APPROVE.HasValue && item.APPROVE.Value)
        {
            CallSnackBar("This Container is approved!", MudBlazor.Severity.Warning);
            return;
        }

        detail_cont = JsonSerializer.Deserialize<M_Container>(JsonSerializer.Serialize(item));
        await mudTable.SetEditingItemAsync(item);
    }
