@inject CustomerService csv
@inject SupportServices supsv
@inject SharedServices ssv
@inject AccountService asv
@inject GlobalServices gsv
@inject BookingService bksv

@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject ShipmentService shipsv
@inject ContainerDepotLookupService depotLookup
@inject IStringLocalizer<SharedResource> Localizer
@inject HistoryLogService HistoryLogService
@using System.Text.Json;

<style>
    .container-tab-shell {
        padding: 12px 14px;
        border: 1px solid #e0e3eb;
        border-radius: 14px;
        background: #ffffff;
        min-width: 1320px;
    }

    .container-tab-header {
        padding: 2px 4px 12px 4px;
        border-bottom: 1px solid #e5e7eb;
        margin-bottom: 10px;
    }

    .container-title {
        font-weight: 700;
        color: #118AB2;
        letter-spacing: .2px;
    }

    .container-subtitle {
        color: #6b7280;
        font-size: 12px;
    }

    .container-parent-badge {
        padding: 5px 10px;
        border-radius: 999px;
        background: #f2f8fb;
        border: 1px solid #d6edf5;
        color: #0f6f8f;
        font-size: 12px;
        font-weight: 700;
        white-space: nowrap;
    }

    .container-toolbar {
        gap: 6px;
        align-items: center;
        flex-wrap: wrap;
        justify-content: flex-start;
    }

    .container-grid-scroll {
        width: 100%;
        overflow-x: auto;
        padding-bottom: 4px;
    }

    .container-grid {
        min-width: 1580px;
        border-radius: 10px;
        overflow: hidden;
    }

        .container-grid .mud-table-cell {
            padding: 5px 9px !important;
            font-size: 13px !important;
            height: 34px !important;
            white-space: nowrap;
            vertical-align: middle;
        }

        .container-grid .mud-table-head .mud-table-cell {
            padding: 7px 9px !important;
            font-size: 12.5px !important;
            font-weight: 700 !important;
        }

        .container-grid .mud-input-control {
            margin-top: 0 !important;
            margin-bottom: 0 !important;
        }

        .container-grid .mud-input > input,
        .container-grid .mud-input textarea {
            font-size: 13px !important;
            padding-top: 6px !important;
            padding-bottom: 6px !important;
        }

        .container-grid .mud-input-label {
            font-size: 12px !important;
            color: #4b5563 !important;
        }

    .container-action-cell {
        min-width: 84px;
    }

    .cont-no-cell {
        min-width: 150px;
        font-weight: 700;
        color: #0b5cad;
    }

    .cont-size-cell {
        min-width: 120px;
        font-weight: 600;
    }

    .cont-seal-cell {
        min-width: 130px;
    }

    .cont-number-cell {
        min-width: 100px;
        text-align: right !important;
    }

    .cont-description-cell {
        min-width: 260px;
        white-space: normal !important;
        line-height: 1.35;
    }

    .cont-status-cell {
        min-width: 190px;
        white-space: normal !important;
        line-height: 1.35;
    }

    .cont-location-cell {
        min-width: 170px;
    }

    .cont-date-cell {
        min-width: 170px;
    }

    .container-input {
        min-width: 120px;
    }

    .container-input-wide {
        min-width: 230px;
    }

    @@media(max - width: 1200px) {
            .container-tab-shell {
                min-width: 1000px;
            }

            .container-grid {
                min-width: 1500px;
            }
        }
    </style>

    <MudPaper Class="container-tab-shell" Elevation="0">
        <MudStack Row="true" Justify="Justify.FlexStart" AlignItems="AlignItems.Center" Spacing="3" Class="container-tab-header">
            <div>
                <MudText Typo="Typo.h6" Class="container-title">@Localizer["Container"]</MudText>
                <MudText Typo="Typo.caption" Class="container-subtitle">
                    Manage container number, seal, packages, weight and NVOCC tracking information.
                </MudText>
            </div>

            <MudStack Row="true" Justify="Justify.FlexStart" Class="container-toolbar">
                <span class="container-parent-badge">@GetParentLabel()</span>

                <MudTooltip Text="@Localizer["Reload"]">
                    <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                                   Color="Color.Success"
                                   Size="Size.Small"
                                   OnClick="Refresh"
                                   Variant="Variant.Filled"
                                   Disabled="@IsParentMissing()"
                                   Class="btn-compact" />
                </MudTooltip>

                <MudTooltip Text="@Localizer["New"]">
                    <MudIconButton Icon="@Icons.Material.Filled.Add"
                                   Color="Color.Success"
                                   Size="Size.Small"
                                   OnClick="AddItem"
                                   Variant="Variant.Filled"
                                   Disabled="@IsParentMissing()"
                                   Class="btn-compact" />
                </MudTooltip>

                <MudTooltip Text="@Localizer["Help"]">
                    <a href="HDSDhtml/Huong_dan_Tab_Container.0_Shipment.html" target="_blank">
                        <MudIconButton Icon="@Icons.Material.Filled.Info"
                                       Color="Color.Info"
                                       Size="Size.Small"
                                       Variant="Variant.Filled"
                                       Class="btn-compact" />
                    </a>
                </MudTooltip>
            </MudStack>
        </MudStack>

        <div class="container-grid-scroll">
            <MudDataGrid T="M_Container"
                         Items="@Listdata"
                         Filterable="true"
                         @ref="mudTable"
                         Class="container-grid"
                         Bordered="false"
                         Dense="true"
                         Hover="true"
                         Striped="true"
                         Virtualize="true"
                         Height="calc(100vh - 300px)"
                         FilterMode="@DataGridFilterMode.Simple"
                         FixedHeader="true"
                         FixedFooter="true"
                         HeaderClass="no-wrap"
                         FooterClass="no-wrap"
                         ReadOnly="false"
                         CommittedItemChanges="@CommittedItem"
                         RowClassFunc="@SelectedRowClassFunc"
                         RowClick="@RowClicked"
                         RowContextMenuClick="RowRightClicked"
                         ColumnResizeMode="ResizeMode.Column"
                         Loading="_loading"
                         ShowColumnOptions="false">
                <Columns>
                    <TemplateColumn Title="" CellClass="container-action-cell d-flex justify-end" Filterable="false" ShowColumnOptions="false" Sortable="false">
                        <CellTemplate>
                            <MudTooltip Text="@Localizer["edit"]">
                                <MudIconButton Size="@Size.Small"
                                               Icon="@Icons.Material.Outlined.Edit"
                                               Color="Color.Info"
                                               OnClick="@(() => TryStartEditing(context.Item))" />
                            </MudTooltip>
                            <MudTooltip Text="@Localizer["delete"]">
                                <MudIconButton Size="@Size.Small"
                                               Icon="@Icons.Material.Outlined.Delete"
                                               Color="Color.Error"
                                               OnClick="@(() => DeleteItem(context.Item))" />
                            </MudTooltip>
                        </CellTemplate>
                    </TemplateColumn>

                    <PropertyColumn Property="x => x.CTN_SIZE_TYPE" Title="@Localizer["Cont. Size Type"]" Required="false" CellClass="cont-size-cell">
                        <EditTemplate>
                            <MudSelect Class="container-input"
                                       @bind-Value="context.Item.CTN_SIZE_TYPE"
                                       Label="@Localizer["Cont. Size Type"]"
                                       Margin="Margin.Dense">
                                @foreach (var item in contType)
                                {
                                    <MudSelectItem Value="@item">@item</MudSelectItem>
                                }
                            </MudSelect>
                        </EditTemplate>
                    </PropertyColumn>

                    <PropertyColumn Property="x => x.CONTAINER_NO" Title="@Localizer["Cont. No."]" Required="false" CellClass="cont-no-cell">
                        <EditTemplate>
                            <MudAutocomplete Class="container-input"
                                             @bind-Value="context.Item.CONTAINER_NO"
                                             OnBlur="@(() => OnContainerNoBlurAsync(context.Item))"
                                             Label="@Localizer["Cont. No."]"
                                             CoerceValue
                                             Margin="Margin.Dense"
                                             SearchFunc="SearchContNo" />
                        </EditTemplate>
                    </PropertyColumn>

                    <PropertyColumn Property="x => x.APPROVE" Title="@Localizer["Approve"]" IsEditable="false" Required="false">
                        <CellTemplate>
                            <MudCheckBox @bind-Checked="context.Item.APPROVE"
                                         @bind-Value="context.Item.APPROVE"
                                         Size="Size.Small"
                                         @bind-Value:after="@(() => UpdatebyCheckboxClick(context.Item))" />
                        </CellTemplate>
                    </PropertyColumn>

                    <PropertyColumn Property="x => x.Seal" Title="@Localizer["Seal"]" Required="false" CellClass="cont-seal-cell">
                        <EditTemplate>
                            <MudAutocomplete Class="container-input"
                                             @bind-Value="context.Item.Seal"
                                             Label="@Localizer["Seal"]"
                                             CoerceValue
                                             Margin="Margin.Dense"
                                             SearchFunc="SearchSeal" />
                        </EditTemplate>
                    </PropertyColumn>

                    <PropertyColumn Property="x => x.pkgs" Title="@Localizer["PKGs"]" Required="false" CellClass="cont-number-cell" CellStyle="text-align: right;">
                        <EditTemplate>
                            <MudAutocomplete T="double?"
                                             Class="container-input"
                                             @bind-Value="context.Item.pkgs"
                                             Label="@Localizer["PKGs"]"
                                             CoerceValue
                                             Margin="Margin.Dense"
                                             SearchFunc="SearchKGs" />
                        </EditTemplate>
                    </PropertyColumn>

                    <PropertyColumn Property="x => x.pkgsCode" Title="@Localizer["PKGs Code"]" Required="false" CellClass="cont-size-cell">
                        <EditTemplate>
                            <MudSelect Class="container-input-wide"
                                       @bind-Value="context.Item.pkgsCode"
                                       Label="@Localizer["PKGs Code"]"
                                       Margin="Margin.Dense">
                                @foreach (var item in pkgType)
                                {
                                    <MudSelectItem Value="@item">@item</MudSelectItem>
                                }
                        </MudSelect>
                    </EditTemplate>
                </PropertyColumn>

                    <PropertyColumn Property="x => x.cbm" Title="@Localizer["CBM"]" Required="false" CellClass="cont-number-cell" CellStyle="text-align: right;" />
                    <PropertyColumn Property="x => x.NETWEIGHT" Title="@Localizer["Net WT."]" Required="false" CellClass="cont-number-cell" CellStyle="text-align: right;" />
                    <PropertyColumn Property="x => x.GrossWeight" Title="@Localizer["Gross WT."]" Required="false" CellClass="cont-number-cell" CellStyle="text-align: right;" />

                    <PropertyColumn Property="x => x.description" Title="@Localizer["Description"]" Required="false" CellClass="cont-description-cell">
                        <EditTemplate>
                            <MudTextField Class="container-input-wide"
                                          @bind-Value="context.Item.description"
                                          Label="@Localizer["Description"]"
                                          Lines="3"
                                          AutoGrow="true"
                                          Margin="Margin.Dense" />
                        </EditTemplate>
                    </PropertyColumn>

                    <PropertyColumn Property="x => x.NVOCC_Status" Title="@Localizer["NVOCC_Status"]" Required="true" CellClass="cont-location-cell">
                        <EditTemplate>
                            <MudSelect Class="container-input-wide"
                                       @bind-Value="context.Item.NVOCC_Status"
                                       Label="@Localizer["NVOCC_Status"]"
                                       Margin="Margin.Dense"
                                       Required
                                       RequiredError="@NvoccStatusRequiredMessage"
                                       Clearable>
                                @foreach (var item in nvoccStatusOptions)
                                {
                                    <MudSelectItem Value="@item">@item</MudSelectItem>
                                }
                            </MudSelect>
                        </EditTemplate>
                    </PropertyColumn>

                    <PropertyColumn Property="x => x.Status_Cont" Title="@Localizer["Status_Cont"]" Required="true" CellClass="cont-status-cell">
                        <EditTemplate>
                            <MudSelect Class="container-input-wide"
                                       @bind-Value="context.Item.Status_Cont"
                                       Label="@Localizer["Status_Cont"]"
                                       Margin="Margin.Dense"
                                       Required
                                       RequiredError="@StatusContRequiredMessage"
                                       Clearable>
                                @foreach (var item in statusContOptions)
                                {
                                    <MudSelectItem Value="@item">@item</MudSelectItem>
                                }
                            </MudSelect>
                        </EditTemplate>
                    </PropertyColumn>

                    <PropertyColumn Property="x => x.In_Depot" Title="@($"{Localizer["In Depot"]} *")" Required="false" CellClass="cont-location-cell">
                        <EditTemplate>
                            <MudAutocomplete T="string"
                                             Class="container-input-wide"
                                             @bind-Value="context.Item.In_Depot"
                                             Label="@Localizer["In Depot"]"
                                             CoerceValue
                                             Margin="Margin.Dense"
                                             SearchFunc="SearchTerminal"
                                             Required="@IsInDepotRequired(context.Item)"
                                             RequiredError="@InDepotOrInPortRequiredMessage"
                                             Clearable />
                        </EditTemplate>
                    </PropertyColumn>

                    <PropertyColumn Property="x => x.In_Port" Title="@($"{Localizer["In Port"]} *")" Required="false" CellClass="cont-location-cell">
                        <EditTemplate>
                            <MudAutocomplete T="string"
                                             Class="container-input-wide"
                                             @bind-Value="context.Item.In_Port"
                                             Label="@Localizer["In Port"]"
                                             CoerceValue
                                             Margin="Margin.Dense"
                                             SearchFunc="SearchPorts"
                                             Required="@IsInPortRequired(context.Item)"
                                             RequiredError="@InDepotOrInPortRequiredMessage"
                                             Clearable />
                        </EditTemplate>
                    </PropertyColumn>

                    <PropertyColumn Property="x => x.Empty_pickup_date" Title="Empty Pickup Date" Required="false" CellClass="cont-date-cell">
                        <EditTemplate>
                            <MudDatePicker @bind-Date="context.Item.Empty_pickup_date"
                                           Label="Empty Pickup Date"
                                           Margin="Margin.Dense"
                                           DateFormat="dd/MM/yyyy"
                                           Clearable />
                        </EditTemplate>
                    </PropertyColumn>

                    <PropertyColumn Property="x => x.Full_Discharge_Date" Title="Full Discharge Date" Required="false" CellClass="cont-date-cell">
                        <EditTemplate>
                            <MudDatePicker @bind-Date="context.Item.Full_Discharge_Date"
                                           Label="Full Discharge Date"
                                           Margin="Margin.Dense"
                                           DateFormat="dd/MM/yyyy"
                                           Clearable />
                        </EditTemplate>
                    </PropertyColumn>

                    <PropertyColumn Property="x => x.Full_Delivery_Date" Title="Full Delivery Date" Required="false" CellClass="cont-date-cell">
                        <EditTemplate>
                            <MudDatePicker @bind-Date="context.Item.Full_Delivery_Date"
                                           Label="Full Delivery Date"
                                           Margin="Margin.Dense"
                                           DateFormat="dd/MM/yyyy"
                                           Clearable />
                        </EditTemplate>
                    </PropertyColumn>

                    <PropertyColumn Property="x => x.Empty_Return_Date" Title="Empty Return Date" Required="false" CellClass="cont-date-cell">
                        <EditTemplate>
                            <MudDatePicker @bind-Date="context.Item.Empty_Return_Date"
                                           Label="Empty Return Date"
                                           Margin="Margin.Dense"
                                           DateFormat="dd/MM/yyyy"
                                           Clearable />
                        </EditTemplate>
                    </PropertyColumn>

                    <PropertyColumn Property="x => x.Storage_In_Date" Title="Storage In Date" Required="false" CellClass="cont-date-cell">
                        <EditTemplate>
                            <MudDatePicker @bind-Date="context.Item.Storage_In_Date"
                                           Label="Storage In Date"
                                           Margin="Margin.Dense"
                                           DateFormat="dd/MM/yyyy"
                                           Clearable />
                        </EditTemplate>
                    </PropertyColumn>

                    <PropertyColumn Property="x => x.Storage_Out_Date" Title="Storage Out Date" Required="false" CellClass="cont-date-cell">
                        <EditTemplate>
                            <MudDatePicker @bind-Date="context.Item.Storage_Out_Date"
                                           Label="Storage Out Date"
                                           Margin="Margin.Dense"
                                           DateFormat="dd/MM/yyyy"
                                           Clearable />
                        </EditTemplate>
                    </PropertyColumn>

                    <PropertyColumn Property="x => x.Decommision" Title="@Localizer["Decommision"]" Required="false">
                        <CellTemplate>
                            <MudCheckBox T="bool?" @bind-Value="context.Item.Decommision" Size="Size.Small" />
                        </CellTemplate>
                        <EditTemplate>
                            <MudCheckBox T="bool?"
                                         @bind-Value="context.Item.Decommision"
                                         Label="@Localizer["Decommision"]"
                                         Size="Size.Small" />
                        </EditTemplate>
                    </PropertyColumn>

                    <PropertyColumn Property="x => x.USERID" Title="@Localizer["UserUpdate"]" IsEditable="false" Required="false" />
                    <PropertyColumn Property="x => x.UPDATETIME" Title="@Localizer["Dateupdate"]" IsEditable="false" Required="false" />
                </Columns>
            </MudDataGrid>
        </div>
    </MudPaper>
@code {
    private bool IsParentMissing()
    {
        if (MBLDetail != null)
            return MBLDetail.MblID == Guid.Empty;

        if (HBLDetail != null)
            return HBLDetail.hblID == Guid.Empty;

        return true;
    }

    private string GetParentLabel()
    {
        if (MBLDetail != null && MBLDetail.MblID != Guid.Empty)
            return $"MBL: {MBLDetail.Mbl}";

        if (HBLDetail != null && HBLDetail.hblID != Guid.Empty)
            return $"HBL: {HBLDetail.hbl}";

        return "No MBL/HBL selected";
    }

    [Parameter] public M_MBL? MBLDetail { get; set; } = default!;
    [Parameter] public M_HBL? HBLDetail { get; set; } = default!;
    [CascadingParameter] MudDialogInstance? MudDialog { get; set; }
    M_Container detail;
    List<string> nvoccStatusOptions = new()
    {
        "In Depot",
        "Waiting Port Arrival",
        "Arrived at Port",
        "In Transit"
    };

    List<string> statusContOptions = new()
    {
        "Waiting Port Arrival",
        "Arrived at Port",
        "In Transit",
        "In Depot",
        "Gate Out",
        "Released",
        "Delivered",
        "Returned",
        "Hold",
        "Cancelled"
    };

    void CallSnackBar(string message, MudBlazor.Severity severity)
    {

        Snackbar.Configuration.SnackbarVariant = Variant.Filled;
        Snackbar.Configuration.MaxDisplayedSnackbars = 3;
        Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopRight;
        Snackbar.Add(message, severity);
    }

    private void Submit()
    {
        MudDialog!.Close();
    }
    bool isMBL;
    void Cancel() => MudDialog!.Cancel();
    string usr;
    List<M_Container> Conts = new List<M_Container>();
    private List<Terminal_> Terminals = new List<Terminal_>();
    private List<PortModel> Ports = new List<PortModel>();

    protected async override Task OnInitializedAsync()
    {
        try
        {
            isMBL = MBLDetail == null ? false : true;
            if (isMBL)
            {
                if (MBLDetail.MblID == Guid.Empty)
                {
                    CallSnackBar("Vui lòng chọn 1 dòng MBL", MudBlazor.Severity.Warning);
                    return;
                }
            }
            else
            {
                if (HBLDetail.hblID == Guid.Empty)
                {
                    CallSnackBar("Vui lòng chọn 1 dòng HBL", MudBlazor.Severity.Warning);
                    return;
                }
            }
            Conts = shipsv.GetListContainerAll();
            Terminals = await gsv.GetList_Terminal();
            Ports = await bksv.GetList_PORT();
            usr = asv.GetAuth().Result.User.Identity!.Name!;
            await Refresh();
        }
        catch (Exception ex)
        {
            CallSnackBar("Please slow down!", MudBlazor.Severity.Error);

        }
    }

    bool _loading = false;
    List<M_Container> Listdata = new List<M_Container>();
    M_Container detail_cont;
    List<string> contType = new List<string> { "20DC", "40DC", "40HC", "40RH", "45HC", "20RF", "40RF", "20OT", "40OT", "20FR", "40FR" };
    List<string> pkgType = new List<string> { "BARREL(S)", "BUNDLE(S)", "BAG(S)", "BASKET(S)", "BALE'S)", "BAR(S)", "BOX(S)", "CAN(S)", "CAG(S)", "CONTAINER(S)", "CRATE(S)", "CASE(S)", "CARTON(S)", "DRUM(S)", "FLEXIBAG(S)", "NET(S)", "PARCEL(S)", "PEN(S)", "PLATE(S)", "PIPE(S)", "PACKAGE(S)", "PAIL(S)", "PALLET(S)", "PIECE(S)", "TRAY(S)", "ROLL(S)", "TANK(S)", "WOODENCASE(S)", "WOODENBOX(ES)", "OTHER" };
    List<string> List_Terminal = new List<string>();

    async Task Refresh()
    {
        try
        {
            _loading = true;
            // Simulate asynchronous loading to demonstrate a loading indicator
            Listdata.Clear();
            StateHasChanged();
            await Task.Delay(500);
            if (!await ssv.CheckPermission(usr, "View", "HBL"))
            {
                CallSnackBar("You have not access to view", MudBlazor.Severity.Warning);
                return;
            }
            if (isMBL)
                Listdata = shipsv.GetListContainerMBL(MBLDetail!.MblID);
            else
                Listdata = shipsv.GetListContainerHBL(HBLDetail!.hblID);
        }
        finally
        {
            _loading = false;
        }

    }
    MudDataGrid<M_Container> mudTable;
    async Task AddItem()
    {
        var item = new M_Container();
        Listdata.Add(item);
        await mudTable.SetEditingItemAsync(Listdata.LastOrDefault()!);
    }

    async Task DeleteItem(M_Container item)
    {
        if (item == null)
        {
            CallSnackBar("you must select 1 row.", MudBlazor.Severity.Warning);
            return;
        }

        if (item.APPROVE.HasValue && item.APPROVE.Value)
        {
            CallSnackBar("This Container is approved!", MudBlazor.Severity.Info);
            return;
        }
        var resultMess = await DialogService.ShowMessageBox(
                "Warning",
                "Deleting can not be undone!",
                yesText: "Delete!", cancelText: "Cancel");

        if (resultMess.HasValue)
        {
            var rs = await shipsv.DeleteContainerMBL(item);
            await HistoryLogService.LogAsync(usr, "Delete Container", "Shipment", item.CTN_ID, item.CONTAINER_NO, new { OldData = item });
            CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
            await Refresh();
        }

    }
    private const string NvoccStatusRequiredMessage = "Vui lòng nhập NVOCC Status.";
    private const string StatusContRequiredMessage = "Vui lòng nhập Status Cont.";

    private const string InDepotOrInPortRequiredMessage = "Vui lòng nhập In Depot hoặc In Port (bắt buộc ít nhất một trong hai).";

    private static bool HasRequiredStatusFields(M_Container item) =>
        !string.IsNullOrWhiteSpace(item.NVOCC_Status) && !string.IsNullOrWhiteSpace(item.Status_Cont);

    private static bool HasInDepotOrInPort(M_Container item) =>
        !string.IsNullOrWhiteSpace(item.In_Depot) || !string.IsNullOrWhiteSpace(item.In_Port);

    private static bool IsInDepotRequired(M_Container item) =>
        string.IsNullOrWhiteSpace(item.In_Port);

    private static bool IsInPortRequired(M_Container item) =>
        string.IsNullOrWhiteSpace(item.In_Depot);

    async Task CommittedItem(M_Container item)
    {
        if (!HasRequiredStatusFields(item))
        {
            CallSnackBar("Vui lòng nhập đầy đủ NVOCC Status và Status Cont.", MudBlazor.Severity.Warning);
            await mudTable.SetEditingItemAsync(item);
            return;
        }

        if (!HasInDepotOrInPort(item))
        {
            CallSnackBar(InDepotOrInPortRequiredMessage, MudBlazor.Severity.Warning);
            await mudTable.SetEditingItemAsync(item);
            return;
        }

        if (isMBL) item.mblid = MBLDetail!.MblID;
        else item.hblid = HBLDetail!.hblID;

        item.USERID = usr;
        item.UPDATETIME = DateTime.Now;
        var rs = item.CTN_ID != Guid.Empty ? await shipsv.UpdateContainerMBL(item, detail_cont) : await shipsv.CreateContainerMBL(item);
        CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
        await Refresh();
    }

    private int selectedRowNumber = -1;
    private string SelectedRowClassFunc(M_Container Sis, int rowNumber)
    {
        if (Sis.APPROVE.HasValue && Sis.APPROVE.Value)
        {
            return "custom-disable"; // Gán class "disable" nếu Approve = true
        }
        else if (selectedRowNumber == rowNumber)
        {
            selectedRowNumber = -1;
            return string.Empty;
        }
        else if (mudTable.SelectedItem != null && mudTable.SelectedItem.Equals(Sis))
        {
            selectedRowNumber = rowNumber;
            return "selected";
        }
        else
        {
            return string.Empty;
        }
    }
    void RowClicked(DataGridRowClickEventArgs<M_Container> args)
    {
        if (args.Item.APPROVE.HasValue && args.Item.APPROVE.Value)
            CallSnackBar("This Container is approved!", MudBlazor.Severity.Info);
        else detail = args.Item;
    }

