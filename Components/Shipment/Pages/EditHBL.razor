@using MudBlazor
@inject IStringLocalizer<SharedResource> Localizer
@inject CustomerService csv
@inject ShipmentService ssv
@inject SupportServices supsv

<style>
    .bl-container {
        max-width: 1320px;
        padding: 10px 14px 4px 14px !important;
    }

    .bl-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        margin-bottom: 8px;
    }

    .bl-title-wrap {
        display: flex;
        flex-direction: column;
        gap: 2px;
    }

    .bl-title {
        font-size: 20px;
        font-weight: 700;
        color: #263238;
        line-height: 1.2;
    }

    .bl-subtitle {
        font-size: 12px;
        color: #607d8b;
    }

    .bl-section {
        border: 1px solid #e0e0e0;
        border-radius: 12px;
        padding: 10px 12px 12px 12px;
        background: #ffffff;
        box-shadow: 0 1px 4px rgba(0,0,0,.04);
        margin-bottom: 10px;
    }

    .bl-section-title {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 13px;
        font-weight: 700;
        color: #118AB2;
        margin-bottom: 8px;
        text-transform: uppercase;
        letter-spacing: .3px;
    }

    .bl-section-title::before {
        content: "";
        width: 4px;
        height: 16px;
        border-radius: 4px;
        background: #118AB2;
        display: inline-block;
    }

    .bl-logo-box {
        height: 100%;
        min-height: 150px;
        border: 1px dashed #d7dde2;
        border-radius: 12px;
        display: flex;
        justify-content: center;
        align-items: center;
        background: #fafafa;
        padding: 12px;
    }

    .bl-logo-box img,
    .bl-logo-box .mud-image {
        max-height: 120px;
        max-width: 100%;
        object-fit: contain;
        box-shadow: none !important;
    }

    .bl-input .mud-input-control,
    .bl-container .mud-input-control {
        margin-top: 0 !important;
    }

    .bl-container .mud-input-label {
        font-size: 12px !important;
        color: #455a64 !important;
        font-weight: 600 !important;
    }

    .bl-container .mud-input > input,
    .bl-container textarea {
        font-size: 13px !important;
    }

    .bl-textarea textarea {
        min-height: 86px !important;
        line-height: 1.35 !important;
    }

    .bl-goods-textarea textarea {
        min-height: 128px !important;
        line-height: 1.35 !important;
    }

    .bl-number input,
    .bl-number textarea {
        text-align: right !important;
    }

    .bl-dialog-actions {
        width: 100%;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 8px;
        padding: 8px 12px 10px 12px;
        border-top: 1px solid #e5e7eb;
    }

    .bl-actions-left,
    .bl-actions-right {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .bl-help-link {
        text-decoration: none;
    }

        @@media(max - width: 960px) {
        .bl-header {
            flex-direction: column;
            align-items: flex-start;
        }

            .bl-container {
                padding: 8px !important;
            }
        }
    </style>

    <MudDialog>
        <DialogContent>
            <MudForm @ref="form">
                <MudContainer Class="bl-container">
                    <div class="bl-header">
                        <div class="bl-title-wrap">
                            <div class="bl-title">Bill of Lading Information</div>
                            <div class="bl-subtitle">Nhập thông tin phát hành vận đơn: parties, routing, cargo và thông tin phát hành.</div>
                        </div>

                        <a class="bl-help-link" href="HDSDhtml/Huong_dan_Nhap_Form_HBL_Chi_Tiet.html" target="_blank">
                            <MudButton Color="Color.Info"
                                       Variant="Variant.Outlined"
                                       Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.Info">
                                @Localizer["Help"]
                            </MudButton>
                        </a>
                    </div>

                    <!-- Section 1: Document Information -->
                    <div class="bl-section">
                        <div class="bl-section-title">Document Information</div>
                        <MudGrid Spacing="1">
                            <MudItem xs="12" md="7">
                                <MudGrid Spacing="1">
                                    <MudItem xs="12" md="6">
                                        <MudTextField Class="bl-input"
                                                      @bind-Value="MBL.bkno"
                                                      For="@(() => MBL.bkno)"
                                                      AdornmentColor="@ColorTextFields"
                                                      Immediate="true"
                                                      Label="B/L No."
                                                      Variant="Variant.Outlined"
                                                      Margin="Margin.Dense" />
                                    </MudItem>

                                    <MudItem xs="12" md="6">
                                        <MudTextField Class="bl-input"
                                                      @bind-Value="MBL.hbl"
                                                      For="@(() => MBL.hbl)"
                                                      AdornmentColor="@ColorTextFields"
                                                      Immediate="true"
                                                      Label="HBL"
                                                      Variant="Variant.Outlined"
                                                      Margin="Margin.Dense" />
                                    </MudItem>

                                    <MudItem xs="12" md="4">
                                        <MudTextField Class="bl-input"
                                                      @bind-Value="MBL.IssueAt"
                                                      For="@(() => MBL.IssueAt)"
                                                      AdornmentColor="@ColorTextFields"
                                                      Immediate="true"
                                                      Label="Issue At"
                                                      Variant="Variant.Outlined"
                                                      Margin="Margin.Dense" />
                                    </MudItem>

                                    <MudItem xs="12" md="4">
                                        <MudAutocomplete T="string"
                                                         Class="bl-input"
                                                         @bind-Value="MBL.placeAndDate"
                                                         AdornmentColor="@ColorTextFields"
                                                         SearchFunc="mst_Ports"
                                                         Immediate="true"
                                                         MaxItems="5000"
                                                         ToStringFunc="(x) => x"
                                                         ResetValueOnEmptyText="false"
                                                         Clearable="true"
                                                         Label="Place Of Issue"
                                                         Variant="Variant.Outlined"
                                                         Margin="Margin.Dense" />
                                    </MudItem>

                                    <MudItem xs="12" md="4">
                                        <MudNumericField T="double?"
                                                         Class="bl-input bl-number"
                                                         @bind-Value="MBL.ex_rate"
                                                         For="@(() => MBL.ex_rate)"
                                                         AdornmentColor="@ColorTextFields"
                                                         Label="Exchange Rate"
                                                         Format="N4"
                                                         HideSpinButtons="true"
                                                         Immediate="true"
                                                         Variant="Variant.Outlined"
                                                         Margin="Margin.Dense" />
                                    </MudItem>
                                </MudGrid>
                            </MudItem>

                            <MudItem xs="12" md="5">
                                <div class="bl-logo-box">
                                    <MudImage Src="ImageForReport/logobillseaNVOCC.png" Alt="logo" Class="card-img" />
                                </div>
                            </MudItem>
                        </MudGrid>
                    </div>

                    <!-- Section 2: Parties -->
                    <div class="bl-section">
                        <div class="bl-section-title">Parties</div>
                        <MudGrid Spacing="1">
                            <MudItem xs="12" md="4">
                                <MudAutocomplete T="string"
                                                 Class="bl-input"
                                                 @bind-Value="MBL.shipper"
                                                 AdornmentColor="@ColorTextFields"
                                                 Immediate="true"
                                                 SearchFunc="mst_S"
                                                 ToStringFunc="(x) => x"
                                                 ResetValueOnEmptyText="false"
                                                 Clearable="true"
                                                 Label="Search Shipper"
                                                 Variant="Variant.Outlined"
                                                 Margin="Margin.Dense" />

                                <MudTextField Class="bl-input bl-textarea"
                                              @bind-Value="MBL.shipper"
                                              For="@(() => MBL.shipper)"
                                              AdornmentColor="@ColorTextFields"
                                              Immediate="true"
                                              AutoGrow="true"
                                              Lines="4"
                                              Label="Shipper"
                                              Variant="Variant.Outlined"
                                              Margin="Margin.Dense" />
                            </MudItem>

                            <MudItem xs="12" md="4">
                                <MudAutocomplete T="string"
                                                 Class="bl-input"
                                                 @bind-Value="MBL.consignee"
                                                 AdornmentColor="@ColorTextFields"
                                                 Immediate="true"
                                                 SearchFunc="mst_C"
                                                 ToStringFunc="(x) => x"
                                                 ResetValueOnEmptyText="false"
                                                 Clearable="true"
                                                 Label="Search Consignee"
                                                 Variant="Variant.Outlined"
                                                 Margin="Margin.Dense" />

                                <MudTextField Class="bl-input bl-textarea"
                                              @bind-Value="MBL.consignee"
                                              For="@(() => MBL.consignee)"
                                              AdornmentColor="@ColorTextFields"
                                              Immediate="true"
                                              AutoGrow="true"
                                              Lines="4"
                                              Label="Consignee"
                                              Variant="Variant.Outlined"
                                              Margin="Margin.Dense" />
                            </MudItem>

                            <MudItem xs="12" md="4">
                                <MudAutocomplete T="string"
                                                 Class="bl-input"
                                                 @bind-Value="MBL.notify1"
                                                 AdornmentColor="@ColorTextFields"
                                                 SearchFunc="mst_N"
                                                 ToStringFunc="(x) => x"
                                                 ResetValueOnEmptyText="false"
                                                 Clearable="true"
                                                 Label="Search Notify Party"
                                                 Variant="Variant.Outlined"
                                                 Margin="Margin.Dense" />

                                <MudTextField Class="bl-input bl-textarea"
                                              @bind-Value="MBL.notify1"
                                              For="@(() => MBL.notify1)"
                                              AdornmentColor="@ColorTextFields"
                                              Immediate="true"
                                              AutoGrow="true"
                                              Lines="4"
                                              Label="Notify Party"
                                              Variant="Variant.Outlined"
                                              Margin="Margin.Dense" />
                            </MudItem>
                        </MudGrid>
                    </div>

                    <!-- Section 3: Voyage & Routing -->
                    <div class="bl-section">
                        <div class="bl-section-title">Voyage & Routing</div>
                        <MudGrid Spacing="1">
                            <MudItem xs="12" md="3">
                                <MudAutocomplete T="string"
                                                 Class="bl-input"
                                                 @bind-Value="MBL.vessel"
                                                 AdornmentColor="@ColorTextFields"
                                                 SearchFunc="SearchVessel"
                                                 Immediate="true"
                                                 Label="Vessel"
                                                 Variant="Variant.Outlined"
                                                 Margin="Margin.Dense" />
                            </MudItem>

                            <MudItem xs="12" md="3">
                                <MudAutocomplete T="string"
                                                 Class="bl-input"
                                                 @bind-Value="MBL.voy"
                                                 AdornmentColor="@ColorTextFields"
                                                 SearchFunc="SearchVoy"
                                                 Immediate="true"
                                                 Label="Voy"
                                                 Variant="Variant.Outlined"
                                                 Margin="Margin.Dense" />
                            </MudItem>

                            <MudItem xs="12" md="3">
                                <MudAutocomplete T="string"
                                                 Class="bl-input"
                                                 @bind-Value="MBL.porname"
                                                 AdornmentColor="@ColorTextFields"
                                                 SearchFunc="mst_Ports"
                                                 Immediate="true"
                                                 MaxItems="5000"
                                                 ToStringFunc="(x) => x"
                                                 ResetValueOnEmptyText="false"
                                                 Clearable="true"
                                                 Label="Place Of Receipt"
                                                 Variant="Variant.Outlined"
                                                 Margin="Margin.Dense" />
                            </MudItem>

                            <MudItem xs="12" md="3">
                                <MudAutocomplete T="string"
                                                 Class="bl-input"
                                                 @bind-Value="MBL.polname"
                                                 AdornmentColor="@ColorTextFields"
                                                 SearchFunc="mst_Ports"
                                                 Immediate="true"
                                                 MaxItems="5000"
                                                 ToStringFunc="(x) => x"
                                                 ResetValueOnEmptyText="false"
                                                 Clearable="true"
                                                 Label="Port of Loading"
                                                 Variant="Variant.Outlined"
                                                 Margin="Margin.Dense" />
                            </MudItem>

                            <MudItem xs="12" md="6">
                                <MudAutocomplete T="string"
                                                 Class="bl-input"
                                                 @bind-Value="MBL.podname"
                                                 AdornmentColor="@ColorTextFields"
                                                 SearchFunc="mst_Ports"
                                                 ToStringFunc="(x) => x"
                                                 ResetValueOnEmptyText="false"
                                                 Clearable="true"
                                                 Label="Port of Discharge"
                                                 Variant="Variant.Outlined"
                                                 Margin="Margin.Dense" />
                            </MudItem>

                            <MudItem xs="12" md="6">
                                <MudAutocomplete T="string"
                                                 Class="bl-input"
                                                 @bind-Value="MBL.delName"
                                                 AdornmentColor="@ColorTextFields"
                                                 SearchFunc="mst_Ports"
                                                 Immediate="true"
                                                 MaxItems="5000"
                                                 ToStringFunc="(x) => x"
                                                 ResetValueOnEmptyText="false"
                                                 Clearable="true"
                                                 Label="Place of Delivery"
                                                 Variant="Variant.Outlined"
                                                 Margin="Margin.Dense" />
                            </MudItem>
                        </MudGrid>
                    </div>

                    <!-- Section 4: Cargo Details -->
                    <div class="bl-section">
                        <div class="bl-section-title">Cargo Details</div>
                        <MudGrid Spacing="1">
                            <MudItem xs="12" md="3">
                                <MudTextField Class="bl-input bl-goods-textarea"
                                              @bind-Value="MBL.markAndNumbers"
                                              Lines="6"
                                              For="@(() => MBL.markAndNumbers)"
                                              AdornmentColor="@ColorTextFields"
                                              Immediate="true"
                                              AutoGrow="true"
                                              Label="Marks and Numbers"
                                              Variant="Variant.Outlined"
                                              Margin="Margin.Dense" />
                            </MudItem>

                            <MudItem xs="12" md="2">
                                <MudTextField Class="bl-input bl-goods-textarea bl-number"
                                              @bind-Value="MBL.NoOfPackages"
                                              Lines="6"
                                              For="@(() => MBL.NoOfPackages)"
                                              AdornmentColor="@ColorTextFields"
                                              Immediate="true"
                                              AutoGrow="true"
                                              Label="No. of Packages"
                                              Variant="Variant.Outlined"
                                              Margin="Margin.Dense" />
                            </MudItem>

                            <MudItem xs="12" md="4">
                                <MudTextField Class="bl-input bl-goods-textarea"
                                              @bind-Value="MBL.description"
                                              Lines="6"
                                              For="@(() => MBL.description)"
                                              AdornmentColor="@ColorTextFields"
                                              Immediate="true"
                                              AutoGrow="true"
                                              Label="Description of Goods"
                                              Variant="Variant.Outlined"
                                              Margin="Margin.Dense" />
                            </MudItem>

                            <MudItem xs="12" md="3">
                                <MudGrid Spacing="1">
                                    <MudItem xs="6">
                                        <MudTextField Class="bl-input bl-number"
                                                      @bind-Value="MBL.gross"
                                                      For="@(() => MBL.gross)"
                                                      AdornmentColor="@ColorTextFields"
                                                      Immediate="true"
                                                      AutoGrow="true"
                                                      Label="Gross"
                                                      Variant="Variant.Outlined"
                                                      Margin="Margin.Dense" />
                                    </MudItem>

                                    <MudItem xs="6">
                                        <MudTextField Class="bl-input bl-number"
                                                      @bind-Value="MBL.cbm"
                                                      For="@(() => MBL.cbm)"
                                                      AdornmentColor="@ColorTextFields"
                                                      Immediate="true"
                                                      AutoGrow="true"
                                                      Label="Measurement"
                                                      Variant="Variant.Outlined"
                                                      Margin="Margin.Dense" />
                                    </MudItem>

                                    <MudItem xs="12">
                                        <MudTextField Class="bl-input"
                                                      @bind-Value="MBL.shipOnboard"
                                                      For="@(() => MBL.shipOnboard)"
                                                      AdornmentColor="@ColorTextFields"
                                                      Immediate="true"
                                                      AutoGrow="true"
                                                      Label="Shipped On Board"
                                                      Variant="Variant.Outlined"
                                                      Margin="Margin.Dense" />
                                    </MudItem>

                                    <MudItem xs="12">
                                        <MudTextField Class="bl-input"
                                                      @bind-Value="MBL.say"
                                                      Lines="2"
                                                      For="@(() => MBL.say)"
                                                      AdornmentColor="@ColorTextFields"
                                                      Immediate="true"
                                                      AutoGrow="true"
                                                      Label="SAY"
                                                      Variant="Variant.Outlined"
                                                      Margin="Margin.Dense" />
                                    </MudItem>
                                </MudGrid>
                            </MudItem>
                        </MudGrid>
                    </div>

                    <!-- Section 5: Freight & Payment -->
                    <div class="bl-section">
                        <div class="bl-section-title">Freight & Payment</div>
                        <MudGrid Spacing="1">
                            <MudItem xs="12" md="4">
                                <MudAutocomplete T="string"
                                                 Class="bl-input"
                                                 @bind-Value="MBL.freightPayableAt"
                                                 AdornmentColor="@ColorTextFields"
                                                 SearchFunc="mst_Ports"
                                                 Immediate="true"
                                                 MaxItems="5000"
                                                 ToStringFunc="(x) => x"
                                                 ResetValueOnEmptyText="false"
                                                 Clearable="true"
                                                 Label="Prepaid At"
                                                 Variant="Variant.Outlined"
                                                 Margin="Margin.Dense" />
                            </MudItem>

                            <MudItem xs="12" md="4">
                                <MudAutocomplete T="string"
                                                 Class="bl-input"
                                                 @bind-Value="MBL.collectat"
                                                 AdornmentColor="@ColorTextFields"
                                                 SearchFunc="mst_Ports"
                                                 Immediate="true"
                                                 MaxItems="5000"
                                                 ToStringFunc="(x) => x"
                                                 ResetValueOnEmptyText="false"
                                                 Clearable="true"
                                                 Label="Payable At"
                                                 Variant="Variant.Outlined"
                                                 Margin="Margin.Dense" />
                            </MudItem>

                            <MudItem xs="12" md="4">
                                <MudTextField Class="bl-input"
                                              @bind-Value="MBL.numberOfOriginal"
                                              For="@(() => MBL.numberOfOriginal)"
                                              AdornmentColor="@ColorTextFields"
                                              Immediate="true"
                                              AutoGrow="true"
                                              Label="Number Of Original"
                                              Variant="Variant.Outlined"
                                              Margin="Margin.Dense" />
                            </MudItem>
                        </MudGrid>
                    </div>
                </MudContainer>
            </MudForm>
        </DialogContent>

        <DialogActions>
            <div class="bl-dialog-actions">
                <div class="bl-actions-left">
                    <MudButton Class="custom-button"
                               Variant="Variant.Filled"
                               Size="Size.Small"
                               Color="Color.Tertiary"
                               StartIcon="@Icons.Material.Filled.Inventory2"
                               OnClick="FillCont">
                        Fill Cont
                    </MudButton>
                </div>

                <div class="bl-actions-right">
                    <MudButton Variant="Variant.Text" Color="Color.Secondary" OnClick="Cancel">
                        Cancel
                    </MudButton>
                    <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit">
                        Save
                    </MudButton>
                </div>
            </div>
        </DialogActions>
    </MudDialog>

@code {
    MudForm form;
    Color ColorTextFields = Color.Primary;

    private void Submit()
    {
        MudDialog!.Close(MBL);
    }

    List<string> saleNames = new List<string>();
    List<string> countries = new List<string>();
    List<string> shippers = new List<string>();
    List<string> consignees = new List<string>();
    List<string> notifys = new List<string>();
    List<string> ports = new List<string>();
    List<string>? Sales = new List<string>();
    List<string> listvoy = new List<string>();
    List<string> listvessel = new List<string>();

    [Parameter] public M_HBL? Detail { get; set; } = default!;

    private string shipper = "";
    private string consignee = "";
    private string notify = "";
    private string mst_Shipper = "";
    private string mst_Consignee = "";
    private string mst_Notify = "";
    private string mst_Vessel = "";
    private string mst_Voy = "";
    private string mst_POR = "";
    private string mst_POL = "";
    private string mst_POD = "";
    private string mst_DEL = "";

    private List<M_Container> ContDetail = new List<M_Container>();

    void Cancel() => MudDialog!.Cancel();

    protected async override Task OnInitializedAsync()
    {
        if (Detail != null)
        {
            MBL = Detail;
        }

        ContDetail = ssv.GetListContainerMBL(MBL.hblID);
        shippers = csv.queryListShippers();
        ports = csv.queryListPorts();
        listvoy = await supsv.GetlistVoy();
        listvessel = await supsv.GetlistVessel();
    }

    [CascadingParameter] MudDialogInstance? MudDialog { get; set; }

    M_Customer customer = new M_Customer();
    M_HBL MBL = new M_HBL();

    private async Task<IEnumerable<string>> mst_S(string text)
    {
        try
        {
            if (string.IsNullOrWhiteSpace(text))
            {
                MBL.shipper = "";
                return shippers;
            }

            return shippers.Where(x => !string.IsNullOrEmpty(x) && x.Contains(text, StringComparison.OrdinalIgnoreCase));
        }
        catch (Exception)
        {
            throw;
        }
    }

    private async Task<IEnumerable<string>> mst_C(string text)
    {
        try
        {
            if (string.IsNullOrWhiteSpace(text))
            {
                MBL.consignee = "";
                return shippers;
            }

            return shippers.Where(x => !string.IsNullOrEmpty(x) && x.Contains(text, StringComparison.OrdinalIgnoreCase));
        }
        catch (Exception)
        {
            throw;
        }
    }

    private async Task<IEnumerable<string>> mst_N(string text)
    {
        try
        {
            if (string.IsNullOrWhiteSpace(text))
            {
                MBL.notify1 = "";
                return shippers;
            }

            return shippers.Where(x => !string.IsNullOrEmpty(x) && x.Contains(text, StringComparison.OrdinalIgnoreCase));
        }
        catch (Exception)
        {
            throw;
        }
    }

    private async Task<IEnumerable<string>> mst_Ports(string text)
    {
        try
        {
            var list = ports.Where(x => !string.IsNullOrEmpty(x));
            if (string.IsNullOrWhiteSpace(text))
                return list;

            return list.Where(x => x.Contains(text, StringComparison.OrdinalIgnoreCase));
        }
        catch (Exception)
        {
            throw;
        }
    }

    private async Task<IEnumerable<string>> SearchVoy(string text)
    {
        try
        {
            if (string.IsNullOrWhiteSpace(text))
            {
                return listvoy;
            }

            return listvoy.Where(x => !string.IsNullOrEmpty(x) && x.Contains(text, StringComparison.OrdinalIgnoreCase));
        }
        catch (Exception)
        {
            throw;
        }
    }

    private async Task<IEnumerable<string>> SearchVessel(string text)
    {
        try
        {
            if (string.IsNullOrWhiteSpace(text))
            {
                return listvessel;
            }

            return listvessel.Where(x => !string.IsNullOrEmpty(x) && x.Contains(text, StringComparison.OrdinalIgnoreCase));
        }
        catch (Exception)
        {
            throw;
        }
    }

    void mst_Port(string type)
    {
        try
        {
            if (type == "POL" && !string.IsNullOrEmpty(mst_POL))
            {
                var newValue = ssv.queryPort(mst_POL);
                if (newValue != null && newValue.PORT != MBL.polname)
                {
                    MBL.polname = newValue.PORT;
                    MBL.polcode = newValue.PORT_CODE;
                }
            }
            else if (type == "POD" && !string.IsNullOrEmpty(mst_POD))
            {
                var newValue = ssv.queryPort(mst_POD);
                if (newValue != null && newValue.PORT != MBL.podname)
                {
                    MBL.podname = newValue.PORT;
                    MBL.podcode = newValue.PORT_CODE;
                }
            }
            else if (type == "DEL" && !string.IsNullOrEmpty(mst_DEL))
            {
                var newValue = ssv.queryPort(mst_DEL);
                if (newValue != null && newValue.PORT != MBL.delName)
                {
                    MBL.delName = newValue.PORT;
                    MBL.delcode = newValue.PORT_CODE;
                }
            }
            else if (type == "POR" && !string.IsNullOrEmpty(mst_POR))
            {
                var newValue = ssv.queryPort(mst_POR);
                if (newValue != null && newValue.PORT != MBL.porname)
                {
                    MBL.porname = newValue.PORT;
                    MBL.porcode = newValue.PORT_CODE;
                }
            }
            else if (type == "Vessel" && !string.IsNullOrEmpty(mst_Vessel))
            {
                var newValue = ssv.queryVessel(mst_Vessel);
                if (newValue != null && newValue != "")
                {
                    MBL.vessel = newValue;
                }
            }
            else if (type == "Voy" && !string.IsNullOrEmpty(mst_Voy))
            {
                var newValue = ssv.queryVoy(mst_Voy);
                if (newValue != null && newValue != "")
                {
                    MBL.voy = newValue;
                }
            }
        }
        catch (Exception)
        {
            throw;
        }
    }

    void FillCont()
    {
        if (MBL.Air_type != null)
        {
            MBL.markAndNumbers = MBL.Air_type + "\n" + ssv.GetNumberandRemarkHBL(MBL.hblID);
        }
        else
        {
            MBL.markAndNumbers = "\n" + ssv.GetNumberandRemarkHBL(MBL.hblID);
        }

        MBL.description = ssv.GetDescriptionOfGoodsHBL(MBL.hblID, MBL.CustomerID);
        MBL.markAndNumbers = ssv.GetNumberandRemarkHBL(MBL.hblID);
        MBL.NoOfPackages = ssv.GetNoOfPackagesHBL(MBL.hblID);
        MBL.gross = ssv.GetSumOfGrossHBL(MBL.hblID);
        MBL.cbm = ssv.GetSumOfCBMHBL(MBL.hblID);
        MBL.say = ssv.saycontHBL(MBL.hblID);
    }
}
