                    </MudGrid>
                </MudItem>
                <MudItem xs="5" Class=" border-b-4  border-solid mud-border-primary">
                    <MudItem xs="12">
                        <MudTextField Class=" labelCustomColor" @bind-Value="MBL.bkno"
                        For="@(() => MBL.bkno)"
