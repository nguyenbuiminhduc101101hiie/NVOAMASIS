                        Label="B/L No. " />
                    </MudItem>
                    <MudItem xs="12">
                        <MudTextField Class=" labelCustomColor" @bind-Value="MBL.hbl"
                        For="@(() => MBL.hbl)"
                        AdornmentColor="@ColorTextFields"
                        Immediate="true" AutoGrow
                        Label="HBL " />
                    </MudItem>
                </MudItem>

                <MudGrid>
                    <MudItem xs="3">
                        <MudTextField Class="pa-4 labelCustomColor" @bind-Value="MBL.markAndNumbers" Lines="5"
