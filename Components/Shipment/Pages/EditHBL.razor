                        Label="Description of goods" />
                    </MudItem>
                    <MudItem xs="3" >
                        <MudGrid Style="display:flex">
                            <MudItem xs="6">
                                <MudTextField Class="pa-4 labelCustomColor text-right" @bind-Value="MBL.gross" Lines="5"
                                For="@(() => MBL.gross)"
                                AdornmentColor="@ColorTextFields"
                                Immediate="true" AutoGrow
                                Label="Gross" />
                            </MudItem>
                            <MudItem xs="6">
                                <MudTextField Class="pa-4 labelCustomColor text-right" @bind-Value="MBL.cbm" Lines="5"
                                For="@(() => MBL.cbm)" 
                                AdornmentColor="@ColorTextFields"
                                Immediate="true" AutoGrow
                                Label="Measurement" />
                            </MudItem>
                            <MudItem xs="12">
                                <MudTextField Class="pa-4 labelCustomColor" @bind-Value="MBL.shipOnboard"
                                For="@(() => MBL.shipOnboard)"
                                AdornmentColor="@ColorTextFields"
                                Immediate="true" AutoGrow
                                Label="SHIPPED ON BOARD " />
                            </MudItem>
                        </MudGrid>
                    </MudItem>
                </MudGrid>
                <MudGrid>
                    <MudItem xs="3"></MudItem>
                    <MudItem xs="6">
                        <MudTextField Class="pa-4 labelCustomColor" @bind-Value="MBL.say" Lines="2"
                        For="@(() => MBL.say)"
                        AdornmentColor="@ColorTextFields"
                        Immediate="true" AutoGrow
                        Label="SAY: " />
                    </MudItem>
                    <MudItem xs="3"></MudItem>
                </MudGrid>
                <MudGrid>
                    <MudItem xs="4" Class="border-t-4 border-b-4 border-r-4 border-solid mud-border-primary">
                        <MudAutocomplete T="string"
                                          Class="border border border-solid mud-border-primary"
                                          @bind-Value="MBL.freightPayableAt"
                                          AdornmentColor="@ColorTextFields"
                                          SearchFunc="mst_Ports"
                                          Immediate="true"
                                          MaxItems="5000"
                                          ToStringFunc="(x) => x"
                                          ResetValueOnEmptyText="false"
                                          Clearable="true" />

                        <MudTextField Class="labelCustomColor"
                                      @bind-Value="MBL.freightPayableAt"
                                      For="@(() => MBL.freightPayableAt)"
                                      AdornmentColor="@ColorTextFields"
                                      Immediate="true" AutoGrow
                                      Label="Prepaid At" />
                    </MudItem>
                    @* Hidden: Number Of Original (208060) *@
                    @* <MudItem xs="4" Class="border-t-4 border-r-4 border-solid mud-border-primary">
                        <MudTextField Class=" labelCustomColor" @bind-Value="MBL.numberOfOriginal"
                        For="@(() => MBL.numberOfOriginal)"
                        AdornmentColor="@ColorTextFields"
                        Immediate="true" AutoGrow
                        Label="Number Of Original" />
                    </MudItem> *@
                    <MudItem xs="4" Class="border-t-4 border-b-4 border-solid mud-border-primary">
                        <MudAutocomplete T="string"
                                          Class="border border border-solid mud-border-primary"
                                          @bind-Value="MBL.collectat"
                                          AdornmentColor="@ColorTextFields"
                                          SearchFunc="mst_Ports"
                                          Immediate="true"
                                          MaxItems="5000"
                                          ToStringFunc="(x) => x"
                                          ResetValueOnEmptyText="false"
                                          Clearable="true" />

                        <MudTextField Class="labelCustomColor"
                                      @bind-Value="MBL.collectat"
                                      For="@(() => MBL.collectat)"
                                      AdornmentColor="@ColorTextFields"
                                      Immediate="true" AutoGrow
                                      Label="Payable At" />
                    </MudItem>
                    <MudItem xs="4" Class="border-t-4 border-b-4 border-r-4 border-solid mud-border-primary">
                        <MudAutocomplete T="string"
                                          Class="border border border-solid mud-border-primary"
                                          @bind-Value="MBL.placeAndDate"
                                          AdornmentColor="@ColorTextFields"
                                          SearchFunc="mst_Ports"
                                          Immediate="true"
                                          MaxItems="5000"
                                          ToStringFunc="(x) => x"
                                          ResetValueOnEmptyText="false"
                                          Clearable="true" />

                        <MudTextField Class="labelCustomColor"
                                      @bind-Value="MBL.placeAndDate"
                                      For="@(() => MBL.placeAndDate)"
                                      AdornmentColor="@ColorTextFields"
                                      Immediate="true" AutoGrow
                                      Label="Place Of Issue" />
                    </MudItem>
                    <MudItem xs="4" Class="border-r-4 border-solid mud-border-primary">
                        <MudTextField Class=" labelCustomColor"
                                      @bind-Value="MBL.IssueAt"
                                      For="@(() => MBL.IssueAt)"
                                      AdornmentColor="@ColorTextFields"
                                      Immediate="true" AutoGrow
                                      Label="Issue At" />
                    </MudItem>
                    <MudItem xs="4" Class="border-solid mud-border-primary">
                        <MudNumericField T="double?"
                                         Class=" labelCustomColor"
                                         @bind-Value="MBL.ex_rate"
                                         For="@(() => MBL.ex_rate)"
                                         AdornmentColor="@ColorTextFields"
                                         Label="Exchange Rate"
                                         Format="N4"
                                         HideSpinButtons="true"
                                         Immediate="true" />
                    </MudItem>
                    @* Hidden: Freight Amount / For Delivery *@
                    @* <MudItem xs="4" Class="border-r-4 border-solid mud-border-primary">
                        <MudTextField Class=" labelCustomColor" @bind-Value="MBL.freightAmount"
                        For="@(() => MBL.freightAmount)"
                        AdornmentColor="@ColorTextFields"
                        Immediate="true" AutoGrow
                        Label="Freight Amount" />
                    </MudItem>
                    <MudItem xs="4" Class="border-r-4 border-solid mud-border-primary">
                        <MudTextField Class=" labelCustomColor" @bind-Value="MBL.forDelivery"
                        For="@(() => MBL.forDelivery)"
                        AdornmentColor="@ColorTextFields"
                        Immediate="true" AutoGrow
                        Label="For Delivery" />
                    </MudItem> *@
                    <MudItem xs="4" Class=" border-solid mud-border-primary">

                    </MudItem>
                </MudGrid>
