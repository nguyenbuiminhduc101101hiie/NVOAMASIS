<MudDialog>
    <DialogContent>
        <Index_6_0_HBL MBLDetail="detail"  Customers="Customers"/>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(()=> MudDialog!.Cancel())">Close</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter] public M_MBL? detail { get; set; } = default!;
