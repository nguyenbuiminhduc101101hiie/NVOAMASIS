private string SelectedRowClassFunc(M_HBLViTriLoHang Sis, int rowNumber)
{
    if (selectedRowNumber == rowNumber)
    {
        selectedRowNumber = -1;
        return string.Empty;
    }
    else if (mudTable.SelectedItem != null && mudTable.SelectedItem.Equals(Sis))
    {
        selectedRowNumber = rowNumber;
        return "selected";
    }
    else
    {
        return string.Empty;
    }
}
