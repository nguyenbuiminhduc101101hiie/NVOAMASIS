{
    try
    {
        _loading = true;
        // Simulate asynchronous loading to demonstrate a loading indicator
        Listdata.Clear();
        StateHasChanged();
        Listdata = await shipsv.GetlistVitrilohang(HBLDetail!.hblID);
        await LoadMap(Listdata);
