@inject HistoryLogService HistoryLogService
@using System.Text.Json;

<MudDialog>
    <DialogContent>
        <MudStack Row Class="pa-4">
            @if (isHDDR)
            {
                <MudNumericField @bind-Value="cnHDDR.tongtien" Label="Tổng tiền" Format="#,##0.##" Culture="@(new System.Globalization.CultureInfo("en-US"))" HideSpinButtons />
                <MudCheckBox Label="Max" T="bool" Checked="false" CheckedChanged="CheckChange" Size="Size.Small" Color="Color.Primary" />
            }
            else
            {
                <MudNumericField @bind-Value="cnHDDV.tongtien" Label="Tổng tiền" Format="#,##0.##" Culture="@(new System.Globalization.CultureInfo("en-US"))" HideSpinButtons />
                <MudCheckBox Label="Max" T="bool" Checked="false" CheckedChanged="CheckChange" Size="Size.Small" Color="Color.Primary" />
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Submit" Color="Color.Primary">Create</MudButton>
        <MudButton OnClick="Cancel" Color="Color.Secondary">Cancel</MudButton>
    </DialogActions>
</MudDialog>
@inject AccountService asv
@inject ShipmentService shipsv
@inject ISnackbar Snackbar
@code {
    [CascadingParameter] public MudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public M_HoaDonDauRa HDDR { get; set; } = default!;
    [Parameter] public M_HoaDonDauVao HDDV { get; set; } = default!;
    [Parameter] public bool isHDDR { get; set; } = default!;
    M_CongNoHoaDonDauRa cnHDDR = new();
    M_CongNoHoaDonDauVao cnHDDV = new();
    private async Task Submit()
    {
        var usr = asv.GetUserDetail().Usr;
        if (isHDDR)
        {
            cnHDDR.hoadondauraid = HDDR.hoadondauraid;
            cnHDDR.dateupdate = cnHDDR.ngaytra = DateTime.Now;
            cnHDDR.userupdate = usr;
            cnHDDR.tiente = HDDR.tiente;
            cnHDDR.approve = cnHDDR.continued = cnHDDR.editable = true;
            var rs = await shipsv.CreateCongNoHoaDonDauRaMBL(cnHDDR);
      
            await HistoryLogService.LogAsync(usr, "ADD Cong No Hoa Don Dau Ra", "Shipment", cnHDDR.hoadondauraid, "", cnHDDR);
            CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
        }
        else
        {
            cnHDDV.hoadondauvaoid = HDDV.hoadondauvaoid;
            cnHDDV.dateupdate = cnHDDV.ngaytra = DateTime.Now;
            cnHDDV.userupdate = usr;
            cnHDDV.tiente = HDDV.tiente;
            cnHDDV.approve = cnHDDV.continued = cnHDDV.editable = true;
            var rs = await shipsv.CreateCongNoHoaDonDauVaoMBL(cnHDDV);
            await HistoryLogService.LogAsync(usr, "ADD Cong No Hoa Don Dau Vao", "Shipment", cnHDDV.hoadondauvaoid, "", cnHDDV);
            CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
        }
        MudDialog.Close();
    }
    private void Cancel() => MudDialog.Cancel();
    void CallSnackBar(string message, MudBlazor.Severity severity)
    {

        Snackbar.Configuration.SnackbarVariant = Variant.Filled;
        Snackbar.Configuration.MaxDisplayedSnackbars = 3;
        Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopRight;
        Snackbar.Add(message, severity);
    }
    void CheckChange(bool check)
    {
        if (check)
        {
            if (isHDDR)
                cnHDDR.tongtien = HDDR.thanhtiensauthue;
            else cnHDDV.tongtien = HDDV.thanhtiensauthue;
        }
    }
}
