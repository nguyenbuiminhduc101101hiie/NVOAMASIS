@inject CustomerService csv
@inject SupportServices supsv
@inject SharedServices ssv
@inject AccountService asv
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject ShipmentService shipsv
@inject IStringLocalizer<SharedResource> Localizer


<MudDataGrid T="M_Theodoilohang" Items="@Listdata" Filterable="true" @ref="mudTable"
                FilterMode="@DataGridFilterMode.Simple" Dense="true" Virtualize="true"
                FixedHeader="true" FixedFooter="true" HeaderClass="no-wrap" FooterClass="no-wrap"
                ReadOnly="false" CommittedItemChanges="@CommittedItem" RowClassFunc="@SelectedRowClassFunc"
                RowClick="@RowClicked" RowContextMenuClick="RowRightClicked"
             ColumnResizeMode="ResizeMode.Column" Loading="_loading" ShowColumnOptions="false">
    <Columns>
        <TemplateColumn CellClass="d-flex justify-end" Filterable="false" ShowColumnOptions="false" Sortable="false">
            <HeaderTemplate>
                <MudStack Row="true" Justify="Justify.FlexStart" Spacing="2">

                    <!-- Nút Reload -->
                    <MudTooltip Text="@Localizer["Reload"]">
                        <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                                       Color="Color.Success"
                                       Size="Size.Small"
                                       OnClick="Refresh"
                                       Disabled="@(HBLDetail!.hblID == Guid.Empty)"
                                       Variant="Variant.Filled"
                                       Class="btn-compact" />
                    </MudTooltip>

                    <!-- Nút Add -->
                    <MudTooltip Text="@Localizer["New"]">
                        <MudIconButton Icon="@Icons.Material.Filled.Add"
                                       Color="Color.Success"
                                       Size="Size.Small"
                                       OnClick="AddItem"
                                       Disabled="@(HBLDetail!.hblID == Guid.Empty)"
                                       Variant="Variant.Filled"
                                       Class="btn-compact" />
                    </MudTooltip>
                    <MudTooltip Text="@Localizer["Help"]">
                        <a href="HDSDhtml/Huong_dan_Tab_Theo_Doi_Lo_Hang.html" target="_blank">
                            <MudIconButton Icon="@Icons.Material.Filled.Info"
                                           Color="Color.Info"
                                           Size="Size.Small"
                                           Variant="Variant.Filled"
                                           Class="btn-compact" />
                        </a>
                    </MudTooltip>
                </MudStack>
            </HeaderTemplate>
            <CellTemplate>
                <MudIconButton Size="@Size.Small" Icon="@Icons.Material.Outlined.Edit" OnClick="@context.Actions.StartEditingItemAsync" />
                <MudIconButton Size="@Size.Small" Icon="@Icons.Material.Outlined.Delete" OnClick="@(()=>DeleteItem(context.Item))" />
            </CellTemplate>
        </TemplateColumn>
        <PropertyColumn Property="x => idtohbl(x.outboundid)" Title="@Localizer["HBL"]" Required="false" IsEditable="false"><EditTemplate></EditTemplate></PropertyColumn>
        <PropertyColumn Property="x => x.Items" Title="@Localizer["Items"]">
            <EditTemplate>
                <MudAutocomplete @bind-Value="context.Item.Items" Label="@Localizer["Items"]" Required
                                 SearchFunc="SearchItems" CoerceValue/>
            </EditTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x => x.Remarks" Title="@Localizer["Remarks"]">
            <EditTemplate>
                <MudTextField @bind-Value="context.Item.Remarks" Lines="3" AutoGrow Label="@Localizer["Remarks"]" Required/>
            </EditTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x => x.Timer" Title=@Localizer["Timer"]>
            <EditTemplate>
                <MudStack Row>
                    <MudDatePicker DateChanged="@((t) => context.Item.Timer = t!.Value.ToString("dd/MMM/yyyy",_en))"
                                   Label="@Localizer["Timer"]"  DateFormat="dd/MMM/yyyy" Culture="_en"/>
                    <MudTextField ReadOnly @bind-Value="context.Item.Timer" Required />
                </MudStack>
            </EditTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x => x.approve" Required="false" Title="@Localizer["Approve"]">
            <CellTemplate>
                <MudCheckBox @bind-Checked="context.Item.approve" ReadOnly Culture="_en" />
            </CellTemplate>
            <EditTemplate>
                <MudCheckBox @bind-Checked="context.Item.approve" Label="@Localizer["Approve"]" Disabled="@canapprove" />
            </EditTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x => x.validUser" Title="@Localizer["Valid User"]" Required="false" >
            <EditTemplate>
                <MudAutocomplete T="string" @bind-Value="@search_user" Label="@Localizer["Valid User"]" AutoFocus="false"
                                 SearchFunc="SearchUser" MaxItems="50" />
                <MudStack Row>
                    <MudItem>
                        <MudButton Class="pl-4 pa-10" Style="background-color: #007BFF; color: white;" Size="Size.Small" Color="Color.Primary" OnClick="@(() => context.Item.validUser += (search_user + ";"))">>>></MudButton>
                    </MudItem>
                    <MudTextField @bind-Value="context.Item.validUser" Label="@Localizer["Valid User"]" Lines="4" Required />
                </MudStack>
            </EditTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x => x.ngaychungtu" Title="@Localizer["Document Date"]" Required="false">
            <EditTemplate>
                <MudStack Row>
                    <MudDatePicker Label="@Localizer["Document Date"]" DateChanged="@((t) => context.Item.ngaychungtu = t!.Value.ToString("dd/MMM/yyyy"))" DateFormat="dd/MMM/yyyy" Culture="_en" />
                    <MudTextField @bind-Value="context.Item.ngaychungtu" ReadOnly Culture="_en"/>
                </MudStack>
            </EditTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x => x.bangoc" Title="@Localizer["Original"]" Required="false" />
        <PropertyColumn Property="x => x.intheodoi" Title="@Localizer["Printed Track"]" Required="false" >
            <CellTemplate>
                <MudCheckBox @bind-Checked="context.Item.intheodoi" ReadOnly/>
            </CellTemplate>
            <EditTemplate>
                <MudCheckBox @bind-Checked="context.Item.intheodoi" Label="@Localizer["Printed Track"]" />
            </EditTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x => x.UserUpdate" Title="@Localizer["UserUpdate"]" IsEditable="false" Required="false" />
        <PropertyColumn Property="x => x.dateUpdate" Title="@Localizer["Dateupdate"]" IsEditable="false" Required="false" />
    </Columns>
</MudDataGrid>
@using System.Globalization﻿﻿

@code {

    [Parameter] public M_HBL? HBLDetail { get; set; } = default!;
    [CascadingParameter] MudDialogInstance? MudDialog { get; set; }
    CultureInfo _en = CultureInfo.GetCultureInfo("en-US");

    void CallSnackBar(string message, MudBlazor.Severity severity)
    {

        Snackbar.Configuration.SnackbarVariant = Variant.Filled;
        Snackbar.Configuration.MaxDisplayedSnackbars = 3;
        Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopRight;
        Snackbar.Add(message, severity);
    }

    private void Submit()
    {
        MudDialog!.Close();
    }
    bool isMBL;
    void Cancel() => MudDialog!.Cancel();
    string usr;
    bool canapprove = true;
    List<string?> Users = new List<string?>();
    List<string> Items = new List<string>();
    protected async override Task OnInitializedAsync()
    {
        try
        {
            
        
            if (HBLDetail.hblID == Guid.Empty)
            {
                CallSnackBar("Vui lòng chọn 1 dòng HBL", MudBlazor.Severity.Warning);
                return;
            }
            HBLs = await shipsv.GetListHBLALL();
            usr = asv.GetAuth().Result.User.Identity!.Name!;
            canapprove = !await ssv.CheckPermission(usr, "approve", "HBL");
            var listusr = await asv.GetListUser();
            Users = listusr.Select(x => x.Usr).Distinct().ToList();
            Items = await shipsv.GetListItemTheoDoiLoHang();
            await Refresh();
        }
        catch (Exception ex)
        {
            CallSnackBar("Please slow down!", MudBlazor.Severity.Error);

        }
    }
    bool _loading = false;
    List<M_Theodoilohang> Listdata = new List<M_Theodoilohang>();
    List<M_HBL> HBLs = new List<M_HBL>();
    M_Theodoilohang detail;
    async Task Refresh()
    {
        try
        {
            _loading = true;
            // Simulate asynchronous loading to demonstrate a loading indicator
            Listdata.Clear();
            StateHasChanged();
            await Task.Delay(500);
            if (!await ssv.CheckPermission(usr, "View", "HBL"))
            {
                CallSnackBar("You have not access to view", MudBlazor.Severity.Warning);
                return;
            }
            Listdata = await shipsv.GetListTheoDoiLoHang(HBLDetail!.hblID);
        }
        finally
        {
            _loading = false;
        }

    }
    MudDataGrid<M_Theodoilohang> mudTable;
    async Task AddItem()
    {
        var item = new M_Theodoilohang();
        Listdata.Add(item);
        await mudTable.SetEditingItemAsync(Listdata.LastOrDefault()!);
    }

    async Task DeleteItem(M_Theodoilohang item)
    {
        if (item == null)
        {
            CallSnackBar("you must select 1 row.", MudBlazor.Severity.Warning);
            return;
        }
        if (item.approve.HasValue ? item.approve.Value : false)
        {
            CallSnackBar("you can't delete approve row", MudBlazor.Severity.Warning);
            return;
        }
        var resultMess = await DialogService.ShowMessageBox(
                "Warning",
                "Deleting can not be undone!",
                yesText: "Delete!", cancelText: "Cancel");

        if (resultMess.HasValue)
        {
            var rs = await shipsv.DeleteTheoDoiLoHang(item);
            CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
            await Refresh();
        }

    }
    async Task CommittedItem(M_Theodoilohang item)
    {
        item.outboundid = HBLDetail!.hblID;
        item.UserUpdate = usr;
        item.dateUpdate = DateTime.Now.ToString("MMM dd yyyy  h:mmtt", _en);
        var rs = item.theodoilohangID != Guid.Empty ? await shipsv.UpdateTheoDoiLoHang(item) : await shipsv.CreateTheoDoiLoHang(item);
        CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
        await Refresh();
    }

    private int selectedRowNumber = -1;
    private string SelectedRowClassFunc(M_Theodoilohang Sis, int rowNumber)
    {
        if (selectedRowNumber == rowNumber)
        {
            selectedRowNumber = -1;
            return string.Empty;
        }
        else if (mudTable.SelectedItem != null && mudTable.SelectedItem.Equals(Sis))
        {
            selectedRowNumber = rowNumber;
            return "selected";
        }
        else
        {
            return string.Empty;
        }
    }
    async void RowClicked(DataGridRowClickEventArgs<M_Theodoilohang> args)
    {
        if(args.Item == detail)
        {
            detail = null!;
            return;
        }
        detail = args.Item;
    }

    void RowRightClicked(DataGridRowClickEventArgs<M_Theodoilohang> args)
    {

    }
    string idtohbl(Guid? hblid)
    {
        if (hblid == null || hblid == Guid.Empty)
            return string.Empty;
        return HBLs.FirstOrDefault(x => x.hblID == hblid)!.hbl!;
    }

    string? selectedTimer(DateTime date, M_Theodoilohang item)
    {
        item.Timer = date.ToString("dd/MMM/yyyy");
        return date.ToString("dd/MMM/yyyy"); ;
    }

    private async Task<IEnumerable<string?>> SearchItems(string? text)
    {
        try
        {
            if (string.IsNullOrWhiteSpace(text))
            {
                return Items;
            }
            // MBL.Porname = mst_Consignee;
            return Items.Where(x => x.Contains(text, StringComparison.OrdinalIgnoreCase));
        }
        catch (Exception)
        {
            throw;
        }
    }
    private async Task<IEnumerable<string?>> SearchUser(string? text)
    {
        try
        {
            if (string.IsNullOrWhiteSpace(text))
            {
                return Users;
            }
            // MBL.Porname = mst_Consignee;
            return Users.Where(x => !string.IsNullOrEmpty(x) && x.Contains(text, StringComparison.OrdinalIgnoreCase));
        }
        catch (Exception)
        {
            throw;
        }
    }
    string search_user;
}