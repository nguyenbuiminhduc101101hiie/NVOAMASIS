<MudDialog>
    <DialogContent>

        <MudAutocomplete T="double" Required="true"
                         @bind-Value="vat_input"
                         Label="Chọn VAT %"
                         SearchFunc="SearchType"
                         ToStringFunc="x => x.ToString()" 
                         Clearable="true" />


    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => Muddialog.Cancel())">Close</MudButton>
        @*   <MudButton OnClick="@(()=> Muddialog.Close(DebitSelected))" Color="Color.Primary" Disabled="DebitSelected == null">Ok</MudButton> *@
        <MudButton OnClick="@(() => Muddialog.Close(DialogResult.Ok((vat_input))))"
                   Color="Color.Primary">
            Ok
        </MudButton>

    </DialogActions>
</MudDialog>
@inject ShipmentService ssv
@code {
    [CascadingParameter] public MudDialogInstance Muddialog { get; set; }

    double vat_input;
    List<double> list_vat = new List<double>
    {
        0,
        5,
        10,
        15,
        20,
        25,
        30
    };

    private Task<IEnumerable<double>> SearchType(string? text)
    {
        var items = list_vat.Distinct();

        if (string.IsNullOrWhiteSpace(text))
            return Task.FromResult(items);

        var result = items
            .Where(x => x.ToString().Contains(text, StringComparison.OrdinalIgnoreCase));

        return Task.FromResult(result);
    }

}
