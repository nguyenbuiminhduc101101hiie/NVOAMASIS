    private List<DebitCreditTemplate> _templates = new();

    async Task OpenAddDialog()
    {
        _templates = await supsv.GetAllDebitCreditAsync();
        var charges = await supsv.GetListCharge();
        var parameters = new DialogParameters {
                ["Templates"] = _templates.Where(x=>x.UserCreate == usr).ToList(),
                ["Charges"] = charges,
                ["Customers"] = Customers,
                ["usr"] = usr
        };
        var options = new DialogOptions { CloseButton = false, DisableBackdropClick = true, ClassBackground = "class-dialog-custom", MaxWidth = MaxWidth.ExtraExtraLarge, FullWidth=true };

        var dialog = DialogService.Show<AddDebitCreditTemplate>("Quản lý các phí Debit Credit mặc định", parameters, options);
        var result = await dialog.Result;
        if (!result.Canceled)
        {
            var edited = (List<DebitCreditTemplate>)result.Data!;
            await PersistChangesAsync(edited);
            Snackbar.Add("Lưu thành công", MudBlazor.Severity.Success);
        }
    }
    private async Task PersistChangesAsync(List<DebitCreditTemplate> edited)
    {
        // 1. Xóa
        var toDelete = _templates.Where(x => edited.All(e => e.Id != x.Id));
        foreach (var d in toDelete)
            await supsv.DeleteDebitCreditAsync(d.Id);

        // 2. Thêm
        var toAdd = edited.Where(x => _templates.All(e => e.Id != x.Id));
        foreach (var a in toAdd)
            await supsv.AddDebitCreditAsync(a);

        // 3. Cập nhật
        var toUpdate = edited.Where(x => _templates.Any(e => e.Id == x.Id));
        foreach (var u in toUpdate)
            await supsv.UpdateDebitCreditAsync(u);
    }

    private async Task OnRowDoubleClick(M_Job job)
    {
        // 1. Xóa hết filter cũ
        await mudTable.ClearFiltersAsync();
        chkSearchAd = false;

        // 2. Tạo FilterDefinition cho JobNo == job.JobNo
        var filter = new FilterDefinition<M_Job>
            {
                FilterFunction = x => x.JobNo == job.JobNo,
                Title = nameof(M_Job.JobNo),
                Operator = "equals",
                Value = job.JobNo
            };

        // 3. Thêm filter vào grid
        await mudTable.AddFilterAsync(filter);
        mudTable.ToggleFiltersMenu();
        StateHasChanged();
    }
