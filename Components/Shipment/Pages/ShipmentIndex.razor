﻿
@page "/shipment"
@inject CustomerService csv
@inject SupportServices supsv
@inject SharedServices ssv
@inject AccountService asv
@inject ISnackbar Snackbar
@inject ShipmentService shipsv
@inject IDialogService DialogService
@inject IStringLocalizer<SharedResource> Localizer
@attribute [Authorize]
@inject HistoryLogService HistoryLogService
@using System.Text.Json;

<PageTitle>@Localizer["Shipment"]</PageTitle>
<MudContainer MaxWidth=MaxWidth.False>
    <MudStack Row Justify="Justify.FlexStart" Style="margin-bottom:15px; margin-top:15px; min-width:calc(100vw - 20vw);">
        <MudSwitch @bind-Value="chkSearchAd" @bind-Value:after="@(() => isExpand = chkSearchAd)" Label="Search" Color="Color.Primary" Size="Size.Small" />
         <MudExpansionPanels>
            <MudExpansionPanel Text="Searching data from HBL" Icon="@Icons.Material.Filled.Search" @bind-IsExpanded="isExpand" Disabled="@(!chkSearchAd)">
                <MudGrid>
                    <MudGrid>
                        <MudItem xs="4">
                            <MudAutocomplete @bind-Value="SearchHBL" Label="HBL No" SearchFunc="SearchFuncHBL" ResetValueOnEmptyText Clearable />
                        </MudItem>
                        <MudItem xs="8">
                            <MudStack Row>
                                <MudAutocomplete @bind-Value="SearchSoHDNoiBo" Label="Số hóa đơn nội bộ" SearchFunc="SearchFuncSoHDnoibo" ResetValueOnEmptyText Clearable />
                                <MudAutocomplete @bind-Value="SearchSoHDDienTu" Label="Số hóa đơn điện tử" SearchFunc="SearchFuncSoHDdientu" ResetValueOnEmptyText Clearable />
                                <MudAutocomplete @bind-Value="SearchDebitNo" Label="Số Debit" SearchFunc="SearchFuncSoDebit" ResetValueOnEmptyText Clearable />
                            </MudStack>
                        </MudItem>
                    </MudGrid>
                    <MudItem xs="3">
                        <MudStack Row>
                            <MudAutocomplete @bind-Value="SearchPOL" Label="POL" SearchFunc="SearchPort" ResetValueOnEmptyText Clearable />
                            <MudAutocomplete @bind-Value="SearchPOD" Label="POD" SearchFunc="SearchPort" ResetValueOnEmptyText Clearable />
                        </MudStack>
                    </MudItem>
                    <MudItem xs="9">
                        <MudStack Row>
                            <MudAutocomplete @bind-Value="SearchDescription" Label="Description" SearchFunc="SearchFuncDes" ResetValueOnEmptyText Clearable />
                            <MudAutocomplete @bind-Value="SearchShipper" Label="Shipper" SearchFunc="SearchFucnShipper" ResetValueOnEmptyText Clearable />
                            <MudAutocomplete @bind-Value="SearchConsignee" Label="Consignee" SearchFunc="SearchFucnConsn" ResetValueOnEmptyText Clearable />
                            <MudAutocomplete @bind-Value="SearchNotify" Label="Notify" SearchFunc="SearchFucnNotify" ResetValueOnEmptyText Clearable />
                        </MudStack>
                    </MudItem>
                    <MudItem xs="4">
                        <MudAutocomplete Style="min-width:180px;" @bind-Value="SearchCusID" Label="Customer" SearchFunc="SearchCustomer" ToStringFunc="CusidtoCusCode" ResetValueOnEmptyText Clearable />
                    </MudItem>
                    <MudItem xs="8">
                        <MudStack Row>
                            <MudAutocomplete @bind-Value="SearchContNo" Label="Container No" SearchFunc="SearchFuncContNo" ResetValueOnEmptyText Clearable />
                            <MudAutocomplete @bind-Value="SearchPKGs" Label="PKGs" SearchFunc="SearchFucnPKGs" ResetValueOnEmptyText Clearable />
                            <MudAutocomplete @bind-Value="SearchKGsCode" Label="PKGs Code" SearchFunc="SearchFucnPKGsCode" ResetValueOnEmptyText Clearable />
                            <MudAutocomplete @bind-Value="SearchCBM" Label="CBM" SearchFunc="SearchFucnCBM" ResetValueOnEmptyText Clearable />
                            <MudAutocomplete @bind-Value="SearchGrossWT" Label="Gross WT." SearchFunc="SearchFucnGrossWT" ResetValueOnEmptyText Clearable />
                        </MudStack>
                    </MudItem>
                </MudGrid>
            </MudExpansionPanel>
        </MudExpansionPanels>
    </MudStack>
    <MudStack Row="true" Style="margin-bottom:15px;" Class="gap-12">
        <MudTooltip Text="@Localizer["Reload"]">
            <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                           Color="Color.Success"
                           Size="Size.Small"
                           OnClick="Refresh"
                           Variant="Variant.Filled"
                           Class="btn-compact" />
        </MudTooltip>
        <MudTooltip Text="@Localizer["New"]">
            <MudIconButton Icon="@Icons.Material.Filled.Add"
                           Color="Color.Success"
                           Size="Size.Small"
                           OnClick="AddItem" Disabled
                           Variant="Variant.Filled"
                           Class="btn-compact" />
        </MudTooltip>
        <MudTooltip Text="@Localizer["Duplicate"]">
            <MudIconButton OnClick="@(() => DuplicateItem())" Disabled
                    Size="Size.Small" 
                    Color="Color.Tertiary" 
                    Variant="Variant.Filled"
                    Icon="@Icons.Material.Filled.CopyAll"
                           Class="btn-compact" />
         </MudTooltip>
         <MudTooltip Text="@Localizer["Thêm Debit/Credit Template"]">
            <MudIconButton OnClick="@(() => OpenAddDialog())"
                           Size="Size.Small"
                           Color="Color.Primary"
                           Variant="Variant.Filled"
                           Icon="@Icons.Material.Filled.ContentPasteSearch"
                           Class="btn-compact" />
        </MudTooltip>
        <MudTooltip Text="HBL & MBL">
            <MudIconButton OnClick="@( () => {
                            switch (jobdetail?.Loai)
                            {
                                case "Customs":
                                    OpenDialogCustoms();
                                    break;
                                case "Truck":
                                    OpenDialogTrucking();
                                    break;
                                default:
                                    OpenDialog();
                                    break;
                            }
                        })"
                    Size="Size.Small" Color="Color.Success" Variant="Variant.Filled"
                   Icon="@Icons.Material.Filled.NavigateNext" Class="btn-compact"/>
         </MudTooltip>
        <MudTooltip Text="@Localizer["Report"]">
            <MudIconButton OnClick="@(() => OpenShipmentReport())"
                           Size="Size.Small"
                           Color="Color.Tertiary"
                           Variant="Variant.Filled"
                           Icon="@Icons.Material.Filled.AddChart"
                           Class="btn-compact" />
        </MudTooltip>
        <MudSwitch @bind-Value="chkSI" Label="SI" Color="Color.Primary" Size="Size.Small" />
        <MudSwitch @bind-Value="chkSE" Label="SE" Color="Color.Primary" Size="Size.Small"/>
        <MudSwitch @bind-Value="chkAI" Label="AI" Color="Color.Primary" Size="Size.Small"/>
        <MudSwitch @bind-Value="chkAE" Label="AE" Color="Color.Primary" Size="Size.Small"/>
        <MudSwitch @bind-Value="chkTruck" Label="Truck" Color="Color.Primary" Size="Size.Small" />
        <MudSwitch @bind-Value="chkCustoms" Label="Customs" Color="Color.Primary" Size="Size.Small" />
        @* <MudSwitch @bind-Value="chkSameCus" T="bool" CheckedChanged="@OnSameCustomerToggle" Label="More" Color="Color.Primary" Size="Size.Small"  /> *@
    </MudStack>
    <MudDataGrid T="M_Job" Items="@Listdata" Filterable="true" @ref="mudTable" Class="table-shipment-bg"
                 FilterMode="@DataGridFilterMode.Simple" Dense="true" Virtualize="true" Height=@($"calc(100vh - 33vh {(isExpand ? " - 13vh" : "")});") QuickFilter="_quickFilter"
                 FixedHeader="true" FixedFooter="true" HeaderClass="no-wrap" FooterClass="no-wrap" SortMode="SortMode.Single"
                 ReadOnly="false" CommittedItemChanges="@CommittedItem" RowClassFunc="@SelectedRowClassFunc"
                 RowClick="@RowClicked" RowContextMenuClick="RowRightClicked" Bordered="true" RowClass="no-wrap-cell"
                 ColumnResizeMode="ResizeMode.Column" Loading="_loading" ShowColumnOptions="false" @ondblclick="@(() => OnRowDoubleClick(jobdetail))">
        <Columns>
            <HierarchyColumn T="M_Job" ButtonDisabledFunc="@(x => x.Approve.HasValue && x.Approve.Value)" />
            <TemplateColumn CellClass="d-flex justify-end" Filterable="false" Sortable="false">
                <CellTemplate>
                    <MudIconButton Size="@Size.Small" Icon="@Icons.Material.Outlined.Edit" OnClick="@(() => {
                           
                                 detail = JsonSerializer.Deserialize<M_Job>(JsonSerializer.Serialize(context.Item));

                               context.Actions.StartEditingItemAsync();
                         
                         
                       })" Disabled />
                    <MudIconButton Size="@Size.Small" Icon="@Icons.Material.Outlined.Delete" OnClick="@(()=>DeleteItem(context.Item))" Disabled />
                </CellTemplate>
            </TemplateColumn>
            <PropertyColumn Property="x => x.JobNo" Title="@Localizer["Job No"]" Required CellStyleFunc="_cellStyleFunc" >
                <EditTemplate>
                    <MudTextField @bind-Value="context.Item.JobNo" Immediate Label="@Localizer["Job No"]" Disabled Required />
                    <MudDatePicker Label="@Localizer["Selected Date Create Job"]" DateChanged="((t)=>UpdateJobNo(context.Item,(DateTime)t!))" ImmediateText DateFormat="MM/yyyy" />
                </EditTemplate>
            </PropertyColumn>
            <PropertyColumn Property="x => CountMBL(x.JobID)" Title="@Localizer["Total MBL"]" IsEditable="false" CellStyleFunc="_cellStyleFunc" Filterable="false" ><EditTemplate></EditTemplate></PropertyColumn>
            <PropertyColumn Property="x => CountHBL(x.JobID)" Title="@Localizer["Total HBL"]" IsEditable="false" CellStyleFunc="_cellStyleFunc" Filterable="false" ><EditTemplate></EditTemplate></PropertyColumn>
            <PropertyColumn Property="x => joinmbl(x.JobID)" Title="@Localizer["MBL"]" IsEditable="false" CellStyleFunc="_cellStyleFunc" ><EditTemplate></EditTemplate></PropertyColumn>
            <PropertyColumn Property="x => joinhbl(x.JobID)" Title="@Localizer["HBL"]" IsEditable="false" CellStyleFunc="_cellStyleFunc" ><EditTemplate></EditTemplate></PropertyColumn>
            
            <PropertyColumn Property="x => x.FLC" Title="@Localizer["FLC"]" Required CellStyleFunc="_cellStyleFunc">
                <EditTemplate>
                    <MudSelect @bind-Value="context.Item.FLC" Label="@Localizer["FLC"]">
                        <MudSelectItem Value="@("F")">F</MudSelectItem>
                        <MudSelectItem Value="@("L")">L</MudSelectItem>
                        <MudSelectItem Value="@("C")">C</MudSelectItem>
                    </MudSelect>
                </EditTemplate>
            </PropertyColumn>
            <PropertyColumn Property="x => x.Loai" Title="@Localizer["Type"]" Required CellStyleFunc="_cellStyleFunc">
                <EditTemplate>
                    <MudSelect @bind-Value="context.Item.Loai" Label="@Localizer["Type"]">
                        <MudSelectItem Value="@("AI")">AI</MudSelectItem>
                        <MudSelectItem Value="@("AE")">AE</MudSelectItem>
                        <MudSelectItem Value="@("SI")">SI</MudSelectItem>
                        <MudSelectItem Value="@("SE")">SE</MudSelectItem>
                        <MudSelectItem Value="@("Truck")">Truck</MudSelectItem>
                        <MudSelectItem Value="@("Customs")">Customs</MudSelectItem>
                    </MudSelect>
                </EditTemplate>
            </PropertyColumn>
            <PropertyColumn Property="x => x.statusJob" Title="@Localizer["Status"]" Required CellStyleFunc="_cellStyleFunc">
                <EditTemplate>
                    <MudSelect @bind-Value="context.Item.statusJob" Label="@Localizer["Status"]">
                        @foreach (var item in trangthais)
                        {
                            <MudSelectItem Value="item">@item</MudSelectItem>
                        }
                    </MudSelect>
                </EditTemplate>
            </PropertyColumn>
            <PropertyColumn Property="x => x.CompanyCode" Title="@Localizer["Company Code"]" CellStyleFunc="_cellStyleFunc">
                <EditTemplate>
                    <MudSelect @bind-Value="context.Item.CompanyCode" Label="@Localizer["Company Code"]">
                        <MudSelectItem Value="@("PASL")">PASL</MudSelectItem>
                        <MudSelectItem Value="@("VietStar")">VietStar</MudSelectItem>
                        <MudSelectItem Value="@("AMSS")">AMSS</MudSelectItem>
                        <MudSelectItem Value="@("HDS")">HDS</MudSelectItem>
                    </MudSelect>
                </EditTemplate>
            </PropertyColumn>
            <PropertyColumn Property="x => formatDate(x.Datecreate)" Title="@Localizer["Date Create"]" IsEditable="false" Required="false" CellStyleFunc="_cellStyleFunc"><EditTemplate></EditTemplate></PropertyColumn>
            <PropertyColumn Property="x=>x.Userupdate" Title="@Localizer["UserUpdate"]" IsEditable="false" Required="false" CellStyleFunc="_cellStyleFunc"><EditTemplate></EditTemplate></PropertyColumn>
            <PropertyColumn Property="x=> formatDate(x.Dateupdate)" Title="@Localizer["Dateupdate"]" IsEditable="false" Required="false" CellStyleFunc="_cellStyleFunc"><EditTemplate></EditTemplate></PropertyColumn>
            <PropertyColumn Property="x=>x.Approve" Title="@Localizer["Approve"]" IsEditable="false" Required="false" CellStyleFunc="_cellStyleFunc">
                <CellTemplate>
                    <MudCheckBox @bind-Checked="context.Item.Approve" @bind-Value="context.Item.Approve" @bind-Value:after="@(()=>UpdatebyCheckboxClick(context.Item))" />
                </CellTemplate>
                <EditTemplate>
                </EditTemplate>
            </PropertyColumn>
            <PropertyColumn Property="x=>x.Editable" Title="@Localizer["Editable"]" IsEditable="false" Required="false" CellStyleFunc="_cellStyleFunc">
                <CellTemplate>
                    <MudCheckBox @bind-Checked="context.Item.Editable" @bind-Value="context.Item.Editable" @bind-Value:after="@(()=>UpdatebyCheckboxClick(context.Item))" />
                </CellTemplate>
                <EditTemplate></EditTemplate>
            </PropertyColumn>
        </Columns>
        <ChildRowContent>
            @switch (context.Item.Loai)
            {
                case "Customs":
                    <HQ JobDetail="context.Item" Customers="Customers" />
                    break;
                case "Truck":
                    <Trucking__MBL JobDetail="context.Item" Customers="Customers" />
                    break;
                default:
                    <IndexMBL JobDetail="context.Item" Customers="Customers" />
                    break;
            }
        </ChildRowContent>
    </MudDataGrid>
</MudContainer>

@code {
       M_Job detail;
    void CallSnackBar(string message, MudBlazor.Severity severity)
    {

        Snackbar.Configuration.SnackbarVariant = Variant.Filled;
        Snackbar.Configuration.MaxDisplayedSnackbars = 3;
        Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopRight;
        Snackbar.Add(message, severity);
    }

    string usr;
    AuthUser userdetail;
    List<string> trangthais = new List<string>();
    List<TrangThai> tts = new List<TrangThai>();
    List<M_Customer> Customers = new List<M_Customer>();
    protected async override Task OnInitializedAsync()
    {
        try
        {


            userdetail = asv.GetUserDetail();
            Customers = await csv.GetList(userdetail);
            tts = await supsv.GetListTrangThai();
            trangthais = tts.Where(x => x.Tieude.ToLower() == "job").OrderBy(x=>x.Noidung).Select(x=>x.Noidung).ToList();
            usr = asv.GetAuth().Result.User.Identity!.Name!;
            //await Refresh();
        }
        catch (Exception ex)
        {
            CallSnackBar("Please slow down!", MudBlazor.Severity.Error);

        }
    }
    
    bool _loading = false;
    List<M_Job> Listdata = new List<M_Job>();
    List<M_MBL> ListMBLs = new List<M_MBL>();
    List<M_HBL> ListHBLs = new List<M_HBL>();
    List<M_Container> ListConts = new List<M_Container>();
    List<M_Debit> ListDebits = new List<M_Debit>();
    List<M_HoaDonDauRa> ListHoaDonDRa = new List<M_HoaDonDauRa>();
    List<M_HoaDonDauVao> ListHoaDonDVao = new List<M_HoaDonDauVao>();
    M_Job jobdetail;
    async Task Refresh()
    {
        try
        {
            _loading = true;
            Listdata.Clear();
            await Task.Delay(500);
            StateHasChanged();
            ListMBLs = await shipsv.GetListMBLALL();
            ListHBLs = await shipsv.GetListHBLALL();
            ListConts = shipsv.GetListContainerAll();
            ListDebits = await shipsv.GetListDebitALL();
            ListHoaDonDRa = await shipsv.GetListHoaDonDauRaALL();
            ListHoaDonDVao = await shipsv.GetListHoaDonDauVaoALL();
            jobdetail = null;
            // Simulate asynchronous loading to demonstrate a loading indicator

            if (!await ssv.CheckPermission(usr, "View", "Shipment"))
            {
                CallSnackBar("You have not access to view", MudBlazor.Severity.Warning);
                return;
            }
            Listdata = await shipsv.GetListJob_by_roles_Dept();
        }
        finally
        {
            _loading = false;
        }

    }
    MudDataGrid<M_Job> mudTable;
    async Task UpdateJobNo(M_Job item ,DateTime value)
    {
        var refno = await supsv.GetRefNoByFunc("JOB", value.Month, value.Year, usr);
        var tiepdaungu = await supsv.GetTiepDauNguByFunc("JOB");
        item.JobNo = tiepdaungu + value.ToString("yyMM") + (refno.HasValue ? refno.Value.ToString("D5") : "RefNoError!");
    }
    async Task AddItem()
    {
        if (!await ssv.CheckPermission(usr, "Add", "Shipment"))
        {
            CallSnackBar("You have not access to Add", MudBlazor.Severity.Warning);
            return;
        }
        CopyOps = new();
        var item = new M_Job();
        Listdata.Add(item);
        await mudTable.SetEditingItemAsync(Listdata.LastOrDefault()!);
    }
    CopyOptions CopyOps = new();
    async Task DuplicateItem()
    {
        if (!await ssv.CheckPermission(usr, "Add", "Shipment"))
        {
            CallSnackBar("You have not access to Add", MudBlazor.Severity.Warning);
            return;
        }
        if (jobdetail == null)
        {
            CallSnackBar("you must select 1 row.", MudBlazor.Severity.Warning);
            return;
        }
        var optionsdialog = new DialogOptions
        {
            ClassBackground = "class-dialog-custom",
            FullWidth = true,
            MaxWidth = MaxWidth.Small,
            CloseOnEscapeKey = false,
            DisableBackdropClick = true
        };
        CopyOps = new();
        var dialog = await DialogService.ShowAsync<DialogDuplicate>($"Duplicate Options", optionsdialog);
        var resultMess = await dialog.Result;
        if (!resultMess.Canceled)
            CopyOps = (CopyOptions)resultMess.Data;
        var item = jobdetail.DeepCopy();
        if(!CopyOps.CopyMBLHBL) 
            item.JobID = Guid.Empty;
        item.JobNo = null;
        Listdata.Add(item);
        await mudTable.SetEditingItemAsync(Listdata.LastOrDefault()!);
    }
    async Task DeleteItem(M_Job item)
    {
        if (!await ssv.CheckPermission(usr, "Delete", "Shipment"))
        {
            CallSnackBar("You have not access to Delete", MudBlazor.Severity.Warning);
            return;
        }
        if (item == null)
        {
            CallSnackBar("You must select 1 row.", MudBlazor.Severity.Warning);
            return;
        }
        if (item.Approve.HasValue &&  item.Approve.Value)
        {
            CallSnackBar("You can't delete Job approved", MudBlazor.Severity.Warning);
            return;
        }
        var resultMess = await DialogService.ShowMessageBox(
                "Warning",
                "Deleting can not be undone!",
                yesText: "Delete!", cancelText: "Cancel");

        if (resultMess.HasValue)
        {
            var rs = await shipsv.DeleteJobDetail(item);

            await HistoryLogService.LogAsync(usr, "Delete Job", "Shipment", item.JobID, item.JobNo, item);
            CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
            await Refresh();
        }

    }
    int CountMBL(Guid? i)
    {
        // total mbl & hbl
        var list = ListMBLs.Where(x=>x.Jobid == i);
        return list.Count();
    }
    int CountHBL(Guid? i)
    {
        var list = ListMBLs.Where(x => x.Jobid == i);
        var listhbl = new List<M_HBL>();
        foreach (var item in list)
        {
            var hbls = ListHBLs.Where(x => x.mblid == item.MblID);
            listhbl.AddRange(hbls);
        }
        var TC = ListHBLs.Where(x => x.Jobid == i); // dem truck voi customs
        listhbl.AddRange(TC);
        //
        return listhbl.Count();
    }
    async Task CommittedItem(M_Job item)
    {
        try
        {
            _loading = true;
            var newjobid = Guid.NewGuid();
            await mudTable.CancelEditingItemAsync();
            if (CopyOps.CopyMBLHBL) //coppy các tab bên trong
            {
                var rs = await shipsv.DuplicateDetailList(item.JobID, newjobid, CopyOps);
                await HistoryLogService.LogAsync(usr, "Duplicate Job", "Shipment", item.JobID, item.JobNo, item);
                if (!rs.Flag)
                {
                    CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
                    return;
                }
                item.JobID = Guid.Empty;
            }
            item.Userupdate = usr;
            if(item.JobID == Guid.Empty)
            {
                item.JobID = newjobid;
                item.Continued = item.Editable = true;
                var rs = await shipsv.CreateJobDetail(item);
                await HistoryLogService.LogAsync(usr, "Create Job", "Shipment", item.JobID, item.JobNo, item);
                CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
            }
            else
            {
                var rs = await shipsv.UpdateJobDetail(item);
                await HistoryLogService.LogAsync(usr, "Update Job", "Shipment", item.JobID, item.JobNo, new { OldData = detail, NewData = item });
   
                CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
            }
            await Refresh();
        }
        catch (Exception ex)
        {
            CallSnackBar("somethings went wrong while commit Item, code: " + ex.Message, MudBlazor.Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task TryStartEditing(M_Job item)
    {
        if (item.Approve.HasValue && item.Approve.Value)
        {
            CallSnackBar("This Job is Approved!", MudBlazor.Severity.Warning);
            return;
        }

        await mudTable.SetEditingItemAsync(item);
    }


    private async Task OpenDialog()
    {
        if (!await ssv.CheckPermission(usr, "Add", "Shipment"))
        {
            CallSnackBar("You have not access to Create", MudBlazor.Severity.Warning);
            return;
        }
        if (jobdetail == null)
        {
            CallSnackBar("you must select 1 row.", MudBlazor.Severity.Warning);
            return;
        }
        if (jobdetail.Approve.HasValue && jobdetail.Approve.Value)
        {
            CallSnackBar("this Job is approved", MudBlazor.Severity.Warning);
            return;
        }
        var optionsdialog = new DialogOptions
        {
            ClassBackground = "class-dialog-custom",
            FullWidth = true,
            MaxWidth = MaxWidth.Medium,
            CloseOnEscapeKey = false,
            DisableBackdropClick = true
        };

        var parameters = new DialogParameters<DetailDialogMBL> { { x => x.Jobdetail, jobdetail }, { x=>x.Customers, Customers} };
        var dialog = await DialogService.ShowAsync<DetailDialogMBL>($"MBL Job NO: {jobdetail.JobNo}", parameters, optionsdialog);
    }
    private async Task OpenDialogTrucking()
    {

        if (jobdetail == null)
        {
            CallSnackBar("you must select 1 row.", MudBlazor.Severity.Warning);
            return;
        }
        if (!await ssv.CheckPermission(usr, "Add", "Shipment"))
        {
            CallSnackBar("You have not access to Create", MudBlazor.Severity.Warning);
            return;
        }
        if (jobdetail.Approve.HasValue && jobdetail.Approve.Value)
        {
            CallSnackBar("this Job is approved", MudBlazor.Severity.Warning);
            return;
        }
        var optionsdialog = new DialogOptions
            {
                ClassBackground = "class-dialog-custom",
                FullWidth = true,
                MaxWidth = MaxWidth.Medium,
                CloseOnEscapeKey = false,
                DisableBackdropClick = true
            };

        var parameters = new DialogParameters<DetailDialogMBL_Truck> { { x => x.Jobdetail, jobdetail }, { x => x.Customers, Customers } };
        var dialog = await DialogService.ShowAsync<DetailDialogMBL_Truck>($"MBL_Trucking Job NO: {jobdetail.JobNo}", parameters, optionsdialog);
    }
    private async Task OpenDialogCustoms()
    {

        if (jobdetail == null)
        {
            CallSnackBar("you must select 1 row.", MudBlazor.Severity.Warning);
            return;
        }
        if (jobdetail.Approve.HasValue && jobdetail.Approve.Value)
        {
            CallSnackBar("this Job is approved", MudBlazor.Severity.Warning);
            return;
        }
        if (!await ssv.CheckPermission(usr, "Add", "Shipment"))
        {
            CallSnackBar("You have not access to Create", MudBlazor.Severity.Warning);
            return;
        }

        var optionsdialog = new DialogOptions
            {
                ClassBackground = "class-dialog-custom",
                FullWidth = true,
                MaxWidth = MaxWidth.Medium,
                CloseOnEscapeKey = false,
                DisableBackdropClick = true
            };

        var parameters = new DialogParameters<HQ> { { x => x.JobDetail, jobdetail }, { x => x.Customers, Customers } };
        var dialog = await DialogService.ShowAsync<HQ>($"Customs Job NO: {jobdetail.JobNo}", parameters, optionsdialog);
    }
    private int selectedRowNumber = -1;
    private string SelectedRowClassFunc(M_Job Sis, int rowNumber)
    {
        if (selectedRowNumber == rowNumber)
        {
            selectedRowNumber = -1;
            return string.Empty;
        }
