
<MudDialog>
    <DialogContent>
        @if (!isHBL)
        {
            <MudStack Row>
                <MudCheckBox @bind-Checked="CopyOP.CopyMBLHBL" Label="Copy MBL & HBL" T="bool" ReadOnly="isHBL" />
            </MudStack>
        }
        <MudStack Row>
            <MudCheckBox @bind-Checked="CopyOP.CopyDebit" Label="Copy Debit" T="bool" Disabled="@(!CopyOP.CopyMBLHBL)" />
            <MudCheckBox @bind-Checked="CopyOP.CopyCredit" Label="Copy Credit" T="bool" Disabled="@(!CopyOP.CopyMBLHBL)" />
            <MudCheckBox @bind-Checked="CopyOP.CopyContainer" Label="Copy Container" T="bool" Disabled="@(!CopyOP.CopyMBLHBL)" />
        </MudStack>
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Submit" Color="Color.Primary">OK</MudButton>
        <MudButton OnClick="Cancel" Color="Color.Secondary">Cancel</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    public MudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public bool isHBL { get; set; } = false;
    CopyOptions CopyOP = new();
    private void Submit() => MudDialog.Close(DialogResult.Ok(CopyOP));
    private void Cancel() => MudDialog.Cancel();
    protected override void OnInitialized()
    {
        if (isHBL) CopyOP.CopyMBLHBL = true;
        base.OnInitialized();
    }
}
