<MudDialog>
    <DialogContent>


        <MudSelect @bind-Value="DebitSelected" Label="Select Debit No.">
            @foreach (var item in Listcmb)
            {
                <MudSelectItem Value="@item">@item.debitno</MudSelectItem>
            }
        </MudSelect>

    
        <MudSelect T="int" @bind-Value="mau" Label="Chọn mẫu">
            <MudSelectItem Value="1">Mẫu 1</MudSelectItem>
            <MudSelectItem Value="2">Mẫu 2</MudSelectItem>
            <MudSelectItem Value="3">Mẫu 3</MudSelectItem>
        </MudSelect>
        

    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(()=> Muddialog.Cancel())">Close</MudButton>
      @*   <MudButton OnClick="@(()=> Muddialog.Close(DebitSelected))" Color="Color.Primary" Disabled="DebitSelected == null">Ok</MudButton> *@
        <MudButton OnClick="@(()=> Muddialog.Close(DialogResult.Ok((DebitSelected, mau))))"
                   Color="Color.Primary" Disabled="DebitSelected == null">
            Ok
        </MudButton>

    </DialogActions>
</MudDialog>
@inject ShipmentService ssv
@code {
    [CascadingParameter] public MudDialogInstance Muddialog { get; set; }
    [Parameter] public M_HBL hbldetail { get; set; }
    List<M_Debit> Listcmb = new List<M_Debit>();
    M_Debit DebitSelected;
    int mau = 1;
    protected async override Task OnInitializedAsync()
    {
        var list = await ssv.GetListDebitHBL(hbldetail.hblID);
        if (list.Count > 0)
            Listcmb = list.Where(x => !x.approve.HasValue || !x.approve.Value).DistinctBy(x => x.debitno).ToList();
    }
}
