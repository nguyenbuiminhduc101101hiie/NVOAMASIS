@using System.Globalization
@using System.Text.Json
@using Microsoft.EntityFrameworkCore
@using MudBlazor
@using NVOAMASIS.Data
@using NVOAMASIS.Models
@inject AccountService asv
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IDbContextFactory<AppDbContext> DbFactory
@inject ShipmentService shipsv
@inject SupportServices supsv
@inject tigiaVCBservices Vcbsv
@inject IStringLocalizer<SharedResource> Localizer

<MudDataGrid T="M_Debit"
             Items="@Listdata"
             Filterable="true"
             @ref="mudTable"
             Bordered="true"
             FilterMode="@DataGridFilterMode.Simple"
             Dense="true"
             Virtualize="true"
             FixedHeader="true"
             FixedFooter="true"
             HeaderClass="no-wrap"
             FooterClass="no-wrap"
             ReadOnly="false"
             CommittedItemChanges="@CommittedItem"
             RowClassFunc="@SelectedRowClassFunc"
             RowClick="@RowClicked"
             ColumnResizeMode="ResizeMode.Column"
             Loading="_loading"
             ShowColumnOptions="false"
             Height="@GridHeight">
    <Columns>
        <TemplateColumn CellClass="d-flex justify-end" Filterable="false" ShowColumnOptions="false" Sortable="false">
            <HeaderTemplate>
                <MudStack Row="true" Justify="Justify.FlexStart" Spacing="2">
                    <MudTooltip Text="@Localizer["Reload"]">
                        <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                                       Color="Color.Success"
                                       Size="Size.Small"
                                       OnClick="Refresh"
                                       Variant="Variant.Filled"
                                       Disabled="@(!_canEditContext)"
                                       Class="btn-compact" />
                    </MudTooltip>
                    <MudTooltip Text="@Localizer["New"]">
                        <MudIconButton Icon="@Icons.Material.Filled.CreateNewFolder"
                                       Color="Color.Success"
                                       Size="Size.Small"
                                       OnClick="NewItem"
                                       Variant="Variant.Filled"
                                       Disabled="@(!_canEditContext)"
                                       Class="btn-compact" />
                    </MudTooltip>
                    <MudTooltip Text="@Localizer["Add"]">
                        <MudIconButton Icon="@Icons.Material.Filled.Add"
                                       Color="Color.Success"
                                       Size="Size.Small"
                                       OnClick="AddItem"
                                       Variant="Variant.Filled"
                                       Disabled="@(!_canEditContext)"
                                       Class="btn-compact" />
                    </MudTooltip>
                </MudStack>
            </HeaderTemplate>
            <CellTemplate>
                <MudIconButton Size="@Size.Small" Icon="@Icons.Material.Outlined.Edit" OnClick="@(()=>TryStartEditing(context.Item))" Disabled="context.Item.khoa == true" />
                <MudIconButton Size="@Size.Small" Icon="@Icons.Material.Outlined.Delete" OnClick="@(()=>DeleteItem(context.Item))" Disabled="context.Item.khoa == true" />
            </CellTemplate>
        </TemplateColumn>
        <PropertyColumn Property="x => x.debitno" Title="@Localizer["Debit No."]" Required="false">
            <EditTemplate>
                <MudTextField @bind-Value="context.Item.debitno" Immediate Label="Debit No." Required ReadOnly />
                <MudDatePicker Label="@Localizer["Selected Date Get Debit No"]"
                               DateChanged="@(t => UpdateDebitNo(context.Item, (DateTime)t!))"
                               ImmediateText
                               DateFormat="MM/yyyy"
                               Disabled="!string.IsNullOrEmpty(context.Item.debitno)" />
            </EditTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x=>x.approve" Title="@Localizer["Approve"]" IsEditable="false" Required="false">
            <CellTemplate>
                <MudCheckBox @bind-Checked="context.Item.approve" @bind-Value="context.Item.approve" @bind-Value:after="@(()=>UpdatebyCheckboxClick(context.Item))" />
            </CellTemplate>
            <EditTemplate></EditTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x => CusidtoCusCode(x.customerid)" Title="@Localizer["Customer"]" Required="false" CellClass="no-wrap-cell">
            <EditTemplate>
                <MudAutocomplete @bind-Value="context.Item.customerid" Label="@Localizer["Customer"]" Required SearchFunc="SearchCustomer" ToStringFunc="CusidtoCusCode" Clearable />
            </EditTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x => Charidtocharge(x.itemid)" Title="@Localizer["Item"]" Required="false" CellClass="no-wrap-cell">
            <EditTemplate>
                <MudAutocomplete @bind-Value="context.Item.itemid" Label="@Localizer["Item"]" Required SearchFunc="SearchCharge" ToStringFunc="Charidtocharge" Clearable />
            </EditTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x => x.dongia" Title="@Localizer["Unit Price"]" Format="#,##0.##" Required="false" CellStyle="text-align: right;">
            <EditTemplate>
                <MudNumericField @bind-Value="context.Item.dongia" Class="text-right" Label="@Localizer["Unit Price"]" Format="#,##0.##" Culture="@_en" T="double?" TextChanged="@(e => CalculateTotal(context.Item))" HideSpinButtons="true" />
            </EditTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x=>x.type" Title="@Localizer["Type"]" Required="false">
            <EditTemplate>
                <MudAutocomplete @bind-Value="context.Item.type" Label="@Localizer["Type"]" Required CoerceValue SearchFunc="SearchType" />
            </EditTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x => x.soluong" Title="@Localizer["Quantity"]" Format="#,##0.##" Required="false">
            <EditTemplate>
                <MudNumericField @bind-Value="context.Item.soluong" Label="@Localizer["Quantity"]" Format="#,##0.##" Culture="@_en" T="double?" TextChanged="@(e => CalculateTotal(context.Item))" HideSpinButtons="true" />
            </EditTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x => x.thanhtien" Title="@Localizer["Total Price"]" Format="#,##0.##" CellStyle="text-align: right;" Required="false">
            <EditTemplate>
                <MudNumericField @bind-Value="context.Item.thanhtien" Label="@Localizer["Total Price"]" Format="#,##0.##" Culture="@_en" T="double?" Class="text-right" HideSpinButtons="true" />
            </EditTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x => x.tiente" Title="@Localizer["Loaitiente"]" Required="false">
            <EditTemplate>
                <MudAutocomplete @bind-Value="context.Item.tiente" Label="@Localizer["Currency"]" Required="true" CoerceValue SearchFunc="SearchCurr" />
            </EditTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x => x.thue" Title="@Localizer["VAT"]" Format="#,##0.##" Required="false">
            <EditTemplate>
                <MudNumericField @bind-Value="context.Item.thue" Label="@Localizer["VAT"]" Format="#,##0.##" Culture="@_en" T="double?" TextChanged="@(e => CalculateThanhtiensauthue(context.Item))" HideSpinButtons="true" />
            </EditTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x => x.thanhtiensauthue" Title="@Localizer["Total Price Inc. VAT"]" Format="#,##0.##" Required="false" CellStyle="text-align: right;">
            <EditTemplate>
                <MudNumericField @bind-Value="context.Item.thanhtiensauthue" Label="@Localizer["Total Price Inc. VAT"]" Format="#,##0.##" Culture="@_en" T="double?" Class="text-right" HideSpinButtons="true" />
            </EditTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x => x.thuho" Title="@Localizer["On Behaft"]" Required="false">
            <EditTemplate>
                <MudCheckBox @bind-Checked="context.Item.thuho" Label="@Localizer["On Behaft"]" />
            </EditTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x => x.tigiadebit" Title="@Localizer["Exchange Rate Debit"]" Format="#,##0.##" Required="false">
            <EditTemplate>
                <MudStack Row Spacing="1" AlignItems="AlignItems.Center">
                    <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small"
                               Style="min-width: 80px; height: 36px; padding: 5px 10px;"
                               OnClick="@(() => GetTigia(context.Item))">
                        @Localizer["gettigia"]
                    </MudButton>
                    <MudNumericField @bind-Value="context.Item.tigiadebit"
                                     Label="@Localizer["Exchange Rate Debit"]"
                                     Format="#,##0.##" Culture="@_en"
                                     T="double?" Required="true" HideSpinButtons="true"
                                     Class="text-right" />
                </MudStack>
            </EditTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x => x.tigiahoandondaura" Title="@Localizer["Exchange Rate Invoice"]" Format="#,##0.##" Required="false">
            <EditTemplate>
                <MudStack Row Spacing="1" AlignItems="AlignItems.Center">
                    <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small"
                               Style="min-width: 80px; height: 36px; padding: 5px 10px;"
                               OnClick="@(() => GetTigia_invoice(context.Item))">
                        @Localizer["gettigia"]
                    </MudButton>
                    <MudNumericField @bind-Value="context.Item.tigiahoandondaura"
                                     Label="@Localizer["Exchange Rate Invoice"]"
                                     Format="#,##0.##" Culture="@_en"
                                     T="double?" Required="true" HideSpinButtons="true"
                                     Class="text-right" />
                </MudStack>
            </EditTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x => x.ContainerNo" Title="@Localizer["Cont. No."]" Required="false">
            <EditTemplate>
                <MudTextField @bind-Value="context.Item.ContainerNo" Label="@Localizer["Cont. No."]" />
            </EditTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x => x.ghichu" Title="@Localizer["Notes"]" Required="false">
            <EditTemplate>
                <MudTextField @bind-Value="context.Item.ghichu" Label="@Localizer["Notes"]" Lines="3" />
            </EditTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x => x.khoa" Title="@Localizer["Locked"]">
            <CellTemplate>
                <MudCheckBox @bind-Checked="context.Item.khoa" @bind-Checked:after="@(async () => await OnLockChanged(context.Item))" />
            </CellTemplate>
            <EditTemplate>
                <MudCheckBox @bind-Checked="context.Item.khoa" Label="@Localizer["Locked"]" />
            </EditTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x => x.userupdate" Title="@Localizer["UserUpdate"]" IsEditable="false" Required="false"><EditTemplate></EditTemplate></PropertyColumn>
        <PropertyColumn Property="x => x.dateupdate" Title="@Localizer["Dateupdate"]" IsEditable="false" Required="false"><EditTemplate></EditTemplate></PropertyColumn>
    </Columns>
</MudDataGrid>

@if (Listdata.Count > 0)
{
    <MudStack Row Justify="Justify.FlexStart" Class="pa-4">
        <MudText Typo="Typo.subtitle2" Align="Align.Center" GutterBottom="true" Style="margin-right:20px;">
            Total Inc. VAT: @(Listdata.Sum(x => x.thanhtiensauthue / (x.tiente == "VND" ? x.tigiadebit : 1))!.Value.ToString("#,##0.##", _en)) USD
        </MudText>
        <MudText Typo="Typo.subtitle2" Align="Align.Center" GutterBottom="true">
            Total Inc. VAT: @(Listdata.Sum(x => x.thanhtiensauthue * (x.tiente == "USD" ? x.tigiadebit : 1))!.Value.ToString("#,##0.##", _en)) VND
        </MudText>
    </MudStack>
}

@code {
    [Parameter] public QuanLy_Cont? QuanLyCont { get; set; }
    [Parameter] public QuanLy_Tau? QuanLyTau { get; set; }
    [Parameter] public string GridHeight { get; set; } = "420px";

    public CultureInfo _en = CultureInfo.GetCultureInfo("en-US");
    private MudDataGrid<M_Debit> mudTable = default!;
    private List<M_Debit> Listdata = new();
    private List<M_Customer> Customers = new();
    private List<ChargeModel> charges = new();
    private List<string> currs = new();
    private List<string> Types = new();
    private M_Debit? detail;
    private M_Debit? detail_Debit;
    private bool _loading;
    private bool _initialized;
    private string usr = string.Empty;
    private Guid _loadedContextKey = Guid.Empty;
    private readonly SemaphoreSlim _loadGate = new(1, 1);

    private Guid CurrentContId => QuanLyCont?.Id ?? Guid.Empty;
    private Guid CurrentTauId => QuanLyTau?.Id ?? Guid.Empty;
    private bool IsContContext => CurrentContId != Guid.Empty;
    private bool IsTauContext => CurrentTauId != Guid.Empty;
    private bool _canEditContext => IsContContext || IsTauContext;
    private string ShipmentTypeCode => IsContContext ? "CO" : IsTauContext ? "TA" : string.Empty;

    protected override async Task OnParametersSetAsync()
    {
        await _loadGate.WaitAsync();
        try
        {
            if (!_initialized)
            {
                var auth = await asv.GetAuth();
                usr = auth.User.Identity?.Name ?? string.Empty;
                await LoadLookupsAsync();
                _initialized = true;
            }

            if (!_canEditContext)
            {
                Listdata = new();
                return;
            }

            var contextKey = IsContContext ? CurrentContId : CurrentTauId;
            if (_loadedContextKey != contextKey)
            {
                _loadedContextKey = contextKey;
                await Refresh();
            }
        }
        finally
        {
            _loadGate.Release();
        }
    }

    private async Task LoadLookupsAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        currs = await db.Currency.AsNoTracking()
            .Select(x => x.Currency)
            .Where(x => x != null)
            .Distinct()
            .ToListAsync();

        charges = await db.Charge.AsNoTracking()
            .Where(x => x.CHARGE_CODE == null || !EF.Functions.Like(x.CHARGE_CODE, "%Duty%"))
            .OrderByDescending(x => x.UPDATETIME)
            .ToListAsync();

        var debitTypes = await db.Debit.AsNoTracking()
            .Select(x => x.type)
            .Where(x => x != null)
            .ToListAsync();
        var creditTypes = await db.Credit.AsNoTracking()
            .Select(x => x.type)
            .Where(x => x != null)
            .ToListAsync();
        Types = debitTypes
            .Union(creditTypes)
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Select(x => x!)
            .Distinct()
            .ToList();

        Customers = await db.Customer.AsNoTracking().OrderBy(x => x.shortname).ToListAsync();
    }

    private void CallSnackBar(string message, MudBlazor.Severity severity)
    {
        Snackbar.Configuration.SnackbarVariant = Variant.Filled;
        Snackbar.Configuration.MaxDisplayedSnackbars = 3;
        Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopRight;
        Snackbar.Add(message, severity);
    }

    private async Task Refresh()
    {
        if (!_canEditContext)
        {
            Listdata = new();
            return;
        }

        try
        {
            _loading = true;
            await using var db = await DbFactory.CreateDbContextAsync();
            var query = db.Debit.AsNoTracking().Where(x => x.continued == true);
            query = IsContContext
                ? query.Where(x => x.Quanly_contid == CurrentContId)
                : query.Where(x => x.Quanly_tauid == CurrentTauId);
            Listdata = await query.OrderByDescending(x => x.dateupdate).ToListAsync();
        }
        catch (Exception ex)
        {
            CallSnackBar("Cannot load Debit: " + ex.Message, MudBlazor.Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task NewItem()
    {
        var item = new M_Debit();
        SetContextIds(item);
        if (IsContContext && !string.IsNullOrWhiteSpace(QuanLyCont?.Container))
            item.ContainerNo = QuanLyCont.Container;
        Listdata.Add(item);
        await mudTable.SetEditingItemAsync(item);
    }

    private async Task AddItem()
    {
        if (detail is null)
        {
            CallSnackBar("you must select 1 row.", MudBlazor.Severity.Warning);
            return;
        }

        var item = new M_Debit
        {
            debitno = detail.debitno,
            customerid = detail.customerid,
            itemid = detail.itemid,
            ContainerNo = detail.ContainerNo
        };
        SetContextIds(item);
        Listdata.Add(item);
        await mudTable.SetEditingItemAsync(item);
    }

    private async Task DeleteItem(M_Debit item)
    {
        if (item.approve == true)
        {
            CallSnackBar("This Debit is approved!", MudBlazor.Severity.Info);
            return;
        }

        var resultMess = await DialogService.ShowMessageBox("Warning", "Deleting can not be undone!", yesText: "Delete!", cancelText: "Cancel");
        if (resultMess != true)
            return;

        var rs = await shipsv.DeleteDebitMBL(item);
        CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
        await Refresh();
    }

    private async Task CommittedItem(M_Debit item)
    {
        SetContextIds(item);
        item.mblid = Guid.Empty;
        item.hblid = Guid.Empty;
        item.quotationid = Guid.Empty;
        item.ContainerNo = string.IsNullOrWhiteSpace(item.ContainerNo) ? null : item.ContainerNo.Trim();
        item.userupdate = usr;
        item.dateupdate = DateTime.Now.ToString("dd/MM/yyyy HH:mm:ss");

        var rs = item.debitId != Guid.Empty
            ? await shipsv.UpdateDebitMBL(item, detail_Debit ?? new M_Debit())
            : await shipsv.CreateDebitMBL(item);

        CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
        await Refresh();
    }

    private void SetContextIds(M_Debit item)
    {
        item.Quanly_contid = IsContContext ? CurrentContId : null;
        item.Quanly_tauid = IsTauContext ? CurrentTauId : null;
    }

    private void RowClicked(DataGridRowClickEventArgs<M_Debit> args)
    {
        if (args.Item.approve == true)
            CallSnackBar("Hóa đơn approved!", MudBlazor.Severity.Info);
        else
            detail = args.Item;
    }

    private string SelectedRowClassFunc(M_Debit row, int _)
    {
        if (row.approve == true)
            return "custom-disable";
        if (mudTable?.SelectedItem != null && mudTable.SelectedItem.Equals(row))
            return "selected";
        return string.Empty;
    }

    private string CusidtoCusCode(Guid cusid)
    {
        if (cusid == Guid.Empty) return string.Empty;
        var rs = Customers.FirstOrDefault(x => x.Customer_ID == cusid);
        return rs == null ? string.Empty : rs.shortname + "_" + rs.COMPANY;
    }

    private string Charidtocharge(Guid id)
    {
        if (id == Guid.Empty) return string.Empty;
        var rs = charges.FirstOrDefault(x => x.CHARGE_ID == id);
        return rs == null ? string.Empty : $"{rs.CHARGE_CODE} - {rs.CHARGE}";
    }

    private async Task<IEnumerable<Guid>> SearchCustomer(string text)
    {
        if (string.IsNullOrWhiteSpace(text))
            return Customers.Select(x => x.Customer_ID);
        return Customers.Where(x => (x.shortname + "_" + x.COMPANY).Contains(text, StringComparison.OrdinalIgnoreCase)).Select(x => x.Customer_ID);
    }

    private async Task<IEnumerable<Guid>> SearchCharge(string text)
    {
        if (string.IsNullOrWhiteSpace(text))
            return charges.Select(x => x.CHARGE_ID);
        return charges.Where(x => (x.CHARGE_CODE + "_" + x.CHARGE).Contains(text, StringComparison.OrdinalIgnoreCase)).Select(x => x.CHARGE_ID);
    }

    private async Task<IEnumerable<string?>> SearchType(string? text)
    {
        var items = Types.Distinct();
        if (string.IsNullOrEmpty(text))
            return items;
        return items.Where(x => x != null && x.Contains(text, StringComparison.OrdinalIgnoreCase));
    }

    private async Task<IEnumerable<string>> SearchCurr(string? text)
    {
        if (string.IsNullOrWhiteSpace(text))
            return currs;
        return currs.Where(x => !string.IsNullOrEmpty(x) && x.Contains(text, StringComparison.OrdinalIgnoreCase));
    }

    private void CalculateTotal(M_Debit item)
    {
        if (item.soluong.HasValue && item.dongia.HasValue)
        {
            item.thanhtien = Math.Round((item.soluong ?? 0) * (item.dongia ?? 0), 2);
            CalculateThanhtiensauthue(item);
        }
    }

    private void CalculateThanhtiensauthue(M_Debit item)
    {
        if (item.thanhtien.HasValue && item.thue.HasValue)
            item.thanhtiensauthue = Math.Round((item.thanhtien ?? 0) * ((item.thue ?? 0) / 100 + 1), 2);
    }

    private async Task UpdateDebitNo(M_Debit item, DateTime value)
    {
        var refno = await supsv.GetRefNoByFunc("Debit", value.Month, value.Year, usr);
        var tiepdaungu = await supsv.GetTiepDauNguByFunc("JOB");
        var rs = asv.GetUserDetail();
        var cn = rs?.Branch ?? string.Empty;
        var flc = string.Empty;
        item.debitno = cn + tiepdaungu + ShipmentTypeCode + flc + value.ToString("yyMM") + (refno.HasValue ? refno.Value.ToString("D4") : "RefNoError!");
        StateHasChanged();
    }

    private async Task GetTigia(M_Debit item)
    {
        item.tigiadebit = await Vcbsv.Getexchange_cur(item.tiente);
        StateHasChanged();
    }

    private async Task GetTigia_invoice(M_Debit item)
    {
        item.tigiahoandondaura = await Vcbsv.Getexchange_cur(item.tiente);
        StateHasChanged();
    }

    private async Task UpdatebyCheckboxClick(M_Debit item)
    {
        item.dateupdate = DateTime.Now.ToString("dd/MMM/yyyy", new CultureInfo("en-US"));
        item.userupdate = usr;
        var rs = await shipsv.UpdateDebitMBL_Approve(item);
        if (!rs.Flag)
            CallSnackBar(rs.Message, MudBlazor.Severity.Error);
    }

    private async Task OnLockChanged(M_Debit item)
    {
        item.dateupdate = DateTime.Now.ToString();
        item.userupdate = usr;
        var rs = await shipsv.UpdateDebitMBL(item, detail_Debit ?? item);
        if (!rs.Flag)
            CallSnackBar(rs.Message, MudBlazor.Severity.Error);
    }

    private async Task TryStartEditing(M_Debit item)
    {
        if (item.approve == true)
        {
            CallSnackBar("This Debit is approved!", MudBlazor.Severity.Warning);
            return;
        }

        detail_Debit = JsonSerializer.Deserialize<M_Debit>(JsonSerializer.Serialize(item));
        await mudTable.SetEditingItemAsync(item);
    }
}
