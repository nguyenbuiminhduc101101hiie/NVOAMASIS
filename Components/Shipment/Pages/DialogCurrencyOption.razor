<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.AttachMoney" Class="mr-2" />
            Chon Currency
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.subtitle1" Class="mb-2"><b>Chon loai tien te de export</b></MudText>
        <MudRadioGroup @bind-Value="SelectedCurrency" T="string">
            <MudRadio Value="@("VND")" Color="Color.Primary">VND</MudRadio>
            <MudRadio Value="@("USD")" Color="Color.Primary">USD</MudRadio>
        </MudRadioGroup>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Submit" Color="Color.Primary" Variant="Variant.Filled"
                   Disabled="@string.IsNullOrWhiteSpace(SelectedCurrency)">
            Chon
        </MudButton>
        <MudButton OnClick="Cancel" Color="Color.Default">Cancel</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    public MudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public string DefaultCurrency { get; set; } = "VND";

    private string SelectedCurrency { get; set; } = "VND";

    protected override void OnParametersSet()
    {
        SelectedCurrency = string.IsNullOrWhiteSpace(DefaultCurrency) ? "VND" : DefaultCurrency;
    }

    private void Submit()
    {
        MudDialog.Close(DialogResult.Ok(SelectedCurrency));
    }

    private void Cancel() => MudDialog.Cancel();
}
