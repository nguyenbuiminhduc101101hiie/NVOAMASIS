@using System.Globalization
@inject IStringLocalizer<SharedResource> Localizer

<MudDialog>
    <DialogContent>
        <MudGrid Spacing="3">
            <MudItem xs="6" sm="4">
                <MudText Typo="Typo.caption" Color="Color.Secondary">@Localizer["Customer"]</MudText>
                <MudText Typo="Typo.body1">@(string.IsNullOrWhiteSpace(CustomerText) ? "-" : CustomerText)</MudText>
            </MudItem>
            <MudItem xs="6" sm="4">
                <MudText Typo="Typo.caption" Color="Color.Secondary">@Localizer["Item"]</MudText>
                <MudText Typo="Typo.body1">@(string.IsNullOrWhiteSpace(ItemText) ? "-" : ItemText)</MudText>
            </MudItem>
            <MudItem xs="6" sm="4">
                <MudText Typo="Typo.caption" Color="Color.Secondary">@Localizer["Approve"]</MudText>
                <MudText Typo="Typo.body1">@((Item.approve ?? false) ? "Có" : "Không")</MudText>
            </MudItem>
            <MudItem xs="6" sm="4">
                <MudText Typo="Typo.caption" Color="Color.Secondary">@Localizer["Unit Price"]</MudText>
                <MudText Typo="Typo.body1">@FormatNumber(Item.dongia)</MudText>
            </MudItem>
            <MudItem xs="6" sm="4">
                <MudText Typo="Typo.caption" Color="Color.Secondary">@Localizer["Type"]</MudText>
                <MudText Typo="Typo.body1">@(string.IsNullOrWhiteSpace(Item.type) ? "-" : Item.type)</MudText>
            </MudItem>
            <MudItem xs="6" sm="4">
                <MudText Typo="Typo.caption" Color="Color.Secondary">@Localizer["Quantity"]</MudText>
                <MudText Typo="Typo.body1">@FormatNumber(Item.soluong)</MudText>
            </MudItem>
            <MudItem xs="6" sm="4">
                <MudText Typo="Typo.caption" Color="Color.Secondary">@Localizer["Total Price"]</MudText>
                <MudText Typo="Typo.body1">@FormatNumber(Item.thanhtien)</MudText>
            </MudItem>
            <MudItem xs="6" sm="4">
                <MudText Typo="Typo.caption" Color="Color.Secondary">@Localizer["Loaitiente"]</MudText>
                <MudText Typo="Typo.body1">@(string.IsNullOrWhiteSpace(Item.tiente) ? "-" : Item.tiente)</MudText>
            </MudItem>
            <MudItem xs="6" sm="4">
                <MudText Typo="Typo.caption" Color="Color.Secondary">@Localizer["VAT"]</MudText>
                <MudText Typo="Typo.body1">@FormatNumber(Item.thue)</MudText>
            </MudItem>
            <MudItem xs="6" sm="4">
                <MudText Typo="Typo.caption" Color="Color.Secondary">@Localizer["Total Price Inc. VAT"]</MudText>
                <MudText Typo="Typo.body1">@FormatNumber(Item.thanhtiensauthue)</MudText>
            </MudItem>
            <MudItem xs="6" sm="4">
                <MudText Typo="Typo.caption" Color="Color.Secondary">@Localizer["Exchange Rate Credit"]</MudText>
                <MudText Typo="Typo.body1">@FormatNumber(Item.tigiacredit)</MudText>
            </MudItem>
            <MudItem xs="6" sm="4">
                <MudText Typo="Typo.caption" Color="Color.Secondary">@Localizer["Exchange Rate Invoice"]</MudText>
                <MudText Typo="Typo.body1">@FormatNumber(Item.tigiahoadondauvao)</MudText>
            </MudItem>
            <MudItem xs="6" sm="4">
                <MudText Typo="Typo.caption" Color="Color.Secondary">@Localizer["Cont. No."]</MudText>
                <MudText Typo="Typo.body1">@(string.IsNullOrWhiteSpace(Item.ContainerNo) ? "-" : Item.ContainerNo)</MudText>
            </MudItem>
            <MudItem xs="6" sm="4">
                <MudText Typo="Typo.caption" Color="Color.Secondary">@Localizer["UserUpdate"]</MudText>
                <MudText Typo="Typo.body1">@(string.IsNullOrWhiteSpace(Item.userupdate) ? "-" : Item.userupdate)</MudText>
            </MudItem>
            <MudItem xs="6" sm="4">
                <MudText Typo="Typo.caption" Color="Color.Secondary">@Localizer["Dateupdate"]</MudText>
                <MudText Typo="Typo.body1">@(string.IsNullOrWhiteSpace(Item.dateupdate) ? "-" : Item.dateupdate)</MudText>
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Close">@Localizer["Close"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] MudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public M_Credit Item { get; set; } = new();
    [Parameter] public string? CustomerText { get; set; }
    [Parameter] public string? ItemText { get; set; }

    static CultureInfo _en = CultureInfo.GetCultureInfo("en-US");
    static string FormatNumber(double? value) => value.HasValue ? value.Value.ToString("#,##0.##", _en) : "-";

    void Close() => MudDialog.Close();
}
