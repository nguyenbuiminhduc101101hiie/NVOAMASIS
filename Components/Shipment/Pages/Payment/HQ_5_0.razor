
@inject CustomerService csv
@inject SupportServices supsv
@inject SharedServices ssv
@inject AccountService asv
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject ShipmentService shipsv
@inject IStringLocalizer<SharedResource> Localizer
@inject LenhDieuXeServices lsv
@inject TKHQ_Services hqsv
@inject HistoryLogService HistoryLogService
@using System.Text.Json;
@inject IJSRuntime JSRuntime
<MudDialog>
    <DialogContent>
        <MudText Class="pa-4">Customs No selected: @(hbldetail != null ? hbldetail.hbl : null)</MudText>
        <MudTabs SliderColor="Color.Primary">
            <MudTabPanel Text="Customs" Class="custom-tab">
                <MudDataGrid T="M_HBL" Items="@Listdata" Filterable="true" @ref="mudTable" Class="table-hbl-bg"

                FilterMode="@DataGridFilterMode.Simple" Dense="true" Virtualize="true" Bordered="true"
                FixedHeader="true" FixedFooter="true" HeaderClass="no-wrap" FooterClass="no-wrap" ShowColumnOptions="false"
                ReadOnly="false" CommittedItemChanges="@CommittedItem" RowClassFunc="@SelectedRowClassFunc"
                RowClick="@RowClicked" RowContextMenuClick="RowRightClicked" EditDialogOptions="optionsdialog"
                ColumnResizeMode="ResizeMode.Column" Loading="_loading">
                    <Columns>
                        <TemplateColumn CellClass="d-flex justify-end" Filterable="false" ShowColumnOptions="false" Sortable="false">
                            <HeaderTemplate>
                                <MudStack Row="true" Justify="Justify.FlexStart" Spacing="2">

                                    <!-- Nút Reload -->
                                    <MudTooltip Text="@Localizer["Reload"]">
                                        <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                                        Color="Color.Success"
                                        Size="Size.Small"
                                        OnClick="Refresh"
                                        Variant="Variant.Filled"
                                        Class="btn-compact" />
                                    </MudTooltip>

                                    <!-- Nút Add -->
                                    <MudTooltip Text="@Localizer["New"]">
                                        <MudIconButton Icon="@Icons.Material.Filled.Add"
                                        Color="Color.Success"
                                        Size="Size.Small"
                                        OnClick="AddItem" Disabled
                                        Variant="Variant.Filled"
                                        Class="btn-compact" />
                                    </MudTooltip>
                                </MudStack>
                            </HeaderTemplate>
                            <CellTemplate>
                                <MudIconButton Size="@Size.Small" Icon="@Icons.Material.Outlined.Edit" OnClick="@(()=>TryStartEditing(context.Item))" Disabled/>
                                
                                <MudIconButton Size="@Size.Small" Icon="@Icons.Material.Outlined.Delete" OnClick="@(()=>DeleteItem(context.Item))" Disabled/>
                            </CellTemplate>
                        </TemplateColumn>
                        <PropertyColumn Property="x => x.TKHQ_MaHaiQuan" Title="@Localizer["Customs Code"]">
                            <EditTemplate>
                                <MudGrid>
                                    <MudItem xs="6" Style="background-color:lightcyan;">
                                        <MudStack Row>
                                            <MudDatePicker Label="@Localizer["Select Date Get Customs Code"]" DateChanged="((t)=>UpdateHBLNo(context.Item,(DateTime)t!))" ImmediateText DateFormat="MM/yyyy" />
                                            <MudTextField @bind-Value="context.Item.TKHQ_MaHaiQuan" Immediate Label="@Localizer["Customs Code"]" Required />
                                        </MudStack>
                                        <MudTextField @bind-Value="context.Item.TKHQ_TenHaiQuan" Immediate Label="@Localizer["Customs Name"]" />

                                        <MudSelect @bind-Value="context.Item.statusHBL" Label="@Localizer["Status"]">
                                            @foreach (var item in trangthais)
                                            {
                                                <MudSelectItem Value="item">@item</MudSelectItem>
                                            }
                                        </MudSelect>
                                    </MudItem>
                                    <MudItem xs="6" Style="background-color:lightcoral;">
                                        <MudStack Row>
                                            <MudTextField @bind-Value="context.Item.TKHQ_MaLoaiHinh" Immediate Label="@Localizer["Type Code"]" />
                                            <MudTextField @bind-Value="context.Item.TKHQ_TenLoaiHinh" Immediate Label="@Localizer["Type Name"]" />
                                        </MudStack>
                                        <MudGrid>
                                            <MudItem xs="12">
                                                <MudStack Row>
                                                    <MudDatePicker @bind-Date="context.Item.TKHQ_NgayDangKy" Label="@Localizer["Reg. Date"]" />
                                                    <MudTextField @bind-Value="context.Item.TKHQ_NamDangKy" Immediate Label="@Localizer["Year of Reg."]" />
                                                </MudStack>
                                            </MudItem>
                                            <MudItem xs="12">
                                                <MudAutocomplete @bind-Value="context.Item.TKHQ_SoToKhai" Label="@Localizer["Request Customs No."]" SearchFunc="SearchSoToKhai" Required/>
                                            </MudItem>
                                        </MudGrid>
                                    </MudItem>
                                    <MudItem xs=6 Style="background-color:lightsteelblue;">
                                        <MudGrid>
                                            <MudItem xs="4">
                                                <MudTextField @bind-Value="context.Item.TKHQ_MaDonVi" Label="@Localizer["Unit Code"]" />
                                            </MudItem>
                                            <MudItem xs="8">
                                                <MudStack Row >
                                                    <MudDatePicker @bind-Date="context.Item.TKHQ_NgayThongQuan" Label="@Localizer["Customs Clearance Date"]" />

                                                    <MudDatePicker @bind-Date="context.Item.TKHQ_NgayQuaKhuVucGiamSat" Label="@Localizer["Through Surveillance Area Date"]" />
                                                </MudStack>
                                            </MudItem>
                                        </MudGrid>
                                    </MudItem>
                                    <MudItem xs="6">
                                        <MudTextField @bind-Value="context.Item.TKHQ_TenLuong" Lines="3" AutoGrow Label="@Localizer["Customs Stream Name"]" />
                                    </MudItem>
                                </MudGrid>
                            </EditTemplate>
                        </PropertyColumn>
                        <PropertyColumn Property="x=>x.approve" Title="@Localizer["Approve"]" IsEditable="false" Required="false">
                            <CellTemplate>
                                <MudCheckBox @bind-Checked="context.Item.approve" @bind-Value="context.Item.approve" @bind-Value:after="@(()=>UpdatebyCheckboxClick(context.Item))" />
                            </CellTemplate>
                            <EditTemplate>
                            </EditTemplate>
                        </PropertyColumn>
                        <PropertyColumn Property="x => x.TKHQ_TenHaiQuan" Title="@Localizer["Customs Name"]"><EditTemplate></EditTemplate></PropertyColumn>
                        <PropertyColumn Property="x => x.statusHBL" Title="@Localizer["Status"]" Required="false">
                            <EditTemplate></EditTemplate>
                        </PropertyColumn>
                        <PropertyColumn Property="x => x.TKHQ_MaLoaiHinh" Title="@Localizer["Type Code"]">
                            <EditTemplate></EditTemplate>
                        </PropertyColumn>
                        <PropertyColumn Property="x => x.TKHQ_TenLoaiHinh" Title="@Localizer["Type Name"]">
                            <EditTemplate></EditTemplate>
                        </PropertyColumn>
                        <PropertyColumn Property="x => x.TKHQ_NamDangKy" Title="@Localizer["Year of Reg."]">
                            <EditTemplate></EditTemplate>
                        </PropertyColumn>
                        <PropertyColumn Property="x => x.TKHQ_SoToKhai" Title="@Localizer["Request Customs No."]">
                            <EditTemplate></EditTemplate>
                            <CellTemplate>
                                <MudLink OnClick="@(() => OpenDetailRequestCustomsNo(context.Item.TKHQ_SoToKhai))">@context.Item.TKHQ_SoToKhai</MudLink>
                            </CellTemplate>
                        </PropertyColumn>
                        <PropertyColumn Property="x => formatDate(x.TKHQ_NgayDangKy)" Title="@Localizer["Reg. Date"]">
                            <EditTemplate></EditTemplate>
                        </PropertyColumn>
                        <PropertyColumn Property="x => x.TKHQ_MaDonVi" Title="@Localizer["Unit Code"]">
                            <EditTemplate></EditTemplate>
                        </PropertyColumn>
                        <PropertyColumn Property="x => formatDate(x.TKHQ_NgayThongQuan)" Title="@Localizer["Customs Clearance Date"]">
                            <EditTemplate></EditTemplate>
                        </PropertyColumn>
                        <PropertyColumn Property="x => formatDate(x.TKHQ_NgayQuaKhuVucGiamSat)" Title="@Localizer["Through Surveillance Area Date"]">
                            <EditTemplate></EditTemplate>
                        </PropertyColumn>
                        <PropertyColumn Property="x => x.TKHQ_TenLuong" Title="@Localizer["Customs Stream Name"]">
                            <EditTemplate></EditTemplate>
                        </PropertyColumn>
                    </Columns>
                </MudDataGrid>
            </MudTabPanel>
            <MudTabPanel Text="Debit" Class="custom-tab">
                <DebitTab_5_0 Type="HBL" HBLDetail="hbldetail ==  null ? new M_HBL() : hbldetail" Customers="Customers" isDuty="false"/>
            </MudTabPanel>
            <MudTabPanel Text="Credit" Class="custom-tab">
                <CreditTab_5_0 Type="HBL" HBLDetail="hbldetail ==  null ? new M_HBL() : hbldetail" Customers="Customers" isCommission="false"/>
            </MudTabPanel>
            <MudTabPanel Text="Refund Duty" Class="custom-tab" Disabled>
                <DebitTab Type="HBL" HBLDetail="hbldetail ==  null ? new M_HBL() : hbldetail" Customers="Customers" isDuty="true"/>
            </MudTabPanel>
            <MudTabPanel Text="Commission" Class="custom-tab" Disabled>
                <CreditTab Type="HBL" HBLDetail="hbldetail ==  null ? new M_HBL() : hbldetail" Customers="Customers" isCommission="true"/>
            </MudTabPanel>
        </MudTabs>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Close</MudButton>
    </DialogActions>
</MudDialog>
@code {
    [Parameter] public M_Job? JobDetail { get; set; } = default!;
    [CascadingParameter] MudDialogInstance? MudDialog { get; set; }
    [Parameter] public List<M_Customer>? Customers { get; set; } = default!;
    M_HBL detail;
    M_HBL detail_history;
    void CallSnackBar(string message, MudBlazor.Severity severity)
    {

        Snackbar.Configuration.SnackbarVariant = Variant.Filled;
        Snackbar.Configuration.MaxDisplayedSnackbars = 3;
        Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopRight;
        Snackbar.Add(message, severity);
    }

    private void Submit()
    {
        MudDialog!.Close();
    }

    void Cancel() => MudDialog!.Cancel();
    string usr;
    List<string> trangthais = new List<string>();
    List<string?> SoToKhais = new List<string?>();
    protected async override Task OnInitializedAsync()
    {
        try
        {
            usr = asv.GetAuth().Result.User.Identity!.Name!;
            var tts = await supsv.GetListTrangThai();
            trangthais = tts.Where(x => x.Tieude == "HBL").OrderBy(x => x.Noidung).Select(x => x.Noidung).ToList();
            SoToKhais = hqsv.GetListSoToKhai();
            await Refresh();
        }
        catch(Exception ex)
        {
            CallSnackBar(string.Format(Localizer["SomethingWentWrong"], ex.Message), MudBlazor.Severity.Error);
        }
    }
    DialogOptions optionsdialog = new DialogOptions
        {
            ClassBackground = "class-dialog-custom",
            FullWidth = true,
            MaxWidth = MaxWidth.ExtraLarge,
            CloseOnEscapeKey = false,
            DisableBackdropClick = true,
        };
    bool _loading = false;
    List<M_HBL> Listdata = new List<M_HBL>();
    M_HBL hbldetail = new M_HBL();
    async Task Refresh()
    {
        try
        {
            hbldetail = null!;
            _loading = true;
            // Simulate asynchronous loading to demonstrate a loading indicator
            Listdata.Clear();
            StateHasChanged();
            await Task.Delay(500);
            Listdata = await shipsv.GetListHBLByJobid(JobDetail!.JobID);
            if (Listdata.Count > 0)
                hbldetail = Listdata[0];
        }
        finally
        {
            _loading = false;
        }
        await InvokeAsync(StateHasChanged);
        if (mudTable != null && Listdata.Count > 0)
            await mudTable.SetSelectedItemAsync(Listdata[0]);
    }
    MudDataGrid<M_HBL> mudTable;
    async Task AddItem()
    {
        var item = new M_HBL();
        Listdata.Add(item);
        await mudTable.SetEditingItemAsync(Listdata.LastOrDefault()!);
    }

    async Task DeleteItem(M_HBL item)
    {
        if (!await ssv.CheckPermission(usr, "Delete", "HBL"))
        {
            CallSnackBar(Localizer["NoPermission_Delete"], MudBlazor.Severity.Warning);
            return;
        }
        if (item == null)
        {
            CallSnackBar(Localizer["SelectOneRow"], MudBlazor.Severity.Warning);
            return;
        }
        if (item.approve.HasValue && item.approve.Value)
        {
            CallSnackBar(Localizer["HblApproved"], MudBlazor.Severity.Info);
            return;
        }
        var resultMess = await DialogService.ShowMessageBox(
                Localizer["Warning"],
                Localizer["DeleteConfirmBody"],
                yesText: Localizer["delete"], cancelText: Localizer["cancel"]);

        if (resultMess.HasValue)
        {
            var rs = await shipsv.DeleteHBLDetail(item);
            await HistoryLogService.LogAsync(usr, "Delete HBL", "Shipment", item.hblID, item.hbl, item);
            CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
            await Refresh();
        }

    }
    async Task UpdateHBLNo(M_HBL item, DateTime value)
    {
        var refno = await supsv.GetRefNoByFunc("HBL", value.Month, value.Year, usr);
        item.TKHQ_MaHaiQuan = "Customs" + value.ToString("yyMM") + (refno.HasValue ? refno.Value.ToString("D5") : "RefNoError!");
    }
    async Task CommittedItem(M_HBL item)
    {

        item.Jobid = JobDetail!.JobID;
        item.userupdate = usr;
        var rs = item.hblID != Guid.Empty ? await shipsv.UpdateHBLDetail(item,detail) : await shipsv.CreateTruckDetail(item);
        CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
        await Refresh();
    }

    private int selectedRowNumber = -1;
    private string SelectedRowClassFunc(M_HBL Sis, int rowNumber)
    {
        if (Sis.approve.HasValue && Sis.approve.Value)
        {
            return "custom-disable"; // Gán class "disable" nếu Approve = true
        }
        else if (mudTable.SelectedItem != null && mudTable.SelectedItem.Equals(Sis))
        {
            return "selected"; // Giữ lớp "selected" cho dòng đã chọn
        }
        else
        {
            return string.Empty;
        }
    }
    void RowClicked(DataGridRowClickEventArgs<M_HBL> args)
    {
        if (args.Item.approve.HasValue && args.Item.approve.Value)
            CallSnackBar(Localizer["HblApproved"], MudBlazor.Severity.Info);
        else hbldetail = args.Item;
    }

    void RowRightClicked(DataGridRowClickEventArgs<M_HBL> args)
    {

    }
    private async Task<IEnumerable<string?>> SearchSoToKhai(string? text)
    {
        try
        {
            if (string.IsNullOrEmpty(text))
            {
                return SoToKhais;
            }
            // MBL.Porname = mst_Consignee;
            return SoToKhais.Where(x => !string.IsNullOrEmpty(x) && x.Contains(text, StringComparison.OrdinalIgnoreCase));
        }
        catch (Exception)
        {
            throw;
        }
    }
    string formatDate(DateTime? date)
    {
        if (date == null)
            return string.Empty;
        return date.Value.ToString("dd/MM/yyyy");
    }
    private async Task OpenDetailRequestCustomsNo(string? no)
    {
        var tr = hqsv.GetDetailByNo(no);
        var optionsdialog = new DialogOptions { ClassBackground = "class-dialog-custom", FullWidth = true, MaxWidth = MaxWidth.Medium };
        if (tr == null)
        {
            CallSnackBar(Localizer["DataNotFound"], MudBlazor.Severity.Warning);
            return;
        }
        DialogOptions closeOnEscapeKey = new DialogOptions() { CloseOnEscapeKey = true };
        var parameters = new DialogParameters<TKHQ.Pages.ADD> { { x => x._THKQ_Thongtinchung_Detail, tr }, { x => x.Status, "edit" } };
        var dialog = await DialogService.ShowAsync<TKHQ.Pages.ADD>(no, parameters, optionsdialog);
        var result = await dialog.Result;
        StateHasChanged();
        return;
    }

    async Task UpdatebyCheckboxClick(M_HBL item)
    {
        if (!await ssv.CheckPermission(usr, "Approve", "HBL"))
        {
            CallSnackBar(Localizer["NoPermission_Approve"], MudBlazor.Severity.Warning);
            return;
        }
        item.dateupdate = DateTime.Now.ToString("dd/MMM/yyyy", new System.Globalization.CultureInfo("en-US"));
        item.userupdate = usr;
        var rs = await shipsv.UpdateHBLDetail_approve(item);
        if (!rs.Flag) CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
    }
    async Task TryStartEditing(M_HBL item)
    {
        
        if (item.approve.HasValue && item.approve.Value)
        {
            CallSnackBar(Localizer["HblApproved"], MudBlazor.Severity.Warning);
            return;
        }
        detail = JsonSerializer.Deserialize<M_HBL>(JsonSerializer.Serialize(item));
        await mudTable.SetEditingItemAsync(item);
    }
}