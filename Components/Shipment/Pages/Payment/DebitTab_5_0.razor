    async Task UpdatebyCheckboxClick(M_Debit item)
    {
        if (!await ssv.CheckPermission(usr, "Approve", "HBL"))
        {
            CallSnackBar("You have not access to Approve", MudBlazor.Severity.Warning);
            return;
        }
        item.dateupdate = DateTime.Now.ToString("dd/MMM/yyyy", new CultureInfo("en-US"));
        item.userupdate = usr;
        var rs = await shipsv.UpdateDebitMBL_Approve(item);
        if (!rs.Flag) CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
    }
    async Task OnLockChanged(M_Debit item)
    {
        if (item.khoa != true && !canUnlockDebit)
        {
            item.khoa = true;
            CallSnackBar("Only ACCOUNT or ADMIN can unlock Debit!", MudBlazor.Severity.Warning);
            return;
        }
        var oldData = detail_Debit ?? JsonSerializer.Deserialize<M_Debit>(JsonSerializer.Serialize(item));
        if (oldData != null)
            oldData.khoa = !(item.khoa ?? false);
        item.dateupdate = DateTime.Now.ToString();
        item.userupdate = usr;
        var rs = await shipsv.UpdateDebitMBL(item, oldData!);
        if (!rs.Flag)
            CallSnackBar(rs.Message, MudBlazor.Severity.Error);
    }
    async Task TryStartEditing(M_Debit item)
    {
        if (item.khoa.HasValue && item.khoa.Value)
        {
            CallSnackBar("This Debit is locked!", MudBlazor.Severity.Warning);
            return;
        }
        if (item.approve.HasValue && item.approve.Value)
        {
            CallSnackBar("This Debit is approved!", MudBlazor.Severity.Warning);
            return;
        }
  
        detail_Debit = JsonSerializer.Deserialize<M_Debit>(JsonSerializer.Serialize(item));
        await mudTable.SetEditingItemAsync(item);
    }
