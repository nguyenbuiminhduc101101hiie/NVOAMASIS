@using MudBlazor
<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Export Bill Sea - Vessel/Voyage display</MudText>
    </TitleContent>
    <DialogContent>
        <MudText Class="mb-3">Choose where to show vessel-voyage number:</MudText>
        <MudRadioGroup @bind-SelectedOption="SelectedOption" T="string">
            <MudRadio Option="@PreCarriageOption" Color="Color.Primary">Pre-Carriage</MudRadio>
            <MudRadio Option="@VesselVoyOption" Color="Color.Primary">Vessel & Voy No.</MudRadio>
        </MudRadioGroup>
        <MudCheckBox @bind-Checked="Attach"
                     Label="Attach"
                     Color="Color.Primary"
                     Class="mt-2" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Submit" Color="Color.Primary" Variant="Variant.Filled">OK</MudButton>
        <MudButton OnClick="Cancel" Color="Color.Secondary">Cancel</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private const string PreCarriageOption = "precarriage";
    private const string VesselVoyOption = "vesselvoy";

    [CascadingParameter]
    public MudDialogInstance MudDialog { get; set; } = default!;

    private string SelectedOption { get; set; } = PreCarriageOption;
    private bool Attach { get; set; }

    private void Submit()
    {
        bool showPreCarriage = SelectedOption == PreCarriageOption;
        MudDialog.Close(DialogResult.Ok((showPreCarriage, Attach)));
    }

    private void Cancel() => MudDialog.Cancel();
}
