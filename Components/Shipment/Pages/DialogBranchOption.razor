<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.AccountTree" Class="mr-2" />
            Chon Branch
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.subtitle1" Class="mb-2"><b>Chon branch cua company</b></MudText>
        <MudRadioGroup @bind-Value="SelectedBranch" T="string">
            @foreach (var branch in BranchOptions)
            {
                <MudRadio Value="@branch" Color="Color.Primary">@branch</MudRadio>
            }
        </MudRadioGroup>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Submit" Color="Color.Primary" Variant="Variant.Filled"
                   Disabled="@string.IsNullOrWhiteSpace(SelectedBranch)">
            Chon
        </MudButton>
        <MudButton OnClick="Cancel" Color="Color.Default">Cancel</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    public MudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public List<string> BranchOptions { get; set; } = new();

    private string SelectedBranch { get; set; } = string.Empty;

    protected override void OnParametersSet()
    {
        if (string.IsNullOrWhiteSpace(SelectedBranch))
        {
            SelectedBranch = BranchOptions.FirstOrDefault() ?? string.Empty;
        }
    }

    private void Submit()
    {
        MudDialog.Close(DialogResult.Ok(SelectedBranch));
    }

    private void Cancel() => MudDialog.Cancel();
}
