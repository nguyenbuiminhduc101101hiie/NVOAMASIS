<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.Print" Class="mr-2" />
            Export Bill - Chọn mẫu Bill
        </MudText>
    </TitleContent>
    <DialogContent>
        @* ── Chọn loại Bill ── *@
        <MudText Typo="Typo.subtitle1" Class="mb-2"><b>Loại Bill</b></MudText>
        <MudRadioGroup @bind-Value="SelectedBillType" T="string">
            <MudRadio Value="@("PASL")" Color="Color.Primary">PASL (Pacific Star Logistics)</MudRadio>
            <MudRadio Value="@("VietStar")" Color="Color.Primary">VietStar (Viet Star Shipping Line)</MudRadio>
            <MudRadio Value="@("AMSS")" Color="Color.Primary">AMSS (Amasis Shipping)</MudRadio>
            <MudRadio Value="@("HDS")" Color="Color.Primary">HDS (Hafez Darya Arya Shipping)</MudRadio>
        </MudRadioGroup>

        <MudDivider Class="my-3" />

        @* ── Chọn bản in: Original / Draft ── *@
        <MudText Typo="Typo.subtitle1" Class="mb-2"><b>Bản in</b></MudText>
        <MudRadioGroup @bind-Value="IsOriginal" T="bool">
            <MudRadio Value="false" Color="Color.Secondary">
                <MudText>Draft <MudText Typo="Typo.caption" Color="Color.Default"></MudText></MudText>
            </MudRadio>
            <MudRadio Value="true" Color="Color.Secondary">
                <MudText>Original <MudText Typo="Typo.caption" Color="Color.Default"></MudText></MudText>
            </MudRadio>
        </MudRadioGroup>

        <MudDivider Class="my-3" />

        @* ── Vessel / Voyage display ── *@
        <MudText Typo="Typo.subtitle1" Class="mb-2"><b>Vessel / Voyage hiển thị</b></MudText>
        <MudRadioGroup @bind-Value="SelectedVesselOption" T="string">
            <MudRadio Value="@PreCarriageOption" Color="Color.Tertiary">Pre-Carriage</MudRadio>
            <MudRadio Value="@VesselVoyOption" Color="Color.Tertiary">Vessel &amp; Voy No.</MudRadio>
        </MudRadioGroup>

        <MudCheckBox @bind-Value="Attach"
                     Label="Attach"
                     Color="Color.Primary"
                     Class="mt-2" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Submit" Color="Color.Primary" Variant="Variant.Filled"
                   Disabled="@string.IsNullOrEmpty(SelectedBillType)">
            <MudIcon Icon="@Icons.Material.Filled.PictureAsPdf" Class="mr-1" /> Export
        </MudButton>
        <MudButton OnClick="Cancel" Color="Color.Default">Cancel</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private const string PreCarriageOption = "precarriage";
    private const string VesselVoyOption   = "vesselvoy";

    [CascadingParameter]
    public MudDialogInstance MudDialog { get; set; } = default!;

    /// <summary>Loại bill: PASL | VietStar | AMSS | HDS</summary>
    private string SelectedBillType { get; set; } = "PASL";

    /// <summary>true = Original (không logo), false = Draft (có logo)</summary>
    private bool IsOriginal { get; set; } = false;

    private string SelectedVesselOption { get; set; } = PreCarriageOption;
    private bool Attach { get; set; }

    private void Submit()
    {
        bool showPreCarriage = SelectedVesselOption == PreCarriageOption;
        MudDialog.Close(DialogResult.Ok(new BillExportOptions
        {
            BillType        = SelectedBillType,
            IsOriginal      = IsOriginal,
            ShowPreCarriage = showPreCarriage,
            Attach          = Attach
        }));
    }

    private void Cancel() => MudDialog.Cancel();

    /// <summary>DTO trả kết quả dialog về caller.</summary>
    public class BillExportOptions
    {
        public string BillType        { get; set; } = "PASL";
        public bool   IsOriginal      { get; set; }
        public bool   ShowPreCarriage { get; set; } = true;
        public bool   Attach          { get; set; }
    }
}
