    // --- Copy Debit from searched HBL (HBL mode only) ---
    private readonly SemaphoreSlim _copyQuerySemaphore = new(1, 1);
    private readonly Dictionary<Guid, M_HBL> _hblLookup = new();
    private readonly Dictionary<string, string> _debitNoBySourceKey = new(StringComparer.OrdinalIgnoreCase);
    private readonly HashSet<Guid> copiedDebitIds = new();

    private MudAutocomplete<Guid?>? _hblNoAutocomplete;
    private List<M_Debit> sourceDebitList = new();
    private List<M_HBL> searchedHBLs = new();
    private List<PortModel> Ports = new();

    private bool searchPanelExpanded = true;
    private bool sourceDebitGridVisible = true;
    private Guid? _copySourceHblId;
    private string? _filterPol;
    private string? _filterPod;
    private Guid? _filterCustomerId;
    private DateTime? _filterEtd;
    private DateTime? _filterEta;
    private string? searchHBLMessage;

    private bool _loadingHblNoSearch;
    private bool _loadingSearchHBL;
    private bool _loadingSourceDebit;
    private bool _copyingDebitRow;

    private Guid? CurrentHblId => HBLDetail?.hblID;

    private string HblIdToText(Guid? id)
    {
        if (id == null || id == Guid.Empty) return string.Empty;
        if (!_hblLookup.TryGetValue(id.Value, out var hbl))
            hbl = searchedHBLs.FirstOrDefault(x => x.hblID == id.Value);
        if (hbl == null) return string.Empty;

        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(hbl.hbl))
            parts.Add(hbl.hbl);
        if (!string.IsNullOrWhiteSpace(hbl.polname))
            parts.Add(hbl.polname);
        if (!string.IsNullOrWhiteSpace(hbl.podname))
            parts.Add(hbl.podname);
        if (hbl.ETD.HasValue)
            parts.Add(hbl.ETD.Value.ToString("dd/MM/yyyy"));
        if (hbl.ETA.HasValue)
            parts.Add(hbl.ETA.Value.ToString("dd/MM/yyyy"));

        return string.Join(" | ", parts);
    }

    private void CacheHblResults(IEnumerable<M_HBL> hbls)
    {
        foreach (var hbl in hbls)
            _hblLookup[hbl.hblID] = hbl;
    }

    private async Task<IEnumerable<Guid?>> SearchHblNoLike(string text)
    {
        if (searchedHBLs.Count > 0)
        {
            if (string.IsNullOrWhiteSpace(text))
                return searchedHBLs.Select(x => (Guid?)x.hblID);

            return searchedHBLs
                .Where(x => MatchesHblSearchText(x, text))
                .Select(x => (Guid?)x.hblID);
        }

        if (string.IsNullOrWhiteSpace(text))
            return Enumerable.Empty<Guid?>();

        if (!await _copyQuerySemaphore.WaitAsync(0))
        {
            return _hblLookup.Values
                .Where(x => MatchesHblSearchText(x, text))
                .Select(x => (Guid?)x.hblID);
        }

        try
        {
            _loadingHblNoSearch = true;
            StateHasChanged();

            var results = await shipsv.SearchHBLByHblNoLike(text, CurrentHblId);
            CacheHblResults(results);
            return results.Select(x => (Guid?)x.hblID);
        }
        finally
        {
            _loadingHblNoSearch = false;
            _copyQuerySemaphore.Release();
        }
    }

    private static bool MatchesHblSearchText(M_HBL hbl, string text)
    {
        if (string.IsNullOrWhiteSpace(text))
            return true;

        return (!string.IsNullOrEmpty(hbl.hbl) && hbl.hbl.Contains(text, StringComparison.OrdinalIgnoreCase))
            || (!string.IsNullOrEmpty(hbl.polname) && hbl.polname.Contains(text, StringComparison.OrdinalIgnoreCase))
            || (!string.IsNullOrEmpty(hbl.podname) && hbl.podname.Contains(text, StringComparison.OrdinalIgnoreCase));
    }

    private Task<IEnumerable<string>> SearchFilterPort(string text)
    {
        var portNames = Ports
            .Where(x => x.show != false && !string.IsNullOrWhiteSpace(x.PORT))
            .Select(x => x.PORT!)
            .Distinct()
            .OrderBy(x => x);

        if (string.IsNullOrWhiteSpace(text))
            return Task.FromResult<IEnumerable<string>>(portNames);

        return Task.FromResult<IEnumerable<string>>(portNames.Where(x => x.Contains(text, StringComparison.OrdinalIgnoreCase)));
    }

    private Task<IEnumerable<Guid?>> SearchFilterCustomer(string text)
    {
        if (string.IsNullOrWhiteSpace(text))
            return Task.FromResult(Customers.Select(x => (Guid?)x.Customer_ID));

        return Task.FromResult(Customers.Where(x =>
                (x.shortname + "_" + x.COMPANY).Contains(text, StringComparison.OrdinalIgnoreCase) ||
                (!string.IsNullOrWhiteSpace(x.TaxCode) && x.TaxCode.Contains(text, StringComparison.OrdinalIgnoreCase)) ||
                (!string.IsNullOrWhiteSpace(x.Customer_Code) && x.Customer_Code.Contains(text, StringComparison.OrdinalIgnoreCase)))
            .Select(x => (Guid?)x.Customer_ID));
    }

    private bool HasAtLeastOneHblFilter()
        => !string.IsNullOrWhiteSpace(_filterPol)
           || !string.IsNullOrWhiteSpace(_filterPod)
           || (_filterCustomerId.HasValue && _filterCustomerId.Value != Guid.Empty)
           || _filterEtd.HasValue
           || _filterEta.HasValue;

    private async Task SearchHblByFilter()
    {
        if (!HasAtLeastOneHblFilter())
        {
            CallSnackBar("Vui lòng nhập ít nhất 1 điều kiện: POL, POD, Customer, ETD hoặc ETA.", MudBlazor.Severity.Warning);
            return;
        }

        if (!await _copyQuerySemaphore.WaitAsync(0))
        {
            CallSnackBar("Đang tải dữ liệu, vui lòng thử lại sau.", MudBlazor.Severity.Info);
            return;
        }

        try
        {
            _loadingSearchHBL = true;
            searchHBLMessage = null;
            searchedHBLs.Clear();
            _copySourceHblId = null;
            sourceDebitList.Clear();
            StateHasChanged();

            searchedHBLs = await shipsv.SearchHBLByFilter(
                _filterPol, _filterPod, _filterCustomerId, _filterEtd, _filterEta, CurrentHblId);
            CacheHblResults(searchedHBLs);

            searchHBLMessage = searchedHBLs.Count == 0
                ? "Không tìm thấy HBL phù hợp."
                : searchedHBLs.Count == 1
                    ? "Tìm thấy 1 HBL. Đã chọn tự động."
                    : $"Tìm thấy {searchedHBLs.Count} HBL. Chọn trong ô HBL No.";
        }
        catch (Exception)
        {
            CallSnackBar("Lỗi khi tìm HBL.", MudBlazor.Severity.Error);
        }
        finally
        {
            _loadingSearchHBL = false;
            _copyQuerySemaphore.Release();
        }

        if (searchedHBLs.Count == 1)
        {
            await OnCopySourceHblChanged(searchedHBLs[0].hblID);
        }
        else if (searchedHBLs.Count > 1)
            await OpenHblNoSearchResults();
    }

    private async Task OpenHblNoSearchResults()
    {
        await InvokeAsync(StateHasChanged);
        if (_hblNoAutocomplete != null)
            await _hblNoAutocomplete.ToggleMenu();
    }

    private void ToggleSourceDebitGridVisible()
    {
        sourceDebitGridVisible = !sourceDebitGridVisible;
    }

    private async Task OnCopySourceHblChanged(Guid? hblId)
    {
        _copySourceHblId = hblId;
        sourceDebitList.Clear();
        sourceDebitGridVisible = true;

        if (hblId == null || hblId == Guid.Empty)
            return;

        if (hblId == CurrentHblId)
        {
            CallSnackBar("Không thể chọn chính HBL hiện tại.", MudBlazor.Severity.Warning);
            _copySourceHblId = null;
            return;
        }

        await _copyQuerySemaphore.WaitAsync();
        try
        {
            _loadingSourceDebit = true;
            StateHasChanged();
            await LoadSourceDebitsInternal(hblId.Value);
        }
        catch (Exception)
        {
            CallSnackBar("Lỗi khi tải Debit của HBL.", MudBlazor.Severity.Error);
        }
        finally
        {
            _loadingSourceDebit = false;
            _copyQuerySemaphore.Release();
        }
    }

    private async Task LoadSourceDebitsInternal(Guid hblId)
    {
        sourceDebitList = await shipsv.GetListDebitHBL(hblId, isDuty);
    }

    private async Task<string> GenerateNewDebitNo(Guid targetMblId)
    {
        var now = DateTime.Now;
        var refno = await supsv.GetRefNoByFunc("Debit", now.Month, now.Year, usr);
        var tiepdaungu = await supsv.GetTiepDauNguByFunc("JOB");
        var userDetail = asv.GetUserDetail();
        var cn = userDetail.Branch;
        var flc = await shipsv.GetFLCByMBLID(targetMblId);
        var shipmentType = await shipsv.GetTypeByMBLID(targetMblId);
        return cn + tiepdaungu + shipmentType + flc + now.ToString("yyMM") + (refno.HasValue ? refno.Value.ToString("D4") : "RefNoError!");
    }

    private async Task CopySourceDebitToCurrent(M_Debit item)
    {
        if (HBLDetail == null || HBLDetail.hblID == Guid.Empty)
        {
            CallSnackBar("Please select 1 row HBL", MudBlazor.Severity.Warning);
            return;
        }

        if (item == null)
            return;

        if (_copySourceHblId == HBLDetail.hblID)
        {
            CallSnackBar("Không thể copy Debit từ chính HBL hiện tại.", MudBlazor.Severity.Warning);
            return;
        }

        try
        {
            _copyingDebitRow = true;
            StateHasChanged();

            var sourceDebitNoKey = item.debitno ?? string.Empty;
            if (!_debitNoBySourceKey.TryGetValue(sourceDebitNoKey, out var targetDebitNo))
            {
                targetDebitNo = await GenerateNewDebitNo(HBLDetail.mblid);
                _debitNoBySourceKey[sourceDebitNoKey] = targetDebitNo;
            }

            var newDebit = new M_Debit
            {
                debitId = Guid.Empty,
                quotationid = item.quotationid,
                debitno = targetDebitNo,
                mblid = HBLDetail.mblid,
                hblid = HBLDetail.hblID,
                itemid = item.itemid,
                customerid = item.customerid,
                dongia = item.dongia,
                soluong = item.soluong,
                thanhtien = item.thanhtien,
                tiente = item.tiente,
                thue = item.thue,
                thanhtiensauthue = item.thanhtiensauthue,
                thuho = item.thuho,
                tigiadebit = item.tigiadebit,
                tigiahoandondaura = item.tigiahoandondaura,
                pol = item.pol,
                pod = item.pod,
                del = item.del,
                nhom = item.nhom,
                ghichu = item.ghichu,
                type = item.type,
                continued = true,
                editable = true,
                approve = false,
                dateupdate = DateTime.Now.ToString("dd/MM/yyyy"),
                userupdate = usr,
                daIndebit = false,
                daXuatHoadon = false,
                khoa = false,
                InArrival = false,
                sohoadondaura = null
            };

            var rs = await shipsv.CreateDebitMBL(newDebit);
            if (rs.Flag)
            {
                copiedDebitIds.Add(newDebit.debitId);
                CallSnackBar(rs.Message, MudBlazor.Severity.Success);
                await Refresh();
            }
            else
            {
                CallSnackBar(rs.Message, MudBlazor.Severity.Error);
            }
        }
        catch (Exception ex)
        {
            CallSnackBar("Throw exception: " + ex.Message, MudBlazor.Severity.Error);
        }
        finally
        {
            _copyingDebitRow = false;
            StateHasChanged();
        }
    }
