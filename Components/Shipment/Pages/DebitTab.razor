    private bool _processingUpload = false;
    string cur_type;
    private async Task ExportBill()
    {
        try
        {
            var optionsdialog = new DialogOptions
            {
                ClassBackground = "class-dialog-custom",
                FullWidth = true,
                MaxWidth = MaxWidth.Small,
                CloseOnEscapeKey = false,
                DisableBackdropClick = true,
            };
            var debitdetail = new M_Debit();
            if (!isMBL)
            {
                var parameters = new DialogParameters<DebitComboboxHBL> { { x => x.hbldetail, HBLDetail } };
                var dialog = await DialogService.ShowAsync<DebitComboboxHBL>("Selected Debit No.", parameters, optionsdialog);
                var result = await dialog.Result;

                if (result.Canceled) return;
                var (debit, text) = ((M_Debit, string))result.Data;

                debitdetail = debit;
                cur_type = text;

                // if (result.Canceled) return;
                // debitdetail = (M_Debit)result.Data;
            }
            else
            {
                var parameters = new DialogParameters<DebitComboboxMBL> { { x => x.mbldetail, MBLDetail } };
                var dialog = await DialogService.ShowAsync<DebitComboboxMBL>("Selected Debit No.", parameters, optionsdialog);
                var result = await dialog.Result;
                if (result.Canceled) return;
                var (debit, text) = ((M_Debit, string))result.Data;

                debitdetail = debit;
                cur_type = text;

            }


            _processingUpload = true;
            StateHasChanged();
            await Task.Delay(1);

            var billType = string.Empty;
            var branches = string.Empty;
            if (type != "SI" || isMBL)
            {
                var companyOptions = await gsv.GetCompanyOtherList();
                billType = companyOptions
                    .Select(x => x.Code?.Trim())
                    .Where(x => !string.IsNullOrWhiteSpace(x))
                    .Distinct(StringComparer.OrdinalIgnoreCase)
                    .FirstOrDefault() ?? string.Empty;
                if (string.IsNullOrWhiteSpace(billType))
                {
                    CallSnackBar("Không tìm thấy thông tin công ty", MudBlazor.Severity.Error);
                    return;
                }
                var resolvedBranches = await ResolveBranchByCompanyAsync(billType);
                if (resolvedBranches is null) return;
                branches = resolvedBranches;
            }

            if (type == "SI")
            {
                if (isMBL)
                {
                    var rs = await shipsv.ExportDebitSI_mbl(debitdetail, cur_type, billType, branches);
                    CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
                }
                else
                {
                    var rs = await shipsv.ExportDebitSI(debitdetail, cur_type);
                    CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
                }

            }
            else if (type == "SE")
            {
                if (isMBL)
                {
                    var rs = await shipsv.ExportDebitSE_mbl(debitdetail, cur_type, billType, branches);
                    CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
                }
                else
                {
                    var rs = await shipsv.ExportDebitSE(debitdetail, cur_type, billType, branches);
                    CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
                }

            }
            else if (type == "AI")
            {
                if (isMBL)
                {
                    var rs = await shipsv.ExportDebitAI_mbl(debitdetail, cur_type, billType, branches);
                    CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
                }
                else
                {
                    var rs = await shipsv.ExportDebitAI(debitdetail, cur_type, billType, branches);
                    CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
                }
            }
            else if (type == "AE")
            {
                if (isMBL)
                {
                    var rs = await shipsv.ExportDebitAE_mbl(debitdetail, cur_type, billType, branches);
                    CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
                }
                else
                {
                    var rs = await shipsv.ExportDebitAE(debitdetail, cur_type, billType, branches);
                    CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
                }

            }
            else if (type == "Truck")
            {
                var rs = await shipsv.ExportDebitTruck(debitdetail, cur_type, isMBL, billType, branches);
                CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
            }
            else
            {
                CallSnackBar($"Chưa có mẫu bill cho loại '{type}' ", MudBlazor.Severity.Warning);
                return;
            }
            var dbs = await shipsv.GetListDebit_Debitno(debitdetail.debitno);
            dbs.ForEach(x => x.daIndebit = true);
            var ud = await shipsv.UpdateDebitMBL(dbs); // update đã in debit
            await Refresh();
        }
        catch (Exception ex)
        {
            CallSnackBar("Throw exception: " + ex.Message, MudBlazor.Severity.Error);
        }
        finally
        {
            _processingUpload = false;
        }
    }

    private async Task<string?> ResolveBranchByCompanyAsync(string billType)
    {
        var companyOptions = await gsv.GetCompanyOtherList();
        var branchesByCompany = companyOptions
            .Where(x => string.Equals(x.Code?.Trim(), billType.Trim(), StringComparison.OrdinalIgnoreCase))
            .Select(x => x.Branches?.Trim())
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();

        if (!branchesByCompany.Any())
        {
            return string.Empty;
        }

        if (branchesByCompany.Count == 1)
        {
            return branchesByCompany[0]!;
        }

        var branchDialogOptions = new DialogOptions
        {
            ClassBackground = "class-dialog-custom",
            FullWidth = true,
            MaxWidth = MaxWidth.ExtraSmall,
            CloseOnEscapeKey = true,
            DisableBackdropClick = true
        };
        var branchParameters = new DialogParameters<Shipment.Pages.DialogBranchOption>
        {
            { x => x.BranchOptions, branchesByCompany! }
        };
        var branchDialogRef = await DialogService.ShowAsync<Shipment.Pages.DialogBranchOption>("Debit - Chon Branch", branchParameters, branchDialogOptions);
        var branchResult = await branchDialogRef.Result;
        if (branchResult.Canceled)
        {
            return null;
        }
        return branchResult.Data?.ToString() ?? string.Empty;
    }

