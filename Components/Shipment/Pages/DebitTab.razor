@using System.Globalization
@using System.Threading
@inject CustomerService csv
@inject SupportServices supsv
@inject SharedServices ssv
@inject AccountService asv
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject ShipmentService shipsv
@inject IStringLocalizer<SharedResource> Localizer
@inject HistoryLogService HistoryLogService
@using System.Text.Json;
@inject tigiaVCBservices Vcbsv
@inject GlobalServices gsv

<MudTabs SliderColor="Color.Success">
    <MudTabPanel Text="@(isDuty ? "Input" : "Debit")" BadgeColor="Color.Secondary" Class="custom-tab">
        @if (!isMBL)
        {
            <MudExpansionPanels Class="debit-copy-search-panel mb-3" Elevation="0">
                <MudExpansionPanel Text="Tìm HBL để copy Debit"
                                   Icon="@Icons.Material.Filled.Search"
                                   @bind-IsExpanded="searchPanelExpanded"
                                   Dense="true"
                                   Class="debit-copy-search-expansion">
                    <MudStack Row="true"
                              Spacing="2"
                              AlignItems="AlignItems.End"
                              Wrap="Wrap.Wrap"
                              Class="debit-copy-search-row">
                        <div class="debit-copy-search-field debit-copy-search-hblno">
                            <MudAutocomplete T="Guid?"
                                             @ref="_hblNoAutocomplete"
                                             Class="debit-copy-search-input"
                                             Value="_copySourceHblId"
                                             ValueChanged="OnCopySourceHblChanged"
                                             Label="HBL No."
                                             Variant="Variant.Outlined"
                                             Dense="@true"
                                             Margin="Margin.Dense"
                                             SearchFunc="SearchHblNoLike"
                                             ToStringFunc="HblIdToText"
                                             ResetValueOnEmptyText
                                             Clearable
                                             Strict="false"
                                             MinCharacters="0"
                                             DebounceInterval="300"
                                             MaxItems="20"
                                             ShowProgressIndicator="@_loadingHblNoSearch"
                                             FullWidth="@true" />
                        </div>
                        <div class="debit-copy-search-field debit-copy-search-pol">
                            <MudAutocomplete T="string"
                                             Class="debit-copy-search-input"
                                             @bind-Value="_filterPol"
                                             Label="POL"
                                             Variant="Variant.Outlined"
                                             Dense="@true"
                                             Margin="Margin.Dense"
                                             SearchFunc="SearchFilterPort"
                                             ResetValueOnEmptyText
                                             Clearable
                                             FullWidth="@true" />
                        </div>
                        <div class="debit-copy-search-field debit-copy-search-pod">
                            <MudAutocomplete T="string"
                                             Class="debit-copy-search-input"
                                             @bind-Value="_filterPod"
                                             Label="POD"
                                             Variant="Variant.Outlined"
                                             Dense="@true"
                                             Margin="Margin.Dense"
                                             SearchFunc="SearchFilterPort"
                                             ResetValueOnEmptyText
                                             Clearable
                                             FullWidth="@true" />
                        </div>
                        <div class="debit-copy-search-field debit-copy-search-customer">
                            <MudAutocomplete T="Guid?"
                                             Class="debit-copy-search-input"
                                             @bind-Value="_filterCustomerId"
                                             Label="@Localizer["Customer"]"
                                             Variant="Variant.Outlined"
                                             Dense="@true"
                                             Margin="Margin.Dense"
                                             SearchFunc="SearchFilterCustomer"
                                             ToStringFunc="CusidNullableToCusCode"
                                             ResetValueOnEmptyText
                                             Clearable
                                             FullWidth="@true" />
                        </div>
                        <div class="debit-copy-search-field debit-copy-search-etd">
                            <MudDatePicker @bind-Date="_filterEtd"
                                           Label="ETD"
                                           Variant="Variant.Outlined"
                                           Dense="@true"
                                           Margin="Margin.Dense"
                                           Clearable
                                           DateFormat="dd/MM/yyyy"
                                           Class="debit-copy-search-input"
                                           FullWidth="@true" />
                        </div>
                        <div class="debit-copy-search-field debit-copy-search-eta">
                            <MudDatePicker @bind-Date="_filterEta"
                                           Label="ETA"
                                           Variant="Variant.Outlined"
                                           Dense="@true"
                                           Margin="Margin.Dense"
                                           Clearable
                                           DateFormat="dd/MM/yyyy"
                                           Class="debit-copy-search-input"
                                           FullWidth="@true" />
                        </div>
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.Search"
                                   OnClick="SearchHblByFilter"
                                   Disabled="_loadingSearchHBL || _loading"
                                   Class="debit-copy-search-btn">
                            Search
                        </MudButton>
                    </MudStack>
                    @if (!string.IsNullOrWhiteSpace(searchHBLMessage))
                    {
                        <MudText Typo="Typo.caption" Color="Color.Info" Class="mt-2 px-1">@searchHBLMessage</MudText>
                    }
                </MudExpansionPanel>
            </MudExpansionPanels>

            @if (_copySourceHblId.HasValue && _copySourceHblId.Value != Guid.Empty)
            {
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="mb-1">
                    <MudText Typo="Typo.subtitle2">
                        Debit từ HBL: <b>@HblIdToText(_copySourceHblId)</b>
                        @if (sourceDebitList.Count > 0)
                        {
                            <span class="ms-2 text-secondary">(@sourceDebitList.Count dòng)</span>
                        }
                    </MudText>
                    <MudTooltip Text="@(sourceDebitGridVisible ? "Ẩn lưới Debit copy" : "Hiện lưới Debit copy")">
                        <MudIconButton Size="Size.Small"
                                       Icon="@(sourceDebitGridVisible ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                                       Color="Color.Default"
                                       OnClick="ToggleSourceDebitGridVisible" />
                    </MudTooltip>
                </MudStack>
                @if (sourceDebitGridVisible)
                {
                    <div class="debit-copy-grid-wrap">
                        <MudDataGrid T="M_Debit"
                                     Items="@sourceDebitList"
                                     Filterable="true"
                                     FilterMode="@DataGridFilterMode.Simple"
                                     Dense="true"
                                     ReadOnly="true"
                                     Bordered="true"
                                     Hover="false"
                                     Loading="_loadingSourceDebit"
                                     ShowColumnOptions="false"
                                     Class="stock-grid-autofit debit-copy-grid mb-3"
                                     HeaderClass="no-wrap">
                            <ColGroup>
                                <col style="width: 36px;" />
                                <col style="width: 110px;" />
                                <col style="width: 140px;" />
                                <col style="width: 120px;" />
                                <col style="width: 90px;" />
                                <col style="width: 70px;" />
                                <col style="width: 70px;" />
                                <col style="width: 95px;" />
                                <col style="width: 55px;" />
                                <col style="width: 55px;" />
                                <col style="width: 105px;" />
                                <col style="width: 120px;" />
                            </ColGroup>
                            <Columns>
                                <TemplateColumn Title="" Filterable="false" Sortable="false" HeaderStyle="width: 36px;" CellStyle="width: 36px;" CellClass="d-flex justify-center">
                                    <CellTemplate>
                                        <MudTooltip Text="Copy xuống Debit HBL hiện tại">
                                            <MudIconButton Size="Size.Small"
                                                           Icon="@Icons.Material.Filled.South"
                                                           Color="Color.Success"
                                                           OnClick="@(() => CopySourceDebitToCurrent(context.Item))"
                                                           Disabled="_copyingDebitRow" />
                                        </MudTooltip>
                                    </CellTemplate>
                                </TemplateColumn>
                                <PropertyColumn Property="x => x.debitno" Title="@Localizer["Debit No."]" CellClass="no-wrap-cell debit-copy-col-text" HeaderClass="debit-copy-col-text" />
                                <PropertyColumn Property="x => CusidtoCusCode(x.customerid)" Title="@Localizer["Customer"]" CellClass="no-wrap-cell debit-copy-col-text" HeaderClass="debit-copy-col-text" />
                                <PropertyColumn Property="x => Charidtocharge(x.itemid)" Title="@Localizer["Item"]" CellClass="no-wrap-cell debit-copy-col-text" HeaderClass="debit-copy-col-text" />
                                <PropertyColumn Property="x => x.dongia" Title="@Localizer["Unit Price"]" Format="#,##0.##" CellClass="no-wrap-cell debit-copy-col-num" HeaderClass="debit-copy-col-num" />
                                <PropertyColumn Property="x => x.type" Title="@Localizer["Type"]" CellClass="no-wrap-cell debit-copy-col-text" HeaderClass="debit-copy-col-text" />
                                <PropertyColumn Property="x => x.soluong" Title="@Localizer["Quantity"]" Format="#,##0.##" CellClass="no-wrap-cell debit-copy-col-num" HeaderClass="debit-copy-col-num" />
                                <PropertyColumn Property="x => x.thanhtien" Title="@Localizer["Total Price"]" Format="#,##0.##" CellClass="no-wrap-cell debit-copy-col-num" HeaderClass="debit-copy-col-num" />
                                <PropertyColumn Property="x => x.tiente" Title="@Localizer["Loaitiente"]" CellClass="no-wrap-cell debit-copy-col-text" HeaderClass="debit-copy-col-text" />
                                <PropertyColumn Property="x => x.thue" Title="@Localizer["VAT"]" Format="#,##0.##" CellClass="no-wrap-cell debit-copy-col-num" HeaderClass="debit-copy-col-num" />
                                <PropertyColumn Property="x => x.thanhtiensauthue" Title="@Localizer["Total Price Inc. VAT"]" Format="#,##0.##" CellClass="no-wrap-cell debit-copy-col-num" HeaderClass="debit-copy-col-num" />
                                <PropertyColumn Property="x => x.ghichu" Title="@Localizer["Notes"]" CellClass="no-wrap-cell debit-copy-col-text" HeaderClass="debit-copy-col-text" />
                            </Columns>
                        </MudDataGrid>
                    </div>
                    <MudDivider Class="my-2" />
                }
            }

            <MudText Typo="Typo.subtitle2" Class="mb-1">
                Debit HBL hiện tại: <b>@(HBLDetail?.hbl ?? string.Empty)</b>
            </MudText>
        }

        <MudDataGrid T="M_Debit" Items="@Listdata" Filterable="true" @ref="mudTable"
        FilterMode="@DataGridFilterMode.Simple" Dense="true" Virtualize="true"
        FixedHeader="true" FixedFooter="true" HeaderClass="no-wrap" FooterClass="no-wrap"
        ReadOnly="false" CommittedItemChanges="@CommittedItem" RowClassFunc="@SelectedRowClassFunc"
        RowClick="@RowClicked" RowContextMenuClick="RowRightClicked" Bordered="true"
        ColumnResizeMode="ResizeMode.Column" Loading="_loading" ShowColumnOptions="false"
        Class="debit-main-grid">
            <Columns>
                <TemplateColumn CellClass="d-flex justify-end" Filterable="false" ShowColumnOptions="false" Sortable="false">
                    <HeaderTemplate>
                        <MudStack Row="true" Justify="Justify.FlexStart" Spacing="2">

                            <!-- Nút Reload -->
                            <MudTooltip Text="@Localizer["Reload"]">
                                <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                                Color="Color.Success"
                                Size="Size.Small"
                                OnClick="Refresh"
                                Variant="Variant.Filled"
                                Disabled="@(isMBL ? (MBLDetail!.MblID == Guid.Empty ? true : false) : (HBLDetail!.hblID == Guid.Empty ? true : false))"
                                Class="btn-compact" />
                            </MudTooltip>
                            <MudTooltip Text="@Localizer["New In Cell"]">
                                <MudIconButton Icon="@Icons.Material.Filled.OpenInNew"
                                Color="Color.Success"
                                Size="Size.Small"
                                OnClick="NewItemIncell"
                                Variant="Variant.Filled"
                                Disabled="@(isMBL ? (MBLDetail!.MblID == Guid.Empty ? true : false) : (HBLDetail!.hblID == Guid.Empty ? true : false))"
                                Class="btn-compact" />
                            </MudTooltip>
                            <MudTooltip Text="@Localizer["New"]">
                                <MudIconButton Icon="@Icons.Material.Filled.CreateNewFolder"
                                Color="Color.Success"
                                Size="Size.Small"
                                OnClick="NewItem"
                                Variant="Variant.Filled"
                                Disabled="@(isMBL ? (MBLDetail!.MblID == Guid.Empty ? true : false) : (HBLDetail!.hblID == Guid.Empty ? true : false))"
                                Class="btn-compact" />
                            </MudTooltip>

                            <MudTooltip Text="@Localizer["Add"]">
                                <MudIconButton Icon="@Icons.Material.Filled.Add"
                                Color="Color.Success"
                                Size="Size.Small"
                                OnClick="AddItem"
                                Variant="Variant.Filled"
                                Disabled="@(isMBL ? (MBLDetail!.MblID == Guid.Empty ? true : false) : (HBLDetail!.hblID == Guid.Empty ? true : false))"
                                Class="btn-compact" />
                            </MudTooltip>



                            <MudTooltip Text="@Localizer["Bills"]">
                                <MudMenu Icon="@Icons.Material.Filled.Download"
                                Color="Color.Success"
                                Size="Size.Small"
                                Variant="Variant.Filled"
                                Disabled="@(isMBL ? (MBLDetail!.MblID == Guid.Empty ? true : false) : (HBLDetail!.hblID == Guid.Empty ? true : false))"
                                AnchorOrigin="Origin.BottomCenter"
                                TransformOrigin="Origin.TopCenter">
                                    <MudMenuItem Disabled="_processingUpload" OnClick="ExportBill">
                                        @if (_processingUpload)
                                        {
                                            <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                                            <span class="ms-2">Exporting...</span>
                                        }
                                        else
                                        {
                                            @Localizer["Export Debit"]
                                        }
                                    </MudMenuItem>
                                    @if(!isDuty)
                                    {
                                        <MudMenuItem OnClick="CreateInvoice">
                                            @Localizer["Create Invoice"]
                                        </MudMenuItem>
                                    }
                                </MudMenu>
                            </MudTooltip>

                            <MudTooltip Text="@Localizer["Copy_Debit"]">
                                <MudIconButton Icon="@Icons.Material.Filled.ControlPointDuplicate"
                                Color="Color.Success"
                                Size="Size.Small"
                                OnClick="CopyDebitQuotation"
                                Variant="Variant.Filled"
                                Disabled="@(HBLDetail == null || HBLDetail.hblID == Guid.Empty)"
                                Class="btn-compact" />
                            </MudTooltip>

                            <MudTooltip Text="Copy Debit (MBL/HBL)">
                                <MudIconButton Icon="@Icons.Material.Filled.ContentCopy"
                                Color="Color.Success"
                                Size="Size.Small"
                                OnClick="CopyDebitFromMblHbl"
                                Variant="Variant.Filled"
                                Disabled="@(isMBL ? ((MBLDetail?.MblID ?? Guid.Empty) == Guid.Empty) : ((HBLDetail?.hblID ?? Guid.Empty) == Guid.Empty))"
                                Class="btn-compact" />
                            </MudTooltip>
                            @if(!isDuty)
                            {
                                <MudTooltip Text="@Localizer["Help"]">
                                    <a href="HDSDhtml/Huong_dan_Tab_Debit_CAPNHAT.html" target="_blank">
                                        <MudIconButton Icon="@Icons.Material.Filled.Info"
                                                       Color="Color.Info"
                                                       Size="Size.Small"
                                                       Variant="Variant.Filled"
                                                       Class="btn-compact" />
                                    </a>
                                </MudTooltip>
                            }
                            else
                            {
                                <MudTooltip Text="@Localizer["Help"]">
                                    <a href="HDSDhtml/Huong_dan_Tab_Refund_Duty.html" target="_blank">
                                        <MudIconButton Icon="@Icons.Material.Filled.Info"
                                                       Color="Color.Info"
                                                       Size="Size.Small"
                                                       Variant="Variant.Filled"
                                                       Class="btn-compact" />
                                    </a>
                                </MudTooltip>
                            }
                        </MudStack>
                    </HeaderTemplate>
                    <CellTemplate>
                        <MudIconButton Size="@Size.Small" Icon="@Icons.Material.Outlined.Edit" OnClick="@(()=>TryStartEditing(context.Item))" Disabled="context.Item.khoa == true" />
                        <MudIconButton Size="@Size.Small" Icon="@Icons.Material.Outlined.Delete" OnClick="@(()=>DeleteItem(context.Item))" Disabled="context.Item.khoa == true" />
                    </CellTemplate>
                </TemplateColumn>
                <PropertyColumn Property="x => x.debitno" Title="@Localizer["Debit No."]" Required="false" >
                    <EditTemplate>
                        <MudTextField @bind-Value="context.Item.debitno" Immediate Label="Debit No." Required ReadOnly/>
                        <MudDatePicker Label="@Localizer["Selected Date Get Debit No"]" DateChanged="((t)=>UpdateDebitNo(context.Item,(DateTime)t!))" 
                        ImmediateText DateFormat="MM/yyyy"  Disabled="!string.IsNullOrEmpty(context.Item.debitno)"/>
                    </EditTemplate>
                </PropertyColumn>
                <PropertyColumn Property="x=>x.approve" Title="@Localizer["Approve"]" IsEditable="false" Required="false">
                    <CellTemplate>
                        <MudCheckBox @bind-Checked="context.Item.approve" @bind-Value="context.Item.approve" @bind-Value:after="@(()=>UpdatebyCheckboxClick(context.Item))" />
                    </CellTemplate>
                    <EditTemplate>
                    </EditTemplate>
                </PropertyColumn>
                <PropertyColumn Property="x => CusidtoCusCode(x.customerid)" Title="@Localizer["Customer"]" Required="false" CellClass="no-wrap-cell">
                    <EditTemplate>
                        <MudAutocomplete @bind-Value="context.Item.customerid" Label="@Localizer["Customer"]" Required
                        SearchFunc="SearchCustomer" ToStringFunc="CusidtoCusCode" Clearable />
                    </EditTemplate>
                </PropertyColumn>
                <PropertyColumn Property="x =>  Charidtocharge(x.itemid)" Title="@Localizer["Item"]" Required="false" CellClass="no-wrap-cell">
                    <EditTemplate>
                        <MudAutocomplete @bind-Value="context.Item.itemid" Label="@Localizer["Item"]" Required
                        SearchFunc="SearchCharge" ToStringFunc="Charidtocharge" Clearable/>
                    </EditTemplate>
                </PropertyColumn>
                <PropertyColumn Property="x => x.dongia" Title="@Localizer["Unit Price"]" Format="#,##0.##" Required="false" CellStyle="text-align: right;">
                    <EditTemplate>
                        <MudNumericField @bind-Value="context.Item.dongia" Class="text-right"
                        Label="@Localizer["Unit Price"]" Format="#,##0.##" Culture="@_en" T="double?"
                        TextChanged="@(e => CalculateTotal(context.Item))" HideSpinButtons="true" />
                    </EditTemplate>
                </PropertyColumn>
                <PropertyColumn Property="x=>x.type" Title="@Localizer["Type"]" Required="false" >
                    <EditTemplate>


                        <MudAutocomplete @bind-Value="context.Item.type" Label="@Localizer["Type"]" Required CoerceValue SearchFunc="SearchType" />
                 
                    </EditTemplate>

                </PropertyColumn>
                <PropertyColumn Property="x => x.soluong" Title="@Localizer["Quantity"]" Format="#,##0.##" Required="false">
                    <EditTemplate>
                        <MudNumericField @bind-Value="context.Item.soluong"
                        Label="@Localizer["Quantity"]" Format="#,##0.##" Culture="@_en" T="double?"
                        TextChanged="@(e => CalculateTotal(context.Item))" HideSpinButtons="true" />
                    </EditTemplate>
                </PropertyColumn>

                <PropertyColumn Property="x => x.thanhtien" Title="@Localizer["Total Price"]" Format="#,##0.##" CellStyle="text-align: right;" Required="false">
                    <EditTemplate>
                        <MudNumericField @bind-Value="context.Item.thanhtien" Label="@Localizer["Total Price"]" 
                        Format="#,##0.##" Culture="@_en" T="double?" Class="text-right" HideSpinButtons="true" />
                    </EditTemplate>
                </PropertyColumn>


                <PropertyColumn Property="x => x.tiente" Title="@Localizer["Loaitiente"]" Required="false">
                    <EditTemplate>
                        <MudAutocomplete @bind-Value="context.Item.tiente" Label="@Localizer["Currency"]" Required="true" Class="custom-label" CoerceValue SearchFunc="SearchCurr" />
                    </EditTemplate>
                </PropertyColumn>


                <PropertyColumn Property="x => x.thue" Title="@Localizer["VAT"]" Format="#,##0.##" Required="false">
                    <EditTemplate>
                        <MudNumericField @bind-Value="context.Item.thue" Label="@Localizer["VAT"]"
                        Format="#,##0.##" Culture="@_en" T="double?"
                        TextChanged="@(e => CalculateThanhtiensauthue(context.Item))" HideSpinButtons="true" />
                    </EditTemplate>
                </PropertyColumn>
                <PropertyColumn Property="x => x.thanhtiensauthue" Title="@Localizer["Total Price Inc. VAT"]" Format="#,##0.##" Required="false" CellStyle="text-align: right;">
                    <EditTemplate>
                        <MudNumericField @bind-Value="context.Item.thanhtiensauthue" Label="@Localizer["Total Price Inc. VAT"]"
                        Format="#,##0.##" Culture="@_en" T="double?" Class="text-right" HideSpinButtons="true" />
                    </EditTemplate>
                </PropertyColumn>
                <PropertyColumn Property="x => x.thuho" Title="@Localizer["On Behaft"]" Required="false">
                    <EditTemplate>
                        <MudCheckBox @bind-Checked="context.Item.thuho" Label="@Localizer["On Behaft"]" />
                    </EditTemplate>
                </PropertyColumn>
      

                <PropertyColumn Property="x => x.tigiadebit" Title="@Localizer["Exchange Rate Debit"]" Format="#,##0.##" Required="false">
                    <EditTemplate>
                        <MudStack Row Spacing="1" AlignItems="AlignItems.Center">
                            <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small"
                                       Style="min-width: 80px; height: 36px; padding: 5px 10px;"
                                       OnClick="@(() => GetTigia(context.Item))">
                                @Localizer["gettigia"]
                            </MudButton>

                            <MudNumericField @bind-Value="context.Item.tigiadebit"
                                             Label="@Localizer["Exchange Rate Debit"]"
                                             Format="#,##0.##" Culture="@_en"
                                             T="double?" Required="true" HideSpinButtons="true"
                                             Class="text-right" />
                        </MudStack>
                    </EditTemplate>
                </PropertyColumn>
          

                <PropertyColumn Property="x => x.tigiahoandondaura" Title="@Localizer["Exchange Rate Invoice"]" Format="#,##0.##" Required="false">
                    <EditTemplate>
                        <MudStack Row Spacing="1" AlignItems="AlignItems.Center">
                            <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small"
                                       Style="min-width: 80px; height: 36px; padding: 5px 10px;"
                                       OnClick="@(() => GetTigia_invoice(context.Item))">
                                @Localizer["gettigia"]
                            </MudButton>

                            <MudNumericField @bind-Value="context.Item.tigiahoandondaura"
                                             Label="@Localizer["Exchange Rate Invoice"]"
                                             Format="#,##0.##" Culture="@_en"
                                             T="double?" Required="true" HideSpinButtons="true"
                                             Class="text-right" />
                        </MudStack>
                    </EditTemplate>
                </PropertyColumn>

                <PropertyColumn Property="x => x.ContainerNo" Title="@Localizer["Cont. No."]" Required="false" CellClass="no-wrap-cell">
                    <EditTemplate>
                        <MudAutocomplete T="string"
                                         @bind-Value="context.Item.ContainerNo"
                                         Label="@Localizer["Cont. No."]"
                                         CoerceText="true"
                                         CoerceValue="false"
                                         Clearable
                                         Strict="false"
                                         ResetValueOnEmptyText="true"
                                         SearchFunc="SearchContainerNo" />
                    </EditTemplate>
                </PropertyColumn>
                <PropertyColumn Property="x => x.ghichu" Title="@Localizer["Notes"]" Required="false">
                    <EditTemplate>
                        <MudTextField @bind-Value="context.Item.ghichu" Label="@Localizer["Notes"]" Placeholder="Notes..."
                        Adornment="Adornment.Start" AdornmentIcon="Icons.Material.Filled.Notes"
                        InputType="InputType.Text" Lines="3" />
                    </EditTemplate>
                </PropertyColumn>
                <PropertyColumn Property="x => x.daIndebit" Title="@Localizer["Debit Printed"]" >
                    <CellTemplate>
                        <MudCheckBox @bind-Checked="context.Item.daIndebit" ReadOnly />
                    </CellTemplate>
                    <EditTemplate>
                        <MudCheckBox @bind-Checked="context.Item.daIndebit" Label="@Localizer["Debit Printed"]" />
                    </EditTemplate>
                </PropertyColumn>
                <PropertyColumn Property="x => x.daXuatHoadon" Title="@Localizer["Invoice Printed"]">
                    <CellTemplate>
                        <MudCheckBox @bind-Checked="context.Item.daXuatHoadon" ReadOnly />
                    </CellTemplate>
                    <EditTemplate>
                        <MudStack Row>
                            <MudCheckBox @bind-Checked="context.Item.daXuatHoadon" Label="@Localizer["Invoice Printed"]" />
                            <MudTextField @bind-Value="context.Item.sohoadondaura" Label="@Localizer["Invoice No."]" ReadOnly />
                        </MudStack>
                    </EditTemplate>
                </PropertyColumn>
                <PropertyColumn Property="x => x.sohoadondaura" Title="@Localizer["Invoice No."]" IsEditable="false" Required="false"><EditTemplate></EditTemplate></PropertyColumn>
                <PropertyColumn Property="x => x.khoa" Title="@Localizer["Locked"]">
                    <CellTemplate>
                        <MudCheckBox @bind-Checked="context.Item.khoa" @bind-Checked:after="@(async () => await OnLockChanged(context.Item))" Disabled="context.Item.khoa == true && !canUnlockDebit" />
                    </CellTemplate>
                    <EditTemplate>
                        <MudCheckBox @bind-Checked="context.Item.khoa" @bind-Checked:after="@(async () => await OnLockChanged(context.Item))" Label="@Localizer["Locked"]" />
                    </EditTemplate>
                </PropertyColumn>
                <PropertyColumn Property="x => x.InArrival" Title="@Localizer["Arrival Printed"]">
                    <CellTemplate>
                        <MudCheckBox @bind-Checked="context.Item.InArrival" ReadOnly />
                    </CellTemplate>
                    <EditTemplate>
                        <MudCheckBox @bind-Checked="context.Item.InArrival" Label="@Localizer["Arrival Printed"]" />
                    </EditTemplate>
                </PropertyColumn>
                <PropertyColumn Property="x => x.userupdate" Title="@Localizer["UserUpdate"]" IsEditable="false" Required="false"><EditTemplate></EditTemplate></PropertyColumn>
                <PropertyColumn Property="x => x.dateupdate" Title="@Localizer["Dateupdate"]" IsEditable="false" Required="false"><EditTemplate></EditTemplate></PropertyColumn>
                <PropertyColumn Property="x => x.continued" Title="@Localizer["Continued"]" IsEditable="false" Required="false"><EditTemplate></EditTemplate></PropertyColumn>
            </Columns>
        </MudDataGrid>
        @if(Listdata.Count > 0)
        {
