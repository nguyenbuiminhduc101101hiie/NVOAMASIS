                .ToList();
            if (isMBL)
                df.ForEach(x => x.mblid = MBLDetail!.MblID);
            else
                df.ForEach(x => x.hblid = HBLDetail!.hblID);
            var tigia = await GetTigiafromstring("VND");
            df.ForEach(x => x.tigiadebit = x.tigiahoandondaura = tigia);
            foreach (var x in df)
                await UpdateDebitNo(x, DateTime.Now);
            //Listdata.AddRange(df);
        }
        var parameters = new DialogParameters<DebitAddInCell> { { x => x.Debits, Listdata }, { x => x.Debitsdf, df }, { x=>x.currs, currs}, { x=>x.Type, type}, {x=>x.usr, usr}, {x=>x.isMBL,isMBL},
            {x=>x.MBLDetail , MBLDetail}, {x=>x.HBLDetail , HBLDetail}, {x=>x.Customers , Customers}, {x=>x.Types,Types}, {x=>x.charges,charges}, {x=>x.maincus,maincus}};
        var options = new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.ExtraExtraLarge, DisableBackdropClick = true, ClassBackground = "class-dialog-custom" };
        var dialog = DialogService.Show<DebitAddInCell>($"Quản lý Debit - Customer: {CusidtoCusCode(maincus)}", parameters, options);
        var result = await dialog.Result;
