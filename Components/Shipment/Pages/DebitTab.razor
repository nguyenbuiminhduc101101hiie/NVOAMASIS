            currs = await Vcbsv.GetCur();
            Types = await shipsv.GetListTypeInDebitCredit();
            type = await shipsv.GetTypeByMBLID(isMBL ? MBLDetail!.MblID : HBLDetail!.mblid); // Sea Air Truck HQ
            charges = await supsv.GetListChargeDuty(isDuty);
            usr = asv.GetAuth().Result.User.Identity!.Name!;
            var userDetail = asv.GetUserDetail();
            var department = userDetail?.Department?.Trim();
            canUnlockDebit = string.Equals(department, "ACCOUNT", StringComparison.OrdinalIgnoreCase)
                || string.Equals(department, "ADMIN", StringComparison.OrdinalIgnoreCase);
            if (!isMBL)
                Ports = await supsv.GetListPort();
            Conts = shipsv.GetListContainerAll();
            await Refresh();
        }
        catch (Exception ex)
        {
            CallSnackBar("Please slow down!", MudBlazor.Severity.Error);

        }
    }

    bool _loading = false;
    List<M_Debit> Listdata = new List<M_Debit>();
    List<M_Container> Conts = new();
    M_Debit detail;
    async Task Refresh()
    {
        try
        {
            _loading = true;
            // Simulate asynchronous loading to demonstrate a loading indicator
            Listdata.Clear();
            StateHasChanged();
            await Task.Delay(500);
            if (!await ssv.CheckPermission(usr, "View", "MBL"))
            {
                CallSnackBar("You have not access to view", MudBlazor.Severity.Warning);
                return;
            }
            if (isMBL)
            {
                Listdata = await shipsv.GetListDebitMBL(MBLDetail!.MblID);
                ListdataHoaDon = await shipsv.GetListHoaDonDauRaMBL(MBLDetail!.MblID);
            }
            else
            {
                Listdata = await shipsv.GetListDebitHBL(HBLDetail!.hblID, isDuty);
                ListdataHoaDon = await shipsv.GetListHoaDonDauRaHBL(HBLDetail!.hblID);
            }

            // check có còn tồn tại hóa đơn không
            if (Listdata.Any(x => !string.IsNullOrWhiteSpace(x.sohoadondaura)))
            {
                var isexistinv = await shipsv.isExistInvoice(Listdata);
                if (!isexistinv) // không tồn tại hóa đơn nữa thì update lại debit
                {
                    Listdata.ForEach(x => x.sohoadondaura = null);
                    Listdata.ForEach(x => x.daXuatHoadon = false);
                    var rs = await shipsv.UpdateDebitMBL(Listdata);
                }
            }
            if (OnDataCountChanged.HasDelegate)
                await OnDataCountChanged.InvokeAsync(Listdata?.Count ?? 0);
        }
        catch(Exception ex)
        {
            CallSnackBar("Please slow down!", MudBlazor.Severity.Error);
        }
        finally
        {
            _loading = false;
        }

    }
