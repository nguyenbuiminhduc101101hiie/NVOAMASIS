                .Select(t => new M_Debit
                    {
                        customerid = maincus,
                        editable = true,
                        tiente = t.Cur,
                        type = !string.IsNullOrWhiteSpace(t.type) ? t.type! : Types.First(),
                        soluong = 1,
                        dongia = t.Amount,
                        itemid = t.ItemId,
                        thanhtien = 0,
                        thue = 0,
                        thanhtiensauthue = 0,
                        userupdate = usr,
                        dateupdate = DateTime.Now.ToString()
