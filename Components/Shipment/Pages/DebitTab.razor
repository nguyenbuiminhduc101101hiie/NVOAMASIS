    {
        var maincus = isMBL ? MBLDetail!.CustomerID : HBLDetail!.CustomerID;
        var df = new List<M_Debit>();

        var takeTpldialog = DialogService.Show<TemplateDialog>("Lấy mẫu", new DialogParameters { ["IncludeCustomerId"] = false });
