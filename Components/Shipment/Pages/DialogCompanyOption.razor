<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.Business" Class="mr-2" />
            Chọn Company (Logo)
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.subtitle1" Class="mb-2"><b>Chọn Company</b></MudText>
        <MudRadioGroup @bind-Value="SelectedCompany" T="string">
            <MudRadio Value="@("PASL")" Color="Color.Primary">PASL (Pacific Star Logistics)</MudRadio>
            <MudRadio Value="@("VSSL")" Color="Color.Primary">VietStar (Viet Star Shipping Line)</MudRadio>
            <MudRadio Value="@("VSSA")" Color="Color.Primary">VietStar (Viet Star Shipping Agent)</MudRadio>
            <MudRadio Value="@("AMSS")" Color="Color.Primary">AMSS (Amasis Shipping)</MudRadio>
            <MudRadio Value="@("PASG")" Color="Color.Primary">PASG (Pacific Star Group)</MudRadio>
        </MudRadioGroup>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Submit" Color="Color.Primary" Variant="Variant.Filled"
                   Disabled="@string.IsNullOrEmpty(SelectedCompany)">
            <MudIcon Icon="@Icons.Material.Filled.PictureAsPdf" Class="mr-1" /> Export
        </MudButton>
        <MudButton OnClick="Cancel" Color="Color.Default">Cancel</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    public MudDialogInstance MudDialog { get; set; } = default!;

    /// <summary>Company: PASL | VietStar | AMSS | HDS</summary>
    private string SelectedCompany { get; set; } = "PASL";

    private void Submit()
    {
        MudDialog.Close(DialogResult.Ok(SelectedCompany));
    }

    private void Cancel() => MudDialog.Cancel();
}
