<MudText Class="pa-2" Typo="Typo.h6">@Localizer["More_details_for_customs_clearance"]</MudText>
<MudStack Row Justify="Justify.FlexStart" Class="pa-4">
    <MudButton  HtmlTag="label"
                OnClick="Refresh"
                Size="Size.Small" Color="Color.Primary" Variant="   Variant.Filled"
                StartIcon="@Icons.Material.Filled.Refresh">
        @Localizer["reload"]
    </MudButton>

    <MudButton HtmlTag="label"
               @onclick="@(() => AddItem())"
               Size="Size.Small" Color="Color.Secondary" Variant="Variant.Filled"
               StartIcon="@Icons.Material.Filled.Add">
        New
    </MudButton>



</MudStack>



<MudDataGrid T="M_TKHQ_Thongtinchitiet" Items="@Listdata.ToList()" Filterable="true" @ref="mudTable" Style="background-color: lightblue;"
            FilterMode="@DataGridFilterMode.ColumnFilterRow" Dense="true" Virtualize="true"
            FixedHeader="true" FixedFooter="true" HeaderClass="no-wrap" FooterClass="no-wrap"
            ReadOnly="false" CommittedItemChanges="@CommittedItem"
            ColumnResizeMode="@(_resizeColumn ? ResizeMode.Column : ResizeMode.Container)">

    <Columns>
        <HierarchyColumn T="M_TKHQ_Thongtinchitiet" />
        <TemplateColumn CellClass="d-flex justify-end">
            <CellTemplate>
                <MudIconButton Icon="@Icons.Material.Outlined.Edit" OnClick="@(() => {

                                 detail_TKHQ = JsonSerializer.Deserialize<M_TKHQ_Thongtinchitiet>(JsonSerializer.Serialize(context.Item));

                               context.Actions.StartEditingItemAsync();

                       })" />

                <MudIconButton Icon="@Icons.Material.Outlined.Delete" OnClick="@(()=>DeleteItem(context.Item))" />
            </CellTemplate>
        </TemplateColumn>

        <PropertyColumn Property="x=>x.Tenhanghoa" Title="@Localizer["Product_Name"]" Required="false" CellStyleFunc="_cellStyleFunc">
            <EditTemplate>
                <MudTextField @bind-Value="context.Item.Tenhanghoa" Label="@Localizer["Product_Name"]" Class="custom-label"
                              InputType="InputType.Text" />
            </EditTemplate>
        </PropertyColumn>

        <PropertyColumn Property="x=>x.Mahs" Title="@Localizer["Ma_HS"]" Required="false" CellStyleFunc="_cellStyleFunc">
            <EditTemplate>
                <MudTextField @bind-Value="context.Item.Mahs" Label="@Localizer["Ma_HS"]" Class="custom-label"
                              InputType="InputType.Text" />
            </EditTemplate>
        </PropertyColumn>

        <PropertyColumn Property="x=>x.Soluong" Title="@Localizer["Quantity"]" Required="false" CellStyleFunc="_cellStyleFunc">
            <EditTemplate>
                <MudNumericField @bind-Value="context.Item.Soluong"
                                 Label="@Localizer["Quantity"]" Format="#,##0.##" Culture="@_en" T="double?" HideSpinButtons="true"
                                 Class="text-right-input custom-label" />
            </EditTemplate>
        </PropertyColumn>

        <PropertyColumn Property="x=>x.Dontvitinh" Title="@Localizer["Unit"]" Required="false" CellStyleFunc="_cellStyleFunc">
            <EditTemplate>
                <MudTextField @bind-Value="context.Item.Dontvitinh" Label="@Localizer["Unit"]" Class="custom-label"
                              InputType="InputType.Text" />
            </EditTemplate>
        </PropertyColumn>

         <PropertyColumn Property="x=>x.Giatrihanghoa" Title="@Localizer["Giatrihanghoa"]" Required="false" CellStyleFunc="_cellStyleFunc">
            <EditTemplate>
                <MudNumericField @bind-Value="context.Item.Giatrihanghoa"
                                 Label="@Localizer["Giatrihanghoa"]" Format="#,##0.##" Culture="@_en" T="double?" HideSpinButtons="true"
                                 Class="text-right-input custom-label" />
            </EditTemplate>
        </PropertyColumn>

        <PropertyColumn Property="x=>x.Xuatxuhanghoa" Title="@Localizer["Xuatxuhanghoa"]" Required="false" CellStyleFunc="_cellStyleFunc">
            <EditTemplate>
                <MudTextField @bind-Value="context.Item.Xuatxuhanghoa" Label="@Localizer["Xuatxuhanghoa"]" Class="custom-label"
                              InputType="InputType.Text" />
            </EditTemplate>
        </PropertyColumn>

    </Columns>

</MudDataGrid>

