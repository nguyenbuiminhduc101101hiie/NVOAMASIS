    protected async override Task OnInitializedAsync()
    {
        usr = asv.GetAuth().Result.User.Identity!.Name!;
        await Refresh();
    }



    bool _loading = false;
    async Task Refresh()
    {
        try
        {
            detail = null!;
            _loading = true;
            Listdata.Clear();

            await Task.Delay(500);
            if (!await ssv.CheckPermission(usr, "Add", "TKHQ"))
            {
                CallSnackBar("You have not access to view", MudBlazor.Severity.Warning);
                return;
            }
            Listdata = await tkhqsv.GetListTKHQ_Detail_BYID_TKHQ(_TKHQ_ThongTinChung_details.Id);
            StateHasChanged();
        }
        catch(Exception ex)
        {
            CallSnackBar("Something went wrong!, error code: " + ex.Message, MudBlazor.Severity.Warning);
        }
        finally
        {
            _loading = false;
        }

    }

    void CallSnackBar(string message, MudBlazor.Severity severity)
    {
        
        Snackbar.Configuration.SnackbarVariant = Variant.Filled;
        Snackbar.Configuration.MaxDisplayedSnackbars = 3;
        Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopRight;
        Snackbar.Add(message, severity);
    }
    void RowClicked(DataGridRowClickEventArgs<M_TKHQ_Thongtinchitiet> args)
    {
        detail = args.Item;
    }
    private int selectedRowNumber = -1;
    private string SelectedRowClassFunc(M_TKHQ_Thongtinchitiet m, int rowNumber)
    {
        if (selectedRowNumber == rowNumber)
        {
            selectedRowNumber = -1;
            return string.Empty;
        }
        else if (mudTable.SelectedItem != null && mudTable.SelectedItem.Equals(m))
        {
            selectedRowNumber = rowNumber;
            return "selected";
        }
        else
        {
            return string.Empty;
        }
    }

    async Task CommittedItem(M_TKHQ_Thongtinchitiet item)
    {
        item.Id_Tkhq = _TKHQ_ThongTinChung_details.Id;
        item.userupdate = asv.GetAuth().Result.User.Identity!.Name!;
        item.dateupdate = DateTime.Now;
        var rs = item.Id != Guid.Empty ? await tkhqsv.UpdateTKHQChitiet_Detail(item,detail_TKHQ) : await tkhqsv.CreateTKHQChitiet_Detail(item);
        CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);

        await Refresh();
    }
    int? index_no;
    async Task AddItem()
    {

        if (!await ssv.CheckPermission(usr, "Add", "TKHQ"))
        {
            CallSnackBar("You have not access to Add", MudBlazor.Severity.Warning);
            return;
        }
        var item = new M_TKHQ_Thongtinchitiet
        {

        };

        item.userupdate = asv.GetAuth().Result.User.Identity!.Name!;
        item.dateupdate = DateTime.Now;
        Listdata.Add(item);
        await mudTable.SetEditingItemAsync(Listdata.LastOrDefault()!);
    }
    private async Task<IEnumerable<string>> Searchpol(string text)
    {
        try
        {
            if (string.IsNullOrWhiteSpace(text))
            {
                return List_pol.Where(x => !string.IsNullOrEmpty(x.PORT))
               .Select(x => x.PORT);
            }
            // MBL.Porname = mst_Consignee;
            return List_pol.Where(x => !string.IsNullOrEmpty(x.PORT) &&
                            x.PORT.Contains(text, StringComparison.OrdinalIgnoreCase))
               .Select(x => x.PORT);
        }
        catch (Exception)
        {
            throw;
        }
    }
    private async Task<IEnumerable<string>> Searchpod(string text)
    {
        try
        {
            if (string.IsNullOrWhiteSpace(text))
            {
                return List_pod.Where(x => !string.IsNullOrEmpty(x.PORT))
               .Select(x => x.PORT);
            }

            return List_pod.Where(x => !string.IsNullOrEmpty(x.PORT) &&
                            x.PORT.Contains(text, StringComparison.OrdinalIgnoreCase))
               .Select(x => x.PORT);
        }
        catch (Exception)
        {
            throw;
        }
    }

    async Task DeleteItem(M_TKHQ_Thongtinchitiet item)
    {
        if (!await ssv.CheckPermission(usr, "Delete", "TKHQ"))
        {
            CallSnackBar("You have not access to Delete", MudBlazor.Severity.Warning);
            return;
        }
        var resultMess = await DialogService.ShowMessageBox(
                "Warning",
                "Deleting can not be undone!",
                yesText: "Delete!", cancelText: "Cancel");

        if (resultMess.HasValue)
        {
            var rs = await tkhqsv.DeleteTKHQChiTiet_Detail(item);
            CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
            await Refresh();
        }

    }
