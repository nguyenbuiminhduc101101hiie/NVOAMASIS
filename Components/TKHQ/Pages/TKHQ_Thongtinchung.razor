        }
        if (tr.Approve == true)
        {
            CallSnackBar("Data đã được Approve!!! , vui lòng bỏ Approve", MudBlazor.Severity.Warning);
            return;
        }
        if (await ssv.CheckPermission(asv.GetAuth().Result.User.Identity.Name, "Add", "TKHQ"))
        {

            DialogOptions closeOnEscapeKey = new DialogOptions() { CloseOnEscapeKey = true };
            var parameters = new DialogParameters<ADD_Details> { { x => x._TKHQ_ThongTinChung_details, tr } };

            var dialog = await DialogService.ShowAsync<ADD_Details>(tr.Id == Guid.Empty ? "ADD Details" : "ADD Details", parameters, optionsdialog);
            var result = await dialog.Result;
            // Giữ nguyên dòng được chọn
            selectedRowNumber = selectedRowNumber;
            StateHasChanged();
  
            if (!result.Canceled)
            {
                var data = (M_TKHQ_Thongtinchitiet)result.Data;
                var rs = await tkhqsv.UpdateCreateTKHQ_Detail(data);
                MudBlazor.Severity severity;
