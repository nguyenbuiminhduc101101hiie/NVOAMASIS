    private async Task OpenEditDialog_Detail(Models.M_TKHQ_Thongtinchunglohang tr)
    {
        var optionsdialog = new DialogOptions { ClassBackground = "class-dialog-custom", FullWidth = true, MaxWidth = MaxWidth.ExtraExtraLarge };
        if (tr == null)
        {
            CallSnackBar("Please select Data", MudBlazor.Severity.Warning);
