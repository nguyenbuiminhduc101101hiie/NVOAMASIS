<PageTitle>@Localizer["Request_to_do_customs_clearance"] </PageTitle>
<MudText Class="pa-2" Typo="Typo.h6">@Localizer["Request_to_do_customs_clearance"]</MudText>
<MudStack Row Justify="Justify.FlexStart" Class="pa-4">
    <MudButton  HtmlTag="label"
                OnClick="Refresh"
                Size="Size.Small" Color="Color.Primary" Variant="   Variant.Filled"
                StartIcon="@Icons.Material.Filled.Refresh">
        @Localizer["reload"]
    </MudButton>
    <MudButton  HtmlTag="label"
                 @onclick="@((e) => OpenCreateDialog(new Models.M_TKHQ_Thongtinchunglohang()))"
                Size="Size.Small" Color="Color.Secondary" Variant="Variant.Filled"
                StartIcon="@Icons.Material.Filled.Add">
        @Localizer["new"]
    </MudButton>

    <MudButton HtmlTag="label"
               @onclick="@((e) => OpenEditDialog(detail))"
               Size="Size.Small" Color="Color.Info" Variant="Variant.Filled"
               StartIcon="@Icons.Material.Filled.Edit">
        @Localizer["edit"]
    </MudButton>

        <MudButton HtmlTag="label"
               @onclick="@((e) => OpenDuplicateDialog(detail))"
               Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled"
               StartIcon="@Icons.Material.Filled.CopyAll">
        @Localizer["duplicate"]
    </MudButton>

     <MudButton HtmlTag="label"
               @onclick="@(() => OpenEditDialog_Detail(detail))"
               Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled"
               StartIcon="@Icons.Material.Filled.CopyAll">
        @Localizer["ADD Detail"]
    </MudButton>

</MudStack>

<MudDataGrid    T="M_TKHQ_Thongtinchunglohang" Items="@Listdata" Filterable="true" @ref="mudTable" Class="pa-4"  Bordered ="true"
                FilterMode="@DataGridFilterMode.ColumnFilterRow" Dense="true" Virtualize="true" QuickFilter="@FilterFunc1"
                FixedHeader="true" FixedFooter="true" HeaderClass="no-wrap" FooterClass="no-wrap"
                ReadOnly="false" CommittedItemChanges="@CommittedItem" RowClassFunc="@SelectedRowClassFunc"
                RowClick="@RowClicked" EditDialogOptions="@options"
             ColumnResizeMode="@(_resizeColumn ? ResizeMode.Column : ResizeMode.Container)" Loading="_loading">
    <Columns>
        <HierarchyColumn T="M_TKHQ_Thongtinchunglohang" />
        <TemplateColumn CellClass="d-flex justify-end">
            <CellTemplate>
     
                <MudIconButton Icon="@Icons.Material.Outlined.Delete" OnClick="@(()=>DeleteItem(context.Item))" />
            </CellTemplate>
        </TemplateColumn>
        <PropertyColumn Property="x=>x.Sotokhai" Title="@Localizer["sotokhai"]" Required="false" CellStyleFunc="_cellStyleFunc" CellClass="custom-right-align">
            <EditTemplate>
                <MudTextField @bind-Value="context.Item.Sotokhai" class="custom-label" Required="false" />
            </EditTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x=>x.Mst_Xk" Title="@Localizer["Export_Tax_Code"]" Required="false" CellStyleFunc="_cellStyleFunc" CellClass="custom-right-align">
            <EditTemplate>
                <MudTextField @bind-Value="context.Item.Mst_Xk"  class="custom-label" Required="false" />
            </EditTemplate>
        </PropertyColumn>

        <PropertyColumn Property="x=>x.Company_Xk" Title="@Localizer["Company_Export"]" Required="false" CellStyleFunc="_cellStyleFunc" CellClass="custom-right-align">
            <EditTemplate>
                <MudTextField @bind-Value="context.Item.Company_Xk"  class="custom-label" Required="false" />
            </EditTemplate>
        </PropertyColumn>

        <PropertyColumn Property="x=>x.Address_Xk" Title="@Localizer["Address_Export"]" Required="false" CellStyleFunc="_cellStyleFunc" CellClass="custom-right-align">
            <EditTemplate>
                <MudTextField @bind-Value="context.Item.Address_Xk" class="custom-label" Required="false" />
            </EditTemplate>
        </PropertyColumn>

        <PropertyColumn Property="x=>x.Mst_Nk" Title="@Localizer["Import_Tax_Code"]" Required="false" CellStyleFunc="_cellStyleFunc" CellClass="custom-right-align">
            <EditTemplate>
                <MudTextField @bind-Value="context.Item.Mst_Nk"  class="custom-label" Required="false" />
            </EditTemplate>
        </PropertyColumn>

        <PropertyColumn Property="x=>x.Company_Nk" Title="@Localizer["Company_Import"]" Required="false" CellStyleFunc="_cellStyleFunc" CellClass="custom-right-align">
            <EditTemplate>
                <MudTextField @bind-Value="context.Item.Company_Nk" class="custom-label" Required="false" />
            </EditTemplate>
        </PropertyColumn>

        <PropertyColumn Property="x=>x.Address_Nk" Title="@Localizer["Address_Import"]" Required="false" CellStyleFunc="_cellStyleFunc" CellClass="custom-right-align">
            <EditTemplate>
                <MudTextField @bind-Value="context.Item.Address_Nk" class="custom-label" Required="false" />
            </EditTemplate>
        </PropertyColumn>

    

        <PropertyColumn Property="x => x.Ngaykhaibao" Title="@Localizer["Date_of_Declaration"]" Required="false" Format="dd/MM/yyyy">
            <EditTemplate>
                <MudDatePicker Class="pl-4 custom-label" @bind-Date="context.Item.Ngaykhaibao"
                               Label="Ngày Khai Báo:"
                               Required="true" />
            </EditTemplate>
        </PropertyColumn>

        <PropertyColumn Property="x=>x.Noikhaibao" Title="@Localizer["Place_of_Declaration"]" Required="false" CellStyleFunc="_cellStyleFunc" CellClass="custom-right-align">
            <EditTemplate>
                <MudTextField @bind-Value="context.Item.Noikhaibao" class="custom-label" Required="false" />
            </EditTemplate>
        </PropertyColumn>

        <PropertyColumn Property="x=>x.Phuongthucvanchuyen" Title="@Localizer["Shipping_Method"]" Required="false" CellStyleFunc="_cellStyleFunc" CellClass="custom-right-align">
            <EditTemplate>
                <MudTextField @bind-Value="context.Item.Phuongthucvanchuyen" class="custom-label" Required="false" />
            </EditTemplate>
        </PropertyColumn>

        <PropertyColumn Property="x=>x.Phuongtienvanchuyen" Title="@Localizer["Means_of_Transport"]" Required="false" CellStyleFunc="_cellStyleFunc" CellClass="custom-right-align">
            <EditTemplate>
                <MudTextField @bind-Value="context.Item.Phuongtienvanchuyen" class="custom-label" Required="false" />
            </EditTemplate>
        </PropertyColumn>

          <PropertyColumn Property="x => x.Noixephang" Title="@Localizer["noixephang"]" Required="false" CellStyleFunc="_cellStyleFunc">
            <EditTemplate>
                <MudAutocomplete @bind-Value="context.Item.Noixephang" Label="Nơi Xếp Hàng" class="custom-label" Required
                                 SearchFunc="Searchpol" />
            </EditTemplate>
        </PropertyColumn>

        <PropertyColumn Property="x => x.Noidohang" Title="@Localizer["noidohang"]" Required="false" CellStyleFunc="_cellStyleFunc">
            <EditTemplate>
                <MudAutocomplete @bind-Value="context.Item.Noidohang" Label="Nơi Dỡ Hàng" class="custom-label" Required
                                 SearchFunc="Searchpod" />
            </EditTemplate>
        </PropertyColumn>

        <PropertyColumn Property="x=>x.Sohoadon" Title="@Localizer["sohoadon"]" Required="false" CellStyleFunc="_cellStyleFunc" CellClass="custom-right-align">
            <EditTemplate>
                <MudTextField @bind-Value="context.Item.Sohoadon" class="custom-label" Required="false" />
            </EditTemplate>
        </PropertyColumn>

        <PropertyColumn Property="x => x.Ngaylaphoadon" Title="@Localizer["ngaylaphoadon"]" Required="false" Format="dd/MM/yyyy">
            <EditTemplate>
                <MudDatePicker Class="pl-4 custom-label" @bind-Date="context.Item.Ngaylaphoadon"
                               Label="Ngày Lập Hoá Đơn:"
                               Required="true" />
            </EditTemplate>
        </PropertyColumn>

        <PropertyColumn Property="x => x.Sotien" Title="@Localizer["dongtienthanhtoan"]" Format="N2" Required="false" CellClass="custom-right-align">

            <EditTemplate>
                <MudNumericField @bind-Value="context.Item.Sotien"
                                 Label="Đồng Tiền Thanh Toán" Format="#,##0.##" Culture="@_en" T="double?"
                                 Class="text-right-input  custom-label" HideSpinButtons="true" />
            </EditTemplate>
        </PropertyColumn>

        <PropertyColumn Property="x => x.Dieukiengiaohang" Title="@Localizer["dieukiengiaohang"]" Required="false">
            <EditTemplate>
                <MudTextField @bind-Value="context.Item.Dieukiengiaohang" Label="Điều Kiện Giao Hàng" Placeholder="Điều Kiện Giao Hàng..." Class="custom-label"
                Adornment="Adornment.Start" AdornmentIcon="Icons.Material.Filled.Notes"
                InputType="InputType.Text" Lines="3" />
            </EditTemplate>
        </PropertyColumn>

         <PropertyColumn Property="x => x.Orther" Title="@Localizer["cacthongtinkhac"]" Required="false">
            <EditTemplate>
                <MudTextField @bind-Value="context.Item.Orther" Label="Các Thông Tin Khác" Placeholder="Các Thông Tin Khác..." Class="custom-label"
                Adornment="Adornment.Start" AdornmentIcon="Icons.Material.Filled.Notes"
                InputType="InputType.Text" Lines="3" />
            </EditTemplate>
        </PropertyColumn>

        <TemplateColumn Title="@Localizer["Approve"]">
            <CellTemplate>
                <MudCheckBox @bind-Checked="context.Item.Approve" @bind-Value="context.Item.Approve" @bind-Value:after="@(()=> OnApproveCheckboxWrapper(context.Item))">
                </MudCheckBox>
            </CellTemplate>
        </TemplateColumn>

     
    </Columns>

     <ChildRowContent>
        <MudTabs>
            <MudTabPanel Text="Detail">
                <ADD_Details _TKHQ_ThongTinChung_details="context.Item" />
            </MudTabPanel>
        </MudTabs>
    </ChildRowContent>


     <PagerContent>
        <MudDataGridPager T="Models.M_TKHQ_Thongtinchunglohang" PageSizeOptions="@(new int[] { 8, 10, 20 })" />
    </PagerContent>
</MudDataGrid>

@code {
    List<M_TKHQ_Thongtinchunglohang> Listdata = new List<M_TKHQ_Thongtinchunglohang>();
    MudDataGrid<M_TKHQ_Thongtinchunglohang> mudTable;
    AuthUser user;
    string mailtp, mailpp;
    string usr;
    private List<string> ListUser { get; set; } = new List<string>();
    string UserHanding;
    List<string> trangthais = new List<string>();
    private List<Models.TrangThai> M_Trangthais = new List<Models.TrangThai>();
    private string searchText_pol = "";
    private string searchText_pod = "";
    private List<PortModel> filteredPorts = new List<PortModel>();
    private List<PortModel> filteredPorts_pod = new List<PortModel>();
    private List<PortModel> Ports = new List<PortModel>();
    private bool _resizeColumn;
    M_TKHQ_Thongtinchunglohang detail;
    private List<PortModel> List_pod = new List<PortModel>();
    private List<PortModel> List_pol = new List<PortModel>();
    private List<M_Customer> filteredCarr = new List<M_Customer>();

    private List<M_Customer> Cuss_Carr = new List<M_Customer>();
    public CultureInfo _de = CultureInfo.GetCultureInfo("de-DE");
    public CultureInfo _en = CultureInfo.GetCultureInfo("en-US");

    protected async override Task OnInitializedAsync()
    {
        List_pol = await ldxsv.GetList_port();
        List_pod = await ldxsv.GetList_port();
        ListUser = await asv.GetList_User_handle() ?? new List<string>();
        usr = asv.GetAuth().Result.User.Identity!.Name!;
        Cuss_Carr = await lcsv.GetList_Customer_line();
        // await Refresh();
    }

  

    bool _loading = false;
    async Task Refresh()
    {
        try
        {
            detail = null!;
            _loading = true;
            Listdata.Clear();
            
            await Task.Delay(500);
            if (!await ssv.CheckPermission(usr, "View", "TKHQ"))
            {
                CallSnackBar("You have not access to view", MudBlazor.Severity.Warning);
                return;
            }
            Listdata = await tkhqsv.GetListTKHQ();
            StateHasChanged();
        }
        catch(Exception ex)
        {
            CallSnackBar("Something went wrong!, error code: " + ex.Message, MudBlazor.Severity.Warning);
        }
        finally
        {
            _loading = false;
        }

    }

    void CallSnackBar(string message, MudBlazor.Severity severity)
    {
        
        Snackbar.Configuration.SnackbarVariant = Variant.Filled;
        Snackbar.Configuration.MaxDisplayedSnackbars = 3;
        Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopRight;
        Snackbar.Add(message, severity);
    }
    void RowClicked(DataGridRowClickEventArgs<M_TKHQ_Thongtinchunglohang> args)
    {
        detail = args.Item;
    }
    private int selectedRowNumber = -1;
    private string SelectedRowClassFunc(M_TKHQ_Thongtinchunglohang m, int rowNumber)
    {
        if (selectedRowNumber == rowNumber)
        {
            selectedRowNumber = -1;
            return string.Empty;
        }
        else if (mudTable.SelectedItem != null && mudTable.SelectedItem.Equals(m))
        {
            selectedRowNumber = rowNumber;
            return "selected";
        }
        else
        {
            return string.Empty;
        }
    }

    async Task CommittedItem(M_TKHQ_Thongtinchunglohang item)
    {
        item.userupdate = asv.GetAuth().Result.User.Identity!.Name!;
        item.dateupdate = DateTime.Now;
        var rs = item.Id != Guid.Empty ? await tkhqsv.UpdateTKHQ_Detail(item) : await tkhqsv.CreateTKHQ_Detail(item);
        CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);

        await Refresh();
    }
    int? index_no;
    async Task AddItem()
    {

        if (!await ssv.CheckPermission(usr, "Add", "TKHQ"))
        {
            CallSnackBar("You have not access to Add", MudBlazor.Severity.Warning);
            return;
        }
        var item = new M_TKHQ_Thongtinchunglohang
        {

        };

        item.userupdate = asv.GetAuth().Result.User.Identity!.Name!;
        item.dateupdate = DateTime.Now;
        Listdata.Add(item);
        await mudTable.SetEditingItemAsync(Listdata.LastOrDefault()!);
    }
    private async Task<IEnumerable<string>> Searchpol(string text)
    {
        try
        {
            if (string.IsNullOrWhiteSpace(text))
            {
                return List_pol.Where(x => !string.IsNullOrEmpty(x.PORT))
               .Select(x => x.PORT);
            }
            // MBL.Porname = mst_Consignee;
            return List_pol.Where(x => !string.IsNullOrEmpty(x.PORT) &&
                            x.PORT.Contains(text, StringComparison.OrdinalIgnoreCase))
               .Select(x => x.PORT);
        }
        catch (Exception)
        {
            throw;
        }
    }
    private async Task<IEnumerable<string>> Searchpod(string text)
    {
        try
        {
            if (string.IsNullOrWhiteSpace(text))
            {
                return List_pod.Where(x => !string.IsNullOrEmpty(x.PORT))
               .Select(x => x.PORT);
            }

            return List_pod.Where(x => !string.IsNullOrEmpty(x.PORT) &&
                            x.PORT.Contains(text, StringComparison.OrdinalIgnoreCase))
               .Select(x => x.PORT);
        }
        catch (Exception)
        {
            throw;
        }
    }

    async Task DeleteItem(M_TKHQ_Thongtinchunglohang item)
    {
        if (item.Approve == true)
        {
            CallSnackBar("Data đã được Approve!!! , vui lòng bỏ Approve", MudBlazor.Severity.Warning);
            return;
        }
        if (!await ssv.CheckPermission(usr, "Delete", "TKHQ"))
        {
            CallSnackBar("You have not access to Delete", MudBlazor.Severity.Warning);
            return;
        }
        var resultMess = await DialogService.ShowMessageBox(
                "Warning",
                "Deleting can not be undone!",
                yesText: "Delete!", cancelText: "Cancel");

        if (resultMess.HasValue)
        {
            var rs = await tkhqsv.DeleteTKHQ_Detail(item);
            await HistoryLogService.LogAsync(usr, "Delete TKHQ", "TKHQ", item.Id, item.Sotokhai, new { OldData = item });
            CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
            await Refresh();
        }

    }
    DialogOptions options = new DialogOptions 
    {
        ClassBackground = "class-dialog-custom",
        FullWidth = true,
        MaxWidth = MaxWidth.Medium,
        CloseOnEscapeKey = false,
        DisableBackdropClick = true
    };
    string search;

    private bool FilterFunc1(M_TKHQ_Thongtinchunglohang sbd) => FilterFunc(sbd, search);

    private bool FilterFunc(M_TKHQ_Thongtinchunglohang sbd, string searchString)
    {
        if (string.IsNullOrWhiteSpace(sbd.Sotokhai))
            return true;
        if (string.IsNullOrWhiteSpace(searchString))
            return true;
        if (sbd.Sotokhai!.Contains(searchString, StringComparison.OrdinalIgnoreCase))
            return true;
        if ($"{sbd.Sotokhai} ".Contains(searchString))
            return true;
        return false;
    }

    private Func<M_TKHQ_Thongtinchunglohang, string> _cellStyleFunc => x =>
      {


          return "color: #000000";
      };

      private async Task OpenCreateDialog(Models.M_TKHQ_Thongtinchunglohang tr)
    {
        var optionsdialog = new DialogOptions { ClassBackground = "class-dialog-custom", FullWidth = true, MaxWidth = MaxWidth.Medium };

        if (await ssv.CheckPermission(asv.GetAuth().Result.User.Identity.Name, "Add", "TKHQ"))
        {

            DialogOptions closeOnEscapeKey = new DialogOptions() { CloseOnEscapeKey = true };
            var parameters = new DialogParameters<ADD> { { x => x._THKQ_Thongtinchung_Detail, tr }, { x => x.Status, "add" } };

            var dialog = await DialogService.ShowAsync<ADD>(tr.Id == Guid.Empty ? "TKHQ Create" : "TKHQ Edit", parameters, optionsdialog);
            var result = await dialog.Result;
            if (!result.Canceled)
            {
                var data = (M_TKHQ_Thongtinchunglohang)result.Data;
                var rs = await tkhqsv.UpdateCreateTKHQ(data);

                await HistoryLogService.LogAsync(usr, "ADD TKHQ", "TKHQ", data.Id, data.Sotokhai, data);
                MudBlazor.Severity severity;
                if (rs[1] == "1")
                    severity = MudBlazor.Severity.Success;
                else
                    severity = MudBlazor.Severity.Error;

                CallSnackBar(rs[0], severity);
        
                await HandleRefresh_create(data.Id);

            }

            return;

        }
        else
        {
            CallSnackBar("You have not access to Create", MudBlazor.Severity.Warning);
            return;
        }

    }

    async Task HandleRefresh_create(Guid? id)
    {
        try
        {

            detail = null;

            Listdata.Clear();
    
            await Task.Delay(500);

            if (!await ssv.CheckPermission(asv.GetAuth().Result.User.Identity.Name, "View", "TKHQ"))
            {
                CallSnackBar("You have not access to view", MudBlazor.Severity.Warning);

                return;
            }
            Listdata = await tkhqsv.GetListTKHQ_create(id);
            StateHasChanged();
        }
        finally
        {


        }
    }

    private async Task OpenEditDialog(Models.M_TKHQ_Thongtinchunglohang tr)
    {
        var optionsdialog = new DialogOptions { ClassBackground = "class-dialog-custom", FullWidth = true, MaxWidth = MaxWidth.Medium };
        if (tr == null)
        {
            CallSnackBar("Please select Data", MudBlazor.Severity.Warning);
            return;
        }
        if (tr.Approve == true)
        {
            CallSnackBar("Data đã được Approve!!! , vui lòng bỏ Approve", MudBlazor.Severity.Warning);
            return;
        }
        if (await ssv.CheckPermission(asv.GetAuth().Result.User.Identity.Name, "Edit", "TKHQ"))
        {
            var OldData = JsonSerializer.Deserialize<M_TKHQ_Thongtinchunglohang>(JsonSerializer.Serialize(tr));
            DialogOptions closeOnEscapeKey = new DialogOptions() { CloseOnEscapeKey = true };
            var parameters = new DialogParameters<ADD> { { x => x._THKQ_Thongtinchung_Detail, tr }, { x => x.Status, "edit" } };

            var dialog = await DialogService.ShowAsync<ADD>(tr.Id == Guid.Empty ? "TKHQ Edit" : "TKHQ Edit", parameters, optionsdialog);
            var result = await dialog.Result;
            // Giữ nguyên dòng được chọn
            selectedRowNumber = selectedRowNumber;
            StateHasChanged();

            if (!result.Canceled)
            {
                var data = (M_TKHQ_Thongtinchunglohang)result.Data;
                var rs = await  tkhqsv.UpdateCreateTKHQ(data);
                await HistoryLogService.LogAsync(usr, "Update TKHQ", "TKHQ", data.Id, data.Sotokhai, new { OldData = OldData, NewData = data });
                MudBlazor.Severity severity;
                if (rs[1] == "1")
                    severity = MudBlazor.Severity.Success;
                else
                    severity = MudBlazor.Severity.Error;

                CallSnackBar(rs[0], severity);
            }

            return;

        }
        else
        {
            CallSnackBar("You have not access to Edit", MudBlazor.Severity.Warning);
            return;
        }

    }

