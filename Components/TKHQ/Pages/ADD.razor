                                        </MudItem>

                                        <MudItem xs="12">
                                                <MudStack Row>
                                                    <MudContainer Class="pa-4; max-height:200px; overflow-y: auto; custom-label;">
                                                        <MudText class="custom-label" Typo="Typo.h6">Hình ảnh mô tả</MudText>
                                                        @foreach (var item in Linksplit(_THKQ_Thongtinchung_Detail.Links!))
                                                        {
                                                            <MudPaper Elevation="3" Style="position: relative; display: inline-block;">
                                                                <MudImage Src="@item.Replace("ftp","http")" Alt="@item.Replace("ftp","http")"
                                                                            Height="150" Elevation="25" Class="rounded-lg ma-4" />

                                                                <MudIconButton Icon="@Icons.Material.Filled.Visibility" OnClick="@(() => SeeDetail(item))"
                                                                                Style="position: absolute; top: 5px; left: 5px; padding: 0; min-width: 0;" />

                                                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error"
                                                                        OnClick="@(() => Deleteimg(_THKQ_Thongtinchung_Detail,item))"
                                                                                Style="position: absolute; top: 5px; right: 5px; padding: 0; min-width: 0;" />
                                                            </MudPaper>
                                                        }
                                                    </MudContainer>

                                            <MudFileUpload T="IBrowserFile" Accept=".png,.jpg,.jpeg" FilesChanged="@((t) => AttachFileToFTP(t,_THKQ_Thongtinchung_Detail))">
                                                        <ButtonTemplate Context="context1">
                                                            <MudIconButton HtmlTag="label" for="@context1" Size="Size.Small" Color="Color.Secondary"
                                                                            Icon="@Icons.Material.Filled.AttachFile" />
                                                        </ButtonTemplate>
                                                    </MudFileUpload>

                                                </MudStack>
                                        </MudItem>

                                    </MudGrid>
                                   
                                </MudCardContent>
                            </MudCard>
                        </MudGrid>
                        

                    </MudCardContent>
                </MudForm>

            </MudCard>
        </MudContainer>
    </DialogContent>
    <DialogActions>

        <MudButton OnClick="@(async () => await Submit())">Save</MudButton>
        <MudButton OnClick="Cancel">Cancel</MudButton>

    </DialogActions>
</MudDialog>



@code {
    [CascadingParameter] MudDialogInstance? MudDialog { get; set; }
    [Parameter] public Models.M_TKHQ_Thongtinchunglohang _THKQ_Thongtinchung_Detail { get; set; }

    [Parameter] public string Status { get; set; }
    MudForm form;
    private List<PortModel> List_pod = new List<PortModel>();
    private List<PortModel> List_pol = new List<PortModel>();
    private string NumCrew { get; set; }
    private List<M_Customer> filteredCarr = new List<M_Customer>();
    private List<M_Customer> Cuss_Carr = new List<M_Customer>();
    public CultureInfo _de = CultureInfo.GetCultureInfo("de-DE");
    public CultureInfo _en = CultureInfo.GetCultureInfo("en-US");
    private List<M_Customer> List_Company_XK = new List<M_Customer>();
    private List<M_Customer> List_Company_ADD = new List<M_Customer>();
    private List<M_Customer> List_Company_NK = new List<M_Customer>();
    string UserHanding;
    private List<string> ListUser { get; set; } = new List<string>();
    protected async override Task OnInitializedAsync()
    {
        if (Status == "add")
        {
            _THKQ_Thongtinchung_Detail.nguoiyeucau = asv.GetAuth().Result.User.Identity!.Name!;
        }

        if (Status == "Duplicate")
        {
            _THKQ_Thongtinchung_Detail.nguoiyeucau = asv.GetAuth().Result.User.Identity!.Name!;
            _THKQ_Thongtinchung_Detail.Id = Guid.Empty;
            _THKQ_Thongtinchung_Detail.Approve = false;
            _THKQ_Thongtinchung_Detail.Sotokhai = "";
        }
        await Get_Sotokhai();
        ListUser = await asv.GetList_User_handle() ?? new List<string>();
        List_pol = await ldxsv.GetList_port();
        List_pod = await ldxsv.GetList_port();
        List_Company_NK = await tkhqsv.GetList_Cusl();
        List_Company_XK = await tkhqsv.GetList_Cusl();
        List_Company_ADD = await tkhqsv.GetList_Cusl();
    }
    private async Task<IEnumerable<string>> Searchpol(string text)
    {
        try
        {
            if (string.IsNullOrWhiteSpace(text))
            {
                return List_pol.Where(x => !string.IsNullOrEmpty(x.PORT))
               .Select(x => x.PORT);
            }
            // MBL.Porname = mst_Consignee;
            return List_pol.Where(x => !string.IsNullOrEmpty(x.PORT) &&
                            x.PORT.Contains(text, StringComparison.OrdinalIgnoreCase))
               .Select(x => x.PORT);
        }
        catch (Exception)
        {
            throw;
        }
    }
    private async Task<IEnumerable<string>> Searchpod(string text)
    {
        try
        {
            if (string.IsNullOrWhiteSpace(text))
            {
                return List_pod.Where(x => !string.IsNullOrEmpty(x.PORT))
               .Select(x => x.PORT);
            }

            return List_pod.Where(x => !string.IsNullOrEmpty(x.PORT) &&
                            x.PORT.Contains(text, StringComparison.OrdinalIgnoreCase))
               .Select(x => x.PORT);
        }
        catch (Exception)
        {
            throw;
        }
    }
    private async Task Get_Sotokhai()
    {

        int formattedYear = DateTime.Now.Year;
        int formattedMonth = DateTime.Now.Month;

        string usr = asv.GetAuth().Result.User.Identity!.Name!;
        var refno = await supsv.GetRefNoByFunc("TKHQ", formattedMonth, formattedYear, usr);

        var rs = asv.GetUserDetail();
        var cn = rs.Branch;
        _THKQ_Thongtinchung_Detail.Sotokhai = cn + "TKHQ_" + formattedYear.ToString() + formattedMonth.ToString() + refno.Value.ToString("D4");
    }

    private async Task Submit()
    {
        if ((await ssv.CheckPermission(asv.GetAuth().Result.User.Identity.Name, "Edit", "TKHQ") || await ssv.CheckPermission(asv.GetAuth().Result.User.Identity.Name, "New", "TKHQ")))
        {

            await form.Validate();

            if (form.IsValid)
            {
 
                var UserName = asv.GetAuth().Result.User.Identity!.Name!;
                _THKQ_Thongtinchung_Detail.dateupdate = DateTime.Now;
                _THKQ_Thongtinchung_Detail.userupdate = UserName;
                MudDialog!.Close(_THKQ_Thongtinchung_Detail);

            }
        }

    }
    void Cancel() => MudDialog.Cancel();

    void CallSnackBar(string message, MudBlazor.Severity severity)
    {
        
        Snackbar.Configuration.SnackbarVariant = Variant.Filled;
        Snackbar.Configuration.MaxDisplayedSnackbars = 3;
        Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopRight;
        Snackbar.Add(message, severity);
    }
    private async Task<IEnumerable<string>> SearchCompanyXK(string text)
    {
        try
        {
            if (string.IsNullOrWhiteSpace(text))
            {
                return List_Company_XK.Where(x => !string.IsNullOrEmpty(x.COMPANY))
               .Select(x => x.COMPANY);
            }
            // MBL.Porname = mst_Consignee;
            return List_Company_XK.Where(x => !string.IsNullOrEmpty(x.COMPANY) &&
                            x.COMPANY.Contains(text, StringComparison.OrdinalIgnoreCase))
               .Select(x => x.COMPANY);
        }
        catch (Exception)
        {
            throw;
        }
    }
    private async Task<IEnumerable<string>> SearchCompanyNK(string text)
    {
        try
        {
            if (string.IsNullOrWhiteSpace(text))
            {
                return List_Company_NK.Where(x => !string.IsNullOrEmpty(x.COMPANY))
               .Select(x => x.COMPANY);
            }
            // MBL.Porname = mst_Consignee;
            return List_Company_NK.Where(x => !string.IsNullOrEmpty(x.COMPANY) &&
                            x.COMPANY.Contains(text, StringComparison.OrdinalIgnoreCase))
               .Select(x => x.COMPANY);
        }
        catch (Exception)
        {
            throw;
        }
    }


    private void OnCompanyXKBlur(FocusEventArgs e)
    {
        var company = List_Company_ADD.FirstOrDefault(x => x.COMPANY == _THKQ_Thongtinchung_Detail.Company_Xk);
        if (company != null)
        {
            _THKQ_Thongtinchung_Detail.Address_Xk = company.Address;
        }
    }
    private void OnCompanyNKBlur(FocusEventArgs e)
    {
        var company = List_Company_ADD.FirstOrDefault(x => x.COMPANY == _THKQ_Thongtinchung_Detail.Company_Nk);
        if (company != null)
        {
            _THKQ_Thongtinchung_Detail.Address_Nk = company.Address;
        }
    }

    private async Task<IEnumerable<string>> Search_User(string value)
    {
        if (string.IsNullOrEmpty(value))
            return ListUser;

        return ListUser.Where(x => x.Contains(value, StringComparison.InvariantCultureIgnoreCase));
    }
    private async Task Getuser()
    {
        if (string.IsNullOrEmpty(_THKQ_Thongtinchung_Detail.nguoitraloi))
        {
            _THKQ_Thongtinchung_Detail.nguoitraloi = UserHanding;
        }
        else
        {
            _THKQ_Thongtinchung_Detail.nguoitraloi += "," + UserHanding + ",";
        }
    }
    private bool _processingUpload = false;
    async Task SendMailnotify()
    {
        try
        {
            string[] users = _THKQ_Thongtinchung_Detail.nguoitraloi.Split(',');
            List<string> emails = new List<string>(); // Danh sách động, có thể thêm thoải mái

            int index = 0;
            foreach (var user in users)
            {
                if (string.IsNullOrEmpty(user))
                {

                }
                else
                {
                    string inputemail = "";
                    inputemail = await gsv.GetEmailAsync(user);
                    if (!string.IsNullOrEmpty(inputemail))
                    {
                        emails.Add(inputemail);
                    }

                }
            }
            string[] emailarray = emails.ToArray();
            _processingUpload = true;
            await Task.Delay(1);
            StateHasChanged();
            if (emails != null && emailarray.Length > 0)
            {
                var rs = await gsv.GuiThongBao_TKHQ(_THKQ_Thongtinchung_Detail, emailarray);
                if (rs.Flag == true)
                {
                    if (_THKQ_Thongtinchung_Detail.Id == Guid.Empty)
                    {
                        _THKQ_Thongtinchung_Detail.Trangthai = "Emailed";
                    }
                    else
                    {
                        _THKQ_Thongtinchung_Detail.Trangthai = "Emailed";
                        await tkhqsv.UpdateTKHQDetail(_THKQ_Thongtinchung_Detail);

                    }
                }
                CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);

            }
            else
            {

                CallSnackBar(Localizer["EmailEmpty"], MudBlazor.Severity.Warning);
                return;
            }




        }
        catch (Exception ex)
        {
            CallSnackBar(string.Format(Localizer["SomethingWentWrong"], ex.Message), MudBlazor.Severity.Error);
        }
        finally
        {
            _processingUpload = false;
        }

    }

    private bool _processingUploadzalo = false;
    async Task SendZalonotify()
    {
        try
        {
            _processingUploadzalo = true;
            await Task.Delay(1);
            StateHasChanged();

            if (string.IsNullOrEmpty(_THKQ_Thongtinchung_Detail.nguoitraloi))
            {
                CallSnackBar(Localizer["UserEmpty"], MudBlazor.Severity.Warning);
                return;
            }

            string[] users = _THKQ_Thongtinchung_Detail.nguoitraloi.Split(',');
            List<string> zaloid = new List<string>(); // Danh sách động, có thể thêm thoải mái

            int index = 0;
            foreach (var user in users)
            {
                if (string.IsNullOrEmpty(user))
                {

                }
                else
                {


                    var userinfo = await asv.GetUserDetail_byname(user);
                    if (!string.IsNullOrEmpty(userinfo.Zaloid))
                    {
                        zaloid.Add(userinfo.Zaloid);
                    }

                }
            }

            foreach (var u in zaloid)
            {

                var rs = await gsv.SendMessageAsync(u, _THKQ_Thongtinchung_Detail.TieuDeEmail, _THKQ_Thongtinchung_Detail.NoidungEmail, _THKQ_Thongtinchung_Detail.NoidungChitietEmail);
                if (!rs.Flag)
                {
                    CallSnackBar(rs.Message, MudBlazor.Severity.Error);
                    return;
                }
            }
            CallSnackBar(Localizer["SendSuccess"], MudBlazor.Severity.Success);
        }
        catch (Exception ex)
        {
            CallSnackBar(string.Format(Localizer["SomethingWentWrong"], ex.Message), MudBlazor.Severity.Error);
        }
        finally
        {
            _processingUploadzalo = false;
        }

    }

    List<string> Linksplit(string links)
    {
        if (string.IsNullOrEmpty(links))
            return new List<string>();
        return links.Split(';').ToList();
    }

    async Task SeeDetail(string link)
    {

        await JSRuntime.InvokeVoidAsync("open", link.Replace("ftp", "http"), "_blank");
    }
    async Task Deleteimg(M_TKHQ_Thongtinchunglohang item, string link)
    {
        try
        {
            if (item.Links!.Contains(";"))
                link = link + ";";
            item.Links = item.Links!.Replace(link, string.Empty);
            //var rs = ssv.DeleteFileFromFTP(link);
            //CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
            StateHasChanged();
