                                                    <MudText>Send Email</MudText>
                                                }
                                            </MudButton>
                                        </MudItem>

                                        <MudItem xs="2">
                                            <MudButton HtmlTag="label" Disabled="_processingUploadzalo"
                                                       @onclick="@(() => SendZalonotify())"
                                                       Size="Size.Small" Color="Color.Tertiary" Variant="Variant.Filled"
                                                       StartIcon="@Icons.Material.Filled.Send">
                                                @if (_processingUploadzalo)
                                                {
                                                    <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                                                    <MudText Class="ms-2">Processing</MudText>
                                                }
                                                else
                                                {
                                                    <MudText>Send Zalo</MudText>
                                                }
