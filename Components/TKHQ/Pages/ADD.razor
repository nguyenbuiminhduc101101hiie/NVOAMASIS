                                                             MaxItems="100">
                                            </MudAutocomplete>
                                        </MudItem>

                                        <MudItem xs="1">
                                            <MudButton Class="pl-4 labelCustomColor" Style="background-color: #007BFF; color: white;" Size="Size.Small" Color="Color.Primary"
                                                       OnClick="() => Getuser()">>>></MudButton>
                                        </MudItem>

                                        <MudItem xs="3">
                                            <MudTextField @bind-Value="_THKQ_Thongtinchung_Detail.nguoitraloi" class="custom-label" HelperTextOnFocus HelperText="từ 2 mail trở lên vui lòng ngăn cách bằng dấu ','"
                                                          Lines="3" AutoGrow Label="@Localizer["userguiemail"]" Required="false" />
                                        </MudItem>

                                        <MudItem xs="2">
                                            <MudButton HtmlTag="label" Disabled="_processingUpload"
                                                       @onclick="@(() => SendMailnotify())"
