                                        <MudItem xs="12">
                                            <MudTextField @bind-Value="_THKQ_Thongtinchung_Detail.TieuDeEmail" Lines="3" AutoGrow Label="@Localizer["tieudeemail"]" class="custom-label" Required="false" />
                                        </MudItem>
                                        <MudItem xs="12">
                                            <MudTextField @bind-Value="_THKQ_Thongtinchung_Detail.NoidungEmail" Lines="3" AutoGrow Label="@Localizer["noidung"]" class="custom-label" Required="false" />
                                        </MudItem>


                                        <MudItem xs="12">
                                            <MudTextField @bind-Value="_THKQ_Thongtinchung_Detail.NoidungChitietEmail" Lines="3" AutoGrow Label="@Localizer["chitietnoidung"]" class="custom-label" Required="false" />
                                        </MudItem>


                                        <MudItem xs="2">
                                            <MudAutocomplete Class="pl-4 labelCustomColor custom-label" T="string"
