@using NVOAMASIS.Models

<MudDialog>
    <DialogContent>
        <MudAlert Severity="MudBlazor.Severity.Info" Class="mb-3" Dense="true">
            File "@FileName" có @Rows.Count dòng. Kiểm tra lại dữ liệu bên dưới trước khi xác nhận import.
        </MudAlert>

        <MudDataGrid T="M_AirFreightRate" Items="@Rows" Dense="true" Striped="true" Bordered="true"
                     Virtualize="true" FixedHeader="true" Height="55vh">
            <Columns>
                <PropertyColumn Property="x => x.Airlines" Title="Airlines" />
                <PropertyColumn Property="x => x.Destination" Title="Destination" />
                <PropertyColumn Property="x => x.Min" Title="Min" Format="#,##0.##" />
                <PropertyColumn Property="x => x.RateUnder45" Title="-45kg" Format="#,##0.##" />
                <PropertyColumn Property="x => x.RateOver45" Title="+45kg" Format="#,##0.##" />
                <PropertyColumn Property="x => x.RateOver100" Title="+100kg" Format="#,##0.##" />
                <PropertyColumn Property="x => x.RateOver300" Title="+300kg" Format="#,##0.##" />
                <PropertyColumn Property="x => x.RateOver500" Title="+500kg" Format="#,##0.##" />
                <PropertyColumn Property="x => x.RateOver1000" Title="+1000kg" Format="#,##0.##" />
                <PropertyColumn Property="x => x.FscWsc" Title="FSC & WSC" />
                <PropertyColumn Property="x => x.Frequency" Title="FRE" />
                <PropertyColumn Property="x => x.Route" Title="ROUTE" />
                <PropertyColumn Property="x => x.TransitTime" Title="TT" />
                <PropertyColumn Property="x => x.Surcharges" Title="Surcharges" />
                <PropertyColumn Property="x => x.Note" Title="Note" />
            </Columns>
        </MudDataGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Huỷ</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.CheckCircle" OnClick="Confirm">
            Xác nhận import
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private MudDialogInstance MudDialog { get; set; } = default!;
    [Parameter, EditorRequired] public List<M_AirFreightRate> Rows { get; set; } = new();
    [Parameter, EditorRequired] public string FileName { get; set; } = string.Empty;

    private void Confirm() => MudDialog.Close(DialogResult.Ok(true));
    private void Cancel() => MudDialog.Cancel();
}
