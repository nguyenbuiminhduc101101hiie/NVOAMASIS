@page "/AirFreightRate"
@attribute [Authorize]
@using System.Text.Json
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.Extensions.Localization
@using NVOAMASIS.Models
@using NVOAMASIS.Resources
@using NVOAMASIS.Services
@inject AirFreightRateService Service
@inject AccountService asv
@inject SharedServices ssv
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IStringLocalizer<SharedResource> Localizer

<PageTitle>@Localizer["AirFreight_Title"]</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="pa-2">
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-2">
        <MudText Typo="Typo.h5">4.8 @Localizer["AirFreight_Title"]</MudText>
        <MudButton HtmlTag="label" Variant="Variant.Filled" Color="Color.Tertiary" StartIcon="@Icons.Material.Filled.UploadFile" Disabled="_importing || !_canAdd">
            @Localizer["AirFreight_ImportExcel"]
            <InputFile OnChange="OnFileSelectedAsync" accept=".xlsx,.xls" style="display:none" />
        </MudButton>
    </MudStack>

    @if (_importing)
    {
        <MudPaper Class="pa-3 mb-2" Elevation="0" Outlined="true">
            <MudText Typo="Typo.body2" Class="mb-1">@_importStageLabel</MudText>
            <MudProgressLinear Color="Color.Primary" Value="@_importPercent" />
        </MudPaper>
    }

    <ImportedFileDeleteCard Batches="_importedFiles" Busy="_importing" OnRefresh="LoadImportedFilesAsync" OnDeleteSelected="DeleteSelectedImportedFilesAsync" />

    <MudPaper Class="pa-2 mb-2 d-flex flex-wrap align-center gap-2">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Refresh" OnClick="RefreshAsync" Disabled="_loading">@Localizer["reload"]</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.Add" OnClick="AddAsync" Disabled="_loading || !_canAdd">@Localizer["new"]</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Info" StartIcon="@Icons.Material.Filled.Edit" OnClick="EditAsync" Disabled="_loading || !_canEdit">@Localizer["edit"]</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete" OnClick="DeleteSelectedAsync" Disabled="_loading || !_canDelete">@Localizer["delete"]</MudButton>
        <MudTextField T="string" @bind-Value="_searchText" Immediate="true" DebounceInterval="200" Clearable="true"
                      Placeholder="@Localizer["AirFreight_SearchPlaceholder"]" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                      Variant="Variant.Outlined" Margin="Margin.Dense" Class="ml-md-auto" Style="min-width:280px;" />
    </MudPaper>

    <MudDataGrid T="M_AirFreightRate" Items="@_items" Dense="true" Striped="true" Hover="true" Bordered="true"
                 FixedHeader="true" FixedFooter="true" Height="65vh" RowClick="@(e => _selected = e.Item)"
                 RowClassFunc="@SelectedRowClassFunc" QuickFilter="@QuickFilterFunc"
                 Filterable="true" FilterMode="@DataGridFilterMode.ColumnFilterRow">
        <Columns>
            <PropertyColumn Property="x => x.Airlines" Title="@Localizer["AirFreight_Col_Airlines"]" />
            <PropertyColumn Property="x => x.Destination" Title="@Localizer["AirFreight_Col_Destination"]" />
            <PropertyColumn Property="x => x.Min" Title="Min" Format="#,##0.##" />
            <PropertyColumn Property="x => x.RateUnder45" Title="-45kg" Format="#,##0.##" />
            <PropertyColumn Property="x => x.RateOver45" Title="+45kg" Format="#,##0.##" />
            <PropertyColumn Property="x => x.RateOver100" Title="+100kg" Format="#,##0.##" />
            <PropertyColumn Property="x => x.RateOver300" Title="+300kg" Format="#,##0.##" />
            <PropertyColumn Property="x => x.RateOver500" Title="+500kg" Format="#,##0.##" />
            <PropertyColumn Property="x => x.RateOver1000" Title="+1000kg" Format="#,##0.##" />
            <PropertyColumn Property="x => x.FscWsc" Title="FSC & WSC" />
            <PropertyColumn Property="x => x.Frequency" Title="FRE" />
            <PropertyColumn Property="x => x.Route" Title="ROUTE" />
            <PropertyColumn Property="x => x.TransitTime" Title="TT" />
            <PropertyColumn Property="x => x.Surcharges" Title="@Localizer["AirFreight_Col_Surcharges"]" />
            <PropertyColumn Property="x => x.Note" Title="@Localizer["AirFreight_Col_Note"]" />
            <PropertyColumn Property="x => x.SourceFileName" Title="@Localizer["AirFreight_Col_FileName"]" />
        </Columns>
        <PagerContent>
            <MudDataGridPager T="M_AirFreightRate" PageSizeOptions="new[] { 20, 50, 100 }" />
        </PagerContent>
    </MudDataGrid>
</MudContainer>

@code {
    private const string PermissionMenuName = "AirFreightRate";
    private bool _loading;
    private bool _importing;
    private bool _canView;
    private bool _canAdd;
    private bool _canEdit;
    private bool _canDelete;
    private readonly JsonSerializerOptions _jsonOptions = new() { PropertyNameCaseInsensitive = true };

    private List<M_AirFreightRate> _items = new();
    private M_AirFreightRate? _selected;
    private List<ImportedFileBatch> _importedFiles = new();
    private string _searchText = string.Empty;

    private string _importStageLabel = string.Empty;
    private double _importPercent;

    private Func<M_AirFreightRate, bool> QuickFilterFunc => row =>
    {
        if (string.IsNullOrWhiteSpace(_searchText))
            return true;

        return Contains(row.Airlines) || Contains(row.Destination) || Contains(row.Route)
            || Contains(row.Note) || Contains(row.Surcharges) || Contains(row.FscWsc)
            || Contains(row.SourceFileName) || Contains(row.UserImport);
    };

    private bool Contains(string? value) =>
        !string.IsNullOrEmpty(value) && value.Contains(_searchText, StringComparison.OrdinalIgnoreCase);

    private string SelectedRowClassFunc(M_AirFreightRate row, int rowNumber) =>
        _selected != null && row.Id == _selected.Id ? "selected" : string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadPermissionAsync();
        if (!_canView)
        {
            Snackbar.Add(Localizer["AirFreight_NoAccessView"], MudBlazor.Severity.Warning);
            return;
        }

        await RefreshAsync();
        await LoadImportedFilesAsync();
    }

    private async Task RefreshAsync()
    {
        _loading = true;
        _selected = null;
        try
        {
            _items = await Service.GetAllAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(Localizer["AirFreight_LoadError", ex.Message], MudBlazor.Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task LoadImportedFilesAsync()
    {
        _importedFiles = await Service.GetImportedFileBatchesAsync();
    }

    private async Task DeleteSelectedImportedFilesAsync(IReadOnlyList<ImportedFileBatch> batches)
    {
        if (!_canDelete)
        {
            Snackbar.Add(Localizer["AirFreight_NoAccessDelete"], MudBlazor.Severity.Warning);
            return;
        }

        if (batches.Count == 0)
            return;

        var label = string.Join(", ", batches.Select(x => x.DisplayLabel));
        var confirm = await DialogService.ShowMessageBox(
            Localizer["AirFreight_Warning"], Localizer["AirFreight_DeleteManyConfirm", label],
            yesText: Localizer["delete"].Value, cancelText: Localizer["cancel"].Value);
        if (confirm != true)
            return;

        _importing = true;
        try
        {
            var deleted = await Service.DeleteImportedFileBatchesAsync(batches);
            Snackbar.Add(Localizer["AirFreight_DeletedRows", deleted], MudBlazor.Severity.Success);
            await LoadImportedFilesAsync();
            await RefreshAsync();
        }
        finally
        {
            _importing = false;
        }
    }

    private async Task OnFileSelectedAsync(InputFileChangeEventArgs e)
    {
        if (!_canAdd)
        {
            Snackbar.Add(Localizer["AirFreight_NoAccessAdd"], MudBlazor.Severity.Warning);
            return;
        }

        if (e.FileCount == 0)
            return;

        var fileName = e.File.Name;

        // Read the browser file into memory BEFORE touching any UI state. Blazor Server's
        // InputFile JS interop tracks the selected file by a client-side id; if the
        // component re-renders (e.g. from a StateHasChanged() call) before the stream is
        // fully read, that id can be lost, throwing "Cannot read properties of null
        // (reading '_blazorFilesById')". Reading first, with no state change in between,
        // avoids that race.
        byte[] fileBytes;
        try
        {
            await using var stream = e.File.OpenReadStream(20 * 1024 * 1024);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            fileBytes = ms.ToArray();
        }
        catch (Exception ex)
        {
            Snackbar.Add(Localizer["AirFreight_ReadFileError", ex.Message], MudBlazor.Severity.Error);
            return;
        }

        if (await Service.FileNameExistsAsync(fileName))
        {
            Snackbar.Add(Localizer["AirFreight_FileAlreadyImported", fileName], MudBlazor.Severity.Warning);
            return;
        }

        _importing = true;
        _importStageLabel = Localizer["AirFreight_StageReading"];
        _importPercent = 0;
        StateHasChanged();
        try
        {
            using var ms = new MemoryStream(fileBytes);
            var preview = await Service.ParseAsync(ms, fileName, ReportParseProgress);
            if (!string.IsNullOrWhiteSpace(preview.ErrorMessage))
            {
                Snackbar.Add(Localizer["AirFreight_ImportError", preview.ErrorMessage], MudBlazor.Severity.Error);
                return;
            }
            if (preview.Rows.Count == 0)
            {
                Snackbar.Add(Localizer["AirFreight_ImportEmptyFile"], MudBlazor.Severity.Warning);
                return;
            }

            _importing = false;
            StateHasChanged();

            var previewDialog = DialogService.Show<AirFreightRateImportPreview_Dialog>(
                Localizer["AirFreight_PreviewTitle"],
                new DialogParameters { ["Rows"] = preview.Rows, ["FileName"] = fileName },
                new DialogOptions { MaxWidth = MaxWidth.ExtraLarge, FullWidth = true, CloseOnEscapeKey = true });
            var previewResult = await previewDialog.Result;
            if (previewResult.Canceled || previewResult.Data is not bool confirmed || !confirmed)
                return;

            _importing = true;
            _importStageLabel = Localizer["AirFreight_StageSaving"];
            _importPercent = 0;
            StateHasChanged();

            var authState = await asv.GetAuth();
            var importUser = authState.User?.Identity?.Name;
            var commitResult = await Service.CommitImportAsync(preview.Rows, fileName, importUser);
            if (!string.IsNullOrWhiteSpace(commitResult.ErrorMessage))
            {
                Snackbar.Add(Localizer["AirFreight_ImportError", commitResult.ErrorMessage], MudBlazor.Severity.Error);
                return;
            }

            Snackbar.Add(Localizer["AirFreight_ImportSuccess", commitResult.Imported], MudBlazor.Severity.Success);
            await LoadImportedFilesAsync();
            await RefreshAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(Localizer["AirFreight_ImportError", ex.Message], MudBlazor.Severity.Error);
        }
        finally
        {
            _importing = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task ReportParseProgress(AirFreightRateImportProgress p)
    {
        _importStageLabel = $"{Localizer["AirFreight_StageReading"]} ({p.Current}/{p.Total})";
        _importPercent = p.Total == 0 ? 0 : 100.0 * p.Current / p.Total;
        await InvokeAsync(StateHasChanged);
    }

    private async Task AddAsync()
    {
        if (!_canAdd)
        {
            Snackbar.Add(Localizer["AirFreight_NoAccessAdd"], MudBlazor.Severity.Warning);
            return;
        }

        var now = DateTime.UtcNow;
        var authState = await asv.GetAuth();
        var model = new M_AirFreightRate
        {
            Id = Guid.NewGuid(),
            SourceFileName = null,
            UserImport = authState.User?.Identity?.Name,
            DateImport = now,
            CreatedAt = now
        };
        await OpenDialogAndSaveAsync(model, isNew: true);
    }

    private async Task EditAsync()
    {
        if (!_canEdit)
        {
            Snackbar.Add(Localizer["AirFreight_NoAccessEdit"], MudBlazor.Severity.Warning);
            return;
        }

        if (_selected == null)
        {
            Snackbar.Add(Localizer["AirFreight_SelectRowToEdit"], MudBlazor.Severity.Warning);
            return;
        }

        await OpenDialogAndSaveAsync(Clone(_selected), isNew: false);
    }

    private async Task DeleteSelectedAsync()
    {
        if (!_canDelete)
        {
            Snackbar.Add(Localizer["AirFreight_NoAccessDelete"], MudBlazor.Severity.Warning);
            return;
        }

        if (_selected == null)
        {
            Snackbar.Add(Localizer["AirFreight_SelectRowToDelete"], MudBlazor.Severity.Warning);
            return;
        }

        var confirm = await DialogService.ShowMessageBox(Localizer["AirFreight_Warning"], Localizer["AirFreight_DeleteConfirm"], yesText: Localizer["delete"].Value, cancelText: Localizer["cancel"].Value);
        if (confirm != true)
            return;

        var result = await Service.DeleteAsync(_selected.Id);
        if (!result.Ok)
        {
            Snackbar.Add(result.Error ?? Localizer["AirFreight_DeleteFailed"].Value, MudBlazor.Severity.Error);
            return;
        }

        Snackbar.Add(Localizer["AirFreight_Deleted"], MudBlazor.Severity.Success);
        await RefreshAsync();
    }

    private async Task OpenDialogAndSaveAsync(M_AirFreightRate model, bool isNew)
    {
        var lockedFileName = model.SourceFileName;
        var dialog = DialogService.Show<AirFreightRateEdit_Dialog>(
            Localizer[isNew ? "AirFreight_AddDialogTitle" : "AirFreight_EditDialogTitle"],
            new DialogParameters
            {
                ["Model"] = model,
                ["IsNew"] = isNew
            },
            new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true, CloseOnEscapeKey = true, DisableBackdropClick = true });
        var result = await dialog.Result;
        if (result.Canceled || result.Data is not M_AirFreightRate data)
            return;

        data.SourceFileName = lockedFileName; // fixed by context, not user-editable.
        var saveResult = await Service.UpsertAsync(data);
        if (!saveResult.Ok)
        {
            Snackbar.Add(saveResult.Error ?? Localizer["AirFreight_SaveFailed"].Value, MudBlazor.Severity.Error);
            return;
        }

        Snackbar.Add(Localizer["AirFreight_Saved"], MudBlazor.Severity.Success);
        await RefreshAsync();
    }

    private T Clone<T>(T source)
    {
        var json = JsonSerializer.Serialize(source, _jsonOptions);
        return JsonSerializer.Deserialize<T>(json, _jsonOptions)!;
    }

    private async Task LoadPermissionAsync()
    {
        var authState = await asv.GetAuth();
        var username = authState.User?.Identity?.Name;
        if (string.IsNullOrWhiteSpace(username))
            return;

        _canView = await ssv.CheckPermission(username, "View", PermissionMenuName);
        _canAdd = await ssv.CheckPermission(username, "Add", PermissionMenuName);
        _canEdit = await ssv.CheckPermission(username, "Edit", PermissionMenuName);
        _canDelete = await ssv.CheckPermission(username, "Delete", PermissionMenuName);
    }
}
