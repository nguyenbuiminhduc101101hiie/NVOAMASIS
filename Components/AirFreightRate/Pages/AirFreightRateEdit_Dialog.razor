@using System.Globalization
@using Microsoft.Extensions.Localization
@using NVOAMASIS.Models
@using NVOAMASIS.Resources
@inject IStringLocalizer<SharedResource> Localizer

<MudDialog>
    <TitleContent>
        <div class="d-flex align-center gap-2">
            <MudIcon Icon="@Icons.Material.Filled.FlightTakeoff" Color="Color.Primary" />
            <MudText Typo="Typo.h6">@Localizer[IsNew ? "AirFreight_AddDialogTitle" : "AirFreight_EditDialogTitle"]</MudText>
        </div>
    </TitleContent>
    <DialogContent>
        <div class="afr-dialog">
            <section>
                <div class="afr-section-title">
                    <MudIcon Icon="@Icons.Material.Filled.Route" Size="Size.Small" />
                    <span>@Localizer["AirFreight_Section_Route"]</span>
                </div>
                <MudGrid Spacing="2">
                    <MudItem xs="12" sm="6" md="4">
                        <MudTextField @bind-Value="Model.Airlines" Label="@Localizer["AirFreight_Col_Airlines"]"
                                      Variant="Variant.Outlined" Margin="Margin.Dense" AutoFocus="true" />
                    </MudItem>
                    <MudItem xs="12" sm="6" md="4">
                        <MudTextField @bind-Value="Model.Destination" Label="@Localizer["AirFreight_Col_Destination"]"
                                      Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </MudItem>
                    <MudItem xs="12" sm="12" md="4">
                        <MudTextField @bind-Value="Model.Route" Label="@($"{Localizer["AirFreight_Col_Route"]} (ROUTE)")"
                                      Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </MudItem>
                    <MudItem xs="12" sm="6" md="4">
                        <MudTextField @bind-Value="Model.Frequency" Label="@($"{Localizer["AirFreight_Col_Frequency"]} (FRE)")"
                                      Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </MudItem>
                    <MudItem xs="12" sm="6" md="4">
                        <MudTextField @bind-Value="Model.TransitTime" Label="@($"{Localizer["AirFreight_Col_TransitTime"]} (TT)")"
                                      Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </MudItem>
                </MudGrid>
            </section>

            <section>
                <div class="afr-section-title">
                    <MudIcon Icon="@Icons.Material.Filled.Scale" Size="Size.Small" />
                    <span>@Localizer["AirFreight_Section_Rates"]</span>
                </div>
                <div class="afr-tiers">
                    <div class="afr-tier afr-tier-min">
                        <label class="afr-tier-label">Min</label>
                        <MudNumericField T="decimal?" @bind-Value="Model.Min"
                                         Format="#,##0.##" Culture="@Invariant" HideSpinButtons="true"
                                         Variant="Variant.Outlined" Margin="Margin.Dense" Class="afr-num" aria-label="Min" />
                        <span class="afr-tier-note">@Localizer["AirFreight_MinUnit"]</span>
                    </div>
                    @for (var i = 0; i < Tiers.Length; i++)
                    {
                        var t = i;
                        <div class="afr-tier">
                            <label class="afr-tier-label">@Tiers[t].Label</label>
                            <MudNumericField T="decimal?" Value="@Tiers[t].Get(Model)" ValueChanged="@(v => Tiers[t].Set(Model, v))"
                                             Format="#,##0.##" Culture="@Invariant" HideSpinButtons="true"
                                             Variant="Variant.Outlined" Margin="Margin.Dense" Class="afr-num" aria-label="@Tiers[t].Label" />
                            @if (IsHigherThanPrevious(t))
                            {
                                <span class="afr-tier-warn">@Localizer["AirFreight_TierHigherWarning"]</span>
                            }
                        </div>
                    }
                </div>
            </section>

            <section>
                <div class="afr-section-title">
                    <MudIcon Icon="@Icons.Material.Filled.StickyNote2" Size="Size.Small" />
                    <span>@Localizer["AirFreight_Section_Notes"]</span>
                </div>
                <MudGrid Spacing="2">
                    <MudItem xs="12">
                        <MudTextField @bind-Value="Model.FscWsc" Label="FSC & WSC"
                                      Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudTextField @bind-Value="Model.Surcharges" Label="@Localizer["AirFreight_Col_Surcharges"]"
                                      Lines="2" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudTextField @bind-Value="Model.Note" Label="@Localizer["AirFreight_Col_Note"]"
                                      Lines="2" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </MudItem>
                </MudGrid>
            </section>
        </div>
    </DialogContent>
    <DialogActions>
        <div class="afr-meta">
            <MudIcon Icon="@(string.IsNullOrWhiteSpace(Model.SourceFileName) ? Icons.Material.Filled.Keyboard : Icons.Material.Filled.Description)" Size="Size.Small" />
            <span>@(string.IsNullOrWhiteSpace(Model.SourceFileName) ? Localizer["AirFreight_Meta_Manual"].Value : Model.SourceFileName)</span>
            @if (!string.IsNullOrWhiteSpace(Model.UserImport))
            {
                <span>· @Localizer["AirFreight_Meta_ImportedBy", Model.UserImport]</span>
            }
            <span>· @Model.DateImport.ToString("dd/MM/yyyy")</span>
        </div>
        <MudButton Variant="Variant.Text" OnClick="Cancel">@Localizer["cancel"]</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save" OnClick="Save">@Localizer["save"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private MudDialogInstance MudDialog { get; set; } = default!;
    [Parameter, EditorRequired] public M_AirFreightRate Model { get; set; } = default!;
    [Parameter] public bool IsNew { get; set; }

    private static readonly CultureInfo Invariant = CultureInfo.InvariantCulture;

    private sealed record WeightTier(string Label, Func<M_AirFreightRate, decimal?> Get, Action<M_AirFreightRate, decimal?> Set);

    // Per-kg break points, lightest first; same order and labels as the grid columns.
    private static readonly WeightTier[] Tiers =
    {
        new("-45kg", m => m.RateUnder45, (m, v) => m.RateUnder45 = v),
        new("+45kg", m => m.RateOver45, (m, v) => m.RateOver45 = v),
        new("+100kg", m => m.RateOver100, (m, v) => m.RateOver100 = v),
        new("+300kg", m => m.RateOver300, (m, v) => m.RateOver300 = v),
        new("+500kg", m => m.RateOver500, (m, v) => m.RateOver500 = v),
        new("+1000kg", m => m.RateOver1000, (m, v) => m.RateOver1000 = v),
    };

    /// <summary>Heavier tiers are normally cheaper per kg; flags a likely typo (non-blocking).</summary>
    private bool IsHigherThanPrevious(int index)
    {
        var current = Tiers[index].Get(Model);
        if (!current.HasValue)
            return false;

        for (var i = index - 1; i >= 0; i--)
        {
            var previous = Tiers[i].Get(Model);
            if (previous.HasValue)
                return current.Value > previous.Value;
        }

        return false;
    }

    private void Save() => MudDialog.Close(DialogResult.Ok(Model));
    private void Cancel() => MudDialog.Cancel();
}
