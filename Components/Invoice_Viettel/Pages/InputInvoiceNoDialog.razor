@using MudBlazor

<MudDialog>
    <DialogContent>
        <MudTextField @bind-Value="InvoiceNo"
                     Label="Số Hóa Đơn Nội Bộ"
                     Variant="Variant.Outlined"
                     Required="true"
                     RequiredError="Vui lòng nhập số hóa đơn nội bộ"
                     FullWidth="true" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Hủy</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit">Xác Nhận</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] MudDialogInstance MudDialog { get; set; } = default!;

    private string InvoiceNo { get; set; } = string.Empty;

    void Submit()
    {
        if (string.IsNullOrWhiteSpace(InvoiceNo))
        {
            return;
        }
        MudDialog.Close(DialogResult.Ok(InvoiceNo));
    }

    void Cancel() => MudDialog.Cancel();
}

