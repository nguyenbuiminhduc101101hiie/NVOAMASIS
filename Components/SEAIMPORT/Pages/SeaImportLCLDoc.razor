@page "/seaimport/doc"

@inject ReportServices rpsv
@inject ISnackbar Snackbar
@inject IDialogService Dialog
@attribute [Authorize]
<style>

    .custom-header-class {
        background-color: #06D6A0;
        font-weight: bold; 
    }
    .custom-headertable-class {
        background-color: #FFD166;
    }


    .selected {
        background-color: #1E88E5 !important;
    }

    .selected > td {
        color: white !important;
    }

    .selected > td .mud-input {
        color: white !important;
    }

    .custom-paper {
        margin-top: 10px;
        margin-left: 160px;
        margin-bottom: 10px;
    }

    .custom-viewbutton {
        margin-top: 10px;
        margin-left: 160px;
        margin-bottom: 5px;
    }

    .mud-table-cell, .mud-tab, .mud-input, .mud-input-label {
        font-size:small;
        white-space: nowrap;
        overflow: hidden; 
        text-overflow: ellipsis;
    }
    .mud-input-label
    {
        color: rgba(17, 138, 178) !important;
    }

    .mud-input-text:not(.mud-select-input) {
        background-color: rgba(255, 209, 102, 0.1);
        backdrop-filter: blur(20px);
    }
</style>

<PageTitle>Import (Agent/Oversea) - F</PageTitle>
<MudPaper Class="custom-paper">
    <MudDataGrid T="ListRef" Items="@ListInboundsRef" Filterable="true"
                 LoadingProgressColor="Color.Info" Loading="_load"
                 Style="max-height:400px;" HorizontalScrollbar="true"
                 ColumnResizeMode="ResizeMode.Column"
                 FilterMode="@DataGridFilterMode.ColumnFilterRow" 
                 Dense="true" ItemSize="10" RowsPerPage="4"
                 HeaderClass="custom-header-class ">
                 <ColGroup>
                    <col style ="width:10px" />
                    <col style="width:10px" />
                    <col style="width:200px" />
                    <col style="width:200px" />
                    <col style="width:180px" />
                 </ColGroup>
                 <ToolBarContent>
                    <MudSelect Dense="true" T="string" Label="Choose Type (L-F-C)" AnchorOrigin="Origin.BottomCenter"
                       Variant="Variant.Text" SelectedValuesChanged="GetListAsync" @bind-Value="SelectedValue">
                        @foreach(var item in cLTypes)
                        {
                            <MudSelectItem Value="item.SoftName">@item.FullName</MudSelectItem>
                        }
                    </MudSelect>
                 </ToolBarContent>
                <Columns>
                    <HierarchyColumn T="ListRef"/>
                    <PropertyColumn Property="x => x.gFLC" Title="F/L/C" />
                    <PropertyColumn Property="x => x.REF" Title="REF" />
                    <PropertyColumn Property="x => x.MBL" Title="MBL" />
                    <PropertyColumn Property="x => x.TotalHBL" Title="Total HBL" />
                    <PropertyColumn Property="x => string.Empty" Title="" Filterable="false" Sortable="false" />
                </Columns>
                <ChildRowContent >
                    <MudTable T="InboundFull"
                              Items="@Inbounds.Where(_ => _.REF == @context.Item.REF).ToList()"
                              HeaderClass="custom-headertable-class" Style="max-height:180px"
                      Dense="true" ItemSize="10"
                      RowClass="cursor-pointer" RowClassFunc="@((item, idx) => TblRowStyle(item, idx))"
                        OnRowClick="RowClickEvent">
                        <HeaderContent>
                            <MudTh>F/L/C</MudTh>
                            <MudTh>REF</MudTh>
                            <MudTh>Status</MudTh>
                            <MudTh>ETA</MudTh>
                            <MudTh>Vessel</MudTh>
                            <MudTh>Voyage</MudTh>
                            <MudTh>Consignee</MudTh>
                            <MudTh>POL</MudTh>
                            <MudTh>POD</MudTh>
                            <MudTh>Paid Debit</MudTh>
                            <MudTh>DEST.</MudTh>
                            <MudTh>DEST. Mainfest</MudTh>
                            <MudTh>MBL</MudTh>
                            <MudTh>HBL</MudTh>
                            <MudTh>Bill type</MudTh>
                            <MudTh>Cont. 20</MudTh>
                            <MudTh>Cont. 40</MudTh>
                            <MudTh>LOT</MudTh>
                            <MudTh>Invoice Request</MudTh>
                            <MudTh>Debit Issued</MudTh>
                            <MudTh>Invoice Issued</MudTh>
                            <MudTh>Paid</MudTh>
                            <MudTh>Paid Credit</MudTh>
                            <MudTh>Aprrove</MudTh>
                            <MudTh>Shipper</MudTh>
                            <MudTh>Notify</MudTh>
                            <MudTh>Debit No.</MudTh>
                            <MudTh>Credit No.</MudTh>
                            <MudTh>Report Date</MudTh>
                            <MudTh>Lock</MudTh>
                            <MudTh>User Update</MudTh>
                            <MudTh>Date Update</MudTh>
                        </HeaderContent>
                        <RowTemplate Context="contextnew">
                            <MudTd DataLabel="F/L/C"> @contextnew.gFLC</MudTd>
                            <MudTd DataLabel="REF"> @contextnew.REF </MudTd>
                            <MudTd DataLabel="Status"> @contextnew.status</MudTd>
                            <MudTd DataLabel="ETA"> @contextnew.ETA</MudTd>
                            <MudTd DataLabel="Vessel" > @contextnew.VESSEL</MudTd>
                            <MudTd DataLabel="Voyage"> @contextnew.VOYAGE</MudTd>
                            <MudTd DataLabel="Consignee"> @contextnew.CONSIGNEE</MudTd>
                            <MudTd DataLabel="Pol"> @contextnew.POL</MudTd>
                            <MudTd DataLabel="Pod"> @contextnew.POD</MudTd>
                            <MudTd DataLabel="Paid Debit"> @contextnew.paiddebit</MudTd>
                            <MudTd DataLabel="DEST."> @contextnew.DEST</MudTd>
                            <MudTd DataLabel="DEST. Mainfest"> @contextnew.destpreedays</MudTd>
                            <MudTd DataLabel="MBL"> @contextnew.MBL</MudTd>
                            <MudTd DataLabel="HBL"> @contextnew.HBL</MudTd>
                            <MudTd DataLabel="Bill Type" > @contextnew.BL_TYPE</MudTd>
                            <MudTd DataLabel="LOT"> @contextnew.lot</MudTd>
                            <MudTd DataLabel="Invoice Request"> @contextnew.InvoiceRequest</MudTd>
                            <MudTd DataLabel="Debit Issued"> @contextnew.DebitIssued</MudTd>
                            <MudTd DataLabel="Invoice Issued"> @contextnew.InvoiceIssued</MudTd>
                            <MudTd DataLabel="Paid"> @contextnew.Paid</MudTd>
                            <MudTd DataLabel="Paid Credit"> @contextnew.paidcredit</MudTd>
                            <MudTd DataLabel="Aprrove"> @contextnew.Approve</MudTd>
                            <MudTd DataLabel="Shipper"> @contextnew.SHIPPER</MudTd>
                            <MudTd DataLabel="Notify"> @contextnew.NOTIFY</MudTd>
                            <MudTd DataLabel="Debit No." > @contextnew.NoDebit</MudTd>
                            <MudTd DataLabel="Credit No." > @contextnew.noCredit</MudTd>
                            <MudTd DataLabel="Report Date" > @contextnew.datereport</MudTd>
                            <MudTd DataLabel="Lock"> @contextnew.Continued</MudTd>
                            <MudTd DataLabel="User Update" > @contextnew.UserUpdate</MudTd>
                            <MudTd DataLabel="Date Update" > @contextnew.DateUpdate</MudTd>
                        </RowTemplate>
                    </MudTable>
            </ChildRowContent>
            <PagerContent>
                <MudDataGridPager T="ListRef"  PageSizeOptions="[4,10,15]" />
            </PagerContent>
    </MudDataGrid>
</MudPaper>
    <MudGrid Class=" custom-viewbutton">
        <MudItem xs="6">
            <MudGrid Justify="Justify.FlexStart">
                <MudItem xs="3" >
                    <MudButton Variant="Variant.Filled"
                            StartIcon="@Icons.Material.Filled.Save"
                            Color="Color.Info" Size="Size.Small"
                            OnClick="@(async () => await Submit())"
                            ButtonType="ButtonType.Submit">Save</MudButton>
                </MudItem>
                <MudItem xs="3">
                    <MudButton Variant="Variant.Filled"
                            StartIcon="@Icons.Material.Filled.Undo"
                            Color="Color.Warning" Size="Size.Small"
                            OnClick="@(async () => await Reset())"
                            ButtonType="ButtonType.Submit">Clear</MudButton>
                </MudItem>
            </MudGrid>
        </MudItem>
        <MudItem xs="6">

        </MudItem>
    </MudGrid>

<MudTabs Position="Position.Start" Rounded="true" Border="true"
         MinimumTabWidth="20px" Style="margin-top:5px !important;"
         ApplyEffectsToContainer="true" Class="mt-8" PanelClass="pa-6">
    <MudTabPanel Text="Information">
        <MudContainer Style="min-height: 700px">
            <MudForm Model="@In_BoundDetail" @ref="@form" Validation="@(orderValidator.ValidateValue)" ValidationDelay="1">
                    <MudGrid>
                        <MudItem xs="6">
                            <MudTextField @bind-Value="In_BoundDetail.bkno"
                                          For="@(() => In_BoundDetail.bkno)"
                                          Immediate="true"
                                          Label="BK No." />

                            <MudSelect Dense="true" T="string" Label="Vessel" 
                                AnchorOrigin="Origin.BottomCenter"
                                Variant="Variant.Text"
                                @bind-Value="In_BoundDetail.VESSEL">
                                @if(ListVessel != null)
                                    @foreach (var item in ListVessel)
                                    {
                                        <MudSelectItem Value="item">@item</MudSelectItem>
                                    }
                            </MudSelect>

                            <MudTextField @bind-Value="In_BoundDetail.SAILINGDATE"
                                          For="@(() => In_BoundDetail.SAILINGDATE)"
                                          Immediate="true"
                                          Label="ETD" />

                            <MudTextField @bind-Value="In_BoundDetail.bkkcomm"
                                          For="@(() => In_BoundDetail.bkkcomm)"
                                          Immediate="true"
                                          Label="Issue" />

                            <MudTextField @bind-Value="In_BoundDetail.ETA"
                                          For="@(() => In_BoundDetail.ETA)"
                                          Immediate="true"
                                          Label="ETA" />

                            <MudTextField @bind-Value="In_BoundDetail.paidreceived"
                                          For="@(() => In_BoundDetail.paidreceived)"
                                          Immediate="true"
                                          Label="ATA" />
                            <MudGrid Justify="Justify.FlexStart">
                                <MudItem xs="4">
                                    <MudSelect Dense="true" T="string" Label="POL Code"
