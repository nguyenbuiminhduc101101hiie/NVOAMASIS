                                               Variant="Variant.Text"
                                               SelectedValuesChanged="GetPOL" 
                                               @bind-Value="In_BoundDetail.POLCode">
                                        @if(ListPOL_POD_DESTcmb != null)
                                        @foreach (var item in ListPOL_POD_DESTcmb)
                                        {
                                            <MudSelectItem Value="item">@item</MudSelectItem>
                                        }
                                    </MudSelect>
                                </MudItem>
                                <MudItem xs="8">
                                    <MudTextField @bind-Value="In_BoundDetail.POL"
                                                  For="@(() => In_BoundDetail.POL)"
                                                  Immediate="true"
                                                  Label="POL" />
                                </MudItem>
                            </MudGrid>

                            <MudGrid Justify="Justify.FlexStart">
                                <MudItem xs="4">
                                    <MudSelect Dense="true" T="string" Label="POD Code"
                                               AnchorOrigin="Origin.BottomCenter"
                                               Variant="Variant.Text"
                                               SelectedValuesChanged="GetPOD"
                                               @bind-Value="In_BoundDetail.podcode">
                                                @if(ListPOL_POD_DESTcmb != null)
                                               @foreach (var item in ListPOL_POD_DESTcmb)
                                                {
                                                    <MudSelectItem Value="item">@item</MudSelectItem>
                                                }
                                    </MudSelect>
                                </MudItem>
                                <MudItem xs="8">
                                    <MudTextField @bind-Value="In_BoundDetail.POD"
                                                  For="@(() => In_BoundDetail.POD)"
                                                  Immediate="true"
                                                  Label="POD" />
                                </MudItem>
                            </MudGrid>

                            <MudGrid Justify="Justify.FlexStart">
                                <MudItem xs="4">
                                    <MudSelect Dense="true" T="string" Label="DEST CODE"
                                               AnchorOrigin="Origin.BottomCenter"
                                               Variant="Variant.Text"
                                               SelectedValuesChanged="GetDEST" 
                                               @bind-Value="In_BoundDetail.SentHPGDate">
                                            @if(ListPOL_POD_DESTcmb != null)
                                               @foreach (var item in ListPOL_POD_DESTcmb)
                                                {
                                                    <MudSelectItem Value="item">@item</MudSelectItem>
                                                }
                                    </MudSelect>
                                </MudItem>
                                <MudItem xs="8">
                                    <MudTextField @bind-Value="In_BoundDetail.DEST"
                                          For="@(() => In_BoundDetail.DEST)"
                                          Immediate="true"
                                          Label="DEST" />
                                </MudItem>
                            </MudGrid>

                            <MudSelect Dense="true" T="string" Label="Sales"
                                        AnchorOrigin="Origin.BottomCenter"
                                        Variant="Variant.Text"
                                        @bind-Value="In_BoundDetail.SaleCode">
                                    @if (ListSalescmb != null)
                                    @foreach (var item in ListSalescmb)
                                    {
                                        <MudSelectItem Value="item">@item</MudSelectItem>
                                    }
                            </MudSelect>

                            <MudTextField @bind-Value="In_BoundDetail.remarks"
                                          For="@(() => In_BoundDetail.remarks)"
                                          Immediate="true"
                                          Label="Remarks" 
                                          AutoGrow MaxLines="4" />

                            <MudTextField @bind-Value="In_BoundDetail.loai"
                                          For="@(() => In_BoundDetail.loai)"
                                          Immediate="true"
                                          Label="Remarks Booking"
                                        AutoGrow MaxLines="4" />

                             <MudTextField @bind-Value="In_BoundDetail.commodity"
                                           For="@(() => In_BoundDetail.commodity)"
                                           Immediate="true"
                                           Label="Re./Comm"
                                            AutoGrow MaxLines="2" />

                            <MudTextField @bind-Value="In_BoundDetail.remarksdo"
                                       For="@(() => In_BoundDetail.remarksdo)"
                                          Immediate="true"
                                          Label="Remarks DO"
                                        AutoGrow MaxLines="4" />

                            <MudSelect Dense="true" T="string" Label="Status"
                                        AnchorOrigin="Origin.BottomCenter"
                                        Variant="Variant.Text"
                                        @bind-Value="In_BoundDetail.status">
                             <MudSelectItem Value="@("COMPLETE")">COMPLETE</MudSelectItem>
                             <MudSelectItem Value="@("PENDING")">PENDING</MudSelectItem>
                                <MudSelectItem Value="@("CANCELED")">COMPLETE</MudSelectItem>
                            </MudSelect>

                             <MudSelect Dense="true" T="string" Label="Group"
                                        AnchorOrigin="Origin.BottomCenter"
                                        Variant="Variant.Text"
                                        @bind-Value="In_BoundDetail.ItemSITC">
                                        @if(ListGroupcmb != null)
                                        @foreach(var item in ListGroupcmb)
                                        {
                                            <MudSelectItem Value="item">@item</MudSelectItem>
                                        }
                             </MudSelect>

                             <MudGrid Justify="Justify.FlexStart">
                                <MudItem xs="4">
                                    <MudTextField 
                                              T = "string"
                                              Mask="@(new RegexMask(@"^[a-zA-Z0-9_.-]*$"))"
                                              TextChanged="(t) => In_BoundDetail.COLOADER_INBOUND = string.IsNullOrEmpty(t) ? string.Empty : 
                                        string.IsNullOrEmpty(ListCOLoadercmb.FirstOrDefault(x => x.ToLower().Contains(t.ToLower()))) ? string.Empty :
                                        ListCOLoadercmb.FirstOrDefault(x => x.ToLower().Contains(t.ToLower()))"
                                              Immediate="true"
                                              Label="Search" />
                                </MudItem>
                                <MudItem xs="8">
                                    <MudSelect Dense="true" T="string" Label="Co-Loader"
                                            AnchorOrigin="Origin.BottomCenter"
                                            Variant="Variant.Text"
                                            @bind-Value="In_BoundDetail.COLOADER_INBOUND">
                                        @if (ListCOLoadercmb != null)
                                            @foreach(var item in ListCOLoadercmb)
                                            {
                                                <MudSelectItem Value="item">@item</MudSelectItem>
                                            }
                                    </MudSelect>
                                </MudItem>
                            </MudGrid>
                        </MudItem>
                        
                        <MudItem xs="6">
                            <MudGrid>
                                <MudItem xs="6">
                                    <MudTextField @bind-Value="In_BoundDetail.VOYAGE"
                                          For="@(() => In_BoundDetail.VOYAGE)"
                                          Immediate="true"
                                          Label="Voyage" />
                                 </MudItem>
                                      
                                 <MudItem xs="6">
                                    <MudTextField @bind-Value="In_BoundDetail.oprcode"
                                                  For="@(() => In_BoundDetail.oprcode)"
                                                  Immediate="true"
                                                  Label="OPR. Code" />
                                 </MudItem>
                            </MudGrid>

                            <MudGrid Justify="Justify.FlexStart">
                                <MudItem xs="4">
                                    <MudTextField 
                                          T = "string"
                                          Mask="@(new RegexMask(@"^[a-zA-Z0-9_.-]*$"))"
                                        TextChanged="(t) => In_BoundDetail.DEL = string.IsNullOrEmpty(t) ? string.Empty : 
                                       string.IsNullOrEmpty(ListDelscmb.FirstOrDefault(x => x.ToLower().Contains(t.ToLower()))) ?  string.Empty :
                                        ListDelscmb.FirstOrDefault(x => x.ToLower().Contains(t.ToLower()))"
                                          Immediate="true"
                                          Label="Search" />
                                </MudItem>
                                <MudItem xs="8">
                                     <MudSelect Dense="true" T="string" Label="DEL"
                                                AnchorOrigin="Origin.BottomCenter"
                                                Variant="Variant.Text"
                                                @bind-Value="In_BoundDetail.DEL">
                                     @if (ListDelscmb != null)
                                            @foreach (var item in ListDelscmb)
                                            {
                                                <MudSelectItem Value="item">@item</MudSelectItem>
                                            }
                                    </MudSelect>
                                </MudItem>
                            </MudGrid>

                             <MudGrid Justify="Justify.FlexStart">
                                <MudItem xs="4">
                                    <MudTextField 
                                          T = "string"
                                          Immediate="true"
                                          Mask="@(new RegexMask(@"^[a-zA-Z0-9_.-]*$"))"
                                              TextChanged="(t) => In_BoundDetail.ImportCY = string.IsNullOrEmpty(t) ? string.Empty : 
                                                string.IsNullOrEmpty(ListCYcmb.FirstOrDefault(x => x.ToLower().Contains(t.ToLower()))) ? string.Empty :
                                                ListCYcmb.FirstOrDefault(x => x.ToLower().Contains(t.ToLower()))"
                                          Label="Search" />
                                </MudItem>
                                <MudItem xs="8">
                                     <MudSelect Dense="true" T="string" Label="Port/ICD"
                                                AnchorOrigin="Origin.BottomCenter"
                                                Variant="Variant.Text"
                                            @bind-Value="In_BoundDetail.ImportCY">
                                         @if (ListCYcmb != null)
                                         @foreach (var item in ListCYcmb)
                                            {
                                                <MudSelectItem Value="item">@item</MudSelectItem>
                                            }
                                    </MudSelect>
                                </MudItem>
                            </MudGrid>

                            <MudGrid Justify="Justify.FlexStart">
                                <MudItem xs="4">
                                    <MudTextField T="string"
                                                  Immediate="true"
                                                  Mask="@(new RegexMask(@"^[a-zA-Z0-9_.-]*$"))"
                                              TextChanged="(t) => In_BoundDetail.ShippingLine = string.IsNullOrEmpty(t) ? string.Empty : 
                                                string.IsNullOrEmpty(ListCarriercmb.FirstOrDefault(x => x.ToLower().Contains(t.ToLower()))) ? string.Empty :
                                                ListCarriercmb.FirstOrDefault(x => x.ToLower().Contains(t.ToLower()))"
                                              Label="Search" />
                                </MudItem>
                                <MudItem xs="8">
                                    <MudSelect Dense="true" T="string" Label="Carrier/Col"
                                               AnchorOrigin="Origin.BottomCenter"
                                               Variant="Variant.Text"
                                               @bind-Value="In_BoundDetail.ShippingLine">
                                        @if (ListCarriercmb != null)
                                        @foreach (var item in ListCarriercmb)
                                            {
                                                <MudSelectItem Value="item">@item</MudSelectItem>
                                            }
                                    </MudSelect>
                                </MudItem>
                            </MudGrid>

                            <MudGrid Justify="Justify.FlexStart">
                                <MudItem xs="4">
                                    <MudTextField T="string"
                                                  Immediate="true"
                                                  Mask="@(new RegexMask(@"^[a-zA-Z0-9_.-]*$"))"
                                              TextChanged="(t) => In_BoundDetail.ops = string.IsNullOrEmpty(t) ? string.Empty : 
                                                string.IsNullOrEmpty(ListOPScmb.FirstOrDefault(x => x.ToLower().Contains(t.ToLower()))) ? string.Empty :
                                                    ListOPScmb.FirstOrDefault(x => x.ToLower().Contains(t.ToLower()))"
                                                  Label="Search" />
                                </MudItem>
                                <MudItem xs="8">
                                    <MudSelect Dense="true" T="string" Label="OPS"
                                               AnchorOrigin="Origin.BottomCenter"
                                               Variant="Variant.Text"
                                               @bind-Value="In_BoundDetail.ops">
                                        @if (ListOPScmb != null)
                                            @foreach (var item in ListOPScmb)
                                            {
                                                <MudSelectItem Value="item">@item</MudSelectItem>
                                            }
                                    </MudSelect>
                                </MudItem>
                            </MudGrid>

                            <MudTextField @bind-Value="In_BoundDetail.BL_TYPE"
                                          For="@(() => In_BoundDetail.BL_TYPE)"
                                          Immediate="true"
                                          Label="B/L Type" />

                            <MudTextField @bind-Value="In_BoundDetail.CY_CFS_ITEM"
                                          For="@(() => In_BoundDetail.CY_CFS_ITEM)"
                                          Immediate="true"
                                          Label="Terms" />


                            <MudTextField @bind-Value="In_BoundDetail.tkhq"
                                      For="@(() => In_BoundDetail.tkhq)"
                                          Immediate="true"
                                          Label="Customs (TKHQ)" />

                            <MudTextField @bind-Value="In_BoundDetail.ngayhttthq"
                                      For="@(() => In_BoundDetail.ngayhttthq)"
                                          Immediate="true"
                                          Label="Date (TKHQ)" />

                            <MudTextField @bind-Value="In_BoundDetail.quotationno"
                                      For="@(() => In_BoundDetail.quotationno)"
                                          Immediate="true"
                                      Label="Quotation No." />

                            <MudGrid Justify="Justify.FlexStart">
                                <MudItem xs="4">
                                    <MudTextField T="string"
                                                  Immediate="true"
                                                  Mask="@(new RegexMask(@"^[a-zA-Z0-9_.-]*$"))"
                                              TextChanged="(t) => In_BoundDetail.macangFCL = string.IsNullOrEmpty(t) ? string.Empty : 
                                                string.IsNullOrEmpty(ListPortandWHcmb.FirstOrDefault(x => x.ToLower().Contains(t.ToLower()))) ? string.Empty:
                                                ListPortandWHcmb.FirstOrDefault(x => x.ToLower().Contains(t.ToLower()))"
                                                  Label="Search" />
                                </MudItem>
                                <MudItem xs="8">
                                <MudSelect Dense="true" T="string" Label="Port(Mã cảng)"
                                               AnchorOrigin="Origin.BottomCenter"
                                               Variant="Variant.Text"
                                               @bind-Value="In_BoundDetail.macangFCL">
                                        @if (ListPortandWHcmb != null)
                                        @foreach (var item in ListPortandWHcmb)
                                            {
                                                <MudSelectItem Value="item">@item</MudSelectItem>
                                            }
                                    </MudSelect>
                                </MudItem>
                            </MudGrid>
                            <MudGrid Justify="Justify.FlexStart">
                                <MudItem xs="4">
                                    <MudTextField T="string"
                                                  Immediate="true"
                                                  Mask="@(new RegexMask(@"^[a-zA-Z0-9_.-]*$"))"
                                                TextChanged="(t) => In_BoundDetail.KHO = string.IsNullOrEmpty(t) ? string.Empty :
                                                string.IsNullOrEmpty(ListPortandWHcmb.FirstOrDefault(x => x.ToLower().Contains(t.ToLower()))) ? string.Empty :
                                                ListPortandWHcmb.FirstOrDefault(x => x.ToLower().Contains(t.ToLower()))"
                                                Label="Search" />
                                </MudItem>
                                <MudItem xs="8">
                                    <MudSelect Dense="true" T="string" Label="W.h(Mã kho)"
                                               AnchorOrigin="Origin.BottomCenter"
                                               Variant="Variant.Text"
                                               @bind-Value="In_BoundDetail.KHO">
                                        @if (ListPortandWHcmb != null)
                                            @foreach (var item in ListPortandWHcmb)
                                            {
                                                <MudSelectItem Value="item">@item</MudSelectItem>
                                            }
                                    </MudSelect>
                                </MudItem>
                            </MudGrid>

                            <MudSelect Dense="true" T="string" Label="Fre/Nomi"
                                           AnchorOrigin="Origin.BottomCenter"
                                           Variant="Variant.Text"
                                           @bind-Value="In_BoundDetail.KgAvailable">
                                        <MudSelectItem Value="@("FREEHAND")">FREEHAND</MudSelectItem>
                                        <MudSelectItem Value="@("NOMINATE")">NOMINATE</MudSelectItem>
                            </MudSelect>

                            <MudSelect Dense="true" T="string" Label="Loại Hàng"
