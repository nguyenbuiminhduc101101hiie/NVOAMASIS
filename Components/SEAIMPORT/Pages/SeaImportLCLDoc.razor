        else if(Type == "I")
            s = MudBlazor.Severity.Info;
        else if(Type == "W")
            s = MudBlazor.Severity.Warning;
        else if(Type == "E")
            s = MudBlazor.Severity.Error;
        Snackbar.Configuration.SnackbarVariant = Variant.Filled;
