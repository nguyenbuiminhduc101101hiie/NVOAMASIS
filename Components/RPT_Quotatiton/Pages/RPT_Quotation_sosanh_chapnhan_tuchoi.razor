@using MudBlazor
@using System.Globalization
@using System.Linq
@using MudBlazor.Components
@attribute [Authorize]
@inject GlobalServices gsv
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject AccountService asv
@inject SharedServices ssv
@inject BookingService bksv
@inject IJSRuntime JSRuntime
@inject SupportServices supsv
@inject IStringLocalizer<SharedResource> Localizer
@inject LocalChargesServices lcsv
@inject CustomerService Cussv
@inject PhieuThu_Chi_Services thuchisv
@inject ReportServices rpsv
@inject QuotationService Quosv
@inject IJSRuntime JSRuntime

<PageTitle>@Localizer["RPT_Quotatiton_Accpet_Deny"] </PageTitle>
<MudText Class="pa-2" Typo="Typo.h6">@Localizer["RPT_Quotatiton_Accpet_Deny"]</MudText>


<MudGrid Class="pa-6">
    <!-- Picker chiếm 4/12 cột -->
    <MudItem xs="4">
        <MudDateRangePicker Label="@Localizer["searchdatefromto"]"
                            @bind-DateRange="_dateRange" />
    </MudItem>

    <!-- Button chiếm 3/12 cột -->
    <MudItem xs="2">
        <MudButton HtmlTag="label"
                   OnClick="Search"
                   Size="Size.Small"
                   Color="Color.Primary"
                   Variant="Variant.Filled"
                   StartIcon="@Icons.Material.Filled.Refresh">
            @Localizer["Search"]
        </MudButton>
    </MudItem>

    <!-- From Month -->
    <MudItem xs="1">
        <MudSelect T="int" Label="Từ tháng" @bind-Value="fromThang" Dense="true">
            @foreach (var m in Months)
            {
                <MudSelectItem T="int" Value="m">@m</MudSelectItem>
            }
        </MudSelect>
    </MudItem>

    <!-- From Year -->
    <MudItem xs="1">
        <MudSelect T="int" Label="Từ năm" @bind-Value="fromNam" Dense="true">
            @foreach (var y in Years)
            {
                <MudSelectItem T="int" Value="y">@y</MudSelectItem>
            }
        </MudSelect>
    </MudItem>

    <MudItem xs="1">
        <MudSelect T="int" Label="Đến tháng" @bind-Value="toThang" Dense="true">
            @foreach (var m in Months)
            {
                <MudSelectItem T="int" Value="m">@m</MudSelectItem>
            }
        </MudSelect>
    </MudItem>

    <!-- To Year -->
    <MudItem xs="1">
        <MudSelect T="int" Label="Đến năm" @bind-Value="toNam" Dense="true">
            @foreach (var y in Years)
            {
                <MudSelectItem T="int" Value="y">@y</MudSelectItem>
            }
        </MudSelect>
    </MudItem>

    <MudItem xs="2">
        <MudButton HtmlTag="label"
                   OnClick="Search_By_months"
                   Size="Size.Small" Color="Color.Primary" Variant="   Variant.Filled"
                   StartIcon="@Icons.Material.Filled.Refresh">
            @Localizer["Search Months"]
        </MudButton>
    </MudItem>

</MudGrid>


<MudContainer MaxWidth="MudBlazor.MaxWidth.False" Class="mt-4">
    <MudGrid>
        <!-- Phần bên trái: Report -->
        <MudItem xs="12">
            <MudDataGrid T="M_Quotation" Items="@Listdata" Bordered="true" Striped="true" Hover="true">

                <Columns>
                    <PropertyColumn Property="x => x.quotationNo" Title="@Localizer["QuotationNo"]" CellStyleFunc="_cellStyleFunc" />

                    <PropertyColumn Property="x => CustomerName(x.customer_id)" Title="Customer" CellStyleFunc="_cellStyleFunc">
                        <EditTemplate>
                            <MudSelect @bind-Value="context.Item.customer_id" Label="Customer">
                                @foreach (var item in CustomerList)
                                {
                                    <MudSelectItem Value="@item.Customer_ID">@item.COMPANY</MudSelectItem>
                                }
                            </MudSelect>
                        </EditTemplate>
                    </PropertyColumn>

                    <PropertyColumn Property="x => x.BookingNo" Title="@Localizer["BookingNo"]" CellStyleFunc="_cellStyleFunc" />

                    <PropertyColumn Property="x => x.o1" Title="@(Localizer["Group1"])" CellStyleFunc="_cellStyleFunc">
                        <FooterTemplate>
                            @Localizer["Group1"]
                        </FooterTemplate>
                    </PropertyColumn>

                    <PropertyColumn Property="x => x.o2" Title="@(Localizer["Group2"])" CellStyleFunc="_cellStyleFunc">
                        <FooterTemplate>
                            @Localizer["Group2"]
                        </FooterTemplate>
                    </PropertyColumn>

                    <PropertyColumn Property="x => x.o3" Title="@(Localizer["Group3"])" CellStyleFunc="_cellStyleFunc">
                        <FooterTemplate>
