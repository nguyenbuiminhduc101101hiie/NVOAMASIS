                        </FooterTemplate>
                    </PropertyColumn>

                    <PropertyColumn Property="x => x.o4" Title="@(Localizer["Group4"])" CellStyleFunc="_cellStyleFunc">
                        <FooterTemplate>
                            @Localizer["Group4"]
                        </FooterTemplate>
                    </PropertyColumn>

                    <PropertyColumn Property="x => x.terms" Title="@(Localizer["Terms"])" CellStyleFunc="_cellStyleFunc">
                        <FooterTemplate>
                            @Localizer["Terms"]
                        </FooterTemplate>
                    </PropertyColumn>

                    <PropertyColumn Property="x => x.type" Title="@(Localizer["Type"])" CellStyleFunc="_cellStyleFunc">
                        <FooterTemplate>
                            @Localizer["Type"]
                        </FooterTemplate>
                    </PropertyColumn>

                    <PropertyColumn Property="x => x.pol" Title="@(Localizer["POL"])" CellStyleFunc="_cellStyleFunc">
                        <FooterTemplate>
                            @Localizer["POL"]
                        </FooterTemplate>
                    </PropertyColumn>

                    <PropertyColumn Property="x => x.pod" Title="@(Localizer["POD"])" CellStyleFunc="_cellStyleFunc">
                        <FooterTemplate>
