                        </FooterTemplate>
                    </PropertyColumn>

                    <PropertyColumn Property="x => x.frequency" Title="@(Localizer["Frequency"])" CellStyleFunc="_cellStyleFunc">
                        <FooterTemplate>
                            @Localizer["Frequency"]
                        </FooterTemplate>
                    </PropertyColumn>

                    <PropertyColumn Property="x => x.Routing" Title="@(Localizer["Routing"])" CellStyleFunc="_cellStyleFunc">
