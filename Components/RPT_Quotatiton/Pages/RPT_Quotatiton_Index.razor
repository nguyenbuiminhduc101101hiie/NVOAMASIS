@using MudBlazor
@using System.Globalization
@using System.Linq
@using MudBlazor.Components
@attribute [Authorize]
@inject GlobalServices gsv
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject AccountService asv
@inject SharedServices ssv
@inject BookingService bksv
@inject IJSRuntime JSRuntime
@inject SupportServices supsv
@inject IStringLocalizer<SharedResource> Localizer
@inject LocalChargesServices lcsv
@inject CustomerService Cussv
@inject PhieuThu_Chi_Services thuchisv
@inject ReportServices rpsv
@inject QuotationService Quosv
@inject IJSRuntime JSRuntime

<PageTitle>@Localizer["RPT_Quotatiton"] </PageTitle>
<MudText Class="pa-2" Typo="Typo.h6">@Localizer["RPT_Quotatiton"]</MudText>


<MudGrid Class="pa-6">
    <!-- Picker chiếm 4/12 cột -->
    <MudItem xs="4">
        <MudDateRangePicker Label="@Localizer["searchdatefromto"]"
                            @bind-DateRange="_dateRange" />
    </MudItem>

    <!-- Button chiếm 3/12 cột -->
    <MudItem xs="2">
        <MudButton HtmlTag="label"
                   OnClick="Search"
                   Size="Size.Small"
                   Color="Color.Primary"
                   Variant="Variant.Filled"
                   StartIcon="@Icons.Material.Filled.Refresh">
            @Localizer["Search"]
        </MudButton>
    </MudItem>

    <!-- From Month -->
    <MudItem xs="1">
        <MudSelect T="int" Label="Từ tháng" @bind-Value="fromThang" Dense="true">
            @foreach (var m in Months)
            {
                <MudSelectItem T="int" Value="m">@m</MudSelectItem>
            }
        </MudSelect>
    </MudItem>

    <!-- From Year -->
    <MudItem xs="1">
        <MudSelect T="int" Label="Từ năm" @bind-Value="fromNam" Dense="true">
            @foreach (var y in Years)
            {
                <MudSelectItem T="int" Value="y">@y</MudSelectItem>
            }
        </MudSelect>
    </MudItem>

    <MudItem xs="1">
        <MudSelect T="int" Label="Đến tháng" @bind-Value="toThang" Dense="true">
            @foreach (var m in Months)
            {
                <MudSelectItem T="int" Value="m">@m</MudSelectItem>
            }
        </MudSelect>
    </MudItem>

    <!-- To Year -->
    <MudItem xs="1">
        <MudSelect T="int" Label="Đến năm" @bind-Value="toNam" Dense="true">
            @foreach (var y in Years)
            {
                <MudSelectItem T="int" Value="y">@y</MudSelectItem>
            }
        </MudSelect>
    </MudItem>

    <MudItem xs="2">
        <MudButton HtmlTag="label"
        OnClick="Search_By_months"
        Size="Size.Small" Color="Color.Primary" Variant="   Variant.Filled"
        StartIcon="@Icons.Material.Filled.Refresh">
            @Localizer["Search_Months"]
        </MudButton>
    </MudItem>

    <MudItem xs="12">
        <MudRadioGroup T="int" @bind-SelectedOption="_selectedOption">
            <MudRadio Value="1" Color="Color.Primary" UnCheckedColor="Color.Default">@Localizer["RPT_QUO_1"]</MudRadio>
            <MudRadio Value="2" Color="Color.Secondary" UnCheckedColor="Color.Default">@Localizer["RPT_QUO_2"]</MudRadio>
            <MudRadio Value="3" Color="Color.Success" UnCheckedColor="Color.Error">@Localizer["RPT_QUO_3"]</MudRadio>
        </MudRadioGroup>
    </MudItem>
</MudGrid>


<MudContainer MaxWidth="MudBlazor.MaxWidth.False" Class="mt-4">
    <MudGrid>
        <!-- Phần bên trái: Report -->
        <MudItem xs="12">
            <MudDataGrid T="M_Quotation" Items="@Listdata" Bordered="true" Striped="true" Hover="true" Loading="_loading">

                <Columns>
                    
                         <TemplateColumn Title="STT">
                            <CellTemplate>
                                @{
                                    var index = Listdata.IndexOf(context.Item) + 1;
                                    @index
                                }
                            </CellTemplate>
                        <FooterTemplate>
                            @Localizer["no"]  <!-- Tùy chỉnh phần footer -->
                        </FooterTemplate>
                        </TemplateColumn>
                       
                  
                    
                    <PropertyColumn Property="x => CustomerName(x.customer_id)" Title="@Localizer["Customer"]" CellStyleFunc="_cellStyleFunc">
                        <EditTemplate>
                            <MudSelect @bind-Value="context.Item.customer_id" Label="@Localizer["Customer"]">
                                @foreach (var item in CustomerList)
                                {
                                    <MudSelectItem Value="@item.Customer_ID">@item.COMPANY</MudSelectItem>
                                }
                            </MudSelect>
                        </EditTemplate>
                        <FooterTemplate>
                            @Localizer["Customer"]
                        </FooterTemplate>
                    </PropertyColumn>

                    <PropertyColumn Property="x => x.status" Title="@Localizer["status"]" CellStyleFunc="_cellStyleFunc">
                        <FooterTemplate>
                            @Localizer["status"]
                        </FooterTemplate>
                    </PropertyColumn>


                    <PropertyColumn Property="x => x.BookingNo" Title="@Localizer["BookingNo"]" CellStyleFunc="_cellStyleFunc" >
                        <FooterTemplate>
                            @Localizer["BookingNo"]
                        </FooterTemplate>
                    </PropertyColumn>

                    <PropertyColumn Property="x => x.o1" Title="@(Localizer["Group1"])" CellStyleFunc="_cellStyleFunc">
                        <FooterTemplate>
                            @Localizer["Group1"]
                        </FooterTemplate>
                    </PropertyColumn>

                    <PropertyColumn Property="x => x.o2" Title="@(Localizer["Group2"])" CellStyleFunc="_cellStyleFunc">
                        <FooterTemplate>
                            @Localizer["Group2"]
                        </FooterTemplate>
                    </PropertyColumn>

                    <PropertyColumn Property="x => x.o3" Title="@(Localizer["Group3"])" CellStyleFunc="_cellStyleFunc">
                        <FooterTemplate>
                            @Localizer["Group3"]
                        </FooterTemplate>
                    </PropertyColumn>

                    <PropertyColumn Property="x => x.o4" Title="@(Localizer["Group4"])" CellStyleFunc="_cellStyleFunc">
                        <FooterTemplate>
                            @Localizer["Group4"]
                        </FooterTemplate>
                    </PropertyColumn>

                    <PropertyColumn Property="x => x.terms" Title="@(Localizer["Terms"])" CellStyleFunc="_cellStyleFunc">
                        <FooterTemplate>
                            @Localizer["Terms"]
                        </FooterTemplate>
                    </PropertyColumn>

                    <PropertyColumn Property="x => x.type" Title="@(Localizer["Type"])" CellStyleFunc="_cellStyleFunc">
                        <FooterTemplate>
                            @Localizer["Type"]
                        </FooterTemplate>
                    </PropertyColumn>

                    <PropertyColumn Property="x => x.pol" Title="@(Localizer["POL"])" CellStyleFunc="_cellStyleFunc">
                        <FooterTemplate>
                            @Localizer["POL"]
                        </FooterTemplate>
                    </PropertyColumn>

                    <PropertyColumn Property="x => x.pod" Title="@(Localizer["POD"])" CellStyleFunc="_cellStyleFunc">
                        <FooterTemplate>
                            @Localizer["POD"]
                        </FooterTemplate>
                    </PropertyColumn>

                    <PropertyColumn Property="x => x.TransitTime" Title="@(Localizer["TransitTime"])" CellStyleFunc="_cellStyleFunc">
                        <FooterTemplate>
                            @Localizer["TransitTime"]
                        </FooterTemplate>
                    </PropertyColumn>

                    <PropertyColumn Property="x => x.Transitport" Title="@(Localizer["Transitport"])" CellStyleFunc="_cellStyleFunc">
                        <FooterTemplate>
                            @Localizer["Transitport"]
                        </FooterTemplate>
                    </PropertyColumn>

                    <PropertyColumn Property="x => x.shippingline" Title="@(Localizer["Shippingline"])" CellStyleFunc="_cellStyleFunc">
                        <FooterTemplate>
                            @Localizer["Shippingline"]
                        </FooterTemplate>
                    </PropertyColumn>

                    <PropertyColumn Property="x => x.frequency" Title="@(Localizer["Frequency"])" CellStyleFunc="_cellStyleFunc">
                        <FooterTemplate>
                            @Localizer["Frequency"]
                        </FooterTemplate>
                    </PropertyColumn>

                    <PropertyColumn Property="x => x.Routing" Title="@(Localizer["Routing"])" CellStyleFunc="_cellStyleFunc">
                        <FooterTemplate>
                            @Localizer["Routing"]
                        </FooterTemplate>
                    </PropertyColumn>

                    <PropertyColumn Property="x => x.SaleName" Title="@(Localizer["SaleName"])" CellStyleFunc="_cellStyleFunc">
                        <FooterTemplate>
                            @Localizer["SaleName"]
                        </FooterTemplate>
                    </PropertyColumn>

                    <PropertyColumn Property="x => x.remarks" Title="@(Localizer["Remarks"])" CellStyleFunc="_cellStyleFunc">
                        <FooterTemplate>
                            @Localizer["Remarks"]
                        </FooterTemplate>
                    </PropertyColumn>

                    <PropertyColumn Property="x => x.validDate" Title="@(Localizer["ValidDate"])" CellStyleFunc="_cellStyleFunc">
                        <FooterTemplate>
                            @Localizer["ValidDate"]
                        </FooterTemplate>
                    </PropertyColumn>


                    <PropertyColumn Property="x => x.userupdate" Title="@(Localizer["Userupdate"])" CellStyleFunc="_cellStyleFunc">
                        <FooterTemplate>
                            @Localizer["Userupdate"]
                        </FooterTemplate>
                    </PropertyColumn>


                    <PropertyColumn Property="x => x.dateupdate" Title="@(Localizer["Dateupdate"])" CellStyleFunc="_cellStyleFunc">
                        <FooterTemplate>
                            @Localizer["Dateupdate"]
                        </FooterTemplate>
                    </PropertyColumn>


                    <PropertyColumn Property="x => x.MasterColoader" Title="@(Localizer["MasterColoader"])" CellStyleFunc="_cellStyleFunc">
                        <FooterTemplate>
                            @Localizer["MasterColoader"]
                        </FooterTemplate>
                    </PropertyColumn>

                    <PropertyColumn Property="x => x.ETD" Title="@(Localizer["ETD"])" CellStyleFunc="_cellStyleFunc">
                        <FooterTemplate>
                            @Localizer["ETD"]
                        </FooterTemplate>
                    </PropertyColumn>

                    <PropertyColumn Property="x => x.ETA" Title="@(Localizer["ETA"])" CellStyleFunc="_cellStyleFunc">
                        <FooterTemplate>
                            @Localizer["ETA"]
                        </FooterTemplate>
                    </PropertyColumn>
                </Columns>

                <PagerContent>
                    <MudDataGridPager T="M_Quotation" PageSizeOptions="@(new int[] { 8, 10, 20 })" />
                </PagerContent>
            </MudDataGrid>
        </MudItem>


        <MudGrid Justify="Justify.Center">
            <MudItem xs="6">
                <div style="background-color:papayawhip; padding: 16px; border-radius: 8px;">
                    <MudChart ChartType="ChartType.Bar" ChartSeries="@Series" XAxisLabels="@XAxisLabels" Width="100%" Height="350px" ChartOptions="@options">
                      
                    </MudChart>
                </div>
            </MudItem>
        </MudGrid>

    </MudGrid>
</MudContainer>

@code {
    private DateRange _dateRange = new DateRange(DateTime.Now.Date, DateTime.Now.AddDays(5).Date);
    private List<M_Quotation> Listdata = new();
    private List<M_Customer> List_Cus = new List<M_Customer>();

    private bool _processingUpload = false;
    public CultureInfo _en = CultureInfo.GetCultureInfo("en-US");
    // Selected values
    private int fromThang;
    private int fromNam;
    private int toThang;
    private int toNam;
    private string type_search;
    // Data sources
    private readonly int[] Months = Enumerable.Range(1, 12).ToArray();
    private List<Models.M_Customer> CustomerList = new List<Models.M_Customer>();
    // Ví dụ: năm từ 2020 đến 2030
    private readonly int[] Years = Enumerable.Range(2020, 11).ToArray();
    private int _selectedOption = 1;

    protected async override Task OnInitializedAsync()
    {
        CustomerList = await Cussv.GetList();
        List_Cus = await Cussv.GetList();
        M_Trangthais = await supsv.GetListTrangThai();
        var tts = await supsv.GetListTrangThai();
        trangthais = tts.Where(x => x.Tieude == "Quo").OrderBy(x => x.Noidung).Select(x => x.Noidung).ToList();
    }
    public class RFQCountByMonthAndStatus
    {
        public string MonthYear { get; set; } // ví dụ: "03/2025"
        public string Status { get; set; }    // ví dụ: "Open", "Closed"
        public int Count { get; set; }
    }


    bool _loading = false;
    List<string> trangthais = new List<string>();
    private List<Models.TrangThai> M_Trangthais = new List<Models.TrangThai>();
    private double[] PieData = Array.Empty<double>();
    private string[] PieLabels = Array.Empty<string>();

    private ChartOptions options = new ChartOptions
        {
            InterpolationOption = InterpolationOption.NaturalSpline,
            YAxisFormat = "#,##0"
        };
    // public List<ChartSeries> Series = new List<ChartSeries>()
    // {
    //     new ChartSeries() { Name = "Series 1", Data = new double[] { 90, 79, 72, 69, 62, 62, 55, 65, 70 } },
    //     new ChartSeries() { Name = "Series 2", Data = new double[] { 35, 41, 35, 51, 49, 62, 69, 91, 148 } },
    // };
    // public string[] XAxisLabels = { "Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep" };
    public List<ChartSeries> Series = new();
    public string[] XAxisLabels = Array.Empty<string>();
    Random random = new Random();
    object chartOptions = new
    {
        yaxis = new
        {
            tickAmount = 5, // hiển thị 5 giá trị trục Y: ví dụ 0, 10, 20, 30, 40
            labels = new
            {
                formatter = new Func<double, string>(value => $"{value:0}")
            }
        }
    };
    async Task Search()
    {

        _loading = true;
        type_search = "search";
        var startDate = _dateRange.Start.Value;
        var endDate = _dateRange.End.Value;

        if (startDate != null && endDate != null)
        {
            // Xóa dữ liệu cũ
            if (_selectedOption == 1)
            {
                Listdata = await Quosv.GetReport_Quo_dagui(startDate, endDate);
                if(Listdata.Count ==0)
                {
                    CallSnackBar("No Data", MudBlazor.Severity.Warning);
                    _loading = false;
                    return;
                }
                var totalQuantity = Listdata.Count;

                // Thêm 2 tháng ảo vào đầu và cuối
                var first = startDate; // Không cần sử dụng .Value nếu startDate là DateTime
                var last = endDate; // Không cần sử dụng .Value nếu endDate là DateTime

                // Tạo các tháng ảo trước và sau
                DateTime prev = first.AddMonths(-1);
                DateTime next = last.AddMonths(1);

                // Tạo dữ liệu với các cột "ảo"
                var seriesData = new List<double> { 0, (double)totalQuantity, 0 };  // Các giá trị 0 cho tháng "ảo"

                // Tạo nhãn trục X (không có các tháng "ảo" - chỉ hiển thị tháng thực tế)
                var xAxisLabels = new string[] { $"{first:MM/dd/yyyy} - {last:MM/dd/yyyy}" };

                // Gán dữ liệu cho Series
                Series = new List<ChartSeries>
            {
                new ChartSeries
                {
                    Name = "SL Quotation",
                    Data = seriesData.ToArray()
                }
            };

                // Gán nhãn trục X chỉ có tháng thực tế
                XAxisLabels = xAxisLabels;
            }
            else if (_selectedOption == 2)
            {
                Listdata = await Quosv.GetReport_Quo_accept_Deny(startDate, endDate);
                // Nhóm theo Status, loại bỏ Status null hoặc rỗng
                var groupedData = Listdata
                    .Where(x => !string.IsNullOrEmpty(x.status))
                    .GroupBy(x => x.status)
                    .OrderBy(g => g.Key)
                    .ToList();

                // Tạo dữ liệu biểu đồ với 2 cột ảo (đầu và cuối)
                var seriesData = new List<double> { 0 };     // Cột ảo đầu
                var xAxisLabels = new List<string> { "" };   // Nhãn ảo đầu

                foreach (var group in groupedData)
                {
                    seriesData.Add(group.Count());           // Thêm số lượng theo từng Status
                    xAxisLabels.Add(group.Key);              // Thêm nhãn là Status
                }

                seriesData.Add(0);      // Cột ảo cuối
                xAxisLabels.Add("");    // Nhãn ảo cuối

                // Gán vào biểu đồ
                Series = new List<ChartSeries>
                {
                    new ChartSeries
                    {
                        Name = "Số lượng theo Status",
                        Data = seriesData.ToArray()
                    }
                };

                XAxisLabels = xAxisLabels.ToArray();
            }
            else if(_selectedOption==3)
            {
                // Lấy dữ liệu
                Listdata = await Quosv.GetReport_Quo_toBK(startDate, endDate);
                int SL = await Quosv.GetReport_SL_Quo_ALL(startDate, endDate);
                int totalQuantity = Listdata.Count;

                // Tính tỷ lệ %
                double percent = SL == 0 ? 0 : (double)totalQuantity / SL * 100;

                // Thêm 2 tháng ảo vào đầu và cuối
                var first = startDate;
                var last = endDate;

                DateTime prev = first.AddMonths(-1);
                DateTime next = last.AddMonths(1);

                // Dữ liệu biểu đồ dạng phần trăm, 2 cột ảo đầu/cuối là 0
                var seriesData = new List<double> { 0, percent, 0 };

                // Nhãn trục X
                var xAxisLabels = new string[] { $"{first:MM/dd/yyyy} - {last:MM/dd/yyyy}" };

                // Gán series
                Series = new List<ChartSeries>
                {
                    new ChartSeries
                    {
                        Name = "Tỷ lệ Quotation To BK (%)",
                        Data = seriesData.ToArray()
                    }
                };

                XAxisLabels = xAxisLabels;
            }
            _loading = false;

        }
        else
        {
            _loading = false;
            CallSnackBar("Select Date Time Range", MudBlazor.Severity.Warning);
            return;
        }
    }
    async Task Search_By_months()
    {
        type_search = "search_month";
        _loading = true;
        if (fromThang != null && fromNam != null && toThang != null && toNam != null && fromThang != 0 && fromNam != 0 && toThang != 0 && toNam != 0)
        {
            if (_selectedOption == 1)
            {
                Listdata = await Quosv.GetReport_Quo_dagui_by_month(fromThang, fromNam, toThang, toNam);
                // 2. Danh sách tất cả các tháng/năm có trong dữ liệu
                var allMonthYears = Listdata
                    .Where(x => x.validDate.HasValue)
                    .Select(x => new
                    {
                        Year = x.validDate.Value.Year,
                        Month = x.validDate.Value.Month
                    })
                    .Distinct()
                    .OrderBy(x => x.Year)
                    .ThenBy(x => x.Month)
                    .Select(x => $"{x.Month:D2}/{x.Year}")
                    .ToList();

                if (allMonthYears.Count < 3 && allMonthYears.Count >0)
                {
                    // Lấy tháng đầu tiên và cuối cùng để thêm tháng ảo trước/sau
                    var first = allMonthYears.First();
                    var last = allMonthYears.Last();

                    // Parse tháng đầu tiên
                    var firstParts = first.Split('/');
                    int firstMonth = int.Parse(firstParts[0]);
                    int firstYear = int.Parse(firstParts[1]);
                    DateTime prev = new DateTime(firstYear, firstMonth, 1).AddMonths(-1);
                    allMonthYears.Insert(0, $"{prev.Month:D2}/{prev.Year}");

                    // Parse tháng cuối cùng
                    var lastParts = last.Split('/');
                    int lastMonth = int.Parse(lastParts[0]);
                    int lastYear = int.Parse(lastParts[1]);
                    DateTime next = new DateTime(lastYear, lastMonth, 1).AddMonths(1);
                    allMonthYears.Add($"{next.Month:D2}/{next.Year}");
                }

                var rawData = allMonthYears.Select(monthYear =>
                {
                    var parts = monthYear.Split('/');
                    int month = int.Parse(parts[0]);
                    int year = int.Parse(parts[1]);

                    return Listdata.Count(x =>
                        x.validDate.HasValue &&
                        x.validDate.Value.Month == month &&
                        x.validDate.Value.Year == year);
                }).ToList();


                // 4. Tạo series tổng số lượng theo từng tháng
                Series = new List<ChartSeries>
                {
                    new ChartSeries
                    {
                        Name = "SL Quotation",
                        Data = rawData.Select(x => (double)x).ToArray()
                    }
                };


                XAxisLabels = allMonthYears.ToArray();
            }
            else if(_selectedOption==2)
            {
                Listdata = await Quosv.GetReport_Quo_accept_deny_by_month(fromThang, fromNam, toThang, toNam);
                var allMonthYears = Listdata
                    .Where(x => x.validDate.HasValue)
                    .Select(x => new
                    {
                        Year = x.validDate.Value.Year,
                        Month = x.validDate.Value.Month
                    })
                    .Distinct()
                    .OrderBy(x => x.Year)
                    .ThenBy(x => x.Month)
                    .Select(x => $"{x.Month:D2}/{x.Year}")
                    .ToList();

                // Thêm tháng ảo nếu cần
                if (allMonthYears.Count < 3 && allMonthYears.Count > 0)
                {
                    var first = allMonthYears.First();
                    var last = allMonthYears.Last();

                    var firstParts = first.Split('/');
                    int firstMonth = int.Parse(firstParts[0]);
                    int firstYear = int.Parse(firstParts[1]);
                    DateTime prev = new DateTime(firstYear, firstMonth, 1).AddMonths(-1);
                    allMonthYears.Insert(0, $"{prev.Month:D2}/{prev.Year}");

                    var lastParts = last.Split('/');
                    int lastMonth = int.Parse(lastParts[0]);
                    int lastYear = int.Parse(lastParts[1]);
                    DateTime next = new DateTime(lastYear, lastMonth, 1).AddMonths(1);
                    allMonthYears.Add($"{next.Month:D2}/{next.Year}");
                }

                // Lấy danh sách tất cả các status có trong dữ liệu
                var allStatuses = Listdata
                    .Where(x => !string.IsNullOrEmpty(x.status))
                    .Select(x => x.status)
                    .Distinct()
                    .ToList();

                // Tạo series cho từng Status
                var seriesList = new List<ChartSeries>();

                foreach (var status in allStatuses)
                {
                    var data = allMonthYears.Select(monthYear =>
                    {
                        var parts = monthYear.Split('/');
                        int month = int.Parse(parts[0]);
                        int year = int.Parse(parts[1]);

                        return Listdata.Count(x =>
                            x.validDate.HasValue &&
                            x.validDate.Value.Month == month &&
                            x.validDate.Value.Year == year &&
                            x.status == status);
                    }).Select(count => (double)count).ToArray();

                    seriesList.Add(new ChartSeries
                        {
                            Name = status,
                            Data = data
                        });
                }

                Series = seriesList;
                XAxisLabels = allMonthYears.ToArray();
            }
            else if (_selectedOption == 3)
            {
                Listdata = await Quosv.GetReport_Quo_toBK_by_month(fromThang, fromNam, toThang, toNam);
                var allQuotation = await Quosv.GetReport_SL_Quo_ALL_by_month(fromThang, fromNam, toThang, toNam);

                // Danh sách tất cả các tháng/năm từ cả 2 nguồn
                var allMonthYears = allQuotation
                    .Where(x => x.validDate.HasValue)
                    .Select(x => new { x.validDate.Value.Year, x.validDate.Value.Month })
                    .Distinct()
                    .OrderBy(x => x.Year)
                    .ThenBy(x => x.Month)
                    .Select(x => $"{x.Month:D2}/{x.Year}")
                    .ToList();

                // Thêm tháng ảo nếu cần
                if (allMonthYears.Count < 3 && allMonthYears.Count > 0)
                {
                    var first = allMonthYears.First();
                    var last = allMonthYears.Last();

                    var firstParts = first.Split('/');
                    int firstMonth = int.Parse(firstParts[0]);
                    int firstYear = int.Parse(firstParts[1]);
                    DateTime prev = new DateTime(firstYear, firstMonth, 1).AddMonths(-1);
                    allMonthYears.Insert(0, $"{prev.Month:D2}/{prev.Year}");

                    var lastParts = last.Split('/');
                    int lastMonth = int.Parse(lastParts[0]);
                    int lastYear = int.Parse(lastParts[1]);
                    DateTime next = new DateTime(lastYear, lastMonth, 1).AddMonths(1);
                    allMonthYears.Add($"{next.Month:D2}/{next.Year}");
                }

                // Tính phần trăm theo từng tháng
                var percentData = allMonthYears.Select(monthYear =>
                {
                    var parts = monthYear.Split('/');
                    int month = int.Parse(parts[0]);
                    int year = int.Parse(parts[1]);

                    int totalInMonth = allQuotation.Count(x => x.validDate.HasValue && x.validDate.Value.Month == month && x.validDate.Value.Year == year);
                    int toBKInMonth = Listdata.Count(x => x.validDate.HasValue && x.validDate.Value.Month == month && x.validDate.Value.Year == year);

                    double percent = totalInMonth == 0 ? 0 : (double)toBKInMonth / totalInMonth * 100;
                    return percent;
                }).ToList();

                // Gán series phần trăm
                Series = new List<ChartSeries>
                {
                    new ChartSeries
                    {
                        Name = "Tỷ lệ Quotation To BK (%)",
                        Data = percentData.ToArray()
                    }
                };

                // Gán nhãn trục X
                XAxisLabels = allMonthYears.ToArray();

            }
            _loading = false;
        }
        else
        {
             _loading = false;
            CallSnackBar("Select Date Time Range", MudBlazor.Severity.Warning);
            return;
        }

    }

    void CallSnackBar(string message, MudBlazor.Severity severity)
    {

        Snackbar.Configuration.SnackbarVariant = Variant.Filled;
        Snackbar.Configuration.MaxDisplayedSnackbars = 3;
        Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopRight;
        Snackbar.Add(message, severity);
    }

    string CustomerName(Guid? customerID)
    {
        var rs = List_Cus.FirstOrDefault(x => x.Customer_ID == customerID);
        return rs != null ? rs.COMPANY! : "";
    }

    private Func<M_Quotation, string> _cellStyleFunc => x =>
     {
         string style = "";

         if (string.IsNullOrEmpty(x.status))
             return "color: #000000";

         var rs = M_Trangthais
     .Where(t => (t.Noidung).Contains(x.status, StringComparison.InvariantCultureIgnoreCase)
         && t.Tieude.Equals("QUOTATION", StringComparison.InvariantCultureIgnoreCase))
     .Select(t => t.Mamau)
     .FirstOrDefault();
         return "color: " + rs;

     };
}


