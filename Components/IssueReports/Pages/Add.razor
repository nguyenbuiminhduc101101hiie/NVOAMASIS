@using System.Globalization
@inject ISnackbar Snackbar
@inject AccountService asv
@inject TrainScheduleServices trainsv
@inject IStringLocalizer<SharedResource> Localizer
@inject SharedServices ssv
@inject LocalChargesServices lcsv
@inject SupportServices supsv
@inject LenhDieuXeServices ldxsv
@inject TKHQ_Services tkhqsv
@inject GlobalServices gsv
@inject Bieugianangha_Services BGRRsv
@inject CustomerService CusSV
@inject DNTUServices DNTUSV
@inject BookingService Bksv
@inject ShipmentService shipmentsv
@inject NavigationManager NavigationManager
@inject ProductPriceServices prsv
@inject NotificationService _notificationService
@inject IJSRuntime JSRuntime
@inject IssueReportServices IRSv


<MudDialog>
    <DialogContent>
        <MudSpacer></MudSpacer>
        <MudContainer>

            <MudCard>
                <MudForm Model="@_IssueReport_Details" @ref="@form">
                    <MudCardContent>

                        <MudGrid>

                            <MudItem xs="2">
                                <MudButton Style="background-color: #007BFF; color: white;" Size="Size.Small" Color="Color.Primary"
                                           Disabled="@(Status == "edit")"
                                           OnClick="() => Get_BGNHNo()">>>></MudButton>
                            </MudItem>

                            <MudItem xs="5">
                                <MudTextField @bind-Value="_IssueReport_Details.No" Disabled="true" Label="@Localizer["No"]" Class="custom-label" Required="true" />
                            </MudItem>

                        </MudGrid>

                        <MudGrid>

                            <MudItem xs="6">
                                <MudTextField @bind-Value="_IssueReport_Details.Title" Label="@Localizer["Title"]" class="custom-label" />
                            </MudItem>

                            <MudItem xs="6">
                                <MudTextField @bind-Value="_IssueReport_Details.Description" Label="@Localizer["Description"]" class="custom-label" />
                            </MudItem>

                            <MudItem xs="6">
                                <MudTextField @bind-Value="_IssueReport_Details.StepsToReproduce" Label="@Localizer["StepsToReproduce"]" class="custom-label" />
                            </MudItem>

                            <MudItem xs="6">
                                <MudTextField @bind-Value="_IssueReport_Details.ExpectedResult" Label="@Localizer["ExpectedResult"]" class="custom-label" />
                            </MudItem>

                            <MudItem xs="6">
                                <MudTextField @bind-Value="_IssueReport_Details.ActualResult" Label="@Localizer["ActualResult"]" class="custom-label" />
                            </MudItem>

                            <MudItem xs="6">
                            <MudSelect @bind-Value="_IssueReport_Details.Severity" Label="@Localizer["Severity"]" Class="custom-label" Required="true">
                                <MudSelectItem Value="@("Low")">Low</MudSelectItem>
                                <MudSelectItem Value="@("Medium")">Medium</MudSelectItem>
                                <MudSelectItem Value="@("High")">High</MudSelectItem>
                                <MudSelectItem Value="@("Critical")">Critical</MudSelectItem>
                            </MudSelect>

                            </MudItem>

                            <MudItem xs="6">
                                <MudSelect @bind-Value="_IssueReport_Details.Status" Label="@Localizer["status"]" class="custom-label">
                                    @foreach (var item in trangthais)
                                    {
                                        <MudSelectItem Value="item">@item</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>

                            <MudItem xs="6">
                                <MudTextField @bind-Value="_IssueReport_Details.AssignedTo" Label="@Localizer["AssignedTo"]" class="custom-label" />
                            </MudItem>

     
                            <MudItem xs="6">
                                <MudDatePicker Class="custom-label" @bind-Date="_IssueReport_Details.ResolveDate"
                                               For="@(() => _IssueReport_Details.ResolveDate)"
                                               Label="@Localizer["ResolveDate"]"
                                               DateFormat="dd/MM/yyyy"
                                               Required="true" />
                            </MudItem>
                            <MudItem xs="6">
                            </MudItem>
                            <MudItem xs="3">
                                <MudAutocomplete Class="labelCustomColor custom-label" T="string"
                                @bind-Value="UserHanding"
                                Label="@Localizer["User"]"
                                SearchFunc="Search_User"
                                Immediate="true"
                                CoerceText="true"
                                Clearable="true"
                                MaxItems="100">
                                </MudAutocomplete>
                            </MudItem>

                            <MudItem xs="1">
                                <MudButton Class="labelCustomColor" Style="background-color: #007BFF; color: white;" Size="Size.Small" Color="Color.Primary" OnClick="() => Getuser(_IssueReport_Details)">>>></MudButton>
                            </MudItem>

                            <MudItem xs="4">
                                <MudTextField @bind-Value="_IssueReport_Details.UserHandle" class="labelCustomColor custom-label" 
                                Lines="3" AutoGrow Label="User Nhận Email" Required="false" />
                            </MudItem>

                            <MudItem xs="2">
                                <MudButton HtmlTag="label" Disabled="_processingUpload"
                                @onclick="@(() => SendMailnotify(_IssueReport_Details))"
                                Size="Size.Small" Color="Color.Tertiary" Variant="Variant.Filled"
                                StartIcon="@Icons.Material.Filled.Email">
                                    @if (_processingUpload)
                                    {
                                        <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                                        <MudText Class="ms-2">Processing</MudText>
                                    }
                                    else
                                    {
                                        <MudText>@Localizer["sendemail"]</MudText>
                                    }
                                </MudButton>

                            </MudItem>

                            <MudItem xs="2">
                                <MudButton HtmlTag="label" Disabled="_processingUpload_message"
                                @onclick="@(() => SendMessage(_IssueReport_Details))"
                                Size="Size.Small" Color="Color.Tertiary" Variant="Variant.Filled"
                                StartIcon="@Icons.Material.Filled.Email">
                                    @if (_processingUpload_message)
                                    {
                                        <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                                        <MudText Class="ms-2">Processing</MudText>
                                    }
                                    else
                                    {
                                        <MudText>@Localizer["message"]</MudText>
                                    }
                                </MudButton>
                            </MudItem>


                            <MudItem xs="12">
                                <MudStack Row>
                                    <MudFileUpload T="IBrowserFile"
                                                   Accept=".pdf,.doc,.docx,.xls,.xlsx"
                                                   FilesChanged="@((t) => AttachFileToFTP(t, _IssueReport_Details))">
                                        <ButtonTemplate Context="context1">
                                            <MudIconButton HtmlTag="label" for="@context1"
                                                           Size="Size.Small"
                                                           Color="Color.Secondary"
                                                           Icon="@Icons.Material.Filled.AttachFile" />
                                        </ButtonTemplate>
                                    </MudFileUpload>

                                    <MudContainer Class="pa-4; max-height:200px; overflow-y: auto;">
                                        <MudText Typo="Typo.h6">Files</MudText>

                                        @foreach (var item in Linksplit(_IssueReport_Details.ScreenshotUrl!))
                                        {
                                            var fileName = Path.GetFileName(item);
                                            var fileUrl = item.Replace("ftp", "http");
                                            var fileExtension = Path.GetExtension(fileName).ToLower();

                                            <MudPaper Elevation="3" Class="d-flex align-items-center justify-between ma-2 pa-2">
                                                <MudIcon Icon="@GetFileIcon(fileExtension)" Size="Size.Medium" />
                                                <MudText Class="mx-2" Style="flex-grow: 1;">@fileName</MudText>

                                                <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                                                               OnClick="@(() => SeeDetail(fileUrl))"
                                                               Color="Color.Primary" />

                                                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                               OnClick="@(() => DeleteFiles(_IssueReport_Details, item))"
                                                               Color="Color.Error" />
                                            </MudPaper>
                                        }
                                    </MudContainer>

                                </MudStack>
                            </MudItem>
                        </MudGrid>

                    </MudCardContent>
                </MudForm>

            </MudCard>
        </MudContainer>
    </DialogContent>
    <DialogActions>

        <MudButton OnClick="@(async () => await Submit())">Save</MudButton>
        <MudButton OnClick="Cancel">Cancel</MudButton>

    </DialogActions>
</MudDialog>


@code {
    [CascadingParameter] MudDialogInstance? MudDialog { get; set; }
    [Parameter] public Models.M_IssueReports _IssueReport_Details { get; set; }
    [Parameter] public string Status { get; set; }

    List<string> trangthais = new List<string>();
    private List<Models.TrangThai> M_Trangthais = new List<Models.TrangThai>();
    public CultureInfo _en = CultureInfo.GetCultureInfo("en-US");
    List<M_IssueReports> IssueReports = new List<M_IssueReports>();
    public string? UserHanding;
    MudForm form;
    private List<string> ListUser { get; set; } = new List<string>();


    protected async override Task OnInitializedAsync()
    {
        if (Status == "Duplicate")
        {

            _IssueReport_Details.IssueId = Guid.Empty;
            _IssueReport_Details.Approve = false;
            _IssueReport_Details.Continued = true;
            _IssueReport_Details.Editable = true;
        }

        M_Trangthais = await supsv.GetListTrangThai();
        var tts = await supsv.GetListTrangThai();
        trangthais = tts.Where(x => x.Tieude == "IssueReports").OrderBy(x => x.Noidung).Select(x => x.Noidung).ToList();
        IssueReports = await IRSv.Get_IssueReport();
        ListUser = await asv.GetList_User_handle() ?? new List<string>();
    }

    
    private async Task Submit()
    {
        await form.Validate();

        if (form.IsValid)
        {
            var UserName = asv.GetAuth().Result.User.Identity!.Name!;
            if (Status == "add")
            {
                _IssueReport_Details.Reporter = UserName;
                _IssueReport_Details.ReportDate = DateTime.Now.ToString();
                _IssueReport_Details.Approve = false;
                _IssueReport_Details.Continued = true;
                _IssueReport_Details.Editable = true;
            }
     
            _IssueReport_Details.Dateupdate = DateTime.Now.ToString();
            _IssueReport_Details.Userupdate = UserName;
            MudDialog!.Close(_IssueReport_Details);

           
        }

    }
    void Cancel() => MudDialog.Cancel();

    void CallSnackBar(string message, MudBlazor.Severity severity)
    {

        Snackbar.Configuration.SnackbarVariant = Variant.Filled;
        Snackbar.Configuration.MaxDisplayedSnackbars = 3;
        Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopRight;
        Snackbar.Add(message, severity);
    }
  
    private async Task<IEnumerable<string>> Search_User(string value)
    {
        if (string.IsNullOrEmpty(value))
            return ListUser;

        return ListUser.Where(x => x.Contains(value, StringComparison.InvariantCultureIgnoreCase));
    }

    private async Task Getuser(M_IssueReports item)
    {
        if (string.IsNullOrEmpty(item.UserHandle))
        {
            item.UserHandle = UserHanding;
        }
        else
        {
            item.UserHandle += "," + UserHanding + ",";
        }
    }

    private bool _processingUpload = false;
    async Task SendMailnotify(M_IssueReports item)
    {
        try
        {
            string[] users = item.UserHandle.Split(',');
            List<string> emails = new List<string>(); // Danh sách động, có thể thêm thoải mái

            int index = 0;
            foreach (var user in users)
            {
                if (string.IsNullOrEmpty(user))
                {

                }
                else
                {
                    string inputemail = "";
                    inputemail = await gsv.GetEmailAsync(user);
                    if (!string.IsNullOrEmpty(inputemail))
                    {
                        emails.Add(inputemail);
                    }

                }
            }
            string[] emailarray = emails.ToArray();
            _processingUpload = true;
            await Task.Delay(1);
            StateHasChanged();
           
            if (emails != null && emailarray.Length > 0)
            {
     
                var rs = await gsv.GuiThongBao_IssueReport(item, emailarray);

                CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);

            }
            else
            {

                CallSnackBar("Email is empty!", MudBlazor.Severity.Warning);
                return;
            }


        }
        catch (Exception ex)
        {
            CallSnackBar("Somethings went wrong!, error code: " + ex.Message, MudBlazor.Severity.Error);
        }
        finally
        {
            _processingUpload = false;
        }

    }

    private bool _processingUpload_message = false;
    async Task SendMessage(M_IssueReports item)
    {
        try
        {
            string[] users = item.UserHandle.Split(',');
            List<string> listid = new List<string?>(); // Danh sách động, có thể thêm thoải mái

            int index = 0;
            foreach (var user in users)
            {
                if (string.IsNullOrEmpty(user))
                {

                }
                else
                {

                    Guid? inputid = await gsv.GetIdfromUser(user);
                    if (inputid != null)
                    {
                        listid.Add(inputid.ToString());
                    }

                }
            }
            string[] Idarray = listid.ToArray();
            _processingUpload_message = true;
            await Task.Delay(1);
            StateHasChanged();
            string noidung = "Issue Report Title:" + item.No;
            if (listid != null && Idarray.Length > 0)
            {
                await _notificationService.SendNotificationAsync(Idarray, noidung);


            }
            else
            {

                CallSnackBar("User is empty!", MudBlazor.Severity.Warning);
                return;
            }

        }
        catch (Exception ex)
        {
            CallSnackBar("Somethings went wrong!, error code: " + ex.Message, MudBlazor.Severity.Error);
        }
        finally
        {
            _processingUpload_message = false;
        }
    }

    private async Task Get_BGNHNo()
    {

        int formattedYear = DateTime.Now.Year;
        int formattedMonth = DateTime.Now.Month;

        string usr = asv.GetAuth().Result.User.Identity!.Name!;
        var refno = await supsv.GetRefNoByFunc("IssueReports", formattedMonth, formattedYear, usr);

        var rs = asv.GetUserDetail();
        var cn = rs.Branch;
        _IssueReport_Details.No = cn + "Isuue_Rpt_" + formattedYear.ToString() + formattedMonth.ToString() + refno.Value.ToString("D4");
    }

    async Task SeeDetail(string fileUrl)
    {

        await JSRuntime.InvokeVoidAsync("open", fileUrl, "_blank");

    }
    async Task DeleteFiles(M_IssueReports item, string link)
    {
        try
        {
            if (item.ScreenshotUrl!.Contains(";"))
                link = link + ";";
            item.ScreenshotUrl = item.ScreenshotUrl!.Replace(link, string.Empty);

            StateHasChanged();
        }
        catch (Exception ex)
        {
            CallSnackBar("Throw exception code: " + ex.Message, MudBlazor.Severity.Error);
        }
    }
    async Task AttachFileToFTP(IBrowserFile file, M_IssueReports item)
    {
        try
        {
            var rs = await ssv.UploadfiletoFTP_Issue(file, (object)item);
            CallSnackBar(rs.Message, rs.Flag ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
        }
        catch (Exception ex)
        {
            CallSnackBar("Throw exception code: " + ex.Message, MudBlazor.Severity.Error);
        }
    }
    List<string> Linksplit(string links)
    {
        if (string.IsNullOrEmpty(links))
            return new List<string>();
        return links.Split(';').ToList();
    }

    private string GetFileIcon(string extension)
    {
        return extension switch
        {
            ".pdf" => Icons.Material.Filled.PictureAsPdf,
            ".doc" or ".docx" => Icons.Material.Filled.Description,
            ".xls" or ".xlsx" => Icons.Material.Filled.TableChart,
            _ => Icons.Material.Filled.InsertDriveFile
        };
    }


}
